-30.md"}}, {id:"federal:BR:L:608/1949", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-01-10", numero:"608", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-01-10;608", vigente:true, titulo:"Lei nº 608 de 10/01/1949", urn:"urn:lex:br:federal:lei:1949-01-10;608", ementa:"Torna extensiva aos suboficiais e sargentos do 1º Grupo da FAB as vantagens concedidas ao pessoal da FEB pelo Decreto-Lei n. 8159, de 1945 e pela Lei n. 11, de 1946.", arquivo:"federal/leis-ordinarias/1949/lei-608-1949-01-10.md"}}, {id:"federal:BR:L:624/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-02-20", numero:"624", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-02-20;624", vigente:true, titulo:"Lei nº 624 de 20/02/1949", urn:"urn:lex:br:federal:lei:1949-02-20;624", ementa:"Revoga o Decreto-lei n. 4631, de 27 de agosto de 1942.", arquivo:"federal/leis-ordinarias/1949/lei-624-1949-02-20.md"}}, {id:"federal:BR:L:781/1949", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-08-17", numero:"781", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-08-17;781", vigente:true, titulo:"Lei nº 781 de 17/08/1949", urn:"urn:lex:br:federal:lei:1949-08-17;781", ementa:"Institui o Dia Nacional de Ação de Graças.", arquivo:"federal/leis-ordinarias/1949/lei-781-1949-08-17.md"}}, {id:"federal:BR:L:996/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-12-23", numero:"996", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-12-23;996", vigente:true, titulo:"Lei nº 996 de 23/12/1949", urn:"urn:lex:br:federal:lei:1949-12-23;996", ementa:"Autoriza a abertura, ao Poder Legislativo, de crédito sup