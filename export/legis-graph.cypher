20/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1983, data:"1983-08-30", numero:"7120", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1983-08-30;7120", vigente:true, titulo:"Lei nº 7.120 de 30/08/1983", urn:"urn:lex:br:federal:lei:1983-08-30;7120", ementa:"Dispõe sobre a criação e extinção de cargos na Secretaria do Tribunal   Superior do Trabalho, e dá outras providências.", arquivo:"federal/leis-ordinarias/1983/lei-7120-1983-08-30.md"}}, {id:"federal:BR:L:7105/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1983, data:"1983-06-20", numero:"7105", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1983-06-20;7105", vigente:true, titulo:"Lei nº 7.105 de 20/06/1983", urn:"urn:lex:br:federal:lei:1983-06-20;7105", ementa:"Altera as alíquotas do imposto sobre a trasmissão de bens imóveis e de   direitos a eles relativos, a que se refere o artigo 31 do Decreto-lei nº 82, de   26 de dezembro de 1966.", arquivo:"federal/leis-ordinarias/1983/lei-7105-1983-06-20.md"}}, {id:"federal:BR:L:7142/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1983, data:"1983-11-23", numero:"7142", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1983-11-23;7142", vigente:true, titulo:"Lei nº 7.142 de 23/11/1983", urn:"urn:lex:br:federal:lei:1983-11-23;7142", ementa:"Concede pensão especial a Augusto Schulze, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1983/lei-7142-1983-11-23.md"}}, {id:"federal:BR:L:7131/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1983, data:"1983-10-26", numero:"7131", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1983-10-26;7131", vigente:true, titulo:"Lei nº 7.131 de 26/10/1983", urn:"urn:lex:br:federal:lei:1983-10-26;7131", ementa:"Concede pensão especial a TEREZA MARIA DE SOUZA CORRÊA e dá outras   providências.", arquivo:"federal/leis-ordinarias/1983/lei-7131-1983-10-26.md"}}, {id:"federal:BR:L:7110/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1983, data:"1983-07-05", numero:"7110", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1983-07-05;7110", vigente:true, titulo:"Lei nº 7.110 de 05/07/1983", urn:"urn:lex:br:federal:lei:1983-07-05;7110", ementa:"Retifica, sem ônus, a Lei nº 7.054, de 6 de dezembro de 1982, que estima a Receita e fixa a Despesa do Distrito Federal para o exercício financeiro de 1983.", arquivo:"federal/leis-ordinarias/1983/lei-7110-1983-07-05.md"}}, {id:"federal:BR:L:7180/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1983, data:"1983-12-20", numero:"7180", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1983-12-20;7180", vigente:true, titulo:"Lei nº 7.180 de 20/12/1983", urn:"urn:lex:br:federal:lei:1983-12-20;7180", ementa:"Dispõe sobre a concessão da permanência no Brasil   aos estrangeiros registrados provisoriamente.", arquivo:"federal/leis-ordinarias/1983/lei-7180-1983-12-20.md"}}, {id:"federal:BR:L:7129/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1983, data:"1983-10-10", numero:"7129", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1983-10-10;7129", vigente:true, titulo:"Lei nº 7.129 de 10/10/1983", urn:"urn:lex:br:federal:lei:1983-10-10;7129", ementa:"Concede pensão especial a Abigail Lopes, companheira do ex-sertanista   Francisco Furtado Soares de Meireles.", arquivo:"federal/leis-ordinarias/1983/lei-7129-1983-10-10.md"}}, {id:"federal:BR:L:7114/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1983, data:"1983-08-17", numero:"7114", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1983-08-17;7114", vigente:true, titulo:"Lei nº 7.114 de 17/08/1983", urn:"urn:lex:br:federal:lei:1983-08-17;7114", ementa:"Autoriza o Poder Executivo a abrir ao Ministério da Justiça o crédito especial de até Cr$ 1.000.000.000,00 (Um bilhão de cruzeiros), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1983/lei-7114-1983-08-17.md"}}, {id:"federal:BR:L:7167/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1983, data:"1983-12-14", numero:"7167", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1983-12-14;7167", vigente:true, titulo:"Lei nº 7.167 de 14/12/1983", urn:"urn:lex:br:federal:lei:1983-12-14;7167", ementa:"Altera a estrutura da Categoria Funcional de Engenheiro Florestal, do   Grupo - Outras Atividades de Nível Superior, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1983/lei-7167-1983-12-14.md"}}, {id:"federal:BR:L:7109/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1983, data:"1983-07-05", numero:"7109", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1983-07-05;7109", vigente:true, titulo:"Lei nº 7.109 de 05/07/1983", urn:"urn:lex:br:federal:lei:1983-07-05;7109", ementa:"Autoriza o Governo do Distrito Federal a contratar operação de crédito no valor de Cr$ 8.304.089.820,00 (Oito bilhões, trezentos e quatro milhões, oitenta e nove mil, oitocentos e vinte cruzeiros).", arquivo:"federal/leis-ordinarias/1983/lei-7109-1983-07-05.md"}}, {id:"federal:BR:L:7139/1983", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1983, data:"1983-11-07", numero:"7139", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1983-11-07;7139", vigente:true, titulo:"Lei nº 7.139 de 07/11/1983", urn:"urn:lex:br:federal:lei:1983-11-07;7139", ementa:"Fixa os valores de retribuição das Categorias Funcionais de Técnico de Meteorologia Aeronáutica e Técnico de Programação e Operação de Defesa Aérea e Controle de Tráfego Aéreo, e dá outras providências.", arquivo:"federal/leis-ordinarias/1983/lei-7139-1983-11-07.md"}}, {id:"federal:BR:L:7119/1983", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1983, data:"1983-08-30", numero:"7119", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1983-08-30;7119", vigente:true, titulo:"Lei nº 7.119 de 30/08/1983", urn:"urn:lex:br:federal:lei:1983-08-30;7119", ementa:"Altera a composição e a organização interna dos Tribunais Regionais do Trabalho que menciona, cria cargos, e dá outras providências.", arquivo:"federal/leis-ordinarias/1983/lei-7119-1983-08-30.md"}}, {id:"federal:BR:L:162/1947", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1947, data:"1947-12-02", numero:"162", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1947-12-02;162", vigente:true, titulo:"Lei nº 162 de 02/12/1947", urn:"urn:lex:br:federal:lei:1947-12-02;162", ementa:"Estima a receita e fixa a despesa da União para o exercício financeiro de 1948.", arquivo:"federal/leis-ordinarias/1947/lei-162-1947-12-02.md"}}] AS row
