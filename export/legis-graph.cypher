federal:BR:L:5423/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-26", numero:"5423", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-26;5423", vigente:true, titulo:"Lei nº 5.423 de 26/04/1968", urn:"urn:lex:br:federal:lei:1968-04-26;5423", ementa:"Reclassifica, no símbolo 5-C, os cargos em comissão de Diretores das   Escolas Técnicas e Industriais Federais da Rede Federal de Ensino Industrial do   Ministério da Educação e Cultura.", arquivo:"federal/leis-ordinarias/1968/lei-5423-1968-04-26.md"}}, {id:"federal:BR:L:5442/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-05-24", numero:"5442", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-05-24;5442", vigente:true, titulo:"Lei nº 5.442 de 24/05/1968", urn:"urn:lex:br:federal:lei:1968-05-24;5442", ementa:"Modifica a redação de dispositivos da Consolidação das Leis do Trabalho e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5442-1968-05-24.md"}}, {id:"federal:BR:L:5428/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-30", numero:"5428", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-30;5428", vigente:true, titulo:"Lei nº 5.428 de 30/04/1968", urn:"urn:lex:br:federal:lei:1968-04-30;5428", ementa:"Reajusta os vencimentos dos funcinários das Secretarias do Tribunal Superior Eleitoral e Tribunais Regionais Eleitorais.", arquivo:"federal/leis-ordinarias/1968/lei-5428-1968-04-30.md"}}, {id:"federal:BR:L:3351/1887", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1887, data:"1887-10-20", numero:"3351", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1887-10-20;3351", vigente:true, titulo:"Lei nº 3.351 de 20/10/1887", urn:"urn:lex:br:federal:lei:1887-10-20;3351", ementa:"CONCEDE CREDITO ESPECIAL DE 18.220:633$096, AFIM DE SER APLICADO 3.220:633$096 A CONCLUSÃO DO PROLONGAMENTO DA ESTRADA DE FERRO DA BAHIA AO S. FRANCISCO E 15.000:000$ A CONSTRUÇÃO DA ESTRADA DE FERRO DE BAGE A URUGUAIANA, PASSANDO POR CACEQUI; E AUTORIZA AS OPERAÇÕES DE CREDITO QUE FOREM PRECISAS PARA OCORRER A ESSA DESPESA.", arquivo:"federal/leis-ordinarias/1887/lei-3351-1887-10-20.md"}}, {id:"federal:BR:L:3318/1887", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1887, data:"1887-06-28", numero:"3318", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1887-06-28;3318", vigente:true, titulo:"Lei nº 3.318 de 28/06/1887", urn:"urn:lex:br:federal:lei:1887-06-28;3318", ementa:"OUTORGA O CONSENTIMENTO DE QUE TRATA O ARTIGO 104 DA CONSTITUIÇÃO, PARA QUE SUA MAJESTADE O IMPERADOR POSSA SAIR DO IMPÉRIO, E DECLARA QUE DURANTE SUA AUSÊNCIA, GOVERNARÁ, COMO REGENTE, A PRINCESA IMPERIAL SENHORA D. ISABEL.", arquivo:"federal/leis-ordinarias/1887/lei-3318-1887-06-28.md"}}, {id:"federal:BR:L:3348/1887", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1887, data:"1887-10-20", numero:"3348", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1887-10-20;3348", vigente:true, titulo:"Lei nº 3.348 de 20/10/1887", urn:"urn:lex:br:federal:lei:1887-10-20;3348", ementa:"ORÇA A RECEITA GERAL DO IMPÉRIO PARA O EXERCÍCIO DE 1888 E DÁ OUTRAS PROVIDÊNCIAS.", arquivo:"federal/leis-ordinarias/1887/lei-3348-1887-10-20.md"}}, {id:"federal:BR:L:3319/1887", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1887, data:"1887-06-28", numero:"3319", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1887-06-28;3319", vigente:true, titulo:"Lei nº 3.319 de 28/06/1887", urn:"urn:lex:br:federal:lei:1887-06-28;3319", ementa:"FIXA AS FORÇAS DE TERRA PARA O SEGUNDO SEMESTRE DO ANO DE 1888.", arquivo:"federal/leis-ordinarias/1887/lei-3319-1887-06-28.md"}}, {id:"federal:BR:L:3317/1887", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1887, data:"1887-06-20", numero:"3317", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1887-06-20;3317", vigente:true, titulo:"Lei nº 3.317 de 20/06/1887", urn:"urn:lex:br:federal:lei:1887-06-20;3317", ementa:"FIXA AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1887-1888.", arquivo:"federal/leis-ordinarias/1887/lei-3317-1887-06-20.md"}}, {id:"federal:BR:L:3349/1887", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1887, data:"1887-10-20", numero:"3349", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1887-10-20;3349", vigente:true, titulo:"Lei nº 3.349 de 20/10/1887", urn:"urn:lex:br:federal:lei:1887-10-20;3349", ementa:"FIXA A DESPESA GERAL DO IMPÉRIO PARA O EXERCÍCIO DE 1888 E DÁ OUTRAS PROVIDÊNCIAS.", arquivo:"federal/leis-ordinarias/1887/lei-3349-1887-10-20.md"}}, {id:"federal:BR:L:3326/1887", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1887, data:"1887-08-04", numero:"3326", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1887-08-04;3326", vigente:true, titulo:"Lei nº 3.326 de 04/08/1887", urn:"urn:lex:br:federal:lei:1887-08-04;3326", ementa:"FIXA A FORÇA NAVAL PARA O 2 SEMESTRE DE 1888.", arquivo:"federal/leis-ordinarias/1887/lei-3326-1887-08-04.md"}}, {id:"federal:BR:L:14938/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-07-29", numero:"14938", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-07-29;14938", vigente:true, titulo:"Lei nº 14.938 de 29/07/2024", urn:"urn:lex:br:federal:lei:2024-07-29;14938", ementa:"Institui o Dia Nacional da Lembrança do Holocausto.", arquivo:"federal/leis-ordinarias/2024/lei-14938-2024-07-29.md"}}, {id:"federal:BR:L:14922/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-07-11", numero:"14922", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-07-11;14922", vigente:true, titulo:"Lei nº 14.922 de 11/07/2024", urn:"urn:lex:br:federal:lei:2024-07-11;14922", ementa:"Abre crédito extraordinário em favor do Ministério da Justiça e Segurança Pública, do Ministério do Meio Ambiente e Mudança do Clima, do Ministério do Desenvolvimento Agrário e Agricultura Familiar, do Ministério da Defesa, do Ministério do Desenvolvimento e Assistência Social, Família e Combate à Fome, do Ministério da Pesca e Aquicultura, do Ministério dos Direitos Humanos e da Cidadania e do Ministério dos Povos Indígenas, no valor de R$ 1.062.231.956,00 (um bilhão, sessenta e dois milhões, d", arquivo:"federal/leis-ordinarias/2024/lei-14922-2024-07-11.md"}}, {id:"federal:BR:L:14869/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-05-28", numero:"14869", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-05-28;14869", vigente:true, titulo:"Lei nº 14.869 de 28/05/2024", urn:"urn:lex:br:federal:lei:2024-05-28;14869", ementa:"Declara a cidade de Santa Gertrudes, no Estado de São Paulo, Capital Nacional da Cerâmica de Pisos e Revestimentos.", arquivo:"federal/leis-ordinarias/2024/lei-14869-2024-05-28.md"}}, {id:"federal:BR:L:15011/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-11-01", numero:"15011", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-11-01;15011", vigente:true, titulo:"Lei nº 15.011 de 01/11/2024", urn:"urn:lex:br:federal:lei:2024-11-01;15011", ementa:"Confere ao Município de Jaraguá do Sul, no Estado de Santa Catarina, o título de Capital Nacional dos Atiradores.", arquivo:"federal/leis-ordinarias/2024/lei-15011-2024-11-01.md"}}, {id:"federal:BR:L:15046/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-12-17", numero:"15046", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-12-17;15046", vigente:true, titulo:"Lei nº 15.046 de 17/12/2024", urn:"urn:lex:br:federal:lei:2024-12-17;15046", ementa:"Autoriza a criação do Cadastro Nacional de Animais Domésticos.", arquivo:"federal/leis-ordinarias/2024/lei-15046-2024-12-17.md"}}, {id:"federal:BR:L:15073/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-12-26", numero:"15073", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-12-26;15073", vigente:true, titulo:"Lei nº 15.073 de 26/12/2024", urn:"urn:lex:br:federal:lei:2024-12-26;15073", ementa:"Altera a Lei nº 11.771, de 17 de setembro de 2008 (Lei Geral do Turismo), para prever sanções aos prestadores de serviços turísticos que cometerem infrações associadas à facilitação do turismo sexual.", arquivo:"federal/leis-ordinarias/2024/lei-15073-2024-12-26.md"}}, {id:"federal:BR:L:15067/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-12-23", numero:"15067", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-12-23;15067", vigente:true, titulo:"Lei nº 15.067 de 23/12/2024", urn:"urn:lex:br:federal:lei:2024-12-23;15067", ementa:"Altera a Lei nº 14.791, de 29 de dezembro de 2023, que dispõe sobre as diretrizes para a elaboração e a execução da Lei Orçamentária de 2024.", arquivo:"federal/leis-ordinarias/2024/lei-15067-2024-12-23.md"}}, {id:"federal:BR:L:15009/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-10-29", numero:"15009", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-10-29;15009", vigente:true, titulo:"Lei nº 15.009 de 29/10/2024", urn:"urn:lex:br:federal:lei:2024-10-29;15009", ementa:"Altera a Lei nº 13.733, de 16 de novembro de 2018, para instituir o Outubrinho Rosa, a ser realizado no mês de outubro.", arquivo:"federal/leis-ordinarias/2024/lei-15009-2024-10-29.md"}}, {id:"federal:BR:L:14851/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-05-03", numero:"14851", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-05-03;14851", vigente:true, titulo:"Lei nº 14.851 de 03/05/2024", urn:"urn:lex:br:federal:lei:2024-05-03;14851", ementa:"Dispõe sobre a obrigatoriedade de criação de mecanismos de levantamento e de divulgação da demanda por vagas no atendimento à educação infantil de crianças de 0 (zero) a 3 (três) anos de idade.", arquivo:"federal/leis-ordinarias/2024/lei-14851-2024-05-03.md"}}, {id:"federal:BR:L:15058/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-12-23", numero:"15058", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-12-23;15058", vigente:true, titulo:"Lei nº 15.058 de 23/12/2024", urn:"urn:lex:br:federal:lei:2024-12-23;15058", ementa:"Abre ao Orçamento Fiscal da União, em favor do Tribunal de Contas da União, crédito especial no valor de R$ 685.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/2024/lei-15058-2024-12-23.md"}}, {id:"federal:BR:L:15028/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-11-18", numero:"15028", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-11-18;15028", vigente:true, titulo:"Lei nº 15.028 de 18/11/2024", urn:"urn:lex:br:federal:lei:2024-11-18;15028", ementa:"Denomina \"Rodovia Governador Benedito Valadares\" o trecho da rodovia BR-262 entre o Km 352,5 e o Km 426, no Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/2024/lei-15028-2024-11-18.md"}}, {id:"federal:BR:L:14912/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-07-03", numero:"14912", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-07-03;14912", vigente:true, titulo:"Lei nº 14.912 de 03/07/2024", urn:"urn:lex:br:federal:lei:2024-07-03;14912", ementa:"Altera a Lei nº 8.080, de 19 de setembro de 1990 (Lei Orgânica da Saúde), para determinar a realização de campanhas permanentes sobre os riscos da automedicação.", arquivo:"federal/leis-ordinarias/2024/lei-14912-2024-07-03.md"}}, {id:"federal:BR:L:15010/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-10-30", numero:"15010", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-10-30;15010", vigente:true, titulo:"Lei nº 15.010 de 30/10/2024", urn:"urn:lex:br:federal:lei:2024-10-30;15010", ementa:"Abre crédito extraordinário em favor da Justiça Federal, da Defensoria Pública da União, do Ministério do Trabalho e Emprego e de Encargos Financeiros da União, no valor de R$ 2.036.694.007,00 (dois bilhões trinta e seis milhões seiscentos e noventa e quatro mil e sete reais), para os fins que especifica.", arquivo:"federal/leis-ordinarias/2024/lei-15010-2024-10-30.md"}}, {id:"federal:BR:L:14965/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-09-09", numero:"14965", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-09-09;14965", vigente:true, titulo:"Lei nº 14.965 de 09/09/2024", urn:"urn:lex:br:federal:lei:2024-09-09;14965", ementa:"Dispõe sobre as normas gerais relativas a concursos públicos.", arquivo:"federal/leis-ordinarias/2024/lei-14965-2024-09-09.md"}}, {id:"federal:BR:L:14827/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-03-20", numero:"14827", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-03-20;14827", vigente:true, titulo:"Lei nº 14.827 de 20/03/2024", urn:"urn:lex:br:federal:lei:2024-03-20;14827", ementa:"Institui o Dia Nacional do Cirurgião Oncológico.", arquivo:"federal/leis-ordinarias/2024/lei-14827-2024-03-20.md"}}, {id:"federal:BR:L:14837/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-04-08", numero:"14837", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-04-08;14837", vigente:true, titulo:"Lei nº 14.837 de 08/04/2024", urn:"urn:lex:br:federal:lei:2024-04-08;14837", ementa:"Altera a Lei nº 12.244, de 24 de maio de 2010, que \"dispõe sobre a universalização das bibliotecas nas instituições de ensino do País\", para modificar a definição de biblioteca escolar e criar o Sistema Nacional de Bibliotecas Escolares (SNBE).", arquivo:"federal/leis-ordinarias/2024/lei-14837-2024-04-08.md"}}, {id:"federal:BR:L:14881/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-06-07", numero:"14881", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-06-07;14881", vigente:true, titulo:"Lei nº 14.881 de 07/06/2024", urn:"urn:lex:br:federal:lei:2024-06-07;14881", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor dos Ministérios da Saúde, e da Integração e do Desenvolvimento Regional, crédito suplementar no valor de R$ 2.854.421.588,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2024/lei-14881-2024-06-07.md"}}, {id:"federal:BR:L:14886/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-06-11", numero:"14886", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-06-11;14886", vigente:true, titulo:"Lei nº 14.886 de 11/06/2024", urn:"urn:lex:br:federal:lei:2024-06-11;14886", ementa:"Institui o Programa Nacional de Vacinação em Escolas Públicas.", arquivo:"federal/leis-ordinarias/2024/lei-14886-2024-06-11.md"}}, {id:"federal:BR:L:14870/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-05-28", numero:"14870", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-05-28;14870", vigente:true, titulo:"Lei nº 14.870 de 28/05/2024", urn:"urn:lex:br:federal:lei:2024-05-28;14870", ementa:"Institui o Dia Nacional do Produtor de Leite.", arquivo:"federal/leis-ordinarias/2024/lei-14870-2024-05-28.md"}}, {id:"federal:BR:L:14955/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-09-02", numero:"14955", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-09-02;14955", vigente:true, titulo:"Lei nº 14.955 de 02/09/2024", urn:"urn:lex:br:federal:lei:2024-09-02;14955", ementa:"Confere o título de Capital Nacional das Startups à cidade de Florianópolis, no Estado de Santa Catarina.", arquivo:"federal/leis-ordinarias/2024/lei-14955-2024-09-02.md"}}, {id:"federal:BR:L:14847/2024", properties:{esfera:"federal", versao_texto:"texto da fonte oficial", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-04-25", numero:"14847", fonte:"https://www.planalto.gov.br/ccivil_03/_ato2023-2026/2024/lei/l14847.htm", vigente:true, titulo:"Lei nº 14.847 de 25/04/2024", urn:"urn:lex:br:federal:lei:2024-04-25;14847", ementa:"Altera a Lei nº 8.080, de 19 de setembro de 1990 (Lei Orgânica da Saúde), para dispor sobre o atendimento de mulheres vítimas de violência em ambiente privativo e individualizado nos serviços de saúde prestados no âmbito do Sistema Único de Saúde.", arquivo:"federal/leis-ordinarias/2024/lei-14847-2024-04-25.md"}}, {id:"federal:BR:L:14894/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-06-12", numero:"14894", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-06-12;14894", vigente:true, titulo:"Lei nº 14.894 de 12/06/2024", urn:"urn:lex:br:federal:lei:2024-06-12;14894", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor de diversos órgãos do Poder Executivo, crédito especial no valor de R$ 94.835.105,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2024/lei-14894-2024-06-12.md"}}, {id:"federal:BR:L:14855/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-05-16", numero:"14855", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-05-16;14855", vigente:true, titulo:"Lei nº 14.855 de 16/05/2024", urn:"urn:lex:br:federal:lei:2024-05-16;14855", ementa:"Altera a Lei nº 14.791, de 29 de dezembro de 2023, que dispõe sobre as diretrizes para a elaboração e a execução da Lei Orçamentária de 2024.", arquivo:"federal/leis-ordinarias/2024/lei-14855-2024-05-16.md"}}, {id:"federal:BR:L:14862/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-05-27", numero:"14862", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-05-27;14862", vigente:true, titulo:"Lei nº 14.862 de 27/05/2024", urn:"urn:lex:br:federal:lei:2024-05-27;14862", ementa:"Altera a Lei nº 9.394, de 20 de dezembro de 1996 (Lei de Diretrizes e Bases da Educação Nacional), para permitir que os professores da educação básica pública utilizem os veículos de transporte escolar dos Estados, do Distrito Federal e dos Municípios, nos termos que especifica; e revoga a Lei nº 10.709, de 31 de julho de 2003.", arquivo:"federal/leis-ordinarias/2024/lei-14862-2024-05-27.md"}}, {id:"federal:BR:L:14804/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-01-10", numero:"14804", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-01-10;14804", vigente:true, titulo:"Lei nº 14.804 de 10/01/2024", urn:"urn:lex:br:federal:lei:2024-01-10;14804", ementa:"Dispõe sobre a atuação do Tribunal de Contas da União (TCU) como membro do Conselho de Auditores da Organização das Nações Unidas (ONU).", arquivo:"federal/leis-ordinarias/2024/lei-14804-2024-01-10.md"}}, {id:"federal:BR:L:14946/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-07-31", numero:"14946", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-07-31;14946", vigente:true, titulo:"Lei nº 14.946 de 31/07/2024", urn:"urn:lex:br:federal:lei:2024-07-31;14946", ementa:"Institui normas aplicáveis a atividades espaciais nacionais.", arquivo:"federal/leis-ordinarias/2024/lei-14946-2024-07-31.md"}}, {id:"federal:BR:L:14952/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-08-06", numero:"14952", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-08-06;14952", vigente:true, titulo:"Lei nº 14.952 de 06/08/2024", urn:"urn:lex:br:federal:lei:2024-08-06;14952", ementa:"Altera a Lei nº 9.394, de 20 de dezembro de 1996 (Lei de Diretrizes e Bases da Educação Nacional), a fim de estabelecer regime escolar especial para atendimento a educandos nas situações que especifica.", arquivo:"federal/leis-ordinarias/2024/lei-14952-2024-08-06.md"}}, {id:"federal:BR:L:14798/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-01-05", numero:"14798", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-01-05;14798", vigente:true, titulo:"Lei nº 14.798 de 05/01/2024", urn:"urn:lex:br:federal:lei:2024-01-05;14798", ementa:"Institui o Dia Nacional da Educação Legislativa.", arquivo:"federal/leis-ordinarias/2024/lei-14798-2024-01-05.md"}}, {id:"federal:BR:L:14811/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-01-12", numero:"14811", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-01-12;14811", vigente:true, titulo:"Lei nº 14.811 de 12/01/2024", urn:"urn:lex:br:federal:lei:2024-01-12;14811", ementa:"Institui medidas de proteção à criança e ao adolescente contra a violência nos estabelecimentos educacionais ou similares, prevê a Política Nacional de Prevenção e Combate ao Abuso e Exploração Sexual da Criança e do Adolescente e altera o Decreto-Lei nº 2.848, de 7 de dezembro de 1940 (Código Penal), e as Leis nºs 8.072, de 25 de julho de 1990 (Lei dos Crimes Hediondos), e 8.069, de 13 de julho de 1990 (Estatuto da Criança e do Adolescente).", arquivo:"federal/leis-ordinarias/2024/lei-14811-2024-01-12.md"}}, {id:"federal:BR:L:14947/2024", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-08-02", numero:"14947", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-08-02;14947", vigente:true, titulo:"Lei nº 14.947 de 02/08/2024", urn:"urn:lex:br:federal:lei:2024-08-02;14947", ementa:"Dispõe sobre a criação do Fundo de Investimento em Infraestrutura Social (FIIS); e altera a Medida Provisória nº 2.156-5, de 24 de agosto de 2001, para autorizar os agentes operadores do Fundo de Desenvolvimento do Nordeste (FDNE) a renegociar os termos, os prazos e as demais condições financeiras das operações de crédito cujos riscos são suportados, parcial ou integralmente, pela União.", arquivo:"federal/leis-ordinarias/2024/lei-14947-2024-08-02.md"}}, {id:"federal:BR:L:14993/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-10-08", numero:"14993", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-10-08;14993", vigente:true, titulo:"Lei nº 14.993 de 08/10/2024", urn:"urn:lex:br:federal:lei:2024-10-08;14993", ementa:"Dispõe sobre a promoção da mobilidade sustentável de baixo carbono e a captura e a estocagem geológica de dióxido de carbono; institui o Programa Nacional de Combustível Sustentável de Aviação (ProBioQAV), o Programa Nacional de Diesel Verde (PNDV) e o Programa Nacional de Descarbonização do Produtor e Importador de Gás Natural e de Incentivo ao Biometano; altera as Leis nºs 9.478, de 6 de agosto de 1997, 9.847, de 26 de outubro de 1999, 8.723, de 28 de outubro de 1993, e 13.033, de 24 de setemb", arquivo:"federal/leis-ordinarias/2024/lei-14993-2024-10-08.md"}}, {id:"federal:BR:L:15017/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-11-12", numero:"15017", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-11-12;15017", vigente:true, titulo:"Lei nº 15.017 de 12/11/2024", urn:"urn:lex:br:federal:lei:2024-11-12;15017", ementa:"Altera a Lei nº 9.394, de 20 de dezembro de 1996 (Lei de Diretrizes e Bases da Educação Nacional), para dispor sobre a publicização de dados e microdados coletados nos censos da educação básica e superior e nos respectivos exames e sistemas de avaliação.", arquivo:"federal/leis-ordinarias/2024/lei-15017-2024-11-12.md"}}, {id:"federal:BR:L:14918/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-07-05", numero:"14918", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-07-05;14918", vigente:true, titulo:"Lei nº 14.918 de 05/07/2024", urn:"urn:lex:br:federal:lei:2024-07-05;14918", ementa:"Denomina Perimetral Sérgio Lobato Machado o trecho rodoviário que liga a rodovia BR-277 à ponte internacional da integração sobre o rio Paraná, na fronteira entre o Brasil e o Paraguai, no Município de Foz do Iguaçu, no Estado do Paraná.", arquivo:"federal/leis-ordinarias/2024/lei-14918-2024-07-05.md"}}, {id:"federal:BR:L:14829/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-03-26", numero:"14829", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-03-26;14829", vigente:true, titulo:"Lei nº 14.829 de 26/03/2024", urn:"urn:lex:br:federal:lei:2024-03-26;14829", ementa:"Reconhece a Festa de Nossa Senhora Achiropita, realizada no Município de São Paulo, no Estado de São Paulo, como manifestação da cultura nacional.", arquivo:"federal/leis-ordinarias/2024/lei-14829-2024-03-26.md"}}, {id:"federal:BR:L:14853/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-05-09", numero:"14853", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-05-09;14853", vigente:true, titulo:"Lei nº 14.853 de 09/05/2024", urn:"urn:lex:br:federal:lei:2024-05-09;14853", ementa:"Denomina \"Antônio Carlos Belchior\" o Terminal Marítimo de Passageiros do Porto de Fortaleza, no Estado do Ceará.", arquivo:"federal/leis-ordinarias/2024/lei-14853-2024-05-09.md"}}, {id:"federal:BR:L:15025/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-11-13", numero:"15025", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-11-13;15025", vigente:true, titulo:"Lei nº 15.025 de 13/11/2024", urn:"urn:lex:br:federal:lei:2024-11-13;15025", ementa:"Abre crédito extraordinário em favor dos Ministérios da Educação e da Cultura e de Operações Oficiais de Crédito, no valor de R$ 1.454.799.092,00 (um bilhão quatrocentos e cinquenta e quatro milhões setecentos e noventa e nove mil e noventa e dois reais), para os fins que especifica.", arquivo:"federal/leis-ordinarias/2024/lei-15025-2024-11-13.md"}}, {id:"federal:BR:L:14934/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-07-25", numero:"14934", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-07-25;14934", vigente:true, titulo:"Lei nº 14.934 de 25/07/2024", urn:"urn:lex:br:federal:lei:2024-07-25;14934", ementa:"Prorroga, até 31 de dezembro de 2025, a vigência do Plano Nacional de Educação, aprovado por meio da Lei nº 13.005, de 25 de junho de 2014.", arquivo:"federal/leis-ordinarias/2024/lei-14934-2024-07-25.md"}}, {id:"federal:BR:L:14928/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-07-22", numero:"14928", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-07-22;14928", vigente:true, titulo:"Lei nº 14.928 de 22/07/2024", urn:"urn:lex:br:federal:lei:2024-07-22;14928", ementa:"Denomina \"Viaduto Vicente Vitagliano\" o viaduto localizado no km 72,8 da rodovia BR-153, no Município de São José do Rio Preto, Estado de São Paulo.", arquivo:"federal/leis-ordinarias/2024/lei-14928-2024-07-22.md"}}, {id:"federal:BR:L:15014/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-11-06", numero:"15014", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-11-06;15014", vigente:true, titulo:"Lei nº 15.014 de 06/11/2024", urn:"urn:lex:br:federal:lei:2024-11-06;15014", ementa:"Altera a Lei nº 11.350, de 5 de outubro de 2006, para prever a concessão de indenização de transporte ao Agente Comunitário de Saúde e ao Agente de Combate às Endemias como forma de custeio de locomoção.", arquivo:"federal/leis-ordinarias/2024/lei-15014-2024-11-06.md"}}, {id:"federal:BR:L:14982/2024", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-09-20", numero:"14982", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-09-20;14982", vigente:true, titulo:"Lei nº 14.982 de 20/09/2024", urn:"urn:lex:br:federal:lei:2024-09-20;14982", ementa:"Dispõe sobre regras aplicáveis às vantagens pessoais nominalmente identificáveis dos servidores ativos e inativos e dos pensionistas do Quadro de Pessoal do Senado Federal.", arquivo:"federal/leis-ordinarias/2024/lei-14982-2024-09-20.md"}}, {id:"federal:BR:L:14876/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-05-31", numero:"14876", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-05-31;14876", vigente:true, titulo:"Lei nº 14.876 de 31/05/2024", urn:"urn:lex:br:federal:lei:2024-05-31;14876", ementa:"Altera a descrição do Código 20 do Anexo VIII da Lei nº 6.938, de 31 de agosto de 1981, acrescido pela Lei nº 10.165, de 27 de dezembro de 2000, para excluir a silvicultura do rol de atividades potencialmente poluidoras e utilizadoras de recursos ambientais.", arquivo:"federal/leis-ordinarias/2024/lei-14876-2024-05-31.md"}}, {id:"federal:BR:L:14971/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-09-13", numero:"14971", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-09-13;14971", vigente:true, titulo:"Lei nº 14.971 de 13/09/2024", urn:"urn:lex:br:federal:lei:2024-09-13;14971", ementa:"Institui o Dia Nacional do Guia de Turismo.", arquivo:"federal/leis-ordinarias/2024/lei-14971-2024-09-13.md"}}, {id:"federal:BR:L:14905/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, da