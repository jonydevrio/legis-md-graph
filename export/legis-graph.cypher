04-08;6523", vigente:true, titulo:"Lei nº 6.523 de 08/04/1978", urn:"urn:lex:br:federal:lei:1978-04-08;6523", ementa:"Autoriza a doação ao Montepio Geral de Economia dos Servidores do Estado   do terreno que menciona, situado na Cidade e Estado do Rio de   Janeiro.", arquivo:"federal/leis-ordinarias/1978/lei-6523-1978-04-08.md"}}, {id:"federal:BR:L:6550/1978", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-07-05", numero:"6550", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-07-05;6550", vigente:true, titulo:"Lei nº 6.550 de 05/07/1978", urn:"urn:lex:br:federal:lei:1978-07-05;6550", ementa:"Estabelece diretrizes para a classificação de cargos, empregos e funções do Serviço Civil dos Territórios Federais, e dá outras providências.", arquivo:"federal/leis-ordinarias/1978/lei-6550-1978-07-05.md"}}, {id:"federal:BR:L:6544/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-06-30", numero:"6544", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-06-30;6544", vigente:true, titulo:"Lei nº 6.544 de 30/06/1978", urn:"urn:lex:br:federal:lei:1978-06-30;6544", ementa:"Altera dispositivos do Código Penal Militar (Decreto-Lei nº 1.001, de 21 de outubro de 1969) e do Código de Processo Penal Militar (Decreto-Lei nº 1002, de 21 de outubro de 1969) e dá outras providências.", arquivo:"federal/leis-ordinarias/1978/lei-6544-1978-06-30.md"}}, {id:"federal:BR:L:6615/1978", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-12-16", numero:"6615", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-12-16;6615", vigente:true, titulo:"Lei nº 6.615 de 16/12/1978", urn:"urn:lex:br:federal:lei:1978-12-16;6615", ementa:"Dispõe sobre a regulamentação da profissão de Radialista 