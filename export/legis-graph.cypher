federal/leis-ordinarias/1950/lei-1102-1950-05-18.md"}}, {id:"federal:BR:L:1131/1950", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-06-13", numero:"1131", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-06-13;1131", vigente:true, titulo:"Lei nº 1.131 de 13/06/1950", urn:"urn:lex:br:federal:lei:1950-06-13;1131", ementa:"Renova autorização concedida ao Jockey Club Brasileiro pelos Decretos-leis nºs 338, de 1938, e 6.614, de 1944.", arquivo:"federal/leis-ordinarias/1950/lei-1131-1950-06-13.md"}}, {id:"federal:BR:L:1227/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-11-11", numero:"1227", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-11-11;1227", vigente:true, titulo:"Lei nº 1.227 de 11/11/1950", urn:"urn:lex:br:federal:lei:1950-11-11;1227", ementa:"Autoriza a abertura de crédito especial, ao Poder Judiciário, para   pagamento ao Tribunal Regional Eleitoral do Ceará.", arquivo:"federal/leis-ordinarias/1950/lei-1227-1950-11-11.md"}}, {id:"federal:BR:L:1305/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-12-31", numero:"1305", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-12-31;1305", vigente:true, titulo:"Lei nº 1.305 de 31/12/1950", urn:"urn:lex:br:federal:lei:1950-12-31;1305", ementa:"Autoriza a abertura do crédito especial de Cr$ 25.829.809,70, para   pagamento à Companhia Ferroviária Este Brasileiro.", arquivo:"federal/leis-ordinarias/1950/lei-1305-1950-12-31.md"}}, {id:"federal:BR:L:1150/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-06-30", numero:"1150", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-06-30;1150", vigente:true, titulo