is-ordinarias/1974/lei-6037-1974-05-02.md"}}, {id:"federal:BR:L:6072/1974", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-07-10", numero:"6072", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1974-07-10;6072", vigente:true, titulo:"Lei nº 6.072 de 10/07/1974", urn:"urn:lex:br:federal:lei:1974-07-10;6072", ementa:"Fixa os valores dos níveis de vencimentos do Grupo-Direção e   Assessoramento Superiores do Quadro Permanente da Secretaria do Tribunal   Regional do Trabalho da Primeira Região e dá outras providências.", arquivo:"federal/leis-ordinarias/1974/lei-6072-1974-07-10.md"}}, {id:"federal:BR:L:6100/1974", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-09-12", numero:"6100", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1974-09-12;6100", vigente:true, titulo:"Lei nº 6.100 de 12/09/1974", urn:"urn:lex:br:federal:lei:1974-09-12;6100", ementa:"Autoriza o Poder Executivo a promover a subscrição no aumento de capital   da Companhia Vale do Rio Doce - CVRD, e dá outras providências.", arquivo:"federal/leis-ordinarias/1974/lei-6100-1974-09-12.md"}}, {id:"federal:BR:L:6024/1974", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-03-13", numero:"6024", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1974-03-13;6024", vigente:true, titulo:"Lei nº 6.024 de 13/03/1974", urn:"urn:lex:br:federal:lei:1974-03-13;6024", ementa:"Dispõe sobre a intervenção e a liquidação extrajudicial de instituições financeiras, e dá outras providências.", arquivo:"federal/leis-ordinarias/1974/lei-6024-1974-03-13.md"}}, {id:"federal:BR:L:6198/1974", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-12-26", numero:"6198", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1974-12-26;6198", vigente:true, titulo:"Lei nº 6.198 de 26/12/1974", urn:"urn:lex:br:federal:lei:1974-12-26;6198", ementa:"Dispõe sobre a inspeção e a fiscalização obrigatórias dos produtos destinados à alimentação animal e dá outras providências.", arquivo:"federal/leis-ordinarias/1974/lei-6198-1974-12-26.md"}}, {id:"federal:BR:L:6096/1974", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-09-05", numero:"6096", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1974-09-05;6096", vigente:true, titulo:"Lei nº 6.096 de 05/09/1974", urn:"urn:lex:br:federal:lei:1974-09-05;6096", ementa:"Prorroga o prazo estabelecido no parágrafo único do artigo 1º, da Lei nº   5.802, de 11 de setembro de 1972, que dispõe sobre a inscrição em prova de   habilitação à livre-docência e dá outras providências.", arquivo:"federal/leis-ordinarias/1974/lei-6096-1974-09-05.md"}}, {id:"federal:BR:L:6130/1974", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-11-07", numero:"6130", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1974-11-07;6130", vigente:true, titulo:"Lei nº 6.130 de 07/11/1974", urn:"urn:lex:br:federal:lei:1974-11-07;6130", ementa:"Autoriza a Superintendência do Desenvolvimento da Região Centro-Oeste   (SUDECO) a alienar bens integrantes do seu patrimônio.", arquivo:"federal/leis-ordinarias/1974/lei-6130-1974-11-07.md"}}, {id:"federal:BR:L:6087/1974", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-07-16", numero:"6087", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1974-07-16;6087", vigente:true, titulo:"Lei nº 6.087 de 16/07/1974", urn:"urn:lex:br:federal:lei:1974-07-16;6087", ementa:"Dá nova redação ao ;§ 3º do Artigo 654 da Consolidação das Leis do Trabalho, aprovada pelo Decreto-lei número 5.452, de 1º de maio de 1943.", arquivo:"federal/leis-ordinarias/1974/lei-6087-1974-07-16.md"}}, {id:"federal:BR:L:6033/1974", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-04-30", numero:"6033", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1974-04-30;6033", vigente:true, titulo:"Lei nº 6.033 de 30/04/1974", urn:"urn:lex:br:federal:lei:1974-04-30;6033", ementa:"Fixa os valores de vencimentos dos cargos dos Grupos- Atividades de Apoio Judiciário, Serviços Auxiliares, Transporte Oficial e Portaria, Artesanato, outras Atividades de Nível Superior ;e Outras Atividades de Nível Médio, do Quadro Permanente da Secretaria do Tribunal Superior Eleitoral, e dá outras providências.", arquivo:"federal/leis-ordinarias/1974/lei-6033-1974-04-30.md"}}, {id:"federal:BR:L:6066/1974", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-07-02", numero:"6066", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1974-07-02;6066", vigente:true, titulo:"Lei nº 6.066 de 02/07/1974", urn:"urn:lex:br:federal:lei:1974-07-02;6066", ementa:"Autoriza a doação, pelo Departamento Nacional de Obras Contra as Secas   (DNOCS), da área de terreno que menciona, situada no Município de Santa Luzia,   no Estado da Paraíba.", arquivo:"federal/leis-ordinarias/1974/lei-6066-1974-07-02.md"}}, {id:"federal:BR:L:6143/1974", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-11-29", numero:"6143", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1974-11-29;6143", vigente:true, titulo:"Lei nº 6.143 de 29/11/1974", urn:"urn:lex:br:federal:lei:1974-11-29;6143", ementa:"Autoriza a União a subscrever ações no aumento do capital social do Banco   Nacional de Crédito Cooperativo S.A., e dá outras providências.", arquivo:"federal/leis-ordinarias/1974/lei-6143-1974-11-29.md"}}, {id:"federal:BR:L:6111/1974", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-10-01", numero:"6111", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1974-10-01;6111", vigente:true, titulo:"Lei nº 6.111 de 01/10/1974", urn:"urn:lex:br:federal:lei:1974-10-01;6111", ementa:"Reajusta o valor de gratificações, na Justiça Eleitoral, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1974/lei-6111-1974-10-01.md"}}, {id:"federal:BR:L:6171/1974", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-12-09", numero:"6171", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1974-12-09;6171", vigente:true, titulo:"Lei nº 6.171 de 09/12/1974", urn:"urn:lex:br:federal:lei:1974-12-09;6171", ementa:"Extingue o Departamento Nacional de Estradas de Ferro e dá outras providências.", arquivo:"federal/leis-ordinarias/1974/lei-6171-1974-12-09.md"}}, {id:"federal:BR:L:6026/1974", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-04-09", numero:"6026", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1974-04-09;6026", vigente:true, titulo:"Lei nº 6.026 de 09/04/1974", urn:"urn:lex:br:federal:lei:1974-04-09;6026", ementa:"Fixa o valor do Nível de vencimento do Grupo-Direção e Assessoramento   Superiores, do Quadro Permanente das Secretarias das Seções Judiciárias da   Justiça Federal de Primeira Instância e dá outras providências.", arquivo:"federal/leis-ordinarias/1974/lei-6026-1974-04-09.md"}}, {id:"federal:BR:L:6046/1974", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-05-15", numero:"6046", fonte:"https://normas.leg.br/?urn=urn:l