em:"revogada=false", ano:1996, data:"1996-12-12", numero:"9352", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-12-12;9352", vigente:true, titulo:"Lei nº 9.352 de 12/12/1996", urn:"urn:lex:br:federal:lei:1996-12-12;9352", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento Fiscal da União, em favor do Estado-Maior das Forças Armadas e do Ministério da Marinha, crédito suplementar no valor global de R$ 23.073.685,00, para os fins que especifica", arquivo:"federal/leis-ordinarias/1996/lei-9352-1996-12-12.md"}}, {id:"federal:BR:L:9287/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1996, data:"1996-06-27", numero:"9287", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-06-27;9287", vigente:true, titulo:"Lei nº 9.287 de 27/06/1996", urn:"urn:lex:br:federal:lei:1996-06-27;9287", ementa:"Autoriza ao Poder Executivo a abrir ao Orçamento da Seguridade Social da União, em favor de diversos Órgãos do Poder Executivo, crédito suplementar no valor de R$ 1.662.450.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1996/lei-9287-1996-06-27.md"}}, {id:"federal:BR:L:9255/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1996, data:"1996-01-03", numero:"9255", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-01-03;9255", vigente:true, titulo:"Lei nº 9.255 de 03/01/1996", urn:"urn:lex:br:federal:lei:1996-01-03;9255", ementa:"Autoriza o Poder Executivo a conceder pensão especial a Lúcia de Oliveira Menezes, tetraneta de Joaquim José da Silva Xavier, o Tiradentes.", arquivo:"federal/leis-ordinarias/1996/lei-9255-1996-01-03.md"}}, {id:"federal:BR:L:9316/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1996, data:"1996-11-22", numero:"9316", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-11-22;9316", vigente:true, titulo:"Lei nº 9.316 de 22/11/1996", urn:"urn:lex:br:federal:lei:1996-11-22;9316", ementa:"Altera a legislação do imposto de renda e da contribuição social sobre o lucro liquido.", arquivo:"federal/leis-ordinarias/1996/lei-9316-1996-11-22.md"}}, {id:"federal:BR:L:9323/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1996, data:"1996-12-05", numero:"9323", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-12-05;9323", vigente:true, titulo:"Lei nº 9.323 de 05/12/1996", urn:"urn:lex:br:federal:lei:1996-12-05;9323", ementa:"Altera o limite de dedução de que trata o § 2º do art. 1º da Lei nº 8.685, de 20 de julho de 1993, que cria mecanismos de fomento à atividade audiovisual, e dá outras providências.", arquivo:"federal/leis-ordinarias/1996/lei-9323-1996-12-05.md"}}, {id:"federal:BR:L:9360/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1996, data:"1996-12-13", numero:"9360", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-12-13;9360", vigente:true, titulo:"Lei nº 9.360 de 13/12/1996", urn:"urn:lex:br:federal:lei:1996-12-13;9360", ementa:"Dá nova redação ao parágrafo único do art.1º da Lei n. 8995, de 24 de fevereiro de 1995, que autoriza o Ministério dos Transportes, por intermédio da Companhia Brasileira de Trens Urbanos - CBTU, a transferir à Companhia Fluminense de Trens Urbanos FLUMITRENS, recursos para pagamento de pessoal.", arquivo:"federal/leis-ordinarias/1996/lei-9360-1996-12-13.md"}}, {id:"federal:BR:L:2913/1879", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1879, data:"1879-08-30", numero:"2913", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1879-08-30;2913", vigente:true, titulo:"Lei nº 2.913 de 30/08/1879", urn:"urn:lex:br:federal:lei:1879-08-30;2913", ementa:"CONCEDE AO MINISTERIO DOS NEGOCIOS DO IMPERIO, POR CONTA DO EXERCITO DE 1878-1879, OS CREDITOS SUPLEMENTARES DE 288:580$645 A VERBA-CAMARA DOS SENADORES E 392:193$548 A VERBA-CAMARA DOS DEPUTADOS- PARA PAGAMENTO DO SUBSIDIO E DAS DESPESAS COM A PUBLICAÇÃO DOS DEBATES, A CONTAR DE 3 DE MAIO A 30 DE JUNHO FINDO.", arquivo:"federal/leis-ordinarias/1879/lei-2913-1879-08-30.md"}}, {id:"federal:BR:L:2941/1879", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1879, data:"1879-11-08", numero:"2941", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1879-11-08;2941", vigente:true, titulo:"Lei nº 2.941 de 08/11/1879", urn:"urn:lex:br:federal:lei:1879-11-08;2941", ementa:"FIXA A FORÇA NAVAL PARA O ANO FINANCEIRO DE 1880-1881.", arquivo:"federal/leis-ordinarias/1879/lei-2941-1879-11-08.md"}}, {id:"federal:BR:L:2934/1879", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1879, data:"1879-10-25", numero:"2934", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1879-10-25;2934", vigente:true, titulo:"Lei nº 2.934 de 25/10/1879", urn:"urn:lex:br:federal:lei:1879-10-25;2934", ementa:"CONCEDE AO MINISTERIO DOS NEGOCIOS DO IMPERIO UM CREDITO EXTRAORDINARIO DE 558:692$872, AFIM DE OCORRER A DESPESAS COM AS OBRAS DE CONCLUSÃO DO NOVO MATADOURO, QUE SE ESTA CONSTRUINDO NO CURATO DE SANTA CRUZ, E AUTORIZA O DOS NEGOCIOS DA FAZENDA A FAZER AS OPERAÇÕES DE CREDITO, QUE FOREM PRECISAS PARA REALIZAÇÃO DE TAIS DESPESAS.", arquivo:"federal/leis-ordinarias/1879/lei-2934-1879-10-25.md"}}, {id:"federal:BR:L:2927/1879", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1879, data:"1879-10-18", numero:"2927", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1879-10-18;2927", vigente:true, titulo:"Lei nº 2.927 de 18/10/1879", urn:"urn:lex:br:federal:lei:1879-10-18;2927", ementa:"CONCEDE AO MINISTERIO DOS NEGOCIOS ESTRANGEIROS UM CREDITO EXTRAORDINARIO DE CENTO E VINTE CONTOS DE REIS AO CAMBIO DE VINTE E SETE DINHEIROS ESTERLINOS POR MIL REIS, PARA SER APLICADO AS DESPESAS DA MISSÃO ESPECIAL, QUE TEM DE SER ENVIADA A CHINA.", arquivo:"federal/leis-ordinarias/1879/lei-2927-1879-10-18.md"}}, {id:"federal:BR:L:2915/1879", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1879, data:"1879-08-30", numero:"2915", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1879-08-30;2915", vigente:true, titulo:"Lei nº 2.915 de 30/08/1879", urn:"urn:lex:br:federal:lei:1879-08-30;2915", ementa:"ABRE, AO MINISTERIO DOS NEGOCIOS ESTRANGEIROS, UM CREDITO SUPLEMENTAR DE UM CONTO E SETENTA E SEIS MIL E SEICENTOS E SETENTA E NOVE REIS, PARA SER APLICADO AO PAGAMENTO DA DESPESA COM EMPREGADOS EM DISPONIBILIDADE NO EXERCICIO DE 1878-1879.", arquivo:"federal/leis-ordinarias/1879/lei-2915-1879-08-30.md"}}, {id:"federal:BR:L:2940/1879", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1879, data:"1879-10-31", numero:"2940", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1879-10-31;2940", vigente:true, titulo:"Lei nº 2.940 de 31/10/1879", urn:"urn:lex:br:federal:lei:1879-10-31;2940", ementa:"FIXA A DESPESA E ORÇA A RECEITA GERAL DO IMPERIO PARA OS EXERCICIOS DE 1879-1880 E 1880-1881, E DA OUTRAS PROVIDENCIAS.", arquivo:"federal/leis-ordinarias/1879/lei-2940-1879-10-31.md"}}, {id:"federal:BR:L:2942/1879", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1879, data:"1879-11-08", numero:"2942", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1879-11-08;2942", vigente:true, titulo:"Lei nº 2.942 de 08/11/1879", urn:"urn:lex:br:federal:lei:1879-11-08;2942", ementa:"FIXA AS FORÇAS DA TERRA PARA O ANO FINANCEIRO DE 1880-1881.", arquivo:"federal/leis-ordinarias/1879/lei-2942-1879-11-08.md"}}, {id:"federal:BR:L:2897/1879", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1879, data:"1879-08-09", numero:"2897", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1879-08-09;2897", vigente:true, titulo:"Lei nº 2.897 de 09/08/1879", urn:"urn:lex:br:federal:lei:1879-08-09;2897", ementa:"ABRE AO GOVERNO, PELO MINISTERIO DA FAZENDA, UM CREDITO SUPLEMENTAR E EXTRAORDINARIO DE 4.292:137$676.", arquivo:"federal/leis-ordinarias/1879/lei-2897-1879-08-09.md"}}, {id:"federal:BR:L:2914/1879", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1879, data:"1879-08-30", numero:"2914", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1879-08-30;2914", vigente:true, titulo:"Lei nº 2.914 de 30/08/1879", urn:"urn:lex:br:federal:lei:1879-08-30;2914", ementa:"CONCEDE AO MINISTERIO DOS NEGOCIOS DO IMPERIO, POR CONTA DO EXERCICIO DE 1878-1879, O CREDITO SUPLEMENTAR DE 280:746$221 PARA CONTINUAÇÃO DAS DESPESAS DA VERBA- SOCORROS PUBLICOS E MELHORAMENTO  DO ESTADO SANITARIO.", arquivo:"federal/leis-ordinarias/1879/lei-2914-1879-08-30.md"}}, {id:"federal:BR:L:2880/1879", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1879, data:"1879-06-30", numero:"2880", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1879-06-30;2880", vigente:true, titulo:"Lei nº 2.880 de 30/06/1879", urn:"urn:lex:br:federal:lei:1879-06-30;2880", ementa:"FIXA A FORÇA NAVAL PARA O ANO FINANCEIRO DE 1879-1880.", arquivo:"federal/leis-ordinarias/1879/lei-2880-1879-06-30.md"}}, {id:"federal:BR:L:2924/1879", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1879, data:"1879-09-27", numero:"2924", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1879-09-27;2924", vigente:true, titulo:"Lei nº 2.924 de 27/09/1879", urn:"urn:lex:br:federal:lei:1879-09-27;2924", ementa:"ABRE, AO MINISTERIO DA MARINHA, UM CREDITO DE NOVE CONTOS E QUINHENTOS TRINTA E TRES MIL E TREZENTOS E VINTE OITO REIS (9:523$328) , PARA PAGAMENTO DAS GRATIFICAÇÕES QUE POR LEI FOREM DEVIDAS AOS EMPREGADOS DA REPARTIÇÃO HIDROGRAFICA NOS EXERCICIOS DE 1877-1879.", arquivo:"federal/leis-ordinarias/1879/lei-2924-1879-09-27.md"}}, {id:"federal:BR:L:2879/1879", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1879, data:"1879-06-30", numero:"2879", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1879-06-30;2879", vigente:true, titulo:"Lei nº 2.879 de 30/06/1879", urn:"urn:lex:br:federal:lei:1879-06-30;2879", ementa:"FIXA AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1879-1880.", arquivo:"federal/leis-ordinarias/1879/lei-2879-1879-06-30.md"}}, {id:"federal:BR:L:2909/1879", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1879, data:"1879-08-30", numero:"2909", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1879-08-30;2909", vigente:true, titulo:"Lei nº 2.909 de 30/08/1879", urn:"urn:lex:br:federal:lei:1879-08-30;2909", ementa:"ABRE AO GOVERNO, PELO MINISTERIO DA GUERRA, UM CREDITO SUPLEMENTAR DE 654:150$313.", arquivo:"federal/leis-ordinarias/1879/lei-2909-1879-08-30.md"}}, {id:"federal:BR:L:2823/1879", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1879, data:"1879-02-15", numero:"2823", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1879-02-15;2823", vigente:true, titulo:"Lei nº 2.823 de 15/02/1879", urn:"urn:lex:br:federal:lei:1879-02-15;2823", ementa:"FIXA A FORÇA NAVAL PARA O ANO FINANCEIRO DE 1878 A 1879.", arquivo:"federal/leis-ordinarias/1879/lei-2823-1879-02-15.md"}}, {id:"federal:BR:L:2852/1879", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1879, data:"1879-05-03", numero:"2852", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1879-05-03;2852", vigente:true, titulo:"Lei nº 2.852 de 03/05/1879", urn:"urn:lex:br:federal:lei:1879-05-03;2852", ementa:"FIXA AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1878-1879.", arquivo:"federal/leis-ordinarias/1879/lei-2852-1879-05-03.md"}}, {id:"federal:BR:L:4703/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-28", numero:"4703", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-28;4703", vigente:true, titulo:"Lei nº 4.703 de 28/06/1965", urn:"urn:lex:br:federal:lei:1965-06-28;4703", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações   Exteriores, o crédito especial de Cr$ 370.000.000 (trezentos e setenta milhões   de cruzeiros), para atender às despesas decorrentes da realização da Segunda   Conferência Interamericana Extraordinária.", arquivo:"federal/leis-ordinarias/1965/lei-4703-1965-06-28.md"}}, {id:"federal:BR:L:4779/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-09-28", numero:"4779", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-09-28;4779", vigente:true, titulo:"Lei nº 4.779 de 28/09/1965", urn:"urn:lex:br:federal:lei:1965-09-28;4779", ementa:"Retifica, sem aumento de despesa, a Lei nº 4.539, de 10 de dezembro de   1964, que estima a receita e fixa a despesa para o exercício financeiro de   1965.", arquivo:"federal/leis-ordinarias/1965/lei-4779-1965-09-28.md"}}, {id:"federal:BR:L:4876/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-02", numero:"4876", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-02;4876", vigente:true, titulo:"Lei nº 4.876 de 02/12/1965", urn:"urn:lex:br:federal:lei:1965-12-02;4876", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações Exteriores, o crédito especial de Cr$ 5.810.000, para atender às despesas complementares com o comparecimento do Clero brasileiro ao \"Concílio Ecumênico Vaticano II\".", arquivo:"federal/leis-ordinarias/1965/lei-4876-1965-12-02.md"}}, {id:"federal:BR:L:4692/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-21", numero:"4692", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-21;4692", vigente:true, titulo:"Lei nº 4.692 de 21/06/1965", urn:"urn:lex:br:federal:lei:1965-06-21;4692", ementa:"Isenta dos impostos de importação e de consumo, bem como da taxa de   despacho aduaneiro, um automóvel \"Chevrolet Impala\", de propriedade de Ieda   Maria Vargas.", arquivo:"federal/leis-ordinarias/1965/lei-4692-1965-06-21.md"}}, {id:"federal:BR:L:4762/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-08-30", numero:"4762", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-08-30;4762", vigente:true, titulo:"Lei nº 4.762 de 30/08/1965", urn:"urn:lex:br:federal:lei:1965-08-30;4762", ementa:"Modifica o art. 11 e seus parágrafos da Lei nº 1.493, de 13 de dezembro de 1951, alterados pela Lei nº 2.266, de 12 de julho de 1954, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4762-1965-08-30.md"}}, {id:"federal:BR:L:4797/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-20", numero:"4797", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-20;4797", vigente:true, titulo:"Lei nº 4.797 de 20/10/1965", urn:"urn:lex:br:federal:lei:1965-10-20;4797", ementa:"Torna obrigatório, pelas empresas concessionárias de serviços públicos, o   emprego de madeiras preservadas e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4797-1965-10-20.md"}}, {id:"federal:BR:L:4829/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-05", numero:"4829", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-05;4829", vigente:true, titulo:"Lei nº 4.829 de 05/11/1965", urn:"urn:lex:br:federal:lei:1965-11-05;4829", ementa:"Institucionaliza o crédito rural.", arquivo:"federal/leis-ordinarias/1965/lei-4829-1965-11-05.md"}}, {id:"federal:BR:L:4711/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-29", numero:"4711", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-29;4711", vigente:true, titulo:"Lei nº 4.711 de 29/06/1965", urn:"urn:lex:br:federal:lei:1965-06-29;4711", ementa:"Estende aos remanescentes ou reformados da extinta Polícia Militar do antigo Território do Acre as disposições da Lei nº 4.328, de 30 de abril de 1964, que institui o nôvo Código de Vencimentos dos Militares.", arquivo:"federal/leis-ordinarias/1965/lei-4711-1965-06-29.md"}}, {id:"federal:BR:L:4734/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-14", numero:"4734", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-14;4734", vigente:true, titulo:"Lei nº 4.734 de 14/07/1965", urn:"urn:lex:br:federal:lei:1965-07-14;4734", ementa:"Estabelece normas para o aproveitamento, como servidores civis efetivos,   dos militares remanescentes das extintas Companhias de Serviço   Industrial.", arquivo:"federal/leis-ordinarias/1965/lei-4734-1965-07-14.md"}}, {id:"federal:BR:L:4657/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-02", numero:"4657", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-02;4657", vigente:true, titulo:"Lei nº 4.657 de 02/06/1965", urn:"urn:lex:br:federal:lei:1965-06-02;4657", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras Públicas, o crédito especial de Cr$ 10.998.000.000 (dez bilhões, novecentos e noventa e oito milhões de cruzeiros), destinado ao refôrço do Fundo da Marinha Mercante.", arquivo:"federal/leis-ordinarias/1965/lei-4657-1965-06-02.md"}}, {id:"federal:BR:L:4745/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-21", numero:"4745", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-21;4745", vigente:true, titulo:"Lei nº 4.745 de 21/07/1965", urn:"urn:lex:br:federal:lei:1965-07-21;4745", ementa:"Autoriza a abertura, pelo Ministério da Viação e Obras Públicas, do   crédito especial de Cr$ 200.000.000 ( duzentos milhões de cruzeiros ), para   reconstrução da ponte sôbre o Rio da Prata, no trecho João Pinheiro -   Paracatu.", arquivo:"federal/leis-ordinarias/1965/lei-4745-1965-07-21.md"}}, {id:"federal:BR:L:4854/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-25", numero:"4854", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-25;4854", vigente:true, titulo:"Lei nº 4.854 de 25/11/1965", urn:"urn:lex:br:federal:lei:1965-11-25;4854", ementa:"Modifica o art. 115 da Lei nº 1.711, de 28 de outubro de 1952 (Estatuto dos Funcionários Públicos Civis da União).", arquivo:"federal/leis-ordinarias/1965/lei-4854-1965-11-25.md"}}, {id:"federal:BR:L:4760/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-08-23", numero:"4760", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-08-23;4760", vigente:true, titulo:"Lei nº 4.760 de 23/08/1965", urn:"urn:lex:br:federal:lei:1965-08-23;4760", ementa:"Estende aos guardas-civis dos Estados e Territórios o benefício previsto no art. 295 do Código de Processo Penal.", arquivo:"federal/leis-ordinarias/1965/lei-4760-1965-08-23.md"}}, {id:"federal:BR:L:4647/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-31", numero:"4647", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-31;4647", vigente:true, titulo:"Lei nº 4.647 de 31/05/1965", urn:"urn:lex:br:federal:lei:1965-05-31;4647", ementa:"Autoriza o Poder Executivo a abrir, pela Presidência da República, o   crédito especial de Cr$ 4.362.416,00 (quatro milhões trezentos e sessenta e dois   mil quatrocentos e dezesseis cruzeiros), para atender a despesas que especifica,   a cargo do Estado Maior das Forças Armadas.", arquivo:"federal/leis-ordinarias/1965/lei-4647-1965-05-31.md"}}, {id:"federal:BR:L:4683/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-21", numero:"4683", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-21;4683", vigente:true, titulo:"Lei nº 4.683 de 21/06/1965", urn:"urn:lex:br:federal:lei:1965-06-21;4683", ementa:"Isenta dos impostos de importação e de consumo equipamento telefônico   destinado à Emprêsa Telefônica de Uberaba S.A.", arquivo:"federal/leis-ordinarias/1965/lei-4683-1965-06-21.md"}}, {id:"federal:BR:L:4915/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-17", numero:"4915", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-17;4915", vigente:true, titulo:"Lei nº 4.915 de 17/12/1965", urn:"urn:lex:br:federal:lei:1965-12-17;4915", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Guerra o crédito especial de Cr$ 2.070.000.000,00 (dois bilhões e setenta milhões de cruzeiros), destinado a atender a despesas com a Fábrica Presidente Vargas, em Piquête.", arquivo:"federal/leis-ordinarias/1965/lei-4915-1965-12-17.md"}}, {id:"federal:BR:L:4721/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-09", numero:"4721", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-09;4721", vigente:true, titulo:"Lei nº 4.721 de 09/07/1965", urn:"urn:lex:br:federal:lei:1965-07-09;4721", ementa:"Fixa os valôres para os símbolos dos cargos e das funções gratificadas do Quadro do Pessoal da Secretaria do Tribunal Regional do Trabalho da 2ª Região, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4721-1965-07-09.md"}}, {id:"federal:BR:L:4633/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-18", numero:"4633", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-18;4633", vigente:true, titulo:"Lei nº 4.633 de 18/05/1965", urn:"urn:lex:br:federal:lei:1965-05-18;4633", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Guerra, o crédito especial de Cr$ 2.750.000,00 (dois milhões, setecentos e cinqüenta mil cruzeiros), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4633-1965-05-18.md"}}, {id:"federal:BR:L:4596/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-02-22", numero:"4596", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-02-22;4596", vigente:true, titulo:"Lei nº 4.596 de 22/02/1965", urn:"urn:lex:br:federal:lei:1965-02-22;4596", ementa:"Isenta do impôsto de importação e de consumo equipamento a ser importado   pela Rádio Sociedade Gaúcha S.A.", arquivo:"federal/leis-ordinarias/1965/lei-4596-1965-02-22.md"}}, {id:"federal:BR:L:4867/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-30", numero:"4867", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-30;4867", vigente:true, titulo:"Lei nº 4.867 de 30/11/1965", urn:"urn:lex:br:federal:lei:1965-11-30;4867", ementa:"Concede a pensão especial de Cr$ 66.000 (sessenta e seis mil cruzeiros)   mensais a Maria de Lourdes Corrêa da Silva, viúva do ex-comandante de Guarnição   da Seção de Bombeiros do GEB, Ademar Corrêa da Silva.", arquivo:"federal/leis-ordinarias/1965/lei-4867-1965-11-30.md"}}, {id:"federal:BR:L:4742/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-15", numero:"4742", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-15;4742", vigente:true, titulo:"Lei nº 4.742 de 15/07/1965", urn:"urn:lex:br:federal:lei:1965-07-15;4742", ementa:"Dispõe sôbre o prazo de validade de concursos públicos para candidatos habilitados que estejam exercendo ou hajam assumido mandato legislativo ou executivo.", arquivo:"federal/leis-ordinarias/1965/lei-4742-1965-07-15.md"}}, {id:"federal:BR:L:4834/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-09", numero:"4834", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-09;4834", vigente:true, titulo:"Lei nº 4.834 de 09/11/1965", urn:"urn:lex:br:federal:lei:1965-11-09;4834", ementa:"Autoriza a abertura, pela Secretaria de Finanças da Prefeitura do Distrito Federal, do crédito especial de Cr$ 200.000.000 (duzentos milhões de cruzeiros), para auxílio às obras do Estádio de Brasília.", arquivo:"federal/leis-ordinarias/1965/lei-4834-1965-11-09.md"}}, {id:"federal:BR:L:4780/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-09-28", numero:"4780", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-09-28;4780", vigente:true, titulo:"Lei nº 4.780 de 28/09/1965", urn:"urn:lex:br:federal:lei:1965-09-28;4780", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações   Exteriores, o crédito especial de Cr$ 100.000.000 (cem milhões de cruzeiros)   para atender às despesas decorrentes do reajustamento da contribuição brasileira   ao Fundo Especial de Assistência para o Desenvolvimento.", arquivo:"federal/leis-ordinarias/1965/lei-4780-1965-09-28.md"}}, {id:"federal:BR:L:4668/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-08", numero:"4668", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-08;4668", vigente:true, titulo:"Lei nº 4.668 de 08/06/1965", urn:"urn:lex:br:federal:lei:1965-06-08;4668", ementa:"Revoga o art. 510 da Consolidação das Leis do Trabalho, aprovado pelo   Decreto-lei nº. 5452, de 1º de maio de 1943.", arquivo:"federal/leis-ordinarias/1965/lei-4668-1965-06-08.md"}}, {id:"federal:BR:L:4886/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-09", numero:"4886", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-09;4886", vigente:true, titulo:"Lei nº 4.886 de 09/12/1965", urn:"urn:lex:br:federal:lei:1965-12-09;4886", ementa:"Regula as atividades dos representantes comerciais autônomos.", arquivo:"federal/leis-ordinarias/1965/lei-4886-1965-12-09.md"}}, {id:"federal:BR:L:4811/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-25", numero:"4811", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-25;4811", vigente:true, titulo:"Lei nº 4.811 de 25/10/1965", urn:"urn:lex:br:federal:lei:1965-10-25;4811", ementa:"Concede pensão mensal a Dona Maria Luiza Vitória Ruy Barbosa Guerra.", arquivo:"federal/leis-ordinarias/1965/lei-4811-1965-10-25.md"}}, {id:"federal:BR:L:4622/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-03", numero:"4622", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-03;4622", vigente:true, titulo:"Lei nº 4.622 de 03/05/1965", urn:"urn:lex:br:federal:lei:1965-05-03;4622", ementa:"Concede isenção de tributos para importação de bens e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4622-1965-05-03.md"}}, {id:"federal:BR:L:4830/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-05", numero:"4830", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-05;4830", vigente:true, titulo:"Lei nº 4.830 de 05/11/1965", urn:"urn:lex:br:federal:lei:1965-11-05;4830", ementa:"Prorroga, até 31 de dezembro de 1967, a suspensão da cobrança das taxas   aeroportuárias aplicadas às aeronaves das emprêsas brasileiras na execução de   suas linhas domésticas.", arquivo:"federal/leis-ordinarias/1965/lei-4830-1965-11-05.md"}}, {id:"federal:BR:L:4777/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-09-22", numero:"4777", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-09-22;4777", vigente:true, titulo:"Lei nº 4.777 de 22/09/1965", urn:"urn:lex:br:federal:lei:1965-09-22;4777", ementa:"Estende à Comarca de São Vicente à Jurisdição da Junta de Conciliação e   Julgamento de Santos, no Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1965/lei-4777-1965-09-22.md"}}, {id:"federal:BR:L:4895/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-09", numero:"4895", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-09;4895", vigente:true, titulo:"Lei nº 4.895 de 09/12/1965", urn:"urn:lex:br:federal:lei:1965-12-09;4895", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações   Exteriores, o crédito especial de Cr$ 30.000.000,00 (trinta milhões de   cruzeiros), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4895-1965-12-09.md"}}, {id:"federal:BR:L:4606/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-03-30", numero:"4606", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-03-30;4606", vigente:true, titulo:"Lei nº 4.606 de 30/03/1965", urn:"urn:lex:br:federal:lei:1965-03-30;4606", ementa:"Dispõe sôbre as comemorações do centenário de Epitácio   Pessoa.", arquivo:"federal/leis-ordinarias/1965/lei-4606-1965-03-30.md"}}, {id:"federal:BR:L:4755/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-08-18", numero:"4755", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-08-18;4755", vigente:true, titulo:"Lei nº 4.755 de 18/08/1965", urn:"urn:lex:br:federal:lei:1965-08-18;4755", ementa:"Dispõe sôbre a forma de fixação do impôsto sindical devido pelos   estabelecimentos rurais e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4755-1965-08-18.md"}}, {id:"federal:BR:L:4664/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-08", numero:"4664", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-08;4664", vigente:true, titulo:"Lei nº 4.664 de 08/06/1965", urn:"urn:lex:br:federal:lei:1965-06-08;4664", ementa:"Considera morto em defesa da ordem, das instituições e do regime o   Tenente-Coronel-Aviador Rubens Florentino Vaz.", arquivo:"federal/leis-ordinarias/1965/lei-4664-1965-06-08.md"}}, {id:"federal:BR:L:4675/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-15", numero:"4675", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-15;4675", vigente:true, titulo:"Lei nº 4.675 de 15/06/1965", urn:"urn:lex:br:federal:lei:1965-06-15;4675", ementa:"Autoriza o cancelamento do débito do espólio de Codrato de Vilhena, antigo   Diretor-Gerente da Companhia Nacional de Navegação Costeira, incorporada ao   Patrimônio Nacional.", arquivo:"federal/leis-ordinarias/1965/lei-4675-1965-06-15.md"}}, {id:"federal:BR:L:4729/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-14", numero:"4729", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-14;4729", vigente:true, titulo:"Lei nº 4.729 de 14/07/1965", urn:"urn:lex:br:federal:lei:1965-07-14;4729", ementa:"Define o crime de sonegação fiscal e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4729-1965-07-14.md"}}, {id:"federal:BR:L:4707/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-28", numero:"4707", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-28;4707", vigente:true, titulo:"Lei nº 4.707 de 28/06/1965", urn:"urn:lex:br:federal:lei:1965-06-28;4707", ementa:"Dispõe sôbre transferência de próprio nacional ao Estado de Minas Gerais e   à Prefeitura de Belo Horizonte.", arquivo:"federal/leis-ordinarias/1965/lei-4707-1965-06-28.md"}}, {id:"federal:BR:L:4882/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-09", numero:"4882", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-09;4882", vigente:true, titulo:"Lei nº 4.882 de 09/12/1965", urn:"urn:lex:br:federal:lei:1965-12-09;4882", ementa:"Abre ao Poder Legislativo - Câmara dos Deputados - o crédito suplementar de Cr$ 3.440.000.000, para refôrço de dotações orçamentárias que especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4882-1965-12-09.md"}}, {id:"federal:BR:L:4766/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-08-30", numero:"4766", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-08-30;4766", vigente:true, titulo:"Lei nº 4.766 de 30/08/1965", urn:"urn:lex:br:federal:lei:1965-08-30;4766", ementa:"Dispõe sôbre a elaboração de um Plano Diretor Regional, ao qual ficará   subordinada a utilização das áreas que constituem o Distrito Federal, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4766-1965-08-30.md"}}, {id:"federal:BR:L:4803/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-20", numero:"4803", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-20;4803", vigente:true, titulo:"Lei nº 4.803 de 20/10/1965", urn:"urn:lex:br:federal:lei:1965-10-20;4803", ementa:"Autoriza a abertura, pelo Ministério da Fazenda, o crédito especial de Cr$   820.000.000,00 (oitocentos e vinte milhões de cruzeiros) para ocorrer às   despesas com a mudança da Delegacia Fiscal de São Paulo para o Edifìcio Cibraço.", arquivo:"federal/leis-ordinarias/1965/lei-4803-1965-10-20.md"}}, {id:"federal:BR:L:4863/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-29", numero:"4863", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-29;4863", vigente:true, titulo:"Lei nº 4.863 de 29/11/1965", urn:"urn:lex:br:federal:lei:1965-11-29;4863", ementa:"Reajusta os vencimentos dos servidores civis e militares, altera as alíquotas dos impostos de renda, importação, consumo e sêlo e da quota de previdência social, unifica contribuições baseadas nas fôlhas de salários, e dá outras providências. /Há veto/", arquivo:"federal/leis-ordinarias/1965/lei-4863-1965-11-29.md"}}, {id:"federal:BR:L:4715/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-29", numero:"4715", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-29;4715", vigente:true, titulo:"Lei nº 4.715 de 29/06/1965", urn:"urn:lex:br:federal:lei:1965-06-29;4715", ementa:"Autoriza o Poder Executivo a permutar um terreno de propriedade da União   Federal por outros pertencentes ao Município de Guarapuava, Estado do   Paraná.", arquivo:"federal/leis-ordinarias/1965/lei-4715-1965-06-29.md"}}, {id:"federal:BR:L:4737/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-15", numero:"4737", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-15;4737", titulo:"Lei nº 4.737 de 15/07/1965", vigente:true, urn:"urn:lex:br:federal:lei:1965-07-15;4737", ementa:"Institui o Código Eleitoral.", arquivo:"federal/leis-ordinarias/1965/lei-4737-1965-07-15.md"}}, {id:"federal:BR:L:4846/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-19", numero:"4846", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-19;4846", vigente:true, titulo:"Lei nº 4.846 de 19/11/1965", urn:"urn:lex:br:federal:lei:1965-11-19;4846", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito   especial de Cr$ 58.960.943 (cinqüenta e oito milhões, novecentos e sessenta mil,   novecentos e quarenta e três cruzeiros) para atender a pagamento de vencimentos   e vantagens.", arquivo:"federal/leis-ordinarias/1965/lei-4846-1965-11-19.md"}}, {id:"federal:BR:L:4899/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-10", numero:"4899", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-10;4899", vigente:true, titulo:"Lei nº 4.899 de 10/12/1965", urn:"urn:lex:br:federal:lei:1965-12-10;4899", ementa:"Estima a Receita e fixa a Despesa do Distrito Federal para o Exercício Financeiro de 1966.", arquivo:"federal/leis-ordinarias/1965/lei-4899-1965-12-10.md"}}, {id:"federal:BR:L:4695/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-22", numero:"4695", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-22;4695", vigente:true, titulo:"Lei nº 4.695 de 22/06/1965", urn:"urn:lex:br:federal:lei:1965-06-22;4695", ementa:"Dispõe sôbre a composição do Conselho Federal de Contabilidade e dá outras   providências.", arquivo:"federal/leis-ordinarias/1965/lei-4695-1965-06-22.md"}}, {id:"federal:BR:L:4610/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-03-31", numero:"4610", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-03-31;4610", vigente:true, titulo:"Lei nº 4.610 de 31/03/1965", urn:"urn:lex:br:federal:lei:1965-03-31;4610", ementa:"Fixa novos valôres para os símbolos dos cargos do Quadro de Pessoal da Secretaria do Tribunal Regional do Trabalho da 4ª Região e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4610-1965-03-31.md"}}, {id:"federal:BR:L:4819/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-29", numero:"4819", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-29;4819", vigente:true, titulo:"Lei nº 4.819 de 29/10/1965", urn:"urn:lex:br:federal:lei:1965-10-29;4819", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações   Exteriores, o crédito especial de Cr$ 6.749.890 (seis milhões, setecentos e   quarenta e nove mil, oitocentos e noventa cruzeiros), para regularização de   despesas decorrentes da visita ao Brasil de personalidades ilustres   estrangeiras, no exercício de 1960.", arquivo:"federal/leis-ordinarias/1965/lei-4819-1965-10-29.md"}}, {id:"federal:BR:L:4891/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-09", numero:"4891", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-09;4891", vigente:true, titulo:"Lei nº 4.891 de 09/12/1965", urn:"urn:lex:br:federal:lei:1965-12-09;4891", ementa:"Altera a redação do parágrafo único do art. 32 do Decreto nº 22.239, de 19   de dezembro de 1932, que reforma as disposições do Decreto Legislativo nº 1.637,   de 5 de janeiro de 1907, na parte referente às Cooperativas.", arquivo:"federal/leis-ordinarias/1965/lei-4891-1965-12-09.md"}}, {id:"federal:BR:L:4879/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-03", numero:"4879", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-03;4879", vigente:true, titulo:"Lei nº 4.879 de 03/12/1965", urn:"urn:lex:br:federal:lei:1965-12-03;4879", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério da Justiça e Negócios   Interiores, o crédito especial de Cr$ 800.000.000 (oitocentos milhões de   cruzeiros), destinado a obras de complementação de repartições do D.F.S.P, em   Brasília.", arquivo:"federal/leis-ordinarias/1965/lei-4879-1965-12-03.md"}}, {id:"federal:BR:L:4603/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-03-20", numero:"4603", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-03-20;4603", vigente:true, titulo:"Lei nº 4.603 de 20/03/1965", urn:"urn:lex:br:federal:lei:1965-03-20;4603", ementa:"Concede a denominação de \"Cidade Monumento da História Pátria\" à cidade de   São Vicente, no Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1965/lei-4603-1965-03-20.md"}}, {id:"federal:BR:L:4719/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-06", numero:"4719", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-06;4719", vigente:true, titulo:"Lei nº 4.719 de 06/07/1965", urn:"urn:lex:br:federal:lei:1965-07-06;4719", ementa:"Eleva a pensão especial, concedida aos herdeiros de Clóvis   Bevilacqua.", arquivo:"federal/leis-ordinarias/1965/lei-4719-1965-07-06.md"}}, {id:"federal:BR:L:4919/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-17", numero:"4919", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-17;4919", vigente:true, titulo:"Lei nº 4.919 de 17/12/1965", urn:"urn:lex:br:federal:lei:1965-12-17;4919", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 138.941.000,00 (cento e trinta e oito milhões novecentos e quarenta e um mil cruzeiros), destinado ao pagamento de ações preferenciais subscritas pelo Tesouro Nacional ao aumento de capital da Companhia Vale do Rio Doce.", arquivo:"federal/leis-ordinarias/1965/lei-4919-1965-12-17.md"}}, {id:"federal:BR:L:4687/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-21", numero:"4687", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-21;4687", vigente:true, titulo:"Lei nº 4.687 de 21/06/1965", urn:"urn:lex:br:federal:lei:1965-06-21;4687", ementa:"Dispõe sôbre a aplicação do art. 7º da Lei nº 3.421, de 10 de julho de 1958, que trata do aforamento, pelo Poder Executivo, dos acrescidos de marinha resultantes de obras e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4687-1965-06-21.md"}}, {id:"federal:BR:L:4638/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-26", numero:"4638", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-26;4638", vigente:true, titulo:"Lei nº 4.638 de 26/05/1965", urn:"urn:lex:br:federal:lei:1965-05-26;4638", ementa:"Modifica a redação do art. 14 do Decreto-lei nº 3.199, de 14 de abril de 1941 (que estabelece as bases de organização dos Desportos em todo o País).", arquivo:"federal/leis-ordinarias/1965/lei-4638-1965-05-26.md"}}, {id:"federal:BR:L:4619/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-04-28", numero:"4619", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-04-28;4619", vigente:true, titulo:"Lei nº 4.619 de 28/04/1965", urn:"urn:lex:br:federal:lei:1965-04-28;4619", ementa:"Dispõe sobre a ação regressiva da União contra seus Agentes.", arquivo:"federal/leis-ordinarias/1965/lei-4619-1965-04-28.md"}}, {id:"federal:BR:L:4609/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-03-31", numero:"4609", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-03-31;4609", vigente:true, titulo:"Lei nº 4.609 de 31/03/1965", urn:"urn:lex:br:federal:lei:1965-03-31;4609", ementa:"Fixa novos valores para os símbolos dos cargos e das funções gratificadas do Quadro do Pessoal de Secretaria e Serviços Auxiliares do Tribunal de Justiça do Distrito Federal, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4609-1965-03-31.md"}}, {id:"federal:BR:L:4625/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-13", numero:"4625", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-13;4625", vigente:true, titulo:"Lei nº 4.625 de 13/05/1965", urn:"urn:lex:br:federal:lei:1965-05-13;4625", ementa:"Dá a denominação de \"Rodovia Vital Brasil\" à BR-32.", arquivo:"federal/leis-ordinarias/1965/lei-4625-1965-05-13.md"}}, {id:"federal:BR:L:4730/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-14", numero:"4730", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-14;4730", vigente:true, titulo:"Lei nº 4.730 de 14/07/1965", urn:"urn:lex:br:federal:lei:1965-07-14;4730", ementa:"Transforma a Escola de Medicina e Cirurgia do Rio de Janeiro em Fundação e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4730-1965-07-14.md"}}, {id:"federal:BR:L:4784/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-09-28", numero:"4784", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-09-28;4784", vigente:true, titulo:"Lei nº 4.784 de 28/09/1965", urn:"urn:lex:br:federal:lei:1965-09-28;4784", ementa:"Define a competência dos Estados para a cobrança do impôsto sôbre vendas e consignações.", arquivo:"federal/leis-ordinarias/1965/lei-4784-1965-09-28.md"}}, {id:"federal:BR:L:4670/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-12", numero:"4670", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-12;4670", vigente:true, titulo:"Lei nº 4.670 de 12/06/1965", urn:"urn:lex:br:federal:lei:1965-06-12;4670", ementa:"Altera dispositivos da Lei nº 3.244, de 14 de agôsto de 1957, que autoriza abertura de crédito especial e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4670-1965-06-12.md"}}, {id:"federal:BR:L:4903/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-16", numero:"4903", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-16;4903", vigente:true, titulo:"Lei nº 4.903 de 16/12/1965", urn:"urn:lex:br:federal:lei:1965-12-16;4903", ementa:"Dá nova redação ao art. 2º e ao parágrafo 1º do art. 6º da Lei nº 4.725, de 13 de julho de 1965, que estabelece normas para o processo dos dissídios coletivos, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4903-1965-12-16.md"}}, {id:"federal:BR:L:4643/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-31", numero:"4643", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-31;4643", vigente:true, titulo:"Lei nº 4.643 de 31/05/1965", urn:"urn:lex:br:federal:lei:1965-05-31;4643", ementa:"Determina a inclusão da especialização de engenheiro florestal na   enumeração do art. 16 do Decreto-lei nº 8.620, de 10 de janeiro de   1946.", arquivo:"federal/leis-ordinarias/1965/lei-4643-1965-05-31.md"}}, {id:"federal:BR:L:4758/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-08-19", numero:"4758", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-08-19;4758", vigente:true, titulo:"Lei nº 4.758 de 19/08/1965", urn:"urn:lex:br:federal:lei:1965-08-19;4758", ementa:"Altera dispositivos da Lei n° 4.539, de 10 de dezembro de 1964, que aprovou o Orçamento Geral da União para o exercício de 1965.", arquivo:"federal/leis-ordinarias/1965/lei-4758-1965-08-19.md"}}, {id:"federal:BR:L:4911/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-17", numero:"4911", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-17;4911", vigente:true, titulo:"Lei nº 4.911 de 17/12/1965", urn:"urn:lex:br:federal:lei:1965-12-17;4911", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Marinha, o crédito   especial de Cr$ 10.000.000,00 (dez milhões de cruzeiros), para atender a   despesas com um dique flutuante, precedente dos Estados Unidos da América do   Norte.", arquivo:"federal/leis-ordinarias/1965/lei-4911-1965-12-17.md"}}, {id:"federal:BR:L:4615/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-04-15", numero:"4615", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-04-15;4615", vigente:true, titulo:"Lei nº 4.615 de 15/04/1965", urn:"urn:lex:br:federal:lei:1965-04-15;4615", ementa:"Concede pensão mensal especial aos voluntários e militares que prestaram serviço de guerra na Campanha de Canudos e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4615-1965-04-15.md"}}, {id:"federal:BR:L:4793/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-20", numero:"4793", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-20;4793", vigente:true, titulo:"Lei nº 4.793 de 20/10/1965", urn:"urn:lex:br:federal:lei:1965-10-20;4793", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Marinha, o crédito especial de Cr$ 400.000.000 (Quatrocentos milhões de cruzeiros) para atender a despesas com reparos de navios.", arquivo:"federal/leis-ordinarias/1965/lei-4793-1965-10-20.md"}}, {id:"federal:BR:L:4825/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-05", numero:"4825", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-05;4825", vigente:true, titulo:"Lei nº 4.825 de 05/11/1965", urn:"urn:lex:br:federal:lei:1965-11-05;4825", ementa:"Acresce de um parágrafo o artigo 483, da Consolidação das Leis do   Trabalho.", arquivo:"federal/leis-ordinarias/1965/lei-4825-1965-11-05.md"}}, {id:"federal:BR:L:4662/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-02", numero:"4662", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-02;4662", vigente:true, titulo:"Lei nº 4.662 de 02/06/1965", urn:"urn:lex:br:federal:lei:1965-06-02;4662", ementa:"Desdobra em duas unidades universitárias distintas a atual Faculdade de Farmácia e Odontologia da Universidade do Ceará.", arquivo:"federal/leis-ordinarias/1965/lei-4662-1965-06-02.md"}}, {id:"federal:BR:L:4623/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-06", numero:"4623", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-06;4623", vigente:true, titulo:"Lei nº 4.623 de 06/05/1965", urn:"urn:lex:br:federal:lei:1965-05-06;4623", ementa:"Institui o \"Dia Nacional do ex-Combatente\".", arquivo:"federal/leis-ordinarias/1965/lei-4623-1965-05-06.md"}}, {id:"federal:BR:L:4820/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-29", numero:"4820", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-29;4820", vigente:true, titulo:"Lei nº 4.820 de 29/10/1965", urn:"urn:lex:br:federal:lei:1965-10-29;4820", ementa:"Dá nova redação ao item 85-28, alínea 004, da Seção XVI, da Tarifa que acompanha a Lei nº 3.244, de 14 de agôsto de 1957.", arquivo:"federal/leis-ordinarias/1965/lei-4820-1965-10-29.md"}}, {id:"federal:BR:L:4880/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-03", numero:"4880", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-03;4880", vigente:true, titulo:"Lei nº 4.880 de 03/12/1965", urn:"urn:lex:br:federal:lei:1965-12-03;4880", ementa:"Isenta do imposto de importação equipamento para tratamento de água   destinado à Companhia de Saneamento do Paraná.", arquivo:"federal/leis-ordinarias/1965/lei-4880-1965-12-03.md"}}, {id:"federal:BR:L:4652/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-31", numero:"4652", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-31;4652", vigente:true, titulo:"Lei nº 4.652 de 31/05/1965", urn:"urn:lex:br:federal:lei:1965-05-31;4652", ementa:"Autoriza a abertura de créditos especiais, num montante de Cr$ 1.079.494.483,40 (um bilhão, setenta e nove milhões, quatrocentos e noventa e quatro mil,quatrocentos e oitenta e ;três cruzeiros e quarenta centavos), a diversos Ministérios.", arquivo:"federal/leis-ordinarias/1965/lei-4652-1965-05-31.md"}}, {id:"federal:BR:L:4923/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-23", numero:"4923", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-23;4923", vigente:true, titulo:"Lei nº 4.923 de 23/12/1965", urn:"urn:lex:br:federal:lei:1965-12-23;4923", ementa:"Institui o cadastro permanente das admissões e dispensas de empregados, estabelece medidas contra o desemprego e de assistência aos desempregados, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4923-1965-12-23.md"}}, {id:"federal:BR:L:4851/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-24", numero:"4851", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-24;4851", vigente:true, titulo:"Lei nº 4.851 de 24/11/1965", urn:"urn:lex:br:federal:lei:1965-11-24;4851", ementa:"Altera o Quadro do Pessoal da Secretaria do Tribunal Superior do Trabalho e dá outras providências. /Há veto/", arquivo:"federal/leis-ordinarias/1965/lei-4851-1965-11-24.md"}}, {id:"federal:BR:L:4620/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-04-28", numero:"4620", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-04-28;4620", vigente:true, titulo:"Lei nº 4.620 de 28/04/1965", urn:"urn:lex:br:federal:lei:1965-04-28;4620", ementa:"Isenta do impôsto único sobre energia elétrica a Rêde Elétrica   Piquete-Itajubá, no período que especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4620-1965-04-28.md"}}, {id:"federal:BR:L:4872/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-02", numero:"4872", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-02;4872", vigente:true, titulo:"Lei nº 4.872 de 02/12/1965", urn:"urn:lex:br:federal:lei:1965-12-02;4872", ementa:"Isenta do impôsto de importação o material destindo à Faculdade de   Medicina de Rio Grande e importado pela Fundação Cidade do Rio   Grande.", arquivo:"federal/leis-ordinarias/1965/lei-4872-1965-12-02.md"}}, {id:"federal:BR:L:4838/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-10", numero:"4838", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-10;4838", vigente:true, titulo:"Lei nº 4.838 de 10/11/1965", urn:"urn:lex:br:federal:lei:1965-11-10;4838", ementa:"Cria, no Ministério da Aeronáutica, o Quadro de Oficiais Aviadores da Reserva de 2ª Classe, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4838-1965-11-10.md"}}, {id:"federal:BR:L:4694/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-21", numero:"4694", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-21;4694", vigente:true, titulo:"Lei nº 4.694 de 21/06/1965", urn:"urn:lex:br:federal:lei:1965-06-21;4694", ementa:"Isenta a Fábrica Nacional de Motores S.A. de impostos federais e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4694-1965-06-21.md"}}, {id:"federal:BR:L:4764/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-08-30", numero:"4764", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-08-30;4764", vigente:true, titulo:"Lei nº 4.764 de 30/08/1965", urn:"urn:lex:br:federal:lei:1965-08-30;4764", ementa:"Concede a inclusão da Escola de Serviço Social, anexa à Pontifícia   Universidade Católica do Rio de Janeiro, entre os estabelecimentos   subvencionados pelo Govêrno Federal.", arquivo:"federal/leis-ordinarias/1965/lei-4764-1965-08-30.md"}}, {id:"federal:BR:L:4743/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-16", numero:"4743", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-16;4743", vigente:true, titulo:"Lei nº 4.743 de 16/07/1965", urn:"urn:lex:br:federal:lei:1965-07-16;4743", ementa:"Dispõe sôbre as comemorações do centenário do nascimento do Marechal Rondon.", arquivo:"federal/leis-ordinarias/1965/lei-4743-1965-07-16.md"}}, {id:"federal:BR:L:4673/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-15", numero:"4673", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-15;4673", vigente:true, titulo:"Lei nº 4.673 de 15/06/1965", urn:"urn:lex:br:federal:lei:1965-06-15;4673", ementa:"Aplica aos bens penhorados em execuções fiscais as normas de   impenhorabilidade do art. 942 do Código do Processo Civil.", arquivo:"federal/leis-ordinarias/1965/lei-4673-1965-06-15.md"}}, {id:"federal:BR:L:4705/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-28", numero:"4705", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-28;4705", vigente:true, titulo:"Lei nº 4.705 de 28/06/1965", urn:"urn:lex:br:federal:lei:1965-06-28;4705", ementa:"Concede isenção das Taxas de Despacho Aduaneiro e de Melhoramento dos Portos para um aparelho de Raio X, doado ao Círculo Operário Pôrto Alegrense, Pôrto Alegre, Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1965/lei-4705-1965-06-28.md"}}, {id:"federal:BR:L:4844/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-19", numero:"4844", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-19;4844", vigente:true, titulo:"Lei nº 4.844 de 19/11/1965", urn:"urn:lex:br:federal:lei:1965-11-19;4844", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações   Exteriores, o crédito especial de Cr$ 25.000.000 (vinte e cinco milhões de   cruzeiros), para atender às despesas decorrentes da visita ao Brasil do   Presidente da República Popular Federativa da Iugoslávia.", arquivo:"federal/leis-ordinarias/1965/lei-4844-1965-11-19.md"}}, {id:"federal:BR:L:4799/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-20", numero:"4799", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-20;4799", vigente:true, titulo:"Lei nº 4.799 de 20/10/1965", urn:"urn:lex:br:federal:lei:1965-10-20;4799", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça Eleitoral - Tribunais Regionais Eleitorais - o crédito suplementar de Cr$ 6.438.130.186,00, em reforço a dotações do Orçamento vigente (Lei número 4.539, de 10 de dezembro de 1964).", arquivo:"federal/leis-ordinarias/1965/lei-4799-1965-10-20.md"}}, {id:"federal:BR:L:4801/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-20", numero:"4801", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-20;4801", vigente:true, titulo:"Lei nº 4.801 de 20/10/1965", urn:"urn:lex:br:federal:lei:1965-10-20;4801", ementa:"Altera dispositivo do Decreto-Lei número 1.995, de 1º de fevereiro de 1940, que fixa a tarifa geral para os serviços dos Correios e Telegráfos.", arquivo:"federal/leis-ordinarias/1965/lei-4801-1965-10-20.md"}}, {id:"federal:BR:L:4788/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-13", numero:"4788", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-13;4788", vigente:true, titulo:"Lei nº 4.788 de 13/10/1965", urn:"urn:lex:br:federal:lei:1965-10-13;4788", ementa:"Autoriza a abertura de créditos especiais, no montante de Cr$ 4.269.970.880 (quatro bilhões, duzentos e sessenta e nove milhões, novecentos e setenta mil, oitocentos e oitenta cruzeiros), a diversos Ministérios, ao Poder Judiciário e ao Tribunal de Contas da União.", arquivo:"federal/leis-ordinarias/1965/lei-4788-1965-10-13.md"}}, {id:"federal:BR:L:4908/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-17", numero:"4908", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-17;4908", vigente:true, titulo:"Lei nº 4.908 de 17/12/1965", urn:"urn:lex:br:federal:lei:1965-12-17;4908", ementa:"Modifica dispositivo da Lei nº 3119, de 31 de março de 1957, que autoriza a União a constituir uma sociedade por ações, denominada \"Sociedade Termoelétrica de Capivari\" - SOTELCA - e que passa a denominar-se \"Sociedade Termoelétrica de Capivari S.A.\" - SOTELCA.", arquivo:"federal/leis-ordinarias/1965/lei-4908-1965-12-17.md"}}, {id:"federal:BR:L:4649/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-31", numero:"4649", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-31;4649", vigente:true, titulo:"Lei nº 4.649 de 31/05/1965", urn:"urn:lex:br:federal:lei:1965-05-31;4649", ementa:"Autoriza o Poder Executivo a abrir ao Ministério da Aeronáutica o crédito   especial de Cr$ 103.806.000,00 (cento e três milhões, oitocentos e seis mil   cruzeiros), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4649-1965-05-31.md"}}, {id:"federal:BR:L:4659/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-02", numero:"4659", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-02;4659", vigente:true, titulo:"Lei nº 4.659 de 02/06/1965", urn:"urn:lex:br:federal:lei:1965-06-02;4659", ementa:"Autoriza o Poder Executivo a abrir, pelo MInistério da Viação e Obras Públicas, o crédito especial de Cr$ 1.300.000.000,00 (um bilhão e trezentos milhões de cruzeiros) destinado ao pagamento de insalubridade aos associados do Sindicato dos Operários Navais do Rio de Janeiro e de serviços realizados, em navios do Lóide Brasileiro, por estaleiros nacionais.", arquivo:"federal/leis-ordinarias/1965/lei-4659-1965-06-02.md"}}, {id:"federal:BR:L:4856/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-25", numero:"4856", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-25;4856", vigente:true, titulo:"Lei nº 4.856 de 25/11/1965", urn:"urn:lex:br:federal:lei:1965-11-25;4856", ementa:"Dispõe sôbre o regime de funções gratificadas na Secretaria de Estado das   Relações Exteriores.", arquivo:"federal/leis-ordinarias/1965/lei-4856-1965-11-25.md"}}, {id:"federal:BR:L:4817/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-29", numero:"4817", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-29;4817", vigente:true, titulo:"Lei nº 4.817 de 29/10/1965", urn:"urn:lex:br:federal:lei:1965-10-29;4817", ementa:"Acrescenta parágrafo ao art. 33 da Lei nº 3.820, de 11 de novembro de   1960, que cria o Conselho Federal e os Conselhos Regionais de Farmácia, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4817-1965-10-29.md"}}, {id:"federal:BR:L:4598/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-02-22", numero:"4598", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-02-22;4598", vigente:true, titulo:"Lei nº 4.598 de 22/02/1965", urn:"urn:lex:br:federal:lei:1965-02-22;4598", ementa:"Isenta do impôsto de importação equipamento de televisão importado pela   Rádio Rio Limitada (TV - Rio).", arquivo:"federal/leis-ordinarias/1965/lei-4598-1965-02-22.md"}}, {id:"federal:BR:L:4600/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-02-22", numero:"4600", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-02-22;4600", vigente:true, titulo:"Lei nº 4.600 de 22/02/1965", urn:"urn:lex:br:federal:lei:1965-02-22;4600", ementa:"Cria a Diretoria Regional dos Correios e Telégrafos de São José do Rio Prêto, Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1965/lei-4600-1965-02-22.md"}}, {id:"federal:BR:L:4836/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-09", numero:"4836", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-09;4836", vigente:true, titulo:"Lei nº 4.836 de 09/11/1965", urn:"urn:lex:br:federal:lei:1965-11-09;4836", ementa:"Autoriza a abertura, pela Secretaria de Educação e Cultura da Prefeitura do Distrito Federal, do crédito especial de Cr$ 1.750.000.000 (um bilhão e ;setecentos e cinqüenta milhões de cruzeiros), para auxílio à Fundação Educacional do Distrito Federal.", arquivo:"federal/leis-ordinarias/1965/lei-4836-1965-11-09.md"}}, {id:"federal:BR:L:4786/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-06", numero:"4786", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-06;4786", vigente:true, titulo:"Lei nº 4.786 de 06/10/1965", urn:"urn:lex:br:federal:lei:1965-10-06;4786", ementa:"Concede isenção de impostos para importação de bens destinados ao   desenvolvimento da indústria mecânica de precisão.", arquivo:"federal/leis-ordinarias/1965/lei-4786-1965-10-06.md"}}, {id:"federal:BR:L:4747/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-08-11", numero:"4747", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-08-11;4747", vigente:true, titulo:"Lei nº 4.747 de 11/08/1965", urn:"urn:lex:br:federal:lei:1965-08-11;4747", ementa:"Concede a pensão especial de Cr$ 33.000 ( trinta e três mil cruzeiros )   mensais à viúva e filhas de Manoel Gomes da Silva.", arquivo:"federal/leis-ordinarias/1965/lei-4747-1965-08-11.md"}}, {id:"federal:BR:L:4635/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-18", numero:"4635", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-18;4635", vigente:true, titulo:"Lei nº 4.635 de 18/05/1965", urn:"urn:lex:br:federal:lei:1965-05-18;4635", ementa:"Autoriza o Poder Executivo a abrir ;ao Ministério da Educação e   Cultura, o crédito especial de Cr$ 180.000.000(cento e oitenta milhões de cruzeiros),   para custear as despesas com obras de recuperação do imóvel situado no Estado da   Guanabara, na Praia do Flamengo nº 132.", arquivo:"federal/leis-ordinarias/1965/lei-4635-1965-05-18.md"}}, {id:"federal:BR:L:4917/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-17", numero:"4917", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-17;4917", vigente:true, titulo:"Lei nº 4.917 de 17/12/1965", urn:"urn:lex:br:federal:lei:1965-12-17;4917", ementa:"Isenta dos impostos de importação e de consumo, e de outras contribuições fiscais, os alimentos de qualquer natureza, e outras utilidades, adquiridos no exterior, mediante doação, pelas instituições em funcionamento no País, que se dediquem à assistência social.", arquivo:"federal/leis-ordinarias/1965/lei-4917-1965-12-17.md"}}, {id:"federal:BR:L:4723/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-09", numero:"4723", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-09;4723", vigente:true, titulo:"Lei nº 4.723 de 09/07/1965", urn:"urn:lex:br:federal:lei:1965-07-09;4723", ementa:"Dispõe sôbre a série de classes de Pesquisador e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4723-1965-07-09.md"}}, {id:"federal:BR:L:4685/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-21", numero:"4685", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-21;4685", vigente:true, titulo:"Lei nº 4.685 de 21/06/1965", urn:"urn:lex:br:federal:lei:1965-06-21;4685", ementa:"Modifica a Lei nº 3.760, de 25 de abril de 1960, que concede a pensão especial de Cr$ 40.000 (quarenta mil cruzeiros) à viúva e filhos do Senador Lameira Bittencourt.", arquivo:"federal/leis-ordinarias/1965/lei-4685-1965-06-21.md"}}, {id:"federal:BR:L:4888/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-09", numero:"4888", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-09;4888", vigente:true, titulo:"Lei nº 4.888 de 09/12/1965", urn:"urn:lex:br:federal:lei:1965-12-09;4888", ementa:"Proíbe o emprêgo da palavra couro em produtos industrializados, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4888-1965-12-09.md"}}, {id:"federal:BR:L:4813/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-25", numero:"4813", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-25;4813", vigente:true, titulo:"Lei nº 4.813 de 25/10/1965", urn:"urn:lex:br:federal:lei:1965-10-25;4813", ementa:"Inclui, no Quadro de Pessoal da Polícia do Distrito Federal, criada pela Lei nº 4.483, de 16 de novembro de 1964, o Grupo Ocupacional PM-400 - Policiamento Ostensivo, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4813-1965-10-25.md"}}, {id:"federal:BR:L:4901/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-16", numero:"4901", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-16;4901", vigente:true, titulo:"Lei nº 4.901 de 16/12/1965", urn:"urn:lex:br:federal:lei:1965-12-16;4901", ementa:"Cria cargo de Professor de Ensino Superior e de Direito no Quadro de   Pessoal do Ministério da Educação e Cultura, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1965/lei-4901-1965-12-16.md"}}, {id:"federal:BR:L:4782/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-09-28", numero:"4782", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-09-28;4782", vigente:true, titulo:"Lei nº 4.782 de 28/09/1965", urn:"urn:lex:br:federal:lei:1965-09-28;4782", ementa:"Autoriza a abertura de crédito especial especial de Cr$ 11.283.990.500 (   onze bilhões, duzentos e oitenta e três milhões, novecentos e noventa mil e   quinhentos cruzeiros ) ao Ministério da Agricultura, para o fim que   especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4782-1965-09-28.md"}}, {id:"federal:BR:L:4832/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-05", numero:"4832", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-05;4832", vigente:true, titulo:"Lei nº 4.832 de 05/11/1965", urn:"urn:lex:br:federal:lei:1965-11-05;4832", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Aeronáutica, o crédito especial de Cr$ 508.500.000,00 (quinhentos e oito milhões e quinhentos mil cruzeiros), destinado a atender a despesas com a restauração e adptação de vários aeroportos.", arquivo:"federal/leis-ordinarias/1965/lei-4832-1965-11-05.md"}}, {id:"federal:BR:L:4921/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-23", numero:"4921", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-23;4921", vigente:true, titulo:"Lei nº 4.921 de 23/12/1965", urn:"urn:lex:br:federal:lei:1965-12-23;4921", ementa:"Estende aos Serviços de Navegação da Amazônia e de Administração do Porto do Pará, o regime de isenção fiscal de que gozam o Lóide Brasileiro e a Companhia de Navegação Costeira, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4921-1965-12-23.md"}}, {id:"federal:BR:L:4897/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-09", numero:"4897", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-09;4897", vigente:true, titulo:"Lei nº 4.897 de 09/12/1965", urn:"urn:lex:br:federal:lei:1965-12-09;4897", ementa:"Declara Joaquim José da Silva Xavier, o Tiradentes, Patrono da Nação Brasileira.", arquivo:"federal/leis-ordinarias/1965/lei-4897-1965-12-09.md"}}, {id:"federal:BR:L:4650/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-31", numero:"4650", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-31;4650", vigente:true, titulo:"Lei nº 4.650 de 31/05/1965", urn:"urn:lex:br:federal:lei:1965-05-31;4650", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Aeronáutica, o crédito   especial ;no valor de Cr$ 15.480.000.000,00 (quinze bilhões quatrocentos e oitenta   milhões de cruzeiros), para cobrir a diferença nas aquisições cambiais para   a ;importação de material aeronáutico.", arquivo:"federal/leis-ordinarias/1965/lei-4650-1965-05-31.md"}}, {id:"federal:BR:L:4791/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-20", numero:"4791", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-20;4791", vigente:true, titulo:"Lei nº 4.791 de 20/10/1965", urn:"urn:lex:br:federal:lei:1965-10-20;4791", ementa:"Fixa novos valôres para os símbolos dos cargos e das funções gratificadas do Quadro do Pessoal da Secretaria do Tribunal Regional do Trabalho da 5ª Região, e dá outras providências. /Há veto/", arquivo:"federal/leis-ordinarias/1965/lei-4791-1965-10-20.md"}}, {id:"federal:BR:L:4660/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-02", numero:"4660", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-02;4660", vigente:true, titulo:"Lei nº 4.660 de 02/06/1965", urn:"urn:lex:br:federal:lei:1965-06-02;4660", ementa:"Isenta de impostos de importação e outras contribuições fiscais os   gêneros, mercadorias e equipamentos doados ou importados para a Comissão   Nacional de Alimentação quer por organizações internacionais, quer por governos   estrangeiros.", arquivo:"federal/leis-ordinarias/1965/lei-4660-1965-06-02.md"}}, {id:"federal:BR:L:4602/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-03-18", numero:"4602", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-03-18;4602", vigente:true, titulo:"Lei nº 4.602 de 18/03/1965", urn:"urn:lex:br:federal:lei:1965-03-18;4602", ementa:"Dispõe sôbre a fixação de coeficientes de correção monetária para os efeitos legais.", arquivo:"federal/leis-ordinarias/1965/lei-4602-1965-03-18.md"}}, {id:"federal:BR:L:4757/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-08-18", numero:"4757", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-08-18;4757", vigente:true, titulo:"Lei nº 4.757 de 18/08/1965", urn:"urn:lex:br:federal:lei:1965-08-18;4757", ementa:"Concede isenção de direitos de importação, mais taxas aduaneiras e impôsto   de consumo para materiais importados pela S.A. Rádio Tupi, com sede no Estado da   Guanabara.", arquivo:"federal/leis-ordinarias/1965/lei-4757-1965-08-18.md"}}, {id:"federal:BR:L:4884/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-09", numero:"4884", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-09;4884", vigente:true, titulo:"Lei nº 4.884 de 09/12/1965", urn:"urn:lex:br:federal:lei:1965-12-09;4884", ementa:"Concede à Fundação Nacional do Bem-Estar do Menor o auxílio de Cr$ 6.000.000.000 (seis bilhões de cruzeiros); autoriza a abertura do crédito especial para atender a ;essa finalidade, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4884-1965-12-09.md"}}, {id:"federal:BR:L:4613/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-04-02", numero:"4613", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-04-02;4613", vigente:true, titulo:"Lei nº 4.613 de 02/04/1965", urn:"urn:lex:br:federal:lei:1965-04-02;4613", ementa:"Isenta dos impostos de importação e de consumo, bem como da taxa de   despacho aduaneiro, os veículos especiais destinados a uso exclusivo de   paraplégicos ou pessoas portadoras de defeitos físicos ou quais fiquem   impossibilitados de utilizar os modelos comuns.", arquivo:"federal/leis-ordinarias/1965/lei-4613-1965-04-02.md"}}, {id:"federal:BR:L:4709/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-28", numero:"4709", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-28;4709", vigente:true, titulo:"Lei nº 4.709 de 28/06/1965", urn:"urn:lex:br:federal:lei:1965-06-28;4709", ementa:"Altera a Lei nº 2.743, de 6 de março de 1956, e cria a Campanha de Erradicação da Malária.", arquivo:"federal/leis-ordinarias/1965/lei-4709-1965-06-28.md"}}, {id:"federal:BR:L:4666/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-08", numero:"4666", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-08;4666", vigente:true, titulo:"Lei nº 4.666 de 08/06/1965", urn:"urn:lex:br:federal:lei:1965-06-08;4666", ementa:"Autoriza o Poder Executivo   a abrir, pelo Ministério da Fazenda, consignada ao Conselho Nacional   de Telecomunicações, o crédito especial de Cr$ 1.500.000.000, para atender às   despesas com a participação do Brasil no Sistema Mundial de Telecomunicações por   Satélites.", arquivo:"federal/leis-ordinarias/1965/lei-4666-1965-06-08.md"}}, {id:"federal:BR:L:4859/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-26", numero:"4859", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-26;4859", vigente:true, titulo:"Lei nº 4.859 de 26/11/1965", urn:"urn:lex:br:federal:lei:1965-11-26;4859", ementa:"Revoga a Lei nº 4.127, de 27 de agôsto de 1962, e estabelece normas para prestação do serviço de vigilância portuária por vigias matriculados nas Delegacias do Trabalho Marítimo.", arquivo:"federal/leis-ordinarias/1965/lei-4859-1965-11-26.md"}}, {id:"federal:BR:L:4739/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-15", numero:"4739", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-15;4739", vigente:true, titulo:"Lei nº 4.739 de 15/07/1965", urn:"urn:lex:br:federal:lei:1965-07-15;4739", ementa:"Dispõe sôbre o exercício da profissão de estatístico e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4739-1965-07-15.md"}}, {id:"federal:BR:L:4717/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-29", numero:"4717", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-29;4717", titulo:"Lei nº 4.717 de 29/06/1965", vigente:true, urn:"urn:lex:br:federal:lei:1965-06-29;4717", ementa:"Regula a ação popular.", arquivo:"federal/leis-ordinarias/1965/lei-4717-1965-06-29.md"}}, {id:"federal:BR:L:4848/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-19", numero:"4848", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-19;4848", vigente:true, titulo:"Lei nº 4.848 de 19/11/1965", urn:"urn:lex:br:federal:lei:1965-11-19;4848", ementa:"Autoriza o Poder Executivo a abrir, a diversos Órgãos e Ministérios,   créditos especiais num montante de Cr$ 265.347.106 (duzentos e sessenta e cinco   milhões trezentos e quarenta e sete mil cento e seis cruzeiros), destinados a   atender às despesas que especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4848-1965-11-19.md"}}, {id:"federal:BR:L:4805/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-20", numero:"4805", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-20;4805", vigente:true, titulo:"Lei nº 4.805 de 20/10/1965", urn:"urn:lex:br:federal:lei:1965-10-20;4805", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça Eleitoral - Tribunal Superior Eleitoral o crédito suplementar de Cr$ 456.950.000, em refôrço à dotação do Orçamento vigente (Lei nº 4.539, de 10 de dezembro de 1964).", arquivo:"federal/leis-ordinarias/1965/lei-4805-1965-10-20.md"}}, {id:"federal:BR:L:4773/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-09-15", numero:"4773", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-09-15;4773", vigente:true, titulo:"Lei nº 4.773 de 15/09/1965", urn:"urn:lex:br:federal:lei:1965-09-15;4773", ementa:"Autoriza o Poder Executivo a abrir, através do Ministério da Fazenda, o crédito especial de Cr$ 5.000.000.000 (cinco bilhões de cruzeiros), destinado a atender às despesas decorrentes da participação da União na constituição do capital da Emprêsa Brasileira de Telecomunicações.", arquivo:"federal/leis-ordinarias/1965/lei-4773-1965-09-15.md"}}, {id:"federal:BR:L:4893/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-09", numero:"4893", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-09;4893", vigente:true, titulo:"Lei nº 4.893 de 09/12/1965", urn:"urn:lex:br:federal:lei:1965-12-09;4893", ementa:"Dá nova redação ao art. 91 do Código do Processo Penal (Decreto-Lei número   3.693, de 3 de outubro de 1941).", arquivo:"federal/leis-ordinarias/1965/lei-4893-1965-12-09.md"}}, {id:"federal:BR:L:4621/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-04-30", numero:"4621", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-04-30;4621", vigente:true, titulo:"Lei nº 4.621 de 30/04/1965", urn:"urn:lex:br:federal:lei:1965-04-30;4621", ementa:"Dispõe sôbre subscrição compulsória de Obrigações Reajustáveis do Tesouro Nacional pelas pessoas que recebem remuneração classificável na cédula \"C\" de rendimentos e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4621-1965-04-30.md"}}, {id:"federal:BR:L:4676/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-16", numero:"4676", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-16;4676", vigente:true, titulo:"Lei nº 4.676 de 16/06/1965", urn:"urn:lex:br:federal:lei:1965-06-16;4676", ementa:"Modifica, em parte, as Leis nºs. 2.308, de 31 de agôsto de 1954, 2.944, de 8 de novembro de 1956, 4.156, de 28 de novembro de 1962, e 4.364, de 22 de junho de 1964, que dispõem sôbre o Fundo Federal de Eletrificação e sôbre a distribuição e aplicação do Impôsto Único sôbre Energia Elétrica, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4676-1965-06-16.md"}}, {id:"federal:BR:L:4775/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-09-22", numero:"4775", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-09-22;4775", vigente:true, titulo:"Lei nº 4.775 de 22/09/1965", urn:"urn:lex:br:federal:lei:1965-09-22;4775", ementa:"Prorroga o prazo estabelecido no art. 2º da Lei nº 2.341, de 22 de novembro de 1954, que autoriza o Poder Executivo a financiar operações imobiliárias realizadas pelo Clube Naval.", arquivo:"federal/leis-ordinarias/1965/lei-4775-1965-09-22.md"}}, {id:"federal:BR:L:4697/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-22", numero:"4697", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-22;4697", vigente:true, titulo:"Lei nº 4.697 de 22/06/1965", urn:"urn:lex:br:federal:lei:1965-06-22;4697", ementa:"Dá nova redação ao § 2º e acrescenta mais um parágrafo ao art. 16 da Lei nº 4.328, de 30 de abril de 1964 (Código de Vencimentos dos Militares).", arquivo:"federal/leis-ordinarias/1965/lei-4697-1965-06-22.md"}}, {id:"federal:BR:L:4604/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-03-30", numero:"4604", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-03-30;4604", vigente:true, titulo:"Lei nº 4.604 de 30/03/1965", urn:"urn:lex:br:federal:lei:1965-03-30;4604", ementa:"Altera o Decreto-lei nº 7.036, de 10 de novembro de 1944, que reforma a   Lei de Acidentes do Trabalho.", arquivo:"federal/leis-ordinarias/1965/lei-4604-1965-03-30.md"}}, {id:"federal:BR:L:4689/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-21", numero:"4689", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-21;4689", vigente:true, titulo:"Lei nº 4.689 de 21/06/1965", urn:"urn:lex:br:federal:lei:1965-06-21;4689", ementa:"Isenta de impôsto de importação dez mil toneladas de placas de aço (slabs) importadas pela Companhia Siderúrgica Paulista - COSIPA.", arquivo:"federal/leis-ordinarias/1965/lei-4689-1965-06-21.md"}}, {id:"federal:BR:L:4744/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-19", numero:"4744", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-19;4744", vigente:true, titulo:"Lei nº 4.744 de 19/07/1965", urn:"urn:lex:br:federal:lei:1965-07-19;4744", ementa:"Autoriza o Poder Executivo a abrir, pela Superintendência do Plano de   Valorização Econômica da Amazônia, o crédito especial de Cr$ 10.000.000.000 (   dez bilhões de cruzeiros ), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4744-1965-07-19.md"}}, {id:"federal:BR:L:4645/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-31", numero:"4645", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-31;4645", vigente:true, titulo:"Lei nº 4.645 de 31/05/1965", urn:"urn:lex:br:federal:lei:1965-05-31;4645", ementa:"Autoriza a abertura, ao Ministério da Justiça e Negócios Interiores, do   crédito especial de Cr$ 68.000.000,00 (sessenta e oito milhões de cruzeiros),   para o fim que especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4645-1965-05-31.md"}}, {id:"federal:BR:L:4710/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-28", numero:"4710", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-28;4710", vigente:true, titulo:"Lei nº 4.710 de 28/06/1965", urn:"urn:lex:br:federal:lei:1965-06-28;4710", ementa:"Isenta da taxa de despacho aduaneiro, a que se refere o art. 66, da Lei número 3.244, de 14 de agôsto de 1957, material doado a estabelecimento hospitalar.", arquivo:"federal/leis-ordinarias/1965/lei-4710-1965-06-28.md"}}, {id:"federal:BR:L:4732/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-14", numero:"4732", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-14;4732", vigente:true, titulo:"Lei nº 4.732 de 14/07/1965", urn:"urn:lex:br:federal:lei:1965-07-14;4732", ementa:"Altera o artigo 5º da Lei Delegada nº 6, de 26 de setembro de 1962, que \"autoriza a constituição da Companhia Brasileira de Alimentos e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4732-1965-07-14.md"}}, {id:"federal:BR:L:4672/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-12", numero:"4672", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-12;4672", vigente:true, titulo:"Lei nº 4.672 de 12/06/1965", urn:"urn:lex:br:federal:lei:1965-06-12;4672", ementa:"Modifica o inciso IV do art. 842 do Decreto-lei nº 1.608, de 18 de setembro de 1939 (Código de Processo Civil)", arquivo:"federal/leis-ordinarias/1965/lei-4672-1965-06-12.md"}}, {id:"federal:BR:L:4751/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-08-12", numero:"4751", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-08-12;4751", vigente:true, titulo:"Lei nº 4.751 de 12/08/1965", urn:"urn:lex:br:federal:lei:1965-08-12;4751", ementa:"Autoriza a abertura do crédito especial de Cr$ 200.000.000 ( duzentos   milhões de cruzeiros ), ao Ministério da Justiça e Negócios Interiores, para   atender a despesas com o Território Federal do Amapá, referentes a exercícios   anteriores.", arquivo:"federal/leis-ordinarias/1965/lei-4751-1965-08-12.md"}}, {id:"federal:BR:L:4841/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-18", numero:"4841", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-18;4841", vigente:true, titulo:"Lei nº 4.841 de 18/11/1965", urn:"urn:lex:br:federal:lei:1965-11-18;4841", ementa:"Acresce de um parágrafo único o artigo 16 da Lei nº 4.102, de 20 de julho de   1962.", arquivo:"federal/leis-ordinarias/1965/lei-4841-1965-11-18.md"}}, {id:"federal:BR:L:4627/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-13", numero:"4627", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-13;4627", vigente:true, titulo:"Lei nº 4.627 de 13/05/1965", urn:"urn:lex:br:federal:lei:1965-05-13;4627", ementa:"Autoriza a abertura, pelo Ministério da Viação e Obras Públicas, do   crédito especial de Cr$ 130.000.000, (cento e trinta milhões de cruzeiros),   para o fim que menciona.", arquivo:"federal/leis-ordinarias/1965/lei-4627-1965-05-13.md"}}, {id:"federal:BR:L:4852/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-25", numero:"4852", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-25;4852", vigente:true, titulo:"Lei nº 4.852 de 25/11/1965", urn:"urn:lex:br:federal:lei:1965-11-25;4852", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério da Fazenda, o crédito   especial de Cr$ 350.000.000 (trezentos e cinqüenta milhões de cruzeiros), para   atender a despesas com obras em repartições do mesmo Ministério.", arquivo:"federal/leis-ordinarias/1965/lei-4852-1965-11-25.md"}}, {id:"federal:BR:L:4663/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-03", numero:"4663", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-03;4663", vigente:true, titulo:"Lei nº 4.663 de 03/06/1965", urn:"urn:lex:br:federal:lei:1965-06-03;4663", ementa:"Cria estímulos ao aumento de produtividade e à contenção de preços e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4663-1965-06-03.md"}}, {id:"federal:BR:L:4860/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-26", numero:"4860", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-26;4860", vigente:true, titulo:"Lei nº 4.860 de 26/11/1965", urn:"urn:lex:br:federal:lei:1965-11-26;4860", ementa:"Dispõe sôbre o regime de trabalho nos portos organizados, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4860-1965-11-26.md"}}, {id:"federal:BR:L:4865/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-30", numero:"4865", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-30;4865", vigente:true, titulo:"Lei nº 4.865 de 30/11/1965", urn:"urn:lex:br:federal:lei:1965-11-30;4865", ementa:"Autoriza a abertura, pelo Ministério da Viação e Obras Públicas do crédito especial de Cr$ 20.500.000.000 (vinte bilhões e quinhentos milhões de cruzeiros), para o fim que menciona.", arquivo:"federal/leis-ordinarias/1965/lei-4865-1965-11-30.md"}}, {id:"federal:BR:L:4681/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-21", numero:"4681", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-21;4681", vigente:true, titulo:"Lei nº 4.681 de 21/06/1965", urn:"urn:lex:br:federal:lei:1965-06-21;4681", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito   especial de Cr$ 39.412.700, destinado a atender às despesas com o   prosseguimento das obras da Alfândega de Itajaí, Santa Catarina.", arquivo:"federal/leis-ordinarias/1965/lei-4681-1965-06-21.md"}}, {id:"federal:BR:L:4913/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-17", numero:"4913", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-17;4913", vigente:true, titulo:"Lei nº 4.913 de 17/12/1965", urn:"urn:lex:br:federal:lei:1965-12-17;4913", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras Públicas, o   crédito especial de Cr$ 533.412.079,00 (quinhentos e trinta e três milhões,   quatrocentos e doze mil e setenta e nove cruzeiros), para atender ao pagamento   de diferenças de proventos e vantagens, aos inativos da Rede Viação Paraná-Santa   Catarina, relativa aos anos de 1961 e 1962.", arquivo:"federal/leis-ordinarias/1965/lei-4913-1965-12-17.md"}}, {id:"federal:BR:L:4881/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-03", numero:"4881", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-03;4881", titulo:"Lei nº 4.881 de 03/12/1965", vigente:true, urn:"urn:lex:br:federal:lei:1965-12-03;4881", ementa:"Dispensa a cobrança do impôsto de sêlo em contrato de promessa de compra e   venda firmado entre a Associação Brasileira para o Rearmamento Moral e os   proprietários do \"Sítio São Luiz\" localizado em Petrópolis.", arquivo:"federal/leis-ordinarias/1965/lei-4881-1965-12-03.md"}}, {id:"federal:BR:L:4925/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-23", numero:"4925", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-23;4925", vigente:true, titulo:"Lei nº 4.925 de 23/12/1965", urn:"urn:lex:br:federal:lei:1965-12-23;4925", ementa:"Autoriza o Ministério da Marinha a aproveitar na classe inicial das séries   de classe de suas especialidades, após conclusão de curso, todos os alunos   bolsistas e os aprendizes das Escolas Técnicas e Indústrias reconhecidas ou   classificadas pelo Ministério da Educação e Cultura.", arquivo:"federal/leis-ordinarias/1965/lei-4925-1965-12-23.md"}}, {id:"federal:BR:L:4904/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-17", numero:"4904", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-17;4904", vigente:true, titulo:"Lei nº 4.904 de 17/12/1965", urn:"urn:lex:br:federal:lei:1965-12-17;4904", ementa:"Dispõe sôbre a organização do Ministério das Minas e Energia, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4904-1965-12-17.md"}}, {id:"federal:BR:L:4816/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-26", numero:"4816", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-26;4816", vigente:true, titulo:"Lei nº 4.816 de 26/10/1965", urn:"urn:lex:br:federal:lei:1965-10-26;4816", ementa:"Cria, na Justiça do Trabalho da 3ª Região, duas Juntas de Conciliação e Julgamento, com sede em Brasília, Distrito Federal, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4816-1965-10-26.md"}}, {id:"federal:BR:L:4795/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-20", numero:"4795", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-20;4795", vigente:true, titulo:"Lei nº 4.795 de 20/10/1965", urn:"urn:lex:br:federal:lei:1965-10-20;4795", ementa:"Modifica, sem aumento de depesas, distribuição de dotações consignadas na Lei nº 4.539, de 10 de dezembro de 1964.", arquivo:"federal/leis-ordinarias/1965/lei-4795-1965-10-20.md"}}, {id:"federal:BR:L:4827/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-05", numero:"4827", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-05;4827", vigente:true, titulo:"Lei nº 4.827 de 05/11/1965", urn:"urn:lex:br:federal:lei:1965-11-05;4827", ementa:"Concede pensão especial ao cidadão inglês Henry Philip Brotherton Dye,   servidor da Delegacia do Tesouro Brasileiro no Exterior.", arquivo:"federal/leis-ordinarias/1965/lei-4827-1965-11-05.md"}}, {id:"federal:BR:L:4617/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-04-15", numero:"4617", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-04-15;4617", vigente:true, titulo:"Lei nº 4.617 de 15/04/1965", urn:"urn:lex:br:federal:lei:1965-04-15;4617", ementa:"Cria o Fundo do Exército, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4617-1965-04-15.md"}}, {id:"federal:BR:L:4874/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-02", numero:"4874", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-02;4874", vigente:true, titulo:"Lei nº 4.874 de 02/12/1965", urn:"urn:lex:br:federal:lei:1965-12-02;4874", ementa:"Autoriza a doação, ao Hospital Evangélico da Bahia, de um ;lote de terreno, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4874-1965-12-02.md"}}, {id:"federal:BR:L:4699/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-28", numero:"4699", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-28;4699", vigente:true, titulo:"Lei nº 4.699 de 28/06/1965", urn:"urn:lex:br:federal:lei:1965-06-28;4699", ementa:"Revigora o crédito autorizado pela Lei nº 4.271, de 24 de outubro de 1963,   para abertura, pelo Ministério da Fazenda, do crédito especial de Cr$   400.000.000 (quatrocentos milhões de cruzeiros), destinado à integralização da   quota de participação da União na Sociedade de Economia Mista \"Aços Finos   Piratini\", correspondente ao exercício de 1962.", arquivo:"federal/leis-ordinarias/1965/lei-4699-1965-06-28.md"}}, {id:"federal:BR:L:4769/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-09-09", numero:"4769", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-09-09;4769", vigente:true, titulo:"Lei nº 4.769 de 09/09/1965", urn:"urn:lex:br:federal:lei:1965-09-09;4769", ementa:"Dispõe sobre o exercício da profissão de Técnico de Administração, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4769-1965-09-09.md"}}, {id:"federal:BR:L:4690/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-21", numero:"4690", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-21;4690", vigente:true, titulo:"Lei nº 4.690 de 21/06/1965", urn:"urn:lex:br:federal:lei:1965-06-21;4690", ementa:"Autoriza o Poder Executivo a abrir o crédito especial de   Cr$ 36.221.047, ;a favor do Serviço Nacional dos Municípios - SENAM - subordinado ao Ministro   de Estado Extraordinário para a Coordenação dos Organismos   Regionais.", arquivo:"federal/leis-ordinarias/1965/lei-4690-1965-06-21.md"}}, {id:"federal:BR:L:4808/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-25", numero:"4808", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-25;4808", vigente:true, titulo:"Lei nº 4.808 de 25/10/1965", urn:"urn:lex:br:federal:lei:1965-10-25;4808", ementa:"Dá nova redação ao art. 3º da Lei nº 4.563, de 11 de dezembro de 1964, que \"institui o Conselho Nacional de Transportes e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4808-1965-10-25.md"}}, {id:"federal:BR:L:4800/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-20", numero:"4800", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-20;4800", vigente:true, titulo:"Lei nº 4.800 de 20/10/1965", urn:"urn:lex:br:federal:lei:1965-10-20;4800", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Saúde, o crédito suplementar de Cr$ 8.700.000.000 à categoria econômica 3.2.00 - Transferências Correntes, do Anexo 4.21.00 - Ministério da Saúde - 06 - Departamento de Administração (Lei número 4.539, de 10 de dezembro de 1964).", arquivo:"federal/leis-ordinarias/1965/lei-4800-1965-10-20.md"}}, {id:"federal:BR:L:4869/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-01", numero:"4869", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-01;4869", vigente:true, titulo:"Lei nº 4.869 de 01/12/1965", urn:"urn:lex:br:federal:lei:1965-12-01;4869", ementa:"Aprova o Plano Diretor do Desenvolvimento do Nordeste para os anos de 1966, 1967 e 1968, e dá outras providências. /Há veto/", arquivo:"federal/leis-ordinarias/1965/lei-4869-1965-12-01.md"}}, {id:"federal:BR:L:4798/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-20", numero:"4798", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-20;4798", vigente:true, titulo:"Lei nº 4.798 de 20/10/1965", urn:"urn:lex:br:federal:lei:1965-10-20;4798", ementa:"Concede, pelo prazo de 2 (dois) anos, isenção dos impostos e taxas   que menciona, aos materias importados, para uso próprio, pelos bancos oficiais   dos Estados, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4798-1965-10-20.md"}}, {id:"federal:BR:L:4843/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-19", numero:"4843", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-19;4843", vigente:true, titulo:"Lei nº 4.843 de 19/11/1965", urn:"urn:lex:br:federal:lei:1965-11-19;4843", ementa:"Autoriza os estabelecimentos Bancários a substituirem, em sua contabilidade, o livro \"Diário\" de escrituração mercantil pelo livro \"Balancetes Diários e Balanços\", cujas características define: atribui eficácia probatória ao lançamento efetuado segundo o sistema de \"fichas de lançamento\", e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4843-1965-11-19.md"}}, {id:"federal:BR:L:4753/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-08-13", numero:"4753", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-08-13;4753", vigente:true, titulo:"Lei nº 4.753 de 13/08/1965", urn:"urn:lex:br:federal:lei:1965-08-13;4753", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações   Exteriores, o crédito especial de Cr$ 60.000.000 ( sessenta milhões de cruzeiros   ), para atender às despesas com a realização da VIII Bienal de São   Paulo.", arquivo:"federal/leis-ordinarias/1965/lei-4753-1965-08-13.md"}}, {id:"federal:BR:L:4712/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-29", numero:"4712", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-29;4712", vigente:true, titulo:"Lei nº 4.712 de 29/06/1965", urn:"urn:lex:br:federal:lei:1965-06-29;4712", ementa:"Dá nova redação à alínea c , do art. 15 da Lei nº 1.184, de 30 de agôsto de 1950, que dispõe sobre o Banco de Crédito da Borracha S.A.", arquivo:"federal/leis-ordinarias/1965/lei-4712-1965-06-29.md"}}, {id:"federal:BR:L:4629/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-14", numero:"4629", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-14;4629", vigente:true, titulo:"Lei nº 4.629 de 14/05/1965", urn:"urn:lex:br:federal:lei:1965-05-14;4629", ementa:"Autoriza o Ministério da Aeronáutica a dar a denominação de \"Marechal   Rondon\" ao aeroporto que serve às cidades de Várzea Grande e Cuiabá, no Estado   do Mato Grosso.", arquivo:"federal/leis-ordinarias/1965/lei-4629-1965-05-14.md"}}, {id:"federal:BR:L:4693/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-21", numero:"4693", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-21;4693", vigente:true, titulo:"Lei nº 4.693 de 21/06/1965", urn:"urn:lex:br:federal:lei:1965-06-21;4693", ementa:"Autoriza o Poder Executivo a abrir, pelo Estado Maior das Fôrças Armadas,   o crédito especial de Cr$ 650.189,50, para atender às despesas com o   enquadramento de seu pessoal civil.", arquivo:"federal/leis-ordinarias/1965/lei-4693-1965-06-21.md"}}, {id:"federal:BR:L:4763/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-08-30", numero:"4763", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-08-30;4763", vigente:true, titulo:"Lei nº 4.763 de 30/08/1965", urn:"urn:lex:br:federal:lei:1965-08-30;4763", ementa:"Inclui, no Polígono das Sêcas, o Município de Vitória da Conquista, no   Estado da Bahia e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4763-1965-08-30.md"}}, {id:"federal:BR:L:4877/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-02", numero:"4877", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-02;4877", vigente:true, titulo:"Lei nº 4.877 de 02/12/1965", urn:"urn:lex:br:federal:lei:1965-12-02;4877", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério da Fazenda, o crédito suplementar de Cr$ 10.000.000 como refôrço à dotação orçamentária insuficiente destinada à Contadoria-Geral da República.", arquivo:"federal/leis-ordinarias/1965/lei-4877-1965-12-02.md"}}, {id:"federal:BR:L:4704/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-28", numero:"4704", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-28;4704", vigente:true, titulo:"Lei nº 4.704 de 28/06/1965", urn:"urn:lex:br:federal:lei:1965-06-28;4704", ementa:"Disciplina o recolhimento pelo Departamento dos Correios e Telégrafos de seus saldos orçamentários já empenhados e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4704-1965-06-28.md"}}, {id:"federal:BR:L:4684/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-21", numero:"4684", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-21;4684", vigente:true, titulo:"Lei nº 4.684 de 21/06/1965", urn:"urn:lex:br:federal:lei:1965-06-21;4684", ementa:"Isenta dos impostos de importação e de consumo equipamento telefônico   destinado à Telefônica Pinhal S.A.", arquivo:"federal/leis-ordinarias/1965/lei-4684-1965-06-21.md"}}, {id:"federal:BR:L:4722/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-09", numero:"4722", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-09;4722", vigente:true, titulo:"Lei nº 4.722 de 09/07/1965", urn:"urn:lex:br:federal:lei:1965-07-09;4722", ementa:"Cria a Escola Agrícola de Caconde, no Estado de São Paulo, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4722-1965-07-09.md"}}, {id:"federal:BR:L:4916/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-17", numero:"4916", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-17;4916", vigente:true, titulo:"Lei nº 4.916 de 17/12/1965", urn:"urn:lex:br:federal:lei:1965-12-17;4916", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações Exteriores, o crédito especial de Cr$ 86.087.100,00 (oitenta e seis milhões, oitenta e sete mil e cem cruzeiros), para atender às despesas decorrentes das Segundas Reuniões Anuais Ordinárias do Conselho Interamericano Econômico e Social (CIES) da organização dos Estados Americanos.", arquivo:"federal/leis-ordinarias/1965/lei-4916-1965-12-17.md"}}, {id:"federal:BR:L:4634/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-18", numero:"4634", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-18;4634", vigente:true, titulo:"Lei nº 4.634 de 18/05/1965", urn:"urn:lex:br:federal:lei:1965-05-18;4634", ementa:"Dispõe sobre a elevação do capital da Fábrica Nacional de Motores e dá   outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4634-1965-05-18.md"}}, {id:"federal:BR:L:4785/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-06", numero:"4785", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-06;4785", vigente:true, titulo:"Lei nº 4.785 de 06/10/1965", urn:"urn:lex:br:federal:lei:1965-10-06;4785", ementa:"Dispõe sôbre a fiscalização do comércio e uso de produtos fitossanitários e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4785-1965-10-06.md"}}, {id:"federal:BR:L:4597/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-02-22", numero:"4597", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-02-22;4597", vigente:true, titulo:"Lei nº 4.597 de 22/02/1965", urn:"urn:lex:br:federal:lei:1965-02-22;4597", ementa:"Concede isenção de direitos aduaneiros, inclusive adicional de 10 %,   imposto de consumo e mais taxas alfandegárias para materiais importados pela   Companhia Telefônica Sul Bahiano, no Estado da Bahia.", arquivo:"federal/leis-ordinarias/1965/lei-4597-1965-02-22.md"}}, {id:"federal:BR:L:4868/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-30", numero:"4868", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-30;4868-a", vigente:true, titulo:"Lei nº 4.868-A de 30/11/1965", urn:"urn:lex:br:federal:lei:1965-11-30;4868-a", ementa:"Estende a jurisdição das Juntas de Conciliação e Julgamento de Campos e   Nova Friburgo.", arquivo:"federal/leis-ordinarias/1965/lei-4868-a-1965-11-30.md"}}, {id:"federal:BR:L:4835/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-09", numero:"4835", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-09;4835", vigente:true, titulo:"Lei nº 4.835 de 09/11/1965", urn:"urn:lex:br:federal:lei:1965-11-09;4835", ementa:"Autoriza a abertura, pela Secretaria de Finanças da Prefeitura do Distrito Federal, do crédito especial de Cr$ 619.790.191 (seiscentos e dezenove milhões, setecentos e noventa mil, cento e noventa e ; um cruzeiros), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4835-1965-11-09.md"}}, {id:"federal:BR:L:4648/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-31", numero:"4648", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-31;4648", vigente:true, titulo:"Lei nº 4.648 de 31/05/1965", urn:"urn:lex:br:federal:lei:1965-05-31;4648", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Aeronáutica, o   crédito especial de Cr$ 950.000.000,00 (novecentos e cinquenta milhões de   cruzeiros), para os fins que especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4648-1965-05-31.md"}}, {id:"federal:BR:L:4761/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-08-23", numero:"4761", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-08-23;4761", vigente:true, titulo:"Lei nº 4.761 de 23/08/1965", urn:"urn:lex:br:federal:lei:1965-08-23;4761", ementa:"Autoriza o Poder Executivo a abrir ao Estado Maior das Fôrças Armadas e   aos Ministérios Militares o crédito especial de Cr$ 6.400.000.000 para atender a   despesas com o Destacamento Brasileiro da Fôrça Armada Interamericana ( FAIBRÁS   ).", arquivo:"federal/leis-ordinarias/1965/lei-4761-1965-08-23.md"}}, {id:"federal:BR:L:4658/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-02", numero:"4658", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-02;4658", vigente:true, titulo:"Lei nº 4.658 de 02/06/1965", urn:"urn:lex:br:federal:lei:1965-06-02;4658", ementa:"Isenta dos impostos de importação e de consumo equipamento de televisão   destinado à Rádio Difusora São Paulo S.A.", arquivo:"federal/leis-ordinarias/1965/lei-4658-1965-06-02.md"}}, {id:"federal:BR:L:4855/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-25", numero:"4855", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-25;4855", vigente:true, titulo:"Lei nº 4.855 de 25/11/1965", urn:"urn:lex:br:federal:lei:1965-11-25;4855", ementa:"Vincula ao Ministério da Viação e Obras Públicas a Companhia de Navegação   do São Francisco, Sociedade de Economia Mista.", arquivo:"federal/leis-ordinarias/1965/lei-4855-1965-11-25.md"}}, {id:"federal:BR:L:4735/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-14", numero:"4735", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-14;4735", vigente:true, titulo:"Lei nº 4.735 de 14/07/1965", urn:"urn:lex:br:federal:lei:1965-07-14;4735", ementa:"Concede isenção de direitos, imposto de consumo e taxas aduaneiras, exceto a de previdência social, para importação de objetos doados pela Holanda à Província Carmelita de Santo Elias.", arquivo:"federal/leis-ordinarias/1965/lei-4735-1965-07-14.md"}}, {id:"federal:BR:L:4870/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-01", numero:"4870", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-01;4870", vigente:true, titulo:"Lei nº 4.870 de 01/12/1965", urn:"urn:lex:br:federal:lei:1965-12-01;4870", ementa:"Dispõe sôbre a produção açucareira a receita do Instituto do Açúcar e do Álcool e sua aplicação, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4870-1965-12-01.md"}}, {id:"federal:BR:L:4831/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-05", numero:"4831", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-05;4831", vigente:true, titulo:"Lei nº 4.831 de 05/11/1965", urn:"urn:lex:br:federal:lei:1965-11-05;4831", ementa:"Dispõe sôbre as novas denominações das Universidades Federais das cidades   do Rio de Janeiro e de Niterói.", arquivo:"federal/leis-ordinarias/1965/lei-4831-1965-11-05.md"}}, {id:"federal:BR:L:4630/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-14", numero:"4630", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-14;4630", vigente:true, titulo:"Lei nº 4.630 de 14/05/1965", urn:"urn:lex:br:federal:lei:1965-05-14;4630", ementa:"Dá a denominação de \"Prefeito Emílio Sesti\" à barragem de Furnas do   Segrêdo, no Rio Jaguari, Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1965/lei-4630-1965-05-14.md"}}, {id:"federal:BR:L:4823/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-04", numero:"4823", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-04;4823", vigente:true, titulo:"Lei nº 4.823 de 04/11/1965", urn:"urn:lex:br:federal:lei:1965-11-04;4823", ementa:"Concede isenção do impôsto de importação e de taxas aduaneiras para   materiais a serem importados pela Rádio Santana Limitada, de Anápolis, Estado de   Goiás e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4823-1965-11-04.md"}}, {id:"federal:BR:L:4812/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-25", numero:"4812", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-25;4812", vigente:true, titulo:"Lei nº 4.812 de 25/10/1965", urn:"urn:lex:br:federal:lei:1965-10-25;4812", ementa:"Concede pensão especial a Dª. Hermínia Furtado Reis.", arquivo:"federal/leis-ordinarias/1965/lei-4812-1965-10-25.md"}}, {id:"federal:BR:L:4887/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-09", numero:"4887", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-09;4887", vigente:true, titulo:"Lei nº 4.887 de 09/12/1965", urn:"urn:lex:br:federal:lei:1965-12-09;4887", ementa:"Autoriza o Ministério da Fazenda a efetuar a doação de Obrigações   Reajustáveis do Tesouro Nacional às entidades que menciona, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1965/lei-4887-1965-12-09.md"}}, {id:"federal:BR:L:4669/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-08", numero:"4669", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-08;4669", vigente:true, titulo:"Lei nº 4.669 de 08/06/1965", urn:"urn:lex:br:federal:lei:1965-06-08;4669", ementa:"Complementa a Lei nº 3.917, de 14 de julho de 1961, que \"reorganizou o   Ministério das Relações Exteriores\".", arquivo:"federal/leis-ordinarias/1965/lei-4669-1965-06-08.md"}}, {id:"federal:BR:L:4781/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-09-28", numero:"4781", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-09-28;4781", vigente:true, titulo:"Lei nº 4.781 de 28/09/1965", urn:"urn:lex:br:federal:lei:1965-09-28;4781", ementa:"Concede isenção de licença de importação, tributos e emolumentos   consulares para donativos destinados às obras de assistência social, mantidas   pela Sociedade das Obras Sociais e Educativas - Estado da Bahia.", arquivo:"federal/leis-ordinarias/1965/lei-4781-1965-09-28.md"}}, {id:"federal:BR:L:4607/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-03-30", numero:"4607", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-03-30;4607", vigente:true, titulo:"Lei nº 4.607 de 30/03/1965", urn:"urn:lex:br:federal:lei:1965-03-30;4607", ementa:"Ratifica convênio celebrado pela Prefeitura do Distrito Federal e autoriza   a inclusão no seu orçamento de verba correspondente até 1% das rendas   tributárias, para atender a despesas com a ;execução do ajuste.", arquivo:"federal/leis-ordinarias/1965/lei-4607-1965-03-30.md"}}, {id:"federal:BR:L:4807/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-21", numero:"4807", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-21;4807", vigente:true, titulo:"Lei nº 4.807 de 21/10/1965", urn:"urn:lex:br:federal:lei:1965-10-21;4807", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Tribunal Superior   Eleitoral - o crédito especial de Cr$ 519.550 (quinhentos e dezenove mil,   quinhentos e cinqüenta cruzeiros), para atender a despesas efetuadas com a   realização de eleições em 1963 e 1964.", arquivo:"federal/leis-ordinarias/1965/lei-4807-1965-10-21.md"}}, {id:"federal:BR:L:4756/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigen