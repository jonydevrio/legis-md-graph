", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1840-05-12;105", vigente:true, titulo:"Lei nº 105 de 12/05/1840", urn:"urn:lex:br:federal:lei:1840-05-12;105", ementa:"INTERPRETA ALGUNS ARTIGOS DA REFORMA CONSTITUCIONAL.", arquivo:"federal/leis-ordinarias/1840/lei-105-1840-05-12.md"}}, {id:"federal:BR:L:164/1840", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1840, data:"1840-09-26", numero:"164", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1840-09-26;164", vigente:true, titulo:"Lei nº 164 de 26/09/1840", urn:"urn:lex:br:federal:lei:1840-09-26;164", ementa:"FIXANDO A DESPESA, E ORÇANDO A RECEITA PARA O EXERCICIO DO ANO FINANCEIRO DE 1841-1842.", arquivo:"federal/leis-ordinarias/1840/lei-164-1840-09-26.md"}}, {id:"federal:BR:L:149/1840", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1840, data:"1840-08-27", numero:"149", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1840-08-27;149", vigente:true, titulo:"Lei nº 149 de 27/08/1840", urn:"urn:lex:br:federal:lei:1840-08-27;149", ementa:"FIXANDO AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1841 A 1842.", arquivo:"federal/leis-ordinarias/1840/lei-149-1840-08-27.md"}}, {id:"federal:BR:L:166/1840", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1840, data:"1840-09-29", numero:"166", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1840-09-29;166", vigente:true, titulo:"Lei nº 166 de 29/09/1840", urn:"urn:lex:br:federal:lei:1840-09-29;166", ementa:"ESTABELECE A DOTAÇÃO DE SUA ALTEZA IMPERIAL, QUANDO HORVER DE REALIZAR-SE O SEU CONSORCIO.", arquivo:"federal/leis-ordinarias/1840/lei-166-1840-09-29.md"}}, {id:"federal:BR:L:4310/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-23", numero:"4310", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-23;4310", vigente:true, titulo:"Lei nº 4.310 de 23/12/1963", urn:"urn:lex:br:federal:lei:1963-12-23;4310", ementa:"Autoriza a abertura, pelo Ministério da Viação e Obras Públicas, do crédito especial de Cr$ 3.000.000.000,00 (três bilhões de cruzeiros) para execução de obras e serviços da Adutora do Rio das Velhas, em Belo Horizonte.", arquivo:"federal/leis-ordinarias/1963/lei-4310-1963-12-23.md"}}, {id:"federal:BR:L:4301/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-23", numero:"4301", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-23;4301", vigente:true, titulo:"Lei nº 4.301 de 23/12/1963", urn:"urn:lex:br:federal:lei:1963-12-23;4301", ementa:"Altera o art. 60, do preâmbulo, do Código da Justiça Militar (Decreto-lei nº 925, de 2 de dezembro de 1938).", arquivo:"federal/leis-ordinarias/1963/lei-4301-1963-12-23.md"}}, {id:"federal:BR:L:4202/1963", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-02-06", numero:"4202", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-02-06;4202", vigente:true, titulo:"Lei nº 4.202 de 06/02/1963", urn:"urn:lex:br:federal:lei:1963-02-06;4202", ementa:"Altera o imposto de faróis incidente sôbre navios estrangeiros que demandam portos do Brasil.", arquivo:"federal/leis-ordinarias/1963/lei-4202-1963-02-06.md"}}, {id:"federal:BR:L:4259/1963", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-09-12", numero:"4259", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-09-12;4259", vigente:true, titulo:"Lei nº 4.259 de 12/09/1963", urn:"urn:lex:br:federal:lei:1963-09-12;4259", ementa:"Dispõe sobre a situação dos contribuintes do Montepio Civil dos Funcionários Públicos Federais, e dá outras providências.", arquivo:"federal/leis-ordinarias/1963/lei-4259-1963-09-12.md"}}, {id:"federal:BR:L:4230/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-06-01", numero:"4230", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-06-01;4230", vigente:true, titulo:"Lei nº 4.230 de 01/06/1963", urn:"urn:lex:br:federal:lei:1963-06-01;4230", ementa:"Concede isenção de direitos aduaneiros, adicional de 10%, imposto de consumo e mais taxas alfandegárias para equipamento importado pela Empresa Telefônica Aquidauanense Ltda., Companhia Telefônica de Valinhos e Empresa de Melhoramentos de Andradina - EMA - Construtora S.A.", arquivo:"federal/leis-ordinarias/1963/lei-4230-1963-06-01.md"}}, {id:"federal:BR:L:4226/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-05-23", numero:"4226", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-05-23;4226", vigente:true, titulo:"Lei nº 4.226 de 23/05/1963", urn:"urn:lex:br:federal:lei:1963-05-23;4226", ementa:"Denomina Hospital Professor Edgard Santos o atual Hospital das Clínicas da Universidade da Bahia.", arquivo:"federal/leis-ordinarias/1963/lei-4226-1963-05-23.md"}}, {id:"federal:BR:L:4318/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-23", numero:"4318", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-23;4318", vigente:true, titulo:"Lei nº 4.318 de 23/12/1963", urn:"urn:lex:br:federal:lei:1963-12-23;4318", ementa:"Orça a Receita e fixa a Despesa do Distrito Federal para o exercício de 1964.", arquivo:"federal/leis-ordinarias/1963/lei-4318-1963-12-23.md"}}, {id:"federal:BR:L:4229/1963", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigenc