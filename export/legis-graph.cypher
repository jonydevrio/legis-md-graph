ederal:lei:1963-02-09;4209", vigente:true, titulo:"Lei nº 4.209 de 09/02/1963", urn:"urn:lex:br:federal:lei:1963-02-09;4209", ementa:"Altera a denominação do Instituto Joaquim Nabuco, para Instituto Joaquim   Nabuco de Pesquisas Sociais, com sede no Recife, Estado de   Pernambuco.", arquivo:"federal/leis-ordinarias/1963/lei-4209-1963-02-09.md"}}, {id:"federal:BR:L:4269/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-10-22", numero:"4269", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-10-22;4269", vigente:true, titulo:"Lei nº 4.269 de 22/10/1963", urn:"urn:lex:br:federal:lei:1963-10-22;4269", ementa:"Dá nova redação ao artigo 19 da Lei n.º 4.154, de 28 de dezembro de 1962   (dispõe sobre legislação de rendas).", arquivo:"federal/leis-ordinarias/1963/lei-4269-1963-10-22.md"}}, {id:"federal:BR:L:4254/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-08-30", numero:"4254", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-08-30;4254", vigente:true, titulo:"Lei nº 4.254 de 30/08/1963", urn:"urn:lex:br:federal:lei:1963-08-30;4254", ementa:"Concede pensão a viúva do ex-funcionário público federal Leopoldo Bernardes dos Santos.", arquivo:"federal/leis-ordinarias/1963/lei-4254-1963-08-30.md"}}, {id:"federal:BR:L:4296/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-20", numero:"4296", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-20;4296", vigente:true, titulo:"Lei nº 4.296 de 20/12/1963", urn:"urn:lex:br:federal:lei:1963-12-20;4296", ementa:"Autoriza o Poder Executivo a doar imóvel à Prefeitura Municipal de Aquidauana, Estado de Mato Grosso.", arquivo:"federal/leis-ordinarias/1963/lei-4296-1963-12-20.md"}}, {id:"federal:BR:L:4277/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-11-04", numero:"4277", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-11-04;4277", vigente:true, titulo:"Lei nº 4.277 de 04/11/1963", urn:"urn:lex:br:federal:lei:1963-11-04;4277", ementa:"Abre ao Poder Legislativo - Subanexo 2.01- Câmara dos Deputados - o crédito suplementar de Cr$ 2.241.410.000,00, ao Orçamento da União para o exercício financeiro de 1963.", arquivo:"federal/leis-ordinarias/1963/lei-4277-1963-11-04.md"}}, {id:"federal:BR:L:4286/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-03", numero:"4286", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-03;4286", vigente:true, titulo:"Lei nº 4.286 de 03/12/1963", urn:"urn:lex:br:federal:lei:1963-12-03;4286", ementa:"Proíbe a distribuição dos saldos das autarquias a seus   funcionários.", arquivo:"federal/leis-ordinarias/1963/lei-4286-1963-12-03.md"}}, {id:"federal:BR:L:4207/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-02-07", numero:"4207", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-02-07;4207", vigente:true, titulo:"Lei nº 4.207 de 07/02/1963", urn:"urn:lex:br:federal:lei:1963-02-07;4207", ementa:"Altera o Quadro do Pessoal da Secretaria do Tribunal Regional Eleitoral de São Paulo e do Tribunal Regional Eleitoral do Distrito Federal.", arquivo:"federal/leis-ordinarias/1963/lei-4207-1963-02-07.md"}}, {id:"federal:BR:L:4252/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-08-10", numero:"4252", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-08-10;4252", vigente:true, titulo:"Lei nº 4.252 de 10/08/1963", urn:"urn:lex:br:federal:lei:1963-08-10;4252", ementa:"Dispõe sôbre a divisão do território nacional em Zonas Aéreas.", arquivo:"federal/leis-ordinarias/1963/lei-4252-1963-08-10.md"}}, {id:"federal:BR:L:4274/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-10-31", numero:"4274", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-10-31;4274", vigente:true, titulo:"Lei nº 4.274 de 31/10/1963", urn:"urn:lex:br:federal:lei:1963-10-31;4274", ementa:"Dispõe sôbre pagamento relativo às importações feitas por empresas concessionárias de serviços telefônicos, e dá outras providências.", arquivo:"federal/leis-ordinarias/1963/lei-4274-1963-10-31.md"}}, {id:"federal:BR:L:4316/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-23", numero:"4316", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-23;4316", vigente:true, titulo:"Lei nº 4.316 de 23/12/1963", urn:"urn:lex:br:federal:lei:1963-12-23;4316", ementa:"Autoriza o Poder Executivo a abrir o crédito especial de Cr$   600.000.000,00 (seiscentos milhões de cruzeiros), em favor do Estado da   Guanabara, destinado aos festejos comemorativos do quadricentenário da Cidade do   Rio de Janeiro, a realizar-se em 1965.", arquivo:"federal/leis-ordinarias/1963/lei-4316-1963-12-23.md"}}, {id:"federal:BR:L:4291/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-12", numero:"4291", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-12;4291", vigente:true, titulo:"Lei nº 4.291 de 12/12/1963", urn:"urn:lex:br:federal:lei:1963-12-12;4291", ementa:"Altera dispositivo da Lei n.º 3.242, de 13 de agosto de 1957, \"que reorganiza as Secretarias do Ministério Público da União junto à Justiça do Trabalho, cria o respectivo Quadro de Pessoal e dá outras providências.", arquivo:"federal/leis-ordinarias/1963/lei-4291-1963-12-12.md"}}, {id:"federal:BR:L:4307/1963", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-23", numero:"4307", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-23;4307", vigente:true, titulo:"Lei nº 4.307 de 23/12/1963", urn:"urn:lex:br:federal:lei:1963-12-23;4307", ementa:"Federaliza a Escola Superior de Agricultura de Lavras (ESAL) e dá outras providências.", arquivo:"federal/leis-ordinarias/1963/lei-4307-1963-12-23.md"}}, {id:"federal:BR:L:4266/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-10-03", numero:"4266", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-10-03;4266", vigente:true, titulo:"Lei nº 4.266 de 03/10/1963", urn:"urn:lex:br:federal:lei:1963-10-03;4266", ementa:"Institui o salário-família do Trabalhador e dá outras providências.", arquivo:"federal/leis-ordinarias/1963/lei-4266-1963-10-03.md"}}, {id:"federal:BR:L:4233/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-06-13", numero:"4233", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-06-13;4233", vigente:true, titulo:"Lei nº 4.233 de 13/06/1963", urn:"urn:lex:br:federal:lei:1963-06-13;4233", ementa:"Concede isenção de direitos de importação e demais taxas aduaneiras e imposto de consumo para os materiais importados pelas Centrais Elétricas de Minas Gerais S.A. e Espírito Santo Centrais Elétricas Sociedade Anônima.", arquivo:"federal/leis-ordinarias/1963/lei-4233-1963-06-13.md"}}, {id:"federal:BR:L:4272/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-10-24", numero:"4272", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-10-24;4272", vigente:true, titulo:"Lei nº 4.272 de 24/10/1963", urn:"urn:lex:br:federal:lei:1963-10-24;4272", ementa:"Isenta dos impostos de importação e de consumo, exceto a taxa de previdência social, equipamento importado pela Empresa Telefônica de Nova Friburgo.", arquivo:"federal/leis-ordinarias/1963/lei-4272-1963-10-24.md"}}, {id:"federal:BR:L:4243/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-07-19", numero:"4243", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-07-19;4243", vigente:true, titulo:"Lei nº 4.243 de 19/07/1963", urn:"urn:lex:br:federal:lei:1963-07-19;4243", ementa:"Cria, para o cumprimento da Lei n. 3401, de 12 de junho de 1958, cargos no Quadro do Pessoal, Parte Permanente, do Ministério da Educação e Cultura, e dá outras providências.", arquivo:"federal/leis-ordinarias/1963/lei-4243-1963-07-19.md"}}, {id:"federal:BR:L:4295/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-16", numero:"4295", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-16;4295", vigente:true, titulo:"Lei nº 4.295 de 16/12/1963", urn:"urn:lex:br:federal:lei:1963-12-16;4295", ementa:"Estima a Receita e fixa a Despesa da União para o Exercício Financeiro de 1964.", arquivo:"federal/leis-ordinarias/1963/lei-4295-1963-12-16.md"}}, {id:"federal:BR:L:4201/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-02-05", numero:"4201", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-02-05;4201", vigente:true, titulo:"Lei nº 4.201 de 05/02/1963", urn:"urn:lex:br:federal:lei:1963-02-05;4201", ementa:"Concede isenção dos impostos de importação e de consumo e outros tributos à Companhia Siderúrgica da Guanabara ( COSIGUA ).", arquivo:"federal/leis-ordinarias/1963/lei-4201-1963-02-05.md"}}, {id:"federal:BR:L:4311/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-23", numero:"4311", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-23;4311", vigente:true, titulo:"Lei nº 4.311 de 23/12/1963", urn:"urn:lex:br:federal:lei:1963-12-23;4311", ementa:"Autoriza o Poder Executivo a abrir o crédito especial de Cr$   885.000.000,00 (oitocentos e oitenta e cinco milhões de cruzeiros), para   construção de rede de abastecimento d''água, em cidades do Estado de Santa   Catarina.", arquivo:"federal/leis-ordinarias/1963/lei-4311-1963-12-23.md"}}, {id:"federal:BR:L:4213/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-02-14", numero:"4213", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-02-14;4213", vigente:true, titulo:"Lei nº 4.213 de 14/02/1963", urn:"urn:lex:br:federal:lei:1963-02-14;4213", ementa:"Reorganiza o Departamento Nacional de Portos, Rios e Canais, dando-lhe a denominação de Departamento Nacional de Portos e Vias Navegáveis, disciplina a aplicação do Fundo Portuário Nacional e dá outras providências.", arquivo:"federal/leis-ordinarias/1963/lei-4213-1963-02-14.md"}}, {id:"federal:BR:L:4249/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-08-06", numero:"4249", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-08-06;4249", vigente:true, titulo:"Lei nº 4.249 de 06/08/1963", urn:"urn:lex:br:federal:lei:1963-08-06;4249", ementa:"Prorroga pelo prazo de um exercício a vigência da Lei n.º 3.974, de 25 de outubro de 1961, que concede crédito especial destinado a obras da rodovia Belém-Brasília.", arquivo:"federal/leis-ordinarias/1963/lei-4249-1963-08-06.md"}}, {id:"federal:BR:L:4239/1963", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-06-27", numero:"4239", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-06-27;4239", vigente:true, titulo:"Lei nº 4.239 de 27/06/1963", urn:"urn:lex:br:federal:lei:1963-06-27;4239", ementa:"Aprova o Plano Diretor do Desenvolvimento do Nordeste para os anos de 1963, 1964 e 1965, e dá outras providências.", arquivo:"federal/leis-ordinarias/1963/lei-4239-1963-06-27.md"}}, {id:"federal:BR:L:4223/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-05-10", numero:"4223", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-05-10;4223", vigente:true, titulo:"Lei nº 4.223 de 10/05/1963", urn:"urn:lex:br:federal:lei:1963-05-10;4223", ementa:"Autoriza o Poder Executivo a permutar o terreno de propriedade da 3ª Base Aérea de Canoas, no Estado do Rio Grande do Sul, pelo terreno de propriedade de Ernesto Baron, situado no perímetro da referida Base.", arquivo:"federal/leis-ordinarias/1963/lei-4223-1963-05-10.md"}}, {id:"federal:BR:L:4198/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-01-28", numero:"4198", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-01-28;4198", vigente:true, titulo:"Lei nº 4.198 de 28/01/1963", urn:"urn:lex:br:federal:lei:1963-01-28;4198", ementa:"Acresce a Comissão Nacional de Fiscalização de Entorpecentes, de um integrante, como representante do Ministério da Aeronáutica.", arquivo:"federal/leis-ordinarias/1963/lei-4198-1963-01-28.md"}}, {id:"federal:BR:L:4302/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-23", numero:"4302", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-23;4302", vigente:true, titulo:"Lei nº 4.302 de 23/12/1963", urn:"urn:lex:br:federal:lei:1963-12-23;4302", ementa:"Autoriza o Poder Executivo a abrir pelo Ministério da Guerra, o crédito especial de Cr$ 16.100.000,00 (dezesseis milhões e cem mil cruzeiros) destinado a atender às despesas de qualquer natureza decorrentes das comemorações do Sesquincentenário da Academia Militar das Agulhas Negras.", arquivo:"federal/leis-ordinarias/1963/lei-4302-1963-12-23.md"}}, {id:"federal:BR:L:4281/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-11-08", numero:"4281", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-11-08;4281", vigente:true, titulo:"Lei nº 4.281 de 08/11/1963", urn:"urn:lex:br:federal:lei:1963-11-08;4281", ementa:"Institui abono especial em caráter permanente, para aposentados de Institutos de Previdência.", arquivo:"federal/leis-ordinarias/1963/lei-4281-1963-11-08.md"}}, {id:"federal:BR:L:4228/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-05-31", numero:"4228", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-05-31;4228", vigente:true, titulo:"Lei nº 4.228 de 31/05/1963", urn:"urn:lex:br:federal:lei:1963-05-31;4228", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Saúde, o crédito especial de Cr$ 3.000.000,00 (três milhões de cruzeiros) destinado a atender às despesas do IV Congresso Latino Americano de Psicanálise.", arquivo:"federal/leis-ordinarias/1963/lei-4228-1963-05-31.md"}}, {id:"federal:BR:L:4208/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-02-09", numero:"4208", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-02-09;4208", vigente:true, titulo:"Lei nº 4.208 de 09/02/1963", urn:"urn:lex:br:federal:lei:1963-02-09;4208", ementa:"Transforma em unidades universitárias os Cursos de Odontologia e de Farmácia da Universidade de Minas Gerais.", arquivo:"federal/leis-ordinarias/1963/lei-4208-1963-02-09.md"}}, {id:"federal:BR:L:4227/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-05-23", numero:"4227", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-05-23;4227", vigente:true, titulo:"Lei nº 4.227 de 23/05/1963", urn:"urn:lex:br:federal:lei:1963-05-23;4227", ementa:"Isenta dos impostos de importação e de consumo equipamento telefônico importado pela Companhia Telefônica de Campo Grande, no Estado de Mato Grosso.", arquivo:"federal/leis-ordinarias/1963/lei-4227-1963-05-23.md"}}, {id:"federal:BR:L:4246/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-07-20", numero:"4246", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-07-20;4246", vigente:true, titulo:"Lei nº 4.246 de 20/07/1963", urn:"urn:lex:br:federal:lei:1963-07-20;4246", ementa:"Autoriza a abertura de crédito especial de Cr$ 8.000.000,00, pelo Ministério da Saúde, para atender às despesas com o prosseguimento das obras do Hospital Matogrossense do Pênfigo, com sede em Campo Grande - Mato Grosso - e ampliação das instalações do Hospital do Pênfigo de Uberaba - Minas Gerais.", arquivo:"federal/leis-ordinarias/1963/lei-4246-1963-07-20.md"}}, {id:"federal:BR:L:4276/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-11-04", numero:"4276", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-11-04;4276", vigente:true, titulo:"Lei nº 4.276 de 04/11/1963", urn:"urn:lex:br:federal:lei:1963-11-04;4276", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 12.269.000.000,00 (doze bilhões, duzentos e sessenta e nove milhões de cruzeiros), para ocorrer ao pagamento da cota do imposto de consumo aos Municípios.", arquivo:"federal/leis-ordinarias/1963/lei-4276-1963-11-04.md"}}, {id:"federal:BR:L:4294/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-12", numero:"4294", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-12;4294", vigente:true, titulo:"Lei nº 4.294 de 12/12/1963", urn:"urn:lex:br:federal:lei:1963-12-12;4294", ementa:"Retifica, sem ônus, a Lei n.º 4.177, de 11 de dezembro de 1962, que estima a Receita e fixa a Despesa da União, para o Exercício financeiro de 1963.", arquivo:"federal/leis-ordinarias/1963/lei-4294-1963-12-12.md"}}, {id:"federal:BR:L:4261/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-09-12", numero:"4261", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-09-12;4261", vigente:true, titulo:"Lei nº 4.261 de 12/09/1963", urn:"urn:lex:br:federal:lei:1963-09-12;4261", ementa:"Concede pensão vitalícia de Cr$ 40.000,00 do jornalista Apparício Torelly.", arquivo:"federal/leis-ordinarias/1963/lei-4261-1963-09-12.md"}}, {id:"federal:BR:L:4315/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-23", numero:"4315", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-23;4315", vigente:true, titulo:"Lei nº 4.315 de 23/12/1963", urn:"urn:lex:br:federal:lei:1963-12-23;4315", ementa:"Isenta dos impostos de importação e de consumo material importado pela Companhia Telefônica de Minas Gerais.", arquivo:"federal/leis-ordinarias/1963/lei-4315-1963-12-23.md"}}, {id:"federal:BR:L:4206/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-02-07", numero:"4206", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-02-07;4206", vigente:true, titulo:"Lei nº 4.206 de 07/02/1963", urn:"urn:lex:br:federal:lei:1963-02-07;4206", ementa:"Autoriza a abertura de crédito especial de Cr$ 23.200.000,00, para construção de prédios destinados a Agências Postais-Telegráficas nas cidades que enumera.", arquivo:"federal/leis-ordinarias/1963/lei-4206-1963-02-07.md"}}, {id:"federal:BR:L:4271/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-10-24", numero:"4271", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-10-24;4271", vigente:true, titulo:"Lei nº 4.271 de 24/10/1963", urn:"urn:lex:br:federal:lei:1963-10-24;4271", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 400.000.000,00, destinado a participação da União, no exercício de 1962, da quota de capital da sociedade de economia mista Aços Finos Piratini S.A.", arquivo:"federal/leis-ordinarias/1963/lei-4271-1963-10-24.md"}}, {id:"federal:BR:L:4220/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-05-08", numero:"4220", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-05-08;4220", vigente:true, titulo:"Lei nº 4.220 de 08/05/1963", urn:"urn:lex:br:federal:lei:1963-05-08;4220", ementa:"Concede pensão especial de Cr$ 5.000,00 a Adalgisa Leal Braga, irmã inválida do funcionário Jorge Leal Braga.", arquivo:"federal/leis-ordinarias/1963/lei-4220-1963-05-08.md"}}, {id:"federal:BR:L:4306/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-23", numero:"4306", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-23;4306", vigente:true, titulo:"Lei nº 4.306 de 23/12/1963", urn:"urn:lex:br:federal:lei:1963-12-23;4306", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério da Fazenda o crédito especial   de Cr$ 250.000.000,00 (duzentos e cinquenta milhões de cruzeiros) para o   fim que especifica.", arquivo:"federal/leis-ordinarias/1963/lei-4306-1963-12-23.md"}}, {id:"federal:BR:L:4265/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-10-03", numero:"4265", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-10-03;4265", vigente:true, titulo:"Lei nº 4.265 de 03/10/1963", urn:"urn:lex:br:federal:lei:1963-10-03;4265", ementa:"Concede isenção de impostos de importação e de consumo para equipamento e maquinária importados pela Cooperativa de São Carlos, no Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1963/lei-4265-1963-10-03.md"}}, {id:"federal:BR:L:4199/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-02-04", numero:"4199", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-02-04;4199", vigente:true, titulo:"Lei nº 4.199 de 04/02/1963", urn:"urn:lex:br:federal:lei:1963-02-04;4199", ementa:"Cria Juntas de Conciliação e Julgamento na Quarta Região da Justiça do Trabalho.", arquivo:"federal/leis-ordinarias/1963/lei-4199-1963-02-04.md"}}, {id:"federal:BR:L:4212/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-02-11", numero:"4212", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-02-11;4212", vigente:true, titulo:"Lei nº 4.212 de 11/02/1963", urn:"urn:lex:br:federal:lei:1963-02-11;4212", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o crédito especial de Cr$ 80.000.000,00 para construção do prédio onde se instalará o Instituto de Química Agrícola e dá outras providências.", arquivo:"federal/leis-ordinarias/1963/lei-4212-1963-02-11.md"}}, {id:"federal:BR:L:4219/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-05-08", numero:"4219", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-05-08;4219", vigente:true, titulo:"Lei nº 4.219 de 08/05/1963", urn:"urn:lex:br:federal:lei:1963-05-08;4219", ementa:"Isenta dos impostos de importação e consumo uma central telefônica automática a ser importada pela Emprêsa Telefônica de Uberaba S.A., no Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/1963/lei-4219-1963-05-08.md"}}, {id:"federal:BR:L:4200/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-02-05", numero:"4200", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-02-05;4200", vigente:true, titulo:"Lei nº 4.200 de 05/02/1963", urn:"urn:lex:br:federal:lei:1963-02-05;4200", ementa:"Estabelece medidas de amparo à indústria de transporte aéreo, e dá outras providências.", arquivo:"federal/leis-ordinarias/1963/lei-4200-1963-02-05.md"}}, {id:"federal:BR:L:4256/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-09-09", numero:"4256", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-09-09;4256", vigente:true, titulo:"Lei nº 4.256 de 09/09/1963", urn:"urn:lex:br:federal:lei:1963-09-09;4256", ementa:"Aprova o ajuste de contas assinado entre o Governo Federal e o Governo do Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1963/lei-4256-1963-09-09.md"}}, {id:"federal:BR:L:4204/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-02-07", numero:"4204", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-02-07;4204", vigente:true, titulo:"Lei nº 4.204 de 07/02/1963", urn:"urn:lex:br:federal:lei:1963-02-07;4204", ementa:"Isenta do visto consular os desportistas, cidadãos de países americanos, que participarem dos IV Jogos Pan-Americanos.", arquivo:"federal/leis-ordinarias/1963/lei-4204-1963-02-07.md"}}, {id:"federal:BR:L:4313/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-23", numero:"4313", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-23;4313", vigente:true, titulo:"Lei nº 4.313 de 23/12/1963", urn:"urn:lex:br:federal:lei:1963-12-23;4313", ementa:"Dá nova discriminação às rodovias BR-55 e BR-66, do Plano Rodoviário   Nacional.", arquivo:"federal/leis-ordinarias/1963/lei-4313-1963-12-23.md"}}, {id:"federal:BR:L:4225/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-05-10", numero:"4225", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-05-10;4225", vigente:true, titulo:"Lei nº 4.225 de 10/05/1963", urn:"urn:lex:br:federal:lei:1963-05-10;4225", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Marinha, o crédito especial de Cr$ 50.000.000,00 para regularizar a despesa com a desapropriação da área mencionada no Decreto n. 42627, de 13 de novembro de 1957.", arquivo:"federal/leis-ordinarias/1963/lei-4225-1963-05-10.md"}}, {id:"federal:BR:L:4304/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-23", numero:"4304", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-23;4304", vigente:true, titulo:"Lei nº 4.304 de 23/12/1963", urn:"urn:lex:br:federal:lei:1963-12-23;4304", ementa:"Autoriza o Poder Executivo a abrir, através do Ministério da Aeronáutica,   o crédito especial de Cr$ 130.000.000,00 (cento e trinta milhões de cruzeiros)   para o prosseguimento das obras do Aeroporto de Corumbá.", arquivo:"federal/leis-ordinarias/1963/lei-4304-1963-12-23.md"}}, {id:"federal:BR:L:4210/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-02-11", numero:"4210", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-02-11;4210", vigente:true, titulo:"Lei nº 4.210 de 11/02/1963", urn:"urn:lex:br:federal:lei:1963-02-11;4210", ementa:"Reestrutura o Quadro da Secretaria do Tribunal de Contas da União e dá outras providências.", arquivo:"federal/leis-ordinarias/1963/lei-4210-1963-02-11.md"}}, {id:"federal:BR:L:4236/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-06-24", numero:"4236", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-06-24;4236", vigente:true, titulo:"Lei nº 4.236 de 24/06/1963", urn:"urn:lex:br:federal:lei:1963-06-24;4236", ementa:"Isenta dos impostos de importação e de consumo material importado pela Companhia Municipal de Transportes Coletivos.", arquivo:"federal/leis-ordinarias/1963/lei-4236-1963-06-24.md"}}, {id:"federal:BR:L:4250/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-08-08", numero:"4250", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-08-08;4250", vigente:true, titulo:"Lei nº 4.250 de 08/08/1963", urn:"urn:lex:br:federal:lei:1963-08-08;4250", ementa:"Retifica, sem ônus, a Lei n.º 3.994, de 9 de dezembro de 1961, que estima a Receita e fixa a Despesa da União para o exercício financeiro de 1962.", arquivo:"federal/leis-ordinarias/1963/lei-4250-1963-08-08.md"}}, {id:"federal:BR:L:4242/1963", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-07-17", numero:"4242", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-07-17;4242", vigente:true, titulo:"Lei nº 4.242 de 17/07/1963", urn:"urn:lex:br:federal:lei:1963-07-17;4242", ementa:"Fixa novos valores para os vencimentos dos servidores do Poder Executivo, Civis e Militares; institui o empréstimo compulsório; cria o Fundo Nacional de Investimentos, e dá outras providências.", arquivo:"federal/leis-ordinarias/1963/lei-4242-1963-07-17.md"}}, {id:"federal:BR:L:4217/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-05-08", numero:"4217", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-05-08;4217", vigente:true, titulo:"Lei nº 4.217 de 08/05/1963", urn:"urn:lex:br:federal:lei:1963-05-08;4217", ementa:"Concede pensão vitalícia de Cr$ 3.000,00 a Otília Barreto Trindade, viúva de Indalécio Trindade.", arquivo:"federal/leis-ordinarias/1963/lei-4217-1963-05-08.md"}}, {id:"federal:BR:L:4278/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-11-04", numero:"4278", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-11-04;4278", vigente:true, titulo:"Lei nº 4.278 de 04/11/1963", urn:"urn:lex:br:federal:lei:1963-11-04;4278", ementa:"Abre ao Poder Legislativo - Senado Federal - o crédito suplementar de Cr$ 1.068.245.000,00 (um bilhão e sessenta e oito milhões, duzentos e quarenta e cinco mil cruzeiros) como reforço das verbas que enumera.", arquivo:"federal/leis-ordinarias/1963/lei-4278-1963-11-04.md"}}, {id:"federal:BR:L:4234/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-06-17", numero:"4234", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-06-17;4234", vigente:true, titulo:"Lei nº 4.234 de 17/06/1963", urn:"urn:lex:br:federal:lei:1963-06-17;4234", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Saúde, o crédito especial de Cr$ 1.500.000,00 ( um milhão e quinhentos mil cruzeiros ) destinado a auxiliar o Colégio Brasileiro de Cirurgiões nas despesas realizadas com o VII Congresso Brasileiro de Cirurgia em julho de 1961, na cidade do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1963/lei-4234-1963-06-17.md"}}, {id:"federal:BR:L:4287/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-03", numero:"4287", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-03;4287", vigente:true, titulo:"Lei nº 4.287 de 03/12/1963", urn:"urn:lex:br:federal:lei:1963-12-03;4287", ementa:"Concede isenção fiscal à Petróleo Brasileiro S.A. e suas subsidiárias, a partir de 1º de janeiro de 1963, e dá outras providências.", arquivo:"federal/leis-ordinarias/1963/lei-4287-1963-12-03.md"}}, {id:"federal:BR:L:4247/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-07-30", numero:"4247", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-07-30;4247", vigente:true, titulo:"Lei nº 4.247 de 30/07/1963", urn:"urn:lex:br:federal:lei:1963-07-30;4247", ementa:"Dispõe sobre o auxílio da União aos programas e atividades esportivas dos Clubes de Caça e Tiro e associações congêneres das zonas de colonização.", arquivo:"federal/leis-ordinarias/1963/lei-4247-1963-07-30.md"}}, {id:"federal:BR:L:4290/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-05", numero:"4290", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-05;4290", vigente:true, titulo:"Lei nº 4.290 de 05/12/1963", urn:"urn:lex:br:federal:lei:1963-12-05;4290", ementa:"Modifica dispositivos do Código do Processo Civil.", arquivo:"federal/leis-ordinarias/1963/lei-4290-1963-12-05.md"}}, {id:"federal:BR:L:4317/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-23", numero:"4317", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-23;4317", vigente:true, titulo:"Lei nº 4.317 de 23/12/1963", urn:"urn:lex:br:federal:lei:1963-12-23;4317", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o crédito especial de Cr$ 125.000.000,00 (cento e vinte e cinco milhões de cruzeiros) a fim de atender aos agricultores e entidades dos municípios atingidos por violento temporal e chuva de granizo, no Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1963/lei-4317-1963-12-23.md"}}, {id:"federal:BR:L:4285/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-11-20", numero:"4285", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-11-20;4285", vigente:true, titulo:"Lei nº 4.285 de 20/11/1963", urn:"urn:lex:br:federal:lei:1963-11-20;4285", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras Públicas, o crédito especial de Cr$ 980.000.000,00 destinado, a fazer face às despesas com os trabalhos de construção da ligação rodoviária Fortaleza-Brasília.", arquivo:"federal/leis-ordinarias/1963/lei-4285-1963-11-20.md"}}, {id:"federal:BR:L:4241/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-07-05", numero:"4241", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-07-05;4241", vigente:true, titulo:"Lei nº 4.241 de 05/07/1963", urn:"urn:lex:br:federal:lei:1963-07-05;4241", ementa:"Promove \"post-mortem\" ao posto de General-de-Divisão o Coronel de Infantaria Pedro Ângelo Corrêa.", arquivo:"federal/leis-ordinarias/1963/lei-4241-1963-07-05.md"}}, {id:"federal:BR:L:4244/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-07-20", numero:"4244", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-07-20;4244", vigente:true, titulo:"Lei nº 4.244 de 20/07/1963", urn:"urn:lex:br:federal:lei:1963-07-20;4244", ementa:"Estabelece normas para o recebimento de verbas orçamentárias e créditos da Justiça do Trabalho.", arquivo:"federal/leis-ordinarias/1963/lei-4244-1963-07-20.md"}}, {id:"federal:BR:L:4273/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-10-24", numero:"4273", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-10-24;4273", vigente:true, titulo:"Lei nº 4.273 de 24/10/1963", urn:"urn:lex:br:federal:lei:1963-10-24;4273", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Saúde, o crédito especial de Cr$ 38.115.777,70 para pagamento dos débitos do Serviço Nacional de Tuberculose, referentes aos exercícios de 1955 a 1959.", arquivo:"federal/leis-ordinarias/1963/lei-4273-1963-10-24.md"}}, {id:"federal:BR:L:4231/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-06-07", numero:"4231", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-06-07;4231", vigente:true, titulo:"Lei nº 4.231 de 07/06/1963", urn:"urn:lex:br:federal:lei:1963-06-07;4231", ementa:"Releva a prescrição em que incorreu o direito à reforma, por incapacidade física, do ex-soldado do Exército Jorge Lado Cés.", arquivo:"federal/leis-ordinarias/1963/lei-4231-1963-06-07.md"}}, {id:"federal:BR:L:4308/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-23", numero:"4308", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-23;4308", vigente:true, titulo:"Lei nº 4.308 de 23/12/1963", urn:"urn:lex:br:federal:lei:1963-12-23;4308", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito   especial de Cr$ 11.000.000,00 (onze milhões de cruzeiros), em favor da   Prefeitura Municipal de Piratuba, Estado de Santa Catarina, e um crédito   especial de Cr$ 2.000.000.000,00 (dois bilhões de cruzeiros) para acorrer aos   prejuizos causados pelas enchentes verificadas no Estado do Rio Grande do   Sul.", arquivo:"federal/leis-ordinarias/1963/lei-4308-1963-12-23.md"}}, {id:"federal:BR:L:4222/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-05-08", numero:"4222", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-05-08;4222", vigente:true, titulo:"Lei nº 4.222 de 08/05/1963", urn:"urn:lex:br:federal:lei:1963-05-08;4222", ementa:"Concede a pensão especial de Cr$ 3.750,00 mensais à família de Domingos Luiz Rotti, servidor do Arsenal de Marinha do Rio de Janeiro, do Ministério da Marinha, falecido em consequência de doença profissional.", arquivo:"federal/leis-ordinarias/1963/lei-4222-1963-05-08.md"}}, {id:"federal:BR:L:4300/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-23", numero:"4300", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-23;4300", vigente:true, titulo:"Lei nº 4.300 de 23/12/1963", urn:"urn:lex:br:federal:lei:1963-12-23;4300", ementa:"Eleva o efetivo de Almirante de Esquadra do Corpo da Armada.", arquivo:"federal/leis-ordinarias/1963/lei-4300-1963-12-23.md"}}, {id:"federal:BR:L:4298/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-23", numero:"4298", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-23;4298", vigente:true, titulo:"Lei nº 4.298 de 23/12/1963", urn:"urn:lex:br:federal:lei:1963-12-23;4298", ementa:"Altera o quadro do pessoal da Secretaria do Tribunal Regional Eleitoral do   Rio Grande do Sul e dá outras providências.", arquivo:"federal/leis-ordinarias/1963/lei-4298-1963-12-23.md"}}, {id:"federal:BR:L:4258/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-09-12", numero:"4258", fonte