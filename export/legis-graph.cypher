.", arquivo:"federal/leis-ordinarias/1997/lei-9469-1997-07-10.md"}}, {id:"federal:BR:L:9459/1997", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1997, data:"1997-05-13", numero:"9459", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1997-05-13;9459", vigente:true, titulo:"Lei nº 9.459 de 13/05/1997", urn:"urn:lex:br:federal:lei:1997-05-13;9459", ementa:"Altera os arts. 1º e 20 da Lei nº 7.716, de 5 de janeiro de 1989, que define os crimes resultantes de preconceito de raça ou de cor, e acrescenta parágrafo no art. 140 do Decreto-lei e 2.848, de 7 de dezembro de 1940.", arquivo:"federal/leis-ordinarias/1997/lei-9459-1997-05-13.md"}}, {id:"federal:BR:L:9581/1997", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1997, data:"1997-12-19", numero:"9581", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1997-12-19;9581", vigente:true, titulo:"Lei nº 9.581 de 19/12/1997", urn:"urn:lex:br:federal:lei:1997-12-19;9581", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento Fiscal da União, em favor   de Encargos Financeiros da União - Recursos sob Supervisão do Ministério da   Fazenda, crédito suplementar no valor de R$ 35.358.083,00, para os fins que   especifica.", arquivo:"federal/leis-ordinarias/1997/lei-9581-1997-12-19.md"}}, {id:"federal:BR:L:9560/1997", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1997, data:"1997-12-18", numero:"9560", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1997-12-18;9560", vigente:true, titulo:"Lei nº 9.560 de 18/12/1997", urn:"urn:lex:br:federal:lei:1997-12-18;9560", ementa:"Autoriza o Poder Executivo a abrir aos Orçamentos Fiscal e da Seguridade   Social da União, em favor do Ministério da Fazenda, do Ministério do   Planejamento e Orçamento e de Transferências a Estados, Distrito Federal e   Municípios, crédi