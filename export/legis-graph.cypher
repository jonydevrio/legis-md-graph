6384", ementa:"Regula a eleição para prefeito, vice-prefeito e vereadores, nos municípios   que deixaram de fazê-la no dia 15 de novembro de 1976.", arquivo:"federal/leis-ordinarias/1976/lei-6384-1976-12-07.md"}}, {id:"federal:BR:L:6404/1976", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1976, data:"1976-12-15", numero:"6404", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1976-12-15;6404", vigente:true, titulo:"Lei nº 6.404 de 15/12/1976", urn:"urn:lex:br:federal:lei:1976-12-15;6404", ementa:"Dispõe sobre as sociedades por ações.", arquivo:"federal/leis-ordinarias/1976/lei-6404-1976-12-15.md"}}, {id:"federal:BR:L:6323/1976", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1976, data:"1976-04-14", numero:"6323", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1976-04-14;6323", vigente:true, titulo:"Lei nº 6.323 de 14/04/1976", urn:"urn:lex:br:federal:lei:1976-04-14;6323", ementa:"Reajusta os vencimentos dos servidores do Senado Federal e dá outras providências.", arquivo:"federal/leis-ordinarias/1976/lei-6323-1976-04-14.md"}}, {id:"federal:BR:L:6395/1976", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1976, data:"1976-12-09", numero:"6395", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1976-12-09;6395", vigente:true, titulo:"Lei nº 6.395 de 09/12/1976", urn:"urn:lex:br:federal:lei:1976-12-09;6395", ementa:"Estima a Receita e Fixa a Despesa da União para o Exercício Financeiro de 1977.", arquivo:"federal/leis-ordinarias/1976/lei-6395-1976-12-09.md"}}, {id:"federal:BR:L:6379/1976", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1976, data:"1976-12-07", numero:"6379", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1976-12-07;6379", vigente:true, titulo:"Lei nº 6.379 de 07/12/1976", urn:"urn:lex:br:federal:lei:1976-12-07;6379", ementa:"Autoriza o Poder Executivo a abrir à Justiça Eleitoral, em favor do   Tribunal Regional Eleitoral do Acre, o crédito especial de Cr$ 615.800,00 para o   fim que especifica.", arquivo:"federal/leis-ordinarias/1976/lei-6379-1976-12-07.md"}}, {id:"federal:BR:L:6386/1976", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1976, data:"1976-12-09", numero:"6386", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1976-12-09;6386", vigente:true, titulo:"Lei nº 6.386 de 09/12/1976", urn:"urn:lex:br:federal:lei:1976-12-09;6386", ementa:"Altera dispositivos da Consolidação das Leis do Trabalho e dá outras providências.", arquivo:"federal/leis-ordinarias/1976/lei-6386-1976-12-09.md"}}, {id:"federal:BR:L:6327/1976", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1976, data:"1976-05-04", numero:"6327", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1976-05-04;6327", vigente:true, titulo:"Lei nº 6.327 de 04/05/1976", urn:"urn:lex:br:federal:lei:1976-05-04;6327", ementa:"Autoriza o Instituto Nacional de Colonização e Reforma Agrária - INCRA - a   doar os imóveis que menciona.", arquivo:"federal/leis-ordinarias/1976/lei-6327-1976-05-04.md"}}, {id:"federal:BR:L:6376/1976", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1976, data:"1976-11-30", numero:"6376", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1976-11-30;6376", vigente:true, titulo:"Lei nº 6.376 de 30/11/1976", urn:"urn:lex:br:federal:lei:1976-11-30;6376", ementa:"Autoriza o Poder Executivo a abrir à Justiça Federal de 1ª Instância o   crédito especial de Cr$ 1.200.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/1976/lei-6376-1976-11-30.md"}}, {id:"federal:BR:L:6380/1976", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1976, data:"1976-12-07", numero:"6380", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1976-12-07;6380", vigente:true, titulo:"Lei nº 6.380 de 07/12/1976", urn:"urn:lex:br:federal:lei:1976-12-07;6380", ementa:"Autoriza o Poder Executivo a abrir ao Ministério da Fazenda, em favor do   Fundo Especial de Desenvolvimento e Aperfeiçoamento das Atividades de   Fiscalização - FUNDAF - o crédito especial até o limite de Cr$ 120.000.000,00,   para o fim que especifica.", arquivo:"federal/leis-ordinarias/1976/lei-6380-1976-12-07.md"}}, {id:"federal:BR:L:6331/1976", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1976, data:"1976-05-18", numero:"6331", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1976-05-18;6331", vigente:true, titulo:"Lei nº 6.331 de 18/05/1976", urn:"urn:lex:br:federal:lei:1976-05-18;6331", ementa:"Dispõe sobre a opção de transferência, para o quadro de pessoal do Banco   Central do Brasil, de funcioários requisitados, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1976/lei-6331-1976-05-18.md"}}, {id:"federal:BR:L:6342/1976", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1976, data:"1976-07-05", numero:"6342", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1976-07-05;6342", vigente:true, titulo:"Lei nº 6.342 de 05/07/1976", urn:"urn:lex:br:federal:lei:1976-07-05;6342", ementa:"Altera disposições da Lei nº 6.082, de 10 de julho de 1974, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1976/lei-6342-1976-07-05.md"}}, {id:"federal:BR:L:314/1895", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1895, data:"1895-10-30", numero:"314", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1895-10-30;314", vigente:true, titulo:"Lei nº 314 de 30/10/1895", urn:"urn:lex:br:federal:lei:1895-10-30;314", ementa:"Reorganisa o ensino das Faculdades de   Direito.", arquivo:"federal/leis-ordinarias/1895/lei-314-1895-10-30.md"}}, {id:"federal:BR:L:350/1895", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1895, data:"1895-12-09", numero:"350", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1895-12-09;350", vigente:true, titulo:"Lei nº 350 de 09/12/1895", urn:"urn:lex:br:federal:lei:1895-12-09;350", ementa:"Autorisa o Governo a graduar no primeiro posto do   Exercito todas as praças commissionadas neste posto até 3 de novembro de   1894.", arquivo:"federal/leis-ordinarias/1895/lei-350-1895-12-09.md"}}, {id:"federal:BR:L:352/1895", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1895, data:"1895-12-12", numero:"352", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1895-12-12;352", vigente:true, titulo:"Lei nº 352 de 12/12/1895", urn:"urn:lex:br:federal:lei:1895-12-12;352", ementa:"Autorisa o Poder Executivo a auxiliar, por emprestimo, a   Municipalidade do Districto Federal com a quantia de 3.700:000$000.", arquivo:"federal/leis-ordinarias/1895/lei-352-1895-12-12.md"}}, {id:"federal:BR:L:288/1895", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1895, data:"1895-08-06", numero:"288", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1895-08-06;288", vigente:true, titulo:"Lei nº 288 de 06/08/1895", urn:"urn:lex:br:federal:lei:1895-08-06;288", ementa:"Determina que o montepio das officiaes da Armada e classes annexas, a que se refere a resolução de 23 de setembro de 1795, seja regulado pelo mesmo decreto que trata do montepio dos officiaes do Exercito.", arquivo:"federal/leis-ordinarias/1895/lei-288-1895-08-06.md"}}, {id:"federal:BR:L:347/1895", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1895, data:"1895-12-07", numero:"347", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1895-12-07;347", vigente:true, titulo:"Lei nº 347 de 07/12/1895", urn:"urn:lex:br:federal:lei:1895-12-07;347", ementa:"Regula o processo de apuração na eleição para os cargos   de Presidente e Vice-Presidente da Republica.", arquivo:"federal/leis-ordinarias/1895/lei-347-1895-12-07.md"}}, {id:"federal:BR:L:284/1895", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1895, data:"1895-07-30", numero:"284", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1895-07-30;284", vigente:true, titulo:"Lei nº 284 de 30/07/1895", urn:"urn:lex:br:federal:lei:1895-07-30;284", ementa:"Fixa as Forças de terra para o exercicio de 1896.", arquivo:"federal/leis-ordinarias/1895/lei-284-1895-07-30.md"}}, {id:"federal:BR:L:285/1895", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1895, data:"1895-08-01", numero:"285", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1895-08-01;285", vigente:true, titulo:"Lei nº 285 de 01/08/1895", urn:"urn:lex:br:federal:lei:1895-08-01;285", ementa:"Fixa a Força naval para o exercicio de 1896.", arquivo:"federal/leis-ordinarias/1895/lei-285-1895-08-01.md"}}, {id:"federal:BR:L:282/1895", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1895, data:"1895-07-29", numero:"282", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1895-07-29;282", vigente:true, titulo:"Lei nº 282 de 29/07/1895", urn:"urn:lex:br:federal:lei:1895-07-29;282", ementa:"Regula o modo de provar o fallecimento de qualquer   official de terra ou mar para habilitação ao meio soldo e montepio.", arquivo:"federal/leis-ordinarias/1895/lei-282-1895-07-29.md"}}, {id:"federal:BR:L:342/1895", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1895, data:"1895-12-02", numero:"342", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1895-12-02;342", vigente:true, titulo:"Lei nº 342 de 02/12/1895", urn:"urn:lex:br:federal:lei:1895-12-02;342", ementa:"Reduz a tres mezes o prazo estabelecido no paragrapho   unico do art. 30 da lei n. 35 de 26 da janeiro de 1892, para duração das   incompatibilidades definidas no referido artigo; e revoga a lei n. 28 de 8 do   mesmo mez e anno.", arquivo:"federal/leis-ordinarias/1895/lei-342-1895-12-02.md"}}, {id:"federal:BR:L:322/1895", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1895, data:"1895-11-08", numero:"322", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1895-11-08;322", vigente:true, titulo:"Lei nº 322 de 08/11/1895", urn:"urn:lex:br:federal:lei:1895-11-08;322", ementa:"Dá nova organisação ao Corpo Diplomatico e crea diversos Consulados.", arquivo:"federal/leis-ordinarias/1895/lei-322-1895-11-08.md"}}, {id:"federal:BR:L:304/1895", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1895, data:"1895-10-10", numero:"304", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1895-10-10;304", vigente:true, titulo:"Lei nº 304 de 10/10/1895", urn:"urn:lex:br:federal:lei:1895-10-10;304", ementa:"Augmenta os vencimentos dos officiaes inferiores dos corpos e   brigadas de marinha e equiparados.", arquivo:"federal/leis-ordinarias/1895/lei-304-1895-10-10.md"}}, {id:"federal:BR:L:360/1895", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1895, data:"1895-12-30", numero:"360", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1895-12-30;360", vigente:true, titulo:"Lei nº 360 de 30/12/1895", urn:"urn:lex:br:federal:lei:1895-12-30;360", ementa:"Fixa a despeza geral da Republica dos Estados Unidos do   Brazil para o exercicio de 1896 e dá outras providencias.", arquivo:"federal/leis-ordinarias/1895/lei-360-1895-12-30.md"}}, {id:"federal:BR:L:359/1895", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1895, data:"1895-12-30", numero:"359", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1895-12-30;359", vigente:true, titulo:"Lei nº 359 de 30/12/1895", urn:"urn:lex:br:federal:lei:1895-12-30;359", ementa:"Orça a receita geral da Republica dos Estados Unidos do Brazil para o exercicio de 1896 e dá outras providencias.", arquivo:"federal/leis-ordinarias/1895/lei-359-1895-12-30.md"}}, {id:"federal:BR:L:1041/1859", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1859, data:"1859-09-14", numero:"1041", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1859-09-14;1041", vigente:true, titulo:"Lei nº 1.041 de 14/09/1859", urn:"urn:lex:br:federal:lei:1859-09-14;1041", ementa:"MANDA VIGORAR NO EXERCICIO DE 1860-1861, A LEI DO ORÇAMENTO DE 1859-1860, E AUTORIZA O GOVERNO PARA ALTERAR O CONTRATO COM A COMPANHIA BRASILEIRA DE PAQUETES A VAPOR.", arquivo:"federal/leis-ordinarias/1859/lei-1041-1859-09-14.md"}}, {id:"federal:BR:L:1042/1859", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1859, data:"1859-09-14", numero:"1042", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1859-09-14;1042", vigente:true, titulo:"Lei nº 1.042 de 14/09/1859", urn:"urn:lex:br:federal:lei:1859-09-14;1042", ementa:"FIXA AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1860 A 1861.", arquivo:"federal/leis-ordinarias/1859/lei-1042-1859-09-14.md"}}, {id:"federal:BR:L:1043/1859", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1859, data:"1859-09-15", numero:"1043", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1859-09-15;1043", vigente:true, titulo:"Lei nº 1.043 de 15/09/1859", urn:"urn:lex:br:federal:lei:1859-09-15;1043", ementa:"FIXA A FORÇA NAVAL, PARA O ANO FINANCEIRO DE 1860 A 1861.", arquivo:"federal/leis-ordinarias/1859/lei-1043-1859-09-15.md"}}, {id:"federal:BR:L:1040/1859", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1859, data:"1859-09-14", numero:"1040", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1859-09-14;1040", vigente:true, titulo:"Lei nº 1.040 de 14/09/1859", urn:"urn:lex:br:federal:lei:1859-09-14;1040", ementa:"FIXANDO A DESPESA E ORÇANDO A RECEITA PARA O EXERCICIO DE 1859-1860.", arquivo:"federal/leis-ordinarias/1859/lei-1040-1859-09-14.md"}}, {id:"federal:BR:L:12998/2014", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-06-18", numero:"12998", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-06-18;12998", vigente:true, titulo:"Lei nº 12.998 de 18/06/2014", urn:"urn:lex:br:federal:lei:2014-06-18;12998", ementa:"Dispõe sobre remuneração das Carreiras e dos Planos Especiais de Cargos das Agências Reguladoras, das Carreiras e do Plano Especial de Cargos do Departamento Nacional de Infraestrutura de Transportes - DNIT, das Carreiras e do Plano Especial de Cargos do Departamento Nacional de Produção Mineral - DNPM, da Carreira de Perito Federal Agrário, das Carreiras do Hospital das Forças Armadas, da Fundação Nacional do Índio - FUNAI, dos empregados de que trata a Lei nº 8.878, de 11 de maio de 1994; auto", arquivo:"federal/leis-ordinarias/2014/lei-12998-2014-06-18.md"}}, {id:"federal:BR:L:12954/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-02-05", numero:"12954", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-02-05;12954", vigente:true, titulo:"Lei nº 12.954 de 05/02/2014", urn:"urn:lex:br:federal:lei:2014-02-05;12954", ementa:"Cria o Centro de Tecnologias Estratégicas do Nordeste, o Instituto Nacional de Pesquisa do Pantanal e o Instituto Nacional de Águas; altera a estrutura básica do Ministério da Ciência, Tecnologia e Inovação; cria cargos em comissão do Grupo-Direção e Assessoramento Superiores - DAS; altera a Lei nº 10.683, de 28 de maio de 2003; revoga dispositivo da Lei nº 11.906, de 20 de janeiro de 2009; e dá outras providências.", arquivo:"federal/leis-ordinarias/2014/lei-12954-2014-02-05.md"}}, {id:"federal:BR:L:13047/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-12-02", numero:"13047", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-12-02;13047", vigente:true, titulo:"Lei nº 13.047 de 02/12/2014", urn:"urn:lex:br:federal:lei:2014-12-02;13047", ementa:"Altera as Leis nºs 9.266, de 15 de março de 1996, que reorganiza as classes da Carreira Policial Federal, fixa a remuneração dos cargos que as integram e dá outras providências, e 9.264, de 7 de fevereiro de 1996.", arquivo:"federal/leis-ordinarias/2014/lei-13047-2014-12-02.md"}}, {id:"federal:BR:L:13064/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-12-30", numero:"13064", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-12-30;13064", vigente:true, titulo:"Lei nº 13.064 de 30/12/2014", urn:"urn:lex:br:federal:lei:2014-12-30;13064", ementa:"Altera a nomenclatura do cargo de Agente Penitenciário da Carreira de Polícia Civil do Distrito Federal, de que trata a Lei nº 9.264, de 7 de fevereiro de 1996, para Agente Policial de Custódia.", arquivo:"federal/leis-ordinarias/2014/lei-13064-2014-12-30.md"}}, {id:"federal:BR:L:13041/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-10-28", numero:"13041", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-10-28;13041", vigente:true, titulo:"Lei nº 13.041 de 28/10/2014", urn:"urn:lex:br:federal:lei:2014-10-28;13041", ementa:"Denomina \"Ney Junqueira\", \"Dr. José Humberto Rodrigues da Cunha\", \"Professor Mário Palmério\", \"Alexandre Jorge\", \"Major Geraldo da Silva Vieira\", \"Adauto Pereira de Almeida\" e \"Romes Daher\" os viadutos que especifica, situados no perímetro urbano da cidade de Uberaba, no Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/2014/lei-13041-2014-10-28.md"}}, {id:"federal:BR:L:13011/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-07-16", numero:"13011", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-07-16;13011", vigente:true, titulo:"Lei nº 13.011 de 16/07/2014", urn:"urn:lex:br:federal:lei:2014-07-16;13011", ementa:"Autoriza o Banco Central do Brasil a alienar à Companhia de Desenvolvimento Urbano da Região do Porto do Rio de Janeiro S.A. - CDURP os imóveis que especifica.", arquivo:"federal/leis-ordinarias/2014/lei-13011-2014-07-16.md"}}, {id:"federal:BR:L:13020/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-08-06", numero:"13020", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-08-06;13020", vigente:true, titulo:"Lei nº 13.020 de 06/08/2014", urn:"urn:lex:br:federal:lei:2014-08-06;13020", ementa:"Cria, em caráter temporário, as Funções Comissionadas de Grandes Eventos - FCGE e extingue Funções Comissionadas Técnicas - FCT.", arquivo:"federal/leis-ordinarias/2014/lei-13020-2014-08-06.md"}}, {id:"federal:BR:L:13004/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-06-24", numero:"13004", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-06-24;13004", vigente:true, titulo:"Lei nº 13.004 de 24/06/2014", urn:"urn:lex:br:federal:lei:2014-06-24;13004", ementa:"Altera os arts. 1º, 4º e 5º da Lei nº 7.347, de 24 de julho de 1985, para incluir, entre as finalidades da ação civil pública, a proteção do patrimônio público e social.", arquivo:"federal/leis-ordinarias/2014/lei-13004-2014-06-24.md"}}, {id:"federal:BR:L:12967/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-05-06", numero:"12967", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-05-06;12967", vigente:true, titulo:"Lei nº 12.967 de 06/05/2014", urn:"urn:lex:br:federal:lei:2014-05-06;12967", ementa:"Institui o Dia Nacional do Administrador.", arquivo:"federal/leis-ordinarias/2014/lei-12967-2014-05-06.md"}}, {id:"federal:BR:L:12981/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-05-28", numero:"12981", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-05-28;12981", vigente:true, titulo:"Lei nº 12.981 de 28/05/2014", urn:"urn:lex:br:federal:lei:2014-05-28;12981", ementa:"Dispõe sobre a oficialização no território nacional do Hino à Negritude.", arquivo:"federal/leis-ordinarias/2014/lei-12981-2014-05-28.md"}}, {id:"federal:BR:L:13054/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-12-22", numero:"13054", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-12-22;13054", vigente:true, titulo:"Lei nº 13.054 de 22/12/2014", urn:"urn:lex:br:federal:lei:2014-12-22;13054", ementa:"Institui o dia 6 de agosto como Dia Nacional dos Profissionais da Educação.", arquivo:"federal/leis-ordinarias/2014/lei-13054-2014-12-22.md"}}, {id:"federal:BR:L:13015/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-07-21", numero:"13015", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-07-21;13015", vigente:true, titulo:"Lei nº 13.015 de 21/07/2014", urn:"urn:lex:br:federal:lei:2014-07-21;13015", ementa:"Altera a Consolidação das Leis do Trabalho (CLT), aprovada pelo Decreto-Lei nº 5.452, de 1º de maio de 1943, para dispor sobre o processamento de recursos no âmbito da Justiça do Trabalho.", arquivo:"federal/leis-ordinarias/2014/lei-13015-2014-07-21.md"}}, {id:"federal:BR:L:12991/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-06-17", numero:"12991", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-06-17;12991", vigente:true, titulo:"Lei nº 12.991 de 17/06/2014", urn:"urn:lex:br:federal:lei:2014-06-17;12991", ementa:"Dispõe sobre a criação de cargos de provimento efetivo e em comissão e de funções comissionadas destinados ao Quadro de Pessoal do Superior Tribunal de Justiça e dá outras providências.", arquivo:"federal/leis-ordinarias/2014/lei-12991-2014-06-17.md"}}, {id:"federal:BR:L:13073/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-12-30", numero:"13073", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-12-30;13073", vigente:true, titulo:"Lei nº 13.073 de 30/12/2014", urn:"urn:lex:br:federal:lei:2014-12-30;13073", ementa:"Abre ao Orçamento Fiscal da União, em favor das Justiças Federal, Eleitoral e do Trabalho, crédito especial no valor de R$ 14.641.923,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2014/lei-13073-2014-12-30.md"}}, {id:"federal:BR:L:12988/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-06-02", numero:"12988", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-06-02;12988", vigente:true, titulo:"Lei nº 12.988 de 02/06/2014", urn:"urn:lex:br:federal:lei:2014-06-02;12988", ementa:"Inscreve o nome de Joaquim Aurélio Barreto Nabuco de Araújo no Livro dos Heróis da Pátria.", arquivo:"federal/leis-ordinarias/2014/lei-12988-2014-06-02.md"}}, {id:"federal:BR:L:13050/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-12-08", numero:"13050", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-12-08;13050", vigente:true, titulo:"Lei nº 13.050 de 08/12/2014", urn:"urn:lex:br:federal:lei:2014-12-08;13050", ementa:"Institui o dia 25 de outubro como Dia Nacional do Macarrão.", arquivo:"federal/leis-ordinarias/2014/lei-13050-2014-12-08.md"}}, {id:"federal:BR:L:12970/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-05-08", numero:"12970", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-05-08;12970", vigente:true, titulo:"Lei nº 12.970 de 08/05/2014", urn:"urn:lex:br:federal:lei:2014-05-08;12970", ementa:"Altera o Capítulo VI do Título III e o art. 302 e revoga os arts. 89, 91 e 92 da Lei nº 7.565, de 19 de dezembro de 1986 - Código Brasileiro de Aeronáutica, para dispor sobre as investigações do Sistema de Investigação e Prevenção de Acidentes Aeronáuticos - SIPAER e o acesso aos destroços de aeronave; e dá outras providências.", arquivo:"federal/leis-ordinarias/2014/lei-12970-2014-05-08.md"}}, {id:"federal:BR:L:12965/2014", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-04-23", numero:"12965", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-04-23;12965", vigente:true, titulo:"Lei nº 12.965 de 23/04/2014", urn:"urn:lex:br:federal:lei:2014-04-23;12965", ementa:"Estabelece princípios, garantias, direitos e deveres para o uso da Internet no Brasil.", arquivo:"federal/leis-ordinarias/2014/lei-12965-2014-04-23.md"}}, {id:"federal:BR:L:12984/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-06-02", numero:"12984", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-06-02;12984", vigente:true, titulo:"Lei nº 12.984 de 02/06/2014", urn:"urn:lex:br:federal:lei:2014-06-02;12984", ementa:"Define o crime de discriminação dos portadores do vírus da imunodeficiência humana (HIV) e doentes de aids.", arquivo:"federal/leis-ordinarias/2014/lei-12984-2014-06-02.md"}}, {id:"federal:BR:L:12962/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-04-08", numero:"12962", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-04-08;12962", vigente:true, titulo:"Lei nº 12.962 de 08/04/2014", urn:"urn:lex:br:federal:lei:2014-04-08;12962", ementa:"Altera a Lei nº 8.069, de 13 de julho de 1990 - Estatuto da Criança e do Adolescente, para assegurar a convivência da criança e do adolescente com os pais privados de liberdade.", arquivo:"federal/leis-ordinarias/2014/lei-12962-2014-04-08.md"}}, {id:"federal:BR:L:13018/2014", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-07-22", numero:"13018", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-07-22;13018", vigente:true, titulo:"Lei nº 13.018 de 22/07/2014", urn:"urn:lex:br:federal:lei:2014-07-22;13018", ementa:"Institui a Política Nacional de Cultura Viva e dá outras providências.", arquivo:"federal/leis-ordinarias/2014/lei-13018-2014-07-22.md"}}, {id:"federal:BR:L:13032/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-09-24", numero:"13032", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-09-24;13032", vigente:true, titulo:"Lei nº 13.032 de 24/09/2014", urn:"urn:lex:br:federal:lei:2014-09-24;13032", ementa:"Dispõe sobre a criação do quadro de pessoal, dos cargos efetivos, dos cargos em comissão e das funções de confiança da Escola Superior do Ministério Público da União, e dá outras providências.", arquivo:"federal/leis-ordinarias/2014/lei-13032-2014-09-24.md"}}, {id:"federal:BR:L:13068/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-12-30", numero:"13068", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-12-30;13068", vigente:true, titulo:"Lei nº 13.068 de 30/12/2014", urn:"urn:lex:br:federal:lei:2014-12-30;13068", ementa:"Abre ao Orçamento Fiscal da União, em favor da Secretaria de Portos da Presidência da República, crédito suplementar no valor de R$ 333.250.000,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2014/lei-13068-2014-12-30.md"}}, {id:"federal:BR:L:13026/2014", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-09-03", numero:"13026", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-09-03;13026", vigente:true, titulo:"Lei nº 13.026 de 03/09/2014", urn:"urn:lex:br:federal:lei:2014-09-03;13026", ementa:"Altera as Leis nºs 10.410, de 11 de janeiro de 2002, que cria e disciplina a Carreira de Especialista em Meio Ambiente, e 11.357, de 19 de outubro de 2006, na parte em que dispõe sobre o Plano Especial de Cargos do Ministério do Meio Ambiente e do Instituto Brasileiro do Meio Ambiente - IBAMA; cria o Quadro em Extinção de Combate às Endemias; e autoriza a transformação dos empregos criados pelo art. 15 da Lei nº 11.350, de 5 de outubro de 2006, no cargo de Agente de Combate às Endemias.", arquivo:"federal/leis-ordinarias/2014/lei-13026-2014-09-03.md"}}, {id:"federal:BR:L:13036/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-10-28", numero:"13036", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-10-28;13036", vigente:true, titulo:"Lei nº 13.036 de 28/10/2014", urn:"urn:lex:br:federal:lei:2014-10-28;13036", ementa:"Dá a denominação de \"Rodovia Luiz Henrique Rezende Novaes\" à BR-465/RJ, no Estado do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/2014/lei-13036-2014-10-28.md"}}, {id:"federal:BR:L:13044/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-11-19", numero:"13044", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-11-19;13044", vigente:true, titulo:"Lei nº 13.044 de 19/11/2014", urn:"urn:lex:br:federal:lei:2014-11-19;13044", ementa:"Confere ao Município de Itabaiana no Estado de Sergipe o título de Capital Nacional do Caminhão.", arquivo:"federal/leis-ordinarias/2014/lei-13044-2014-11-19.md"}}, {id:"federal:BR:L:13058/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-12-22", numero:"13058", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-12-22;13058", vigente:true, titulo:"Lei nº 13.058 de 22/12/2014", urn:"urn:lex:br:federal:lei:2014-12-22;13058", ementa:"Altera os arts. 1.583, 1.584, 1.585 e 1.634 da Lei nº 10.406, de 10 de janeiro de 2002 (Código Civil), para estabelecer o significado da expressão \"guarda compartilhada\" e dispor sobre sua aplicação.", arquivo:"federal/leis-ordinarias/2014/lei-13058-2014-12-22.md"}}, {id:"federal:BR:L:13077/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-12-30", numero:"13077", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-12-30;13077", vigente:true, titulo:"Lei nº 13.077 de 30/12/2014", urn:"urn:lex:br:federal:lei:2014-12-30;13077", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério da Agricultura, Pecuária e Abastecimento, crédito suplementar no valor de R$ 310.186.453,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2014/lei-13077-2014-12-30.md"}}, {id:"federal:BR:L:12976/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-05-19", numero:"12976", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-05-19;12976", vigente:true, titulo:"Lei nº 12.976 de 19/05/2014", urn:"urn:lex:br:federal:lei:2014-05-19;12976", ementa:"Altera o § 3º do art. 59 da Lei nº 9.504, de 30 de setembro de 1997, para estabelecer a ordem dos painéis na urna eletrônica.", arquivo:"federal/leis-ordinarias/2014/lei-12976-2014-05-19.md"}}, {id:"federal:BR:L:13022/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-08-08", numero:"13022", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-08-08;13022", vigente:true, titulo:"Lei nº 13.022 de 08/08/2014", urn:"urn:lex:br:federal:lei:2014-08-08;13022", ementa:"Dispõe sobre o Estatuto Geral das Guardas Municipais.", arquivo:"federal/leis-ordinarias/2014/lei-13022-2014-08-08.md"}}, {id:"federal:BR:L:13006/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2014, data:"2014-06-26", numero:"13006", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2014-06-26;13006", vigente:true, titulo:"Lei nº 13.006 de 26/06/2014", urn:"urn:lex:br:federal:lei:2014-06-26;13006", ementa:"Acrescenta § 8º ao art. 26 da Lei nº 9.394, de 20 de dezembro de 1996, que estabelece as diretrizes e bases da educação nacional, para o