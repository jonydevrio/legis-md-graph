br/?urn=urn:lex:br:federal:lei:1950-12-28;1299", vigente:true, titulo:"Lei nº 1.299 de 28/12/1950", urn:"urn:lex:br:federal:lei:1950-12-28;1299", ementa:"Concede pensão a Eunice Cardoso da Silveira e Mariana Cardoso Campos,   irmãs do ex-Deputado Maurício Graccho Cardoso.", arquivo:"federal/leis-ordinarias/1950/lei-1299-1950-12-28.md"}}, {id:"federal:BR:L:1246/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-11-30", numero:"1246", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-11-30;1246", vigente:true, titulo:"Lei nº 1.246 de 30/11/1950", urn:"urn:lex:br:federal:lei:1950-11-30;1246", ementa:"Reestrutura o Quadro de Oficiais do Serviço de Intendência do Exército, e   da outras providências.", arquivo:"federal/leis-ordinarias/1950/lei-1246-1950-11-30.md"}}, {id:"federal:BR:L:1263/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-12-06", numero:"1263", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-12-06;1263", vigente:true, titulo:"Lei nº 1.263 de 06/12/1950", urn:"urn:lex:br:federal:lei:1950-12-06;1263", ementa:"Autoriza abertura, pelo Ministério da Viação e Obras Públicas, de crédito   especial para a construção do trecho da linha férrea   Blumenau-Itajaí.", arquivo:"federal/leis-ordinarias/1950/lei-1263-1950-12-06.md"}}, {id:"federal:BR:L:1274/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-12-13", numero:"1274", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-12-13;1274", vigente:true, titulo:"Lei nº 1.274 de 13/12/1950", urn:"urn:lex:br:federal:lei:1950-12-13;1274", ementa:"Dispõe sobre a inclusão no Quadro Permanente dos Marítimos diaristas do   Ministério da Marinha.", arquivo:"federal/leis-ordinarias/1950/lei-1274-1950-12-13.md"}}, {id:"federal:BR:L:1153/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-07-04", numero:"1153", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-07-04;1153", vigente:true, titulo:"Lei nº 1.153 de 04/07/1950", urn:"urn:lex:br:federal:lei:1950-07-04;1153", ementa:"Estende a alunos do Curso Normal de Educação Física regalias conferidas aos licenciados em Educação Física, de que trata o Decreto-Lei n° 1.212, de 17 de abril de 1939.", arquivo:"federal/leis-ordinarias/1950/lei-1153-1950-07-04.md"}}, {id:"federal:BR:L:1094/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-04-30", numero:"1094", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-04-30;1094", vigente:true, titulo:"Lei nº 1.094 de 30/04/1950", urn:"urn:lex:br:federal:lei:1950-04-30;1094", ementa:"Concede auxílio à Federação das Sociedades de Assistência aos Lázaros e Defesa Contra a Lepra.", arquivo:"federal/leis-ordinarias/1950/lei-1094-1950-04-30.md"}}, {id:"federal:BR:L:1124/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-06-07", numero:"1124", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-06-07;1124", vigente:true, titulo:"Lei nº 1.124 de 07/06/1950", urn:"urn:lex:br:federal:lei:1950-06-07;1124", ementa:"Concede isenção de direitos de importação e taxas aduaneiras, inclusive impôsto de consumo, para máquinas, adquiridas pelo Laboratório Plasma S. A., de Belo Horizonte.", arquivo:"federal/leis-ordinarias/1950/lei-1124-1950-06-07.md"}}, {id:"federal:BR:L:1237/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-11-15", numero:"1237", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-11-15;1237", vigente:true, titulo:"Lei nº 1.237 de 15/11/1950", urn:"urn:lex:br:federal:lei:1950-11-15;1237", ementa:"Autoriza a abertura, pelo Ministério da Educação e Saúde, dos créditos   especiais de Cr$ 5.000.000,00 e Cr$ 1.500.000,00 para os fins que   especifica.", arquivo:"federal/leis-ordinarias/1950/lei-1237-1950-11-15.md"}}, {id:"federal:BR:L:1135/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-06-14", numero:"1135", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-06-14;1135", vigente:true, titulo:"Lei nº 1.135 de 14/06/1950", urn:"urn:lex:br:federal:lei:1950-06-14;1135", ementa:"Autoriza o Poder Executivo a contratar com o Banco do Brasil S.A. ou dar garantia do Tesouro Federal às operações de crédito que se venham a realizar entre o referido Banco e as entidades de serviço público, consumidoras de carvão nacional.", arquivo:"federal/leis-ordinarias/1950/lei-1135-1950-06-14.md"}}, {id:"federal:BR:L:1074/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-03-24", numero:"1074", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-03-24;1074", titulo:"Lei nº 1.074 de 24/03/1950", vigente:true, urn:"urn:lex:br:federal:lei:1950-03-24;1074", ementa:"Cria a Ordem do Mérito Médico.", arquivo:"federal/leis-ordinarias/1950/lei-1074-1950-03-24.md"}}, {id:"federal:BR:L:1216/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-10-28", numero:"1216", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-10-28;1216", vigente:true, titulo:"Lei nº 1.216 de 28/10/1950", urn:"urn:lex:br:federal:lei:1950-10-28;1216", ementa:"Dispõe sôbre a organização da Casa da Moeda, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1950/lei-1216-1950-10-28.md"}}, {id:"federal:BR:L:1076/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-03-31", numero:"1076", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-03-31;1076", vigente:true, titulo:"Lei nº 1.076 de 31/03/1950", urn:"urn:lex:br:federal:lei:1950-03-31;1076", ementa:"Assegura aos estudantes que concluírem curso de primeiro ciclo do ensino comercial, industrial ou agrícola, o direito à matrícula nos cursos clássico e científico e dá outras providências.", arquivo:"federal/leis-ordinarias/1950/lei-1076-1950-03-31.md"}}, {id:"federal:BR:L:1256/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-12-04", numero:"1256", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-12-04;1256-a", vigente:true, titulo:"Lei nº 1.256-A de 04/12/1950", urn:"urn:lex:br:federal:lei:1950-12-04;1256-a", ementa:"Uniformiza o tipo das estampilhas do impôsto do sêlo e do papel   selado.", arquivo:"federal/leis-ordinarias/1950/lei-1256-a-1950-12-04.md"}}, {id:"federal:BR:L:1072/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-03-17", numero:"1072", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-03-17;1072", vigente:true, titulo:"Lei nº 1.072 de 17/03/1950", urn:"urn:lex:br:federal:lei:1950-03-17;1072", ementa:"Altera a redação do Decreto-lei nº 8.393, de 17 de dezembro de 1945 e do Estatuto da Universidade do Brasil, aprovado pelo Decreto nº 21.321, de 18 de junho de 1946.", arquivo:"federal/leis-ordinarias/1950/lei-1072-1950-03-17.md"}}, {id:"federal:BR:L:1193/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-09-06", numero:"1193", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-09-06;1193", vigente:true, titulo:"Lei nº 1.193 de 06/09/1950", urn:"urn:lex:br:feder