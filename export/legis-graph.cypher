0;6653", vigente:true, titulo:"Lei nº 6.653 de 30/05/1979", urn:"urn:lex:br:federal:lei:1979-05-30;6653", ementa:"Cria a Auditoria da 12ª Circunscrição Judiciária Militar e dá outras   providências.", arquivo:"federal/leis-ordinarias/1979/lei-6653-1979-05-30.md"}}, {id:"federal:BR:L:6661/1979", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-06-21", numero:"6661", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-06-21;6661", vigente:true, titulo:"Lei nº 6.661 de 21/06/1979", urn:"urn:lex:br:federal:lei:1979-06-21;6661", ementa:"Cria o Fundo Especial de Formação de Pessoal - FUNFORPE.", arquivo:"federal/leis-ordinarias/1979/lei-6661-1979-06-21.md"}}, {id:"federal:BR:L:6689/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-09-24", numero:"6689", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-09-24;6689", vigente:true, titulo:"Lei nº 6.689 de 24/09/1979", urn:"urn:lex:br:federal:lei:1979-09-24;6689", ementa:"Autoriza o Departamento Nacional de Obras Contra as Secas - DNOCS,   Autarquia vinculada ao Ministério do Interior, a doar o imóvel que menciona,   situado no Município de Sobral, Estado do Ceará.", arquivo:"federal/leis-ordinarias/1979/lei-6689-1979-09-24.md"}}, {id:"federal:BR:L:6693/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-10-03", numero:"6693", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-10-03;6693", vigente:true, titulo:"Lei nº 6.693 de 03/10/1979", urn:"urn:lex:br:federal:lei:1979-10-03;6693", ementa:"Dispõe sobre a constituição, no Território Federal de Roraima, da   Companhia de Desenvolvimento de Roraima - CODESAIMA e dá outras providências.", arquivo:"federal/leis-ordinarias/1979/lei-6693-1979-10-03.md"}}, {id:"federal:BR:L:6747/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-12-10", numero:"6747", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-12-10;6747", vigente:true, titulo:"Lei nº 6.747 de 10/12/1979", urn:"urn:lex:br:federal:lei:1979-12-10;6747", ementa:"Dá nova redação ao artigo 44 do Decreto-Lei n. 82, de 26 de ;dezembro de 1966.", arquivo:"federal/leis-ordinarias/1979/lei-6747-1979-12-10.md"}}, {id:"federal:BR:L:6696/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-10-08", numero:"6696", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-10-08;6696", vigente:true, titulo:"Lei nº 6.696 de 08/10/1979", urn:"urn:lex:br:federal:lei:1979-10-08;6696", ementa:"Equipara, no tocante a previdência social urbana, os ministros de confissão religiosa e os membros de institutos de vida consagrada, congregação ou ordem religiosa aos trabalhadores autônomos, e dá outras providências.", arquivo:"federal/leis-ordinarias/1979/lei-6696-1979-10-08.md"}}, {id:"federal:BR:L:6648/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-05-16", numero:"6648", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-05-16;6648", vigente:true, titulo:"Lei nº 6.648 de 16/05/1979", urn:"urn:lex:br:federal:lei:1979-05-16;6648", ementa:"Introduz alteração no Plano Nacional de Viação, incluindo trecho   rodoviário nos Estados de Santa Catarina e Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1979/lei-6648-1979-05-16.md"}}, {id:"federal:BR:L:6664/1979", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-06-26", numero:"6664", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-06-26;6664", vigente:true, titulo: