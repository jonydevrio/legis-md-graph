07;6605", vigente:true, titulo:"Lei nº 6.605 de 07/12/1978", urn:"urn:lex:br:federal:lei:1978-12-07;6605", ementa:"Autoriza o Governo do Território Federal de Roraima a alienar imóvel sob   sua administração, localizado na Cidade de Belém, Estado do Pará, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1978/lei-6605-1978-12-07.md"}}, {id:"federal:BR:L:6543/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-06-30", numero:"6543", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-06-30;6543", vigente:true, titulo:"Lei nº 6.543 de 30/06/1978", urn:"urn:lex:br:federal:lei:1978-06-30;6543", ementa:"Dispõe sobre a vigência dos efeitos financeiros da inclusão do pessoal   docente do Magistério da Aeronáutica.", arquivo:"federal/leis-ordinarias/1978/lei-6543-1978-06-30.md"}}, {id:"federal:BR:L:6587/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-11-16", numero:"6587", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-11-16;6587", vigente:true, titulo:"Lei nº 6.587 de 16/11/1978", urn:"urn:lex:br:federal:lei:1978-11-16;6587", ementa:"Autoriza o Poder Executivo a abrir crédito suplementar ao Orçamento da   União aprovado pela Lei nº 6.486, de 06 de dezembro de 1977.", arquivo:"federal/leis-ordinarias/1978/lei-6587-1978-11-16.md"}}, {id:"federal:BR:L:6549/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-07-04", numero:"6549", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-07-04;6549", vigente:true, titulo:"Lei nº 6.549 de 04/07/1978", urn:"urn:lex:br:federal:lei:1978-07-04;6549", ementa:"Autoriza o Poder Executivo a abrir ao Ministério da Previdência Social, em   favor da Secretaria de Previdência Complementar, o crédito especial de Cr$   1.800.000,00, para o 