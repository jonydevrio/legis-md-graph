 vigencia_origem:"revogada=false", ano:1901, data:"1901-12-30", numero:"834", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1901-12-30;834", vigente:true, titulo:"Lei nº 834 de 30/12/1901", urn:"urn:lex:br:federal:lei:1901-12-30;834", ementa:"Fixa a despeza geral da Republica dos Estados Unidos do Brazil para o   exercicio de 1902, e dá outras providencias.", arquivo:"federal/leis-ordinarias/1901/lei-834-1901-12-30.md"}}, {id:"federal:BR:L:593/1899", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1899, data:"1899-08-21", numero:"593", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1899-08-21;593", vigente:true, titulo:"Lei nº 593 de 21/08/1899", urn:"urn:lex:br:federal:lei:1899-08-21;593", ementa:"Autoriza a conceder um anno de licença, com o respectivo ordenado, ao telegraphista de 3ª classe da Estrada de Ferro Central do Brazil Procopio Marques de Oliveira Neves, para tratar de sua saude onde lhe convier.", arquivo:"federal/leis-ordinarias/1899/lei-593-1899-08-21.md"}}, {id:"federal:BR:L:652/1899", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1899, data:"1899-11-23", numero:"652", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1899-11-23;652", vigente:true, titulo:"Lei nº 652 de 23/11/1899", urn:"urn:lex:br:federal:lei:1899-11-23;652", ementa:"Fixa a despeza geral da Republica dos Estados Unidos do Brazil para o exercicio de 1900, e dá outras providencias.", arquivo:"federal/leis-ordinarias/1899/lei-652-1899-11-23.md"}}, {id:"federal:BR:L:651/1899", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1899, data:"1899-11-22", numero:"651", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1899-11-22;651", vigente:true, titulo:"Lei nº 651 de 22/11/1899", urn:"urn:lex:br:federal:lei:1899-11-22;651", ementa:"Altera varias disposições da Tarifa das Alfandegas e   Mesas de Rendas", arquivo:"federal/leis-ordinarias/1899/lei-651-1899-11-22.md"}}, {id:"federal:BR:L:641/1899", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1899, data:"1899-11-14", numero:"641", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1899-11-14;641", vigente:true, titulo:"Lei nº 641 de 14/11/1899", urn:"urn:lex:br:federal:lei:1899-11-14;641", ementa:"Estabelece o processo de arrecadação dos impostos de consumo", arquivo:"federal/leis-ordinarias/1899/lei-641-1899-11-14.md"}}, {id:"federal:BR:L:587/1899", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1899, data:"1899-08-05", numero:"587", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1899-08-05;587", vigente:true, titulo:"Lei nº 587 de 05/08/1899", urn:"urn:lex:br:federal:lei:1899-08-05;587", ementa:"Approva o tratado assignado nesta Capital em 6 de outubro de 1898, para o fim de completar o estabelecimento da linha divisoria entre o Brazil e a Republica Argentina.", arquivo:"federal/leis-ordinarias/1899/lei-587-1899-08-05.md"}}, {id:"federal:BR:L:640/1899", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1899, data:"1899-11-14", numero:"640", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1899-11-14;640", vigente:true, titulo:"Lei nº 640 de 14/11/1899", urn:"urn:lex:br:federal:lei:1899-11-14;640", ementa:"Orça a receita geral da Republica dos Estados Unidos do Brazil para o   exercicio de 1900, e dá outras providencias.", arquivo:"federal/leis-ordinarias/1899/lei-640-1899-11-14.md"}}, {id:"federal:BR:L:612/1899", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1899, data:"1899-09-29", numero:"612", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1899-09-29;612", vigente:true, titulo:"Lei nº 612 de 29/09/1899", urn:"urn:lex:br:federal:lei:1899-09-29;612", ementa:"Approva, e amplia ao Exercito nacional, o Codigo Penal para a Armada, que acompanhou o decreto n. 18, de 7 de março de 1891.", arquivo:"federal/leis-ordinarias/1899/lei-612-1899-09-29.md"}}, {id:"federal:BR:L:628/1899", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1899, data:"1899-10-28", numero:"628", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1899-10-28;628", vigente:true, titulo:"Lei nº 628 de 28/10/1899", urn:"urn:lex:br:federal:lei:1899-10-28;628", ementa:"Amplia a acção penal por denuncia do Ministerio Publico, e dá outras providencias.", arquivo:"federal/leis-ordinarias/1899/lei-628-1899-10-28.md"}}, {id:"federal:BR:L:632/1899", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1899, data:"1899-11-06", numero:"632", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1899-11-06;632", vigente:true, titulo:"Lei nº 632 de 06/11/1899", urn:"urn:lex:br:federal:lei:1899-11-06;632", ementa:"Revoga a segunda parte do art. 1º da lei n. 288, de 6 de agosto de 1895, ficando restabelecida a disposição do regulamento annexo ao decreto n. 695, de 28 de agosto de 1890, que manda abonar á viuva do official a pensão integral do montepio, e dá outras providencias", arquivo:"federal/leis-ordinarias/1899/lei-632-1899-11-06.md"}}, {id:"federal:BR:L:606/1899", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1899, data:"1899-09-20", numero:"606", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1899-09-20;606", vigente:true, titulo:"Lei nº 606 de 20/09/1899", urn:"urn:lex:br:federal:lei:1899-09-20;606", ementa:"Fixa as Forças de terra para o exercicio de 1900", arquivo:"federal/leis-ordinarias/1899/lei-606-1899-09-20.md"}}, {id:"federal:BR:L:654/1899", properties:{es