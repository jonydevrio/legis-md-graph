titulo:"Lei nº 2.543 de 14/07/1955", urn:"urn:lex:br:federal:lei:1955-07-14;2543", ementa:"Dispõe sobre a Rede Ferroviária do Nordeste, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1955/lei-2543-1955-07-14.md"}}, {id:"federal:BR:L:2613/1955", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-09-23", numero:"2613", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-09-23;2613", vigente:true, titulo:"Lei nº 2.613 de 23/09/1955", urn:"urn:lex:br:federal:lei:1955-09-23;2613", ementa:"Autoriza a União a criar uma Fundação denominada Serviço Social Rural.", arquivo:"federal/leis-ordinarias/1955/lei-2613-1955-09-23.md"}}, {id:"federal:BR:L:2607/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-09-20", numero:"2607", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-09-20;2607", vigente:true, titulo:"Lei nº 2.607 de 20/09/1955", urn:"urn:lex:br:federal:lei:1955-09-20;2607", ementa:"Concede a pensão especial de Cr$ 2.000,00 mensais a Blanche Alix Marie de   Miranda da Silveira Lobo, viúva do Cônsul Carlos de Miranda da Silveira   Lobo.", arquivo:"federal/leis-ordinarias/1955/lei-2607-1955-09-20.md"}}, {id:"federal:BR:L:2562/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-08-12", numero:"2562", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-08-12;2562", vigente:true, titulo:"Lei nº 2.562 de 12/08/1955", urn:"urn:lex:br:federal:lei:1955-08-12;2562", ementa:"Concede a pensão especial de Cr$ 2.000,00 mensais ao pintor Helios   Aristides Seelinger.", arquivo:"federal/leis-ordinarias/1955/lei-2562-1955-08-12.md"}}, {id:"federal:BR:L:2429/1955", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem