l", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-12-23", numero:"15069", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-12-23;15069", vigente:true, titulo:"Lei nº 15.069 de 23/12/2024", urn:"urn:lex:br:federal:lei:2024-12-23;15069", ementa:"Institui a Política Nacional de Cuidados.", arquivo:"federal/leis-ordinarias/2024/lei-15069-2024-12-23.md"}}, {id:"federal:BR:L:15020/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-11-12", numero:"15020", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-11-12;15020", vigente:true, titulo:"Lei nº 15.020 de 12/11/2024", urn:"urn:lex:br:federal:lei:2024-11-12;15020", ementa:"Inscreve o nome de Darcy Ribeiro no Livro dos Heróis e Heroínas da Pátria.", arquivo:"federal/leis-ordinarias/2024/lei-15020-2024-11-12.md"}}, {id:"federal:BR:L:14950/2024", properties:{esfera:"federal", versao_texto:"texto da fonte oficial", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-08-02", numero:"14950", fonte:"https://www.planalto.gov.br/ccivil_03/_ato2023-2026/2024/lei/l14950.htm", vigente:true, titulo:"Lei nº 14.950 de 02/08/2024", urn:"urn:lex:br:federal:lei:2024-08-02;14950", ementa:"Altera a Lei nº 8.069, de 13 de julho de 1990 (Estatuto da Criança e do Adolescente), para dispor sobre o direito da criança e do adolescente de visitação à mãe ou ao pai internados em instituição de saúde.", arquivo:"federal/leis-ordinarias/2024/lei-14950-2024-08-02.md"}}, {id:"federal:BR:L:14838/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-04-10", numero:"14838", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-04-10;14838", vigente:true, titulo:"Lei nº 14.838 de 10/04/2024", urn:"urn:lex:br:federal:lei:2024-04-10;14838", ementa:"Cria a Rota Turística do Caminho das Missões, no Estado do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/2024/lei-14838-2024-04-10.md"}}, {id:"federal:BR:L:14941/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-07-30", numero:"14941", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-07-30;14941", vigente:true, titulo:"Lei nº 14.941 de 30/07/2024", urn:"urn:lex:br:federal:lei:2024-07-30;14941", ementa:"Cria o Conselho Curador do Fundo de Aperfeiçoamento da Defensoria Pública da União, referido no inciso XXI do caput do art. 4º da Lei Complementar nº 80, de 12 de janeiro de 1994 (Lei Orgânica da Defensoria Pública).", arquivo:"federal/leis-ordinarias/2024/lei-14941-2024-07-30.md"}}, {id:"federal:BR:L:14976/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-09-18", numero:"14976", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-09-18;14976", vigente:true, titulo:"Lei nº 14.976 de 18/09/2024", urn:"urn:lex:br:federal:lei:2024-09-18;14976", ementa:"Altera a Lei nº 13.105, de 16 de março de 2015 (Código de Processo Civil), a fim de dispor sobre a competência dos juizados especiais cíveis para o processamento e o julgamento das causas previstas no inciso II do art. 275 da Lei nº 5.869, de 11 de janeiro de 1973.", arquivo:"federal/leis-ordinarias/2024/lei-14976-2024-09-18.md"}}, {id:"federal:BR:L:15037/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-11-29", numero:"15037", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-11-29;15037", vigente:true, titulo:"Lei nº 15.037 de 29/11/2024", urn:"urn:lex:br:federal:lei:2024-11-29;15037", ementa:"Altera a Lei nº14.606, de 20 de junho de 2023, para especificar que o símbolo da campanha de conscientização sobre a doença de Parkinson será uma tulipa vermelha denominada Dr. James Parkinson, desenvolvida pelo floricultor holandês J.W.S. Van der Wereld.", arquivo:"federal/leis-ordinarias/2024/lei-15037-2024-11-29.md"}}, {id:"federal:BR:L:14792/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-01-05", numero:"14792", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-01-05;14792", vigente:true, titulo:"Lei nº 14.792 de 05/01/2024", urn:"urn:lex:br:federal:lei:2024-01-05;14792", ementa:"Institui o Dia Nacional da Saúde Única.", arquivo:"federal/leis-ordinarias/2024/lei-14792-2024-01-05.md"}}, {id:"federal:BR:L:14987/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-09-25", numero:"14987", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-09-25;14987", vigente:true, titulo:"Lei nº 14.987 de 25/09/2024", urn:"urn:lex:br:federal:lei:2024-09-25;14987", ementa:"Altera a Lei nº 8.069, de 13 de julho de 1990 (Estatuto da Criança e do Adolescente), para estender o direito ao atendimento psicossocial às crianças e aos adolescentes que tiverem qualquer dos pais ou responsáveis vitimado por grave violência ou preso em regime fechado.", arquivo:"federal/leis-ordinarias/2024/lei-14987-2024-09-25.md"}}, {id:"federal:BR:L:14967/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-09-09", numero:"14967", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-09-09;14967", vigente:true, titulo:"Lei nº 14.967 de 09/09/2024", urn:"urn:lex:br:federal:lei:2024-09-09;14967", ementa:"Institui o Estatuto da Segurança Privada e da Segurança das Instituições Financeiras; altera a Lei nº 10.826, de 22 de dezembro de 2003 (Estatuto do Desarmamento), a Lei nº 10.446, de 8 de maio de 2002, a Lei nº 10.637, de 30 de dezembro de 2002, a Lei nº 10.833, de 29 de dezembro de 2003, e o Decreto-Lei nº 2.848, de 7 de dezembro de 1940 (Código Penal); revoga a Lei nº 7.102, de 20 de junho de 1983, a Lei nº 8.863, de 28 de março de 1994, e dispositivos da Lei nº 11.718, de 20 de junho de 2008", arquivo:"federal/leis-ordinarias/2024/lei-14967-2024-09-09.md"}}, {id:"federal:BR:L:14914/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-07-03", numero:"14914", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-07-03;14914", vigente:true, titulo:"Lei nº 14.914 de 03/07/2024", urn:"urn:lex:br:federal:lei:2024-07-03;14914", ementa:"Institui a Política Nacional de Assistência Estudantil (PNAES).", arquivo:"federal/leis-ordinarias/2024/lei-14914-2024-07-03.md"}}, {id:"federal:BR:L:15000/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-10-15", numero:"15000", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-10-15;15000", vigente:true, titulo:"Lei nº 15.000 de 15/10/2024", urn:"urn:lex:br:federal:lei:2024-10-15;15000", ementa:"Declara o educador Anísio Teixeira Patrono da Escola Pública Brasileira.", arquivo:"federal/leis-ordinarias/2024/lei-15000-2024-10-15.md"}}, {id:"federal:BR:L:14831/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2024, data:"2024-03-27", numero:"14831", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2024-03-27;14831", vigente:true, titulo:"Lei nº 14.831 de 27/03/2024", urn:"urn:lex:br:federal:lei:2024-03-27;14831", ementa:"Institui o Certificado Empresa Promotora da Saúde Mental e estabelece os requisitos para a concessão da certificação.", arquivo:"federal/leis-ordinarias/2024/lei-14831-2024-03-27.md"}}, {id:"federal:BR:L:14877/2024", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_or