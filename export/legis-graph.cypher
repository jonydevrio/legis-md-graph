nal", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1970, data:"1970-07-28", numero:"5595", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1970-07-28;5595", vigente:true, titulo:"Lei nº 5.595 de 28/07/1970", urn:"urn:lex:br:federal:lei:1970-07-28;5595", ementa:"Denomina \"Presidente Costa e Silva\" a Ponte Rio-Niterói.", arquivo:"federal/leis-ordinarias/1970/lei-5595-1970-07-28.md"}}, {id:"federal:BR:L:5608/1970", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1970, data:"1970-09-14", numero:"5608", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1970-09-14;5608", vigente:true, titulo:"Lei nº 5.608 de 14/09/1970", urn:"urn:lex:br:federal:lei:1970-09-14;5608", ementa:"Autoriza o Poder Executivo a retificar e ratificar cessão de terreno da União, situado em Porto Alegre, Estado do Rio Grande do Sul, ao Sindicato dos Estivadores e dos Trabalhadores em Estiva de Minérios de Porto Alegre.", arquivo:"federal/leis-ordinarias/1970/lei-5608-1970-09-14.md"}}, {id:"federal:BR:L:5582/1970", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1970, data:"1970-06-16", numero:"5582", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1970-06-16;5582", vigente:true, titulo:"Lei nº 5.582 de 16/06/1970", urn:"urn:lex:br:federal:lei:1970-06-16;5582", ementa:"Altera o artigo 16 do Decreto-Lei nº 3.200, de 19 de abril de 1941, que dispõe sobre a organização e proteção da família.", arquivo:"federal/leis-ordinarias/1970/lei-5582-1970-06-16.md"}}, {id:"federal:BR:L:5586/1970", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1970, data:"1970-06-30", numero:"5586", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1970-06-30;5586", vigente:true, titulo:"Lei nº 5.586 de 30/06/1970", urn:"urn:lex:br:federal:lei:1970-06-30;5586", ementa:"Estedente a Jurisdição da Junta de Conciliação e Julgamento de Londrina às cidades de Ibiporã e Cambé, no Estado do Paraná.", arquivo:"federal/leis-ordinarias/1970/lei-5586-1970-06-30.md"}}, {id:"federal:BR:L:704/1853", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1853, data:"1853-08-29", numero:"704", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1853-08-29;704", vigente:true, titulo:"Lei nº 704 de 29/08/1853", urn:"urn:lex:br:federal:lei:1853-08-29;704", ementa:"ELEVA A COMARCA DE CORITIBA, NA PROVÍNCIA DE SÃO PAULO, A CATEGORIA DE PROVINCIA COM A DENOMINAÇÃO DE - PROVINCIA DO PARANA.", arquivo:"federal/leis-ordinarias/1853/lei-704-1853-08-29.md"}}, {id:"federal:BR:L:719/1853", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1853, data:"1853-09-28", numero:"719", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1853-09-28;719", vigente:true, titulo:"Lei nº 719 de 28/09/1853", urn:"urn:lex:br:federal:lei:1853-09-28;719", ementa:"FIXANDO A DESPESA E ORÇAMENTO A RECEITA PARA O EXERCÍCIO DE 1854-1855.", arquivo:"federal/leis-ordinarias/1853/lei-719-1853-09-28.md"}}, {id:"federal:BR:L:694/1853", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1853, data:"1853-08-10", numero:"694", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1853-08-10;694", vigente:true, titulo:"Lei nº 694 de 10/08/1853", urn:"urn:lex:br:federal:lei:1853-08-10;694", ementa:"FIXA A FORÇA NAVAL PARA O ANO FINANCEIRO DE 1854-1855.", arquivo:"federal/leis-ordinarias/1853/lei-694-1853-08-10.md"}}, {id:"federal:BR:L:723/1853", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1853, data:"1853-09-30", numero:"723", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1853-09-30;723", vigente:true, titulo:"Lei nº 723 de 30/09/1853", urn:"urn:lex:br:federal:lei:1853-09-30;723", ementa:"AUTORISANDO O GOVERNO PARA FORNECER POR EMPRESTIMO A REPUBLICA ORIENTAL DO URUGUAI UM SUBSIDIO QUE NÃO EXCEDA A 60.000 PATACÕES POR MES, NEM DURE MAIS DE UM ANO.", arquivo:"federal/leis-ordinarias/1853/lei-723-1853-09-30.md"}}, {id:"federal:BR:L:715/1853", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1853, data:"1853-09-19", numero:"715", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1853-09-19;715", vigente:true, titulo:"Lei nº 715 de 19/09/1853", urn:"urn:lex:br:federal:lei:1853-09-19;715", ementa:"FIXA AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1854-1855.", arquivo:"federal/leis-ordinarias/1853/lei-715-1853-09-19.md"}}, {id:"federal:BR:L:679/1853", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1853, data:"1853-06-25", numero:"679", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1853-06-25;679", vigente:true, titulo:"Lei nº 679 de 25/06/1853", urn:"urn:lex:br:federal:lei:1853-06-25;679", ementa:"ABRE CREDITOS AO GOVERNO PARA PAGAMENTO DE DÍVIDAS DE EXERCÍCIOS FINDOS.", arquivo:"federal/leis-ordinarias/1853/lei-679-1853-06-25.md"}}, {id:"federal:BR:L:693/1853", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1853, data:"1853-08-10", numero:"693", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1853-08-10;693", vigente:true, titulo:"Lei nº 693 de 10/08/1853", urn:"urn:lex:br:federal:lei:1853-08-10;693", ementa:"AUTORIZA O GOVERNO A IMPETRAR DA SANTA SE AS BULAS DE CRIAÇÃO DE DOIS BISPADOS, UM NA PROVINCIA DE MINAS GERAIS E OUTRO NA DO CEARA.", arquivo:"federal/leis-ordinarias/1853/lei-693-1853-08-10.md"}}, {id:"federal:BR:L:683/1853", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1853, data:"1853-07-05", nu