-12-29.md"}}, {id:"federal:BR:L:11979/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-07-08", numero:"11979", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-07-08;11979", vigente:true, titulo:"Lei nº 11.979 de 08/07/2009", urn:"urn:lex:br:federal:lei:2009-07-08;11979", ementa:"Dispõe sobre a criação de cargos de provimento efetivo e em comissão e funções comissionadas no Quadro de Pessoal da Secretaria do Tribunal Regional do Trabalho da 9ª Região e dá outras providências.", arquivo:"federal/leis-ordinarias/2009/lei-11979-2009-07-08.md"}}, {id:"federal:BR:L:12102/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-01", numero:"12102", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-01;12102", vigente:true, titulo:"Lei nº 12.102 de 01/12/2009", urn:"urn:lex:br:federal:lei:2009-12-01;12102", ementa:"Institui o Dia do Plano Nacional de Educação, acrescentando artigo à Lei nº 10.172, de 9 de janeiro de 2001.", arquivo:"federal/leis-ordinarias/2009/lei-12102-2009-12-01.md"}}, {id:"federal:BR:L:11987/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-07-27", numero:"11987", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-07-27;11987", vigente:true, titulo:"Lei nº 11.987 de 27/07/2009", urn:"urn:lex:br:federal:lei:2009-07-27;11987", ementa:"Altera a composição e a organização interna do Tribunal Regional do Trabalho da 11ª Região - AM/RR, com sede em Manaus, Estado do Amazonas, e dá outras providências.", arquivo:"federal/leis-ordinarias/2009/lei-11987-2009-07-27.md"}}, {id:"federal:BR:L:11935/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-05-11", numero:"11935", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-05-11;11935", vigente:true, titulo:"Lei nº 11.935 de 11/05/2009", urn:"urn:lex:br:federal:lei:2009-05-11;11935", ementa:"Altera o art. 35-C da Lei nº 9.656, de 3 de junho de 1998, que dispõe sobre os planos e seguros privados de assistência à saúde.", arquivo:"federal/leis-ordinarias/2009/lei-11935-2009-05-11.md"}}, {id:"federal:BR:L:12074/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-10-29", numero:"12074", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-10-29;12074", vigente:true, titulo:"Lei nº 12.074 de 29/10/2009", urn:"urn:lex:br:federal:lei:2009-10-29;12074", ementa:"Institui o Dia Nacional do Engenheiro Eletricista.", arquivo:"federal/leis-ordinarias/2009/lei-12074-2009-10-29.md"}}, {id:"federal:BR:L:12005/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-07-29", numero:"12005", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-07-29;12005", vigente:true, titulo:"Lei nº 12.005 de 29/07/2009", urn:"urn:lex:br:federal:lei:2009-07-29;12005", ementa:"Dispõe sobre a criação de 1 (um) cargo em comissão e de funções comissionadas no Quadro de Pessoal do Tribunal Regional do Trabalho da 1ª Região.", arquivo:"federal/leis-ordinarias/2009/lei-12005-2009-07-29.md"}}, {id:"federal:BR:L:12024/2009", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-08-27", numero:"12024", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-08-27;12024", vigente:true, titulo:"Lei nº 12.024 de 27/08/2009", urn:"urn:lex:br:federal:lei:2009-08-27;12024", ementa:"Dá nova redação aos arts. 4º, 5º e 8º da Lei nº 10.931, de 2 de agosto de 2004, que tratam de patrimônio de afetação de incorporações imobiliárias; dispõe sobre o tratamento tributário a ser dado às receitas mensais auferidas pelas empresas construtoras nos contratos de construção de moradias firmados dentro do Programa Minha Casa, Minha Vida - PMCMV, atribui à Agência Nacional de Telecomunicações - ANATEL as atribuições de apurar, constituir, fiscalizar e arrecadar a Contribuição para o Fomento", arquivo:"federal/leis-ordinarias/2009/lei-12024-2009-08-27.md"}}, {id:"federal:BR:L:12050/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-10-09", numero:"12050", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-10-09;12050", vigente:true, titulo:"Lei nº 12.050 de 09/10/2009", urn:"urn:lex:br:federal:lei:2009-10-09;12050", ementa:"Abre ao Orçamento Fiscal da União, em favor da Justiça do Trabalho, crédito suplementar no valor de R$ 26.724.533,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2009/lei-12050-2009-10-09.md"}}, {id:"federal:BR:L:11929/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-04-17", numero:"11929", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-04-17;11929", vigente:true, titulo:"Lei nº 11.929 de 17/04/2009", urn:"urn:lex:br:federal:lei:2009-04-17;11929", ementa:"Denomina Rodovia Governador Aquilino Mota Duarte o trecho da rodovia BR-210.", arquivo:"federal/leis-ordinarias/2009/lei-11929-2009-04-17.md"}}, {id:"federal:BR:L:12130/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-17", numero:"12130", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-17;12130", vigente:true, titulo:"Lei nº 12.130 de 17/12/2009", urn:"urn:lex:br:federal:lei:2009-12-17;12130", ementa:"Institui o Dia Nacional do Historiador, a ser celebrado anualmente no dia 19 de agosto.", arquivo:"federal/leis-ordinarias/2009/lei-12130-2009-12-17.md"}}, {id:"federal:BR:L:11960/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-06-29", numero:"11960", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-06-29;11960", vigente:true, titulo:"Lei nº 11.960 de 29/06/2009", urn:"urn:lex:br:federal:lei:2009-06-29;11960", ementa:"Altera e acresce dispositivos às Leis nºs 9.639, de 25 de maio de 1998, e 11.196, de 21 de novembro de 2005, para dispor sobre parcelamento de débitos de responsabilidade dos Municípios, decorrentes de contribuições sociais de que tratam as alíneas a e c do parágrafo único do art. 11 da Lei nº 8.212, de 24 de julho de 1991; bem como acresce dispositivo à Lei nº 6.830, de 22 de setembro de 1980, para simplificar o tratamento dado às cobranças judiciais da dívida ativa quando, da decisão que orden", arquivo:"federal/leis-ordinarias/2009/lei-11960-2009-06-29.md"}}, {id:"federal:BR:L:12042/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-10-08", numero:"12042", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-10-08;12042", vigente:true, titulo:"Lei nº 12.042 de 08/10/2009", urn:"urn:lex:br:federal:lei:2009-10-08;12042", ementa:"Dispõe sobre a revisão do subsídio do Procurador-Geral da República, referido no inciso XI do art. 37 e no § 4º do art. 39, c/c o § 2º do art. 127 e a alínea c do inciso I do § 5º do art. 128, todos da Constituição Federal.", arquivo:"federal/leis-ordinarias/2009/lei-12042-2009-10-08.md"}}, {id:"federal:BR:L:11973/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-07-06", numero:"11973", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-07-06;11973", vigente:true, titulo:"Lei nº 11.973 de 06/07/2009", urn:"urn:lex:br:federal:lei:2009-07-06;11973", ementa:"Abre ao Orçamento Fiscal da União, em favor da Presidência da República, crédito especial no valor de R$ 492.078.530,00, para os fins que especifica, e dá outras providências.", arquivo:"federal/leis-ordinarias/2009/lei-11973-2009-07-06.md"}}, {id:"federal:BR:L:12111/2009", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-09", numero:"12111", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-09;12111", vigente:true, titulo:"Lei nº 12.111 de 09/12/2009", urn:"urn:lex:br:federal:lei:2009-12-09;12111", ementa:"Dispõe sobre os serviços de energia elétrica nos Sistemas Isolados; altera as Leis nºs 9.991, de 24 de julho de 2000, 9.074, de 7 de julho de 1995, 9.427, de 26 de dezembro de 1996, e 10.848, de 15 de março de 2004; revoga dispositivos das Leis nºs 8.631, de 4 de março de 1993, 9.648, de 27 de maio de 1998, e 10.833, de 29 de dezembro de 2003; e dá outras providências.", arquivo:"federal/leis-ordinarias/2009/lei-12111-2009-12-09.md"}}, {id:"federal:BR:L:12123/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-15", numero:"12123", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-15;12123", vigente:true, titulo:"Lei nº 12.123 de 15/12/2009", urn:"urn:lex:br:federal:lei:2009-12-15;12123", ementa:"Dá nova redação à alínea o do inciso VII do caput do art. 27 da Lei nº 10.683, de 28 de maio de 2003, que dispõe sobre a organização da Presidência da República e dos Ministérios.", arquivo:"federal/leis-ordinarias/2009/lei-12123-2009-12-15.md"}}, {id:"federal:BR:L:12179/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-29", numero:"12179", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-29;12179", vigente:true, titulo:"Lei nº 12.179 de 29/12/2009", urn:"urn:lex:br:federal:lei:2009-12-29;12179", ementa:"Abre ao Orçamento de Investimento para 2009, em favor de empresas estatais, crédito especial no valor total de R$ 257.168.111,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2009/lei-12179-2009-12-29.md"}}, {id:"federal:BR:L:12144/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-21", numero:"12144", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-21;12144", vigente:true, titulo:"Lei nº 12.144 de 21/12/2009", urn:"urn:lex:br:federal:lei:2009-12-21;12144", ementa:"Abre ao Orçamento Fiscal da União, em favor da Presidência da República, crédito especial no valor de R$ 90.000,00, para o fim que especifica, e dá outras providências.", arquivo:"federal/leis-ordinarias/2009/lei-12144-2009-12-21.md"}}, {id:"federal:BR:L:11919/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-04-09", numero:"11919", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-04-09;11919", vigente:true, titulo:"Lei nº 11.919 de 09/04/2009", urn:"urn:lex:br:federal:lei:2009-04-09;11919", ementa:"Denomina Ponte João Monteiro Barbosa Filho a ponte transposta sobre o Rio Tacutu, na BR-401, Km 133, nos Municípios de Bonfim e Normandia, no Estado de Roraima", arquivo:"federal/leis-ordinarias/2009/lei-11919-2009-04-09.md"}}, {id:"federal:BR:L:11955/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-06-25", numero:"11955", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-06-25;11955", vigente:true, titulo:"Lei nº 11.955 de 25/06/2009", urn:"urn:lex:br:federal:lei:2009-06-25;11955", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor do Ministério da Ciência e Tecnologia, crédito especial no valor de R$ 42.000.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2009/lei-11955-2009-06-25.md"}}, {id:"federal:BR:L:11925/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-04-17", numero:"11925", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-04-17;11925", vigente:true, titulo:"Lei nº 11.925 de 17/04/2009", urn:"urn:lex:br:federal:lei:2009-04-17;11925", ementa:"Dá nova redação aos arts. 830 e 895 da Consolidação das Leis do Trabalho - CLT, aprovada pelo Decreto-Lei nº 5.452, de 1º de maio de 1943.", arquivo:"federal/leis-ordinarias/2009/lei-11925-2009-04-17.md"}}, {id:"federal:BR:L:12166/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-29", numero:"12166", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-29;12166", vigente:true, titulo:"Lei nº 12.166 de 29/12/2009", urn:"urn:lex:br:federal:lei:2009-12-29;12166", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério da Pesca e Aquicultura, crédito especial no valor de R$ 31.150.175,00, para os fins que especifica, e dá outras providências.", arquivo:"federal/leis-ordinarias/2009/lei-12166-2009-12-29.md"}}, {id:"federal:BR:L:11998/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-07-29", numero:"11998", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-07-29;11998", vigente:true, titulo:"Lei nº 11.998 de 29/07/2009", urn:"urn:lex:br:federal:lei:2009-07-29;11998", ementa:"Dispõe sobre a criação de cargos de Juiz do Trabalho Substituto, de cargos de provimento efetivo e em comissão e de funções comissionadas no Quadro de Pessoal do Tribunal Regional do Trabalho da 2ª Região.", arquivo:"federal/leis-ordinarias/2009/lei-11998-2009-07-29.md"}}, {id:"federal:BR:L:11941/2009", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-05-27", numero:"11941", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-05-27;11941", vigente:true, titulo:"Lei nº 11.941 de 27/05/2009", urn:"urn:lex:br:federal:lei:2009-05-27;11941", ementa:"Altera a legislação tributária federal relativa ao parcelamento ordinário de débitos tributários; concede remissão nos casos em que especifica; institui regime tributário de transição, alterando o Decreto nº 70.235, de 6 de março de 1972, as Leis nºs 8.212, de 24 de julho de 1991, 8.213, de 24 de julho de 1991, 8.218, de 29 de agosto de 1991, 9.249, de 26 de dezembro de 1995, 9.430, de 27 de dezembro de 1996, 9.469, de 10 de julho de 1997, 9.532, de 10 de dezembro de 1997, 10.426, de 24 de abril", arquivo:"federal/leis-ordinarias/2009/lei-11941-2009-05-27.md"}}, {id:"federal:BR:L:11940/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-05-19", numero:"11940", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-05-19;11940", vigente:true, titulo:"Lei nº 11.940 de 19/05/2009", urn:"urn:lex:br:federal:lei:2009-05-19;11940", ementa:"Estabelece 2009 como Ano da Educação Profissional e Tecnológica e o dia 23 de setembro como o Dia Nacional dos Profissionais de Nível Técnico.", arquivo:"federal/leis-ordinarias/2009/lei-11940-2009-05-19.md"}}, {id:"federal:BR:L:12184/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-29", numero:"12184", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-29;12184", vigente:true, titulo:"Lei nº 12.184 de 29/12/2009", urn:"urn:lex:br:federal:lei:2009-12-29;12184", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor dos Ministérios da Educação, da Cultura e do Esporte, crédito suplementar no valor global de R$ 1.277.680.344,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2009/lei-12184-2009-12-29.md"}}, {id:"federal:BR:L:11963/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-07-03", numero:"11963", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-07-03;11963", vigente:true, titulo:"Lei nº 11.963 de 03/07/2009", urn:"urn:lex:br:federal:lei:2009-07-03;11963", ementa:"Dispõe sobre a criação de cargos de provimento efetivo e funções comissionadas no Quadro de Pessoal da Secretaria do Tribunal Regional do Trabalho da 5ª Região.", arquivo:"federal/leis-ordinarias/2009/lei-11963-2009-07-03.md"}}, {id:"federal:BR:L:12158/2009", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-28", numero:"12158", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-28;12158", vigente:true, titulo:"Lei nº 12.158 de 28/12/2009", urn:"urn:lex:br:federal:lei:2009-12-28;12158", ementa:"Dispõe sobre o acesso às graduações superiores de militares oriundos do Quadro de Taifeiros da Aeronáutica.", arquivo:"federal/leis-ordinarias/2009/lei-12158-2009-12-28.md"}}, {id:"federal:BR:L:12105/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-02", numero:"12105", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-02;12105", vigente:true, titulo:"Lei nº 12.105 de 02/12/2009", urn:"urn:lex:br:federal:lei:2009-12-02;12105", ementa:"Inscreve o nome de Anna Justina Ferreira Nery no Livro dos Heróis da Pátria.", arquivo:"federal/leis-ordinarias/2009/lei-12105-2009-12-02.md"}}, {id:"federal:BR:L:11936/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-05-14", numero:"11936", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-05-14;11936", vigente:true, titulo:"Lei nº 11.936 de 14/05/2009", urn:"urn:lex:br:federal:lei:2009-05-14;11936", ementa:"Proíbe a fabricação, a importação, a exportação, a manutenção em estoque, a comercialização e o uso de diclorodifeniltricloretano (DDT) e dá outras providências.", arquivo:"federal/leis-ordinarias/2009/lei-11936-2009-05-14.md"}}, {id:"federal:BR:L:12034/2009", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-09-29", numero:"12034", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-09-29;12034", vigente:true, titulo:"Lei nº 12.034 de 29/09/2009", urn:"urn:lex:br:federal:lei:2009-09-29;12034", ementa:"Altera as Leis nºs 9.096, de 19 de setembro de 1995 - Lei dos Partidos Políticos, 9.504, de 30 de setembro de 1997, que estabelece normas para as eleições, e 4.737, de 15 de julho de 1965 - Código Eleitoral.", arquivo:"federal/leis-ordinarias/2009/lei-12034-2009-09-29.md"}}, {id:"federal:BR:L:12036/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-10-01", numero:"12036", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-10-01;12036", vigente:true, titulo:"Lei nº 12.036 de 01/10/2009", urn:"urn:lex:br:federal:lei:2009-10-01;12036", ementa:"Altera o Decreto-Lei nº 4.657, de 4 de setembro de 1942 - Lei de Introdução ao Código Civil Brasileiro, para adequá-lo à Constituição Federal em vigor.", arquivo:"federal/leis-ordinarias/2009/lei-12036-2009-10-01.md"}}, {id:"federal:BR:L:12069/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-10-29", numero:"12069", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-10-29;12069", vigente:true, titulo:"Lei nº 12.069 de 29/10/2009", urn:"urn:lex:br:federal:lei:2009-10-29;12069", ementa:"Denomina Rodovia Governador Hélio Campos o trecho da BR-174.", arquivo:"federal/leis-ordinarias/2009/lei-12069-2009-10-29.md"}}, {id:"federal:BR:L:12175/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-29", numero:"12175", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-29;12175", vigente:true, titulo:"Lei nº 12.175 de 29/12/2009", urn:"urn:lex:br:federal:lei:2009-12-29;12175", ementa:"Abre ao Orçamento da Seguridade Social da União, em favor dos Ministérios da Previdência Social e do Desenvolvimento Social e Combate à Fome, crédito suplementar no valor global de R$ 98.671.192,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2009/lei-12175-2009-12-29.md"}}, {id:"federal:BR:L:12140/2009", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-21", numero:"12140", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-21;12140", vigente:true, titulo:"Lei nº 12.140 de 21/12/2009", urn:"urn:lex:br:federal:lei:2009-12-21;12140", ementa:"Abre ao Orçamento Fiscal da União, em favor do Supremo Tribunal Federal, da Justiça Eleitoral, da Presidência da República e do Ministério Público da União, crédito suplementar no valor global de R$ 16.301.300,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2009/lei-12140-2009-12-21.md"}}, {id:"federal:BR:L:12027/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-09-09", numero:"12027", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-09-09;12027", vigente:true, titulo:"Lei nº 12.027 de 09/09/2009", urn:"urn:lex:br:federal:lei:2009-09-09;12027", ementa:"Cria cargos de juiz do trabalho substituto no Tribunal Regional do Trabalho da 2ª Região, com sede em São Paulo.", arquivo:"federal/leis-ordinarias/2009/lei-12027-2009-09-09.md"}}, {id:"federal:BR:L:11945/2009", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-06-04", numero:"11945", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-06-04;11945", vigente:true, titulo:"Lei nº 11.945 de 04/06/2009", urn:"urn:lex:br:federal:lei:2009-06-04;11945", ementa:"Altera a legislação tributária federal e dá outras providências.", arquivo:"federal/leis-ordinarias/2009/lei-11945-2009-06-04.md"}}, {id:"federal:BR:L:11950/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-06-17", numero:"11950", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-06-17;11950", vigente:true, titulo:"Lei nº 11.950 de 17/06/2009", urn:"urn:lex:br:federal:lei:2009-06-17;11950", ementa:"Altera dispositivos da Lei nº 10.356, de 27 de dezembro de 2001 - Plano de Carreira do Tribunal de Contas da União e dá outras providências.", arquivo:"federal/leis-ordinarias/2009/lei-11950-2009-06-17.md"}}, {id:"federal:BR:L:12009/2009", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-07-29", numero:"12009", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-07-29;12009", vigente:true, titulo:"Lei nº 12.009 de 29/07/2009", urn:"urn:lex:br:federal:lei:2009-07-29;12009", ementa:"Regulamenta o exercício das atividades dos profissionais em transporte de passageiros, \"mototaxista\", em entrega de mercadorias e em serviço comunitário de rua, e \"motoboy\", com o uso de motocicleta, altera a Lei nº 9.503, de 23 de setembro de 1997, para dispor sobre regras de segurança dos serviços de transporte remunerado de mercadorias em motocicletas e motonetas - moto- frete -, estabelece regras gerais para a regulação deste serviço e dá outras providências.", arquivo:"federal/leis-ordinarias/2009/lei-12009-2009-07-29.md"}}, {id:"federal:BR:L:12115/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-10", numero:"12115", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-10;12115", vigente:true, titulo:"Lei nº 12.115 de 10/12/2009", urn:"urn:lex:br:federal:lei:2009-12-10;12115", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor das Justiças Eleitoral e do Trabalho e de diversos órgãos do Poder Executivo, crédito suplementar no valor global de R$ 38.168.091,00 para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2009/lei-12115-2009-12-10.md"}}, {id:"federal:BR:L:12078/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-10-29", numero:"12078", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-10-29;12078", vigente:true, titulo:"Lei nº 12.078 de 29/10/2009", urn:"urn:lex:br:federal:lei:2009-10-29;12078", ementa:"Denomina Viaduto Múcio Teixeira o viaduto localizado no km 166 da BR-060.", arquivo:"federal/leis-ordinarias/2009/lei-12078-2009-10-29.md"}}, {id:"federal:BR:L:12054/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-10-09", numero:"12054", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-10-09;12054", vigente:true, titulo:"Lei nº 12.054 de 09/10/2009", urn:"urn:lex:br:federal:lei:2009-10-09;12054", ementa:"Institui o Dia do Movimento Pestalozziano no Brasil, a ser comemorado no dia 26 de outubro.", arquivo:"federal/leis-ordinarias/2009/lei-12054-2009-10-09.md"}}, {id:"federal:BR:L:12155/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-23", numero:"12155", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-23;12155", vigente:true, titulo:"Lei nº 12.155 de 23/12/2009", urn:"urn:lex:br:federal:lei:2009-12-23;12155", ementa:"Dispõe sobre a concessão de Bônus Especial de Desempenho Institucional - BESP/DNIT aos servidores do Departamento Nacional de Infra-Estrutura de Transportes - DNIT; altera as Leis nºs 11.171, de 2 de setembro de 2005, 10.997, de 15 de dezembro de 2004, 11.907, de 2 de fevereiro de 2009, e 11.507, de 20 de julho de 2007; e dá outras providências.", arquivo:"federal/leis-ordinarias/2009/lei-12155-2009-12-23.md"}}, {id:"federal:BR:L:11913/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-03-31", numero:"11913", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-03-31;11913", vigente:true, titulo:"Lei nº 11.913 de 31/03/2009", urn:"urn:lex:br:federal:lei:2009-03-31;11913", ementa:"Denomina \"Rodovia Sylvio Lofêgo Botelho\" trecho da BR-401, no Estado de Roraima.", arquivo:"federal/leis-ordinarias/2009/lei-11913-2009-03-31.md"}}, {id:"federal:BR:L:12139/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-21", numero:"12139", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-21;12139", vigente:true, titulo:"Lei nº 12.139 de 21/12/2009", urn:"urn:lex:br:federal:lei:2009-12-21;12139", ementa:"Abre ao Orçamento Fiscal da União, em favor dos Ministérios da Ciência e Tecnologia, da Educação, da Cultura e do Esporte, crédito suplementar no valor global de R$ 250.945.886,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2009/lei-12139-2009-12-21.md"}}, {id:"federal:BR:L:12014/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-08-06", numero:"12014", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-08-06;12014", vigente:true, titulo:"Lei nº 12.014 de 06/08/2009", urn:"urn:lex:br:federal:lei:2009-08-06;12014", ementa:"Altera o art. 61 da Lei nº 9.394, de 20 de dezembro de 1996, com a finalidade de discriminar as categorias de trabalhadores que se devem considerar profissionais da educação.", arquivo:"federal/leis-ordinarias/2009/lei-12014-2009-08-06.md"}}, {id:"federal:BR:L:11958/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-06-26", numero:"11958", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-06-26;11958", vigente:true, titulo:"Lei nº 11.958 de 26/06/2009", urn:"urn:lex:br:federal:lei:2009-06-26;11958", ementa:"Altera as Leis nºs 7.853, de 24 de outubro de 1989, e 10.683, de 28 de maio de 2003; dispõe sobre a transformação da Secretaria Especial de Aquicultura e Pesca da Presidência da República em Ministério da Pesca e Aquicultura; cria cargos em comissão do Grupo-Direção e Assessoramento Superiores - DAS e Gratificações de Representação da Presidência da República; e dá outras providências.", arquivo:"federal/leis-ordinarias/2009/lei-11958-2009-06-26.md"}}, {id:"federal:BR:L:11949/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-06-17", numero:"11949", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-06-17;11949", vigente:true, titulo:"Lei nº 11.949 de 17/06/2009", urn:"urn:lex:br:federal:lei:2009-06-17;11949", ementa:"Dá nova redação à Lei nº 10.304, de 5 de novembro de 2001, que transfere ao domínio dos Estados de Roraima e do Amapá as terras pertencentes à União e dá outras providências.", arquivo:"federal/leis-ordinarias/2009/lei-11949-2009-06-17.md"}}, {id:"federal:BR:L:12020/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-08-27", numero:"12020", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-08-27;12020", vigente:true, titulo:"Lei nº 12.020 de 27/08/2009", urn:"urn:lex:br:federal:lei:2009-08-27;12020", ementa:"Dá nova redação ao inciso II do caput do art. 20 da Lei nº 9.394, de 20 de dezembro de 1996, que estabelece as diretrizes e bases da educação nacional, para modificar o rol de instituições de ensino comunitárias.", arquivo:"federal/leis-ordinarias/2009/lei-12020-2009-08-27.md"}}, {id:"federal:BR:L:12126/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-16", numero:"12126", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-16;12126", vigente:true, titulo:"Lei nº 12.126 de 16/12/2009", urn:"urn:lex:br:federal:lei:2009-12-16;12126", ementa:"Dá nova redação ao § 1º do art. 8º da Lei nº 9.099, de 26 de setembro de 1995, que dispõe sobre os Juizados Especiais Cíveis e Criminais.", arquivo:"federal/leis-ordinarias/2009/lei-12126-2009-12-16.md"}}, {id:"federal:BR:L:12017/2009", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-08-12", numero:"12017", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-08-12;12017", vigente:true, titulo:"Lei nº 12.017 de 12/08/2009", urn:"urn:lex:br:federal:lei:2009-08-12;12017", ementa:"Dispõe sobre as diretrizes para a elaboração e execução da Lei Orçamentária de 2010 e dá outras providências.", arquivo:"federal/leis-ordinarias/2009/lei-12017-2009-08-12.md"}}, {id:"federal:BR:L:12001/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-07-29", numero:"12001", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-07-29;12001", vigente:true, titulo:"Lei nº 12.001 de 29/07/2009", urn:"urn:lex:br:federal:lei:2009-07-29;12001", ementa:"Altera a composição e a organização interna do Tribunal Regional do Trabalho da 15ª Região, com sede em Campinas, Estado de São Paulo, e dá outras providências.", arquivo:"federal/leis-ordinarias/2009/lei-12001-2009-07-29.md"}}, {id:"federal:BR:L:12070/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-10-29", numero:"12070", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-10-29;12070", vigente:true, titulo:"Lei nº 12.070 de 29/10/2009", urn:"urn:lex:br:federal:lei:2009-10-29;12070", ementa:"Institui o Dia Nacional do Inventor e dá outras providências.", arquivo:"federal/leis-ordinarias/2009/lei-12070-2009-10-29.md"}}, {id:"federal:BR:L:11907/2009", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-02-02", numero:"11907", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-02-02;11907", vigente:true, titulo:"Lei nº 11.907 de 02/02/2009", urn:"urn:lex:br:federal:lei:2009-02-02;11907", ementa:"Dispõe sobre a reestruturação da composição remuneratória das Carreiras de Oficial de Chancelaria e de Assistente de Chancelaria, de que trata o art. 2º da Lei nº 11.440, de 29 de dezembro de 2006, da Carreira de Tecnologia Militar, de que trata a Lei nº 9.657, de 3 de junho de 1998, dos cargos do Grupo Defesa Aérea e Controle de Tráfego Aéreo - Grupo DACTA, de que trata a Lei nº 10.551, de 13 de novembro de 2002, dos empregos públicos do Quadro de Pessoal do Hospital das Forças Armadas - HFA, d", arquivo:"federal/leis-ordinarias/2009/lei-11907-2009-02-02.md"}}, {id:"federal:BR:L:12025/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vi