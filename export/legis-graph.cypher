.", arquivo:"federal/leis-ordinarias/1953/lei-1863-1953-05-21.md"}}, {id:"federal:BR:L:2066/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-11-06", numero:"2066", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-11-06;2066", vigente:true, titulo:"Lei nº 2.066 de 06/11/1953", urn:"urn:lex:br:federal:lei:1953-11-06;2066", ementa:"Concede a pensão especial de Cr$ 850,00 a Etelvina Barbosa Leite, viúva de Gustavo Francisco Leite, ex-contra-mestre aposentado do Arsenal de Guerra do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1953/lei-2066-1953-11-06.md"}}, {id:"federal:BR:L:2072/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-11-09", numero:"2072", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-11-09;2072", vigente:true, titulo:"Lei nº 2.072 de 09/11/1953", urn:"urn:lex:br:federal:lei:1953-11-09;2072", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Saúde, o crédito especial de Cr$ 14.000,00 (quatorze mil cruzeiros), para pagamento do auxílio ao Hospital Virgílio Pereira, de Barreiro, Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1953/lei-2072-1953-11-09.md"}}, {id:"federal:BR:L:1897/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-07-06", numero:"1897", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-07-06;1897", vigente:true, titulo:"Lei nº 1.897 de 06/07/1953", urn:"urn:lex:br:federal:lei:1953-07-06;1897", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Saúde, o crédito especial de Cr$ 72.420,00, para pagamento de diferença de vencimentos ao Professor Ciro Romano Farina.", arquivo:"federal/leis-ordinarias/1953/lei-1897-1953-07-06.md"}}, {id:"federal:BR:L:2002/1953", properties:{esfera:"federal", versao_