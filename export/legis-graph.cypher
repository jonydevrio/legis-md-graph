BR:L:13783/2018", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2018, data:"2018-12-26", numero:"13783", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2018-12-26;13783", vigente:true, titulo:"Lei nº 13.783 de 26/12/2018", urn:"urn:lex:br:federal:lei:2018-12-26;13783", ementa:"Altera a Lei nº 13.587, de 2 de janeiro de 2018.", arquivo:"federal/leis-ordinarias/2018/lei-13783-2018-12-26.md"}}, {id:"federal:BR:L:13716/2018", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2018, data:"2018-09-24", numero:"13716", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2018-09-24;13716", vigente:true, titulo:"Lei nº 13.716 de 24/09/2018", urn:"urn:lex:br:federal:lei:2018-09-24;13716", ementa:"Altera a Lei nº 9.394, de 20 de dezembro de 1996 (Lei de Diretrizes e Bases da Educação Nacional), para assegurar atendimento educacional ao aluno da educação básica internado para tratamento de saúde em regime hospitalar ou domiciliar por tempo prolongado.", arquivo:"federal/leis-ordinarias/2018/lei-13716-2018-09-24.md"}}, {id:"federal:BR:L:13596/2018", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2018, data:"2018-01-08", numero:"13596", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2018-01-08;13596", vigente:true, titulo:"Lei nº 13.596 de 08/01/2018", urn:"urn:lex:br:federal:lei:2018-01-08;13596", ementa:"Institui o \"Dia Nacional do Zootecnista\".", arquivo:"federal/leis-ordinarias/2018/lei-13596-2018-01-08.md"}}, {id:"federal:BR:L:13595/2018", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2018, data:"2018-01-05", numero:"13595", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2018-01-05;13595", vigente:true, titulo:"Lei nº 13.595 de 05/01/2018", urn:"urn:lex:br:federal:lei:2018-01-05;13595", ementa:"Altera a Lei nº 11.350, de 5 de outubro de 2006, para dispor sobre a reformulação das atribuições, a jornada e as condições de trabalho, o grau de formação profissional, os cursos de formação técnica e continuada e a indenização de transporte dos profissionais Agentes Comunitários de Saúde e Agentes de Combate às Endemias.", arquivo:"federal/leis-ordinarias/2018/lei-13595-2018-01-05.md"}}, {id:"federal:BR:L:13663/2018", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2018, data:"2018-05-14", numero:"13663", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2018-05-14;13663", vigente:true, titulo:"Lei nº 13.663 de 14/05/2018", urn:"urn:lex:br:federal:lei:2018-05-14;13663", ementa:"Altera o art. 12 da Lei nº 9.394, de 20 de dezembro de 1996, para incluir a promoção de medidas de conscientização, de prevenção e de combate a todos os tipos de violência e a promoção da cultura de paz entre as incumbências dos estabelecimentos de ensino.", arquivo:"federal/leis-ordinarias/2018/lei-13663-2018-05-14.md"}}, {id:"federal:BR:L:13671/2018", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2018, data:"2018-06-05", numero:"13671", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2018-06-05;13671", vigente:true, titulo:"Lei nº 13.671 de 05/06/2018", urn:"urn:lex:br:federal:lei:2018-06-05;13671", ementa:"Altera o Anexo V à Lei nº 13.587, de 2 de janeiro de 2018, que estima a receita e fixa a despesa da União para o exercício financeiro de 2018.", arquivo:"federal/leis-ordinarias/2018/lei-13671-2018-06-05.md"}}, {id:"federal:BR:L:13739/2018", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2018, data:"2018-11-22", numero:"13739", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2018-11-22;13739", vigente:true, titulo:"Lei nº 