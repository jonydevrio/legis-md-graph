ções do imposto de vendas e consignações nos Territórios Federais.", arquivo:"federal/leis-ordinarias/1960/lei-3758-1960-04-25.md"}}, {id:"federal:BR:L:3859/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-12-24", numero:"3859", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-12-24;3859", vigente:true, titulo:"Lei nº 3.859 de 24/12/1960", urn:"urn:lex:br:federal:lei:1960-12-24;3859", ementa:"Autoriza a abertura ao Poder Judiciário - Tribunal de Justiça do Distrito Federal do crédito especial de Cr$ 78.000,00, destinado a atender ao pagamento de gratificação de representação devida aos Desembargadores, Presidente e Vice-Presidente daquele Tribunal e ao Juiz Presidente do Tribunal do Juri.", arquivo:"federal/leis-ordinarias/1960/lei-3859-1960-12-24.md"}}, {id:"federal:BR:L:282/1843", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1843, data:"1843-05-24", numero:"282", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1843-05-24;282", vigente:true, titulo:"Lei nº 282 de 24/05/1843", urn:"urn:lex:br:federal:lei:1843-05-24;282", ementa:"FIXANDO AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1843 - 1844.", arquivo:"federal/leis-ordinarias/1843/lei-282-1843-05-24.md"}}, {id:"federal:BR:L:317/1843", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1843, data:"1843-10-21", numero:"317", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1843-10-21;317", vigente:true, titulo:"Lei nº 317 de 21/10/1843", urn:"urn:lex:br:federal:lei:1843-10-21;317", ementa:"FIXANDO A DESPEZA E ORÇANDO A RECEITA PARA OS EXERCÍCIOS DE 1843 - 1844 E 1844 - 1845.", arquivo:"federal/leis-ordinarias/1843/lei-317-1843-10-21.md"}}, {id:"federal:BR:L:281/1843", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogad