20;13376", vigente:true, titulo:"Lei nº 13.376 de 20/12/2016", urn:"urn:lex:br:federal:lei:2016-12-20;13376", ementa:"Abre ao Orçamento Fiscal da União, em favor das Justiças Federal e do Trabalho e do Ministério Público da União, crédito especial no valor de R$ 5.253.732,00 para os fins que especifica.", arquivo:"federal/leis-ordinarias/2016/lei-13376-2016-12-20.md"}}, {id:"federal:BR:L:13293/2016", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2016, data:"2016-06-01", numero:"13293", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2016-06-01;13293", vigente:true, titulo:"Lei nº 13.293 de 01/06/2016", urn:"urn:lex:br:federal:lei:2016-06-01;13293", ementa:"Altera a Lei nº 12.505, de 11 de outubro de 2011, que \"concede anistia aos policiais e bombeiros militares dos Estados de Alagoas, de Goiás, do Maranhão, de Minas Gerais, da Paraíba, do Piauí, do Rio de Janeiro, de Rondônia, de Sergipe, da Bahia, do Ceará, de Mato Grosso, de Pernambuco, do Rio Grande do Norte, de Roraima, de Santa Catarina, do Tocantins e do Distrito Federal punidos por participar de movimentos reivindicatórios\", para acrescentar os Estados do Amazonas, do Pará, do Acre, do Mato", arquivo:"federal/leis-ordinarias/2016/lei-13293-2016-06-01.md"}}, {id:"federal:BR:L:13363/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2016, data:"2016-11-25", numero:"13363", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2016-11-25;13363", vigente:true, titulo:"Lei nº 13.363 de 25/11/2016", urn:"urn:lex:br:federal:lei:2016-11-25;13363", ementa:"Altera a Lei nº 8.906, de 4 de julho de 1994, e a Lei nº 13.105, de 16 de março de 2015 (Código de Processo Civil), para estipular direitos e garantias para a advogada gestante, lactante, adotante ou que der à luz e para o advogado que se tornar pai.", arquivo:"federal/leis-ordinarias/2016/lei-13363-2016-11-25.md"}}, {id:"federal:BR:L:13272/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2016, data:"2016-04-15", numero:"13272", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2016-04-15;13272", vigente:true, titulo:"Lei nº 13.272 de 15/04/2016", urn:"urn:lex:br:federal:lei:2016-04-15;13272", ementa:"Institui o ano de 2016 como o Ano do Empoderamento da Mulher na Política e no Esporte.", arquivo:"federal/leis-ordinarias/2016/lei-13272-2016-04-15.md"}}, {id:"federal:BR:L:13285/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2016, data:"2016-05-10", numero:"13285", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2016-05-10;13285", vigente:true, titulo:"Lei nº 13.285 de 10/05/2016", urn:"urn:lex:br:federal:lei:2016-05-10;13285", ementa:"Acrescenta o art. 394-A ao Decreto-Lei nº 3.689, de 3 de outubro de 1941 - Código de Processo Penal.", arquivo:"federal/leis-ordinarias/2016/lei-13285-2016-05-10.md"}}, {id:"federal:BR:L:9353/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1996, data:"1996-12-12", numero:"9353", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-12-12;9353", vigente:true, titulo:"Lei nº 9.353 de 12/12/1996", urn:"urn:lex:br:federal:lei:1996-12-12;9353", ementa:"Autoriza o Poder Executivo a abrir aos Orçamentos da União, em favor do Estado-Maior das Forças Armadas e do Ministério da Marinha, crédito suplementar no valor total de R$ 19.715.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1996/lei-9353-1996-12-12.md"}}, {id:"federal:BR:L:9361/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1996, data:"1996-12-13", numero:"9361", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-12-13;9361", vigente:true, titulo:"Lei nº 9.361 de 13/12/1996", urn:"urn:lex:br:federal:lei:1996-12-13;9361", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento Fiscal da União, em favor do Instituto Nacional de Colonização e Reforma Agrária, crédito extraordinário até o limite de R$ 800.000.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1996/lei-9361-1996-12-13.md"}}, {id:"federal:BR:L:9414/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1996, data:"1996-12-23", numero:"9414", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-12-23;9414", vigente:true, titulo:"Lei nº 9.414 de 23/12/1996", urn:"urn:lex:br:federal:lei:1996-12-23;9414", ementa:"Autoriza o Poder Executivo a abrir aos Orçamento Fiscal e da Seguridade Social da União, em favor do Ministério da Educação e do Desporto, crédito suplementar no valor de R$ 323.791.632,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1996/lei-9414-1996-12-23.md"}}, {id:"federal:BR:L:9408/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1996, data:"1996-12-20", numero:"9408", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-12-20;9408", vigente:true, titulo:"Lei nº 9.408 de 20/12/1996", urn:"urn:lex:br:federal:lei:1996-12-20;9408", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento Fiscal da União, em favor do Ministério da Ciência e Tecnologia e do Ministério dos Transportes, crédito especial até o limite de R$ 1.705.832,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1996/lei-9408-1996-12-20.md"}}, {id:"federal:BR:L:9336/1996", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1996, data:"1996-12-11", numero:"9336", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-12-11;9336", vigente:true, titulo:"Lei nº 9.336 