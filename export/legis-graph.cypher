rties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-04-13", numero:"6987", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-04-13;6987", vigente:true, titulo:"Lei nº 6.987 de 13/04/1982", urn:"urn:lex:br:federal:lei:1982-04-13;6987", ementa:"Dispõe sobre a alienação de imóveis de propriedade da   União e das entidades da Administração Federal Indireta, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1982/lei-6987-1982-04-13.md"}}, {id:"federal:BR:L:7041/1982", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-10-18", numero:"7041", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-10-18;7041", vigente:true, titulo:"Lei nº 7.041 de 18/10/1982", urn:"urn:lex:br:federal:lei:1982-10-18;7041", ementa:"Dispõe sobre a reestruturação do Grupo - Direção e   Assessoramento Superiores dos Tribunais Regionais Eleitorais e a fusão dos   Quadros Permanentes das Secretarias dos Tribunais Regionais Eleitorais dos   Estados da Guanabara e do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1982/lei-7041-1982-10-18.md"}}, {id:"federal:BR:L:7039/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-10-11", numero:"7039", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-10-11;7039", vigente:true, titulo:"Lei nº 7.039 de 11/10/1982", urn:"urn:lex:br:federal:lei:1982-10-11;7039", ementa:"Autoriza o Governo do Distrito Federal a contrair   empréstimo interno destinado ao desenvolvimento do Programa de Aglomerados   Urbanos.", arquivo:"federal/leis-ordinarias/1982/lei-7039-1982-10-11.md"}}, {id:"federal:BR:L:6990/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-05-18", numero:"6990", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-05-18;6990", vigente:true, titulo:"Lei nº 6.990 de 18/05/1982", urn:"urn:lex:br:federal:lei:1982-05-18;6990", ementa:"Altera a redação do art. 92 da Lei nº 4.737, de 15 de   julho de 1965, que instituiu o Código Eleitoral.", arquivo:"federal/leis-ordinarias/1982/lei-6990-1982-05-18.md"}}, {id:"federal:BR:L:7047/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-12-01", numero:"7047", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-12-01;7047", vigente:true, titulo:"Lei nº 7.047 de 01/12/1982", urn:"urn:lex:br:federal:lei:1982-12-01;7047", ementa:"Altera os itens II, III e § 3º do artigo 580, da   Consolidação das Leis do Trabalho.", arquivo:"federal/leis-ordinarias/1982/lei-7047-1982-12-01.md"}}, {id:"federal:BR:L:7081/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-12-21", numero:"7081", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-12-21;7081", vigente:true, titulo:"Lei nº 7.081 de 21/12/1982", urn:"urn:lex:br:federal:lei:1982-12-21;7081", ementa:"Cria cargos em comissão e efetivos no Quadro Permanente da Secretaria do   Tribunal Regional do Trabalho da 4ª Região, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1982/lei-7081-1982-12-21.md"}}, {id:"federal:BR:L:6992/1982", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-05-25", numero:"6992", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-05-25;6992", vigente:true, titulo:"Lei nº 6.992 de 25/05/1982", urn:"urn:lex:br:federal:lei:1982-05-25;6992", ementa:"Reajusta os valores de vencimentos, salários e proventos dos servidores da Câmara do Deputados e dá outras providências.", arquivo:"federal/leis-ordinarias/1982/lei-6992-1982-05-25.md"}}, {id:"federal:BR:L:6995/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-05-31", numero:"6995", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-05-31;6995", vigente:true, titulo:"Lei nº 6.995 de 31/05/1982", urn:"urn:lex:br:federal:lei:1982-05-31;6995", ementa:"Autoriza a doação à Universidade Federal do Rio Grande   do Norte de imóvel situado no Município de Natal, Estado do Rio Grande do Norte.", arquivo:"federal/leis-ordinarias/1982/lei-6995-1982-05-31.md"}}, {id:"federal:BR:L:7003/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-06-24", numero:"7003", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-06-24;7003", vigente:true, titulo:"Lei nº 7.003 de 24/06/1982", urn:"urn:lex:br:federal:lei:1982-06-24;7003", ementa:"Altera a Relação Descritiva das Rodovias do Plano   Nacional de Viação, aprovado pela Lei n° 5.917, de 10 de setembro de 1973, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1982/lei-7003-1982-06-24.md"}}, {id:"federal:BR:L:6981/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-03-30", numero:"6981", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-03-30;6981", vigente:true, titulo:"Lei nº 6.981 de 30/03/1982", urn:"urn:lex:br:federal:lei:1982-03-30;6981", ementa:"Altera a redação do art. 42 da Lei nº 5.764, de 16 de   dezembro de 1971.", arquivo:"federal/leis-ordinarias/1982/lei-6981-1982-03-30.md"}}, {id:"federal:BR:L:7040/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-10-11", numero:"7040", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-10-11;7040", vigente:true, titulo:"Lei nº 7.040 de 11/10/1982", urn:"urn:lex:br:federal:lei:1982-10-11;7040", ementa:"Extingue o cargo de Auditor - Corregedor; transforma a atual Auditoria de   Correição em Corregedoria-Geral da Justiça Militar, atribuindo as funções de   Corregedor ao Ministro Vice-Presidente do Superior Tribunal Militar, com a   denominação cumulativa de Ministro Corregedor-Geral, e dá outras providências.", arquivo:"federal/leis-ordinarias/1982/lei-7040-1982-10-11.md"}}, {id:"federal:BR:L:7028/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-09-13", numero:"7028", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-09-13;7028", vigente:true, titulo:"Lei nº 7.028 de 13/09/1982", urn:"urn:lex:br:federal:lei:1982-09-13;7028", ementa:"Autoriza o Poder Executivo a abrir, à Justiça do   Trabalho, o crédito especial de Cr$ 125.576.000,00 (cento e vinte e cinco   milhões, quinhentos e setenta e seis mil cruzeiros) para o fim que especifica.", arquivo:"federal/leis-ordinarias/1982/lei-7028-1982-09-13.md"}}, {id:"federal:BR:L:7067/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-12-07", numero:"7067", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-12-07;7067", vigente:true, titulo:"Lei nº 7.067 de 07/12/1982", urn:"urn:lex:br:federal:lei:1982-12-07;7067", ementa:"Autoriza o Poder Executivo a doar imóvel ao Clube Inapiários do Rio Grande   do Sul, em Porto Alegre - RS.", arquivo:"federal/leis-ordinarias/1982/lei-7067-1982-12-07.md"}}, {id:"federal:BR:L:7024/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-09-08", numero:"7024", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-09-08;7024", vigente:true, titulo:"Lei nº 7.024 de 08/09/1982", urn:"urn:lex:br:federal:lei:1982-09-08;7024", ementa:"Concede pensão especial ao escultor Francisco Biquida   Dy Lafuente Guarany.", arquivo:"federal/leis-ordinarias/1982/lei-7024-1982-09-08.md"}}, {id:"federal:BR:L:6999/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-06-07", numero:"6999", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-06-07;6999", vigente:true, titulo:"Lei nº 6.999 de 07/06/1982", urn:"urn:lex:br:federal:lei:1982-06-07;6999", ementa:"Dispõe sobre a requisição de servidores públicos pela Justiça Eleitoral, e dá outras providências.", arquivo:"federal/leis-ordinarias/1982/lei-6999-1982-06-07.md"}}, {id:"federal:BR:L:7059/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-12-06", numero:"7059", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-12-06;7059", vigente:true, titulo:"Lei nº 7.059 de 06/12/1982", urn:"urn:lex:br:federal:lei:1982-12-06;7059", ementa:"Altera o artigo 30 da Lei n. 6855, de 18 de novembro   de 1980, que cria a Fundação Habitacional do Exército, e dá outras providências.", arquivo:"federal/leis-ordinarias/1982/lei-7059-1982-12-06.md"}}, {id:"federal:BR:L:11/1946", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1946, data:"1946-12-28", numero:"11", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1946-12-28;11", vigente:true, titulo:"Lei nº 11 de 28/12/1946", urn:"urn:lex:br:federal:lei:1946-12-28;11", ementa:"Inclui os oficiais dentistas, convocados para a F.E.B., entre os   beneficiados do dispisitivo na alínea b, do art. 1º do Decreto-lei nº 8.159, de   1945.", arquivo:"federal/leis-ordinarias/1946/lei-11-1946-12-28.md"}}, {id:"federal:BR:L:6/1946", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1946, data:"1946-12-19", numero:"6", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1946-12-19;6", vigente:true, titulo:"Lei nº 6 de 19/12/1946", urn:"urn:lex:br:federal:lei:1946-12-19;6", ementa:"Dispensa de Notas a disciplina de Trabalhos Manuais do ano letivo de 1946.", arquivo:"federal/leis-ordinarias/1946/lei-6-1946-12-19.md"}}, {id:"federal:BR:L:4/1946", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1946, data:"1946-12-13", numero:"4", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1946-12-13;4", vigente:true, titulo:"Lei nº 4 de 13/12/1946", urn:"urn:lex:br:federal:lei:1946-12-13;4", ementa:"Concede isenção de direitos de importação, de taxas portuárias e demais,   aos reprodutores bovinos, ovinos, cavalares e suínos, que se destinarem à 22.ª   Exposição N. e I. de Uruguaiana, no Estado do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1946/lei-4-1946-12-13.md"}}, {id:"federal:BR:L:8/1946", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1946, data:"1946-12-19", numero:"8", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1946-12-19;8", vigente:true, titulo:"Lei nº 8 de 19/12/1946", urn:"urn:lex:br:federal:lei:1946-12-19;8", ementa:"Suspende, até 30 de Julho de 1947, o vencimento de quaisquer obrigações   civis, comerciais e fiscais, a que estejam sujeitos os pecuaristas.", arquivo:"federal/leis-ordinarias/1946/lei-8-1946-12-19.md"}}, {id:"federal:BR:L:5/1946", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1946, data:"1946-12-14", numero:"5", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1946-12-14;5", vigente:true, titulo:"Lei nº 5 de 14/12/1946", urn:"urn:lex:br:federal:lei:1946-12-14;5", ementa:"Regula as eleições de 19 de janeiro de 1947.", arquivo:"federal/leis-ordinarias/1946/lei-5-1946-12-14.md"}}, {id:"federal:BR:L:12/1946", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1946, data:"1946-12-28", numero:"12", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1946-12-28;12", vigente:true, titulo:"Lei nº 12 de 28/12/1946", urn:"urn:lex:br:federal:lei:1946-12-28;12", ementa:"Autoriza a abrir, pelo Ministério das Relações Exteriores, o crédito especial de Cr$ 650.000,00 para as despesas com a representação do Brasil a posse dos Presidentes das Repúblicas do Chile e dos Estados Unidos Mexicanos.", arquivo:"federal/leis-ordinarias/1946/lei-12-1946-12-28.md"}}, {id:"federal:BR:L:2/1946", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1946, data:"1946-11-22", numero:"2", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1946-11-22;2", vigente:true, titulo:"Lei nº 2 de 22/11/1946", urn:"urn:lex:br:federal:lei:1946-11-22;2", ementa:"Dispõe sobre aprovação de estudantes expedicionários ou convocados em   virtude de estado de guerra.", arquivo:"federal/leis-ordinarias/1946/lei-2-1946-11-22.md"}}, {id:"federal:BR:L:3/1946", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1946, data:"1946-12-02", numero:"3", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1946-12-02;3", vigente:true, titulo:"Lei nº 3 de 02/12/1946", urn:"urn:lex:br:federal:lei:1946-12-02;3", ementa:"Orça a Receita e fixa a Despesa para o exercício de 1947.", arquivo:"federal/leis-ordinarias/1946/lei-3-1946-12-02.md"}}, {id:"federal:BR:L:7/1946", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1946, data:"1946-12-19", numero:"7", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1946-12-19;7", vigente:true, titulo:"Lei nº 7 de 19/12/1946", urn:"urn:lex:br:federal:lei:1946-12-19;7", ementa:"Disciplina o sistema de promoções nos cursos superiores.", arquivo:"federal/leis-ordinarias/1946/lei-7-1946-12-19.md"}}, {id:"federal:BR:L:1/1946", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1946, data:"1946-10-04", numero:"1", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1946-10-04;1", vigente:true, titulo:"Lei nº 1 de 04/10/1946", urn:"urn:lex:br:federal:lei:1946-10-04;1", ementa:"Autoriza a abertura, pelo Ministério da Agricultura, do crédito especial   de Cr$ 1.800.000,00 para despesas com o combate às nuvens de gafanhotos que   estão assolando várias regiões do sul do país.", arquivo:"federal/leis-ordinarias/1946/lei-1-1946-10-04.md"}}, {id:"federal:BR:L:10/1946", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1946, data:"1946-12-20", numero:"10", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1946-12-20;10", vigente:true, titulo:"Lei nº 10 de 20/12/1946", urn:"urn:lex:br:federal:lei:1946-12-20;10", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras   Públicas o crédito especial de Cr$ 11.000.000,00, para atender as despesas com o   prosseguimento da construção da Rodovia Ponta Grossa Foz do Iguaçu.", arquivo:"federal/leis-ordinarias/1946/lei-10-1946-12-20.md"}}, {id:"federal:BR:L:9/1946", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1946, data:"1946-12-20", numero:"9", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1946-12-20;9", vigente:true, titulo:"Lei nº 9 de 20/12/1946", urn:"urn:lex:br:federal:lei:1946-12-20;9", ementa:"Autoriza a abertura de crédito especial de Cr$ 7.000.000,00 para atender   as despesas com o prosseguimento da construção dos trechos ferroviários Campina   Grande-Soledade e Palmeira dos Índios-Colégio.", arquivo:"federal/leis-ordinarias/1946/lei-9-1946-12-20.md"}}, {id:"federal:BR:L:1250/1865", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1865, data:"1865-07-08", numero:"1250", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1865-07-08;1250", vigente:true, titulo:"Lei nº 1.250 de 08/07/1865", urn:"urn:lex:br:federal:lei:1865-07-08;1250", ementa:"FIXA FORÇA NAVAL PARA O ANNO FINANCEIRO DE 1866 A 1867.", arquivo:"federal/leis-ordinarias/1865/lei-1250-1865-07-08.md"}}, {id:"federal:BR:L:1252/1865", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1865, data:"1865-07-08", numero:"1252", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1865-07-08;1252", vigente:true, titulo:"Lei nº 1.252 de 08/07/1865", urn:"urn:lex:br:federal:lei:1865-07-08;1252", ementa:"APROVA O ARTIGO ADICIONAL AO CONTRATO DE MATRIMÔNIO DE SUA ALTEZA IMPERIAL A SENHORA DONA IZABEL CHRISTINA COM SUA ALTEZA REAL O SENHOR PRÍNCIPE LUIZ PHILIPPE MARIA, CONDE D'EU.", arquivo:"federal/leis-ordinarias/1865/lei-1252-1865-07-08.md"}}, {id:"federal:BR:L:1244/1865", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1865, data:"1865-06-26", numero:"1244", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1865-06-26;1244", vigente:true, titulo:"Lei nº 1.244 de 26/06/1865", urn:"urn:lex:br:federal:lei:1865-06-26;1244", ementa:"AUTORIZA O MINISTÉRIO DA FAZENDA A FAZER OPERAÇÕES DE CRÉDITO DENTRO OU FORA DO IMPÉRIO PARA DESPESAS EXTRAORDINÁRIAS DA MARINHA E GUERRA.", arquivo:"federal/leis-ordinarias/1865/lei-1244-1865-06-26.md"}}, {id:"federal:BR:L:1246/1865", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1865, data:"1865-06-28", numero:"1246", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1865-06-28;1246", vigente:true, titulo:"Lei nº 1.246 de 28/06/1865", urn:"urn:lex:br:federal:lei:1865-06-28;1246", ementa:"FIXA AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1866 A 1867.", arquivo:"federal/leis-ordinarias/1865/lei-1246-1865-06-28.md"}}, {id:"federal:BR:L:1243/1865", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1865, data:"1865-06-26", numero:"1243", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1865-06-26;1243", vigente:true, titulo:"Lei nº 1.243 de 26/06/1865", urn:"urn:lex:br:federal:lei:1865-06-26;1243", ementa:"APROVA OS DECRETOS QUE NA CONFORMIDADE DO ARTIGO 13 DA LEI 1.177 DE 9 DE SETEMBRO DE 1862, E EM VIRTUDE DA RESOLUÇÃO LEGISLATIVA 1.198 DE 16 DE ABRIL DE 1864, TRANSPORTARÃO QUANTIAS DE UMAS PARA OUTRAS RUBRICAS DA REFERIDA LEI, E ABRE AO GOVERNO UM CRÉDITO SUPLEMENTAR E EXTRAORDINARIO DE 12.517:525$110.", arquivo:"federal/leis-ordinarias/1865/lei-1243-1865-06-26.md"}}, {id:"federal:BR:L:1245/1865", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1865, data:"1865-06-28", numero:"1245", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1865-06-28;1245", vigente:true, titulo:"Lei nº 1.245 de 28/06/1865", urn:"urn:lex:br:federal:lei:1865-06-28;1245", ementa:"FIXA A DESPESA E ORÇA A RECEITA GERAL DO IMPÉRIO PARA O EXERCÍCIO DE 1865-1866, E DÁ OUTRAS PROVIDÊNCIAS.", arquivo:"federal/leis-ordinarias/1865/lei-1245-1865-06-28.md"}}, {id:"federal:BR:L:1253/1865", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1865, data:"1865-07-08", numero:"1253", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1865-07-08;1253", vigente:true, titulo:"Lei nº 1.253 de 08/07/1865", urn:"urn:lex:br:federal:lei:1865-07-08;1253", ementa:"APROVA AS DECLARAÇÕES FEITAS POR OCASIÃO DA TROCA DAS RATIFICAÇÕES DA CONVENÇÃO MATRIMONIAL DO 1 DE NOVEMBRO DE 1864, NA PARTE EM QUE O GOVERNO IMPERIAL SE OBRIGOU A CONFERIR A SUA ALTEZA O SENHOR PRINCIPE DUQUE DE SAXE O POSTO DE ALMIRANTE EFETIVO DA ARMADA.", arquivo:"federal/leis-ordinarias/1865/lei-1253-1865-07-08.md"}}, {id:"federal:BR:L:5870/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-03-26", numero:"5870", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-03-26;5870", vigente:true, titulo:"Lei nº 5.870 de 26/03/1973", urn:"urn:lex:br:federal:lei:1973-03-26;5870", ementa:"Acrescenta alínea ao artigo 26, da Lei nº ;4.771, de 15 de setembro de 1965, que institui o novo Código Florestal.", arquivo:"federal/leis-ordinarias/1973/lei-5870-1973-03-26.md"}}, {id:"federal:BR:L:5956/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-12-03", numero:"5956", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-12-03;5956", vigente:true, titulo:"Lei nº 5.956 de 03/12/1973", urn:"urn:lex:br:federal:lei:1973-12-03;5956", ementa:"Dispõe sobre o emprego de fibras em produtos têxteis.", arquivo:"federal/leis-ordinarias/1973/lei-5956-1973-12-03.md"}}, {id:"federal:BR:L:5901/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-07-09", numero:"5901", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-07-09;5901", vigente:true, titulo:"Lei nº 5.901 de 09/07/1973", urn:"urn:lex:br:federal:lei:1973-07-09;5901", ementa:"Fixa os valores de vencimentos dos cargos do Grupo-Direção e   Assessoramento Superiores, do Quadro Permanente da Câmara dos Deputados, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1973/lei-5901-1973-07-09.md"}}, {id:"federal:BR:L:5914/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-08-31", numero:"5914", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-08-31;5914", vigente:true, titulo:"Lei nº 5.914 de 31/08/1973", urn:"urn:lex:br:federal:lei:1973-08-31;5914", ementa:"Fixa os valores de vencimento dos cargos do Grupo-Artesanato, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1973/lei-5914-1973-08-31.md"}}, {id:"federal:BR:L:5874/1973", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-05-11", numero:"5874", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-05-11;5874", vigente:true, titulo:"Lei nº 5.874 de 11/05/1973", urn:"urn:lex:br:federal:lei:1973-05-11;5874", ementa:"Acrescenta parágrafos ao artigo 17, do Decreto-lei nº 1.038, de 21 de outubro de 1969, que \"estabelece normas relativas ao Imposto Único sobre Minerais, e dá outras providências\".", arquivo:"federal/leis-ordinarias/1973/lei-5874-1973-05-11.md"}}, {id:"federal:BR:L:5934/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-11-08", numero:"5934", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-11-08;5934", vigente:true, titulo:"Lei nº 5.934 de 08/11/1973", urn:"urn:lex:br:federal:lei:1973-11-08;5934", ementa:"Fixa os valores dos vencimentos dos cargos do Grupo-Direção e Assessoramento Superiores do Serviço Civil do Distrito Federal e dá outras providências.", arquivo:"federal/leis-ordinarias/1973/lei-5934-1973-11-08.md"}}, {id:"federal:BR:L:5958/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-12-10", numero:"5958", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-12-10;5958", vigente:true, titulo:"Lei nº 5.958 de 10/12/1973", urn:"urn:lex:br:federal:lei:1973-12-10;5958", ementa:"Dispõe sobre a retroatividade da opção pelo regime do Fundo de Garantia do   Tempo de Serviço, criado pela Lei nº 5.107, de 13 de setembro de   1966.", arquivo:"federal/leis-ordinarias/1973/lei-5958-1973-12-10.md"}}, {id:"federal:BR:L:5966/1973", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-12-11", numero:"5966", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-12-11;5966", vigente:true, titulo:"Lei nº 5.966 de 11/12/1973", urn:"urn:lex:br:federal:lei:1973-12-11;5966", ementa:"Institui o Sistema Nacional de Metrologia, Normalização e Qualidade Industrial, e dá outras providências.", arquivo:"federal/leis-ordinarias/1973/lei-5966-1973-12-11.md"}}, {id:"federal:BR:L:5925/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-10-01", numero:"5925", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-10-01;5925", vigente:true, titulo:"Lei nº 5.925 de 01/10/1973", urn:"urn:lex:br:federal:lei:1973-10-01;5925", ementa:"Retifica dispositivos da Lei nº 5.869, de 11 de janeiro de 1973, que instituiu o Código de Processo Civil.", arquivo:"federal/leis-ordinarias/1973/lei-5925-1973-10-01.md"}}, {id:"federal:BR:L:6014/1973", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-12-27", numero:"6014", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-12-27;6014", vigente:true, titulo:"Lei nº 6.014 de 27/12/1973", urn:"urn:lex:br:federal:lei:1973-12-27;6014", ementa:"Adapta ao novo Código de Processo Civil as leis que menciona.", arquivo:"federal/leis-ordinarias/1973/lei-6014-1973-12-27.md"}}, {id:"federal:BR:L:5879/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-05-23", numero:"5879", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-05-23;5879", vigente:true, titulo:"Lei nº 5.879 de 23/05/1973", urn:"urn:lex:br:federal:lei:1973-05-23;5879", ementa:"Fixa as normas para promoção de Juízes Presidentes de Junta de Conciliação e Julgamento e Juiz do Trabalho Substituto.", arquivo:"federal/leis-ordinarias/1973/lei-5879-1973-05-23.md"}}, {id:"federal:BR:L:5994/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-12-18", numero:"5994", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-12-18;5994", vigente:true, titulo:"Lei nº 5.994 de 18/12/1973", urn:"urn:lex:br:federal:lei:1973-12-18;5994", ementa:"Fixa os valores de vencimentos dos cargos do Grupo-Serviços Auxiliares do   Serviço Civil do Distrito Federal e dá outras providências.", arquivo:"federal/leis-ordinarias/1973/lei-5994-1973-12-18.md"}}, {id:"federal:BR:L:6004/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-12-19", numero:"6004", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-12-19;6004", vigente:true, titulo:"Lei nº 6.004 de 19/12/1973", urn:"urn:lex:br:federal:lei:1973-12-19;6004", ementa:"Fixa os valores de vencimentos dos cargos dos Grupos-Atividades de Apoio   Judiciário, Serviços Auxiliares, Serviços de Transporte Oficial e Portaria,   Artesanato, e Outras Atividades de Nível Superior, do Quadro Permanente da   Secretaria do Tribunal Superior do Trabalho, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1973/lei-6004-1973-12-19.md"}}, {id:"federal:BR:L:5948/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-11-29", numero:"5948", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-11-29;5948", vigente:true, titulo:"Lei nº 5.948 de 29/11/1973", urn:"urn:lex:br:federal:lei:1973-11-29;5948", ementa:"Dá nova redação às letras \"c\" e \"d\" do artigo 68, da Lei de Organização Judiciária Militar.", arquivo:"federal/leis-ordinarias/1973/lei-5948-1973-11-29.md"}}, {id:"federal:BR:L:5936/1973", properties:{esfera:"federal"