", ementa:"Tranforma funções do Grupo-Direção e Assistência Intermediárias em funções   de Direção Intermediária e dá outras providências.", arquivo:"federal/leis-ordinarias/1990/lei-8116-1990-12-13.md"}}, {id:"federal:BR:L:8052/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-06-20", numero:"8052", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-06-20;8052", vigente:true, titulo:"Lei nº 8.052 de 20/06/1990", urn:"urn:lex:br:federal:lei:1990-06-20;8052", ementa:"Altera a Lei nº 5.108, de 21 de setembro de 1966, que dispõe sobre o Código Nacional de Trânsito.", arquivo:"federal/leis-ordinarias/1990/lei-8052-1990-06-20.md"}}, {id:"federal:BR:L:8090/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-11-13", numero:"8090", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-11-13;8090", vigente:true, titulo:"Lei nº 8.090 de 13/11/1990", urn:"urn:lex:br:federal:lei:1990-11-13;8090", ementa:"Altera a estrutura básica da Secretaria da Ciência e Tecnologia da Presidência da República e dá outras providências.", arquivo:"federal/leis-ordinarias/1990/lei-8090-1990-11-13.md"}}, {id:"federal:BR:L:8014/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-04-06", numero:"8014", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-04-06;8014", vigente:true, titulo:"Lei nº 8.014 de 06/04/1990", urn:"urn:lex:br:federal:lei:1990-04-06;8014", ementa:"Dispõe sobre a tributação, pelo Imposto de Renda, dos ganhos líquidos obtidos em bolsas de valores, de mercadorias, de futuros e assemelhados.", arquivo:"federal/leis-ordinarias/1990/lei-8014-1990-04-06.md"}}, {id:"federal:BR:L:8071/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false"