}}, {id:"federal:BR:L:6759/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-12-17", numero:"6759", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-12-17;6759", vigente:true, titulo:"Lei nº 6.759 de 17/12/1979", urn:"urn:lex:br:federal:lei:1979-12-17;6759", ementa:"Autoriza a doação à Fundação Serviços de Saúde Pública do domínio útil do   terreno que menciona, situado na Cidade e Estado do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1979/lei-6759-1979-12-17.md"}}, {id:"federal:BR:L:6642/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-05-14", numero:"6642", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-05-14;6642", vigente:true, titulo:"Lei nº 6.642 de 14/05/1979", urn:"urn:lex:br:federal:lei:1979-05-14;6642", ementa:"Altera dispositivos da Lei n.º 4.769, de 9 de setembro de 1965, que dispõe sobre o exercício da profissão de Técnico de Administração.", arquivo:"federal/leis-ordinarias/1979/lei-6642-1979-05-14.md"}}, {id:"federal:BR:L:6735/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-12-04", numero:"6735", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-12-04;6735", vigente:true, titulo:"Lei nº 6.735 de 04/12/1979", urn:"urn:lex:br:federal:lei:1979-12-04;6735", ementa:"Renova o prazo de validade de carteira de identidade para estrangeiros.", arquivo:"federal/leis-ordinarias/1979/lei-6735-1979-12-04.md"}}, {id:"federal:BR:L:6687/1979", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-09-17", numero:"6687", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-09-17;6687", vigente:true, titulo:"Lei nº 6.687 de 17/09/1979", urn:"urn:lex:br:feder