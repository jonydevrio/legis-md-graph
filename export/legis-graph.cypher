vigencia_origem:"revogada=false", ano:1949, data:"1949-06-02", numero:"724", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-06-02;724", vigente:true, titulo:"Lei nº 724 de 02/06/1949", urn:"urn:lex:br:federal:lei:1949-06-02;724", ementa:"Concede isenção de direitos de importação para dois tratores destinados ao   Departamento Autônomo de Estradas de Rodagem do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1949/lei-724-1949-06-02.md"}}, {id:"federal:BR:L:907/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-10-31", numero:"907", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-10-31;907", vigente:true, titulo:"Lei nº 907 de 31/10/1949", urn:"urn:lex:br:federal:lei:1949-10-31;907", ementa:"Concede isenção de direitos de importação para volumes destinados ao   Convento N. S. da Piedade dos Capuchinhos da Bahia.", arquivo:"federal/leis-ordinarias/1949/lei-907-1949-10-31.md"}}, {id:"federal:BR:L:927/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-11-21", numero:"927", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-11-21;927", vigente:true, titulo:"Lei nº 927-A de 21/11/1949", urn:"urn:lex:br:federal:lei:1949-11-21;927", ementa:"Autoriza a abertura de crédito especial para contrução de prédio destinado   aos serviços postais e telegráficos de Maués, Amazonas.", arquivo:"federal/leis-ordinarias/1949/lei-927-1949-11-21.md"}}, {id:"federal:BR:L:777/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-08-08", numero:"777", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-08-08;777", vigente:true, titulo:"Lei nº 777 de 08/08/1949", urn:"urn:lex:br:federal:lei:1949-08-08;777", ementa:"Concede isenção de direitos de importação para material adquirido pelo   Governo do Estado de São Paulo para a Estrada de Ferro Sorocabana.", arquivo:"federal/leis-ordinarias/1949/lei-777-1949-08-08.md"}}, {id:"federal:BR:L:653/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-03-13", numero:"653", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-03-13;653", vigente:true, titulo:"Lei nº 653 de 13/03/1949", urn:"urn:lex:br:federal:lei:1949-03-13;653", ementa:"Concede auxílio de Cr$ 200.000,00, ao Hospital Regional de Friburgo, no   Estado do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1949/lei-653-1949-03-13.md"}}, {id:"federal:BR:L:1017/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-12-27", numero:"1017", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-12-27;1017", vigente:true, titulo:"Lei nº 1.017 de 27/12/1949", urn:"urn:lex:br:federal:lei:1949-12-27;1017", ementa:"Altera o Decreto-lei nº 7.197, de 27 de dezembro de 1944, que estabelece a classificação comercial de lã de ovinos, e dispõe sobre o comércio dessa matéria-prima.", arquivo:"federal/leis-ordinarias/1949/lei-1017-1949-12-27.md"}}, {id:"federal:BR:L:925/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-11-21", numero:"925", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-11-21;925", vigente:true, titulo:"Lei nº 925 de 21/11/1949", urn:"urn:lex:br:federal:lei:1949-11-21;925", ementa:"Concede isenção de direitos de importação para material adquirido pela   Sociedade Importadora Suissa Limitada.", arquivo:"federal/leis-ordinarias/1949/lei-925-1949-11-21.md"}}, {id:"federal:BR:L:630/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-02-24", numero:"630", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-02-24;630", vigente:true, titulo:"Lei nº 630 de 24/02/1949", urn:"urn:lex:br:federal:lei:1949-02-24;630", ementa:"Concede isenção de direitos de importação e taxas aduaneiras a toda   empresa ou firma individual que adquirir navio para a indústria do pescado.", arquivo:"federal/leis-ordinarias/1949/lei-630-1949-02-24.md"}}, {id:"federal:BR:L:966/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-12-09", numero:"966", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-12-09;966", vigente:true, titulo:"Lei nº 966 de 09/12/1949", urn:"urn:lex:br:federal:lei:1949-12-09;966", ementa:"Reorganiza os cartórios das Auditorias Militares e dá outras   providências.", arquivo:"federal/leis-ordinarias/1949/lei-966-1949-12-09.md"}}, {id:"federal:BR:L:816/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-09-09", numero:"816", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-09-09;816", vigente:true, titulo:"Lei nº 816 de 09/09/1949", urn:"urn:lex:br:federal:lei:1949-09-09;816", ementa:"Dá nova redação aos arts. 132 e 134 do Decreto-lei nº 5.452 de, 1º de maio de 1943.", arquivo:"federal/leis-ordinarias/1949/lei-816-1949-09-09.md"}}, {id:"federal:BR:L:616/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-02-02", numero:"616", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-02-02;616", vigente:true, titulo:"Lei nº 616 de 02/02/1949", urn:"urn:lex:br:federal:lei:1949-02-02;616", ementa:"Altera os artigos 1º e 6º da Lei n. 288 de 8 de julho de 1948, que concede vantagens a militares e civis que participaram de operações de guerra.", arquivo:"federal/leis-ordinarias/1949/lei-616-1949-02-02.md"}}, {id:"federal:BR:L:617/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-02-10", numero:"617", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-02-10;617", vigente:true, titulo:"Lei nº 617 de 10/02/1949", urn:"urn:lex:br:federal:lei:1949-02-10;617", ementa:"Modifica os artigos 4º e 5º do Decreto-Lei n. 5576, de 14 de junho de   1943.", arquivo:"federal/leis-ordinarias/1949/lei-617-1949-02-10.md"}}, {id:"federal:BR:L:969/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-12-15", numero:"969", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-12-15;969-a", vigente:true, titulo:"Lei nº 969-A de 15/12/1949", urn:"urn:lex:br:federal:lei:1949-12-15;969-a", ementa:"Dispõe sobre o pessoal da Comissão Mista Ferroviária   Brasileiro-Boliviana.", arquivo:"federal/leis-ordinarias/1949/lei-969-a-1949-12-15.md"}}, {id:"federal:BR:L:696/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-05-07", numero:"696", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-05-07;696", vigente:true, titulo:"Lei nº 696 de 07/05/1949", urn:"urn:lex:br:federal:lei:1949-05-07;696", ementa:"Autoriza a abertura de crédito especial para custear as despesas de viagem   e de tratamento no estrangeiro, do Prof. Dr. Coriolano Pereira José da   Silva.", arquivo:"federal/leis-ordinarias/1949/lei-696-1949-05-07.md"}}, {id:"federal:BR:L:779/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-08-11", numero:"779", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-08-11;779", vigente:true, titulo:"Lei nº 779 de 11/08/1949", urn:"urn:lex:br:federal:lei:1949-08-11;779", ementa:"Dispõe sobre a participação do Brasil na exposição retrospectiva   concernente à Vida de Santos-Dumont.", arquivo:"federal/leis-ordinarias/1949/lei-779-1949-08-11.md"}}] AS row
