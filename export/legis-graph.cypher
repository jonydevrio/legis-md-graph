10-01.md"}}, {id:"federal:BR:L:5988/1973", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-12-14", numero:"5988", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-12-14;5988", vigente:true, titulo:"Lei nº 5.988 de 14/12/1973", urn:"urn:lex:br:federal:lei:1973-12-14;5988", ementa:"Regula os direitos autorais e dá outras providências.", arquivo:"federal/leis-ordinarias/1973/lei-5988-1973-12-14.md"}}, {id:"federal:BR:L:5947/1973", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-11-29", numero:"5947", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-11-29;5947", vigente:true, titulo:"Lei nº 5.947 de 29/11/1973", urn:"urn:lex:br:federal:lei:1973-11-29;5947", ementa:"Fixa os valores de vencimentos dos cargos do Grupo - Direção e Assessoramento Superiores do Quadro Permanente da Secretaria Geral do Tribunal de Contas da União e dá outras providências.", arquivo:"federal/leis-ordinarias/1973/lei-5947-1973-11-29.md"}}, {id:"federal:BR:L:5940/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-11-20", numero:"5940", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-11-20;5940", vigente:true, titulo:"Lei nº 5.940 de 20/11/1973", urn:"urn:lex:br:federal:lei:1973-11-20;5940", ementa:"Autoriza o Instituto Nacional de Previdência Social a doar terreno de sua   propriedade à Cruzada São Sebastião, e dá outras providências.", arquivo:"federal/leis-ordinarias/1973/lei-5940-1973-11-20.md"}}, {id:"federal:BR:L:6003/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-12-19", numero:"6003", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-12-19;6003", vigente:true, titulo:"Lei nº 6.003 de 19/12/1973", urn:"urn:lex:br:federal:lei:1973-12-19;6003", ementa:"Fixa os valores dos níveis de vencimentos do Grupo-Direção e   Assessoramento Superiores do Quadro Permanente da Secretaria do Tribunal   Superior do Trabalho e dá outras providências.", arquivo:"federal/leis-ordinarias/1973/lei-6003-1973-12-19.md"}}, {id:"federal:BR:L:5913/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-08-31", numero:"5913", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-08-31;5913", vigente:true, titulo:"Lei nº 5.913 de 31/08/1973", urn:"urn:lex:br:federal:lei:1973-08-31;5913", ementa:"Autoriza a reversão de terreno situado no Município de Pirapora, Estado de   Minas Gerais, à propriedade de Clara Batista de Oliveira.", arquivo:"federal/leis-ordinarias/1973/lei-5913-1973-08-31.md"}}, {id:"federal:BR:L:5872/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-05-03", numero:"5872", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-05-03;5872", vigente:true, titulo:"Lei nº 5.872 de 03/05/1973", urn:"urn:lex:br:federal:lei:1973-05-03;5872", ementa:"Concede aumento de vencimentos aos servidores do Senado Federal, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1973/lei-5872-1973-05-03.md"}}, {id:"federal:BR:L:5933/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-11-08", numero:"5933", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-11-08;5933", vigente:true, titulo:"Lei nº 5.933 de 08/11/1973", urn:"urn:lex:br:federal:lei:1973-11-08;5933", ementa:"Concede pensão especial à Senhora Efigênia Xavier Dornas, viúva do   escritor João Dornas Filho.", arquivo:"federal/leis-ordinarias/1973/lei-5933-1973-11-08.md"}}, {id:"federal:BR:L:5974/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-12-11", numero:"5974", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-12-11;5974", vigente:true, titulo:"Lei nº 5.974 de 11/12/1973", urn:"urn:lex:br:federal:lei:1973-12-11;5974", ementa:"Dispõe sobre a competência criminal para o processo e julgamento dos   membros do Ministério Público da União.", arquivo:"federal/leis-ordinarias/1973/lei-5974-1973-12-11.md"}}, {id:"federal:BR:L:5982/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-12-12", numero:"5982", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-12-12;5982", vigente:true, titulo:"Lei nº 5.982 de 12/12/1973", urn:"urn:lex:br:federal:lei:1973-12-12;5982", ementa:"Concede pensão especial a Madalena Maria Yvonne Tagliaferro.", arquivo:"federal/leis-ordinarias/1973/lei-5982-1973-12-12.md"}}, {id:"federal:BR:L:5955/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-12-03", numero:"5955", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-12-03;5955", vigente:true, titulo:"Lei nº 5.955 de 03/12/1973", urn:"urn:lex:br:federal:lei:1973-12-03;5955", ementa:"Autoriza o Poder Executivo a abrir à Justiça do Trabalho, em favor do   Tribunal Regional do Trabalho da 6º Região, o crédito especial de Cr$   500.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/1973/lei-5955-1973-12-03.md"}}, {id:"federal:BR:L:5900/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1973, data:"1973-07-09", numero:"5900", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1973-07-09;5900", vigente:true, titulo:"Lei nº 5.900 de 09/07/1973", urn:"urn:lex:br:federal:lei:1973-07-09;5900", ementa:"Fixa os valores de vencimentos dos cargos do Grupo-Direção e   Assessoramento Superiores, do Quadro Permanente do Senado Federal, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1973/lei-5900-1973-07-09.md"}}, {id:"federal:BR:L:112/1892", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1892, data:"1892-10-20", numero:"112", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1892-10-20;112", vigente:true, titulo:"Lei nº 112 de 20/10/1892", urn:"urn:lex:br:federal:lei:1892-10-20;112", ementa:"Autorisa a transferencia para as armas de infantaria e cavallaria dos 1ºs e 2ºs tenentes de artilharia que, por falta de habilitações scientificas, não possam ter accesso, passando daquellas armas para esta numero correspondente de officiaes com o respectivo curso.", arquivo:"federal/leis-ordinarias/1892/lei-112-1892-10-20.md"}}, {id:"federal:BR:L:54/1892", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1892, data:"1892-06-13", numero:"54", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1892-06-13;54", vigente:true, titulo:"Lei nº 54 de 13/06/1892", urn:"urn:lex:br:federal:lei:1892-06-13;54", ementa:"Autorisa a reorganização das diversas repartições dos   Ministerios da Guerra e da Marinha, da arma de engenharia e dos corpos de   engenheiros e de estado-maior de 1ª classe e artilharia, e dá outras   providencias.", arquivo:"federal/leis-ordinarias/1892/lei-54-1892-06-13.md"}}, {id:"federal:BR:L:35/1892", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1892, data:"1892-01-26", numero:"35", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1892-01-26;35", vigente:true, titulo:"Lei nº 35 de 26/01/1892", urn:"urn:lex:br:federal:lei:1892-01-26;35", ementa:"Estabelece o processo para as eleições federais,", arquivo:"federal/leis-ordinarias/1892/lei-35-1892-01-26.md"}}, {id:"federal:BR:L:48/1892", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1892, data:"1892-06-07", numero:"48", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1892-06-07;48", vigente:true, titulo:"Lei nº 48 de 07/06/1892", urn:"urn:lex:br:federal:lei:1892-06-07;48", ementa:"Innova o contracto da The Ceará Harbour Corporation,   limited, eleva o seu capital a 4.874:000$ com garantia de juros por 25 annos, e   autorisa a prorogação de prazo para conclusão das respectivas obras.", arquivo:"federal/leis-ordinarias/1892/lei-48-1892-06-07.md"}}, {id:"federal:BR:L:80/1892", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1892, data:"1892-08-27", numero:"80", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1892-08-27;80", vigente:true, titulo:"Lei nº 80 de 27/08/1892", urn:"urn:lex:br:federal:lei:1892-08-27;80", ementa:"Fixa, as forças de terra para o exercicio de 1893.", arquivo:"federal/leis-ordinarias/1892/lei-80-1892-08-27.md"}}, {id:"federal:BR:L:126/1892", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1892, data:"1892-11-21", numero:"126", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1892-11-21;126-a", vigente:true, titulo:"Lei nº 126-A de 21/11/1892", urn:"urn:lex:br:federal:lei:1892-11-21;126-a", ementa:"Orça a receita geral da Republica dos Estados Unidos do Brazil para o   exercicio de 1893, e dá outras providencias.", arquivo:"federal/leis-ordinarias/1892/lei-126-a-1892-11-21.md"}}, {id:"federal:BR:L:69/1892", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1892, data:"1892-08-01", numero:"69", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1892-08-01;69", vigente:true, titulo:"Lei nº 69 de 01/08/1892", urn:"urn:lex:br:federal:lei:1892-08-01;69", ementa:"Altera as disposições do art. 3º da lei n. 35 de 26 de   janeiro de 1892.", arquivo:"federal/leis-ordinarias/1892/lei-69-1892-08-01.md"}}, {id:"federal:BR:L:85/1892", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1892, data:"1892-09-20", numero:"85", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1892-09-20;85", vigente:true, titulo:"Lei nº 85 de 20/09/1892", urn:"urn:lex:br:federal:lei:1892-09-20;85", ementa:"Estabelece a organização municipal do Districto Federal.", arquivo:"federal/leis-ordinarias/1892/lei-85-1892-09-20.md"}}, {id:"federal:BR:L:76/1892", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1892, data:"1892-08-16", numero:"76", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1892-08-16;76", vigente:true, titulo:"Lei nº 76 de 16/08/1892", urn:"urn:lex:br:federal:lei:1892-08-16;76", ementa:"Reorganiza o serviço policial do Districto Federal.", arquivo:"federal/leis-ordinarias/1892/lei-76-1892-08-16.md"}}, {id:"federal:BR:L:97/1892", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1892, data:"1892-10-05", numero:"97", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1892-10-05;97", vigente:true, titulo:"Lei nº 97 de 05/10/1892", urn:"urn:lex:br:federal:lei:1892-10-05;97", ementa:"Permitte livre entrada no territorio da Republica de immigrantes de   nacionalidade chineza e japoneza; autorisa o Governo a promover a execução do   tratado de 5 de setembro de 1890 com a China; a celebrar tratado de commercio,   paz e amizade com o Japão, e dá outras providencias attinentes á immigração   daquellas procedencias.", arquivo:"federal/leis-ordinarias/1892/lei-97-1892-10-05.md"}}, {id:"federal:BR:L:42/1892", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1892, data:"1892-06-02", numero:"42", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1892-06-02;42", vigente:true, titulo:"Lei nº 42 de 02/06/1892", urn:"urn:lex:br:federal:lei:1892-06-02;42", ementa:"Garante os direitos já adquiridos por empregados vitalicios e aposentados.", arquivo:"federal/leis-ordinarias/1892/lei-42-1892-06-02.md"}}, {id:"federal:BR:L:39/1892", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1892, data:"1892-01-30", numero:"39", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1892-01-30;39-a", vigente:true, titulo:"Lei nº 39-A de 30/01/1892", urn:"urn:lex:br:federal:lei:1892-01-30;39-a", ementa:"Fixa as forças de terra para o exercicio de 1892.", arquivo:"federal/leis-ordinarias/1892/lei-39-a-1892-01-30.md"}}, {id:"federal:BR:L:570/1937", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-11-01", numero:"570", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-11-01;570", vigente:true, titulo:"Lei nº 570 de 01/11/1937", urn:"urn:lex:br:federal:lei:1937-11-01;570", ementa:"Autoriza a abrir, pelo Ministério da Justiça, o crédito especial de   150:000$, destinado ao pagamento das despesas autorizadas para a realização do   1º Congresso Nacional de Direito Judiciário.", arquivo:"federal/leis-ordinarias/1937/lei-570-1937-11-01.md"}}, {id:"federal:BR:L:414/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-04-02", numero:"414", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-04-02;414", vigente:true, titulo:"Lei nº 414 de 02/04/1937", urn:"urn:lex:br:federal:lei:1937-04-02;414", ementa:"Autoriza o Poder Executivo a abrir o crédito especial de réis 500:000$000   pelo Ministério do Trabalho, para atender às despesas com a representação do   Brasil na Exposição Internacional de Paris de 1937 - Arte e Técnica na Vida   Moderna", arquivo:"federal/leis-ordinarias/1937/lei-414-1937-04-02.md"}}, {id:"federal:BR:L:370/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-01-04", numero:"370", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-01-04;370", vigente:true, titulo:"Lei nº 370 de 04/01/1937", urn:"urn:lex:br:federal:lei:1937-01-04;370", ementa:"Dispõe sobre o dinheiro e objectos de valor depositados nos estabelecimentos   bancarios e commerciaes.", arquivo:"federal/leis-ordinarias/1937/lei-370-1937-01-04.md"}}, {id:"federal:BR:L:438/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-05-29", numero:"438", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-05-29;438", vigente:true, titulo:"Lei nº 438 de 29/05/1937", urn:"urn:lex:br:federal:lei:1937-05-29;438", ementa:"Autoriza o Poder Executivo a conceder ao Estado de Alagôas um auxílio até   3.000:000$, para atender à situação de calamidade em que se encontra", arquivo:"federal/leis-ordinarias/1937/lei-438-1937-05-29.md"}}, {id:"federal:BR:L:516/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-09-28", numero:"516", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-09-28;516", vigente:true, titulo:"Lei nº 516 de 28/09/1937", urn:"urn:lex:br:federal:lei:1937-09-28;516", ementa:"Autoriza o Poder Executivo a dar a necessária garantia, por intermédio do   Tesouro Nacional, a uma operação de crédito até a importância de 5.000:000$000   entre o Estado do Piauí e o Banco do Brasil para a conclusão das obras de   abastecimento de água a Terezina.", arquivo:"federal/leis-ordinarias/1937/lei-516-1937-09-28.md"}}, {id:"federal:BR:L:413/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-03-31", numero:"413", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-03-31;413", vigente:true, titulo:"Lei nº 413 de 31/03/1937", urn:"urn:lex:br:federal:lei:1937-03-31;413", ementa:"Autoriza o Poder Executivo a abrir o crédito especial de 362:116$500, para   pagamento de gratificação adicional devida aos desembargadores da Corte de   Apelação do Distrito Federal, Elviro Carrilho da Fonseca e Silvo, José Ovidio   Marcondes Romero e José Antônio de Soare Gomes.", arquivo:"federal/leis-ordinarias/1937/lei-413-1937-03-31.md"}}, {id:"federal:BR:L:500/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-09-10", numero:"500", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-09-10;500", vigente:true, titulo:"Lei nº 500 de 10/09/1937", urn:"urn:lex:br:federal:lei:1937-09-10;500", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o   crédito especial de 17:000$000 para atender no pagamento devido à firma S.   Fragelli &amp; Comp. Ltda", arquivo:"federal/leis-ordinarias/1937/lei-500-1937-09-10.md"}}, {id:"federal:BR:L:578/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-11-09", numero:"578", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-11-09;578", vigente:true, titulo:"Lei nº 578 de 09/11/1937", urn:"urn:lex:br:federal:lei:1937-11-09;578", ementa:"Autoriza o Poder Executivo a pagar à Associação Maternal da Policlínica de   Botafogo a subvenção relativa ao ano de 1936", arquivo:"federal/leis-ordinarias/1937/lei-578-1937-11-09.md"}}, {id:"federal:BR:L:458/1937", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-07-16", numero:"458", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-07-16;458", vigente:true, titulo:"Lei nº 458 de 16/07/1937", urn:"urn:lex:br:federal:lei:1937-07-16;458", ementa:"Inclue na Comissão Executiva do Instituto do Açúçar e do Álcool   representantes dos plantadores de cana e de usineiros", arquivo:"federal/leis-ordinarias/1937/lei-458-1937-07-16.md"}}, {id:"federal:BR:L:410/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-03-25", numero:"410", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-03-25;410", vigente:true, titulo:"Lei nº 410 de 25/03/1937", urn:"urn:lex:br:federal:lei:1937-03-25;410", ementa:"Autoriza a alienação de 54 hectares do próprio federal onde funciona a   Inspetoria Regional do Serviço de Defesa Sanitária Animal, em Belo Horizonte, do   Departamento Nacional da Produção Animal do Ministério da Agricultura", arquivo:"federal/leis-ordinarias/1937/lei-410-1937-03-25.md"}}, {id:"federal:BR:L:498/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-09-09", numero:"498", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-09-09;498", vigente:true, titulo:"Lei nº 498 de 09/09/1937", urn:"urn:lex:br:federal:lei:1937-09-09;498", ementa:"Autoriza o Poder Executivo a adquirir, pelo Ministério da Guerra, um terreno   contíguo ao Quartel do 9º Regimento de Cavalaria, na cidade de São Gabriel,   Estado do Rio Grande do Sul", arquivo:"federal/leis-ordinarias/1937/lei-498-1937-09-09.md"}}, {id:"federal:BR:L:546/1937", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-10-16", numero:"546", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-10-16;546", vigente:true, titulo:"Lei nº 546 de 16/10/1937", urn:"urn:lex:br:federal:lei:1937-10-16;546", ementa:"Autoriza o Poder Executivo a crear uma Legação Autônoma na América   Central.", arquivo:"federal/leis-ordinarias/1937/lei-546-1937-10-16.md"}}, {id:"federal:BR:L:397/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-02-20", numero:"397", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-02-20;397", vigente:true, titulo:"Lei nº 397 de 20/02/1937", urn:"urn:lex:br:federal:lei:1937-02-20;397", ementa:"Autoriza a abertura, pelo Ministerio da Guerra, do credito especial de   2.750:000$00, para serviços industriaes do Exercito.", arquivo:"federal/leis-ordinarias/1937/lei-397-1937-02-20.md"}}, {id:"federal:BR:L:381/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-01-19", numero:"381", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-01-19;381", vigente:true, titulo:"Lei nº 381 de 19/01/1937", urn:"urn:lex:br:federal:lei:1937-01-19;381", ementa:"Autoriza o Poder Executivo a dispender a importância de 300:000$000, no   combate ao surto de impaludismo, com caracter epidêmico, irrompido em vários   municípios do Estado do Amazonas.", arquivo:"federal/leis-ordinarias/1937/lei-381-1937-01-19.md"}}, {id:"federal:BR:L:561/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-10-28", numero:"561", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-10-28;561", vigente:true, titulo:"Lei nº 561 de 28/10/1937", urn:"urn:lex:br:federal:lei:1937-10-28;561", ementa:"Autoriza a erigir na cidade de Bagé, no Rio Grande do Sul, a estátua de   Gaspar Silveira Martins", arquivo:"federal/leis-ordinarias/1937/lei-561-1937-10-28.md"}}, {id:"federal:BR:L:369/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-01-04", numero:"369", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-01-04;369", vigente:true, titulo:"Lei nº 369 de 04/01/1937", urn:"urn:lex:br:federal:lei:1937-01-04;369", ementa:"Autoriza o Poder Executivo a abrir o credito especial de 2.000:000$000, para   pagamento de remuneração devida ao pessoal contractado.", arquivo:"federal/leis-ordinarias/1937/lei-369-1937-01-04.md"}}, {id:"federal:BR:L:511/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-09-25", numero:"511", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-09-25;511", vigente:true, titulo:"Lei nº 511 de 25/09/1937", urn:"urn:lex:br:federal:lei:1937-09-25;511", ementa:"Autoriza a criação de um aprendizado agrícola no Estado do   Amazonas.", arquivo:"federal/leis-ordinarias/1937/lei-511-1937-09-25.md"}}, {id:"federal:BR:L:375/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-01-07", numero:"375", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-01-07;375", vigente:true, titulo:"Lei nº 375 de 07/01/1937", urn:"urn:lex:br:federal:lei:1937-01-07;375", ementa:"Approva o convenio celebrado entre os Estados de São Paulo e Minas Geraes,   sobre limites.", arquivo:"federal/leis-ordinarias/1937/lei-375-1937-01-07.md"}}, {id:"federal:BR:L:417/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-04-07", numero:"417", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-04-07;417", vigente:true, titulo:"Lei nº 417 de 07/04/1937", urn:"urn:lex:br:federal:lei:1937-04-07;417", ementa:"Autoriza o Poder Executivo a celebrar novos contratos em concorrência   pública para manutenção dos serviços das linhas aéreas de São Paulo-Cuiabá e   Belém-Manaus.", arquivo:"federal/leis-ordinarias/1937/lei-417-1937-04-07.md"}}, {id:"federal:BR:L:462/1937", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-07-22", numero:"462", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-07-22;462", vigente:true, titulo:"Lei nº 462 de 22/07/1937", urn:"urn:lex:br:federal:lei:1937-07-22;462", ementa:"Autoriza o Poder Executivo a abrir o crédito suplementar de réis   7.380:000$000, para ocorrer ao pagamento de subsídio aos Deputados no período de   1 de julho a 3 de novembro de 1937, e a Câmara dos Deputados a fazer despesas   com os seus serviços", arquivo:"federal/leis-ordinarias/1937/lei-462-1937-07-22.md"}}, {id:"federal:BR:L:378/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-01-13", numero:"378", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-01-13;378", vigente:true, titulo:"Lei nº 378 de 13/01/1937", urn:"urn:lex:br:federal:lei:1937-01-13;378", ementa:"Dá nova organização ao Ministério da educação e Saúde Pública.", arquivo:"federal/leis-ordinarias/1937/lei-378-1937-01-13.md"}}, {id:"federal:BR:L:407/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-03-18", numero:"407", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-03-18;407", vigente:true, titulo:"Lei nº 407 de 18/03/1937", urn:"urn:lex:br:federal:lei:1937-03-18;407", ementa:"Autoriza o Poder Executivo a abrir o credito de 4:950$ para pagamento de   diferença de vencimentos do Procurador Regional Eleitoral do Estado do Rio de   Janeiro", arquivo:"federal/leis-ordinarias/1937/lei-407-1937-03-18.md"}}, {id:"federal:BR:L:393/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-02-15", numero:"393", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-02-15;393", vigente:true, titulo:"Lei nº 393 de 15/02/1937", urn:"urn:lex:br:federal:lei:1937-02-15;393", ementa:"Autoriza a abrir pelo Ministério da Viação e Obras Publicas, o credito   especial de 3.000:000$000, para attender a despesas decorrentes das últimas   chuvas no Estado de Pernambuco", arquivo:"federal/leis-ordinarias/1937/lei-393-1937-02-15.md"}}, {id:"federal:BR:L:452/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-07-05", numero:"452", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-07-05;452", titulo:"Lei nº 452 de 05/07/1937", vigente:true, urn:"urn:lex:br:federal:lei:1937-07-05;452", ementa:"Organiza a Universidade do Brasil.", arquivo:"federal/leis-ordinarias/1937/lei-452-1937-07-05.md"}}, {id:"federal:BR:L:536/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-10-08", numero:"536", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-10-08;536", vigente:true, titulo:"Lei nº 536 de 08/10/1937", urn:"urn:lex:br:federal:lei:1937-10-08;536", ementa:"Autoriza o Poder Executivo a entrar em acôrdo com o govêrno do Estado do   Rio de Janeiro, para erguer, em Niterói, um monumento em homenagem à memória de   Benjamin Constant Botelho de Magalhães", arquivo:"federal/leis-ordinarias/1937/lei-536-1937-10-08.md"}}, {id:"federal:BR:L:426/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-04-16", numero:"426", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-04-16;426", vigente:true, titulo:"Lei nº 426 de 16/04/1937", urn:"urn:lex:br:federal:lei:1937-04-16;426", ementa:"Substitue as carreiras de engenheiro e oficial administrativo do quadro do   pessoal da Viação Férrea. Federal Leste Brasileiro", arquivo:"federal/leis-ordinarias/1937/lei-426-1937-04-16.md"}}, {id:"federal:BR:L:436/1937", properties:{esfera: