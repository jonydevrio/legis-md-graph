l/leis-ordinarias/1963/lei-4309-1963-12-23.md"}}, {id:"federal:BR:L:4260/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-09-12", numero:"4260", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-09-12;4260", vigente:true, titulo:"Lei nº 4.260 de 12/09/1963", urn:"urn:lex:br:federal:lei:1963-09-12;4260", ementa:"Concede a pensão especial de Cr$ 10.000,00 mensais a Albertina de Viveiro Marques, viúva do ex-Deputado Gerson Corrêa Marques.", arquivo:"federal/leis-ordinarias/1963/lei-4260-1963-09-12.md"}}, {id:"federal:BR:L:4293/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-12", numero:"4293", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-12;4293", vigente:true, titulo:"Lei nº 4.293 de 12/12/1963", urn:"urn:lex:br:federal:lei:1963-12-12;4293", ementa:"Abre ao Poder Legislativo - Câmara dos Deputados - o crédito especial de Cr$ 40.000.000,00 (quarenta milhões milhões de cruzeiros) para atender a despesas que especifica.", arquivo:"federal/leis-ordinarias/1963/lei-4293-1963-12-12.md"}}, {id:"federal:BR:L:4245/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-07-20", numero:"4245", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-07-20;4245", vigente:true, titulo:"Lei nº 4.245 de 20/07/1963", urn:"urn:lex:br:federal:lei:1963-07-20;4245", ementa:"Isenta de imposto aduaneiro e taxas, inclusive do imposto de consumo, os materiais importados pela Companhia Municipal de Transportes Coletivos, apartir do ano de 1958.", arquivo:"federal/leis-ordinarias/1963/lei-4245-1963-07-20.md"}}, {id:"federal:BR:L:4275/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-11-04", numero:"4275", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-11-04;4275", vigente:true, titulo:"Lei nº 4.275 de 04/11/1963", urn:"urn:lex:br:federal:lei:1963-11-04;4275", ementa:"Concede auxílios financeiros ao colégio Irmãos Maristas e à União Sul-Brasileirra da Igreja Adventista do Sétimo Dia, em Brasília, e dá outras providências.", arquivo:"federal/leis-ordinarias/1963/lei-4275-1963-11-04.md"}}, {id:"federal:BR:L:4314/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-23", numero:"4314", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-23;4314", vigente:true, titulo:"Lei nº 4.314 de 23/12/1963", urn:"urn:lex:br:federal:lei:1963-12-23;4314", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 200.000.000,00 (duzentos milhões de cruzeiros), a fim de atender às populações do Médio Superior do São Francisco, no Estado de Minas Gerais, atingidas por inundações.", arquivo:"federal/leis-ordinarias/1963/lei-4314-1963-12-23.md"}}, {id:"federal:BR:L:4205/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-02-07", numero:"4205", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-02-07;4205", vigente:true, titulo:"Lei nº 4.205 de 07/02/1963", urn:"urn:lex:br:federal:lei:1963-02-07;4205", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura, o crédito especial de Cr$ 5.000.000,00, para ocorrer às despesas com a relização, em setembro de 1960, na Capital do Estado de São Paulo, do I Congresso Latino Americano, II Internacional e I Brasileiro de Proctologia.", arquivo:"federal/leis-ordinarias/1963/lei-4205-1963-02-07.md"}}, {id:"federal:BR:L:4264/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-10-03", numero:"4264", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-10-03;4264", vigente:true, titulo:"Lei nº 4.264 de 03/10/1963", urn:"urn:lex:br:federal:lei:1963-10-03;4264", ementa:"Concede auxílios especiais ao Colégio Salesiano Santa Rosa e a Escola Industrial Dom Bosco, de Niterói; à Escola Salesiana Dom Bosco, de Fortaleza; ao Colégio Salesiano Nossa Senhora da Vitória, de Vitória, ao Ginásio Arquidiocesano, de Teresina; e dá outras providências.", arquivo:"federal/leis-ordinarias/1963/lei-4264-1963-10-03.md"}}, {id:"federal:BR:L:4305/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-23", numero:"4305", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-23;4305", vigente:true, titulo:"Lei nº 4.305 de 23/12/1963", urn:"urn:lex:br:federal:lei:1963-12-23;4305", ementa:"Institui normas especiais para aplicação de créditos orçamentários e adicionais destinados aos programas e projetos vinculados ao Ponto IV, do Governo dos Estados Unidos da América do Norte.", arquivo:"federal/leis-ordinarias/1963/lei-4305-1963-12-23.md"}}, {id:"federal:BR:L:4282/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-11-11", numero:"4282", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-11-11;4282", vigente:true, titulo:"Lei nº 4.282 de 11/11/1963", urn:"urn:lex:br:federal:lei:1963-11-11;4282", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras Públicas, o crédito especial de Cr$ 28.270.000.000,00 destinado a atender às despesas com as obras complementares da Rodovia Rio-Bahia (BR-4) .", arquivo:"federal/leis-ordinarias/1963/lei-4282-1963-11-11.md"}}, {id:"federal:BR:L:4251/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-08-08", numero:"4251", fonte:"https://normas.l