:lex:br:federal:lei:1975-09-18;6237", ementa:"Dá a denominação de \"Refinaria Presidente Getúlio Vargas\" à refinaria de   petróleo a ser instalada pela Petrobrás S.A., no município de Araucária, Estado   do Paraná.", arquivo:"federal/leis-ordinarias/1975/lei-6237-1975-09-18.md"}}, {id:"federal:BR:L:6247/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-10-08", numero:"6247", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-10-08;6247", vigente:true, titulo:"Lei nº 6.247 de 08/10/1975", urn:"urn:lex:br:federal:lei:1975-10-08;6247", ementa:"Autoriza o Poder Executivo a abrir à Justiça Federal da 1ª Instância   crédito especial de Cr$ 2.080.000,00 (dois milhões e oitenta mil   cruzeiros).", arquivo:"federal/leis-ordinarias/1975/lei-6247-1975-10-08.md"}}, {id:"federal:BR:L:6292/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-12-15", numero:"6292", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-12-15;6292", vigente:true, titulo:"Lei nº 6.292 de 15/12/1975", urn:"urn:lex:br:federal:lei:1975-12-15;6292", ementa:"Dispõe sobre o tombamento de bens no Instituto do Patrimônio Histórico e   Artístico Nacional (IPHAN).", arquivo:"federal/leis-ordinarias/1975/lei-6292-1975-12-15.md"}}, {id:"federal:BR:L:6205/1975", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-04-29", numero:"6205", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-04-29;6205", vigente:true, titulo:"Lei nº 6.205 de 29/04/1975", urn:"urn:lex:br:federal:lei:1975-04-29;6205", ementa:"Estabelece a descaracterização do salário mínimo como fator de correção monetária e acrescenta parágrafo único ao artigo 1º da Lei número 6.147, de 29 de novembro de 1974.", arquivo:"federal/leis-ordinarias/1975/lei-6205-1975-04-29.md"}}, {id:"federal:BR:L:6287/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-12-11", numero:"6287", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-12-11;6287", vigente:true, titulo:"Lei nº 6.287 de 11/12/1975", urn:"urn:lex:br:federal:lei:1975-12-11;6287", ementa:"Autoriza a alienação de bens imóveis da União, situados nas áreas urbanas   das cidades de Macapá, no Território Federal do Amapá, e Boa Vista, no   Território Federal de Roraima, nas condições estabelecidas na Lei nº 6.083, de   10 de julho de 1974, e dá outras providências.", arquivo:"federal/leis-ordinarias/1975/lei-6287-1975-12-11.md"}}, {id:"federal:BR:L:6226/1975", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-07-14", numero:"6226", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-07-14;6226", vigente:true, titulo:"Lei nº 6.226 de 14/07/1975", urn:"urn:lex:br:federal:lei:1975-07-14;6226", ementa:"Dispõe sobre a contagem recíproca de tempo de serviço público federal e de atividade privada, para efeito de aposentadoria.", arquivo:"federal/leis-ordinarias/1975/lei-6226-1975-07-14.md"}}, {id:"federal:BR:L:6280/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-12-09", numero:"6280", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-12-09;6280", vigente:true, titulo:"Lei nº 6.280 de 09/12/1975", urn:"urn:lex:br:federal:lei:1975-12-09;6280", ementa:"Estima a Receita e Fixa a Despesa do Distrito Federal para o Exercício   Financeiro de 1976.", arquivo:"federal/leis-ordinarias/1975/lei-6280-1975-12-09.md"}}, {id:"federal:BR:L:264/1894", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1894, data:"1894-12-20", numero:"264", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1894-12-20;264", vigente:true, titulo:"Lei nº 264 de 20/12/1894", urn:"urn:lex:br:federal:lei:1894-12-20;264", ementa:"Fixa as Forças de terra para o exercicio de   1895.", arquivo:"federal/leis-ordinarias/1894/lei-264-1894-12-20.md"}}, {id:"federal:BR:L:221/1894", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1894, data:"1894-11-20", numero:"221", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1894-11-20;221", vigente:true, titulo:"Lei nº 221 de 20/11/1894", urn:"urn:lex:br:federal:lei:1894-11-20;221", ementa:"Completa a organisação da Justiça Federal da Republica.", arquivo:"federal/leis-ordinarias/1894/lei-221-1894-11-20.md"}}, {id:"federal:BR:L:266/1894", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1894, data:"1894-12-24", numero:"266", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1894-12-24;266", vigente:true, titulo:"Lei nº 266 de 24/12/1894", urn:"urn:lex:br:federal:lei:1894-12-24;266", ementa:"Fixa a despeza geral da Republica dos Estados Unidos do Brazil para o   exercicio de 1895 e dá outras providencias.", arquivo:"federal/leis-ordinarias/1894/lei-266-1894-12-24.md"}}, {id:"federal:BR:L:248/1894", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1894, data:"1894-12-15", numero:"248", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1894-12-15;248", vigente:true, titulo:"Lei nº 248 de 15/12/1894", urn:"urn:lex:br:federal:lei:1894-12-15;248", ementa:"Altera as disposições do art. 7º relativas á organisação   do Conselho Municipal do Districto Federal e regula o processo para as eleições   de que trata o art. 83 da lei n. 85 de 20 de setembro de 1892.", arquivo:"federal/leis-ordinarias/1894/lei-248-1894-12-15.md"}}, {id:"federal:BR:L:222/1894", properties:{esf