UNWIND [{id:"federal:BR:LC:37/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1979, data:"1979-11-13", numero:"37", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1979-11-13;37", vigente:true, titulo:"Lei Complementar nº 37 de 13/11/1979", urn:"urn:lex:br:federal:lei.complementar:1979-11-13;37", ementa:"Altera a Lei Complementar nº 35, de 14 de março de 1979 (Lei Orgânica da   Magistratura Nacional).", arquivo:"federal/leis-complementares/1979/lcp-37-1979-11-13.md"}}, {id:"federal:BR:LC:35/1979", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1979, data:"1979-03-14", numero:"35", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1979-03-14;35", vigente:true, titulo:"Lei Complementar nº 35 de 14/03/1979", urn:"urn:lex:br:federal:lei.complementar:1979-03-14;35", ementa:"Dispõe sobre a Lei Orgânica da Magistratura Nacional.", arquivo:"federal/leis-complementares/1979/lcp-35-1979-03-14.md"}}, {id:"federal:BR:LC:36/1979", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1979, data:"1979-10-31", numero:"36", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1979-10-31;36", vigente:true, titulo:"Lei Complementar nº 36 de 31/10/1979", urn:"urn:lex:br:federal:lei.complementar:1979-10-31;36", ementa:"Permite aposentadoria voluntária, com proventos proporcionais ao tempo de   serviço, nas condições que indica e dá outras providências.", arquivo:"federal/leis-complementares/1979/lcp-36-1979-10-31.md"}}, {id:"federal:BR:LC:38/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1979, data:"1979-11-13", numero:"38", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1979-11-13;38", vigente:true, titulo:"Lei Complementar nº 38 de 13/11/1979", urn:"urn:lex:br:federal:lei.complementar:1979-11-13;38", ementa:"Modifica a redação de dispositivos da Lei Complementar nº 25, de 2 de   julho de 1975, que estabelece critérios e limites para a fixação da remuneração   de Vereadores.", arquivo:"federal/leis-complementares/1979/lcp-38-1979-11-13.md"}}, {id:"federal:BR:LC:160/2017", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2017, data:"2017-08-07", numero:"160", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2017-08-07;160", vigente:true, titulo:"Lei Complementar nº 160 de 07/08/2017", urn:"urn:lex:br:federal:lei.complementar:2017-08-07;160", ementa:"Dispõe sobre convênio que permite aos Estados e ao Distrito Federal deliberar sobre a remissão dos créditos tributários, constituídos ou não, decorrentes das isenções, dos incentivos e dos benefícios fiscais ou financeiro-fiscais instituídos em desacordo com o disposto na alínea \"g\" do inciso XII do § 2º do art. 155 da Constituição Federal e a reinstituição das respectivas isenções, incentivos e benefícios fiscais ou financeiro-fiscais; e altera a Lei nº 12.973, de 13 de maio de 2014.", arquivo:"federal/leis-complementares/2017/lcp-160-2017-08-07.md"}}, {id:"federal:BR:LC:159/2017", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2017, data:"2017-05-19", numero:"159", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2017-05-19;159", vigente:true, titulo:"Lei Complementar nº 159 de 19/05/2017", urn:"urn:lex:br:federal:lei.complementar:2017-05-19;159", ementa:"Institui o Regime de Recuperação Fiscal dos Estados e do Distrito Federal e altera as Leis Complementares nº 101, de 4 de maio de 2000, e nº 156, de 28 de dezembro de 2016.", arquivo:"federal/leis-complementares/2017/lcp-159-2017-05-19.md"}}, {id:"federal:BR:LC:158/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2017, data:"2017-02-23", numero:"158", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2017-02-23;158", vigente:true, titulo:"Lei Complementar nº 158 de 23/02/2017", urn:"urn:lex:br:federal:lei.complementar:2017-02-23;158", ementa:"Acrescenta § 14 ao art. 3º da Lei Complementar nº 63, de 11 de janeiro de 1990, para dispor sobre o cálculo do valor adicionado de energia hidrelétrica para fins de repartição do produto da arrecadação do imposto sobre a circulação de mercadorias e serviços pertencente aos Municípios.", arquivo:"federal/leis-complementares/2017/lcp-158-2017-02-23.md"}}, {id:"federal:BR:LC:89/1997", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1997, data:"1997-02-18", numero:"89", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1997-02-18;89", vigente:true, titulo:"Lei Complementar nº 89 de 18/02/1997", urn:"urn:lex:br:federal:lei.complementar:1997-02-18;89", ementa:"Institui o Fundo para Aparelhamento e Operacionalização das Atividades-fim   da Polícia Federal - FUNAPOL, e dá outras providências.", arquivo:"federal/leis-complementares/1997/lcp-89-1997-02-18.md"}}, {id:"federal:BR:LC:91/1997", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1997, data:"1997-12-22", numero:"91", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1997-12-22;91", vigente:true, titulo:"Lei Complementar nº 91 de 22/12/1997", urn:"urn:lex:br:federal:lei.complementar:1997-12-22;91", ementa:"Dispõe sobre a fixação dos coeficientes do Fundo de Participação dos Municípios.", arquivo:"federal/leis-complementares/1997/lcp-91-1997-12-22.md"}}, {id:"federal:BR:LC:90/1997", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1997, data:"1997-10-01", numero:"90", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1997-10-01;90", vigente:true, titulo:"Lei Complementar nº 90 de 01/10/1997", urn:"urn:lex:br:federal:lei.complementar:1997-10-01;90", ementa:"Determina os casos em que forças estrangeiras possam transitar pelo território nacional ou nele permanecer temporariamente.", arquivo:"federal/leis-complementares/1997/lcp-90-1997-10-01.md"}}, {id:"federal:BR:LC:193/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2022, data:"2022-03-17", numero:"193", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2022-03-17;193", vigente:true, titulo:"Lei Complementar nº 193 de 17/03/2022", urn:"urn:lex:br:federal:lei.complementar:2022-03-17;193", ementa:"Institui o Programa de Reescalonamento do Pagamento de Débitos no Âmbito do Simples Nacional (Relp).", arquivo:"federal/leis-complementares/2022/lcp-193-2022-03-17.md"}}, {id:"federal:BR:LC:197/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-06", numero:"197", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2022-12-06;197", vigente:true, titulo:"Lei Complementar nº 197 de 06/12/2022", urn:"urn:lex:br:federal:lei.complementar:2022-12-06;197", ementa:"Altera a Lei Complementar nº 172, de 15 de abril de 2020, e a Lei nº 14.029, de 28 de julho de 2020, para conceder prazo para que os Estados, o Distrito Federal e os Municípios executem atos de transposição e de transferência e atos de transposição e de reprogramação, respectivamente.", arquivo:"federal/leis-complementares/2022/lcp-197-2022-12-06.md"}}, {id:"federal:BR:LC:195/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2022, data:"2022-07-08", numero:"195", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2022-07-08;195", vigente:true, titulo:"Lei Complementar nº 195 de 08/07/2022", urn:"urn:lex:br:federal:lei.complementar:2022-07-08;195", ementa:"Dispõe sobre apoio financeiro da União aos Estados, ao Distrito Federal e aos Municípios para garantir ações emergenciais direcionadas ao setor cultural; altera a Lei Complementar nº 101, de 4 de maio de 2000 (Lei de Responsabilidade Fiscal), para não contabilizar na meta de resultado primário as transferências federais aos demais entes da Federação para enfrentamento das consequências sociais e econômicas no setor cultural decorrentes de calamidades públicas ou pandemias; e altera a Lei nº 8.31", arquivo:"federal/leis-complementares/2022/lcp-195-2022-07-08.md"}}, {id:"federal:BR:LC:196/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2022, data:"2022-08-24", numero:"196", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2022-08-24;196", vigente:true, titulo:"Lei Complementar nº 196 de 24/08/2022", urn:"urn:lex:br:federal:lei.complementar:2022-08-24;196", ementa:"Altera a Lei Complementar nº 130, de 17 de abril de 2009 (Lei do Sistema Nacional de Crédito Cooperativo), para incluir as confederações de serviço constituídas por cooperativas centrais de crédito entre as instituições integrantes do Sistema Nacional de Crédito Cooperativo e entre as instituições a serem autorizadas a funcionar pelo Banco Central do Brasil; e dá outras providências.", arquivo:"federal/leis-complementares/2022/lcp-196-2022-08-24.md"}}, {id:"federal:BR:LC:191/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2022, data:"2022-03-08", numero:"191", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2022-03-08;191", vigente:true, titulo:"Lei Complementar nº 191 de 08/03/2022", urn:"urn:lex:br:federal:lei.complementar:2022-03-08;191", ementa:"Altera a Lei Complementar nº 173, de 27 de maio de 2020, que estabelece o Programa Federativo de Enfrentamento ao Coronavírus SARS-CoV-2 (Covid-19).", arquivo:"federal/leis-complementares/2022/lcp-191-2022-03-08.md"}}, {id:"federal:BR:LC:194/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2022, data:"2022-06-23", numero:"194", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2022-06-23;194", vigente:true, titulo:"Lei Complementar nº 194 de 23/06/2022", urn:"urn:lex:br:federal:lei.complementar:2022-06-23;194", ementa:"Altera a Lei nº 5.172, de 25 de outubro de 1966 (Código Tributário Nacional), e a Lei Complementar nº 87, de 13 de setembro de 1996 (Lei Kandir), para considerar bens e serviços essenciais os relativos aos combustíveis, à energia elétrica, às comunicações e ao transporte coletivo, e as Leis Complementares nºs 192, de 11 de março de 2022, e 159, de 19 de maio de 2017.", arquivo:"federal/leis-complementares/2022/lcp-194-2022-06-23.md"}}, {id:"federal:BR:LC:192/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2022, data:"2022-03-11", numero:"192", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2022-03-11;192", vigente:true, titulo:"Lei Complementar nº 192 de 11/03/2022", urn:"urn:lex:br:federal:lei.complementar:2022-03-11;192", ementa:"Define os combustíveis sobre os quais incidirá uma única vez o Imposto sobre Operações Relativas à Circulação de Mercadorias e sobre Prestações de Serviços de Transporte Interestadual e Intermunicipal e de Comunicação (ICMS), ainda que as operações se iniciem no exterior; e dá outras providências.", arquivo:"federal/leis-complementares/2022/lcp-192-2022-03-11.md"}}, {id:"federal:BR:LC:190/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2022, data:"2022-01-04", numero:"190", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2022-01-04;190", vigente:true, titulo:"Lei Complementar nº 190 de 04/01/2022", urn:"urn:lex:br:federal:lei.complementar:2022-01-04;190", ementa:"Altera a Lei Complementar nº 87, de 13 de setembro de 1996 (Lei Kandir), para regulamentar a cobrança do Imposto sobre Operações relativas à Circulação de Mercadorias e sobre Prestações de Serviços de Transporte Interestadual e Intermunicipal e de Comunicação (ICMS) nas operações e prestações interestaduais destinadas a consumidor final não contribuinte do imposto.", arquivo:"federal/leis-complementares/2022/lcp-190-2022-01-04.md"}}, {id:"federal:BR:LC:189/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2022, data:"2022-01-04", numero:"189", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2022-01-04;189", vigente:true, titulo:"Lei Complementar nº 189 de 04/01/2022", urn:"urn:lex:br:federal:lei.complementar:2022-01-04;189", ementa:"Altera a Lei Complementar nº 156, de 28 de dezembro de 2016, que estabelece o Plano de Auxílio aos Estados e ao Distrito Federal e medidas de estímulo ao reequilíbrio fiscal, e a Lei Complementar nº 159, de 19 de maio de 2017, que institui o Regime de Recuperação Fiscal dos Estados e do Distrito Federal.", arquivo:"federal/leis-complementares/2022/lcp-189-2022-01-04.md"}}, {id:"federal:BR:LC:117/2004", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2004, data:"2004-09-02", numero:"117", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2004-09-02;117", vigente:true, titulo:"Lei Complementar nº 117 de 02/09/2004", urn:"urn:lex:br:federal:lei.complementar:2004-09-02;117", ementa:"Altera a Lei Complementar nº 97, de 9 de junho de 1999, que dispõe sobre as normas gerais para a organização, o preparo e o emprego das Forças Armadas, para estabelecer novas atribuições subsidiárias.", arquivo:"federal/leis-complementares/2004/lcp-117-2004-09-02.md"}}, {id:"federal:BR:LC:48/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-10", numero:"48", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1984-12-10;48", vigente:true, titulo:"Lei Complementar nº 48 de 10/12/1984", urn:"urn:lex:br:federal:lei.complementar:1984-12-10;48", ementa:"Estabelece normas integrantes do Estatuto da Microempresa, relativas a isenção do imposto sobre Circulação de Mercadorias - ICM e do Imposto sobre Serviços - ISS.", arquivo:"federal/leis-complementares/1984/lcp-48-1984-12-10.md"}}, {id:"federal:BR:LC:47/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1984, data:"1984-10-22", numero:"47", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1984-10-22;47", vigente:true, titulo:"Lei Complementar nº 47 de 22/10/1984", urn:"urn:lex:br:federal:lei.complementar:1984-10-22;47", ementa:"Adapta a Lei Complementar nº 15, de 13 de agosto de 1973, que regula a composição e o funcionamento do Colégio que elegerá o Presidente da República, e dá outras providências, às disposições da Emenda Constitucional nº 22, de 29 de junho de 1982.", arquivo:"federal/leis-complementares/1984/lcp-47-1984-10-22.md"}}, {id:"federal:BR:LC:46/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1984, data:"1984-08-21", numero:"46", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1984-08-21;46", vigente:true, titulo:"Lei Complementar nº 46 de 21/08/1984", urn:"urn:lex:br:federal:lei.complementar:1984-08-21;46", ementa:"Fixa normas sobre repetição de topônimos de cidades e vilas, incorporadas   ao texto da Lei Complementar nº 1, de 9 de novembro de 1967.", arquivo:"federal/leis-complementares/1984/lcp-46-1984-08-21.md"}}, {id:"federal:BR:LC:25/1975", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1975, data:"1975-07-02", numero:"25", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1975-07-02;25", vigente:true, titulo:"Lei Complementar nº 25 de 02/07/1975", urn:"urn:lex:br:federal:lei.complementar:1975-07-02;25", ementa:"Estabelece critério e limites para a fixação da remuneração de   Vereadores.", arquivo:"federal/leis-complementares/1975/lcp-25-1975-07-02.md"}}, {id:"federal:BR:LC:27/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1975, data:"1975-11-03", numero:"27", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1975-11-03;27", vigente:true, titulo:"Lei Complementar nº 27 de 03/11/1975", urn:"urn:lex:br:federal:lei.complementar:1975-11-03;27", ementa:"Altera a redação do artigo 2º da Lei Complementar nº 14, de 8 de junho de   1973, que estabelece regiões metropolitanas.", arquivo:"federal/leis-complementares/1975/lcp-27-1975-11-03.md"}}, {id:"federal:BR:LC:24/1975", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1975, data:"1975-01-07", numero:"24", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1975-01-07;24", vigente:true, titulo:"Lei Complementar nº 24 de 07/01/1975", urn:"urn:lex:br:federal:lei.complementar:1975-01-07;24", ementa:"Dispõe sobre os convênios para a concessão de isenções do imposto sobre operações relativas à circulação de mercadorias, e dá outras providências.", arquivo:"federal/leis-complementares/1975/lcp-24-1975-01-07.md"}}, {id:"federal:BR:LC:28/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1975, data:"1975-11-18", numero:"28", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1975-11-18;28", vigente:true, titulo:"Lei Complementar nº 28 de 18/11/1975", urn:"urn:lex:br:federal:lei.complementar:1975-11-18;28", ementa:"Modifica o artigo 6º da Lei Complementar nº 1, de 9 de novembro de   1967.", arquivo:"federal/leis-complementares/1975/lcp-28-1975-11-18.md"}}, {id:"federal:BR:LC:26/1975", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1975, data:"1975-09-11", numero:"26", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1975-09-11;26", vigente:true, titulo:"Lei Complementar nº 26 de 11/09/1975", urn:"urn:lex:br:federal:lei.complementar:1975-09-11;26", ementa:"Altera disposições da legislação que regula o Programa de Integração Social (PIS) e o Programa de Formação do Patrimônio do Servidor Público (PASEP).", arquivo:"federal/leis-complementares/1975/lcp-26-1975-09-11.md"}}, {id:"federal:BR:LC:142/2013", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2013, data:"2013-05-08", numero:"142", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2013-05-08;142", vigente:true, titulo:"Lei Complementar nº 142 de 08/05/2013", urn:"urn:lex:br:federal:lei.complementar:2013-05-08;142", ementa:"Regulamenta o § 1º do art. 201 da Constituição Federal, no tocante à aposentadoria da pessoa com deficiência segurada do Regime Geral de Previdência Social - RGPS.", arquivo:"federal/leis-complementares/2013/lcp-142-2013-05-08.md"}}, {id:"federal:BR:LC:143/2013", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2013, data:"2013-07-17", numero:"143", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2013-07-17;143", vigente:true, titulo:"Lei Complementar nº 143 de 17/07/2013", urn:"urn:lex:br:federal:lei.complementar:2013-07-17;143", ementa:"Altera a Lei Complementar nº 62, de 28 de dezembro de 1989, a Lei nº 5.172, de 25 de outubro de 1966 (Código Tributário Nacional), e a Lei nº 8.443, de 16 de julho de 1992 (Lei Orgânica do Tribunal de Contas da União), para dispor sobre os critérios de rateio do Fundo de Participação dos Estados e do Distrito Federal (FPE); e revoga dispositivos da Lei nº 5.172, de 25 de outubro de 1966.", arquivo:"federal/leis-complementares/2013/lcp-143-2013-07-17.md"}}, {id:"federal:BR:LC:76/1993", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1993, data:"1993-07-06", numero:"76", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1993-07-06;76", vigente:true, titulo:"Lei Complementar nº 76 de 06/07/1993", urn:"urn:lex:br:federal:lei.complementar:1993-07-06;76", ementa:"Dispõe sobre o procedimento contraditório especial, de rito sumário, para o processo de desapropriação de imóvel rural, por interesse social, para fins de reforma agrária.", arquivo:"federal/leis-complementares/1993/lcp-76-1993-07-06.md"}}, {id:"federal:BR:LC:77/1993", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1993, data:"1993-07-13", numero:"77", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1993-07-13;77", vigente:true, titulo:"Lei Complementar nº 77 de 13/07/1993", urn:"urn:lex:br:federal:lei.complementar:1993-07-13;77", ementa:"Institui o Imposto Provisório sobre a Movimentação ou a Transmissão de   Valores e de Créditos e Direitos de Natureza Finanaceira - IPMF e dá outras   providências.", arquivo:"federal/leis-complementares/1993/lcp-77-1993-07-13.md"}}, {id:"federal:BR:LC:73/1993", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1993, data:"1993-02-10", numero:"73", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1993-02-10;73", vigente:true, titulo:"Lei Complementar nº 73 de 10/02/1993", urn:"urn:lex:br:federal:lei.complementar:1993-02-10;73", ementa:"Institui a Lei Orgânica da Advocacia-Geral da União e dá outras providências.", arquivo:"federal/leis-complementares/1993/lcp-73-1993-02-10.md"}}, {id:"federal:BR:LC:78/1993", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1993, data:"1993-12-30", numero:"78", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1993-12-30;78", vigente:true, titulo:"Lei Complementar nº 78 de 30/12/1993", urn:"urn:lex:br:federal:lei.complementar:1993-12-30;78", ementa:"Disciplina a fixação do número de Deputados, nos termos do art. 45, § 1º da Constituição Federal.", arquivo:"federal/leis-complementares/1993/lcp-78-1993-12-30.md"}}, {id:"federal:BR:LC:72/1993", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1993, data:"1993-01-29", numero:"72", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1993-01-29;72", vigente:true, titulo:"Lei Complementar nº 72 de 29/01/1993", urn:"urn:lex:br:federal:lei.complementar:1993-01-29;72", ementa:"Prorroga a Lei que estabelece normas sobre o cálculo, a entrega e o   controle das liberações dos recursos dos Fundos de Participação e dá outras   providências.", arquivo:"federal/leis-complementares/1993/lcp-72-1993-01-29.md"}}, {id:"federal:BR:LC:75/1993", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1993, data:"1993-05-20", numero:"75", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1993-05-20;75", vigente:true, titulo:"Lei Complementar nº 75 de 20/05/1993", urn:"urn:lex:br:federal:lei.complementar:1993-05-20;75", ementa:"Dispõe sobre a organização, as atribuições e o estatuto do Ministério Público da União.", arquivo:"federal/leis-complementares/1993/lcp-75-1993-05-20.md"}}, {id:"federal:BR:LC:6/1970", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1970, data:"1970-06-30", numero:"6", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1970-06-30;6", vigente:true, titulo:"Lei Complementar nº 6 de 30/06/1970", urn:"urn:lex:br:federal:lei.complementar:1970-06-30;6", ementa:"Concede isenção de impostos federais, estaduais e municipais à Caixa   Econômica Federal - CEF.", arquivo:"federal/leis-complementares/1970/lcp-6-1970-06-30.md"}}, {id:"federal:BR:LC:7/1970", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1970, data:"1970-09-07", numero:"7", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1970-09-07;7", vigente:true, titulo:"Lei Complementar nº 7 de 07/09/1970", urn:"urn:lex:br:federal:lei.complementar:1970-09-07;7", ementa:"Institui o Programa de Integração Social, e dá outras providências.", arquivo:"federal/leis-complementares/1970/lcp-7-1970-09-07.md"}}, {id:"federal:BR:LC:9/1970", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1970, data:"1970-12-11", numero:"9", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1970-12-11;9", vigente:true, titulo:"Lei Complementar nº 9 de 11/12/1970", urn:"urn:lex:br:federal:lei.complementar:1970-12-11;9", ementa:"Dá nova redação ao artigo 10 do Ato Complementar nº 43, de 29 de janeiro   de 1969, e dá outras providências.", arquivo:"federal/leis-complementares/1970/lcp-9-1970-12-11.md"}}, {id:"federal:BR:LC:8/1970", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1970, data:"1970-12-03", numero:"8", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1970-12-03;8", vigente:true, titulo:"Lei Complementar nº 8 de 03/12/1970", urn:"urn:lex:br:federal:lei.complementar:1970-12-03;8", ementa:"Institui o Programa de Formação do Patrimônio do Servidor Público e dá outras providências.", arquivo:"federal/leis-complementares/1970/lcp-8-1970-12-03.md"}}, {id:"federal:BR:LC:5/1970", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1970, data:"1970-04-29", numero:"5", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1970-04-29;5", vigente:true, titulo:"Lei Complementar nº 5 de 29/04/1970", urn:"urn:lex:br:federal:lei.complementar:1970-04-29;5", ementa:"Estabelece, de acordo com a Emenda Constitucional nº 1, de 17 de outubro de 1969, art. 151 e seu parágrafo único, casos de inelegibilidades, e dá outras providências .", arquivo:"federal/leis-complementares/1970/lcp-5-1970-04-29.md"}}, {id:"federal:BR:LC:4/1969", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1969, data:"1969-12-02", numero:"4", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1969-12-02;4", vigente:true, titulo:"Lei Complementar nº 4 de 02/12/1969", urn:"urn:lex:br:federal:lei.complementar:1969-12-02;4", ementa:"Concede isenção do imposto sobre circulação de mercadorias e dá outras providências.", arquivo:"federal/leis-complementares/1969/lcp-4-1969-12-02.md"}}, {id:"federal:BR:LC:213/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2025, data:"2025-01-15", numero:"213", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2025-01-15;213", vigente:true, titulo:"Lei Complementar nº 213 de 15/01/2025", urn:"urn:lex:br:federal:lei.complementar:2025-01-15;213", ementa:"Altera o Decreto-Lei nº 73, de 21 de novembro de 1966 (Lei do Seguro Privado), para dispor sobre as sociedades cooperativas de seguros e as operações de proteção patrimonial mutualista, bem como sobre o termo de compromisso e o processo administrativo sancionador no âmbito da Superintendência de Seguros Privados (Susep); altera o Decreto-Lei nº 261, de 28 de fevereiro de 1967, para dispor regras a que as sociedades de capitalização estão sujeitas; altera a Lei Complementar nº 109, de 29 de maio ", arquivo:"federal/leis-complementares/2025/lcp-213-2025-01-15.md"}}, {id:"federal:BR:LC:220/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2025, data:"2025-10-31", numero:"220", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2025-10-31;220", vigente:true, titulo:"Lei Complementar nº 220 de 31/10/2025", urn:"urn:lex:br:federal:lei.complementar:2025-10-31;220", ementa:"Institui o Sistema Nacional de Educação (SNE) e fixa normas para a cooperação entre a União, os Estados, o Distrito Federal e os Municípios para elaboração e implementação de políticas, de programas e de ações educacionais, em regime de colaboração.", arquivo:"federal/leis-complementares/2025/lcp-220-2025-10-31.md"}}, {id:"federal:BR:LC:214/2025", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2025, data:"2025-01-16", numero:"214", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2025-01-16;214", vigente:true, titulo:"Lei Complementar nº 214 de 16/01/2025", urn:"urn:lex:br:federal:lei.complementar:2025-01-16;214", ementa:"Institui o Imposto sobre Bens e Serviços (IBS), a Contribuição Social sobre Bens e Serviços (CBS) e o Imposto Seletivo (IS); cria o Comitê Gestor do IBS e altera a legislação tributária.", arquivo:"federal/leis-complementares/2025/lcp-214-2025-01-16.md"}}, {id:"federal:BR:LC:224/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2025, data:"2025-12-26", numero:"224", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2025-12-26;224", vigente:true, titulo:"Lei Complementar nº 224 de 26/12/2025", urn:"urn:lex:br:federal:lei.complementar:2025-12-26;224", ementa:"Dispõe sobre a redução e os critérios de concessão de incentivos e benefícios de natureza tributária, financeira ou creditícia concedidos exclusivamente no âmbito da União; estabelece a responsabilidade solidária de terceiros pelo recolhimento de tributos incidentes sobre a exploração de apostas de quota fixa; e altera as Leis Complementares nºs 101, de 4 de maio de 2000 (Lei de Responsabilidade Fiscal), 105, de 10 de janeiro de 2001, e 215, de 21 de março de 2025, e as Leis nºs 7.689, de 15 de ", arquivo:"federal/leis-complementares/2025/lcp-224-2025-12-26.md"}}, {id:"federal:BR:LC:215/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2025, data:"2025-03-21", numero:"215", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2025-03-21;215", vigente:true, titulo:"Lei Complementar nº 215 de 21/03/2025", urn:"urn:lex:br:federal:lei.complementar:2025-03-21;215", ementa:"Dispõe sobre extensão do prazo para liquidação de restos a pagar não processados de que trata o art. 172 da Lei nº 14.791, de 29 de dezembro de 2023 (Lei de Diretrizes Orçamentárias de 2024).", arquivo:"federal/leis-complementares/2025/lcp-215-2025-03-21.md"}}, {id:"federal:BR:LC:216/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2025, data:"2025-07-28", numero:"216", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2025-07-28;216", vigente:true, titulo:"Lei Complementar nº 216 de 28/07/2025", urn:"urn:lex:br:federal:lei.complementar:2025-07-28;216", ementa:"Institui o Programa Acredita Exportação; e altera a Lei Complementar nº 123, de 14 de dezembro de 2006, e as Leis nºs 13.043, de 13 de novembro de 2014, 11.945, de 4 de junho de 2009, e 10.833, de 29 de dezembro de 2003, a fim de ampliar benefícios para determinados serviços nos regimes aduaneiros especiais de drawback e para o Regime Aduaneiro Especial de Entreposto Industrial sob Controle Informatizado (Recof) e incentivar as exportações brasileiras, especialmente as dos pequenos negócios.", arquivo:"federal/leis-complementares/2025/lcp-216-2025-07-28.md"}}, {id:"federal:BR:LC:212/2025", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2025, data:"2025-01-13", numero:"212", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2025-01-13;212", vigente:true, titulo:"Lei Complementar nº 212 de 13/01/2025", urn:"urn:lex:br:federal:lei.complementar:2025-01-13;212", ementa:"Institui o Programa de Pleno Pagamento de Dívidas dos Estados (Propag), destinado a promover a revisão dos termos das dívidas dos Estados e do Distrito Federal com a União firmadas no âmbito da Lei nº 8.727, de 5 de novembro de 1993, da Lei nº 9.496, de 11 de setembro de 1997, da Lei Complementar nº 159, de 19 de maio de 2017, da Lei Complementar nº 178, de 13 de janeiro de 2021, da Lei Complementar nº 201, de 24 de outubro de 2023, e da Medida Provisória nº 2.192-70, de 24 de agosto de 2001; pr", arquivo:"federal/leis-complementares/2025/lcp-212-2025-01-13.md"}}, {id:"federal:BR:LC:218/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2025, data:"2025-09-24", numero:"218", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2025-09-24;218", vigente:true, titulo:"Lei Complementar nº 218 de 24/09/2025", urn:"urn:lex:br:federal:lei.complementar:2025-09-24;218", ementa:"Altera a Lei Complementar nº 116, de 31 de julho de 2003, para explicitar que o Imposto Sobre Serviços de Qualquer Natureza (ISS) incidente sobre os serviços de guincho intramunicipal, de guindaste e de içamento é devido no local da execução da obra.", arquivo:"federal/leis-complementares/2025/lcp-218-2025-09-24.md"}}, {id:"federal:BR:LC:221/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2025, data:"2025-11-18", numero:"221", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2025-11-18;221", vigente:true, titulo:"Lei Complementar nº 221 de 18/11/2025", urn:"urn:lex:br:federal:lei.complementar:2025-11-18;221", ementa:"Dispõe sobre projetos estratégicos em defesa nacional.", arquivo:"federal/leis-complementares/2025/lcp-221-2025-11-18.md"}}, {id:"federal:BR:LC:222/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2025, data:"2025-11-26", numero:"222", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2025-11-26;222", vigente:true, titulo:"Lei Complementar nº 222 de 26/11/2025", urn:"urn:lex:br:federal:lei.complementar:2025-11-26;222", ementa:"Dispõe sobre condições e limites para a concessão, a ampliação ou a prorrogação de incentivos fiscais ao esporte pela União, pelos Estados, pelo Distrito Federal e pelos Municípios; altera a Lei nº 14.260, de 8 de dezembro de 2021; e revoga a Lei nº 11.438, de 29 de dezembro de 2006 (Lei de Incentivo ao Esporte).", arquivo:"federal/leis-complementares/2025/lcp-222-2025-11-26.md"}}, {id:"federal:BR:LC:219/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2025, data:"2025-09-29", numero:"219", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2025-09-29;219", vigente:true, titulo:"Lei Complementar nº 219 de 29/09/2025", urn:"urn:lex:br:federal:lei.complementar:2025-09-29;219", ementa:"Altera a Lei Complementar nº 64, de 18 de maio de 1990 (Lei das Inelegibilidades), para modificar prazos de duração e de fixação dos termos iniciais e finais de contagem de inelegibilidades, e a Lei nº 9.504, de 30 de setembro de 1997 (Lei das Eleições), para prever a criação do Requerimento de Declaração de Elegibilidade (RDE).", arquivo:"federal/leis-complementares/2025/lcp-219-2025-09-29.md"}}, {id:"federal:BR:LC:217/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2025, data:"2025-09-18", numero:"217", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2025-09-18;217", vigente:true, titulo:"Lei Complementar nº 217 de 18/09/2025", urn:"urn:lex:br:federal:lei.complementar:2025-09-18;217", ementa:"Altera a Lei Complementar nº 172, de 15 de abril de 2020, a fim de prorrogar o prazo para que os Estados, o Distrito Federal e os Municípios executem atos de transposição e de transferência de saldos financeiros constantes dos seus Fundos de Saúde.", arquivo:"federal/leis-complementares/2025/lcp-217-2025-09-18.md"}}, {id:"federal:BR:LC:223/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2025, data:"2025-12-19", numero:"223", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2025-12-19;223", vigente:true, titulo:"Lei Complementar nº 223 de 19/12/2025", urn:"urn:lex:br:federal:lei.complementar:2025-12-19;223", ementa:"Altera a Lei Complementar nº 200, de 30 de agosto de 2023, para excluir do cômputo dos limites de despesas primárias e das metas fiscais as despesas temporárias com educação pública e saúde de que trata o art. 6º da Lei nº 15.164, de 14 de julho de 2025.", arquivo:"federal/leis-complementares/2025/lcp-223-2025-12-19.md"}}, {id:"federal:BR:LC:127/2007", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2007, data:"2007-08-14", numero:"127", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2007-08-14;127", vigente:true, titulo:"Lei Complementar nº 127 de 14/08/2007", urn:"urn:lex:br:federal:lei.complementar:2007-08-14;127", ementa:"Altera a Lei Complementar nº 123, de 14 de dezembro de 2006.", arquivo:"federal/leis-complementares/2007/lcp-127-2007-08-14.md"}}, {id:"federal:BR:LC:124/2007", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2007, data:"2007-01-03", numero:"124", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2007-01-03;124", vigente:true, titulo:"Lei Complementar nº 124 de 03/01/2007", urn:"urn:lex:br:federal:lei.complementar:2007-01-03;124", ementa:"Institui, na forma do art. 43 da Constituição Federal, a Superintendência do Desenvolvimento da Amazônia - SUDAM; estabelece sua composição, natureza jurídica, objetivos, área de competência e instrumentos de ação; dispõe sobre o Fundo de Desenvolvimento da Amazônia - FDA; altera a Medida Provisória nº 2.157-5, de 24 de agosto de 2001; revoga a Lei Complementar nº 67, de 13 de junho de 1991; e dá outras providências.", arquivo:"federal/leis-complementares/2007/lcp-124-2007-01-03.md"}}, {id:"federal:BR:LC:126/2007", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2007, data:"2007-01-15", numero:"126", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2007-01-15;126", vigente:true, titulo:"Lei Complementar nº 126 de 15/01/2007", urn:"urn:lex:br:federal:lei.complementar:2007-01-15;126", ementa:"Dispõe sobre a política de resseguro, retrocessão e sua intermediação, as operações de co-seguro, as contratações de seguro no exterior e as operações em moeda estrangeira do setor securitário; altera o Decreto-Lei nº 73, de 21 de novembro de 1966, e a Lei nº 8.031, de 12 de abril de 1990; e dá outras providências.", arquivo:"federal/leis-complementares/2007/lcp-126-2007-01-15.md"}}, {id:"federal:BR:LC:125/2007", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2007, data:"2007-01-03", numero:"125", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2007-01-03;125", vigente:true, titulo:"Lei Complementar nº 125 de 03/01/2007", urn:"urn:lex:br:federal:lei.complementar:2007-01-03;125", ementa:"Institui, na forma do art. 43 da Constituição Federal, a Superintendência do Desenvolvimento do Nordeste - SUDENE; estabelece sua composição, natureza jurídica, objetivos, áreas de atuação, instrumentos de ação; altera a Lei nº 7.827, de 27 de setembro de 1989, e a Medida Provisória nº 2.156, de 24 de agosto de 2001; revoga a Lei Complementar nº 66, de 12 de junho de 1991; e dá outras providências.", arquivo:"federal/leis-complementares/2007/lcp-125-2007-01-03.md"}}, {id:"federal:BR:LC:55/1987", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1987, data:"1987-07-10", numero:"55", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1987-07-10;55", vigente:true, titulo:"Lei Complementar nº 55 de 10/07/1987", urn:"urn:lex:br:federal:lei.complementar:1987-07-10;55", ementa:"Declara não sujeitas à contribuição incidente sobre o produto rural para o   custeio do PRORURAL, as indústrias pesqueiras.", arquivo:"federal/leis-complementares/1987/lcp-55-1987-07-10.md"}}, {id:"federal:BR:LC:57/1987", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1987, data:"1987-12-18", numero:"57", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1987-12-18;57", vigente:true, titulo:"Lei Complementar nº 57 de 18/12/1987", urn:"urn:lex:br:federal:lei.complementar:1987-12-18;57", ementa:"Altera dispositivos da Lei Complementar nº 48, de 10 de dezembro de   1984.", arquivo:"federal/leis-complementares/1987/lcp-57-1987-12-18.md"}}, {id:"federal:BR:LC:34/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1978, data:"1978-09-12", numero:"34", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1978-09-12;34", vigente:true, titulo:"Lei Complementar nº 34 de 12/09/1978", urn:"urn:lex:br:federal:lei.complementar:1978-09-12;34", ementa:"Estabelece, nos termos do art. 103 da Constituição Federal, casos de   aposentadoria compulsória, no Grupo-Diplomacia, código D-300.", arquivo:"federal/leis-complementares/1978/lcp-34-1978-09-12.md"}}, {id:"federal:BR:LC:33/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1978, data:"1978-05-16", numero:"33", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1978-05-16;33", vigente:true, titulo:"Lei Complementar nº 33 de 16/05/1978", urn:"urn:lex:br:federal:lei.complementar:1978-05-16;33", ementa:"Dispõe sobre a renovação de eleições para Prefeito, Vice-Prefeito e   Vereadores, nos municípios criados nos termos do artigo 2º da Lei Complementar   nº 32, de 26 de dezembro de 1977, e dá outras providências.", arquivo:"federal/leis-complementares/1978/lcp-33-1978-05-16.md"}}, {id:"federal:BR:LC:155/2016", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2016, data:"2016-10-27", numero:"155", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2016-10-27;155", vigente:true, titulo:"Lei Complementar nº 155 de 27/10/2016", urn:"urn:lex:br:federal:lei.complementar:2016-10-27;155", ementa:"Altera a Lei Complementar nº 123, de 14 de dezembro de 2006, para reorganizar e simplificar a metodologia de apuração do imposto devido por optantes pelo Simples Nacional; altera as Leis nºs 9.613, de 3 de março de 1998, 12.512, de 14 de outubro de 2011, e 7.998, de 11 de janeiro de 1990; e revoga dispositivo da Lei nº 8.212, de 24 de julho de 1991.", arquivo:"federal/leis-complementares/2016/lcp-155-2016-10-27.md"}}, {id:"federal:BR:LC:156/2016", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2016, data:"2016-12-28", numero:"156", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2016-12-28;156", vigente:true, titulo:"Lei Complementar nº 156 de 28/12/2016", urn:"urn:lex:br:federal:lei.complementar:2016-12-28;156", ementa:"Estabelece o Plano de Auxílio aos Estados e ao Distrito Federal e medidas de estímulo ao reequilíbrio fiscal; e altera a Lei Complementar nº 148, de 25 de novembro de 2014, a Lei nº 9.496, de 11 de setembro de 1997, a Medida Provisória nº 2.192-70, de 24 de agosto de 2001, a Lei nº 8.727, de 5 de novembro de 1993, e a Lei Complementar nº 101, de 4 de maio de 2000.", arquivo:"federal/leis-complementares/2016/lcp-156-2016-12-28.md"}}, {id:"federal:BR:LC:154/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2016, data:"2016-04-18", numero:"154", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2016-04-18;154", vigente:true, titulo:"Lei Complementar nº 154 de 18/04/2016", urn:"urn:lex:br:federal:lei.complementar:2016-04-18;154", ementa:"Acrescenta § 25 ao art. 18-A da Lei Complementar nº 123, de 14 de dezembro de 2006, para permitir ao microempreendedor individual utilizar sua residência como sede do estabelecimento.", arquivo:"federal/leis-complementares/2016/lcp-154-2016-04-18.md"}}, {id:"federal:BR:LC:157/2016", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2016, data:"2016-12-29", numero:"157", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2016-12-29;157", vigente:true, titulo:"Lei Complementar nº 157 de 29/12/2016", urn:"urn:lex:br:federal:lei.complementar:2016-12-29;157", ementa:"Altera a Lei Complementar nº 116, de 31 de julho de 2003, que dispõe sobre o Imposto Sobre Serviços de Qualquer Natureza, a Lei nº 8.429, de 2 de junho de 1992 (Lei de Improbidade Administrativa), e a Lei Complementar nº 63, de 11 de janeiro de 1990, que \"dispõe sobre critérios e prazos de crédito das parcelas do produto da arrecadação de impostos de competência dos Estados e de transferências por estes recebidos, pertencentes aos Municípios, e dá outras providências\".", arquivo:"federal/leis-complementares/2016/lcp-157-2016-12-29.md"}}, {id:"federal:BR:LC:85/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1996, data:"1996-02-15", numero:"85", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1996-02-15;85", vigente:true, titulo:"Lei Complementar nº 85 de 15/02/1996", urn:"urn:lex:br:federal:lei.complementar:1996-02-15;85", ementa:"Altera o art. 7º da Lei Complementar nº 70, de 30 de dezembro de 1991, que estabelece a Contribuição para Financiamento da Seguridade Social - COFINS.", arquivo:"federal/leis-complementares/1996/lcp-85-1996-02-15.md"}}, {id:"federal:BR:LC:88/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1996, data:"1996-12-23", numero:"88", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1996-12-23;88", vigente:true, titulo:"Lei Complementar nº 88 de 23/12/1996", urn:"urn:lex:br:federal:lei.complementar:1996-12-23;88", ementa:"Altera a redação dos arts. 5º, 6º ,10 e 17 da Lei Complementar nº 76, de 6 de julho de 1993, que dispõe sobre o procedimento contraditório especial, de rito sumário, para o processo de desapropriação de imóvel rural, por interesse social, para fins de reforma agrária.", arquivo:"federal/leis-complementares/1996/lcp-88-1996-12-23.md"}}, {id:"federal:BR:LC:86/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1996, data:"1996-05-14", numero:"86", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1996-05-14;86", vigente:true, titulo:"Lei Complementar nº 86 de 14/05/1996", urn:"urn:lex:br:federal:lei.complementar:1996-05-14;86", ementa:"Acrescenta dispositivo ao Código Eleitoral, a fim de permitir a ação rescisória em casos de inegibilidade.", arquivo:"federal/leis-complementares/1996/lcp-86-1996-05-14.md"}}, {id:"federal:BR:LC:87/1996", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1996, data:"1996-09-13", numero:"87", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1996-09-13;87", vigente:true, titulo:"Lei Complementar nº 87 de 13/09/1996", urn:"urn:lex:br:federal:lei.complementar:1996-09-13;87", ementa:"Dispõe sobre o imposto dos Estados e do Distrito Federal sobre operações relativas à circulação de mercadorias e sobre prestações de serviços de transporte interestadual e intermunicipal e de comunicação, e dá outras providências.", arquivo:"federal/leis-complementares/1996/lcp-87-1996-09-13.md"}}, {id:"federal:BR:LC:186/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2021, data:"2021-10-27", numero:"186", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2021-10-27;186", vigente:true, titulo:"Lei Complementar nº 186 de 27/10/2021", urn:"urn:lex:br:federal:lei.complementar:2021-10-27;186", ementa:"Altera a Lei Complementar nº 160, de 7 de agosto de 2017, para permitir a prorrogação, por até 15 (quinze) anos, das isenções, dos incentivos e dos benefícios fiscais ou financeiro-fiscais vinculados ao Imposto sobre Operações Relativas à Circulação de Mercadorias e sobre Prestações de Serviços de Transporte Interestadual e Intermunicipal e de Comunicação (ICMS) destinados à manutenção ou ao incremento das atividades comerciais, desde que o beneficiário seja o real remetente da mercadoria, às pr", arquivo:"federal/leis-complementares/2021/lcp-186-2021-10-27.md"}}, {id:"federal:BR:LC:183/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2021, data:"2021-09-22", numero:"183", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2021-09-22;183", vigente:true, titulo:"Lei Complementar nº 183 de 22/09/2021", urn:"urn:lex:br:federal:lei.complementar:2021-09-22;183", ementa:"Altera a Lei Complementar nº 116, de 31 de julho de 2003, para explicitar a incidência do Imposto sobre Serviços de Qualquer Natureza (ISS) sobre o monitoramento e rastreamento de veículos e carga.", arquivo:"federal/leis-complementares/2021/lcp-183-2021-09-22.md"}}, {id:"federal:BR:LC:179/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2021, data:"2021-02-24", numero:"179", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2021-02-24;179", vigente:true, titulo:"Lei Complementar nº 179 de 24/02/2021", urn:"urn:lex:br:federal:lei.complementar:2021-02-24;179", ementa:"Define os objetivos do Banco Central do Brasil e dispõe sobre sua autonomia e sobre a nomeação e a exoneração de seu Presidente e de seus Diretores; e altera artigo da Lei nº 4.595, de 31 de dezembro de 1964.", arquivo:"federal/leis-complementares/2021/lcp-179-2021-02-24.md"}}, {id:"federal:BR:LC:184/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2021, data:"2021-09-29", numero:"184", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2021-09-29;184", vigente:true, titulo:"Lei Complementar nº 184 de 29/09/2021", urn:"urn:lex:br:federal:lei.complementar:2021-09-29;184", ementa:"Altera a Lei Complementar nº 64, de 18 de maio de 1990, para excluir da incidência de inelegibilidade responsáveis que tenham tido contas julgadas irregulares sem imputação de débito e com condenação exclusiva ao pagamento de multa.", arquivo:"federal/leis-complementares/2021/lcp-184-2021-09-29.md"}}, {id:"federal:BR:LC:185/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2021, data:"2021-10-06", numero:"185", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2021-10-06;185", vigente:true, titulo:"Lei Complementar nº 185 de 06/10/2021", urn:"urn:lex:br:federal:lei.complementar:2021-10-06;185", ementa:"Altera o art. 2º da Lei Complementar nº 125, de 3 de janeiro de 2007, para incluir Municípios dos Estados de Minas Gerais e do Espírito Santo na área de atuação da Superintendência do Desenvolvimento do Nordeste (Sudene).", arquivo:"federal/leis-complementares/2021/lcp-185-2021-10-06.md"}}, {id:"federal:BR:LC:181/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2021, data:"2021-05-06", numero:"181", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2021-05-06;181", vigente:true, titulo:"Lei Complementar nº 181 de 06/05/2021", urn:"urn:lex:br:federal:lei.complementar:2021-05-06;181", ementa:"Altera a Lei Complementar nº 172, de 15 de abril de 2020, e a Lei nº 14.029, de 28 de julho de 2020, para conceder prazo para que os Estados, o Distrito Federal e os Municípios executem atos de transposição e de transferência e atos de transposição e de reprogramação, respectivamente; altera a Lei Complementar nº 156, de 28 de dezembro de 2016, para conceder prazo adicional para celebração de aditivos contratuais e permitir mudança nos critérios de indexação dos contratos de refinanciamento de d", arquivo:"federal/leis-complementares/2021/lcp-181-2021-05-06.md"}}, {id:"federal:BR:LC:178/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2021, data:"2021-01-13", numero:"178", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2021-01-13;178", vigente:true, titulo:"Lei Complementar nº 178 de 13/01/2021", urn:"urn:lex:br:federal:lei.complementar:2021-01-13;178", ementa:"Estabelece o Programa de Acompanhamento e Transparência Fiscal e o Plano de Promoção do Equilíbrio Fiscal; altera a Lei Complementar nº 101, de 4 de maio de 2000, a Lei Complementar nº 156, de 28 de dezembro de 2016, a Lei Complementar nº 159, de 19 de maio de 2017, a Lei Complementar nº 173, de 27 de maio de 2020, a Lei nº 9.496, de 11 de setembro de 1997, a Lei nº 12.348, de 15 de dezembro de 2010, a Lei nº 12.649, de 17 de maio de 2012, e a Medida Provisória nº 2.185-35, de 24 de agosto de 20", arquivo:"federal/leis-complementares/2021/lcp-178-2021-01-13.md"}}, {id:"federal:BR:LC:177/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2021, data:"2021-01-12", numero:"177", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2021-01-12;177", vigente:true, titulo:"Lei Complementar nº 177 de 12/01/2021", urn:"urn:lex:br:federal:lei.complementar:2021-01-12;177", ementa:"Altera a Lei Complementar nº 101, de 4 de maio de 2000, para vedar a limitação de empenho e movimentação financeira das despesas relativas à inovação e ao desenvolvimento científico e tecnológico custeadas por fundo criado para tal finalidade, e a Lei nº 11.540, de 12 de novembro de 2007, para modificar a natureza e as fontes de receitas do Fundo Nacional de Desenvolvimento Científico e Tecnológico (FNDCT), e incluir programas desenvolvidos por organizações sociais entre as instituições que pode", arquivo:"federal/leis-complementares/2021/lcp-177-2021-01-12.md"}}, {id:"federal:BR:LC:187/2021", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-16", numero:"187", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2021-12-16;187", vigente:true, titulo:"Lei Complementar nº 187 de 16/12/2021", urn:"urn:lex:br:federal:lei.complementar:2021-12-16;187", ementa:"Dispõe sobre a certificação das entidades beneficentes e regula os procedimentos referentes à imunidade de contribuições à seguridade social de que trata o § 7º do art. 195 da Constituição Federal; altera as Leis n°s 5.172, de 25 de outubro de 1966 (Código Tributário Nacional), e 9.532, de 10 de dezembro de 1997; revoga a Lei nº 12.101, de 27 de novembro de 2009, e dispositivos das Leis n°s 11.096, de 13 de janeiro de 2005, e 12.249, de 11 de junho de 2010; e dá outras providências.", arquivo:"federal/leis-complementares/2021/lcp-187-2021-12-16.md"}}, {id:"federal:BR:LC:182/2021", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2021, data:"2021-06-01", numero:"182", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2021-06-01;182", vigente:true, titulo:"Lei Complementar nº 182 de 01/06/2021", urn:"urn:lex:br:federal:lei.complementar:2021-06-01;182", ementa:"Institui o marco legal das startups e do empreendedorismo inovador; e altera a Lei nº 6.404, de 15 de dezembro de 1976, e a Lei Complementar nº 123, de 14 de dezembro de 2006.", arquivo:"federal/leis-complementares/2021/lcp-182-2021-06-01.md"}}, {id:"federal:BR:LC:180/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2021, data:"2021-04-14", numero:"180", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2021-04-14;180", vigente:true, titulo:"Lei Complementar nº 180 de 14/04/2021", urn:"urn:lex:br:federal:lei.complementar:2021-04-14;180", ementa:"Altera a Lei Complementar nº 173, de 27 de maio de 2020, que estabelece o Programa Federativo de Enfrentamento ao Coronavírus SARS-CoV-2 (Covid-19).", arquivo:"federal/leis-complementares/2021/lcp-180-2021-04-14.md"}}, {id:"federal:BR:LC:188/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-31", numero:"188", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2021-12-31;188", vigente:true, titulo:"Lei Complementar nº 188 de 31/12/2021", urn:"urn:lex:br:federal:lei.complementar:2021-12-31;188", ementa:"Altera a Lei Complementar nº 123, de 14 de dezembro de 2006 (Estatuto Nacional da Microempresa e da Empresa de Pequeno Porte), para modificar a composição e o funcionamento do Comitê Gestor do Simples Nacional (CGSN) e ampliar o âmbito de aplicação de seu regime tributário.", arquivo:"federal/leis-complementares/2021/lcp-188-2021-12-31.md"}}, {id:"federal:BR:LC:116/2003", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2003, data:"2003-07-31", numero:"116", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2003-07-31;116", vigente:true, titulo:"Lei Complementar nº 116 de 31/07/2003", urn:"urn:lex:br:federal:lei.complementar:2003-07-31;116", ementa:"Dispõe sobre o Imposto Sobre Serviços de Qualquer Natureza, de competência dos Municípios e do Distrito Federal, e dá outras providências.", arquivo:"federal/leis-complementares/2003/lcp-116-2003-07-31.md"}}, {id:"federal:BR:LC:45/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1983, data:"1983-12-14", numero:"45", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1983-12-14;45", vigente:true, titulo:"Lei Complementar nº 45 de 14/12/1983", urn:"urn:lex:br:federal:lei.complementar:1983-12-14;45", ementa:"Estabelece critério para a remuneração de Vereadores.", arquivo:"federal/leis-complementares/1983/lcp-45-1983-12-14.md"}}, {id:"federal:BR:LC:44/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1983, data:"1983-12-07", numero:"44", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1983-12-07;44", vigente:true, titulo:"Lei Complementar nº 44 de 07/12/1983", urn:"urn:lex:br:federal:lei.complementar:1983-12-07;44", ementa:"Altera o Decreto-Lei nº 406, de 31 de dezembro de 1968, que estabelece   normas gerais de direito tributário, e dá outras providências.", arquivo:"federal/leis-complementares/1983/lcp-44-1983-12-07.md"}}, {id:"federal:BR:LC:18/1974", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1974, data:"1974-05-10", numero:"18", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1974-05-10;18", vigente:true, titulo:"Lei Complementar nº 18 de 10/05/1974", urn:"urn:lex:br:federal:lei.complementar:1974-05-10;18", ementa:"Estabelece prazo de desincompatibilização para as eleições fixadas na   Emenda Constitucional nº 2 e altera dispositivo da Lei Complementar nº   5.", arquivo:"federal/leis-complementares/1974/lcp-18-1974-05-10.md"}}, {id:"federal:BR:LC:20/1974", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1974, data:"1974-07-01", numero:"20", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1974-07-01;20", vigente:true, titulo:"Lei Complementar nº 20 de 01/07/1974", urn:"urn:lex:br:federal:lei.complementar:1974-07-01;20", ementa:"Dispõe sobre a criação de Estados e Territórios.", arquivo:"federal/leis-complementares/1974/lcp-20-1974-07-01.md"}}, {id:"federal:BR:LC:23/1974", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1974, data:"1974-12-19", numero:"23", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1974-12-19;23", vigente:true, titulo:"Lei Complementar nº 23 de 19/12/1974", urn:"urn:lex:br:federal:lei.complementar:1974-12-19;23", ementa:"Altera os artigos 1º e 2º e seus parágrafos, e 3º e seus incisos, da Lei   Complementar nº 2, de 29 de novembro de 1967, que \"dispõe sobre a execução do   disposto no artigo 16, parágrafo 2º, da Constituição Federal, relativamente à   remuneração dos Vereadores\".", arquivo:"federal/leis-complementares/1974/lcp-23-1974-12-19.md"}}, {id:"federal:BR:LC:141/2012", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2012, data:"2012-01-13", numero:"141", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2012-01-13;141", vigente:true, titulo:"Lei Complementar nº 141 de 13/01/2012", urn:"urn:lex:br:federal:lei.complementar:2012-01-13;141", ementa:"Regulamenta o § 3º do art. 198 da Constituição Federal para dispor sobre os valores mínimos a serem aplicados anualmente pela União, Estados, Distrito Federal e Municípios em ações e serviços públicos de saúde; estabelece os critérios de rateio dos recursos de transferências para a saúde e as normas de fiscalização, avaliação e controle das despesas com saúde nas 3 (três) esferas de governo; revoga dispositivos das Leis nºs 8.080, de 19 de setembro de 1990, e 8.689, de 27 de julho de 1993; e dá ", arquivo:"federal/leis-complementares/2012/lcp-141-2012-01-13.md"}}, {id:"federal:BR:LC:110/2001", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2001, data:"2001-06-29", numero:"110", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2001-06-29;110", vigente:true, titulo:"Lei Complementar nº 110 de 29/06/2001", urn:"urn:lex:br:federal:lei.complementar:2001-06-29;110", ementa:"Institui contribuições sociais, autoriza créditos de complementos de atualização monetária em contas vinculadas do Fundo de Garantia do Tempo de Serviço - FGTS e dá outras providências.", arquivo:"federal/leis-complementares/2001/lcp-110-2001-06-29.md"}}, {id:"federal:BR:LC:106/2001", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2001, data:"2001-03-23", numero:"106", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2001-03-23;106", vigente:true, titulo:"Lei Complementar nº 106 de 23/03/2001", urn:"urn:lex:br:federal:lei.complementar:2001-03-23;106", ementa:"Dá nova redação aos §§ 1º e 2º do art. 2º da Lei Complementar nº 91, de 22   de dezembro de 1997, que dispõe sobre a fixação dos coeficientes de distribuição   dos recursos do Fundo de Participação dos Municípios.", arquivo:"federal/leis-complementares/2001/lcp-106-2001-03-23.md"}}, {id:"federal:BR:LC:104/2001", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2001, data:"2001-01-10", numero:"104", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2001-01-10;104", vigente:true, titulo:"Lei Complementar nº 104 de 10/01/2001", urn:"urn:lex:br:federal:lei.complementar:2001-01-10;104", ementa:"Altera dispositivos da Lei nº 5.172, de 25 de outubro de 1966 ;- Código Tributário Nacional.", arquivo:"federal/leis-complementares/2001/lcp-104-2001-01-10.md"}}, {id:"federal:BR:LC:112/2001", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2001, data:"2001-09-19", numero:"112", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2001-09-19;112", vigente:true, titulo:"Lei Complementar nº 112 de 19/09/2001", urn:"urn:lex:br:federal:lei.complementar:2001-09-19;112", ementa:"Autoriza o Poder Executivo a criar a Região Integrada de Desenvolvimento da Grande Teresina e instituir o Programa Especial de Desenvolvimento da Grande Teresina e dá outras providências.", arquivo:"federal/leis-complementares/2001/lcp-112-2001-09-19.md"}}, {id:"federal:BR:LC:108/2001", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2001, data:"2001-05-29", numero:"108", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2001-05-29;108", vigente:true, titulo:"Lei Complementar nº 108 de 29/05/2001", urn:"urn:lex:br:federal:lei.complementar:2001-05-29;108", ementa:"Dispõe sobre a relação entre a União, os Estados, o Distrito Federal e os   Municípios, suas autarquias, fundações, sociedades de economia mista e outras   entidades públicas e suas respectivas entidades fechadas de previdência   complementar, e dá outras providências.", arquivo:"federal/leis-complementares/2001/lcp-108-2001-05-29.md"}}, {id:"federal:BR:LC:107/2001", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2001, data:"2001-04-26", numero:"107", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2001-04-26;107", vigente:true, titulo:"Lei Complementar nº 107 de 26/04/2001", urn:"urn:lex:br:federal:lei.complementar:2001-04-26;107", ementa:"Altera a Lei Complementar nº 95, de 26 de fevereiro de 1998.", arquivo:"federal/leis-complementares/2001/lcp-107-2001-04-26.md"}}, {id:"federal:BR:LC:111/2001", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2001, data:"2001-07-06", numero:"111", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2001-07-06;111", vigente:true, titulo:"Lei Complementar nº 111 de 06/07/2001", urn:"urn:lex:br:federal:lei.complementar:2001-07-06;111", ementa:"Dispõe sobre o Fundo de Combate e Erradicação da Pobreza, na forma prevista nos artigos 79, 80 e 81 do Ato das Disposições Constitucionais Transitórias.", arquivo:"federal/leis-complementares/2001/lcp-111-2001-07-06.md"}}, {id:"federal:BR:LC:105/2001", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2001, data:"2001-01-10", numero:"105", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2001-01-10;105", vigente:true, titulo:"Lei Complementar nº 105 de 10/01/2001", urn:"urn:lex:br:federal:lei.complementar:2001-01-10;105", ementa:"Dispõe sobre o sigilo das operações de instituições financeiras e dá outras providências.", arquivo:"federal/leis-complementares/2001/lcp-105-2001-01-10.md"}}, {id:"federal:BR:LC:113/2001", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2001, data:"2001-09-19", numero:"113", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2001-09-19;113", vigente:true, titulo:"Lei Complementar nº 113 de 19/09/2001", urn:"urn:lex:br:federal:lei.complementar:2001-09-19;113", ementa:"Autoriza o Poder Executivo a criar a Região Administrativa Integrada de   Desenvolvimento do Pólo Petrolina/PE e Juazeiro/BA e institui o Programa   Especial de Desenvolvimento do Pólo Petrolina/PE e Juazeiro/BA.", arquivo:"federal/leis-complementares/2001/lcp-113-2001-09-19.md"}}, {id:"federal:BR:LC:109/2001", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2001, data:"2001-05-29", numero:"109", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2001-05-29;109", vigente:true, titulo:"Lei Complementar nº 109 de 29/05/2001", urn:"urn:lex:br:federal:lei.complementar:2001-05-29;109", ementa:"Dispõe sobre o Regime de Previdência Complementar e dá outras providências.", arquivo:"federal/leis-complementares/2001/lcp-109-2001-05-29.md"}}, {id:"federal:BR:LC:40/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-14", numero:"40", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1981-12-14;40", vigente:true, titulo:"Lei Complementar nº 40 de 14/12/1981", urn:"urn:lex:br:federal:lei.complementar:1981-12-14;40", ementa:"Estabelece normas gerais a serem adotadas na Organização do Ministério   Público estadual.", arquivo:"federal/leis-complementares/1981/lcp-40-1981-12-14.md"}}, {id:"federal:BR:LC:41/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-22", numero:"41", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1981-12-22;41", vigente:true, titulo:"Lei Complementar nº 41 de 22/12/1981", urn:"urn:lex:br:federal:lei.complementar:1981-12-22;41", ementa:"Cria o Estado de Rondônia e dá outras providências.", arquivo:"federal/leis-complementares/1981/lcp-41-1981-12-22.md"}}, {id:"federal:BR:LC:13/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1972, data:"1972-10-11", numero:"13", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1972-10-11;13", vigente:true, titulo:"Lei Complementar nº 13 de 11/10/1972", urn:"urn:lex:br:federal:lei.complementar:1972-10-11;13", ementa:"Autoriza a instituição de empréstimo compulsório em favor das Centrais   Elétricas Brasileiras S.A. - ELETROBRÁS - e dá outras providências.", arquivo:"federal/leis-complementares/1972/lcp-13-1972-10-11.md"}}, {id:"federal:BR:LC:137/2010", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2010, data:"2010-08-26", numero:"137", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2010-08-26;137", vigente:true, titulo:"Lei Complementar nº 137 de 26/08/2010", urn:"urn:lex:br:federal:lei.complementar:2010-08-26;137", ementa:"Autoriza a participação da União em fundo destinado à cobertura suplementar dos riscos do seguro rural; altera dispositivos da Lei nº 10.823, de 19 de dezembro de 2003, da Lei Complementar nº 126, de 15 de janeiro de 2007, do Decreto-Lei nº 73, de 21 de novembro de 1966, do Decreto-Lei nº 261, de 28 de fevereiro de 1967, e da Lei nº 4.594, de 29 de dezembro de 1964; revoga dispositivos da Lei nº 8.171, de 17 de janeiro de 1991, da Lei nº 10.823, de 19 de dezembro de 2003, e do Decreto-Lei nº 73,", arquivo:"federal/leis-complementares/2010/lcp-137-2010-08-26.md"}}, {id:"federal:BR:LC:135/2010", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2010, data:"2010-06-04", numero:"135", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2010-06-04;135", vigente:true, titulo:"Lei Complementar nº 135 de 04/06/2010", urn:"urn:lex:br:federal:lei.complementar:2010-06-04;135", ementa:"Altera a Lei Complementar n° 64, de 18 de maio de 1990, que estabelece, de acordo com o § 9° do art. 14 da Constituição Federal, casos de inelegibilidade, prazos de cessação e determina outras providências, para incluir hipóteses de inelegibilidade que visam a proteger a probidade administrativa e a moralidade no exercício do mandato.", arquivo:"federal/leis-complementares/2010/lcp-135-2010-06-04.md"}}, {id:"federal:BR:LC:136/2010", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2010, data:"2010-08-25", numero:"136", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2010-08-25;136", vigente:true, titulo:"Lei Complementar nº 136 de 25/08/2010", urn:"urn:lex:br:federal:lei.complementar:2010-08-25;136", ementa:"Altera a Lei Complementar nº 97, de 9 de junho de 1999, que \"dispõe sobre as normas gerais para a organização, o preparo e o emprego das Forças Armadas\", para criar o Estado-Maior Conjunto das Forças Armadas e disciplinar as atribuições do Ministro de Estado da Defesa.", arquivo:"federal/leis-complementares/2010/lcp-136-2010-08-25.md"}}, {id:"federal:BR:LC:134/2010", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2010, data:"2010-01-14", numero:"134", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2010-01-14;134", vigente:true, titulo:"Lei Complementar nº 134 de 14/01/2010", urn:"urn:lex:br:federal:lei.complementar:2010-01-14;134", ementa:"Dispõe sobre a composição do Conselho de Administração da Superintendência da Zona Franca de Manaus; revoga a Lei Complementar no 68, de 13 de junho de 1991; e dá outras providências.", arquivo:"federal/leis-complementares/2010/lcp-134-2010-01-14.md"}}, {id:"federal:BR:LC:138/2010", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2010, data:"2010-12-29", numero:"138", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2010-12-29;138", vigente:true, titulo:"Lei Complementar nº 138 de 29/12/2010", urn:"urn:lex:br:federal:lei.complementar:2010-12-29;138", ementa:"Altera a Lei Complementar nº 87, de 13 de setembro de 1996, que dispõe sobre o imposto dos Estados e do Distrito Federal sobre Operações Relativas à Circulação de Mercadorias e sobre Prestações de Serviços de Transporte Interestadual e Intermunicipal e de Comunicação, e dá outras providências.", arquivo:"federal/leis-complementares/2010/lcp-138-2010-12-29.md"}}, {id:"federal:BR:LC:63/1990", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1990, data:"1990-01-11", numero:"63", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1990-01-11;63", vigente:true, titulo:"Lei Complementar nº 63 de 11/01/1990", urn:"urn:lex:br:federal:lei.complementar:1990-01-11;63", ementa:"Dispõe sobre critérios e prazos de crédito das parcelas do produto da arrecadação de impostos de competência dos Estados e de transferências por estes recebidas, pertencentes aos Municípios, e dá outras providências.", arquivo:"federal/leis-complementares/1990/lcp-63-1990-01-11.md"}}, {id:"federal:BR:LC:64/1990", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1990, data:"1990-05-18", numero:"64", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1990-05-18;64", vigente:true, titulo:"Lei Complementar nº 64 de 18/05/1990", urn:"urn:lex:br:federal:lei.complementar:1990-05-18;64", ementa:"Estabelece, de acordo com o art. 14, § 9º, da Constituição Federal, casos de inelegibilidade, prazos de cessação e determina outras providências.", arquivo:"federal/leis-complementares/1990/lcp-64-1990-05-18.md"}}, {id:"federal:BR:LC:131/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2009, data:"2009-05-27", numero:"131", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2009-05-27;131", vigente:true, titulo:"Lei Complementar nº 131 de 27/05/2009", urn:"urn:lex:br:federal:lei.complementar:2009-05-27;131", ementa:"Acrescenta dispositivos à Lei Complementar nº 101, de 4 de maio de 2000, que estabelece normas de finanças públicas voltadas para a responsabilidade na gestão fiscal e dá outras providências, a fim de determinar a disponibilização, em tempo real, de informações pormenorizadas sobre a execução orçamentária e financeira da União, dos Estados, do Distrito Federal e dos Municípios.", arquivo:"federal/leis-complementares/2009/lcp-131-2009-05-27.md"}}, {id:"federal:BR:LC:129/2009", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2009, data:"2009-01-08", numero:"129", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2009-01-08;129", vigente:true, titulo:"Lei Complementar nº 129 de 08/01/2009", urn:"urn:lex:br:federal:lei.complementar:2009-01-08;129", ementa:"Institui, na forma do art. 43 da Constituição Federal, a Superintendência do Desenvolvimento do Centro-Oeste - SUDECO, estabelece sua missão institucional, natureza jurídica, objetivos, área de atuação, instrumentos de ação, altera a Lei nº 7.827, de 27 de setembro de 1989, e dá outras providências. ; ;", arquivo:"federal/leis-complementares/2009/lcp-129-2009-01-08.md"}}, {id:"federal:BR:LC:133/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-28", numero:"133", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2009-12-28;133", vigente:true, titulo:"Lei Complementar nº 133 de 28/12/2009", urn:"urn:lex:br:federal:lei.complementar:2009-12-28;133", ementa:"Altera a Lei Complementar nº 123, de 14 de dezembro de 2006, para modificar o enquadramento das atividades de produções cinematográficas, audiovisuais, artísticas e culturais no Regime Especial Unificado de Arrecadação de Tributos e Contribuições devidos pelas Microempresas e Empresas de Pequeno Porte.", arquivo:"federal/leis-complementares/2009/lcp-133-2009-12-28.md"}}, {id:"federal:BR:LC:130/2009", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2009, data:"2009-04-17", numero:"130", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2009-04-17;130", vigente:true, titulo:"Lei Complementar nº 130 de 17/04/2009", urn:"urn:lex:br:federal:lei.complementar:2009-04-17;130", ementa:"Dispõe sobre o Sistema Nacional de Crédito Cooperativo e revoga dispositivos das Leis nºs 4.595, de 31 de dezembro de 1964, e 5.764, de 16 de dezembro de 1971. ;", arquivo:"federal/leis-complementares/2009/lcp-130-2009-04-17.md"}}, {id:"federal:BR:LC:132/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2009, data:"2009-10-07", numero:"132", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2009-10-07;132", vigente:true, titulo:"Lei Complementar nº 132 de 07/10/2009", urn:"urn:lex:br:federal:lei.complementar:2009-10-07;132", ementa:"Altera dispositivos da Lei Complementar nº 80, de 12 de janeiro de 1994, que organiza a Defensoria Pública da União, do Distrito Federal e dos Territórios e prescreve normas gerais para sua organização nos Estados, e da Lei nº 1.060, de 5 de fevereiro de 1950, e dá outras providências.", arquivo:"federal/leis-complementares/2009/lcp-132-2009-10-07.md"}}, {id:"federal:BR:LC:62/1989", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1989, data:"1989-12-28", numero:"62", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1989-12-28;62", vigente:true, titulo:"Lei Complementar nº 62 de 28/12/1989", urn:"urn:lex:br:federal:lei.complementar:1989-12-28;62", ementa:"Estabelece normas sobre o cálculo, a entrega e o controle das liberações dos recursos dos Fundos de Participação e dá outras providências.", arquivo:"federal/leis-complementares/1989/lcp-62-1989-12-28.md"}}, {id:"federal:BR:LC:60/1989", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1989, data:"1989-10-06", numero:"60", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1989-10-06;60", vigente:true, titulo:"Lei Complementar nº 60 de 06/10/1989", urn:"urn:lex:br:federal:lei.complementar:1989-10-06;60", ementa:"Possibilita afastamento de magistrados dirigentes de classe.", arquivo:"federal/leis-complementares/1989/lcp-60-1989-10-06.md"}}, {id:"federal:BR:LC:61/1989", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1989, data:"1989-12-26", numero:"61", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1989-12-26;61", vigente:true, titulo:"Lei Complementar nº 61 de 26/12/1989", urn:"urn:lex:br:federal:lei.complementar:1989-12-26;61", ementa:"Estabelece normas para a participação dos Estados e do Distrito Federal no   produto da arrecadação do Imposto sobre Produtos Industrializados - IPI,   relativamente às exportações.", arquivo:"federal/leis-complementares/1989/lcp-61-1989-12-26.md"}}, {id:"federal:BR:LC:162/2018", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2018, data:"2018-04-06", numero:"162", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2018-04-06;162", vigente:true, titulo:"Lei Complementar nº 162 de 06/04/2018", urn:"urn:lex:br:federal:lei.complementar:2018-04-06;162", ementa:"Institui o Programa Especial de Regularização Tributária das Microempresas e Empresas de Pequeno Porte optantes pelo Simples Nacional (Pert-SN).", arquivo:"federal/leis-complementares/2018/lcp-162-2018-04-06.md"}}, {id:"federal:BR:LC:164/2018", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2018, data:"2018-12-18", numero:"164", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2018-12-18;164", vigente:true, titulo:"Lei Complementar nº 164 de 18/12/2018", urn:"urn:lex:br:federal:lei.complementar:2018-12-18;164", ementa:"Acrescenta §§ 5º e 6º ao art. 23 da Lei Complementar nº 101, de 4 de maio de 2000 (Lei de Responsabilidade Fiscal), para vedar a aplicação de sanções a Município que ultrapasse o limite para a despesa total com pessoal nos casos de queda de receita que especifica.", arquivo:"federal/leis-complementares/2018/lcp-164-2018-12-18.md"}}, {id:"federal:BR:LC:163/2018", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2018, data:"2018-06-14", numero:"163", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2018-06-14;163", vigente:true, titulo:"Lei Complementar nº 163 de 14/06/2018", urn:"urn:lex:br:federal:lei.complementar:2018-06-14;163", ementa:"Dá nova redação ao § 1º do art. 1º da Lei Complementar nº 94, de 19 de fevereiro de 1998, que autoriza o Poder Executivo a criar a Região Integrada de Desenvolvimento do Distrito Federal e Entorno - RIDE e instituir o Programa Especial de Desenvolvimento do Entorno do Distrito Federal, e dá outras providências.", arquivo:"federal/leis-complementares/2018/lcp-163-2018-06-14.md"}}, {id:"federal:BR:LC:161/2018", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2018, data:"2018-01-04", numero:"161", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2018-01-04;161", vigente:true, titulo:"Lei Complementar nº 161 de 04/01/2018", urn:"urn:lex:br:federal:lei.complementar:2018-01-04;161", ementa:"Altera o art. 2º da Lei Complementar nº 130, de 17 de abril de 2009, que dispõe sobre o Sistema Nacional de Crédito Cooperativo.", arquivo:"federal/leis-complementares/2018/lcp-161-2018-01-04.md"}}, {id:"federal:BR:LC:94/1998", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1998, data:"1998-02-19", numero:"94", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1998-02-19;94", vigente:true, titulo:"Lei Complementar nº 94 de 19/02/1998", urn:"urn:lex:br:federal:lei.complementar:1998-02-19;94", ementa:"Autoriza o Poder Executivo a criar a Região Integrada de Desenvolvimento do Distrito Federal e Entorno - (Ride) e instituir o Programa Especial de Desenvolvimento do Entorno do Distrito Federal, e dá outras providências.", arquivo:"federal/leis-complementares/1998/lcp-94-1998-02-19.md"}}, {id:"federal:BR:LC:95/1998", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1998, data:"1998-02-26", numero:"95", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1998-02-26;95", vigente:true, titulo:"Lei Complementar nº 95 de 26/02/1998", urn:"urn:lex:br:federal:lei.complementar:1998-02-26;95", ementa:"Dispõe sobre a elaboração, a redação, a alteração e a consolidação das leis, conforme determina o parágrafo único do art. 59 da Constituição Federal, e estabelece normas para a consolidação dos atos normativos que menciona.", arquivo:"federal/leis-complementares/1998/lcp-95-1998-02-26.md"}}, {id:"federal:BR:LC:93/1998", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1998, data:"1998-02-04", numero:"93", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1998-02-04;93", vigente:true, titulo:"Lei Complementar nº 93 de 04/02/1998", urn:"urn:lex:br:federal:lei.complementar:1998-02-04;93", ementa:"Institui o Fundo de Terras e da Reforma Agrária - Banco da Terra - e dá outras providências.", arquivo:"federal/leis-complementares/1998/lcp-93-1998-02-04.md"}}, {id:"federal:BR:LC:3/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1967, data:"1967-12-07", numero:"3", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1967-12-07;3", vigente:true, titulo:"Lei Complementar nº 3 de 07/12/1967", urn:"urn:lex:br:federal:lei.complementar:1967-12-07;3", ementa:"Dispõe sobre os Orçamentos Plurianuais de Investimento, e dá outras   providências.", arquivo:"federal/leis-complementares/1967/lcp-3-1967-12-07.md"}}, {id:"federal:BR:LC:1/1967", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1967, data:"1967-11-09", numero:"1", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1967-11-09;1", vigente:true, titulo:"Lei Complementar nº 1 de 09/11/1967", urn:"urn:lex:br:federal:lei.complementar:1967-11-09;1", ementa:"Estabelece os requisitos mínimos de população e renda pública e a forma de consulta prévia às populações locais, para a criação de novos municípios.", arquivo:"federal/leis-complementares/1967/lcp-1-1967-11-09.md"}}, {id:"federal:BR:LC:204/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-28", numero:"204", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2023-12-28;204", vigente:true, titulo:"Lei Complementar nº 204 de 28/12/2023", urn:"urn:lex:br:federal:lei.complementar:2023-12-28;204", ementa:"Altera a Lei Complementar nº 87, de 13 de setembro de 1996 (Lei Kandir), para vedar a incidência do Imposto sobre Operações relativas à Circulação de Mercadorias e sobre Prestações de Serviços de Transporte Interestadual e Intermunicipal e de Comunicação (ICMS) nos casos de transferência de mercadoria entre estabelecimentos do mesmo contribuinte.", arquivo:"federal/leis-complementares/2023/lcp-204-2023-12-28.md"}}, {id:"federal:BR:LC:200/2023", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2023, data:"2023-08-30", numero:"200", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2023-08-30;200", vigente:true, titulo:"Lei Complementar nº 200 de 30/08/2023", urn:"urn:lex:br:federal:lei.complementar:2023-08-30;200", ementa:"Institui regime fiscal sustentável para garantir a estabilidade macroeconômica do País e criar as condições adequadas ao crescimento socioeconômico, com fundamento no art. 6º da Emenda Constitucional nº 126, de 21 de dezembro de 2022, e no inciso VIII do caput e no parágrafo único do art. 163 da Constituição Federal; e altera a Lei Complementar nº 101, de 4 de maio de 2000 (Lei de Responsabilidade Fiscal).", arquivo:"federal/leis-complementares/2023/lcp-200-2023-08-30.md"}}, {id:"federal:BR:LC:202/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-15", numero:"202", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2023-12-15;202", vigente:true, titulo:"Lei Complementar nº 202 de 15/12/2023", urn:"urn:lex:br:federal:lei.complementar:2023-12-15;202", ementa:"Altera a Lei Complementar nº 195, de 8 de julho de 2022 (Lei Paulo Gustavo), para prorrogar até 31 de dezembro de 2024 o prazo de execução dos recursos por Estados, Distrito Federal e Municípios.", arquivo:"federal/leis-complementares/2023/lcp-202-2023-12-15.md"}}, {id:"federal:BR:LC:199/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2023, data:"2023-08-01", numero:"199", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2023-08-01;199", vigente:true, titulo:"Lei Complementar nº 199 de 01/08/2023", urn:"urn:lex:br:federal:lei.complementar:2023-08-01;199", ementa:"Institui o Estatuto Nacional de Simplificação de Obrigações Tributárias Acessórias; e dá outras providências.", arquivo:"federal/leis-complementares/2023/lcp-199-2023-08-01.md"}}, {id:"federal:BR:LC:201/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2023, data:"2023-10-24", numero:"201", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2023-10-24;201", vigente:true, titulo:"Lei Complementar nº 201 de 24/10/2023", urn:"urn:lex:br:federal:lei.complementar:2023-10-24;201", ementa:"Dispõe sobre a compensação devida pela União nos termos dos arts. 3º e 14 da Lei Complementar nº 194, de 23 de junho de 2022, a dedução das parcelas dos contratos de dívida, a transferência direta de recursos da União aos Estados e ao Distrito Federal, a incorporação do excesso compensado judicialmente em saldo devedor de contratos de dívida administrados pela Secretaria do Tesouro Nacional do Ministério da Fazenda, o tratamento jurídico e contábil aplicável aos pagamentos, às compensações e às ", arquivo:"federal/leis-complementares/2023/lcp-201-2023-10-24.md"}}, {id:"federal:BR:LC:198/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2023, data:"2023-06-28", numero:"198", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2023-06-28;198", vigente:true, titulo:"Lei Complementar nº 198 de 28/06/2023", urn:"urn:lex:br:federal:lei.complementar:2023-06-28;198", ementa:"Altera a Lei Complementar nº 91, de 22 de dezembro de 1997, para manter os coeficientes do Fundo de Participação dos Municípios (FPM) de Municípios com redução populacional aferida em censo demográfico, aplicando redutor financeiro sobre eventuais ganhos, na forma e no prazo que especifica; e altera a Lei nº 14.133, de 1º de abril de 2021 (Lei de Licitações e Contratos Administrativos).", arquivo:"federal/leis-complementares/2023/lcp-198-2023-06-28.md"}}, {id:"federal:BR:LC:203/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-15", numero:"203", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2023-12-15;203", vigente:true, titulo:"Lei Complementar nº 203 de 15/12/2023", urn:"urn:lex:br:federal:lei.complementar:2023-12-15;203", ementa:"Dispõe sobre as despesas voltadas a programa de incentivo à permanência de estudantes no ensino médio.", arquivo:"federal/leis-complementares/2023/lcp-203-2023-12-15.md"}}, {id:"federal:BR:LC:120/2005", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2005, data:"2005-12-29", numero:"120", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2005-12-29;120", vigente:true, titulo:"Lei Complementar nº 120 de 29/12/2005", urn:"urn:lex:br:federal:lei.complementar:2005-12-29;120", ementa:"Altera dispositivos da Lei Complementar nº 87, de 13 de setembro de 1996, que dispõe sobre o imposto dos Estados e do Distrito Federal sobre Operações Relativas a Circulação de Mercadorias e sobre Prestações de Serviços de Transporte Interestadual e Intermunicipal e de Comunicação, e dá outras providências.", arquivo:"federal/leis-complementares/2005/lcp-120-2005-12-29.md"}}, {id:"federal:BR:LC:118/2005", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2005, data:"2005-02-09", numero:"118", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2005-02-09;118", vigente:true, titulo:"Lei Complementar nº 118 de 09/02/2005", urn:"urn:lex:br:federal:lei.complementar:2005-02-09;118", ementa:"Altera e acrescenta dispositivos à Lei nº 5.172, de 25 de outubro de 1966 - Código Tributário Nacional, e dispõe sobre a interpretação do inciso I do art. 168 da mesma Lei.", arquivo:"federal/leis-complementares/2005/lcp-118-2005-02-09.md"}}, {id:"federal:BR:LC:119/2005", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2005, data:"2005-10-19", numero:"119", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2005-10-19;119", vigente:true, titulo:"Lei Complementar nº 119 de 19/10/2005", urn:"urn:lex:br:federal:lei.complementar:2005-10-19;119", ementa:"Acrescenta inciso ao art. 3º da Lei Complementar nº 79, de 7 de janeiro de 1994, que \"cria o Fundo Penitenciário Nacional - FUNPEN e dá outras providências\", para incluir a manutenção das casas de abrigo.", arquivo:"federal/leis-complementares/2005/lcp-119-2005-10-19.md"}}, {id:"federal:BR:LC:51/1985", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1985, data:"1985-12-20", numero:"51", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1985-12-20;51", vigente:true, titulo:"Lei Complementar nº 51 de 20/12/1985", urn:"urn:lex:br:federal:lei.complementar:1985-12-20;51", ementa:"Dispõe sobre a aposentadoria do funcionário policial, nos termos do art. 103, da Constituição Federal.", arquivo:"federal/leis-complementares/1985/lcp-51-1985-12-20.md"}}, {id:"federal:BR:LC:49/1985", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1985, data:"1985-06-27", numero:"49", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1985-06-27;49", vigente:true, titulo:"Lei Complementar nº 49 de 27/06/1985", urn:"urn:lex:br:federal:lei.complementar:1985-06-27;49", ementa:"Dispõe sobre a instalação de Municípios e dá outras providências.", arquivo:"federal/leis-complementares/1985/lcp-49-1985-06-27.md"}}, {id:"federal:BR:LC:50/1985", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1985, data:"1985-12-19", numero:"50", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1985-12-19;50", vigente:true, titulo:"Lei Complementar nº 50 de 19/12/1985", urn:"urn:lex:br:federal:lei.complementar:1985-12-19;50", ementa:"Altera a redação do art. 1º da Lei Complementar nº 45, de 14 de dezembro de 1983, e concede poderes às Câmaras Municipais para efetuar o cálculo da remuneração dos Vereadores.", arquivo:"federal/leis-complementares/1985/lcp-50-1985-12-19.md"}}, {id:"federal:BR:LC:29/1976", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1976, data:"1976-07-05", numero:"29", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1976-07-05;29", vigente:true, titulo:"Lei Complementar nº 29 de 05/07/1976", urn:"urn:lex:br:federal:lei.complementar:1976-07-05;29", ementa:"Permite aposentadoria voluntária, nas condições que especifica, aos   funcionários incluídos em Quadros Suplementares ou postos em   disponibilidade.", arquivo:"federal/leis-complementares/1976/lcp-29-1976-07-05.md"}}, {id:"federal:BR:LC:147/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2014, data:"2014-08-07", numero:"147", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2014-08-07;147", vigente:true, titulo:"Lei Complementar nº 147 de 07/08/2014", urn:"urn:lex:br:federal:lei.complementar:2014-08-07;147", ementa:"Altera a Lei Complementar nº 123, de 14 de dezembro de 2006, e as Leis nºs 5.889, de 8 de junho de 1973, 11.101, de 9 de fevereiro de 2005, 9.099, de 26 de setembro de 1995, 11.598, de 3 de dezembro de 2007, 8.934, de 18 de novembro de 1994, 10.406, de 10 de janeiro de 2002, e 8.666, de 21 de junho de 1993; e dá outras providências.", arquivo:"federal/leis-complementares/2014/lcp-147-2014-08-07.md"}}, {id:"federal:BR:LC:145/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2014, data:"2014-05-15", numero:"145", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2014-05-15;145", vigente:true, titulo:"Lei Complementar nº 145 de 15/05/2014", urn:"urn:lex:br:federal:lei.complementar:2014-05-15;145", ementa:"Altera dispositivos da Lei Complementar nº 93, de 4 de fevereiro de 1998, que institui o Fundo de Terras e da Reforma Agrária - Banco da Terra.", arquivo:"federal/leis-complementares/2014/lcp-145-2014-05-15.md"}}, {id:"federal:BR:LC:146/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2014, data:"2014-06-25", numero:"146", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2014-06-25;146", vigente:true, titulo:"Lei Complementar nº 146 de 25/06/2014", urn:"urn:lex:br:federal:lei.complementar:2014-06-25;146", ementa:"Estende a estabilidade provisória prevista na alínea b do inciso II do art. 10 do Ato das Disposições Constitucionais Transitórias à trabalhadora gestante, nos casos de morte desta, a quem detiver a guarda de seu filho.", arquivo:"federal/leis-complementares/2014/lcp-146-2014-06-25.md"}}, {id:"federal:BR:LC:144/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2014, data:"2014-05-15", numero:"144", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2014-05-15;144", vigente:true, titulo:"Lei Complementar nº 144 de 15/05/2014", urn:"urn:lex:br:federal:lei.complementar:2014-05-15;144", ementa:"Atualiza a ementa e altera o art. 1º da Lei Complementar nº 51, de 20 de dezembro de 1985, que \"Dispõe sobre a aposentadoria do funcionário policial, nos termos do art. 103, da Constituição Federal\", para regulamentar a aposentadoria da mulher servidora policial.", arquivo:"federal/leis-complementares/2014/lcp-144-2014-05-15.md"}}, {id:"federal:BR:LC:148/2014", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2014, data:"2014-11-25", numero:"148", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2014-11-25;148", vigente:true, titulo:"Lei Complementar nº 148 de 25/11/2014", urn:"urn:lex:br:federal:lei.complementar:2014-11-25;148", ementa:"Altera a Lei Complementar nº 101, de 4 de maio de 2000, que estabelece normas de finanças públicas voltadas para a responsabilidade na gestão fiscal; dispõe sobre critérios de indexação dos contratos de refinanciamento da dívida celebrados entre a União, Estados, o Distrito Federal e Municípios; e dá outras providências.", arquivo:"federal/leis-complementares/2014/lcp-148-2014-11-25.md"}}, {id:"federal:BR:LC:81/1994", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1994, data:"1994-04-13", numero:"81", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1994-04-13;81", vigente:true, titulo:"Lei Complementar nº 81 de 13/04/1994", urn:"urn:lex:br:federal:lei.complementar:1994-04-13;81", ementa:"Altera a redação da alínea \"b\" do inciso I do art. 1º da Lei Complementar   nº 64, de 18 de maio de 1990, para elevar de três para oito anos o prazo de   inelegibilidade para os parlamentares que perderem o mandato por falta de decoro   parlamentar.", arquivo:"federal/leis-complementares/1994/lcp-81-1994-04-13.md"}}, {id:"federal:BR:LC:79/1994", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1994, data:"1994-01-07", numero:"79", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1994-01-07;79", vigente:true, titulo:"Lei Complementar nº 79 de 07/01/1994", urn:"urn:lex:br:federal:lei.complementar:1994-01-07;79", ementa:"Cria o Fundo Penitenciário Nacional - FUNPEN, e dá outras providências.", arquivo:"federal/leis-complementares/1994/lcp-79-1994-01-07.md"}}, {id:"federal:BR:LC:80/1994", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1994, data:"1994-01-12", numero:"80", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1994-01-12;80", vigente:true, titulo:"Lei Complementar nº 80 de 12/01/1994", urn:"urn:lex:br:federal:lei.complementar:1994-01-12;80", ementa:"Organiza a Defensoria Pública da União, do Distrito Federal e dos Territórios e prescreve normas gerais para sua organização nos Estados, e dá outras providências.", arquivo:"federal/leis-complementares/1994/lcp-80-1994-01-12.md"}}] AS row
CREATE (n:Norma{id: row.id}) SET n += row.properties SET n:LeiComplementar;
UNWIND [{id:"federal:BR:N:5/1994", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional de Revisão", vigencia_origem:"revogada=false", ano:1994, numero:"5", data:"1994-06-07", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional.revisao:1994-06-07;5", vigente:true, titulo:"Emenda Constitucional de Revisão nº 5 de 07/06/1994", urn:"urn:lex:br:federal:emenda.constitucional.revisao:1994-06-07;5", ementa:"\"ALTERA O ARTIGO 82 DA CONSTITUIÇÃO FEDERAL, SUBSTITUINDO A EXPRESSÃO \"CINCO ANOS\" POR \"QUATRO ANOS\" PARA O MANDATO DO PRESIDENTE DA REPUBLICA.\" (EMENDA ELABORADA PELA SUBSECRETARIA DE ANALISE PARA A COMPOSIÇÃO DA ESTRUTURA DOCUMENTAL DA BASE DE DADOS).", arquivo:"federal/emendas-constitucionais/1994/emr-5-1994-06-07.md"}}, {id:"federal:BR:N:3/1994", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional de Revisão", vigencia_origem:"revogada=false", ano:1994, numero:"3", data:"1994-06-07", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional.revisao:1994-06-07;3", vigente:true, titulo:"Emenda Constitucional de Revisão nº 3 de 07/06/1994", urn:"urn:lex:br:federal:emenda.constitucional.revisao:1994-06-07;3", ementa:"ALTERA DISPOSITIVOS DA CONSTITUIÇÃO FEDERAL SOBRE NACIONALIDADE BRASILEIRA E DA OUTRAS PROVIDENCIAS. (EMENTA ELABORADA PELA SUBSECRETARIA DE ANALISE PARA A COMPOSIÇÃO DA ESTRUTURA DOCUMENTAL DA BASE DE DADOS).", arquivo:"federal/emendas-constitucionais/1994/emr-3-1994-06-07.md"}}, {id:"federal:BR:N:6/1994", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional de Revisão", vigencia_origem:"revogada=false", ano:1994, numero:"6", data:"1994-06-07", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional.revisao:1994-06-07;6", vigente:true, titulo:"Emenda Constitucional de Revisão nº 6 de 07/06/1994", urn:"urn:lex:br:federal:emenda.constitucional.revisao:1994-06-07;6", ementa:"\"ACRESCENTA O PARAGRAFO 4 AO ARTIGO 55 DA CONSTITUIÇÃO FEDERAL, QUE DISPÕE SOBRE PERDA DE MANDATO DO DEPUTADO OU SENADOR.\" (EMENTA ELABORADA PELA SUBSECRETARIA DE ANALISE PARA A COMPOSIÇÃO DA ESTRUTURA DOCUMENTAL DA BASE DE DADOS).", arquivo:"federal/emendas-constitucionais/1994/emr-6-1994-06-07.md"}}, {id:"federal:BR:N:2/1994", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional de Revisão", vigencia_origem:"revogada=false", ano:1994, numero:"2", data:"1994-06-07", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional.revisao:1994-06-07;2", vigente:true, titulo:"Emenda Constitucional de Revisão nº 2 de 07/06/1994", urn:"urn:lex:br:federal:emenda.constitucional.revisao:1994-06-07;2", ementa:"ALTERA DISPOSITIVOS DA CONSTITUIÇÃO FEDERAL, ACRESCENTANDO EXPRESSÕES AO SEU ARTIGO 50. (EMENTA ELABORADA PELA SUBSECRETARIA DE ANALISE PARA A COMPOSIÇÃO DA ESTRUTURA DOCUMENTAL DA BASE DE DADOS).", arquivo:"federal/emendas-constitucionais/1994/emr-2-1994-06-07.md"}}, {id:"federal:BR:N:1/1994", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional de Revisão", vigencia_origem:"revogada=false", ano:1994, numero:"1", data:"1994-03-01", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional.revisao:1994-03-01;1", vigente:true, titulo:"Emenda Constitucional de Revisão nº 1 de 01/03/1994", urn:"urn:lex:br:federal:emenda.constitucional.revisao:1994-03-01;1", ementa:"ALTERA O ATO DAS DISPOSIÇÕES CONSTITUCIONAIS TRANSITORIAS PARA INCLUIR DISPOSITIVOS SOBRE O FUNDO SOCIAL DE EMERGENCIA, E DÁ OUTRAS PROVIDENCIAS. (EMENTA ELABORADA PELA SUBSECRETARIA DE ANALISE PARA A COMPOSIÇÃO DA ESTRUTURA DOCUMENTAL DA BASE DE DADOS).", arquivo:"federal/emendas-constitucionais/1994/emr-1-1994-03-01.md"}}, {id:"federal:BR:N:4/1994", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional de Revisão", vigencia_origem:"revogada=false", ano:1994, numero:"4", data:"1994-06-07", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional.revisao:1994-06-07;4", vigente:true, titulo:"Emenda Constitucional de Revisão nº 4 de 07/06/1994", urn:"urn:lex:br:federal:emenda.constitucional.revisao:1994-06-07;4", ementa:"\"ACRESCENTA EXPRESSÕES AO TEXTO CONSTITUCIONAL QUE DISPÕE SOBRE DIREITOS POLITICOS NOS CASOS DE INELEGIBILIDADE.\" (EMENTA ELABORADA PELA SUBSECRETARIA DE ANALISE PARA A COMPOSIÇÃO DA ESTRUTURA DOCUMENTAL DA BASE DE DADOS).", arquivo:"federal/emendas-constitucionais/1994/emr-4-1994-06-07.md"}}] AS row
