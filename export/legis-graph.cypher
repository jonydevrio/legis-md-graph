962-07-27.md"}}, {id:"federal:BR:L:4159/1962", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1962, data:"1962-11-30", numero:"4159", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1962-11-30;4159", vigente:true, titulo:"Lei nº 4.159 de 30/11/1962", urn:"urn:lex:br:federal:lei:1962-11-30;4159", ementa:"Integra na Universidade de Minas Gerais o Conservatório Mineiro de Música   de Belo Horizonte, incorpora o Instituto de Belas Artes do Rio Grande do Sul à   Universidade do Rio Grande do Sul e autoriza a abertura, pelo Ministério da   Educação e Cultura, de crédito especial.", arquivo:"federal/leis-ordinarias/1962/lei-4159-1962-11-30.md"}}, {id:"federal:BR:L:4053/1962", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1962, data:"1962-03-09", numero:"4053", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1962-03-09;4053", vigente:true, titulo:"Lei nº 4.053 de 09/03/1962", urn:"urn:lex:br:federal:lei:1962-03-09;4053", ementa:"Concede pensões especiais a Maria do Amparo Medeiros Parente e Lícia Costa   Perlingeiro.", arquivo:"federal/leis-ordinarias/1962/lei-4053-1962-03-09.md"}}, {id:"federal:BR:L:4090/1962", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1962, data:"1962-07-13", numero:"4090", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1962-07-13;4090", vigente:true, titulo:"Lei nº 4.090 de 13/07/1962", urn:"urn:lex:br:federal:lei:1962-07-13;4090", ementa:"Institui a gratificação de Natal para os trabalhadores.", arquivo:"federal/leis-ordinarias/1962/lei-4090-1962-07-13.md"}}, {id:"federal:BR:L:4061/1962", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1962, data:"1962-05-08", numero:"4061", fonte:"https://normas.leg.br/?urn=urn:lex:br:f