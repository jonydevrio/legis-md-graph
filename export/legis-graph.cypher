-12-19.md"}}, {id:"federal:BR:L:2405/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-01-17", numero:"2405", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-01-17;2405", vigente:true, titulo:"Lei nº 2.405 de 17/01/1955", urn:"urn:lex:br:federal:lei:1955-01-17;2405", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça do   Trabalho, Tribunal Regional do Trabalho da 1ª Região - o crédito especial de Cr$   117.320,00, para pagamento de gratificação de representação aos vogais das   Juntas de Conciliação e Julgamento da Primeira Região.", arquivo:"federal/leis-ordinarias/1955/lei-2405-1955-01-17.md"}}, {id:"federal:BR:L:2383/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-01-03", numero:"2383", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-01-03;2383", vigente:true, titulo:"Lei nº 2.383 de 03/01/1955", urn:"urn:lex:br:federal:lei:1955-01-03;2383", ementa:"Cria a Faculdade de Engenharia do Ceará.", arquivo:"federal/leis-ordinarias/1955/lei-2383-1955-01-03.md"}}, {id:"federal:BR:L:2505/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-06-11", numero:"2505", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-06-11;2505", vigente:true, titulo:"Lei nº 2.505 de 11/06/1955", urn:"urn:lex:br:federal:lei:1955-06-11;2505", ementa:"Modifica o art. 180 e seu § 3º do Decreto-lei nº 2.848, de 7 de dezembro de 1940 (Código Penal) e artigo 208, do Decreto-lei nº 6.227, de 24 de ;janeiro de 1944 (Código Penal Militar).", arquivo:"federal/leis-ordinarias/1955/lei-2505-1955-06-11.md"}}, {id:"federal:BR:L:2625/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-10-22", numero:"2625", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-10-22;2625", vigente:true, titulo:"Lei nº 2.625 de 22/10/1955", urn:"urn:lex:br:federal:lei:1955-10-22;2625", ementa:"Autoriza o Poder Executivo a abrir, ao Poder Judiciário - Justiça do   Trabalho - o crédito especial de Cr$ 77.973,50, para atender a despesas de   substituições e aluguel de imóveis do Tribunal Regional do Trabalho da Segunda   Região.", arquivo:"federal/leis-ordinarias/1955/lei-2625-1955-10-22.md"}}, {id:"federal:BR:L:2579/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-08-23", numero:"2579", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-08-23;2579", vigente:true, titulo:"Lei nº 2.579 de 23/08/1955", urn:"urn:lex:br:federal:lei:1955-08-23;2579", ementa:"Concede amparo aos ex-integrantes da Força Expedicionária Brasileira, julgados inválidos ou incapazes definitivamente para o serviço militar.", arquivo:"federal/leis-ordinarias/1955/lei-2579-1955-08-23.md"}}, {id:"federal:BR:L:2390/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-01-05", numero:"2390", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-01-05;2390", vigente:true, titulo:"Lei nº 2.390 de 05/01/1955", urn:"urn:lex:br:federal:lei:1955-01-05;2390", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério do Trabalho, Indústria   e Comércio, o crédito especial de Cr$ 1.100.000,00 para pagamento de diaristas   do mesmo Ministério.", arquivo:"federal/leis-ordinarias/1955/lei-2390-1955-01-05.md"}}, {id:"federal:BR:L:2632/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-10-24", numero:"2632", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-10-24;2632", vigente:true, titulo:"Lei nº 2.632 de 24/10/1955", urn:"urn:lex:b