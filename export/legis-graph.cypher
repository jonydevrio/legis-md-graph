949", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-12-24", numero:"1002", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-12-24;1002", vigente:true, titulo:"Lei nº 1.002 de 24/12/1949", urn:"urn:lex:br:federal:lei:1949-12-24;1002", ementa:"Dispõe sobre o pagamento dos débitos dos criadores e recriadores de gado bovino, e dá outras providências.", arquivo:"federal/leis-ordinarias/1949/lei-1002-1949-12-24.md"}}, {id:"federal:BR:L:603/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-01-02", numero:"603", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-01-02;603", vigente:true, titulo:"Lei nº 603 de 02/01/1949", urn:"urn:lex:br:federal:lei:1949-01-02;603", ementa:"Autoriza a abertura de crédito especial para despesas de amparo às   populações de municípios dos Estados de Pernambuco e Alagoas.", arquivo:"federal/leis-ordinarias/1949/lei-603-1949-01-02.md"}}, {id:"federal:BR:L:956/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-12-05", numero:"956", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-12-05;956", vigente:true, titulo:"Lei nº 956 de 05/12/1949", urn:"urn:lex:br:federal:lei:1949-12-05;956", ementa:"Autoriza a abertura de crédito especial para pagamento de proventos de   disponibilidade a Ramiro Batista Ferreira.", arquivo:"federal/leis-ordinarias/1949/lei-956-1949-12-05.md"}}, {id:"federal:BR:L:962/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-12-08", numero:"962", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-12-08;962", vigente:true, titulo:"Lei nº 962 de 08/12/1949", urn:"urn:lex:br:federal:lei:1949-12-08;962", ementa:"Autoriza o T