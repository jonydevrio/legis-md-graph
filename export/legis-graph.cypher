:BR:L:10831/2003", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2003, data:"2003-12-23", numero:"10831", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2003-12-23;10831", vigente:true, titulo:"Lei nº 10.831 de 23/12/2003", urn:"urn:lex:br:federal:lei:2003-12-23;10831", ementa:"Dispõe sobre a agricultura orgânica e dá outras providências.", arquivo:"federal/leis-ordinarias/2003/lei-10831-2003-12-23.md"}}, {id:"federal:BR:L:10660/2003", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2003, data:"2003-04-22", numero:"10660", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2003-04-22;10660", vigente:true, titulo:"Lei nº 10.660 de 22/04/2003", urn:"urn:lex:br:federal:lei:2003-04-22;10660", ementa:"Abre crédito extraordinário no valor de R$ 24.401.000,00, em favor do Ministério dos Transportes, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2003/lei-10660-2003-04-22.md"}}, {id:"federal:BR:L:10789/2003", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2003, data:"2003-11-28", numero:"10789", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2003-11-28;10789", vigente:true, titulo:"Lei nº 10.789 de 28/11/2003", urn:"urn:lex:br:federal:lei:2003-11-28;10789", ementa:"Altera a Lei nº 5.917, de 10 de setembro de 1973, que aprova o Plano Nacional de Viação, de modo a modificar a descrição da rodovia BR-422, na Relação Descritiva das Rodovias do Sistema Rodoviário Nacional.", arquivo:"federal/leis-ordinarias/2003/lei-10789-2003-11-28.md"}}, {id:"federal:BR:L:10833/2003", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2003, data:"2003-12-29", numero:"10833", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2003-12-29;10833", vigen