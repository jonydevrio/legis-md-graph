2-1948-12-22.md"}}, {id:"federal:BR:L:246/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-02-17", numero:"246", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-02-17;246", vigente:true, titulo:"Lei nº 246 de 17/02/1948", urn:"urn:lex:br:federal:lei:1948-02-17;246", ementa:"Autoriza a prestação de auxílio às populações dos Estados da Bahia,   Sergipe, Alagoas e Rio Grande do Norte.", arquivo:"federal/leis-ordinarias/1948/lei-246-1948-02-17.md"}}, {id:"federal:BR:L:369/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-09-09", numero:"369", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-09-09;369", vigente:true, titulo:"Lei nº 369-A de 09/09/1948", urn:"urn:lex:br:federal:lei:1948-09-09;369", ementa:"Aplica ao Decreto-lei nº 8.922, de 26 de janeiro de 1946, aos atuais   instrutores das disciplinas dos ensinos fundamental e complementar das Escolas   de Aeronáutica e Naval .", arquivo:"federal/leis-ordinarias/1948/lei-369-1948-09-09.md"}}, {id:"federal:BR:L:215/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-01-09", numero:"215", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-01-09;215", vigente:true, titulo:"Lei nº 215 de 09/01/1948", urn:"urn:lex:br:federal:lei:1948-01-09;215", ementa:"Autoriza o Poder Executivo a incorporar o Arsenal de Marinha do Rio de   Janeiro de Arsenal de Marinha da Ilha das Cobras.", arquivo:"federal/leis-ordinarias/1948/lei-215-1948-01-09.md"}}, {id:"federal:BR:L:251/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-02-17", numero:"251", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-02-17;251", vigente:true, titulo:"Lei nº 251 de 