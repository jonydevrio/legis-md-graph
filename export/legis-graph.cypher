/lei-239-1936-08-21.md"}}, {id:"federal:BR:L:236/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-08-15", numero:"236", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-08-15;236", vigente:true, titulo:"Lei nº 236 de 15/08/1936", urn:"urn:lex:br:federal:lei:1936-08-15;236", ementa:"Fica aberto, pelo Ministério da Agricultura, o credito extraordinário de 300:000$000, destinado ás obras de restauração do Jardim Botânico do Rio de Janeiro", arquivo:"federal/leis-ordinarias/1936/lei-236-1936-08-15.md"}}, {id:"federal:BR:L:228/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-07-24", numero:"228", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-07-24;228", vigente:true, titulo:"Lei nº 228 de 24/07/1936", urn:"urn:lex:br:federal:lei:1936-07-24;228", ementa:"Torna extensivos aos   empregados em hoteis e outros estabelecimentos os dispositivos da legislação   social attinentes aos empregados do   commercio", arquivo:"federal/leis-ordinarias/1936/lei-228-1936-07-24.md"}}, {id:"federal:BR:L:177/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-01-09", numero:"177", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-01-09;177", vigente:true, titulo:"Lei nº 177 de 09/01/1936", urn:"urn:lex:br:federal:lei:1936-01-09;177", ementa:"Abre diversos creditos ao Ministerio da Educação e Saude Publica", arquivo:"federal/leis-ordinarias/1936/lei-177-1936-01-09.md"}}, {id:"federal:BR:L:199/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-01-23", numero:"199", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-01-23;199", vigente:true, titulo:"Lei nº 199 de 23/01/1936", urn:"urn:lex:br:federal:lei:1936-01-23;199", ementa:"Autoriza o Poder Executivo a realizar acordos com os Estados, para   coordenar e desenvolver serviços pertinenetes à ação do Ministério da   Agricultura.", arquivo:"federal/leis-ordinarias/1936/lei-199-1936-01-23.md"}}, {id:"federal:BR:L:339/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-12-07", numero:"339", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-12-07;339", vigente:true, titulo:"Lei nº 339 de 07/12/1936", urn:"urn:lex:br:federal:lei:1936-12-07;339", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministerio das Relações Exteriores, o credito especial de 200:000$000 para cumprimento do decreto n. 24.609, de 1934, que creou Instituto Nacional de Estatistica", arquivo:"federal/leis-ordinarias/1936/lei-339-1936-12-07.md"}}, {id:"federal:BR:L:353/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-12-29", numero:"353", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-12-29;353", vigente:true, titulo:"Lei nº 353 de 29/12/1936", urn:"urn:lex:br:federal:lei:1936-12-29;353", ementa:"Autoriza o Poder Executivo a abrir pelo Ministerio da Justiça, o credito supplementar de 440:300$000, para reforço de diversas dotações do mesmo Ministerio.", arquivo:"federal/leis-ordinarias/1936/lei-353-1936-12-29.md"}}, {id:"federal:BR:L:328/1936", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-11-28", numero:"328", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-11-28;328", vigente:true, titulo:"Lei nº 328 de 28/11/1936", urn:"urn:lex:br:federal:lei:1936-11-28;328", ementa:"Autoriza a abrir, pelo Ministerio das Relações Exteriores, credito especial de 250:000$000, afim de attender ás despesas com os estudos para a construcção da ponte internacional sobre o rio Uruguay.", arquivo:"federal/leis-ordinarias/1936/lei-328-1936-11-28.md"}}, {id:"federal:BR:L:284/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-10-28", numero:"284", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-10-28;284", vigente:true, titulo:"Lei nº 284 de 28/10/1936", urn:"urn:lex:br:federal:lei:1936-10-28;284", ementa:"Reajusta os quadros e os vencimentos do funccionalismo publico civil da União e estabelece diversas providencias.", arquivo:"federal/leis-ordinarias/1936/lei-284-1936-10-28.md"}}, {id:"federal:BR:L:346/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-12-18", numero:"346", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-12-18;346", vigente:true, titulo:"Lei nº 346 de 18/12/1936", urn:"urn:lex:br:federal:lei:1936-12-18;346", ementa:"Autoriza o Governo a conceder ao Estado do Rio Grande do Sul um auxilio até 6.000:000$000, para attender aos damnos causados pelos ultimos temporaes e innundações, que se verificaram naquelle Estado", arquivo:"federal/leis-ordinarias/1936/lei-346-1936-12-18.md"}}, {id:"federal:BR:L:201/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-02-04", numero:"201", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-02-04;201", vigente:true, titulo:"Lei nº 201 de 04/02/1936", urn:"urn:lex:br:federal:lei:1936-02-04;201", ementa:"Autoriza o poder Executivo a applicar o saldo de 3.983:000$, das apolices emittidas pelo decreto n. 11.694, de 1915", arquivo:"federal/leis-ordinarias/1936/lei-201-1936-02-04.md"}}, {id:"federal:BR:L:268/1936", properties:{esfera:"federal", versao