4", numero:"3101", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1957-02-24;3101", vigente:true, titulo:"Lei nº 3.101 de 24/02/1957", urn:"urn:lex:br:federal:lei:1957-02-24;3101", ementa:"Cria cargos no Quadro do Pessoal da Justiça do Trabalho da 2ª   Região.", arquivo:"federal/leis-ordinarias/1957/lei-3101-1957-02-24.md"}}, {id:"federal:BR:L:3099/1957", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-02-24", numero:"3099", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1957-02-24;3099", vigente:true, titulo:"Lei nº 3.099 de 24/02/1957", urn:"urn:lex:br:federal:lei:1957-02-24;3099", ementa:"Determina as condições para o funcionamento de estabelecimento de   informações reservadas ou confidenciais, comerciais ou   particulares.", arquivo:"federal/leis-ordinarias/1957/lei-3099-1957-02-24.md"}}, {id:"federal:BR:L:3348/1957", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-12-17", numero:"3348", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1957-12-17;3348", vigente:true, titulo:"Lei nº 3.348 de 17/12/1957", urn:"urn:lex:br:federal:lei:1957-12-17;3348", ementa:"Concede os auxílios de Cr$ 2.000.000,00 e Cr$ 2.000.000,00 à Faculdade de Filosofia da cidade de Pelotas, no Estado do Rio Grande do Sul, e à Faculdade de Filosofia do Ceará.", arquivo:"federal/leis-ordinarias/1957/lei-3348-1957-12-17.md"}}, {id:"federal:BR:L:3188/1957", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-07-02", numero:"3188", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1957-07-02;3188", vigente:true, titulo:"Lei nº 3.188 de 02/07/1957", urn:"urn:lex:br:federal:lei:1957-07-02;3188", ementa:"Cria o Museu Nacional de Imigração e Colonização na cidade de Joinville,   Estado de Santa Catarina, e dá outras providências.", arquivo:"federal/leis-ordinarias/1957/lei-3188-1957-07-02.md"}}, {id:"federal:BR:L:3216/1957", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-07-19", numero:"3216", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1957-07-19;3216", vigente:true, titulo:"Lei nº 3.216 de 19/07/1957", urn:"urn:lex:br:federal:lei:1957-07-19;3216", ementa:"Autoriza o Poder Executivo a doar o terreno situado no pátio da Estação, à esquerda da linha férrea, à Prefeitura Municipal de Pouso Alegre, no Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/1957/lei-3216-1957-07-19.md"}}, {id:"federal:BR:L:3233/1957", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-07-29", numero:"3233", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1957-07-29;3233", vigente:true, titulo:"Lei nº 3.233 de 29/07/1957", urn:"urn:lex:br:federal:lei:1957-07-29;3233", ementa:"Concede a pensão especial de Cr$ 3.000,00 mensais a Rosália Maria de Almeida da Conceição, viúva de Vital da Conceição, ex-servidor federal.", arquivo:"federal/leis-ordinarias/1957/lei-3233-1957-07-29.md"}}, {id:"federal:BR:L:3265/1957", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-09-22", numero:"3265", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1957-09-22;3265", vigente:true, titulo:"Lei nº 3.265 de 22/09/1957", urn:"urn:lex:br:federal:lei:1957-09-22;3265", ementa:"Modifica disposições da Consolidação das Leis do Trabalho.", arquivo:"federal/leis-ordinarias/1957/lei-3265-1957-09-22.md"}}, {id:"federal:BR:L:3139/1957", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-05-17", numero:"3139", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:19