}, {id:"federal:BR:L:505/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-09-20", numero:"505", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-09-20;505", vigente:true, titulo:"Lei nº 505 de 20/09/1937", urn:"urn:lex:br:federal:lei:1937-09-20;505", ementa:"Manda incluir na dívida passiva da União o pagamento da diferença de   vencimentos, já reconhecido pelo art. 73 da lei n. 4.632, de 6 de janeiro de   1923, ao pessoal dos Arsenais de Marinha", arquivo:"federal/leis-ordinarias/1937/lei-505-1937-09-20.md"}}, {id:"federal:BR:L:479/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-08-18", numero:"479", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-08-18;479", vigente:true, titulo:"Lei nº 479 de 18/08/1937", urn:"urn:lex:br:federal:lei:1937-08-18;479", ementa:"Autoriza a despesa com o fornecimento de móveis à Diretoria de Estatistica Ecônomíca e Financeira do Ministério da Fazenda.", arquivo:"federal/leis-ordinarias/1937/lei-479-1937-08-18.md"}}, {id:"federal:BR:L:412/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-03-29", numero:"412", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-03-29;412", vigente:true, titulo:"Lei nº 412 de 29/03/1937", urn:"urn:lex:br:federal:lei:1937-03-29;412", ementa:"Revigora para o exercício de 1937, na sua parte não utilizada, o crédito   de dez mil contos de réis, aberto pelo decreto n.º 24.779, de 14 de julho de   1934", arquivo:"federal/leis-ordinarias/1937/lei-412-1937-03-29.md"}}, {id:"federal:BR:L:550/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-10-20", numero:"550", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-10-20;550", vigente:true, titulo:"Lei nº 550 de 20/10/1937", urn:"urn:lex:br:federal:lei:1937-10-20;550", ementa:"Autoriza a abrir o crédito suplementar de 30:000$000, para refôrço da   sub-consignação n. 4 (Secretaria de Estado) da Verba - Título I - Pessoal, do   vigente orçamento do Ministério de Viação e Obras Públicas", arquivo:"federal/leis-ordinarias/1937/lei-550-1937-10-20.md"}}, {id:"federal:BR:L:402/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-03-04", numero:"402", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-03-04;402", vigente:true, titulo:"Lei nº 402 de 04/03/1937", urn:"urn:lex:br:federal:lei:1937-03-04;402", ementa:"Altera o decreto n. 11.842, de 29 dezembro de 1915, com relação aos premios   de depositos publicos", arquivo:"federal/leis-ordinarias/1937/lei-402-1937-03-04.md"}}, {id:"federal:BR:L:495/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-09-02", numero:"495", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-09-02;495", vigente:true, titulo:"Lei nº 495 de 02/09/1937", urn:"urn:lex:br:federal:lei:1937-09-02;495", ementa:"Dispõe sobre o pessoal - Taquígrafos e Redatores de Documentos Parlamentares   e Anais - do quadro dos funcionário; da Secretaria da Câmara dos   Deputados", arquivo:"federal/leis-ordinarias/1937/lei-495-1937-09-02.md"}}, {id:"federal:BR:L:473/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-08-16", numero:"473", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-08-16;473", vigente:true, titulo:"Lei nº 473 de 16/08/1937", urn:"urn:lex:br:federal:lei:1937-08-16;473", ementa:"Autoriza a abrir o crédito suplementar de 3.000:000$000, para refôrço da   verba 1ª - Secretaria de Estado, sub-consignação n. 7 do vigente orçamen