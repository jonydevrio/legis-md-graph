4-2010-04-12.md"}}, {id:"federal:BR:L:12250/2010", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2010, data:"2010-06-11", numero:"12250", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2010-06-11;12250", vigente:true, titulo:"Lei nº 12.250 de 11/06/2010", urn:"urn:lex:br:federal:lei:2010-06-11;12250", ementa:"Dispõe sobre a criação de cargos de provimento efetivo no Quadro de Pessoal da Secretaria do Tribunal Regional do Trabalho da 24ª Região e dá outras providências.", arquivo:"federal/leis-ordinarias/2010/lei-12250-2010-06-11.md"}}, {id:"federal:BR:L:12211/2010", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2010, data:"2010-01-19", numero:"12211", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2010-01-19;12211", vigente:true, titulo:"Lei nº 12.211 de 19/01/2010", urn:"urn:lex:br:federal:lei:2010-01-19;12211", ementa:"Denomina Ponte de Integração Deputado Tristão da Cunha a ponte sobre o rio Grande, que liga, na BR-146, as cidades de Passos e São João Batista do Glória, no Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/2010/lei-12211-2010-01-19.md"}}, {id:"federal:BR:L:12302/2010", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2010, data:"2010-08-02", numero:"12302", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2010-08-02;12302", vigente:true, titulo:"Lei nº 12.302 de 02/08/2010", urn:"urn:lex:br:federal:lei:2010-08-02;12302", ementa:"Regulamenta o exercício da profissão de Instrutor de Trânsito.", arquivo:"federal/leis-ordinarias/2010/lei-12302-2010-08-02.md"}}, {id:"federal:BR:L:12190/2010", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2010, data:"2010-01-13", numero:"12190", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:l