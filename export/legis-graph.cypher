encia_origem:"revogada=false", ano:1994, data:"1994-04-20", numero:"8871", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1994-04-20;8871", vigente:true, titulo:"Lei nº 8.871 de 20/04/1994", urn:"urn:lex:br:federal:lei:1994-04-20;8871", ementa:"Autoriza o Poder Executivo a doar quinze aeronaves A-122-A (T-23) à Força   Boliviana.", arquivo:"federal/leis-ordinarias/1994/lei-8871-1994-04-20.md"}}, {id:"federal:BR:L:8904/1994", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1994, data:"1994-06-30", numero:"8904", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1994-06-30;8904", vigente:true, titulo:"Lei nº 8.904 de 30/06/1994", urn:"urn:lex:br:federal:lei:1994-06-30;8904", ementa:"Altera o art. 2º da Lei nº 8.352, de 28 de dezembro de 1991, com a redação dada pela Lei nº 8.736, de 29 de novembro de 1993, e o art. 2º da Lei nº 8.736, de 1993, que dispõe sobre as disponibilidades financeiras do Fundo de Amparo ao Trabalhador - FAT, e dá outras providências.", arquivo:"federal/leis-ordinarias/1994/lei-8904-1994-06-30.md"}}, {id:"federal:BR:L:8940/1994", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1994, data:"1994-11-25", numero:"8940", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1994-11-25;8940", vigente:true, titulo:"Lei nº 8.940 de 25/11/1994", urn:"urn:lex:br:federal:lei:1994-11-25;8940", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento da Seguridade Social da   União, em favor do Ministério da Integração Regional, crédito extraordinário no   valor de R$ 2.181.818,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1994/lei-8940-1994-11-25.md"}}, {id:"federal:BR:L:8873/1994", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1994, data:"1994-04-26", numero:"8873", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1994-04-26;8873", vigente:true, titulo:"Lei nº 8.873 de 26/04/1994", urn:"urn:lex:br:federal:lei:1994-04-26;8873", ementa:"Altera dispositivos da Lei nº 4.769, de 9 de setembro de 1965, que dispõe   sobre o exercício da profissão de Técnico de Administração.", arquivo:"federal/leis-ordinarias/1994/lei-8873-1994-04-26.md"}}, {id:"federal:BR:L:8918/1994", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1994, data:"1994-07-14", numero:"8918", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1994-07-14;8918", vigente:true, titulo:"Lei nº 8.918 de 14/07/1994", urn:"urn:lex:br:federal:lei:1994-07-14;8918", ementa:"Dispõe sobre a padronização, a classificação, o registro, a inspeção, a produção e a fiscalização de bebidas, autoriza a criação da Comissão Intersetorial de Bebidas e dá outras providências.", arquivo:"federal/leis-ordinarias/1994/lei-8918-1994-07-14.md"}}, {id:"federal:BR:L:8939/1994", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1994, data:"1994-11-25", numero:"8939", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1994-11-25;8939", vigente:true, titulo:"Lei nº 8.939 de 25/11/1994", urn:"urn:lex:br:federal:lei:1994-11-25;8939", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento da Seguridade Social da   União, em favor do Ministério do Exército, crédito extraordinário no valor de R$   1.106.410,00, para atender despesas com as etapas finais do Programa de   Distribuição Emergencial de Alimentos - PRODEA.", arquivo:"federal/leis-ordinarias/1994/lei-8939-1994-11-25.md"}}, {id:"federal:BR:L:8923/1994", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1994, data:"1994-07-27", numero:"8923", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1994-07-27;8923", vigente:true, titulo:"Lei nº 8.923 de 27/07/1994", urn:"