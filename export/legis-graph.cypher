ente:true, titulo:"Lei nº 13.447 de 31/05/2017", urn:"urn:lex:br:federal:lei:2017-05-31;13447", ementa:"Confere ao Município de Braço do Norte, no Estado de Santa Catarina, o título de Capital Nacional do Gado Jersey.", arquivo:"federal/leis-ordinarias/2017/lei-13447-2017-05-31.md"}}, {id:"federal:BR:L:13462/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-07-05", numero:"13462", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-07-05;13462", vigente:true, titulo:"Lei nº 13.462 de 05/07/2017", urn:"urn:lex:br:federal:lei:2017-07-05;13462", ementa:"Denomina Rodovia Abadio Pereira Cardoso o trecho da BR-060 entre a cidade de Goiânia e o entroncamento com a BR-452 e a GO-174, no Estado de Goiás.", arquivo:"federal/leis-ordinarias/2017/lei-13462-2017-07-05.md"}}, {id:"federal:BR:L:13537/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-12-15", numero:"13537", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-12-15;13537", vigente:true, titulo:"Lei nº 13.537 de 15/12/2017", urn:"urn:lex:br:federal:lei:2017-12-15;13537", ementa:"Confere ao Município de Terra Roxa, no Estado do Paraná, o título de Capital Nacional da Moda Bebê.", arquivo:"federal/leis-ordinarias/2017/lei-13537-2017-12-15.md"}}, {id:"federal:BR:L:13580/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-12-26", numero:"13580", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-12-26;13580", vigente:true, titulo:"Lei nº 13.580 de 26/12/2017", urn:"urn:lex:br:federal:lei:2017-12-26;13580", ementa:"Institui no Brasil o Dia Nacional do Educador Social.", arquivo:"federal/leis-ordinarias/2017/lei-13580-2017-12-26.md"}}, {id:"federal:BR:L:13465/2017", properties:{esfera:"federal", versao_texto:"compilada (texto vigent