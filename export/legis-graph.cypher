-8154-1990-12-28.md"}}, {id:"federal:BR:L:8067/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-07-12", numero:"8067", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-07-12;8067", vigente:true, titulo:"Lei nº 8.067 de 12/07/1990", urn:"urn:lex:br:federal:lei:1990-07-12;8067", ementa:"Altera dispositivo da Lei nº 6.389, de 9 de dezembro de 1976, que fixa as referências de salário dos empregados do Grupo-Processamento de Dados.", arquivo:"federal/leis-ordinarias/1990/lei-8067-1990-07-12.md"}}, {id:"federal:BR:L:8111/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-12-10", numero:"8111", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-12-10;8111", vigente:true, titulo:"Lei nº 8.111 de 10/12/1990", urn:"urn:lex:br:federal:lei:1990-12-10;8111", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento Fiscal da União crédito suplementar no valor de Cr$ 165.770.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1990/lei-8111-1990-12-10.md"}}, {id:"federal:BR:L:8009/1990", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-03-29", numero:"8009", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-03-29;8009", vigente:true, titulo:"Lei nº 8.009 de 29/03/1990", urn:"urn:lex:br:federal:lei:1990-03-29;8009", ementa:"Dispõe sobre a impenhorabilidade do bem de família.", arquivo:"federal/leis-ordinarias/1990/lei-8009-1990-03-29.md"}}, {id:"federal:BR:L:8092/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-11-19", numero:"8092", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-11-19;8092", vigente:true, titulo:"Lei nº 8.092 de 19/11/1990", urn:"urn:l