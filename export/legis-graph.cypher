inal", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-12-21", numero:"568", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-12-21;568", vigente:true, titulo:"Lei nº 568 de 21/12/1948", urn:"urn:lex:br:federal:lei:1948-12-21;568", ementa:"Autoriza a abertura do crédito suplementar para pagamento de aluguel de   prédio ocupado pela Agência Nacional.", arquivo:"federal/leis-ordinarias/1948/lei-568-1948-12-21.md"}}, {id:"federal:BR:L:438/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-10-18", numero:"438", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-10-18;438", vigente:true, titulo:"Lei nº 438 de 18/10/1948", urn:"urn:lex:br:federal:lei:1948-10-18;438", ementa:"Torna reservistas os pilôtos civis.", arquivo:"federal/leis-ordinarias/1948/lei-438-1948-10-18.md"}}, {id:"federal:BR:L:584/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-12-23", numero:"584", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-12-23;584", vigente:true, titulo:"Lei nº 584 de 23/12/1948", urn:"urn:lex:br:federal:lei:1948-12-23;584", ementa:"Autoriza a abertura, pelo Ministério da Educação e Saúde, do crédito   suplementar de Cr$ 704.800,00 , para o Instituto Osvaldo Cruz.", arquivo:"federal/leis-ordinarias/1948/lei-584-1948-12-23.md"}}, {id:"federal:BR:L:553/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-12-18", numero:"553", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-12-18;553", vigente:true, titulo:"Lei nº 553 de 18/12/1948", urn:"urn:lex:br:federal:lei:1948-12-18;553", ementa:"Concede isenção de direitos de importação para material destinado à Santa   Casa da Misericórdia do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1948/lei-553-1948-12-18.md"}}, {id:"federal:BR:L:249/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-02-17", numero:"249", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-02-17;249", vigente:true, titulo:"Lei nº 249 de 17/02/1948", urn:"urn:lex:br:federal:lei:1948-02-17;249", ementa:"Autoriza a abertura, pelo Ministério da Agricultura, de crédito especial   para pagamento de gratificação a José Augusto de Farias.", arquivo:"federal/leis-ordinarias/1948/lei-249-1948-02-17.md"}}, {id:"federal:BR:L:328/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-08-13", numero:"328", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-08-13;328", vigente:true, titulo:"Lei nº 328 de 13/08/1948", urn:"urn:lex:br:federal:lei:1948-08-13;328", ementa:"Autoriza a abertura, pelo Ministério das Relações Exteriores, de crédito especial para pagamento de contribuições ao Conselho Internacional do Trigo.", arquivo:"federal/leis-ordinarias/1948/lei-328-1948-08-13.md"}}, {id:"federal:BR:L:527/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-12-08", numero:"527", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-12-08;527", vigente:true, titulo:"Lei nº 527 de 08/12/1948", urn:"urn:lex:br:federal:lei:1948-12-08;527", ementa:"Concede isenção de direitos e demais taxas aduaneiras para material   importado pelo Governo do Estado de Pernambuco.", arquivo:"federal/leis-ordinarias/1948/lei-527-1948-12-08.md"}}, {id:"federal:BR:L:356/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-08-30", numero:"356", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-08-30;356", vigente:true, titulo:"Lei nº 356 de 30/08/1948"