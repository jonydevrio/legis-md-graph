, titulo:"Lei nº 4.196 de 24/12/1962", urn:"urn:lex:br:federal:lei:1962-12-24;4196", ementa:"Isenta dos impostos de importação e de consumo, equipamentos e acessórios destinados à montagem de uma estação transmissora para radiodifusão e televisão importados pela Fundação Casper Líbero, em São Paulo.", arquivo:"federal/leis-ordinarias/1962/lei-4196-1962-12-24.md"}}, {id:"federal:BR:L:4139/1962", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1962, data:"1962-09-21", numero:"4139", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1962-09-21;4139", vigente:true, titulo:"Lei nº 4.139 de 21/09/1962", urn:"urn:lex:br:federal:lei:1962-09-21;4139", ementa:"Autoriza a concessão da subvenção de Cr$ 2.000.000,00 (dois milhões de   cruzeiros) à Liga Bahiana Contra a Mortalidade Infantil para manutenção do   Hospital Martagão Gesteira.", arquivo:"federal/leis-ordinarias/1962/lei-4139-1962-09-21.md"}}, {id:"federal:BR:L:4077/1962", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1962, data:"1962-06-23", numero:"4077", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1962-06-23;4077", vigente:true, titulo:"Lei nº 4.077 de 23/06/1962", urn:"urn:lex:br:federal:lei:1962-06-23;4077", ementa:"Dispõe sobre a gratificação dos encarregados de postos de   Correio.", arquivo:"federal/leis-ordinarias/1962/lei-4077-1962-06-23.md"}}, {id:"federal:BR:L:4064/1962", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1962, data:"1962-05-19", numero:"4064", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1962-05-19;4064", vigente:true, titulo:"Lei nº 4.064 de 19/05/1962", urn:"urn:lex:br:federal:lei:1962-05-19;4064", ementa:"Isenta dos impostos de importação e de consumo meterial importado pela Companhia Telefônica de Pirapora, Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/1962/lei-4064-1962-05-19.md"}}, {id:"federal:BR:L:4108/1962", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1962, data:"1962-07-27", numero:"4108", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1962-07-27;4108", vigente:true, titulo:"Lei nº 4.108 de 27/07/1962", urn:"urn:lex:br:federal:lei:1962-07-27;4108", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Tribunal Regional   do Trabalho da 2ª Região, o crédito especial de Cr$ 7.700.000,00, para atender à   despesa de adaptação de nova sede daquele Tribunal.", arquivo:"federal/leis-ordinarias/1962/lei-4108-1962-07-27.md"}}, {id:"federal:BR:L:4125/1962", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1962, data:"1962-08-27", numero:"4125", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1962-08-27;4125", vigente:true, titulo:"Lei nº 4.125 de 27/08/1962", urn:"urn:lex:br:federal:lei:1962-08-27;4125", ementa:"Autoriza o Poder Executivo a doar um imóvel da União à Prefeitura   Municipal de Maranguape, Estado do Ceará.", arquivo:"federal/leis-ordinarias/1962/lei-4125-1962-08-27.md"}}, {id:"federal:BR:L:4094/1962", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1962, data:"1962-07-14", numero:"4094", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1962-07-14;4094", vigente:true, titulo:"Lei nº 4.094 de 14/07/1962", urn:"urn:lex:br:federal:lei:1962-07-14;4094", ementa:"Modifica o § 1º do art. 168 do Código do Processo Civil (Decreto-lei nº 1.608, de 18 de setembro de 1939).", arquivo:"federal/leis-ordinarias/1962/lei-4094-1962-07-14.md"}}, {id:"federal:BR:L:4181/1962", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1962, data:"1962-12-11", numero:"4181", fonte:"https://normas.leg.br/?urn=urn:lex:br:feder