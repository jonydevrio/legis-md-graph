UNWIND [{id:"federal:BR:L:6838/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-10-29", numero:"6838", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-10-29;6838", vigente:true, titulo:"Lei nº 6.838 de 29/10/1980", urn:"urn:lex:br:federal:lei:1980-10-29;6838", ementa:"Dispõe sobre o prazo prescricional para a punibilidade de profissional   liberal, por falta sujeita a processo disciplinar, a ser aplicada por órgão   competente.", arquivo:"federal/leis-ordinarias/1980/lei-6838-1980-10-29.md"}}, {id:"federal:BR:L:6779/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-05-12", numero:"6779", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-05-12;6779", vigente:true, titulo:"Lei nº 6.779 de 12/05/1980", urn:"urn:lex:br:federal:lei:1980-05-12;6779", ementa:"Altera a denominação da Categoria Funcional de Agente de Patrulha   Rodoviária, integrante do Grupo-Outras Atividades de Nível Médio, e dá outras   Providências.", arquivo:"federal/leis-ordinarias/1980/lei-6779-1980-05-12.md"}}, {id:"federal:BR:L:6781/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-05-19", numero:"6781", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-05-19;6781", vigente:true, titulo:"Lei nº 6.781 de 19/05/1980", urn:"urn:lex:br:federal:lei:1980-05-19;6781", ementa:"Dispõe sobre o enquadramento dos servidores remanescentes da implantação   do Plano de Classificação de Cargos instituído pela Lei n. 5645, de 10 de   dezembro de 1970, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6781-1980-05-19.md"}}, {id:"federal:BR:L:6828/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-09-22", numero:"6828", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-09-22;6828", vigente:true, titulo:"Lei nº 6.828 de 22/09/1980", urn:"urn:lex:br:federal:lei:1980-09-22;6828", ementa:"Autoriza a reversão, a Bento Luís de Almeida Prado, do terreno que   menciona.", arquivo:"federal/leis-ordinarias/1980/lei-6828-1980-09-22.md"}}, {id:"federal:BR:L:6894/1980", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-16", numero:"6894", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-16;6894", vigente:true, titulo:"Lei nº 6.894 de 16/12/1980", urn:"urn:lex:br:federal:lei:1980-12-16;6894", ementa:"Dispõe sobre a inspeção e fiscalização da produção e do comércio de fertilizantes, corretivos, inoculantes, estimulantes ou biofertilizantes, destinados à agricultura, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6894-1980-12-16.md"}}, {id:"federal:BR:L:6883/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-09", numero:"6883", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-09;6883", vigente:true, titulo:"Lei nº 6.883 de 09/12/1980", urn:"urn:lex:br:federal:lei:1980-12-09;6883", ementa:"Autoriza a alienação de bens imóveis da União, situados na área urbana de   Guajará-Mirim, no Território Federal de Rondônia, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6883-1980-12-09.md"}}, {id:"federal:BR:L:6865/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-01", numero:"6865", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-01;6865", vigente:true, titulo:"Lei nº 6.865 de 01/12/1980", urn:"urn:lex:br:federal:lei:1980-12-01;6865", ementa:"Retifica, sem ônus, a Lei nº 6730, de 3 de dezembro de 1979, que estima a Receita e fixa e Despesa da União para o exercício financeiro de 1980.", arquivo:"federal/leis-ordinarias/1980/lei-6865-1980-12-01.md"}}, {id:"federal:BR:L:6810/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-07-07", numero:"6810", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-07-07;6810", vigente:true, titulo:"Lei nº 6.810 de 07/07/1980", urn:"urn:lex:br:federal:lei:1980-07-07;6810", ementa:"Inclui entre os beneficiados pela Lei n. 6554, de 21 de agosto de 1978,   nos termos do diploma, os Ministros Togados, os Juízes Auditores e os Auditores   Substitutos da Justiça Militar, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6810-1980-07-07.md"}}, {id:"federal:BR:L:6780/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-05-12", numero:"6780", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-05-12;6780", vigente:true, titulo:"Lei nº 6.780 de 12/05/1980", urn:"urn:lex:br:federal:lei:1980-05-12;6780", ementa:"Acrescenta dispositivo ao art. 1218 da Lei n. 5869, de 11 de janeiro de   1973 (Código de Processo Civil).", arquivo:"federal/leis-ordinarias/1980/lei-6780-1980-05-12.md"}}, {id:"federal:BR:L:6846/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-12", numero:"6846", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-12;6846", vigente:true, titulo:"Lei nº 6.846 de 12/11/1980", urn:"urn:lex:br:federal:lei:1980-11-12;6846", ementa:"Autoriza o Governo do Distrito Federal a abrir créditos suplementares até   o limite de Cr$ 4.717.500.000,00 (quatro bilhões, setecentos e dezessete milhões   e quinhentos mil cruzeiros) e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6846-1980-11-12.md"}}, {id:"federal:BR:L:6891/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-11", numero:"6891", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-11;6891", vigente:true, titulo:"Lei nº 6.891 de 11/12/1980", urn:"urn:lex:br:federal:lei:1980-12-11;6891", ementa:"Transforma a Fundação Faculdade Católica de Medicina de Porto Alegre em   Fundação Faculdade Federal de Ciências Médicas de Porto Alegre, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1980/lei-6891-1980-12-11.md"}}, {id:"federal:BR:L:6872/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-03", numero:"6872", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-03;6872", vigente:true, titulo:"Lei nº 6.872 de 03/12/1980", urn:"urn:lex:br:federal:lei:1980-12-03;6872", ementa:"Aprova o Orçamento plurianual de investimentos do Distrito Federal para o   triênio 1981/1983.", arquivo:"federal/leis-ordinarias/1980/lei-6872-1980-12-03.md"}}, {id:"federal:BR:L:6789/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-05-28", numero:"6789", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-05-28;6789", vigente:true, titulo:"Lei nº 6.789 de 28/05/1980", urn:"urn:lex:br:federal:lei:1980-05-28;6789", ementa:"Modifica a redação do caput do art. 15 da Lei n. 6032, de 30 de abril de   1974 (Regimento de Custas da Justiça Federal) .", arquivo:"federal/leis-ordinarias/1980/lei-6789-1980-05-28.md"}}, {id:"federal:BR:L:6893/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-15", numero:"6893", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-15;6893", vigente:true, titulo:"Lei nº 6.893 de 15/12/1980", urn:"urn:lex:br:federal:lei:1980-12-15;6893", ementa:"Cria o Quadro Permanente da Secretaria do Tribunal Regional Eleitoral de Mato Grosso do Sul, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6893-1980-12-15.md"}}, {id:"federal:BR:L:6777/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-05-12", numero:"6777", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-05-12;6777", vigente:true, titulo:"Lei nº 6.777 de 12/05/1980", urn:"urn:lex:br:federal:lei:1980-05-12;6777", ementa:"Concede pensão especial a Joana Pereira da Silva e dá outras   providências.", arquivo:"federal/leis-ordinarias/1980/lei-6777-1980-05-12.md"}}, {id:"federal:BR:L:6826/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-09-22", numero:"6826", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-09-22;6826", vigente:true, titulo:"Lei nº 6.826 de 22/09/1980", urn:"urn:lex:br:federal:lei:1980-09-22;6826", ementa:"Autoriza a alienação de imóveis da União, situados no Município de   Tucuruí, Estado do Pará.", arquivo:"federal/leis-ordinarias/1980/lei-6826-1980-09-22.md"}}, {id:"federal:BR:L:6855/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-18", numero:"6855", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-18;6855", vigente:true, titulo:"Lei nº 6.855 de 18/11/1980", urn:"urn:lex:br:federal:lei:1980-11-18;6855", ementa:"Cria a Fundação Habitacional do Exército e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6855-1980-11-18.md"}}, {id:"federal:BR:L:6795/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-06-11", numero:"6795", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-06-11;6795", vigente:true, titulo:"Lei nº 6.795 de 11/06/1980", urn:"urn:lex:br:federal:lei:1980-06-11;6795", ementa:"Autoriza o Instituto Brasileiro do Café, Autarquia Federal vinculada ao   Ministério da Indústria e do comércio, a alienar imóvel de sua propriedade,   localizado na Cidade de Santos, Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1980/lei-6795-1980-06-11.md"}}, {id:"federal:BR:L:6858/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-24", numero:"6858", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-24;6858", vigente:true, titulo:"Lei nº 6.858 de 24/11/1980", urn:"urn:lex:br:federal:lei:1980-11-24;6858", ementa:"Dispõe sobre o pagamento, aos dependentes ou sucessores, de valores não recebidos em vida pelos respectivos titulares.", arquivo:"federal/leis-ordinarias/1980/lei-6858-1980-11-24.md"}}, {id:"federal:BR:L:6881/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-09", numero:"6881", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-09;6881", vigente:true, titulo:"Lei nº 6.881 de 09/12/1980", urn:"urn:lex:br:federal:lei:1980-12-09;6881", ementa:"Autoriza o Instituto Nacional de Colonização e Reforma Agrária - INCRA a   doar os imóveis que menciona.", arquivo:"federal/leis-ordinarias/1980/lei-6881-1980-12-09.md"}}, {id:"federal:BR:L:6796/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-06-18", numero:"6796", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-06-18;6796", vigente:true, titulo:"Lei nº 6.796 de 18/06/1980", urn:"urn:lex:br:federal:lei:1980-06-18;6796", ementa:"Autoriza o Instituto Brasileiro de Desenvolvimento Florestal - IBDF a   alienar os imóveis que menciona.", arquivo:"federal/leis-ordinarias/1980/lei-6796-1980-06-18.md"}}, {id:"federal:BR:L:6870/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-03", numero:"6870", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-03;6870", vigente:true, titulo:"Lei nº 6.870 de 03/12/1980", urn:"urn:lex:br:federal:lei:1980-12-03;6870", ementa:"Institui, na Fundação Projeto Rondon, a concessão de Bolsas Especiais a   estudantes, nas condições que especifica, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6870-1980-12-03.md"}}, {id:"federal:BR:L:6895/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-17", numero:"6895", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-17;6895", vigente:true, titulo:"Lei nº 6.895 de 17/12/1980", urn:"urn:lex:br:federal:lei:1980-12-17;6895", ementa:"Dá nova redação aos arts. 184 e 186 do Código Penal, aprovado pelo   Decreto-Lei nº 2848, de 7 de dezembro de 1940.", arquivo:"federal/leis-ordinarias/1980/lei-6895-1980-12-17.md"}}, {id:"federal:BR:L:6840/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-03", numero:"6840", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-03;6840", vigente:true, titulo:"Lei nº 6.840 de 03/11/1980", urn:"urn:lex:br:federal:lei:1980-11-03;6840", ementa:"Dispõe sobre títulos de crédito comercial e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6840-1980-11-03.md"}}, {id:"federal:BR:L:6876/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-09", numero:"6876", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-09;6876", vigente:true, titulo:"Lei nº 6.876 de 09/12/1980", urn:"urn:lex:br:federal:lei:1980-12-09;6876", ementa:"Autoriza o Poder Executivo a abrir ao Ministério das Relações Exteriores o   crédito especial até o limite de Cr$ 664.000.000,00 (seiscentos e sessenta e   quatro milhões de cruzeiros), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1980/lei-6876-1980-12-09.md"}}, {id:"federal:BR:L:6785/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-05-26", numero:"6785", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-05-26;6785", vigente:true, titulo:"Lei nº 6.785 de 26/05/1980", urn:"urn:lex:br:federal:lei:1980-05-26;6785", ementa:"Fixa os valores de retribuição de empregos que integram as Categorias   Funcionais de Assistente Jurídico e Procurador Autárquico, do Grupo-Serviços   Jurídicos, do Plano de Classificação de Cargos do Serviço Civil do Distrito   Federal, instituído pela Lei n. 5920, de 19 de setembro de 1973, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1980/lei-6785-1980-05-26.md"}}, {id:"federal:BR:L:6885/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-09", numero:"6885", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-09;6885", vigente:true, titulo:"Lei nº 6.885 de 09/12/1980", urn:"urn:lex:br:federal:lei:1980-12-09;6885", ementa:"Dispõe sobre a inscrição de médicos veterinários militares nos Conselhos   Regionais de Medicina Veterinária.", arquivo:"federal/leis-ordinarias/1980/lei-6885-1980-12-09.md"}}, {id:"federal:BR:L:6822/1980", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-09-22", numero:"6822", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-09-22;6822", vigente:true, titulo:"Lei nº 6.822 de 22/09/1980", urn:"urn:lex:br:federal:lei:1980-09-22;6822", ementa:"Dispõe sobre a cobrança executiva dos débitos fixados em acórdãos do   Tribunal de Contas da União, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6822-1980-09-22.md"}}, {id:"federal:BR:L:6783/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-05-20", numero:"6783", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-05-20;6783", vigente:true, titulo:"Lei nº 6.783 de 20/05/1980", urn:"urn:lex:br:federal:lei:1980-05-20;6783", ementa:"Autoriza a doação do terreno que menciona, situado no Município de Passo   Fundo, Estado do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1980/lei-6783-1980-05-20.md"}}, {id:"federal:BR:L:6811/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-07-08", numero:"6811", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-07-08;6811", vigente:true, titulo:"Lei nº 6.811 de 08/07/1980", urn:"urn:lex:br:federal:lei:1980-07-08;6811", ementa:"Dispõe sobre a destinação da taxa judiciária de que trata o artigo 20 do   Decreto-lei n. 115, de 25 de janeiro de 1967.", arquivo:"federal/leis-ordinarias/1980/lei-6811-1980-07-08.md"}}, {id:"federal:BR:L:6861/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-26", numero:"6861", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-26;6861", vigente:true, titulo:"Lei nº 6.861 de 26/11/1980", urn:"urn:lex:br:federal:lei:1980-11-26;6861", ementa:"Fixa a retribuição de grupos da sistemática de classificação de cargos e empregos do Serviço Civil dos Territórios Federais do Amapá, de Rondônia, e de Roraima, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6861-1980-11-26.md"}}, {id:"federal:BR:L:6832/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-09-30", numero:"6832", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-09-30;6832", vigente:true, titulo:"Lei nº 6.832 de 30/09/1980", urn:"urn:lex:br:federal:lei:1980-09-30;6832", ementa:"Revoga o art. 4º da Lei nº 6.516, de 13 de março de 1978, que declarou em   extinção o Quadro de Oficiais Farmacêuticos do Corpo de Oficiais da Ativa da   Aeronáutica, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6832-1980-09-30.md"}}, {id:"federal:BR:L:6848/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-12", numero:"6848", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-12;6848", vigente:true, titulo:"Lei nº 6.848 de 12/11/1980", urn:"urn:lex:br:federal:lei:1980-11-12;6848", ementa:"Dispõe sobre a expedição de documentos pela Fundação Legião Brasileira de   Assistência - L.B.A.", arquivo:"federal/leis-ordinarias/1980/lei-6848-1980-11-12.md"}}, {id:"federal:BR:L:6852/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-17", numero:"6852", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-17;6852", vigente:true, titulo:"Lei nº 6.852 de 17/11/1980", urn:"urn:lex:br:federal:lei:1980-11-17;6852", ementa:"Dá nova redação ao art. 1º da Lei nº 6756, de 17 de dezembro de 1979, que   autoriza o Departamento Nacional de Obras Contra as Secas - DNOCS a doar o   imóvel que menciona, situado no Município de Icó, Estado do Ceará.", arquivo:"federal/leis-ordinarias/1980/lei-6852-1980-11-17.md"}}, {id:"federal:BR:L:6888/1980", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-10", numero:"6888", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-10;6888", vigente:true, titulo:"Lei nº 6.888 de 10/12/1980", urn:"urn:lex:br:federal:lei:1980-12-10;6888", ementa:"Dispõe sobre o exercício da profissão de Sociólogo e dá outras providências", arquivo:"federal/leis-ordinarias/1980/lei-6888-1980-12-10.md"}}, {id:"federal:BR:L:6821/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-09-17", numero:"6821", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-09-17;6821", vigente:true, titulo:"Lei nº 6.821 de 17/09/1980", urn:"urn:lex:br:federal:lei:1980-09-17;6821", ementa:"Cancela penas impostas ao ex-Presidente Juscelino Kubitschek de Oliveira,   determina a devolução das condecorações nacionais que lhe foram retiradas, bem   como a sua reinclusão no quadros das respectivas ordens dos quais tenha sido   excluído. ;", arquivo:"federal/leis-ordinarias/1980/lei-6821-1980-09-17.md"}}, {id:"federal:BR:L:6806/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-07-07", numero:"6806", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-07-07;6806", vigente:true, titulo:"Lei nº 6.806 de 07/07/1980", urn:"urn:lex:br:federal:lei:1980-07-07;6806", ementa:"Autoriza o Poder Executivo a abrir créditos adicionais até o limite de Cr$   311.911.000.000,00, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6806-1980-07-07.md"}}, {id:"federal:BR:L:6880/1980", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-09", numero:"6880", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-09;6880", vigente:true, titulo:"Lei nº 6.880 de 09/12/1980", urn:"urn:lex:br:federal:lei:1980-12-09;6880", ementa:"Dispõe sobre o Estatuto dos Militares, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6880-1980-12-09.md"}}, {id:"federal:BR:L:6868/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-03", numero:"6868", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-03;6868", vigente:true, titulo:"Lei nº 6.868 de 03/12/1980", urn:"urn:lex:br:federal:lei:1980-12-03;6868", ementa:"Dispensa a apresentação dos documentos que especifica, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1980/lei-6868-1980-12-03.md"}}, {id:"federal:BR:L:6794/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-06-11", numero:"6794", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-06-11;6794", vigente:true, titulo:"Lei nº 6.794 de 11/06/1980", urn:"urn:lex:br:federal:lei:1980-06-11;6794", ementa:"Autoriza a reversão ao Município de Virginópolis, Estado de Minas Gerais,   do terreno que menciona e a doação das benfeitorias nele   construídas.", arquivo:"federal/leis-ordinarias/1980/lei-6794-1980-06-11.md"}}, {id:"federal:BR:L:6775/1980", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-04-23", numero:"6775", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-04-23;6775", vigente:true, titulo:"Lei nº 6.775 de 23/04/1980", urn:"urn:lex:br:federal:lei:1980-04-23;6775", ementa:"Reajusta os vencimentos e proventos dos servidores do Senado Federal e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6775-1980-04-23.md"}}, {id:"federal:BR:L:6773/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-04-07", numero:"6773", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-04-07;6773", vigente:true, titulo:"Lei nº 6.773 de 07/04/1980", urn:"urn:lex:br:federal:lei:1980-04-07;6773", ementa:"Inclui o curso superior de Nutrcionista entre os enumerados pela Lei n.   6.433, de 15 de julho de 1977, para ingresso na Categoria Funcional de   Sanitarista", arquivo:"federal/leis-ordinarias/1980/lei-6773-1980-04-07.md"}}, {id:"federal:BR:L:6774/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-04-15", numero:"6774", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-04-15;6774", vigente:true, titulo:"Lei nº 6.774 de 15/04/1980", urn:"urn:lex:br:federal:lei:1980-04-15;6774", ementa:"Concede pensão especial a Homero Francisco de Souza.", arquivo:"federal/leis-ordinarias/1980/lei-6774-1980-04-15.md"}}, {id:"federal:BR:L:6772/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-03-27", numero:"6772", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-03-27;6772", vigente:true, titulo:"Lei nº 6.772 de 27/03/1980", urn:"urn:lex:br:federal:lei:1980-03-27;6772", ementa:"Autoriza o Departamento Nacional de Obras Contra as Secas - DNOCS,   autarquia vinculada ao Ministério do Interior, a doar o imóvel que menciona,   situado no Município de Morada Nova, Estado do Ceará.", arquivo:"federal/leis-ordinarias/1980/lei-6772-1980-03-27.md"}}, {id:"federal:BR:L:6879/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-09", numero:"6879", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-09;6879", vigente:true, titulo:"Lei nº 6.879 de 09/12/1980", urn:"urn:lex:br:federal:lei:1980-12-09;6879", ementa:"Dispõe sobre o cancelamento de penas disciplinares.", arquivo:"federal/leis-ordinarias/1980/lei-6879-1980-12-09.md"}}, {id:"federal:BR:L:6803/1980", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-07-02", numero:"6803", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-07-02;6803", vigente:true, titulo:"Lei nº 6.803 de 02/07/1980", urn:"urn:lex:br:federal:lei:1980-07-02;6803", ementa:"Dispõe sobre as diretrizes básicas para o zoneamento industrial nas áreas críticas de poluição, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6803-1980-07-02.md"}}, {id:"federal:BR:L:6843/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-03", numero:"6843", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-03;6843", titulo:"Lei nº 6.843 de 03/11/1980", vigente:true, urn:"urn:lex:br:federal:lei:1980-11-03;6843", ementa:"Institui o Dia Nacional do Rotary.", arquivo:"federal/leis-ordinarias/1980/lei-6843-1980-11-03.md"}}, {id:"federal:BR:L:6819/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-09-09", numero:"6819", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-09-09;6819", vigente:true, titulo:"Lei nº 6.819 de 09/09/1980", urn:"urn:lex:br:federal:lei:1980-09-09;6819", ementa:"Autoriza a reversão ao Município de Castro, Estado do Paraná, do terreno   que menciona.", arquivo:"federal/leis-ordinarias/1980/lei-6819-1980-09-09.md"}}, {id:"federal:BR:L:6799/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-06-23", numero:"6799", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-06-23;6799", vigente:true, titulo:"Lei nº 6.799 de 23/06/1980", urn:"urn:lex:br:federal:lei:1980-06-23;6799", ementa:"Dispõe sobre causa de especial aumento de pena, quanto aos crimes contra a   Administração Pública, praticados por ocupantes de cargos em comissão da   administração direta e indireta, regula a forma de seu procedimento, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1980/lei-6799-1980-06-23.md"}}, {id:"federal:BR:L:6845/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-10", numero:"6845", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-10;6845", vigente:true, titulo:"Lei nº 6.845 de 10/11/1980", urn:"urn:lex:br:federal:lei:1980-11-10;6845", ementa:"Concede pensão especial vitalícia a Delma Rosendo Gehm.", arquivo:"federal/leis-ordinarias/1980/lei-6845-1980-11-10.md"}}, {id:"federal:BR:L:6834/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-10-13", numero:"6834", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-10-13;6834", vigente:true, titulo:"Lei nº 6.834 de 13/10/1980", urn:"urn:lex:br:federal:lei:1980-10-13;6834", ementa:"Autoriza a reversão aos Municípios de Jaguari, de Pelotas e de Marcelino   Ramos, no Estado do Rio Grande do Sul, dos terrenos que menciona.", arquivo:"federal/leis-ordinarias/1980/lei-6834-1980-10-13.md"}}, {id:"federal:BR:L:6875/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-09", numero:"6875", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-09;6875", vigente:true, titulo:"Lei nº 6.875 de 09/12/1980", urn:"urn:lex:br:federal:lei:1980-12-09;6875", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério do Interior, um crédito   especial até o limite de Cr$ 350.000.000,00 (trezentos e cinqüenta milhões de   cruzeiros), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1980/lei-6875-1980-12-09.md"}}, {id:"federal:BR:L:6782/1980", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-05-19", numero:"6782", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-05-19;6782", vigente:true, titulo:"Lei nº 6.782 de 19/05/1980", urn:"urn:lex:br:federal:lei:1980-05-19;6782", ementa:"Equipara ao acidente em serviço a doença profissional e as especificadas em lei para efeito de pensão especial e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6782-1980-05-19.md"}}, {id:"federal:BR:L:6790/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-05-29", numero:"6790", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-05-29;6790", vigente:true, titulo:"Lei nº 6.790 de 29/05/1980", urn:"urn:lex:br:federal:lei:1980-05-29;6790", ementa:"Revoga artigos das Leis ns. 6033, de 30 de abril de 1974, e 6082, de 10 de   julho de 1974, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6790-1980-05-29.md"}}, {id:"federal:BR:L:6829/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-09-22", numero:"6829", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-09-22;6829", vigente:true, titulo:"Lei nº 6.829 de 22/09/1980", urn:"urn:lex:br:federal:lei:1980-09-22;6829", ementa:"Autoriza o Departamento Nacional de Obras Contra as Secas - DNOCS,   autarquia vinculada ao Ministério do Interior, a doar a área de terreno que   menciona, situada no Município de Orós, no Estado do Ceará.", arquivo:"federal/leis-ordinarias/1980/lei-6829-1980-09-22.md"}}, {id:"federal:BR:L:6791/1980", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-06-09", numero:"6791", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-06-09;6791", vigente:true, titulo:"Lei nº 6.791 de 09/06/1980", urn:"urn:lex:br:federal:lei:1980-06-09;6791", ementa:"Institui o \"Dia Nacional da Mulher\".", arquivo:"federal/leis-ordinarias/1980/lei-6791-1980-06-09.md"}}, {id:"federal:BR:L:6839/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-10-30", numero:"6839", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-10-30;6839", vigente:true, titulo:"Lei nº 6.839 de 30/10/1980", urn:"urn:lex:br:federal:lei:1980-10-30;6839", ementa:"Dispõe sobre o registro de empresas nas entidades fiscalizadoras do   exercício de profissões.", arquivo:"federal/leis-ordinarias/1980/lei-6839-1980-10-30.md"}}, {id:"federal:BR:L:6770/1980", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-03-25", numero:"6770", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-03-25;6770", vigente:true, titulo:"Lei nº 6.770 de 25/03/1980", urn:"urn:lex:br:federal:lei:1980-03-25;6770", ementa:"Reajusta os vencimentos e salários dos servidores da Câmara dos Deputados, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6770-1980-03-25.md"}}, {id:"federal:BR:L:6851/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-17", numero:"6851", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-17;6851", vigente:true, titulo:"Lei nº 6.851 de 17/11/1980", urn:"urn:lex:br:federal:lei:1980-11-17;6851", ementa:"Altera dispositivos da Lei nº 5869, de 11 de janeiro de 1973 (Código de   Processo Civil).", arquivo:"federal/leis-ordinarias/1980/lei-6851-1980-11-17.md"}}, {id:"federal:BR:L:6873/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-03", numero:"6873", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-03;6873", vigente:true, titulo:"Lei nº 6.873 de 03/12/1980", urn:"urn:lex:br:federal:lei:1980-12-03;6873", ementa:"Estima a Receita e Fixa a Despesa do Distrito Federal para o Exercício   Financeiro de 1981.", arquivo:"federal/leis-ordinarias/1980/lei-6873-1980-12-03.md"}}, {id:"federal:BR:L:6830/1980", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-09-22", numero:"6830", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-09-22;6830", vigente:true, titulo:"Lei nº 6.830 de 22/09/1980", urn:"urn:lex:br:federal:lei:1980-09-22;6830", ementa:"Dispõe sobre a cobrança judicial da Dívida Ativa da Fazenda Pública e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6830-1980-09-22.md"}}, {id:"federal:BR:L:6892/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-11", numero:"6892", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-11;6892", vigente:true, titulo:"Lei nº 6.892 de 11/12/1980", urn:"urn:lex:br:federal:lei:1980-12-11;6892", ementa:"Declara de utilidade pública, para fins de desapropriação, ações da   Companhia Pontagrossense de Telecomunicações - CPT.", arquivo:"federal/leis-ordinarias/1980/lei-6892-1980-12-11.md"}}, {id:"federal:BR:L:6847/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-12", numero:"6847", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-12;6847", vigente:true, titulo:"Lei nº 6.847 de 12/11/1980", urn:"urn:lex:br:federal:lei:1980-11-12;6847", ementa:"Fixa os valores de retribuição de empregos da Categoria Funcional de   Agente de Trânsito, do Plano de Classificação de Cargos instituído pela Lei nº   5920, de 19 de setembro de 1973.", arquivo:"federal/leis-ordinarias/1980/lei-6847-1980-11-12.md"}}, {id:"federal:BR:L:6778/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-05-12", numero:"6778", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-05-12;6778", vigente:true, titulo:"Lei nº 6.778 de 12/05/1980", urn:"urn:lex:br:federal:lei:1980-05-12;6778", ementa:"Estende aos funcionários aposentados da Administração Direta do Distrito   Federal as vantagens financeiras decorrentes da aplicação do Plano de   Classificação de Cargos, instituído pela Lei n. 5920, de 19 de setembro de 1973,   e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6778-1980-05-12.md"}}, {id:"federal:BR:L:6808/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-07-07", numero:"6808", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-07-07;6808", vigente:true, titulo:"Lei nº 6.808 de 07/07/1980", urn:"urn:lex:br:federal:lei:1980-07-07;6808", ementa:"Cria cargos no Quadro Permanente do Senado Federal, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1980/lei-6808-1980-07-07.md"}}, {id:"federal:BR:L:6816/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-08-25", numero:"6816", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-08-25;6816", vigente:true, titulo:"Lei nº 6.816 de 25/08/1980", urn:"urn:lex:br:federal:lei:1980-08-25;6816", ementa:"Dá nova redação ao caput do art. 2º da Lei n. 5861, de 12 de   dezembro de 1972, que autorizou a constituição da Companhia Imobiliária de   Brasília - TERRACAP, e acrescenta parágrafo, renumerando os demais.", arquivo:"federal/leis-ordinarias/1980/lei-6816-1980-08-25.md"}}, {id:"federal:BR:L:6882/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-09", numero:"6882", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-09;6882", vigente:true, titulo:"Lei nº 6.882 de 09/12/1980", urn:"urn:lex:br:federal:lei:1980-12-09;6882", ementa:"Autoriza o Instituto Nacional de Colonização e Reforma Agrária - INCRA a   doar o imóvel que menciona.", arquivo:"federal/leis-ordinarias/1980/lei-6882-1980-12-09.md"}}, {id:"federal:BR:L:6856/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-18", numero:"6856", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-18;6856", vigente:true, titulo:"Lei nº 6.856 de 18/11/1980", urn:"urn:lex:br:federal:lei:1980-11-18;6856", ementa:"Fixa os valores de retribuição do Grupo-Atividades Específicas de Controle Interno, autoriza a estruturação de cargos e funções de órgãos integrantes do sistema de controle interno, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6856-1980-11-18.md"}}, {id:"federal:BR:L:6889/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-11", numero:"6889", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-11;6889", vigente:true, titulo:"Lei nº 6.889 de 11/12/1980", urn:"urn:lex:br:federal:lei:1980-12-11;6889", ementa:"Dispõe sobre a criação e extinção de cargos dos Quadros Permanentes das Secretarias do Superior Tribunal Militar e das Auditorias da Justiça Militar, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6889-1980-12-11.md"}}, {id:"federal:BR:L:6827/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-09-22", numero:"6827", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-09-22;6827", vigente:true, titulo:"Lei nº 6.827 de 22/09/1980", urn:"urn:lex:br:federal:lei:1980-09-22;6827", ementa:"Autoriza a permuta dos terrenos que menciona, situados nos Municípios do   Rio de Janeiro e de Campos, no Estado do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1980/lei-6827-1980-09-22.md"}}, {id:"federal:BR:L:6797/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-06-18", numero:"6797", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-06-18;6797", vigente:true, titulo:"Lei nº 6.797 de 18/06/1980", urn:"urn:lex:br:federal:lei:1980-06-18;6797", ementa:"Autoriza o Poder Executivo a doar o prédio que menciona.", arquivo:"federal/leis-ordinarias/1980/lei-6797-1980-06-18.md"}}, {id:"federal:BR:L:6835/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-10-14", numero:"6835", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-10-14;6835", vigente:true, titulo:"Lei nº 6.835 de 14/10/1980", urn:"urn:lex:br:federal:lei:1980-10-14;6835", ementa:"Dispõe sobre o exercício da profissão de Meteorologista e dá outras   providências.", arquivo:"federal/leis-ordinarias/1980/lei-6835-1980-10-14.md"}}, {id:"federal:BR:L:6864/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-01", numero:"6864", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-01;6864", vigente:true, titulo:"Lei nº 6.864 de 01/12/1980", urn:"urn:lex:br:federal:lei:1980-12-01;6864", ementa:"Estende aos servidores estaduais e municipais, nas condições que menciona, a contagem recíproca de tempo de serviço para aposentadoria, de que trata a Lei nº 6.226, de 14 de julho de 1975.", arquivo:"federal/leis-ordinarias/1980/lei-6864-1980-12-01.md"}}, {id:"federal:BR:L:6788/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-05-28", numero:"6788", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-05-28;6788", vigente:true, titulo:"Lei nº 6.788 de 28/05/1980", urn:"urn:lex:br:federal:lei:1980-05-28;6788", ementa:"Dispõe sobre a reestruturação das carreiras do Ministério Público da União   junto à Justiça Comum, do Trabalho e Militar, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1980/lei-6788-1980-05-28.md"}}, {id:"federal:BR:L:6860/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-24", numero:"6860", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-24;6860", vigente:true, titulo:"Lei nº 6.860 de 24/11/1980", urn:"urn:lex:br:federal:lei:1980-11-24;6860", ementa:"Autoriza o Poder Executivo a instituir a Fundação Petrônio Portella, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6860-1980-11-24.md"}}, {id:"federal:BR:L:6871/1980", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-03", numero:"6871", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-03;6871", vigente:true, titulo:"Lei nº 6.871 de 03/12/1980", urn:"urn:lex:br:federal:lei:1980-12-03;6871", ementa:"Autoriza o Poder Executivo a instituir a Fundação Centro de Formação do Servidor Público - FUNCEP, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6871-1980-12-03.md"}}, {id:"federal:BR:L:6801/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-06-25", numero:"6801", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-06-25;6801", vigente:true, titulo:"Lei nº 6.801 de 25/06/1980", urn:"urn:lex:br:federal:lei:1980-06-25;6801", ementa:"Dispõe sobre a criação do cargo em comissão de Secretário do Conselho   Nacional da Magistratura e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6801-1980-06-25.md"}}, {id:"federal:BR:L:6890/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-11", numero:"6890", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-11;6890", vigente:true, titulo:"Lei nº 6.890 de 11/12/1980", urn:"urn:lex:br:federal:lei:1980-12-11;6890", ementa:"Dispõe sobre a contagem do tempo de serviço prestado por extranumerário,   diarista ou tarefeiro, bem como pelo pessoal retribuído à conta de dotação   global, na forma que especifica, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6890-1980-12-11.md"}}, {id:"federal:BR:L:6877/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-09", numero:"6877", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-09;6877", vigente:true, titulo:"Lei nº 6.877 de 09/12/1980", urn:"urn:lex:br:federal:lei:1980-12-09;6877", ementa:"Restabelece direito de servidores públicos, no caso que especifica.", arquivo:"federal/leis-ordinarias/1980/lei-6877-1980-12-09.md"}}, {id:"federal:BR:L:6850/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-12", numero:"6850", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-12;6850", vigente:true, titulo:"Lei nº 6.850 de 12/11/1980", urn:"urn:lex:br:federal:lei:1980-11-12;6850", ementa:"Altera a Lei nº 6015, de 31 de dezembro de 1973 - Lei dos Registros   Públicos, compatibizando-a com o vigente Código de Processo Civil.", arquivo:"federal/leis-ordinarias/1980/lei-6850-1980-11-12.md"}}, {id:"federal:BR:L:6786/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-05-26", numero:"6786", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-05-26;6786", vigente:true, titulo:"Lei nº 6.786 de 26/05/1980", urn:"urn:lex:br:federal:lei:1980-05-26;6786", ementa:"Altera a redação dos parágrafos 1º e 2º do artigo 34 da Lei n. 4345, de 26   de junho de 1964, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6786-1980-05-26.md"}}, {id:"federal:BR:L:6814/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-08-05", numero:"6814", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-08-05;6814", vigente:true, titulo:"Lei nº 6.814 de 05/08/1980", urn:"urn:lex:br:federal:lei:1980-08-05;6814", ementa:"Altera dispositivos da Lei nº 5.821, de 10 de novembro de 1972, que dispõe   sobre as promoções dos oficiais da ativa das Forças Armadas e dá outras   providências.", arquivo:"federal/leis-ordinarias/1980/lei-6814-1980-08-05.md"}}, {id:"federal:BR:L:6784/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-05-20", numero:"6784", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-05-20;6784", vigente:true, titulo:"Lei nº 6.784 de 20/05/1980", urn:"urn:lex:br:federal:lei:1980-05-20;6784", ementa:"Dispõe sobre o Conselho de Justificação das Polícias Militares dos   Territórios Federais do Amapá, de Roraima e de Rondônia e dá outras   providências.", arquivo:"federal/leis-ordinarias/1980/lei-6784-1980-05-20.md"}}, {id:"federal:BR:L:6792/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-06-11", numero:"6792", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-06-11;6792", vigente:true, titulo:"Lei nº 6.792 de 11/06/1980", urn:"urn:lex:br:federal:lei:1980-06-11;6792", ementa:"Autoriza a doação da \"Ilha do Pinheiro\", situada na Baía da Guanabara,   ao Banco Nacional da Habitação, para implantação de conjuntos habitacionais de   interesse social .", arquivo:"federal/leis-ordinarias/1980/lei-6792-1980-06-11.md"}}, {id:"federal:BR:L:6866/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-03", numero:"6866", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-03;6866", vigente:true, titulo:"Lei nº 6.866 de 03/12/1980", urn:"urn:lex:br:federal:lei:1980-12-03;6866", ementa:"Aprova o Orçamento Plurianual de Investimentos para o triênio 1981/1983.", arquivo:"federal/leis-ordinarias/1980/lei-6866-1980-12-03.md"}}, {id:"federal:BR:L:6820/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-09-16", numero:"6820", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-09-16;6820", vigente:true, titulo:"Lei nº 6.820 de 16/09/1980", urn:"urn:lex:br:federal:lei:1980-09-16;6820", ementa:"Dá nova redação ao art. 923 da Lei n° ;5.869, de 11 de janeiro de 1973   - Código de Processo Civil.", arquivo:"federal/leis-ordinarias/1980/lei-6820-1980-09-16.md"}}, {id:"federal:BR:L:6831/1980", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-09-23", numero:"6831", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-09-23;6831", vigente:true, titulo:"Lei nº 6.831 de 23/09/1980", urn:"urn:lex:br:federal:lei:1980-09-23;6831", ementa:"Dispõe sobre a criação de cargos em órgãos dos Serviços Auxiliares da Justiça do Distrito Federal e dos Territórios, e dá outras providências. ;", arquivo:"federal/leis-ordinarias/1980/lei-6831-1980-09-23.md"}}, {id:"federal:BR:L:6823/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-09-22", numero:"6823", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-09-22;6823", vigente:true, titulo:"Lei nº 6.823 de 22/09/1980", urn:"urn:lex:br:federal:lei:1980-09-22;6823", ementa:"Altera o valor do vencimento mensal dos cargos que especifica, previstos   no artigo 5º da Lei n° ;5.921, de 1973, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6823-1980-09-22.md"}}, {id:"federal:BR:L:6804/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-07-07", numero:"6804", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-07-07;6804", vigente:true, titulo:"Lei nº 6.804 de 07/07/1980", urn:"urn:lex:br:federal:lei:1980-07-07;6804", ementa:"Dispõe sobre o Conselho de Disciplina das Polícias Militares dos   Territórios Federais do Amapá, de Roraima e de Rondônia, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1980/lei-6804-1980-07-07.md"}}, {id:"federal:BR:L:6853/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-17", numero:"6853", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-17;6853", vigente:true, titulo:"Lei nº 6.853 de 17/11/1980", urn:"urn:lex:br:federal:lei:1980-11-17;6853", ementa:"Cria a Procuradoria da República no Estado do Mato Grosso do Sul, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6853-1980-11-17.md"}}, {id:"federal:BR:L:6886/1980", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-10", numero:"6886", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-10;6886", vigente:true, titulo:"Lei nº 6.886 de 10/12/1980", urn:"urn:lex:br:federal:lei:1980-12-10;6886", ementa:"Altera a Lei nº 6.708, de 30 de outubro de 1979, que dispõe sobre a correção automática dos salários, modifica a política salarial e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6886-1980-12-10.md"}}, {id:"federal:BR:L:6849/1980", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-12", numero:"6849", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-12;6849", vigente:true, titulo:"Lei nº 6.849 de 12/11/1980", urn:"urn:lex:br:federal:lei:1980-11-12;6849", ementa:"Fixa os valores de retribuição da Categoria Funcional de Agente de Vigilância, e dá outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6849-1980-11-12.md"}}, {id:"federal:BR:L:5667/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-06-21", numero:"5667", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-06-21;5667", vigente:true, titulo:"Lei nº 5.667 de 21/06/1971", urn:"urn:lex:br:federal:lei:1971-06-21;5667", ementa:"Concede pensão especial ao Compositor Mozart Camargo   Guarnieri.", arquivo:"federal/leis-ordinarias/1971/lei-5667-1971-06-21.md"}}, {id:"federal:BR:L:5675/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-07-12", numero:"5675", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-07-12;5675", vigente:true, titulo:"Lei nº 5.675 de 12/07/1971", urn:"urn:lex:br:federal:lei:1971-07-12;5675", ementa:"Dá nova redação ao art. 77 do Decreto nº 5.083, de 1 de dezembro de 1926,   que institui o Código de Menores.", arquivo:"federal/leis-ordinarias/1971/lei-5675-1971-07-12.md"}}, {id:"federal:BR:L:5729/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-11-08", numero:"5729", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-11-08;5729", vigente:true, titulo:"Lei nº 5.729 de 08/11/1971", urn:"urn:lex:br:federal:lei:1971-11-08;5729", ementa:"Altera o parágrafo 2º do art. 141 da Lei nº 3.807, de 26 de agosto de   1960, que dispõe sobre a Lei Orgânica da Previdência Social.", arquivo:"federal/leis-ordinarias/1971/lei-5729-1971-11-08.md"}}, {id:"federal:BR:L:5657/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-06-04", numero:"5657", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-06-04;5657", vigente:true, titulo:"Lei nº 5.657 de 04/06/1971", urn:"urn:lex:br:federal:lei:1971-06-04;5657", ementa:"Altera a redação do parágrafo 1º do art. 662 da Consolidação das Leis do   Trabalho.", arquivo:"federal/leis-ordinarias/1971/lei-5657-1971-06-04.md"}}, {id:"federal:BR:L:5690/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-08-05", numero:"5690", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-08-05;5690", vigente:true, titulo:"Lei nº 5.690 de 05/08/1971", urn:"urn:lex:br:federal:lei:1971-08-05;5690", ementa:"Dá a denominação de \"Coaracy Nunes\" à Usina Hidrelétrica da cachoeira do   Paredão, no Território Federal do Amapá.", arquivo:"federal/leis-ordinarias/1971/lei-5690-1971-08-05.md"}}, {id:"federal:BR:L:5745/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-01", numero:"5745", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-01;5745", vigente:true, titulo:"Lei nº 5.745 de 01/12/1971", urn:"urn:lex:br:federal:lei:1971-12-01;5745", ementa:"Denomina \"Porto Barão de Teffé\" o Porto de Antonina, no Estado do   Paraná.", arquivo:"federal/leis-ordinarias/1971/lei-5745-1971-12-01.md"}}, {id:"federal:BR:L:5761/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-03", numero:"5761", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-03;5761", vigente:true, titulo:"Lei nº 5.761 de 03/12/1971", urn:"urn:lex:br:federal:lei:1971-12-03;5761", ementa:"Prorroga o prazo estabelecido no ítem I do artigo 14 do Decreto-lei   nº ;61, de 21 de novembro de 1966, que altera a legislação relativa ao   Imposto Único sobre lubrificantes e combustíveis líquidos e gasosos e dá outras   providências.", arquivo:"federal/leis-ordinarias/1971/lei-5761-1971-12-03.md"}}, {id:"federal:BR:L:5730/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-11-08", numero:"5730", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-11-08;5730", vigente:true, titulo:"Lei nº 5.730 de 08/11/1971", urn:"urn:lex:br:federal:lei:1971-11-08;5730", ementa:"Altera o Decreto-lei nº 1.040, de 21 de outubro de 1969, que dispõe sobre   os Conselhos Federal e Regionais de Contabilidade, regula a eleição de seus   membros e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5730-1971-11-08.md"}}, {id:"federal:BR:L:5689/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-08-05", numero:"5689", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-08-05;5689", vigente:true, titulo:"Lei nº 5.689 de 05/08/1971", urn:"urn:lex:br:federal:lei:1971-08-05;5689", ementa:"Dá nova redação à Tebela L do Decreto-lei nº 115, de 25 de janeiro de   1967, que aprova o Regimento de Custas da Justiça do Distrito Federal e dá   outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5689-1971-08-05.md"}}, {id:"federal:BR:L:5722/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-10-26", numero:"5722", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-10-26;5722", vigente:true, titulo:"Lei nº 5.722 de 26/10/1971", urn:"urn:lex:br:federal:lei:1971-10-26;5722", ementa:"Autoriza o Poder Executivo a doar uma aeronave A-122 à Escuela Nacional de   Aeronáutica Civil, da República do Paraguai.", arquivo:"federal/leis-ordinarias/1971/lei-5722-1971-10-26.md"}}, {id:"federal:BR:L:5708/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-10-04", numero:"5708", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-10-04;5708", vigente:true, titulo:"Lei nº 5.708 de 04/10/1971", urn:"urn:lex:br:federal:lei:1971-10-04;5708", ementa:"Dispõe sobre a gratificação pela participação em órgãos de deliberação coletiva.", arquivo:"federal/leis-ordinarias/1971/lei-5708-1971-10-04.md"}}, {id:"federal:BR:L:5770/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-21", numero:"5770", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-21;5770", vigente:true, titulo:"Lei nº 5.770 de 21/12/1971", urn:"urn:lex:br:federal:lei:1971-12-21;5770", ementa:"Dá nova redação ao art. 7º do Decreto-lei nº ;43, de 18 de novembro de 1966, que cria o Instituto Nacional do Cinema, torna da exclusiva competência da União a censura de filmes, estende aos pagamentos do exterior de filmes adquiridos a preços fixos o disposto no art. 45 da Lei nº ;4.131, de 3 de setembro de 1962, prorroga por 6 meses dispositivos da legislação sobre a exibição de filmes nacionais e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5770-1971-12-21.md"}}, {id:"federal:BR:L:5741/1971", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-01", numero:"5741", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-01;5741", vigente:true, titulo:"Lei nº 5.741 de 01/12/1971", urn:"urn:lex:br:federal:lei:1971-12-01;5741", ementa:"Dispõe sobre a proteção do financiamento de bens imóveis vinculados ao Sistema Financeiro da Habitação.", arquivo:"federal/leis-ordinarias/1971/lei-5741-1971-12-01.md"}}, {id:"federal:BR:L:5687/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-08-03", numero:"5687", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-08-03;5687", vigente:true, titulo:"Lei nº 5.687 de 03/08/1971", urn:"urn:lex:br:federal:lei:1971-08-03;5687", ementa:"Concede aumento de vencimentos aos funcionários da Secretaria-Geral do   Tribunal de Contas da União e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5687-1971-08-03.md"}}, {id:"federal:BR:L:5707/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-09-27", numero:"5707", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-09-27;5707", vigente:true, titulo:"Lei nº 5.707 de 27/09/1971", urn:"urn:lex:br:federal:lei:1971-09-27;5707", ementa:"Dá nova redação ao caput    do art. 1º e ao art. 3º da Lei nº 5591, de 16 de julho de   1970, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5707-1971-09-27.md"}}, {id:"federal:BR:L:5694/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-08-23", numero:"5694", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-08-23;5694", vigente:true, titulo:"Lei nº 5.694 de 23/08/1971", urn:"urn:lex:br:federal:lei:1971-08-23;5694", ementa:"Dá nova redação ao item I do § 4º do art. 64 da Lei nº 3.807, de 26 de   agosto de 1960, que dispõe sobre a Lei Orgânica da Previdência   Social.", arquivo:"federal/leis-ordinarias/1971/lei-5694-1971-08-23.md"}}, {id:"federal:BR:L:5658/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-06-07", numero:"5658", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-06-07;5658", vigente:true, titulo:"Lei nº 5.658 de 07/06/1971", urn:"urn:lex:br:federal:lei:1971-06-07;5658", ementa:"Dispõe sobre a venda de bens imóveis, pelos Ministérios da Aeronáutica e   da Marinha, sobre a aplicação do produto da operação, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1971/lei-5658-1971-06-07.md"}}, {id:"federal:BR:L:5725/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-10-27", numero:"5725", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-10-27;5725", vigente:true, titulo:"Lei nº 5.725 de 27/10/1971", urn:"urn:lex:br:federal:lei:1971-10-27;5725", ementa:"Estabelece a permissão do desconto no salário do empregado de prestações relativas ao financiamento para aquisição de unidade habitacional, no Sistema Financeiro de Habitação.", arquivo:"federal/leis-ordinarias/1971/lei-5725-1971-10-27.md"}}, {id:"federal:BR:L:5703/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-09-14", numero:"5703", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-09-14;5703", vigente:true, titulo:"Lei nº 5.703 de 14/09/1971", urn:"urn:lex:br:federal:lei:1971-09-14;5703", ementa:"Concede pensão especial a beneficiários legais de menbro integrante do   grupo de atração e pacificação dos índios Cintas Largas.", arquivo:"federal/leis-ordinarias/1971/lei-5703-1971-09-14.md"}}, {id:"federal:BR:L:5709/1971", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-10-07", numero:"5709", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-10-07;5709", vigente:true, titulo:"Lei nº 5.709 de 07/10/1971", urn:"urn:lex:br:federal:lei:1971-10-07;5709", ementa:"Regula a aquisição de imóvel rural por estrangeiro residente no País ou pessoa jurídica estrangeira autorizada a funcionar no Brasil e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5709-1971-10-07.md"}}, {id:"federal:BR:L:5717/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-10-26", numero:"5717", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-10-26;5717", vigente:true, titulo:"Lei nº 5.717 de 26/10/1971", urn:"urn:lex:br:federal:lei:1971-10-26;5717", ementa:"Autoriza a criação da Fundação Alexandre de Gusmão.", arquivo:"federal/leis-ordinarias/1971/lei-5717-1971-10-26.md"}}, {id:"federal:BR:L:5766/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-20", numero:"5766", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-20;5766", vigente:true, titulo:"Lei nº 5.766 de 20/12/1971", urn:"urn:lex:br:federal:lei:1971-12-20;5766", ementa:"Cria o Conselho Federal e os Conselhos Regionais de Psicologia e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5766-1971-12-20.md"}}, {id:"federal:BR:L:5672/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-07-02", numero:"5672", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-07-02;5672", vigente:true, titulo:"Lei nº 5.672 de 02/07/1971", urn:"urn:lex:br:federal:lei:1971-07-02;5672", ementa:"Modifica o parágrafo 2. do art. 10 da Lei nº. 4947, de 6 de abril de 1966 (Normas de Direito Agrário), e o parágrafo 2º do art. 11 do Decreto-Lei nº 57, de 18 de novembro de 1966, que dispõe sobre o lançamento e cobrança do imposto sobre a propriedade territorial, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5672-1971-07-02.md"}}, {id:"federal:BR:L:5663/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-06-21", numero:"5663", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-06-21;5663", vigente:true, titulo:"Lei nº 5.663 de 21/06/1971", urn:"urn:lex:br:federal:lei:1971-06-21;5663", ementa:"Fixa os vencimentos dos membros do Tribunal de Contas do Distrito Federal, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5663-1971-06-21.md"}}, {id:"federal:BR:L:5705/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-09-21", numero:"5705", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-09-21;5705", vigente:true, titulo:"Lei nº 5.705 de 21/09/1971", urn:"urn:lex:br:federal:lei:1971-09-21;5705", ementa:"Altera disposições da Lei nº 5107, de 13 de setembro de 1966, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1971/lei-5705-1971-09-21.md"}}, {id:"federal:BR:L:5765/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-18", numero:"5765", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-18;5765", vigente:true, titulo:"Lei nº 5.765 de 18/12/1971", urn:"urn:lex:br:federal:lei:1971-12-18;5765", ementa:"Aprova alterações na ortografia da língua portuguesa e dá outras   providências.", arquivo:"federal/leis-ordinarias/1971/lei-5765-1971-12-18.md"}}, {id:"federal:BR:L:5684/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-07-23", numero:"5684", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-07-23;5684", vigente:true, titulo:"Lei nº 5.684 de 23/07/1971", urn:"urn:lex:br:federal:lei:1971-07-23;5684", ementa:"Dá nova redação aos arts. 4 e 6 da Lei nº 4.838, de 10 de novembro de   1965, que cria, no Ministério da Aeronáutica, o Quadro de Oficiais Aviadores da   Reserva de 2º Classe e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5684-1971-07-23.md"}}, {id:"federal:BR:L:5713/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-10-11", numero:"5713", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-10-11;5713", vigente:true, titulo:"Lei nº 5.713 de 11/10/1971", urn:"urn:lex:br:federal:lei:1971-10-11;5713", ementa:"Cria cargos no Quadro da Secretaria do Tribunal de Contas da União, dispõe sobre a forma de provimento, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5713-1971-10-11.md"}}, {id:"federal:BR:L:5736/1971", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-11-22", numero:"5736", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-11-22;5736", vigente:true, titulo:"Lei nº 5.736 de 22/11/1971", urn:"urn:lex:br:federal:lei:1971-11-22;5736", ementa:"Autoriza a União a subscrever aumento de capital da Companhia Auxiliar de Empresas Elétricas Brasileiras - CAEEB, e dá outras prvidências.", arquivo:"federal/leis-ordinarias/1971/lei-5736-1971-11-22.md"}}, {id:"federal:BR:L:5747/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-01", numero:"5747", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-01;5747", vigente:true, titulo:"Lei nº 5.747 de 01/12/1971", urn:"urn:lex:br:federal:lei:1971-12-01;5747", ementa:"Autoriza o Poder Executivo a abrir ao Ministério da Educação e Cultura, em favor do Departamento de Assuntos Universitários, o crédito especial de Cr$ 74.489,00 (setenta e quatro mil, quatrocentos e oitenta e nove cruzeiros), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1971/lei-5747-1971-12-01.md"}}, {id:"federal:BR:L:5670/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-07-02", numero:"5670", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-07-02;5670", vigente:true, titulo:"Lei nº 5.670 de 02/07/1971", urn:"urn:lex:br:federal:lei:1971-07-02;5670", ementa:"Dispõe sobre o cálculo da correção monetária.", arquivo:"federal/leis-ordinarias/1971/lei-5670-1971-07-02.md"}}, {id:"federal:BR:L:5727/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-11-04", numero:"5727", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-11-04;5727", vigente:true, titulo:"Lei nº 5.727 de 04/11/1971", urn:"urn:lex:br:federal:lei:1971-11-04;5727", ementa:"Dispõe sobre o Primeiro Plano Nacional de Desenvolvimento (PND), para o período de 1972 a 1974.", arquivo:"federal/leis-ordinarias/1971/lei-5727-1971-11-04.md"}}, {id:"federal:BR:L:5678/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-07-19", numero:"5678", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-07-19;5678", vigente:true, titulo:"Lei nº 5.678 de 19/07/1971", urn:"urn:lex:br:federal:lei:1971-07-19;5678", ementa:"Modifica o item III do artigo 178 da Lei nº 1.711, de 28 outubro de 1952   (Estatuto dos Funcionários Públicos Civis da União).", arquivo:"federal/leis-ordinarias/1971/lei-5678-1971-07-19.md"}}, {id:"federal:BR:L:5754/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-03", numero:"5754", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-03;5754", vigente:true, titulo:"Lei nº 5.754 de 03/12/1971", urn:"urn:lex:br:federal:lei:1971-12-03;5754", ementa:"Estima a Receita e fixa a Despesa da União para o Exercício Financeiro de 1972.", arquivo:"federal/leis-ordinarias/1971/lei-5754-1971-12-03.md"}}, {id:"federal:BR:L:5724/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-10-26", numero:"5724", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-10-26;5724", vigente:true, titulo:"Lei nº 5.724 de 26/10/1971", urn:"urn:lex:br:federal:lei:1971-10-26;5724", ementa:"Atualiza o valor das multas previstas na Lei nº 3.820, de 11 de novembro   de 1960, que cria o Conselho Federal e os Conselhos Regionais de Farmácia e dá   outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5724-1971-10-26.md"}}, {id:"federal:BR:L:5743/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-01", numero:"5743", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-01;5743", vigente:true, titulo:"Lei nº 5.743 de 01/12/1971", urn:"urn:lex:br:federal:lei:1971-12-01;5743", ementa:"Autoriza o Poder Executivo a abrir, ao Poder Judiciário, em favor da   Justiça Federal de 1ª Instância, o crédito especial de Cr$ 500.000,00   (quinhentos mil cruzeiros), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1971/lei-5743-1971-12-01.md"}}, {id:"federal:BR:L:5751/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-02", numero:"5751", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-02;5751", vigente:true, titulo:"Lei nº 5.751 de 02/12/1971", urn:"urn:lex:br:federal:lei:1971-12-02;5751", ementa:"Autoriza o Poder Executivo a abrir à Justiça Eleitoral, em favor do   Tribunal Regional Eleitoral do Piauí, o crédito especial de Cr$ 24.000,00 (vinte   e quatro mil cruzeiros), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1971/lei-5751-1971-12-02.md"}}, {id:"federal:BR:L:5659/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-06-08", numero:"5659", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-06-08;5659", vigente:true, titulo:"Lei nº 5.659 de 08/06/1971", urn:"urn:lex:br:federal:lei:1971-06-08;5659", ementa:"Acrescenta parágrafo ao artigo 8º do Decreto-Lei nº 201, de 27 de   fevereiro de 1967, que dispõe sobre a responsabilidade dos Prefeitos e   Vereadores, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5659-1971-06-08.md"}}, {id:"federal:BR:L:5699/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-09-01", numero:"5699", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-09-01;5699", vigente:true, titulo:"Lei nº 5.699 de 01/09/1971", urn:"urn:lex:br:federal:lei:1971-09-01;5699", ementa:"Estende a Jurisdição da Junta de Conciliação e Julgamento de Bento   Gonçalves aos Municípios de Carlos Barbosa, Garibaldi, Guaporé, Nova Araçá, Nova   Bassano, Nova Prata, Paraí e Veranópolis, altera a jurisdição das Juntas de   Conciliação e Julgamneto de Novo Hamburgo e Santa Maria, no Estado do Rio grande   do Sul, e a da Junta de Conciliação e Julgamento de Americana, no Estado de São   Paulo, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5699-1971-09-01.md"}}, {id:"federal:BR:L:5720/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-10-26", numero:"5720", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-10-26;5720", vigente:true, titulo:"Lei nº 5.720 de 26/10/1971", urn:"urn:lex:br:federal:lei:1971-10-26;5720", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério das Comunicações, o crédito especial de Cr$ 400.400,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/1971/lei-5720-1971-10-26.md"}}, {id:"federal:BR:L:5661/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-06-16", numero:"5661", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-06-16;5661", vigente:true, titulo:"Lei nº 5.661 de 16/06/1971", urn:"urn:lex:br:federal:lei:1971-06-16;5661", ementa:"Cria a 3ª Auditoria da 2ª Circunscrição Judiciária Militar, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5661-1971-06-16.md"}}, {id:"federal:BR:L:5719/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-10-26", numero:"5719", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-10-26;5719", vigente:true, titulo:"Lei nº 5.719 de 26/10/1971", urn:"urn:lex:br:federal:lei:1971-10-26;5719", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério das Relações Exteriores, o crédito especial de Cr$ 1.620.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/1971/lei-5719-1971-10-26.md"}}, {id:"federal:BR:L:5738/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-11-24", numero:"5738", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-11-24;5738", vigente:true, titulo:"Lei nº 5.738 de 24/11/1971", urn:"urn:lex:br:federal:lei:1971-11-24;5738", ementa:"Aprova o Orçamento Plurianual de Investimentos do Distrito Federal para o   triênio 1972/1974.", arquivo:"federal/leis-ordinarias/1971/lei-5738-1971-11-24.md"}}, {id:"federal:BR:L:5768/1971", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-20", numero:"5768", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-20;5768", vigente:true, titulo:"Lei nº 5.768 de 20/12/1971", urn:"urn:lex:br:federal:lei:1971-12-20;5768", ementa:"Altera a legislação sobre distribuição gratuita de prêmios, mediante sorteio, vale-brinde ou concurso, a título de propaganda, estabelece normas de proteção à poupança popular e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5768-1971-12-20.md"}}, {id:"federal:BR:L:5665/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-06-21", numero:"5665", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-06-21;5665", vigente:true, titulo:"Lei nº 5.665 de 21/06/1971", urn:"urn:lex:br:federal:lei:1971-06-21;5665", ementa:"Altera o artigo 41 da Lei nº 2.004, de 3 de outubro de 1953, que dispõe   sobre a política nacional do petróleo e define as atribuições do Conselho   Nacional do Petróleo, institui a sociedade por ações Petróleo Brasileiro   Sociedade Anônima, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5665-1971-06-21.md"}}, {id:"federal:BR:L:5673/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-07-06", numero:"5673", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-07-06;5673", vigente:true, titulo:"Lei nº 5.673 de 06/07/1971", urn:"urn:lex:br:federal:lei:1971-07-06;5673", ementa:"Acrescenta itens ao artigo 379 da Consolidação das Leis do Trabalho, aprovada pelo Decreto-Lei n. 5452, de 1º de maio de 1943.", arquivo:"federal/leis-ordinarias/1971/lei-5673-1971-07-06.md"}}, {id:"federal:BR:L:5676/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-07-12", numero:"5676", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-07-12;5676", vigente:true, titulo:"Lei nº 5.676 de 12/07/1971", urn:"urn:lex:br:federal:lei:1971-07-12;5676", ementa:"Concede aumento de vencimentos aos funcionários da Secretaria do Senado Federal e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5676-1971-07-12.md"}}, {id:"federal:BR:L:5669/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-07-01", numero:"5669", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-07-01;5669", vigente:true, titulo:"Lei nº 5.669 de 01/07/1971", urn:"urn:lex:br:federal:lei:1971-07-01;5669", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça   Eleitoral, em favor do Tribunal Regional Eleitoral do Rio Grande do Sul, o   crédito especial de Cr$ 94.800,00 (Noventa e quatro mil e oitocentos cruzeiros)   para o fim que especifica.", arquivo:"federal/leis-ordinarias/1971/lei-5669-1971-07-01.md"}}, {id:"federal:BR:L:5731/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-11-08", numero:"5731", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-11-08;5731", vigente:true, titulo:"Lei nº 5.731 de 08/11/1971", urn:"urn:lex:br:federal:lei:1971-11-08;5731", ementa:"Dá nova redação aos arts. 2º, 3º, 4º e 6º do Decreto-lei nº 863, de 12 de   setembro de 1969, que autoriza o Poder Executivo a instituir nos Ministérios da   Marinha, do Exército e da Aeronáutica um Programa Especial de Bolsas de Estudos   a Acadêmico de Medicina de Faculdade Oficial ou reconhecida.", arquivo:"federal/leis-ordinarias/1971/lei-5731-1971-11-08.md"}}, {id:"federal:BR:L:5732/1971", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-11-16", numero:"5732", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-11-16;5732", vigente:true, titulo:"Lei nº 5.732 de 16/11/1971", urn:"urn:lex:br:federal:lei:1971-11-16;5732", ementa:"Dispõe sobre os dividendos da União na Companhia Vale do Rio Doce - CVRD, altera o Decreto-lei nº 1.038, de 21 de outubro de 1969, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5732-1971-11-16.md"}}, {id:"federal:BR:L:5746/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-01", numero:"5746", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-01;5746", vigente:true, titulo:"Lei nº 5.746 de 01/12/1971", urn:"urn:lex:br:federal:lei:1971-12-01;5746", ementa:"Autoriza doação de próprio nacional à Prefeitura Municipal de Juiz de Fora, no Estado de Minas Gerais, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5746-1971-12-01.md"}}, {id:"federal:BR:L:5723/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-10-26", numero:"5723", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-10-26;5723", vigente:true, titulo:"Lei nº 5.723 de 26/10/1971", urn:"urn:lex:br:federal:lei:1971-10-26;5723", ementa:"Autoriza o Poder Executivo a abrir o crédito especial de Cr$ 70.000.000,00 (setenta milhões de cruzeiros), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1971/lei-5723-1971-10-26.md"}}, {id:"federal:BR:L:5753/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-03", numero:"5753", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-03;5753", vigente:true, titulo:"Lei nº 5.753 de 03/12/1971", urn:"urn:lex:br:federal:lei:1971-12-03;5753", ementa:"Aprova o Orçamento Plurianual de Investimentos para o triênio 1972/1974.", arquivo:"federal/leis-ordinarias/1971/lei-5753-1971-12-03.md"}}, {id:"federal:BR:L:5677/1971", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-07-19", numero:"5677", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-07-19;5677", vigente:true, titulo:"Lei nº 5.677 de 19/07/1971", urn:"urn:lex:br:federal:lei:1971-07-19;5677", ementa:"Dispõe sobre o Quadro de Juízes e o Quadro Permanente da Justiça Federal de Primeira Instância, extingue as Seções Judiciárias dos Territórios do Amapá, de Roraima e de Rondônia, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5677-1971-07-19.md"}}, {id:"federal:BR:L:5771/1971", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-21", numero:"5771", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-21;5771", vigente:true, titulo:"Lei nº 5.771 de 21/12/1971", urn:"urn:lex:br:federal:lei:1971-12-21;5771", ementa:"Dispõe sobre o Quadro de Pessoal Civil da Secretaria de Segurança Pública do Distrito Federal, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5771-1971-12-21.md"}}, {id:"federal:BR:L:5693/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-08-16", numero:"5693", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-08-16;5693", vigente:true, titulo:"Lei nº 5.693 de 16/08/1971", urn:"urn:lex:br:federal:lei:1971-08-16;5693", ementa:"Altera o item XXIX do artigo 89 da Lei nº 5108, de 21 de setembro de 1966, que institui o Código Nacional de Trânsito.", arquivo:"federal/leis-ordinarias/1971/lei-5693-1971-08-16.md"}}, {id:"federal:BR:L:5750/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-02", numero:"5750", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-02;5750", vigente:true, titulo:"Lei nº 5.750 de 02/12/1971", urn:"urn:lex:br:federal:lei:1971-12-02;5750", ementa:"Autoriza o Poder Executivo a abrir crédito suplementar utilizando como   recurso o excesso de arrecadação previsto para o corrente exercício e dá outras   providências.", arquivo:"federal/leis-ordinarias/1971/lei-5750-1971-12-02.md"}}, {id:"federal:BR:L:5688/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-08-03", numero:"5688", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-08-03;5688", vigente:true, titulo:"Lei nº 5.688 de 03/08/1971", urn:"urn:lex:br:federal:lei:1971-08-03;5688", ementa:"Concede aumento de vencimentos aos funcionários dos Serviços Auxiliares de Tribunal de Contas do Distrito Federal e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5688-1971-08-03.md"}}, {id:"federal:BR:L:5700/1971", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-09-01", numero:"5700", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-09-01;5700", vigente:true, titulo:"Lei nº 5.700 de 01/09/1971", urn:"urn:lex:br:federal:lei:1971-09-01;5700", ementa:"Dispõe sobre a forma e a apresentação dos Símbolos Nacionais, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5700-1971-09-01.md"}}, {id:"federal:BR:L:5714/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-10-13", numero:"5714", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-10-13;5714", vigente:true, titulo:"Lei nº 5.714 de 13/10/1971", urn:"urn:lex:br:federal:lei:1971-10-13;5714", ementa:"Autoriza o Poder Executivo a renunciar direitos creditórios em favor do   Estado da Paraíba.", arquivo:"federal/leis-ordinarias/1971/lei-5714-1971-10-13.md"}}, {id:"federal:BR:L:5695/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-08-23", numero:"5695", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-08-23;5695", vigente:true, titulo:"Lei nº 5.695 de 23/08/1971", urn:"urn:lex:br:federal:lei:1971-08-23;5695", ementa:"Modifica o Art. 1º do Decreto-lei nº 150, de 9 de fevereiro de 1967, que   dispensa de registro, no Serviço Nacional de Fiscalização da Medicina e   Farmácia, os diplomas expedidos por Escolas ou Faculdades de Medicina e de   Farmácia.", arquivo:"federal/leis-ordinarias/1971/lei-5695-1971-08-23.md"}}, {id:"federal:BR:L:5718/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-10-26", numero:"5718", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-10-26;5718", vigente:true, titulo:"Lei nº 5.718 de 26/10/1971", urn:"urn:lex:br:federal:lei:1971-10-26;5718", ementa:"Autoriza o Poder Executivo a abrir, à Justiça Eleitoral, o crédito   especial de Cr$ 1.900.200,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/1971/lei-5718-1971-10-26.md"}}, {id:"federal:BR:L:5704/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-09-14", numero:"5704", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-09-14;5704", vigente:true, titulo:"Lei nº 5.704 de 14/09/1971", urn:"urn:lex:br:federal:lei:1971-09-14;5704", ementa:"Autoriza o Poder Executivo a desapropriar, em favor da Empresa Brasileira   de Telecomunicações - EMBRATEL -, o domínio direto de terrenos do Estado da   Guanabara.", arquivo:"federal/leis-ordinarias/1971/lei-5704-1971-09-14.md"}}, {id:"federal:BR:L:5691/1971", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-08-10", numero:"5691", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-08-10;5691", vigente:true, titulo:"Lei nº 5.691 de 10/08/1971", urn:"urn:lex:br:federal:lei:1971-08-10;5691", ementa:"Autoriza o Governo do Distrito Federal a constituir a \"Central de Abastecimento de Brasília S/A - CENABRA\", e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5691-1971-08-10.md"}}, {id:"federal:BR:L:5735/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-11-17", numero:"5735", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-11-17;5735", vigente:true, titulo:"Lei nº 5.735 de 17/11/1971", urn:"urn:lex:br:federal:lei:1971-11-17;5735", ementa:"Dá nova redação ao parágrafo único do art. 27 da Lei nº 2.800, de 18 de   junho de 1956, que cria os Conselhos Federal e Regionais de Química, dispõe   sobre o exercício da profissão de químico e dá outras   providências.", arquivo:"federal/leis-ordinarias/1971/lei-5735-1971-11-17.md"}}, {id:"federal:BR:L:5757/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-03", numero:"5757", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-03;5757", vigente:true, titulo:"Lei nº 5.757 de 03/12/1971", urn:"urn:lex:br:federal:lei:1971-12-03;5757", ementa:"Estabelece regime de gratificação ao pessoal à disposição do FUNRURAL e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5757-1971-12-03.md"}}, {id:"federal:BR:L:5664/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-06-21", numero:"5664", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-06-21;5664", vigente:true, titulo:"Lei nº 5.664 de 21/06/1971", urn:"urn:lex:br:federal:lei:1971-06-21;5664", ementa:"Acrescenta parágrafo único ao artigo 1º do Decreto-Lei nº 705, de 25 de   julho de 1969, que altera a redação do artigo 22 da Lei nº ;4.024, de 20 de dezembro   de 1961, que fixa as Diretrizes e Bases da Educação Nacional.", arquivo:"federal/leis-ordinarias/1971/lei-5664-1971-06-21.md"}}, {id:"federal:BR:L:5654/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-05-14", numero:"5654", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-05-14;5654", vigente:true, titulo:"Lei nº 5.654 de 14/05/1971", urn:"urn:lex:br:federal:lei:1971-05-14;5654", ementa:"Dispõe sobre a produção açucareira do País e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5654-1971-05-14.md"}}, {id:"federal:BR:L:5706/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-09-21", numero:"5706", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-09-21;5706", vigente:true, titulo:"Lei nº 5.706 de 21/09/1971", urn:"urn:lex:br:federal:lei:1971-09-21;5706", ementa:"Altera o Quadro da Secretaria do Tribunal Superior Eleitoral e dá outras   providências.", arquivo:"federal/leis-ordinarias/1971/lei-5706-1971-09-21.md"}}, {id:"federal:BR:L:5767/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-20", numero:"5767", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-20;5767", vigente:true, titulo:"Lei nº 5.767 de 20/12/1971", urn:"urn:lex:br:federal:lei:1971-12-20;5767", ementa:"Reorganiza a Secretaria de Segurança Pública, orgão integrante da administração do Distrito Federal, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5767-1971-12-20.md"}}, {id:"federal:BR:L:5775/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-27", numero:"5775", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-27;5775", vigente:true, titulo:"Lei nº 5.775 de 27/12/1971", urn:"urn:lex:br:federal:lei:1971-12-27;5775", ementa:"Estima a Receita e Fixa a Despesa do Distrito Federal para o Exercício Financeiro de 1972.", arquivo:"federal/leis-ordinarias/1971/lei-5775-1971-12-27.md"}}, {id:"federal:BR:L:5668/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-06-23", numero:"5668", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-06-23;5668", vigente:true, titulo:"Lei nº 5.668 de 23/06/1971", urn:"urn:lex:br:federal:lei:1971-06-23;5668", ementa:"Dispõe sobre a filiação dos empregados das Bolsas de Valores ao sistema   orgânico da Previdência Social e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5668-1971-06-23.md"}}, {id:"federal:BR:L:5685/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-07-23", numero:"5685", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-07-23;5685", vigente:true, titulo:"Lei nº 5.685 de 23/07/1971", urn:"urn:lex:br:federal:lei:1971-07-23;5685", ementa:"Concede aumento de vencimentos aos funcionários das Secretarias e Serviços   Auxiliares do Poder Judiciário da União e do Distrito Federal e dá outras   providências.", arquivo:"federal/leis-ordinarias/1971/lei-5685-1971-07-23.md"}}, {id:"federal:BR:L:5686/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-08-03", numero:"5686", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-08-03;5686", vigente:true, titulo:"Lei nº 5.686 de 03/08/1971", urn:"urn:lex:br:federal:lei:1971-08-03;5686", ementa:"Dá nova redação a dispositivos da Consolidação das Leis do Trabalho,   aprovada pelo Decreto-Lei nº 5.452, de 1 de maio de 1943, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1971/lei-5686-1971-08-03.md"}}, {id:"federal:BR:L:5656/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-05-27", numero:"5656", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-05-27;5656", vigente:true, titulo:"Lei nº 5.656 de 27/05/1971", urn:"urn:lex:br:federal:lei:1971-05-27;5656", ementa:"Concede pensão especial a Mercedes Biancheri Locatelli, viúva do   ex-Professor Aldo Doniele Locatelli.", arquivo:"federal/leis-ordinarias/1971/lei-5656-1971-05-27.md"}}, {id:"federal:BR:L:5734/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-11-16", numero:"5734", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-11-16;5734", vigente:true, titulo:"Lei nº 5.734 de 16/11/1971", urn:"urn:lex:br:federal:lei:1971-11-16;5734", ementa:"Reinclui, no Mistério da Saúde, o Instituto Nacional do Câncer, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5734-1971-11-16.md"}}, {id:"federal:BR:L:5715/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-10-18", numero:"5715", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-10-18;5715", vigente:true, titulo:"Lei nº 5.715 de 18/10/1971", urn:"urn:lex:br:federal:lei:1971-10-18;5715", ementa:"Autoriza o Poder Executivo a abrir ao Ministério do Exército, o crédito especial de Cr$ 7.550.000,00 para o fim que especifica.", arquivo:"federal/leis-ordinarias/1971/lei-5715-1971-10-18.md"}}, {id:"federal:BR:L:5737/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-11-22", numero:"5737", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-11-22;5737", vigente:true, titulo:"Lei nº 5.737 de 22/11/1971", urn:"urn:lex:br:federal:lei:1971-11-22;5737", ementa:"Dá nova redação ao § 1º do artigo 5º da Lei nº 4.923, de 23 de dezembro de   1965, que institui o cadastro permanente das admissões e dispensas de   empregados, estabelece medidas contra o desemprego e de assistência aos   desempregados e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5737-1971-11-22.md"}}, {id:"federal:BR:L:5748/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-01", numero:"5748", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-01;5748", vigente:true, titulo:"Lei nº 5.748 de 01/12/1971", urn:"urn:lex:br:federal:lei:1971-12-01;5748", ementa:"Autoriza o Poder Executivo a abrir ao Ministério da Fazenda, em favor da   Superintendência das Empresas Incorporadoras ao Patrimônio Nacional, o crédito   especial até o limite de Cr$ 13.100.000,00 (treze milhões e cem mil cruzeiros),   para o fim que especifica.", arquivo:"federal/leis-ordinarias/1971/lei-5748-1971-12-01.md"}}, {id:"federal:BR:L:5702/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-09-14", numero:"5702", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-09-14;5702", vigente:true, titulo:"Lei nº 5.702 de 14/09/1971", urn:"urn:lex:br:federal:lei:1971-09-14;5702", ementa:"Autoriza a incorporação da Faculdade de Ciências Econômicas, Contábeis e   Atuariais de Natal à Universidade Federal do Rio Grande do Norte e dá outras   providências.", arquivo:"federal/leis-ordinarias/1971/lei-5702-1971-09-14.md"}}, {id:"federal:BR:L:5660/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-06-14", numero:"5660", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-06-14;5660", vigente:true, titulo:"Lei nº 5.660 de 14/06/1971", urn:"urn:lex:br:federal:lei:1971-06-14;5660", ementa:"Fixa os vencimentos de Magistrados, dos membros do Tribunal de Contas da União, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5660-1971-06-14.md"}}, {id:"federal:BR:L:5762/1971", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-14", numero:"5762", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-14;5762", vigente:true, titulo:"Lei nº 5.762 de 14/12/1971", urn:"urn:lex:br:federal:lei:1971-12-14;5762", ementa:"Transforma o Banco Nacional da Habitação (BNH) em empresa pública, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5762-1971-12-14.md"}}, {id:"federal:BR:L:5679/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-07-19", numero:"5679", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-07-19;5679", vigente:true, titulo:"Lei nº 5.679 de 19/07/1971", urn:"urn:lex:br:federal:lei:1971-07-19;5679", ementa:"Dispõe sobre alterações introduzidos no Quadro de pessoal do Departamento   de Polícia Federal.", arquivo:"federal/leis-ordinarias/1971/lei-5679-1971-07-19.md"}}, {id:"federal:BR:L:5773/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-21", numero:"5773", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-21;5773", vigente:true, titulo:"Lei nº 5.773 de 21/12/1971", urn:"urn:lex:br:federal:lei:1971-12-21;5773", ementa:"Transforma em cargos de provimento em comissão os isolados efetivos de   Diretor de Serviço, Quadro da Secretaria do Tribunal Regional Eleitoral de   Pernambuco.", arquivo:"federal/leis-ordinarias/1971/lei-5773-1971-12-21.md"}}, {id:"federal:BR:L:5755/1971", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-03", numero:"5755", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-03;5755", vigente:true, titulo:"Lei nº 5.755 de 03/12/1971", urn:"urn:lex:br:federal:lei:1971-12-03;5755", ementa:"Isenta do pagamento dos impostos predial e territorial urbano e de transmissão, no Distrito Federal, imóveis adquiridos por componentes da Força Expedicionária Brasileira.", arquivo:"federal/leis-ordinarias/1971/lei-5755-1971-12-03.md"}}, {id:"federal:BR:L:5662/1971", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-06-21", numero:"5662", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-06-21;5662", vigente:true, titulo:"Lei nº 5.662 de 21/06/1971", urn:"urn:lex:br:federal:lei:1971-06-21;5662", ementa:"Enquadra o Banco Nacional do Desenvolvimento Econômico (BNDE) na categoria de empresa pública, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5662-1971-06-21.md"}}, {id:"federal:BR:L:5671/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-07-02", numero:"5671", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-07-02;5671", vigente:true, titulo:"Lei nº 5.671 de 02/07/1971", urn:"urn:lex:br:federal:lei:1971-07-02;5671", ementa:"Concede pensão especial ao Cientista e Pesquisador Ceslau Maria   Biezanko.", arquivo:"federal/leis-ordinarias/1971/lei-5671-1971-07-02.md"}}, {id:"federal:BR:L:5655/1971", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-05-20", numero:"5655", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-05-20;5655", vigente:true, titulo:"Lei nº 5.655 de 20/05/1971", urn:"urn:lex:br:federal:lei:1971-05-20;5655", ementa:"Dispõe sobre a remuneração legal do investimento dos concessionários de serviços públicos de energia elétrica, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5655-1971-05-20.md"}}, {id:"federal:BR:L:5696/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-08-24", numero:"5696", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-08-24;5696", vigente:true, titulo:"Lei nº 5.696 de 24/08/1971", urn:"urn:lex:br:federal:lei:1971-08-24;5696", ementa:"Dispõe sobre o registro profissional de jornalista e altera a redação do §   5º do art. 8º do Decreto-lei nº 972, de 17 de outubro de 1969.", arquivo:"federal/leis-ordinarias/1971/lei-5696-1971-08-24.md"}}, {id:"federal:BR:L:5752/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-02", numero:"5752", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-02;5752", vigente:true, titulo:"Lei nº 5.752 de 02/12/1971", urn:"urn:lex:br:federal:lei:1971-12-02;5752", ementa:"Autoriza o Poder Executivo a abrir à Justiça Eleitoral, em favor do Tribunal Reginal Eleitoral, de Mato Grosso, o crédito especial de Cr$ 4.600,00 (quatro mil e seiscentos cruzeiros), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1971/lei-5752-1971-12-02.md"}}, {id:"federal:BR:L:5744/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-01", numero:"5744", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-01;5744", vigente:true, titulo:"Lei nº 5.744 de 01/12/1971", urn:"urn:lex:br:federal:lei:1971-12-01;5744", ementa:"Retifica a Lei ;nº 5.641, de 3 de dezembro de 1970, que \"estima a   Receita e fixa a Despesa do Distrito Federal para o exercício financeiro de   1971\".", arquivo:"federal/leis-ordinarias/1971/lei-5744-1971-12-01.md"}}, {id:"federal:BR:L:5712/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-10-08", numero:"5712", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-10-08;5712", vigente:true, titulo:"Lei nº 5.712 de 08/10/1971", urn:"urn:lex:br:federal:lei:1971-10-08;5712", ementa:"Estende a jurisdição das Juntas de Conciliação e Julgamento de São   Leopoldo, Lajeado, Monte Negro e Santa Rosa, no Estado do Rio Grande do Sul, e   das Juntas