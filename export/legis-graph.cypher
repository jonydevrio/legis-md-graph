rdinária", vigencia_origem:"revogada=false", ano:1904, data:"1904-08-11", numero:"1215", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1904-08-11;1215", vigente:true, titulo:"Lei nº 1.215 de 11/08/1904", urn:"urn:lex:br:federal:lei:1904-08-11;1215", ementa:"Manda graduar no posto immediatamente superior o official do Exercito e da Armada ou das classes annexas que attingir o n. 1 da respectiva escala.", arquivo:"federal/leis-ordinarias/1904/lei-1215-1904-08-11.md"}}, {id:"federal:BR:L:1220/1904", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1904, data:"1904-08-24", numero:"1220", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1904-08-24;1220", vigente:true, titulo:"Lei nº 1.220 de 24/08/1904", urn:"urn:lex:br:federal:lei:1904-08-24;1220", ementa:"Fixa as forças de terra para o exercicio de 1905.", arquivo:"federal/leis-ordinarias/1904/lei-1220-1904-08-24.md"}}, {id:"federal:BR:L:1313/1904", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1904, data:"1904-12-30", numero:"1313", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1904-12-30;1313", vigente:true, titulo:"Lei nº 1.313 de 30/12/1904", urn:"urn:lex:br:federal:lei:1904-12-30;1313", ementa:"Orça a receita geral da Republica dos Estados Unidos do Brazil para o exercicio de 1905, e dá outras providencias.", arquivo:"federal/leis-ordinarias/1904/lei-1313-1904-12-30.md"}}, {id:"federal:BR:L:1269/1904", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1904, data:"1904-11-15", numero:"1269", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1904-11-15;1269", vigente:true, titulo:"Lei nº 1.269 de 15/11/1904", urn:"urn:lex:br:federal:lei:1904-11-15;1269", ementa:"Reforma a legislação eleitoral, e dá outras providencias", arquivo:"federal/leis-ordinarias/1904/lei-1269-1904-11-15.md"}}, {id:"federal:BR:L:1316/1904", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1904, data:"1904-12-31", numero:"1316", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1904-12-31;1316", vigente:true, titulo:"Lei nº 1.316 de 31/12/1904", urn:"urn:lex:br:federal:lei:1904-12-31;1316", ementa:"Fixa a despeza geral da Republica dos Estados Unidos do Brazil para o exercicio de 1905, e dá outras providencias.", arquivo:"federal/leis-ordinarias/1904/lei-1316-1904-12-31.md"}}, {id:"federal:BR:L:s/n/1823:8272", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1823, data:"1823-10-20", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1823-10-20;seq-sf-1", vigente:true, titulo:"Lei  de 20/10/1823 ( seq-sf: 1 )", urn:"urn:lex:br:federal:lei:1823-10-20;seq-sf-1", ementa:"REVOGA O DECRETO DE 16 DE FEVEREIRO DE 1822 QUE CRIOU O CONSELHO DE PROCURADORES DE PROVINCIA.", arquivo:"federal/leis-ordinarias/1823/lei-sn-1823-10-20-s1.md"}}, {id:"federal:BR:L:s/n/1823:8273", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1823, data:"1823-10-20", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1823-10-20;seq-sf-5", vigente:true, titulo:"Lei  de 20/10/1823 ( seq-sf: 5 )", urn:"urn:lex:br:federal:lei:1823-10-20;seq-sf-5", ementa:"DA NOVA FORMA AOS GOVERNOS DAS PROVINCIAS, CRIANDO PARA CADA UMA DELAS UM PRESIDENTE E CONSELHO.", arquivo:"federal/leis-ordinarias/1823/lei-sn-1823-10-20-s5.md"}}, {id:"federal:BR:L:s/n/1823:8274", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1823, data:"1823-10-20", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1823-10-20;seq-sf-3", vigente:true, titulo:"Lei  de 20/10/1823 ( seq-sf: 3 )", urn:"urn:lex:br:federal:lei:1823-10-20;seq-sf-3", ementa:"REVOGA O ALVARA DE 30 DE MARÇO DE 1.818 SOBRE SOCIEDADES SECRETAS.", arquivo:"federal/leis-ordinarias/1823/lei-sn-1823-10-20-s3.md"}}, {id:"federal:BR:L:s/n/1823:8275", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1823, data:"1823-10-20", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1823-10-20;seq-sf-2", vigente:true, titulo:"Lei  de 20/10/1823 ( seq-sf: 2 )", urn:"urn:lex:br:federal:lei:1823-10-20;seq-sf-2", ementa:"PROIBE QUE OS DEPUTADOS A ASSEMBLEIA GERAL CONSTITUINTE EXERÇAM QUALQUER OUTRO EMPREGO DURANTE A SUA DEPUTAÇÃO, E QUE PEÇAM E ACEITEM PARA SI OU PARA OUTREM QUALQUER GRAÇA OU EMPREGO.", arquivo:"federal/leis-ordinarias/1823/lei-sn-1823-10-20-s2.md"}}, {id:"federal:BR:L:s/n/1823:8276", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1823, data:"1823-10-20", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1823-10-20;seq-sf-4", vigente:true, titulo:"Lei  de 20/10/1823 ( seq-sf: 4 )", urn:"urn:lex:br:federal:lei:1823-10-20;seq-sf-4", ementa:"DECLARA EM VIGOR A LEGISLAÇÃO PELA QUAL SE REGIA O BRASIL ATE 25 DE ABRIL DE 1821 E BEM ASSIM AS LEIS PROMULGADAS PELO SENHOR D. PEDRO, COMO REGENTE E IMPERADOR DAQUELA DATA EM DIANTE, E OS DECRETOS DAS CORTES PORTUGUESAS QUE SÃO ESPECIFICADOS.", arquivo:"federal/leis-ordinarias/1823/lei-sn-1823-10-20-s4.md"}}, {id:"federal:BR:L:s/n/1823:8277", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1823, data:"1823-10-20", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1823-10-20;seq-sf-0", titulo:"Lei  de 20/10/1823", vigente:true, urn:"urn:lex:br:federal:lei:1823-10-20;seq-sf-0", ementa:"ESTABELECE PROVISORIAMENTE A FORMA QUE DEVE SER OBSERVADA NA PROMULGAÇÃO DOS DECRETOS DA ASSEMBLÉIA GERAL  CONSTITUINTE E LEGISLATIVA DO BRASIL.", arquivo:"federal/leis-ordinarias/1823/lei-sn-1823-10-20-s0.md"}}, {id:"federal:BR:L:4531/1922", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1922, data:"1922-01-28", numero:"4531", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1922-01-28;4531", vigente:true, titulo:"Lei nº 4.531 de 28/01/1922", urn:"urn:lex:br:federal:lei:1922-01-28;4531", ementa:"Fixa a força Naval para o anno de 1922", arquivo:"federal/leis-ordinarias/1922/lei-4531-1922-01-28.md"}}, {id:"federal:BR:L:242/1841", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1841, data:"1841-11-29", numero:"242", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1841-11-29;242", vigente:true, titulo:"Lei nº 242 de 29/11/1841", urn:"urn:lex:br:federal:lei:1841-11-29;242", ementa:"RESTABELECE O PRIVILÉGIO DO FORO PARA AS CAUSAS DA FAZENDA NACIONAL, E CRIA UM JUÍZO PRIVATIVO DOS FEITOS DA FAZENDA DE PRIMEIRA INSTÂNCIA.", arquivo:"federal/leis-ordinarias/1841/lei-242-1841-11-29.md"}}, {id:"federal:BR:L:184/1841", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1841, data:"1841-07-05", numero:"184", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1841-07-05;184", vigente:true, titulo:"Lei nº 184 de 05/07/1841", urn:"urn:lex:br:federal:lei:1841-07-05;184", ementa:"DECLARA QUE A SENHORA PRINCESA DONA MARIA AMRLIA E PELA CONSTITUIÇÃO DO IMPERIO PRINCESA BRASILEIRA.", arquivo:"federal/leis-ordinarias/1841/lei-184-1841-07-05.md"}}, {id:"federal:BR:L:192/1841", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1841, data:"1841-08-30", numero:"192", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1841-08-30;192", vigente:true, titulo:"Lei nº 192 de 30/08/1841", urn:"urn:lex:br:federal:lei:1841-08-30;192", ementa:"FIXANDO AS FORÇAS DE MAR PARA O ANO FINANCEIRO DE 1842 A 1843.", arquivo:"federal/leis-ordinarias/1841/lei-192-1841-08-30.md"}}, {id:"federal:BR:L:261/1841", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1841, data:"1841-12-03", numero:"261", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1841-12-03;261", vigente:true, titulo:"Lei nº 261 de 03/12/1841", urn:"urn:lex:br:federal:lei:1841-12-03;261", ementa:"REFORMANDO O CÓDIGO DO PROCESSO CRIMINAL.", arquivo:"federal/leis-ordinarias/1841/lei-261-1841-12-03.md"}}, {id:"federal:BR:L:243/1841", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1841, data:"1841-11-30", numero:"243", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1841-11-30;243", vigente:true, titulo:"Lei nº 243 de 30/11/1841", urn:"urn:lex:br:federal:lei:1841-11-30;243", ementa:"FIXANDO A DESPESA, E ORÇANDO A RECEITA PARA O EXERCÍCIO DO ANO FINANCEIRO DE 1842-1843.", arquivo:"federal/leis-ordinarias/1841/lei-243-1841-11-30.md"}}, {id:"federal:BR:L:190/1841", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1841, data:"1841-08-24", numero:"190", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1841-08-24;190", vigente:true, titulo:"Lei nº 190 de 24/08/1841", urn:"urn:lex:br:federal:lei:1841-08-24;190", ementa:"FIXANDO AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1842 E 1843.", arquivo:"federal/leis-ordinarias/1841/lei-190-1841-08-24.md"}}, {id:"federal:BR:L:234/1841", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1841, data:"1841-11-23", numero:"234", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1841-11-23;234", titulo:"Lei nº 234 de 23/11/1841", vigente:true, urn:"urn:lex:br:federal:lei:1841-11-23;234", ementa:"CRIA UM CONSELHO DE ESTADO.", arquivo:"federal/leis-ordinarias/1841/lei-234-1841-11-23.md"}}, {id:"federal:BR:L:241/1841", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1841, data:"1841-11-29", numero:"241", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1841-11-29;241", vigente:true, titulo:"Lei nº 241 de 29/11/1841", urn:"urn:lex:br:federal:lei:1841-11-29;241", ementa:"AUTORIZA O PAGAMENTO DOS JUROS, E TRANSFERÊNCIA DAS APÓLICES DA DÍVIDA INTERNA NAS PROVÍNCIAS DA BAHIA, PERNAMBUCO, E MARANHÃO; E A PASSAGEM DELAS DE UMAS PARA OUTRAS TESOURARIAS, ONDE É PERMITIDO O PAGAMENTO DOS JUROS.", arquivo:"federal/leis-ordinarias/1841/lei-241-1841-11-29.md"}}, {id:"federal:BR:L:3983/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-11-18", numero:"3983", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-11-18;3983", vigente:true, titulo:"Lei nº 3.983 de 18/11/1961", urn:"urn:lex:br:federal:lei:1961-11-18;3983", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Tribunais Regionais do Trabalho e Juntas de Conciliação e Julgamento da 2º, 6º e 8º Regiões, o crédito especial de Cr$ 6.661.990,40, para atender ás despesas que especifica.", arquivo:"federal/leis-ordinarias/1961/lei-3983-1961-11-18.md"}}, {id:"federal:BR:L:3906/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-06-19", numero:"3906", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-06-19;3906", vigente:true, titulo:"Lei nº 3.906 de 19/06/1961", urn:"urn:lex:br:federal:lei:1961-06-19;3906", ementa:"Dispõe sobre a aposentadoria dos funcionários federais e dos empregados autárquicos da União que participaram de operações de guerra na Força Expedicionária, na Força Aérea e na Marinha de Guerra do Brasil ou receberam a Medalha da Campanha do Atlântico Sul. ;", arquivo:"federal/leis-ordinarias/1961/lei-3906-1961-06-19.md"}}, {id:"federal:BR:L:3948/1961", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-09-01", numero:"3948", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-09-01;3948", vigente:true, titulo:"Lei nº 3.948 de 01/09/1961", urn:"urn:lex:br:federal:lei:1961-09-01;3948", ementa:"Organiza o Quadro da Secretaria do Tribunal de Contas do Distrito Federal, e dá outras providências.", arquivo:"federal/leis-ordinarias/1961/lei-3948-1961-09-01.md"}}, {id:"federal:BR:L:3929/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-07-31", numero:"3929", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-07-31;3929", vigente:true, titulo:"Lei nº 3.929 de 31/07/1961", urn:"urn:lex:br:federal:lei:1961-07-31;3929", ementa:"Prorroga, até 31 de dezembro de 1961, o prazo a que se refere a Lei nº 3.892, de 28 de abril de 1961 (COFAP).", arquivo:"federal/leis-ordinarias/1961/lei-3929-1961-07-31.md"}}, {id:"federal:BR:L:3969/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-10-06", numero:"3969", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-10-06;3969", vigente:true, titulo:"Lei nº 3.969 de 06/10/1961", urn:"urn:lex:br:federal:lei:1961-10-06;3969", ementa:"Fixa um teto máximo para as tarifas de energia elétrica na cidade de Fortaleza, Estado do Ceará, e Natal, Estado do Rio Grande de Norte, e dá outras providências.", arquivo:"federal/leis-ordinarias/1961/lei-3969-1961-10-06.md"}}, {id:"federal:BR:L:4005/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-12-15", numero:"4005", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-12-15;4005", vigente:true, titulo:"Lei nº 4.005 de 15/12/1961", urn:"urn:lex:br:federal:lei:1961-12-15;4005", ementa:"Prorroga por mais um exercício a vigência da Lei nº 3.798, de 2 de agosto de 1960, que abriu crédito para a modernização dos serviços de segurança e proteção ao vôo.", arquivo:"federal/leis-ordinarias/1961/lei-4005-1961-12-15.md"}}, {id:"federal:BR:L:4036/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-12-20", numero:"4036", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-12-20;4036", vigente:true, titulo:"Lei nº 4.036 de 20/12/1961", urn:"urn:lex:br:federal:lei:1961-12-20;4036", ementa:"Concede pensão mensal de Cr$ 3.000,00 a Belisário Alves, ex-estafeta de correio a cavalo do 2º Distrito de Pinheiro Machado, Rio Grande do sul.", arquivo:"federal/leis-ordinarias/1961/lei-4036-1961-12-20.md"}}, {id:"federal:BR:L:3956/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-09-11", numero:"3956", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-09-11;3956", vigente:true, titulo:"Lei nº 3.956 de 11/09/1961", urn:"urn:lex:br:federal:lei:1961-09-11;3956", ementa:"Isenta dos impostos de importação e de consumo equipamentos telefônicos a   serem importados pelas Cias. Telefônica de Rio Preto, Telefônica de Piracicaba   S.A., Empresa Telefônica Paulista, Cia. Telefônica Borda do Campo, Telefônica de   Limeira S.A., Estado de São Paulo, e Sociedade Telefônica do Paraná, Estado do   Paraná.", arquivo:"federal/leis-ordinarias/1961/lei-3956-1961-09-11.md"}}, {id:"federal:BR:L:3925/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-07-26", numero:"3925", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-07-26;3925", vigente:true, titulo:"Lei nº 3.925 de 26/07/1961", urn:"urn:lex:br:federal:lei:1961-07-26;3925", ementa:"Fixa vencimento para funcionários e serventuários da justiça de 1ª Instância do Distrito Federal e dá outras providências.", arquivo:"federal/leis-ordinarias/1961/lei-3925-1961-07-26.md"}}, {id:"federal:BR:L:3995/1961", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-12-14", numero:"3995", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-12-14;3995", vigente:true, titulo:"Lei nº 3.995 de 14/12/1961", urn:"urn:lex:br:federal:lei:1961-12-14;3995", ementa:"Aprova o Plano Diretor da SUDENE, para o ano de 1961, e dá outras providências.", arquivo:"federal/leis-ordinarias/1961/lei-3995-1961-12-14.md"}}, {id:"federal:BR:L:3941/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-08-18", numero:"3941", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-08-18;3941", vigente:true, titulo:"Lei nº 3.941 de 18/08/1961", urn:"urn:lex:br:federal:lei:1961-08-18;3941", ementa:"Retifica, sem aumento de despesa, a Lei n° 3.834, de 10 de dezembro de 1960, que estima a Receita e fixa a Despesa da União para o exercício de 1961.", arquivo:"federal/leis-ordinarias/1961/lei-3941-1961-08-18.md"}}, {id:"federal:BR:L:3977/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-11-06", numero:"3977", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-11-06;3977", vigente:true, titulo:"Lei nº 3.977 de 06/11/1961", urn:"urn:lex:br:federal:lei:1961-11-06;3977", ementa:"Concede a pensão especial de Cr$ 6.000,00 a João Ignácio da Silva, ex-foguista do Lóide Brasileiro.", arquivo:"federal/leis-ordinarias/1961/lei-3977-1961-11-06.md"}}, {id:"federal:BR:L:3934/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-08-07", numero:"3934", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-08-07;3934", vigente:true, titulo:"Lei nº 3.934 de 07/08/1961", urn:"urn:lex:br:federal:lei:1961-08-07;3934", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Saúde o crédito especial de Cr$ 5.000.000,00 (cinco milhões de cruzeiros) destinado a auxiliar a construção do Hospital São Domingos, da Escola de Enfermagem Frei Eugênio, de Uberaba, no Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/1961/lei-3934-1961-08-07.md"}}, {id:"federal:BR:L:4044/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-12-21", numero:"4044", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-12-21;4044", vigente:true, titulo:"Lei nº 4.044 de 21/12/1961", urn:"urn:lex:br:federal:lei:1961-12-21;4044", ementa:"Concede isenção de direitos de importação para o material importado pela Companhia Brasileira de Fiação e Tecelagem de Juta, de Manaus, Estado do Amazonas, e outros congêneres.", arquivo:"federal/leis-ordinarias/1961/lei-4044-1961-12-21.md"}}, {id:"federal:BR:L:4013/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-12-16", numero:"4013", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-12-16;4013", vigente:true, titulo:"Lei nº 4.013 de 16/12/1961", urn:"urn:lex:br:federal:lei:1961-12-16;4013", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações Exteriores, o crédito especial de Cr$ 202.525.600,00, para atender ao pagamento das despesas de pessoal e obras a cargo da Comissão Mista Ferroviária Brasileiro-Boliviana.", arquivo:"federal/leis-ordinarias/1961/lei-4013-1961-12-16.md"}}, {id:"federal:BR:L:3883/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-01-30", numero:"3883", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-01-30;3883", vigente:true, titulo:"Lei nº 3.883 de 30/01/1961", urn:"urn:lex:br:federal:lei:1961-01-30;3883", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça Eleitoral - Tribunal Regional do Pará - os créditos especiais de Cr$ 79.112,50 e Cr$ 368.205,00 para ocorrer às despesas com o pagamento de diferença de gratificação adicional devido a funcionários da Secretaria do mesmo Tribunal no período compreendido entre 16 de outubro a 31 de dezembro de 1958 e o exercício de 1959.", arquivo:"federal/leis-ordinarias/1961/lei-3883-1961-01-30.md"}}, {id:"federal:BR:L:3900/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-06-08", numero:"3900", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-06-08;3900", vigente:true, titulo:"Lei nº 3.900 de 08/06/1961", urn:"urn:lex:br:federal:lei:1961-06-08;3900", ementa:"Regula a contagem do tempo de efetivo serviço para os efeitos da Lei de Inatividade dos Militares.", arquivo:"federal/leis-ordinarias/1961/lei-3900-1961-06-08.md"}}, {id:"federal:BR:L:3864/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-01-24", numero:"3864", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-01-24;3864-a", vigente:true, titulo:"Lei nº 3.864-A de 24/01/1961", urn:"urn:lex:br:federal:lei:1961-01-24;3864-a", ementa:"Cria as Escolas Agrícolas de Bambui e Cuiabá, nos Estados de Minas Gerais   e Mato Grosso, e uma Escola de Engenharia em Uberlândia, Minas   Gerais.", arquivo:"federal/leis-ordinarias/1961/lei-3864-a-1961-01-24.md"}}, {id:"federal:BR:L:3972/1961", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-10-13", numero:"3972", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-10-13;3972", vigente:true, titulo:"Lei nº 3.972 de 13/10/1961", urn:"urn:lex:br:federal:lei:1961-10-13;3972", ementa:"Autoriza o Poder Executivo a participar da Sociedade de Economia Mista Aços Piratini S.A., em organização pelo Governo do Estado do Rio Grande do Sul, e dá outras providências.", arquivo:"federal/leis-ordinarias/1961/lei-3972-1961-10-13.md"}}, {id:"federal:BR:L:3897/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-05-19", numero:"3897", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-05-19;3897", vigente:true, titulo:"Lei nº 3.897 de 19/05/1961", urn:"urn:lex:br:federal:lei:1961-05-19;3897", ementa:"Organiza o Quadro da Secretaria e dos Serviços Auxiliares do Tribunal de   Justiça do Distrito Federal, e dá outras providências.", arquivo:"federal/leis-ordinarias/1961/lei-3897-1961-05-19.md"}}, {id:"federal:BR:L:3874/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-01-30", numero:"3874", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-01-30;3874", vigente:true, titulo:"Lei nº 3.874 de 30/01/1961", urn:"urn:lex:br:federal:lei:1961-01-30;3874", ementa:"Dá nova redação ao artigo 13, da Lei nº ;2.370, de 9 de dezembro de 1954, que regula a inatividade dos militares.", arquivo:"federal/leis-ordinarias/1961/lei-3874-1961-01-30.md"}}, {id:"federal:BR:L:3998/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-12-15", numero:"3998", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-12-15;3998", vigente:true, titulo:"Lei nº 3.998 de 15/12/1961", urn:"urn:lex:br:federal:lei:1961-12-15;3998", ementa:"Autoriza o Poder Executivo a instituir a Fundação Universidade 