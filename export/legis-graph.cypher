:6286/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-12-11", numero:"6286", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-12-11;6286", vigente:true, titulo:"Lei nº 6.286 de 11/12/1975", urn:"urn:lex:br:federal:lei:1975-12-11;6286", ementa:"Fixa os valores de vencimentos dos cargos do Grupo - Outras Atividades de   Nível Superior do Quadro Permanente da Secretaria - Geral do Tribunal de Contas   da União e dá outras providências.", arquivo:"federal/leis-ordinarias/1975/lei-6286-1975-12-11.md"}}, {id:"federal:BR:L:6225/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-07-14", numero:"6225", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-07-14;6225", vigente:true, titulo:"Lei nº 6.225 de 14/07/1975", urn:"urn:lex:br:federal:lei:1975-07-14;6225", ementa:"Dispõe sobre discriminação, pelo Ministério da Agricultura, de regiões para execução obrigatória de planos de proteção ao solo e de combate à erosão e dá outras providências.", arquivo:"federal/leis-ordinarias/1975/lei-6225-1975-07-14.md"}}, {id:"federal:BR:L:6282/1975", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-12-09", numero:"6282", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-12-09;6282", vigente:true, titulo:"Lei nº 6.282 de 09/12/1975", urn:"urn:lex:br:federal:lei:1975-12-09;6282", ementa:"Prorroga o prazo estabelecido no artigo 1º da Lei n° ;5.972, de 11 de dezembro de 1973, que regula o procedimento para o registro de propriedade de bens imóveis discriminados administrativamente ou possuidos pela União.", arquivo:"federal/leis-ordinarias/1975/lei-6282-1975-12-09.md"}}, {id:"federal:BR:L:6289/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-12-11", numero:"6289", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-12-11;6289", vigente:true, titulo:"Lei nº 6.289 de 11/12/1975", urn:"urn:lex:br:federal:lei:1975-12-11;6289", ementa:"Altera a redação do art. 697 da Consolidação das Leis do Trabalho aprovada pelo Decreto-Lei nº 5.452, de 1º de maio de 1943.", arquivo:"federal/leis-ordinarias/1975/lei-6289-1975-12-11.md"}}, {id:"federal:BR:L:6273/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-11-28", numero:"6273", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-11-28;6273", vigente:true, titulo:"Lei nº 6.273 de 28/11/1975", urn:"urn:lex:br:federal:lei:1975-11-28;6273", ementa:"Autoriza o Poder Executivo a abrir a Encargos Gerais da União - Recursos   sob Supervisão do Ministério da Fazenda, o crédito especial de Cr$   870.000.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/1975/lei-6273-1975-11-28.md"}}, {id:"federal:BR:L:6243/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-09-24", numero:"6243", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-09-24;6243", vigente:true, titulo:"Lei nº 6.243 de 24/09/1975", urn:"urn:lex:br:federal:lei:1975-09-24;6243", ementa:"Regula a situação do aposentado pela Previdência Social que volta ao Trabalho e a do segurado que se vincula a seu regime após completar sessenta anos de idade, e dá outras providências.", arquivo:"federal/leis-ordinarias/1975/lei-6243-1975-09-24.md"}}, {id:"federal:BR:L:6268/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-11-24", numero:"6268", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-11-24;6268", vigente:true, titulo:"Lei nº 6.268 de 24/11/1975", urn:"urn:lex:br:federal:lei:1975-11-24;6268", ementa:"Dispõe sobre a averbação do pagamento de títulos protestados, a identificação do devedor em títulos cambiais e duplicatas de fatura e dá outras providências.", arquivo:"federal/leis-ordinarias/1975/lei-6268-1975-11-24.md"}}, {id:"federal:BR:L:6294/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-12-15", numero:"6294", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-12-15;6294", vigente:true, titulo:"Lei nº 6.294 de 15/12/1975", urn:"urn:lex:br:federal:lei:1975-12-15;6294", ementa:"Dispõe sobre doação de lotes, a Estado Estrangeiro, pela Companhia Imobiliária de Brasília - TERRACAP.", arquivo:"federal/leis-ordinarias/1975/lei-6294-1975-12-15.md"}}, {id:"federal:BR:L:6277/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-12-05", numero:"6277", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-12-05;6277", vigente:true, titulo:"Lei nº 6.277 de 05/12/1975", urn:"urn:lex:br:federal:lei:1975-12-05;6277", ementa:"Autoriza o Governo do Distrito Federal a contrair empréstimo destinado ao   atendimento da Rede de Ensino do Primeiro Grau do Distrito   Federal.", arquivo:"federal/leis-ordinarias/1975/lei-6277-1975-12-05.md"}}, {id:"federal:BR:L:6249/1975", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-10-08", numero:"6249", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-10-08;6249", vigente:true, titulo:"Lei nº 6.249 de 08/10/1975", urn:"urn:lex:br:federal:lei:1975-10-08;6249", ementa:"Dispõe sobre o Magistério da Aeronáutica e dá outras providências.", arquivo:"federal/leis-ordinarias/1975/lei-6249-1975-10-08.md"}}, {id:"federal:BR:L:6214/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-06-30", numero:"6214", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-06-30;6214", vigente:true, titulo:"Lei nº 6.214 de 30/06/1975", urn:"urn:lex:br:federal:lei:1975-06-30;6214", ementa:"Autoriza a Cruz Vermelha Brasileira a dar destinação diversa ao imóvel que   lhe foi doado.", arquivo:"federal/leis-ordinarias/1975/lei-6214-1975-06-30.md"}}, {id:"federal:BR:L:6261/1975", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-11-14", numero:"6261", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-11-14;6261", vigente:true, titulo:"Lei nº 6.261 de 14/11/1975", urn:"urn:lex:br:federal:lei:1975-11-14;6261", ementa:"Dispõe sobre o Sistema Nacional dos Transportes Urbanos, autoriza a criação da Empresa Brasileira dos Transportes Urbanos e dá outras providências.", arquivo:"federal/leis-ordinarias/1975/lei-6261-1975-11-14.md"}}, {id:"federal:BR:L:6202/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-04-17", numero:"6202", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-04-17;6202", vigente:true, titulo:"Lei nº 6.202 de 17/04/1975", urn:"urn:lex:br:federal:lei:1975-04-17;6202", ementa:"Atribui a estudante em estado de gestação o regime de exercícios domiciliares instituído pelo Decreto-Lei nº 1.044, de 1969, e dá outras providências.", arquivo:"federal/leis-ordinarias/1975/lei-6202-1975-04-17.md"}}, {id:"federal:BR:L:6260/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-11-06", numero:"6260", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-11-06;6260", vigente:true, titulo:"Lei nº 6.260 de 06/11/1975", urn:"urn:lex:br:federal:lei:1975-11-06;6260", ementa:"Institui benefícios de previdência e assistência social em favor dos empregadores rurais e seus dependentes, e dá outras providências.", arquivo:"federal/leis-ordinarias/1975/lei-6260-1975-11-06.md"}}, {id:"federal:BR:L:6290/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-12-11", numero:"6290", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-12-11;6290", vigente:true, titulo:"Lei nº 6.290 de 11/12/1975", urn:"urn:lex:br:federal:lei:1975-12-11;6290", ementa:"Autoriza o Poder Executivo a abrir ao Ministério dos Transportes, em favor   da Secretaria-Geral - Entidades Supervisionadas - o crédito especial de Cr$   600.000.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/1975/lei-6290-1975-12-11.md"}}, {id:"federal:BR:L:6312/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-12-16", numero:"6312", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-12-16;6312", vigente:true, titulo:"Lei nº 6.312 de 16/12/1975", urn:"urn:lex:br:federal:lei:1975-12-16;6312", ementa:"Autoriza o Poder Executivo a instituir a Fundação Nacional de Arte e dá   outras Providências.", arquivo:"federal/leis-ordinarias/1975/lei-6312-1975-12-16.md"}}, {id:"federal:BR:L:6254/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-10-22", numero:"6254", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-10-22;6254", vigente:true, titulo:"Lei nº 6.254 de 22/10/1975", urn:"urn:lex:br:federal:lei:1975-10-22;6254", ementa:"Dispõe sobre a constituição de Fundo de Financiamento para Água e Esgotos   do Distrito Federal - FAE - DF e dá outras providências.", arquivo:"federal/leis-ordinarias/1975/lei-6254-1975-10-22.md"}}, {id:"federal:BR:L:6212/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-06-23", numero:"6212", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-06-23;6212", vigente:true, titulo:"Lei nº 6.212 de 23/06/1975", urn:"urn:lex:br:federal:lei:1975-06-23;6212", ementa:"Revoga a Lei nº 602, de 28 de dezembro de 1948, que dispõe sobre o   julgamento de aptidão para o oficialato dos alunos do Curso Prévio e dos 1º e do   2º anos do Curso Superior da Escola Naval.", arquivo:"federal/leis-ordinarias/1975/lei-6212-1975-06-23.md"}}, {id:"federal:BR:L:6304/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-12-15", numero:"6304", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-12-15;6304", vigente:true, titulo:"Lei nº 6.304 de 15/12/1975", urn:"urn:lex:br:federal:lei:1975-12-15;6304", ementa:"Estende às duplicatas o processo de autenticação mediante chancela   mecânica, nos termos do art. 1º da Lei 5.589, de 3 de julho de   1970.", arquivo:"federal/leis-ordinarias/1975/lei-6304-1975-12-15.md"}}, {id:"federal:BR:L:6250/1975", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-10-08", numero:"6250", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-10-08;6250", vigente:true, titulo:"Lei nº 6.250 de 08/10/1975", urn:"urn:lex:br:federal:lei:1975-10-08;6250", ementa:"Dispõe sobre os vencimentos ou salários básicos do pessoal docente e coadjuvante do magistério da Aeronáutica.", arquivo:"federal/leis-ordinarias/1975/lei-6250-1975-10-08.md"}}, {id:"federal:BR:L:6300/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-12-15", numero:"6300", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-12-15;6300", vigente:true, titulo:"Lei nº 6.300 de 15/12/1975", urn:"urn:lex:br:federal:lei:1975-12-15;6300", ementa:"Retifica, sem ônus, a Lei nº 6.187, de 16 de dezembro de 1974, que \"Estima a Receita e FIxa a Despesa da União referente ao exercício financeiro de 1975\".", arquivo:"federal/leis-ordinarias/1975/lei-6300-1975-12-15.md"}}, {id:"federal:BR:L:6298/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-12-15", numero:"6298", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-12-15;6298", vigente:true, titulo:"Lei nº 6.298 de 15/12/1975", urn:"urn:lex:br:federal:lei:1975-12-15;6298", ementa:"Altera dispositivos do Decreto-Lei nº 32, de 18 de novembro de 1966, que   \"Institui o Código Brasileiro do Ar\".", arquivo:"federal/leis-ordinarias/1975/lei-6298-1975-12-15.md"}}, {id:"federal:BR:L:6206/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-05-07", numero:"6206", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-05-07;6206", vigente:true, titulo:"Lei nº 6.206 de 07/05/1975", urn:"urn:lex:br:federal:lei:1975-05-07;6206", ementa:"Dá valor de documento de indentidade às carteiras expedidas pelos órgãos fiscalizadores de exercício profissional e dá outras providências.", arquivo:"federal/leis-ordinarias/1975/lei-6206-1975-05-07.md"}}, {id:"federal:BR:L:6259/1975", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-10-30", numero:"6259", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-10-30;6259", vigente:true, titulo:"Lei nº 6.259 de 30/10/1975", urn:"urn:lex:br:federal:lei:1975-10-30;6259", ementa:"Dispõe sobre a organização das ações de Vigilância Epidemiológica, sobre o Programa Nacional de Imunizações, estabelece normas relativas à notificação compulsória de doenças, e dá outras providências.", arquivo:"federal/leis-ordinarias/1975/lei-6259-1975-10-30.md"}}, {id:"federal:BR:L:6246/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-10-07", numero:"6246", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-10-07;6246", vigente:true, titulo:"Lei nº 6.246 de 07/10/1975", urn:"urn:lex:br:federal:lei:1975-10-07;6246", ementa:"Suspende a vigência do artigo 1.215 do Código de Processo Civil.", arquivo:"federal/leis-ordinarias/1975/lei-6246-1975-10-07.md"}}, {id:"federal:BR:L:6285/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-12-11", numero:"6285", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-12-11;6285", vigente:true, titulo:"Lei nº 6.285 de 11/12/1975", urn:"urn:lex:br:federal:lei:1975-12-11;6285", ementa:"Autoriza o Poder Executivo a abrir ao Ministério das Comunicações o   crédito especial no valor de Cr$ 350.000,00 (trezentos e cinquenta mil   cruzeiros), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1975/lei-6285-1975-12-11.md"}}, {id:"federal:BR:L:6224/1975", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-07-14", numero:"6224", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-07-14;6224", vigente:true, titulo:"Lei nº 6.224 de 14/07/1975", urn:"urn:lex:br:federal:lei:1975-07-14;6224", ementa:"Regula o exercício da profissão de Propagandista e Vendedor de Produtos Farmacêuticos e dá outras providências.", arquivo:"federal/leis-ordinarias/1975/lei-6224-1975-07-14.md"}}, {id:"federal:BR:L:6271/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-11-26", numero:"6271", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-11-26;6271", vigente:true, titulo:"Lei nº 6.271 de 26/11/1975", urn:"urn:lex:br:federal:lei:1975-11-26;6271", ementa:"Autoriza o Poder Executivo a abrir ao Miinistério dos Transportes, o   crédito especial até o limite de Cr$ 44.863.500,00, para o fim que   especifica.", arquivo:"federal/leis-ordinarias/1975/lei-6271-1975-11-26.md"}}, {id:"federal:BR:L:6241/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-09-22", numero:"6241", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-09-22;6241", vigente:true, titulo:"Lei nº 6.241 de 22/09/1975", urn:"urn:lex:br:federal:lei:1975-09-22;6241", ementa:"Cria a 9ª Região da Justiça do Trabalho e o Tribunal Regional do Trabalho respectivo e institui a correspondente Procuradoria Regional do Ministério Público, e dá outras providências.", arquivo:"federal/leis-ordinarias/1975/lei-6241-1975-09-22.md"}}, {id:"federal:BR:L:6199/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-03-31", numero:"6199", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-03-31;6199", vigente:true, titulo:"Lei nº 6.199 de 31/03/1975", urn:"urn:lex:br:federal:lei:1975-03-31;6199", ementa:"Dispõe sôbre o pagamento das verbas, dotações ou quotas, devidas aos   Estados e Municípios e retidas ou suspensas por irregularidade e dá outras   providências.", arquivo:"federal/leis-ordinarias/1975/lei-6199-1975-03-31.md"}}, {id:"federal:BR:L:6209/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-05-28", numero:"6209", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-05-28;6209", vigente:true, titulo:"Lei nº 6.209 de 28/05/1975", urn:"urn:lex:br:federal:lei:1975-05-28;6209", ementa:"Denomina de \"Estação Florestal de Experimentação Dr. Epitácio Santiago\" a   atual \"Estação Florestal de Experimentação\" do Ministério da Agricultura,   localizada em Lorena, Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1975/lei-6209-1975-05-28.md"}}, {id:"federal:BR:L:6219/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-07-07", numero:"6219", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-07-07;6219", vigente:true, titulo:"Lei nº 6.219 de 07/07/1975", urn:"urn:lex:br:federal:lei:1975-07-07;6219", ementa:"Autoriza o Instituto Nacional de Colonização e Reforma Agrária - INCRA - a   doar o imóvel que menciona.", arquivo:"federal/leis-ordinarias/1975/lei-6219-1975-07-07.md"}}, {id:"federal:BR:L:6257/1975", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1975, data:"1975-10-29", numero:"6257", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1975-10-29;6257", vigente:true, titulo:"Lei nº 6.257 de 29/10/1975", urn:"urn:lex:br:federal:lei:1975-10-29;6257", ementa:"Fixa os valores de retribuição do Grupo-Planejamento e dá outras providências.", arquivo:"federal/leis-ordinarias/1975/lei-6257-1975-10-29.md"}}] AS row
