0714/2003", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2003, data:"2003-08-13", numero:"10714", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2003-08-13;10714", vigente:true, titulo:"Lei nº 10.714 de 13/08/2003", urn:"urn:lex:br:federal:lei:2003-08-13;10714", ementa:"Autoriza o Poder Executivo a disponibilizar, em âmbito nacional, número telefônico destinado a atender denúncias de violência contra a mulher.", arquivo:"federal/leis-ordinarias/2003/lei-10714-2003-08-13.md"}}, {id:"federal:BR:L:10733/2003", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2003, data:"2003-09-11", numero:"10733", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2003-09-11;10733", vigente:true, titulo:"Lei nº 10.733 de 11/09/2003", urn:"urn:lex:br:federal:lei:2003-09-11;10733", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, crédito suplementar no valor de R$ 52.878.297,00, em favor da Presidência da República e do Ministério das Relações Exteriores, para reforço de dotações consignadas na Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2003/lei-10733-2003-09-11.md"}}, {id:"federal:BR:L:10780/2003", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2003, data:"2003-11-25", numero:"10780", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2003-11-25;10780", vigente:true, titulo:"Lei nº 10.780 de 25/11/2003", urn:"urn:lex:br:federal:lei:2003-11-25;10780", ementa:"Abre ao Orçamento de Investimento, para 2003, em favor de diversas empresas estatais federais, crédito especial no valor total de R$ 3.895.568.955,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2003/lei-10780-2003-11-25.md"}}, {id:"federal:BR:L:10742/2003", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Le