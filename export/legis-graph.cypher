tulo:"Lei nº 6.656 de 05/06/1979", urn:"urn:lex:br:federal:lei:1979-06-05;6656", ementa:"Dispõe sobre a criação de cargos na Secretaria do Tribunal Regional   Eleitoral do Rio Grande do Sul, e dá outras providências.", arquivo:"federal/leis-ordinarias/1979/lei-6656-1979-06-05.md"}}, {id:"federal:BR:L:6629/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-04-16", numero:"6629", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-04-16;6629", vigente:true, titulo:"Lei nº 6.629 de 16/04/1979", urn:"urn:lex:br:federal:lei:1979-04-16;6629", ementa:"Estabelece normas para a comprovação de residência, quando exigida por   autoridade pública para a expedição de documento.", arquivo:"federal/leis-ordinarias/1979/lei-6629-1979-04-16.md"}}, {id:"federal:BR:L:6646/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-05-16", numero:"6646", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-05-16;6646", vigente:true, titulo:"Lei nº 6.646 de 16/05/1979", urn:"urn:lex:br:federal:lei:1979-05-16;6646", ementa:"Altera o efetivo de Soldados PM da Polícia Militar do Distrito Federal e   dá outras providências.", arquivo:"federal/leis-ordinarias/1979/lei-6646-1979-05-16.md"}}, {id:"federal:BR:L:6663/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-06-25", numero:"6663", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-06-25;6663", vigente:true, titulo:"Lei nº 6.663 de 25/06/1979", urn:"urn:lex:br:federal:lei:1979-06-25;6663", ementa:"Autoriza a permuta do terreno que menciona por imóvel localizado na cidade   de Quito, República do Equador.", arquivo:"federal/leis-ordinarias/1979/lei-6663-1979-06-25.md"}}, {id:"federal:BR:L:6636/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-05-08", numero:"6636", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-05-08;6636", vigente:true, titulo:"Lei nº 6.636 de 08/05/1979", urn:"urn:lex:br:federal:lei:1979-05-08;6636", ementa:"Dá nova redação ao parágrafo único do art. 12 da Lei n.º 3.807, de 26 de agosto de 1960 (Lei Orgânica da Previdência Social) .", arquivo:"federal/leis-ordinarias/1979/lei-6636-1979-05-08.md"}}, {id:"federal:BR:L:6763/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-12-18", numero:"6763", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-12-18;6763", vigente:true, titulo:"Lei nº 6.763 de 18/12/1979", urn:"urn:lex:br:federal:lei:1979-12-18;6763", ementa:"Reajusta o valor da pensão especial concedida a Rufina Cardoso Machado.", arquivo:"federal/leis-ordinarias/1979/lei-6763-1979-12-18.md"}}, {id:"federal:BR:L:6666/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-07-03", numero:"6666", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-07-03;6666", vigente:true, titulo:"Lei nº 6.666 de 03/07/1979", urn:"urn:lex:br:federal:lei:1979-07-03;6666", ementa:"Dispõe sobre a contratação de pessoal, pela Fundação Instituto Brasileiro   de Geografia e Estatística - IBGE, para realizar coletas de dados.", arquivo:"federal/leis-ordinarias/1979/lei-6666-1979-07-03.md"}}, {id:"federal:BR:L:6755/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-12-17", numero:"6755", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-12-17;6755", vigente:true, titulo:"Lei nº 6.755 de 17/12/1979", urn:"urn:lex:br:federal:lei:1979-12-17;6755", ementa:"Autoriza o Poder Executivo a abrir, em favor do Ministério dos Transportes   e do Fundo Nacional de Desenvolvimento, crédito especial até o limite de Cr$   3.629.478.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/1979/lei-6755-1979-12-17.md"}}, {id:"federal:BR:L:6760/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-12-17", numero:"6760", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-12-17;6760", vigente:true, titulo:"Lei nº 6.760 de 17/12/1979", urn:"urn:lex:br:federal:lei:1979-12-17;6760", ementa:"Concede pensão especial a Cleide Severino Ribeiro e dá outras   providências.", arquivo:"federal/leis-ordinarias/1979/lei-6760-1979-12-17.md"}}, {id:"federal:BR:L:6644/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-05-14", numero:"6644", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-05-14;6644", vigente:true, titulo:"Lei nº 6.644 de 14/05/1979", urn:"urn:lex:br:federal:lei:1979-05-14;6644", ementa:"Cria cargos no Quadro Permanente da Secretaria do Tribunal Regianal do   Trabalho da 9ª Região e dá outras providências.", arquivo:"federal/leis-ordinarias/1979/lei-6644-1979-05-14.md"}}, {id:"federal:BR:L:6631/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-04-19", numero:"6631", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-04-19;6631", vigente:true, titulo:"Lei nº 6.631 de 19/04/1979", urn:"urn:lex:br:federal:lei:1979-04-19;6631", ementa:"Acrescenta parágrafo ao art. 35 do Decreto-Lei nº 221, de 28 de fevereiro de 1967, que \"dispõe sobre a proteção e estímulo à pesca e dá outras providências\".", arquivo:"federal/leis-ordinarias/1979/lei-6631-1979-04-19.md"}}, {id:"federal:BR:L:6641/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-05-08", numero:"6641", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-05-08;6641", vigente:true, titulo:"Lei nº 6.641 de 08/05/1979", urn:"urn:lex:br:federal:lei:1979-05-08;6641", ementa:"Cria cargos em comissão e fixa valores de vencimentos do Grupo-Direção e   Assessoramento Superiores do Quadro Permanente da Secretaria do Tribunal   Regional do Trabalho da 9ª Região e dá outras providências.", arquivo:"federal/leis-ordinarias/1979/lei-6641-1979-05-08.md"}}, {id:"federal:BR:L:6723/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-11-19", numero:"6723", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-11-19;6723", vigente:true, titulo:"Lei nº 6.723 de 19/11/1979", urn:"urn:lex:br:federal:lei:1979-11-19;6723", ementa:"Suprime o art. 11 das Regras de admissão de Agentes Consulares   estrangeiros no Brasil, aprovadas pelo Decreto-Lei nº 4.391, de 18 de junho de   1942.", arquivo:"federal/leis-ordinarias/1979/lei-6723-1979-11-19.md"}}, {id:"federal:BR:L:6745/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-12-05", numero:"6745", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-12-05;6745", vigente:true, titulo:"Lei nº 6.745 de 05/12/1979", urn:"urn:lex:br:federal:lei:1979-12-05;6745", ementa:"Acrescenta parágrafo ao art. 20 da Lei n. 5869, de 11 de janeiro de 1973 - Código de Proceso Civil.", arquivo:"federal/leis-ordinarias/1979/lei-6745-1979-12-05.md"}}, {id:"federal:BR:L:6670/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-07-04", numero:"6670", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-07-04;6670", vigente:true, titulo:"Lei nº 6.670 de 04/07/1979", urn:"urn:lex:br:federal:lei:1979-07-04;6670", ementa:"Dispõe sobre doação de lote à Organização das Nações Unidas - ONU - pela   Companhia Imobiliária de Brasília - TERRACAP.", arquivo:"federal/leis-ordinarias/1979/lei-6670-1979-07-04.md"}}, {id:"federal:BR:L:6736/1979", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-12-05", numero:"6736", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-12-05;6736", vigente:true, titulo:"Lei nº 6.736 de 05/12/1979", urn:"urn:lex:br:federal:lei:1979-12-05;6736", ementa:"Retifica, sem ônus, a Lei nº 6597, de 1º de dezembro de 1978, que \"estima   a Receita e fixa a Despesa da União para o exercício financeiro de 1979\".", arquivo:"federal/leis-ordinarias/1979/lei-6736-1979-12-05.md"}}, {id:"federal:BR:L:6749/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-12-10", numero:"6749", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-12-10;6749", vigente:true, titulo:"Lei nº 6.749 de 10/12/1979", urn:"urn:lex:br:federal:lei:1979-12-10;6749", ementa:"Autoriza a doação ao Departamento Nacional de Obras de Saneamento do   terreno que menciona, situado no Município de Porto Alegre, Estado Rio Grande do   Sul.", arquivo:"federal/leis-ordinarias/1979/lei-6749-1979-12-10.md"}}, {id:"federal:BR:L:6669/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1979, data:"1979-07-04", numero:"6669", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1979-07-04;6669", vigente:true, titulo:"Lei nº 6.669 de 04/07/1979", urn:"urn:lex:br:federal:lei:1979-07-04;6669", ementa:"Altera o art. 21, e seus parágrafos do Decreto-Lei nº 411, de 8 de janeiro de 1969, e dá outras providências.", arquivo:"federal/leis-ordinarias/1979/lei-6669-1979-07-04.md"}}, {id:"federal:BR:L:6702/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_ori