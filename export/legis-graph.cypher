arias/1953/lei-1834-1953-04-02.md"}}, {id:"federal:BR:L:1947/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-08-18", numero:"1947", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-08-18;1947", vigente:true, titulo:"Lei nº 1.947 de 18/08/1953", urn:"urn:lex:br:federal:lei:1953-08-18;1947", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e obras Públicas, o crédito especial de Cr$ 27.703.000,00 destinado ao pagamento do aumento de salários dos servidores dos Serviços da Amazônia e da Administração do Porto Pará.", arquivo:"federal/leis-ordinarias/1953/lei-1947-1953-08-18.md"}}, {id:"federal:BR:L:1851/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-04-30", numero:"1851", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-04-30;1851", vigente:true, titulo:"Lei nº 1.851 de 30/04/1953", urn:"urn:lex:br:federal:lei:1953-04-30;1851", ementa:"Retifica a Lei nº 1.757, de 10 de dezembro de 1952, que estima a Receita e Fixa a Despesa da União para o exercício financeiro de 1953.", arquivo:"federal/leis-ordinarias/1953/lei-1851-1953-04-30.md"}}, {id:"federal:BR:L:1971/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-08-31", numero:"1971", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-08-31;1971", vigente:true, titulo:"Lei nº 1.971 de 31/08/1953", urn:"urn:lex:br:federal:lei:1953-08-31;1971", ementa:"Prorroga por mais 120 dias, o prazo estipulado no art. 13, da Lei n° 1.563, de 1º de março de 1952.", arquivo:"federal/leis-ordinarias/1953/lei-1971-1953-08-31.md"}}, {id:"federal:BR:L:2097/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-11-19", numero:"2097", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-11-19;2097", vigente:true, titulo:"Lei nº 2.097 de 19/11/1953", urn:"urn:lex:br:federal:lei:1953-11-19;2097", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Justiça e Negócios Interiores, o crédito especial de Cr$ 2.000.000,00, destinado a auxiliar o término da construção e equipamentos do novo edifício do Abrigo Francisco de Paula.", arquivo:"federal/leis-ordinarias/1953/lei-2097-1953-11-19.md"}}, {id:"federal:BR:L:1854/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-05-07", numero:"1854", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-05-07;1854", vigente:true, titulo:"Lei nº 1.854 de 07/05/1953", urn:"urn:lex:br:federal:lei:1953-05-07;1854", ementa:"Abre ao Congresso Nacional - Câmara dos Deputados - o crédito especial de Cr$ 5.652.000,00, para pagamento aos Deputados, da ajuda de custo devida pela convocação extraordinária, feita pelo Presidente da República, no período de 15 de janeiro a 9 de março de 1953.", arquivo:"federal/leis-ordinarias/1953/lei-1854-1953-05-07.md"}}, {id:"federal:BR:L:2104/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-11-23", numero:"2104", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-11-23;2104", vigente:true, titulo:"Lei nº 2.104 de 23/11/1953", urn:"urn:lex:br:federal:lei:1953-11-23;2104", ementa:"Autoriza o Poder Executivo a permutar área de terreno pertencente à Viação Férrea do Rio Grande do Sul, por conta igual de propriedade da firma Xavier Irmãos S.A. - Estivas e Comércio Geral.", arquivo:"federal/leis-ordinarias/1953/lei-2104-1953-11-23.md"}}, {id:"federal:BR:L:1943/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-08-14", numero:"1943", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-08-14;1943", vigente:true, titulo:"Lei nº 1.943 de 14/08/1953", urn:"urn:lex:br:federal:lei:1953-08-14;1943", ementa:"Reabre os prazos referidos pelos § 3º do art. 29 da Lei n° 488, de 15 de novembro de 1948 ;e art. 1º da Lei n° 1.063, de 13 de fevereiro de de 1950.", arquivo:"federal/leis-ordinarias/1953/lei-1943-1953-08-14.md"}}, {id:"federal:BR:L:2023/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-10-15", numero:"2023", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-10-15;2023", vigente:true, titulo:"Lei nº 2.023 de 15/10/1953", urn:"urn:lex:br:federal:lei:1953-10-15;2023", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura, os créditos especiais de Cr$ 10.000.000,00 (dez milhões de cruzeiros) , Cr$ 10.000.000,00 (dez milhões de cruzeiros), Cr$ 1.000.000,00 (um milhão de cruzeiros) e Cr$ 2.000.000,00 (dois milhões de cruzeiros), para auxiliar, respectivamente, a construção da sede do Museu de Arte Moderna, do Teatro Castro Alves, da Escola de Belas Artes de Pelotas e do Museu Mariano Procópio.", arquivo:"federal/leis-ordinarias/1953/lei-2023-1953-10-15.md"}}, {id:"federal:BR:L:2017/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-10-12", numero:"2017", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-10-12;2017", vigente:true, titulo:"Lei nº 2.017 de 12/10/1953", urn:"urn:lex:br:federal:lei:1953-10-12;2017", ementa:"Autoriza o Poder Executivo a emitir, pelo Ministério da Viação e Obras Públicas - Departamento dos Correios e Telegrafos - uma série de selos postais comemorativos do centenário de emancipação política do Paraná, e dá outras providências.", arquivo:"federal/leis-ordinarias/1953/lei-2017-1953-10-12.md"}}, {id:"federal:BR:L:2006/1953", properties:{esfera:"federal", versao_tex