7-13.md"}}, {id:"federal:BR:L:2129/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-12-07", numero:"2129", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-12-07;2129", vigente:true, titulo:"Lei nº 2.129 de 07/12/1953", urn:"urn:lex:br:federal:lei:1953-12-07;2129", ementa:"Autoriza a União a doar à Federação das Indústrias do Estado de Goiás, o lote de terras números 70 - 68 - 33 - 35, da quadra 69, setor Central de Goiânia.", arquivo:"federal/leis-ordinarias/1953/lei-2129-1953-12-07.md"}}, {id:"federal:BR:L:2025/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-10-15", numero:"2025", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-10-15;2025", vigente:true, titulo:"Lei nº 2.025 de 15/10/1953", urn:"urn:lex:br:federal:lei:1953-10-15;2025", ementa:"Denomina Professores de Educação Física os atuais Instrutores de Educação Física do Instituto Benjamin Constant.", arquivo:"federal/leis-ordinarias/1953/lei-2025-1953-10-15.md"}}, {id:"federal:BR:L:2019/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-10-12", numero:"2019", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-10-12;2019", vigente:true, titulo:"Lei nº 2.019 de 12/10/1953", urn:"urn:lex:br:federal:lei:1953-10-12;2019", ementa:"Concede a pensão especial de Cr$ 3.000,00 à viúva e a filha do Professor João Carlos Teixeira Brandão", arquivo:"federal/leis-ordinarias/1953/lei-2019-1953-10-12.md"}}, {id:"federal:BR:L:2008/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-10-05", numero:"2008", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-10-05;2008", vigente:true, titulo:"Lei nº 2.008 de 05/10/1953", urn:"urn:le