original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-10", numero:"6844", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-10;6844", vigente:true, titulo:"Lei nº 6.844 de 10/11/1980", urn:"urn:lex:br:federal:lei:1980-11-10;6844", ementa:"Autoriza a reversão ao Município de Palmeira dos Índios, Estado de   Alagoas, do terreno que menciona.", arquivo:"federal/leis-ordinarias/1980/lei-6844-1980-11-10.md"}}, {id:"federal:BR:L:6809/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-07-07", numero:"6809", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-07-07;6809", vigente:true, titulo:"Lei nº 6.809 de 07/07/1980", urn:"urn:lex:br:federal:lei:1980-07-07;6809", ementa:"Cria e transforma cargos do Quadro Permanente do Senado Federal, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1980/lei-6809-1980-07-07.md"}}] AS row
