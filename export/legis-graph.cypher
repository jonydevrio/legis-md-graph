eral:BR:L:2650/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-11-18", numero:"2650", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-11-18;2650", vigente:true, titulo:"Lei nº 2.650 de 18/11/1955", urn:"urn:lex:br:federal:lei:1955-11-18;2650", ementa:"Revoga a letra \"g\", do art. 10 do Decreto-Lei n° 5.625, de 28 de junho de   1943.", arquivo:"federal/leis-ordinarias/1955/lei-2650-1955-11-18.md"}}, {id:"federal:BR:L:2560/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-08-12", numero:"2560", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-08-12;2560", vigente:true, titulo:"Lei nº 2.560 de 12/08/1955", urn:"urn:lex:br:federal:lei:1955-08-12;2560", ementa:"Concede isenção de direitos de importação e mais taxas aduaneiras para equipamento importado pela firma Eletro Metalúrgica Abrasivos Salto Ltda.", arquivo:"federal/leis-ordinarias/1955/lei-2560-1955-08-12.md"}}, {id:"federal:BR:L:2690/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-12-22", numero:"2690", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-12-22;2690", vigente:true, titulo:"Lei nº 2.690 de 22/12/1955", urn:"urn:lex:br:federal:lei:1955-12-22;2690", ementa:"Concede isenção de direitos de importação e taxas aduaneiras, exceto a de Previdência Social, para materiais elétricos importados por Coutinho &amp; Pena e destinados à Usina Hidroelétrica de Sumidouro, Município de Caratinga, Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/1955/lei-2690-1955-12-22.md"}}, {id:"federal:BR:L:2670/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-12-06", numero:"2670", fonte:"https://normas.leg.br/?urn=urn:lex:br:fe