ederal/leis-ordinarias/1954/lei-2367-1954-12-07.md"}}, {id:"federal:BR:L:2292/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-08-23", numero:"2292", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-08-23;2292", vigente:true, titulo:"Lei nº 2.292 de 23/08/1954", urn:"urn:lex:br:federal:lei:1954-08-23;2292", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações   Exteriores, o crédito especial de Cr$ 3.000.000,00 para atender às despesas   decorrentes das visitas ao Brasil do Presidente da República do Peru e do   Ministro das Relações Exteriores do Equador.", arquivo:"federal/leis-ordinarias/1954/lei-2292-1954-08-23.md"}}, {id:"federal:BR:L:2197/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-04-05", numero:"2197", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-04-05;2197", vigente:true, titulo:"Lei nº 2.197 de 05/04/1954", urn:"urn:lex:br:federal:lei:1954-04-05;2197", ementa:"Modifica o § 2º do artigo 19 do Decreto-Lei nº 925, de 2 de dezembro de 1938 - Código de Justiça Militar.", arquivo:"federal/leis-ordinarias/1954/lei-2197-1954-04-05.md"}}, {id:"federal:BR:L:2269/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-07-20", numero:"2269", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-07-20;2269", vigente:true, titulo:"Lei nº 2.269 de 20/07/1954", urn:"urn:lex:br:federal:lei:1954-07-20;2269", ementa:"Concede a inclusão da Faculdade de Filosofia da Pontifícia Universidade   Católica do Rio de Janeiro na categoria de estabelecimentos subvencionados pelo   Governo Federal.", arquivo:"federal/leis-ordinarias/1954/lei-2269-1954-07-20.md"}}, {id:"federal:BR:L:2160/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária