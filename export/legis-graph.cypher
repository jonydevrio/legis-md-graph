l:lei:1976-04-14;6322", ementa:"Dispensa a prestação de fiança por servidores civis da União e dá outras   providências.", arquivo:"federal/leis-ordinarias/1976/lei-6322-1976-04-14.md"}}, {id:"federal:BR:L:6357/1976", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1976, data:"1976-09-08", numero:"6357", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1976-09-08;6357", vigente:true, titulo:"Lei nº 6.357 de 08/09/1976", urn:"urn:lex:br:federal:lei:1976-09-08;6357", ementa:"Dispõe sobre a criação de cargos no Grupo-Atividades de Controle Externo   do Quadro Permanente da Secretaria-Geral do Tribunal de Contas da União e dá   outras providências.", arquivo:"federal/leis-ordinarias/1976/lei-6357-1976-09-08.md"}}, {id:"federal:BR:L:6403/1976", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1976, data:"1976-12-15", numero:"6403", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1976-12-15;6403", vigente:true, titulo:"Lei nº 6.403 de 15/12/1976", urn:"urn:lex:br:federal:lei:1976-12-15;6403", ementa:"Modifica dispositivos do Decreto-Lei n° ;227, de 28 de fevereiro de 1967 (Código de Mineração), alterado pelo Decreto-Lei n° ;318, de 14 de março de 1967.", arquivo:"federal/leis-ordinarias/1976/lei-6403-1976-12-15.md"}}, {id:"federal:BR:L:6389/1976", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1976, data:"1976-12-09", numero:"6389", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1976-12-09;6389", vigente:true, titulo:"Lei nº 6.389 de 09/12/1976", urn:"urn:lex:br:federal:lei:1976-12-09;6389", ementa:"Fixa as Referências de salário dos empregos do Grupo-Processamento de Dados e dá outras providências.", arquivo:"federal/leis-ordinarias/1976/lei-6389-1976-12-09.md"}}, {id:"federal:BR:L:6319/1976", properties:{esfera:"federal", versao_