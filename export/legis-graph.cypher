-11-18;4283", ementa:"Reestrutura a Universidade do Pará, cria cargos na Universidade de Alagoas, e dá outras providências.", arquivo:"federal/leis-ordinarias/1963/lei-4283-1963-11-18.md"}}, {id:"federal:BR:L:4237/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-06-24", numero:"4237", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-06-24;4237", vigente:true, titulo:"Lei nº 4.237 de 24/06/1963", urn:"urn:lex:br:federal:lei:1963-06-24;4237", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Guerra, o crédito especial de Cr$ 5.000.000,00 destinado a auxiliar a construção de um Panteon Militar, na Academia Militar das Agulhas Negras, Município de Resende, Estado do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1963/lei-4237-1963-06-24.md"}}, {id:"federal:BR:L:4257/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-09-10", numero:"4257", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-09-10;4257", vigente:true, titulo:"Lei nº 4.257 de 10/09/1963", urn:"urn:lex:br:federal:lei:1963-09-10;4257", ementa:"Concede isenção dos impostos de importação e de consumo e da taxa de despacho aduaneiro à Empresa Fluminense de Energia Elétrica S.A., para importação de equipamento destinado a instalações hidrelétricas ou termelétricas no Estado do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1963/lei-4257-1963-09-10.md"}}, {id:"federal:BR:L:4211/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-02-11", numero:"4211", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-02-11;4211", vigente:true, titulo:"Lei nº 4.211 de 11/02/1963", urn:"urn:lex:br:federal:lei:1963-02-11;4211", ementa:"Inclui a Pontifícia Universidade Católica de São Paulo entre os estabelecimentos subvencionados pelo Governo Federal.", arquivo:"federal/leis-ordinarias/1963/lei-4211-1963-02-11.md"}}, {id:"federal:BR:L:4248/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-07-30", numero:"4248", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-07-30;4248", vigente:true, titulo:"Lei nº 4.248 de 30/07/1963", urn:"urn:lex:br:federal:lei:1963-07-30;4248", ementa:"Altera o inciso I do art. 945 do Código do Processo Civil e os arts. 1º e 2º do Decreto-lei n. 3077, de 26 de fevereiro de 1941.", arquivo:"federal/leis-ordinarias/1963/lei-4248-1963-07-30.md"}}, {id:"federal:BR:L:4288/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-12-03", numero:"4288", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-12-03;4288", vigente:true, titulo:"Lei nº 4.288 de 03/12/1963", urn:"urn:lex:br:federal:lei:1963-12-03;4288", ementa:"Altera a redação dos arts. 330 e 334 da Lei nº 1.316, de 20 de janeiro de 1951 (Código de Vencimentos e Vantagens dos Militares).", arquivo:"federal/leis-ordinarias/1963/lei-4288-1963-12-03.md"}}, {id:"federal:BR:L:4279/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-11-04", numero:"4279", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-11-04;4279", vigente:true, titulo:"Lei nº 4.279 de 04/11/1963", urn:"urn:lex:br:federal:lei:1963-11-04;4279", ementa:"Altera o Quadro do Pessoal da Secretaria do Supremo Tribunal Federal.", arquivo:"federal/leis-ordinarias/1963/lei-4279-1963-11-04.md"}}, {id:"federal:BR:L:4235/1963", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1963, data:"1963-06-21", numero:"4235", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1963-06-21;4235-a", vigente:tru