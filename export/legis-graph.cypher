UNWIND [{id:"federal:BR:L:13467/2017", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-07-13", numero:"13467", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-07-13;13467", vigente:true, titulo:"Lei nº 13.467 de 13/07/2017", urn:"urn:lex:br:federal:lei:2017-07-13;13467", ementa:"Altera a Consolidação das Leis do Trabalho (CLT), aprovada pelo Decreto-Lei nº 5.452, de 1º de maio de 1943, e as Leis nºs 6.019, de 3 de janeiro de 1974, 8.036, de 11 de maio de 1990, e 8.212, de 24 de julho de 1991, a fim de adequar a legislação às novas relações de trabalho.", arquivo:"federal/leis-ordinarias/2017/lei-13467-2017-07-13.md"}}, {id:"federal:BR:L:13455/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-06-26", numero:"13455", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-06-26;13455", vigente:true, titulo:"Lei nº 13.455 de 26/06/2017", urn:"urn:lex:br:federal:lei:2017-06-26;13455", ementa:"Dispõe sobre a diferenciação de preços de bens e serviços oferecidos ao público em função do prazo ou do instrumento de pagamento utilizado, e altera a Lei nº 10.962, de 11 de outubro de 2004.", arquivo:"federal/leis-ordinarias/2017/lei-13455-2017-06-26.md"}}, {id:"federal:BR:L:13489/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-10-06", numero:"13489", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-10-06;13489", vigente:true, titulo:"Lei nº 13.489 de 06/10/2017", urn:"urn:lex:br:federal:lei:2017-10-06;13489", ementa:"Altera a Lei nº 8.935, de 18 de novembro de 1994 - Lei dos Cartórios, que regulamenta o art. 236 da Constituição Federal, dispondo sobre serviços notariais e de registro.", arquivo:"federal/leis-ordinarias/2017/lei-13489-2017-10-06.md"}}, {id:"federal:BR:L:13584/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-12-26", numero:"13584", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-12-26;13584", vigente:true, titulo:"Lei nº 13.584 de 26/12/2017", urn:"urn:lex:br:federal:lei:2017-12-26;13584", ementa:"Confere ao Município de Castro, no Estado do Paraná, o título de Capital Nacional do Leite.", arquivo:"federal/leis-ordinarias/2017/lei-13584-2017-12-26.md"}}, {id:"federal:BR:L:13575/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-12-26", numero:"13575", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-12-26;13575", vigente:true, titulo:"Lei nº 13.575 de 26/12/2017", urn:"urn:lex:br:federal:lei:2017-12-26;13575", ementa:"Cria a Agência Nacional de Mineração (ANM); extingue o Departamento Nacional de Produção Mineral (DNPM); altera as Leis nºs 11.046, de 27 de dezembro de 2004, e 10.826, de 22 de dezembro de 2003; e revoga a Lei nº 8.876, de 2 de maio de 1994, e dispositivos do Decreto-Lei nº 227, de 28 de fevereiro de 1967 (Código de Mineração).", arquivo:"federal/leis-ordinarias/2017/lei-13575-2017-12-26.md"}}, {id:"federal:BR:L:13528/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-11-29", numero:"13528", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-11-29;13528", vigente:true, titulo:"Lei nº 13.528 de 29/11/2017", urn:"urn:lex:br:federal:lei:2017-11-29;13528", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor da Presidência da República e dos Ministérios da Agricultura, Pecuária e Abastecimento, da Justiça e Cidadania, da Saúde, dos Transportes, Portos e Aviação Civil, do Esporte, da Defesa, da Integração Nacional, do Turismo e do Desenvolvimento Social e Agrário, crédito suplementar no valor de R$ 6.988.987.930,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2017/lei-13528-2017-11-29.md"}}, {id:"federal:BR:L:13437/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-04-19", numero:"13437", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-04-19;13437", vigente:true, titulo:"Lei nº 13.437 de 19/04/2017", urn:"urn:lex:br:federal:lei:2017-04-19;13437", ementa:"Institui o Dia Nacional do Perdão.", arquivo:"federal/leis-ordinarias/2017/lei-13437-2017-04-19.md"}}, {id:"federal:BR:L:13474/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-08-23", numero:"13474", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-08-23;13474", vigente:true, titulo:"Lei nº 13.474 de 23/08/2017", urn:"urn:lex:br:federal:lei:2017-08-23;13474", ementa:"Transforma a Autoridade Pública Olímpica (APO) na Autoridade de Governança do Legado Olímpico (Aglo); altera a Lei no 11.356, de 19 de outubro de 2006; revoga a Lei nº 12.396, de 21 de março de 2011; e dá outras providências.", arquivo:"federal/leis-ordinarias/2017/lei-13474-2017-08-23.md"}}, {id:"federal:BR:L:13546/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-12-19", numero:"13546", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-12-19;13546", vigente:true, titulo:"Lei nº 13.546 de 19/12/2017", urn:"urn:lex:br:federal:lei:2017-12-19;13546", ementa:"Altera dispositivos da Lei nº 9.503, de 23 de setembro de 1997 (Código de Trânsito Brasileiro), para dispor sobre crimes cometidos na direção de veículos automotores.", arquivo:"federal/leis-ordinarias/2017/lei-13546-2017-12-19.md"}}, {id:"federal:BR:L:13428/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-03-30", numero:"13428", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-03-30;13428", vigente:true, titulo:"Lei nº 13.428 de 30/03/2017", urn:"urn:lex:br:federal:lei:2017-03-30;13428", ementa:"Altera a Lei nº 13.254, de 13 de janeiro de 2016, que \"Dispõe sobre o Regime Especial de Regularização Cambial e Tributária (RERCT) de recursos, bens ou direitos de origem lícita, não declarados ou declarados incorretamente, remetidos, mantidos no exterior ou repatriados por residentes ou domiciliados no País\".", arquivo:"federal/leis-ordinarias/2017/lei-13428-2017-03-30.md"}}, {id:"federal:BR:L:13555/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-12-20", numero:"13555", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-12-20;13555", vigente:true, titulo:"Lei nº 13.555 de 20/12/2017", urn:"urn:lex:br:federal:lei:2017-12-20;13555", ementa:"Altera a Lei nº 13.408, de 26 de dezembro de 2016, que dispõe sobre as diretrizes para a elaboração e execução da Lei Orçamentária de 2017.", arquivo:"federal/leis-ordinarias/2017/lei-13555-2017-12-20.md"}}, {id:"federal:BR:L:13516/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-11-24", numero:"13516", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-11-24;13516", vigente:true, titulo:"Lei nº 13.516 de 24/11/2017", urn:"urn:lex:br:federal:lei:2017-11-24;13516", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério da Justiça e Cidadania, crédito especial no valor de R$ 60.000.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/2017/lei-13516-2017-11-24.md"}}, {id:"federal:BR:L:13522/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-11-27", numero:"13522", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-11-27;13522", vigente:true, titulo:"Lei nº 13.522 de 27/11/2017", urn:"urn:lex:br:federal:lei:2017-11-27;13522", ementa:"Altera a Lei nº 11.664, de 29 de abril de 2008, para estabelecer que serão desenvolvidas estratégias intersetoriais específicas para mulheres com dificuldade de acesso às ações de saúde relativas a prevenção, detecção, tratamento e controle dos cânceres do colo uterino e de mama.", arquivo:"federal/leis-ordinarias/2017/lei-13522-2017-11-27.md"}}, {id:"federal:BR:L:13563/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-12-21", numero:"13563", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-12-21;13563", vigente:true, titulo:"Lei nº 13.563 de 21/12/2017", urn:"urn:lex:br:federal:lei:2017-12-21;13563", ementa:"Confere ao Município de Teutônia, no Estado do Rio Grande do Sul, o título de Capital Nacional do Canto Coral.", arquivo:"federal/leis-ordinarias/2017/lei-13563-2017-12-21.md"}}, {id:"federal:BR:L:13469/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-07-19", numero:"13469", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-07-19;13469", vigente:true, titulo:"Lei nº 13.469 de 19/07/2017", urn:"urn:lex:br:federal:lei:2017-07-19;13469", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério da Justiça e Cidadania, crédito suplementar no valor de R$ 102.385.511,00, para reforço de dotação constante da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2017/lei-13469-2017-07-19.md"}}, {id:"federal:BR:L:13533/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-12-15", numero:"13533", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-12-15;13533", vigente:true, titulo:"Lei nº 13.533 de 15/12/2017", urn:"urn:lex:br:federal:lei:2017-12-15;13533", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor dos Ministérios do Trabalho, do Meio Ambiente e do Desenvolvimento Social e Agrário e de Encargos Financeiros da União, crédito suplementar no valor de R$ 4.511.886.489,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2017/lei-13533-2017-12-15.md"}}, {id:"federal:BR:L:13532/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-12-07", numero:"13532", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-12-07;13532", vigente:true, titulo:"Lei nº 13.532 de 07/12/2017", urn:"urn:lex:br:federal:lei:2017-12-07;13532", ementa:"Altera a redação do art. 1.815 da Lei nº 10.406, de 10 de janeiro de 2002 - Código Civil, para promover ação visando à declaração de indignidade de herdeiro ou legatário.", arquivo:"federal/leis-ordinarias/2017/lei-13532-2017-12-07.md"}}, {id:"federal:BR:L:13422/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-03-27", numero:"13422", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-03-27;13422", vigente:true, titulo:"Lei nº 13.422 de 27/03/2017", urn:"urn:lex:br:federal:lei:2017-03-27;13422", ementa:"Inscreve o nome de Clara Camarão no Livro dos Heróis da Pátria.", arquivo:"federal/leis-ordinarias/2017/lei-13422-2017-03-27.md"}}, {id:"federal:BR:L:13509/2017", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-11-22", numero:"13509", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-11-22;13509", vigente:true, titulo:"Lei nº 13.509 de 22/11/2017", urn:"urn:lex:br:federal:lei:2017-11-22;13509", ementa:"Dispõe sobre adoção e altera a Lei nº 8.069, de 13 de julho de 1990 (Estatuto da Criança e do Adolescente), a Consolidação das Leis do Trabalho (CLT), aprovada pelo Decreto-Lei nº 5.452, de 1º de maio de 1943, e a Lei nº 10.406, de 10 de janeiro de 2002 (Código Civil).", arquivo:"federal/leis-ordinarias/2017/lei-13509-2017-11-22.md"}}, {id:"federal:BR:L:13572/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-12-21", numero:"13572", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-12-21;13572", vigente:true, titulo:"Lei nº 13.572 de 21/12/2017", urn:"urn:lex:br:federal:lei:2017-12-21;13572", ementa:"Dispõe sobre a prestação de auxílio financeiro pela União aos Estados, ao Distrito Federal e aos Municípios, relativo ao exercício de 2017, com o objetivo de fomentar as exportações do País.", arquivo:"federal/leis-ordinarias/2017/lei-13572-2017-12-21.md"}}, {id:"federal:BR:L:13436/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-04-12", numero:"13436", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-04-12;13436", vigente:true, titulo:"Lei nº 13.436 de 12/04/2017", urn:"urn:lex:br:federal:lei:2017-04-12;13436", ementa:"Altera a Lei nº 8.069, de 13 de julho de 1990 (Estatuto da Criança e do Adolescente), para garantir o direito a acompanhamento e orientação à mãe com relação à amamentação.", arquivo:"federal/leis-ordinarias/2017/lei-13436-2017-04-12.md"}}, {id:"federal:BR:L:13505/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-11-08", numero:"13505", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-11-08;13505", vigente:true, titulo:"Lei nº 13.505 de 08/11/2017", urn:"urn:lex:br:federal:lei:2017-11-08;13505", ementa:"Acrescenta dispositivos à Lei nº 11.340, de 7 de agosto de 2006 (Lei Maria da Penha), para dispor sobre o direito da mulher em situação de violência doméstica e familiar de ter atendimento policial e pericial especializado, ininterrupto e prestado, preferencialmente, por servidores do sexo feminino.", arquivo:"federal/leis-ordinarias/2017/lei-13505-2017-11-08.md"}}, {id:"federal:BR:L:13485/2017", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2017, data:"2017-10-02", numero:"13485", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2017-10-02;13485", vigente:true, titulo:"Lei nº 13.485 de 02/10/2017", urn:"urn:lex:br:federal:lei:2017-10-02;13485", ementa:"Dispõe sobre o parcelamento de débitos com a Fazenda Nacional relativos às contribuições previdenciárias de responsabilidade dos Estados, do Distrito Federal e dos Municípios, e sobre a revisão da dívida previdenciária dos Municípios pelo Poder Executivo federal; altera a Lei nº 9.796, de 5 de maio de 1999; e dá outras providências.", arquivo:"federal/leis-ordinarias/2017/lei-13485-2017-10-02.md"}}, {id:"federal:BR:L:9452/1997", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1997, data:"1997-03-20", numero:"9452", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1997-03-20;9452", vigente:true, titulo:"Lei nº 9.452 de 20/03/1997", urn:"urn:lex:br:federal:lei:1997-03-20;9452", ementa:"Determina que as Câmaras Municipais sejam obrigatoriamente notificadas da   liberação de recursos federais para os respectivos Municípios e dá outras   providências.", arquivo:"federal/leis-ordinarias/1997/lei-9452-1997-03-20.md"}}, {id:"federal:BR:L:9524/1997", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1997, data:"1997-12-02", numero:"9524", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1997-12-02;9524", vigente:true, titulo:"Lei nº 9.524 de 02/12/1997", urn:"urn:lex:br:federal:lei:1997-12-02;9524", ementa:"Autoriza o Poder Executivo a abrir aos Orçamentos Fiscal e da Seguridade   Social da União, em favor de diversos órgãos dos Poderes Legislativo e   Executivo, crédito suplementar no valor de R$955.767.787,00, para os fins que   especifica.", arquivo:"federal/leis-ordinarias/1997/lei-9524-1997-12-02.md"}}, {id:"federal:BR:L:9586/1997", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1997, data:"1997-12-19", numero:"9586", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1997-12-19;9586", vigente:true, titulo:"Lei nº 9.586 de 19/12/1997", urn:"urn:lex:br:federal:lei:1997-12-19;9586", ementa:"Autoriza o Poder Executivo a abrir aos Orçamentos Fiscal e da Seguridade   Social da União, em favor do Ministério Público da União e de diversos Órgãos do   Poder judiciário, crédito suplementar no valor global de R$ 30.297.451,00, para   os fins que especifica.", arquivo:"federal/leis-ordinarias/1997/lei-9586-1997-12-19.md"}}, {id:"federal:BR:L:9491/1997", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1997, data:"1997-09-09", numero:"9491", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1997-09-09;9491", vigente:true, titulo:"Lei nº 9.491 de 09/09/1997", urn:"urn:lex:br:federal:lei:1997-09-09;9491", ementa:"Altera procedimentos relativos ao Programa Nacional de Desestatização, revoga a Lei nº 8.031, de 12 de abril de 1990, e dá outras providências.", arquivo:"federal/leis-ordinarias/1997/lei-9491-1997-09-09.md"}}, {id:"federal:BR:L:9597/1997", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1997, data:"1997-12-26", numero:"9597", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1997-12-26;9597", vigente:true, titulo:"Lei nº 9.597 de 26/12/1997", urn:"urn:lex:br:federal:lei:1997-12-26;9597", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento Fiscal da União, em favor   do Ministério dos Transportes, crédito suplementar até o limite de R$   33.723.035,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1997/lei-9597-1997-12-26.md"}}, {id:"federal:BR:L:9440/1997", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1997, data:"1997-03-14", numero:"9440", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1997-03-14;9440", vigente:true, titulo:"Lei nº 9.440 de 14/03/1997", urn:"urn:lex:br:federal:lei:1997-03-14;9440", ementa:"Estabelece incentivos fiscais para o desenvolvimento regional e dá outras providências.", arquivo:"federal/leis-ordinarias/1997/lei-9440-1997-03-14.md"}}, {id:"federal:BR:L:9577/1997", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1997, data:"1997-12-19", numero:"9577", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1997-12-19;9577", vigente:true, titulo:"Lei nº 9.577 de 19/12/1997", urn:"urn:lex:br:federal:lei:1997-12-19;9577", ementa:"Autoriza o Poder Executivo a abrir aos Orçamentos Fiscal e da   SeguridadeSocial da União, em favor do Ministério da Justiça, Tribunal de Contas   da União, Senado Federal, Câmara dos Deputados, Ministério da Marinha,   Ministério da Aeronáutica, Presidência da República e Ministério da   Administração Federal e Reforma do Estado, crédito suplementar no valor global   de R$36.226.927,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1997/lei-9577-1997-12-19.md"}}, {id:"federal:BR:L:9534/1997", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1997, data:"1997-12-10", numero:"9534", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1997-12-10;9534", vigente:true, titulo:"Lei nº 9.534 de 10/12/1997", urn:"urn:lex:br:federal:lei:1997-12-10;9534", ementa:"Dá nova redação ao art. 30 da Lei nº 6.015, de 31 de dezembro de 1973, que   dispõe sobre os registros públicos; acrescenta inciso ao art. 1º da Lei nº   9.265, de 12 de fevereiro de 1996, que trata da gratuidade dos atos necessários   ao exercício da cidadania; e altera os arts. 30 e 45 da Lei nº 8.935, de 18 de   novembro de 1994, que dispõe sobre os serviços notariais e de registro.", arquivo:"federal/leis-ordinarias/1997/lei-9534-1997-12-10.md"}}, {id:"federal:BR:L:9466/1997", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1997, data:"1997-07-09", numero:"9466", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1997-07-09;9466", vigente:true, titulo:"Lei nº 9.466 de 09/07/1997", urn:"urn:lex:br:federal:lei:1997-07-09;9466", ementa:"Dá nova redação ao § 3º do art. 52 da Lei nº 8.931, de 22 de setembro de   1994, que dispõe sobre a amortização, juros e outros encargos decorrentes da   extinção ou dissolução de entidades da Administração Pública Federal, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1997/lei-9466-1997-07-09.md"}}, {id:"federal:BR:L:9516/1997", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1997, data:"1997-11-20", numero:"9516", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1997-11-20;9516", vigente:true, titulo:"Lei nº 9.516 de 20/11/1997", urn:"urn:lex:br:federal:lei:1997-11-20;9516", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento Fiscal da União, em favor   do Ministério da Justiça, crédito suplementar no valor de R$610.234,00, para os   fins que especifica.", arquivo:"federal/leis-ordinarias/1997/lei-9516-1997-11-20.md"}}, {id:"federal:BR:L:9569/1997", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1997, data:"1997-12-18", numero:"9569", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1997-12-18;9569", vigente:true, titulo:"Lei nº 9.569 de 18/12/1997", urn:"urn:lex:br:federal:lei:1997-12-18;9569", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento Fiscal da União, em favor   de Operações Oficiais de Crédito - Recursos sob Supervisão do Ministério da   Fazenda, crédito Suplementar no valor de R$ 320.000.000,00, para reforço de   dotação consignada no vigente Orçamento.", arquivo:"federal/leis-ordinarias/1997/lei-9569-1997-12-18.md"}}, {id:"federal:BR:L:9508/1997", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1997, data:"1997-11-18", numero:"9508", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1997-11-18;9508", vigente:true, titulo:"Lei nº 9.508 de 18/11/1997", urn:"urn:lex:br:federal:lei:1997-11-18;9508", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento Fiscal da União, em favor   do Ministério da Justiça, crédito especial até o limite de R$ 2.600.000,00, para   os fins que especifica.", arquivo:"federal/leis-ordinarias/1997/lei-9508-1997-11-18.md"}}, {id:"federal:BR:L:9471/1997", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1997, data:"1997-07-14", numero:"9471", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1997-07-14;9471", vigente:true, titulo:"Lei nº 9.471 de 14/07/1997", urn:"urn:lex:br:federal:lei:1997-07-14;9471", ementa:"Acrescenta inciso ao art. 473 da Consolidação das Leis do Trabalho - CLT.", arquivo:"federal/leis-ordinarias/1997/lei-9471-1997-07-14.md"}}, {id:"federal:BR:L:9553/1997", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1997, data:"1997-12-17", numero:"9553", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1997-12-17;9553", vigente:true, titulo:"Lei nº 9.553 de 17/12/1997", urn:"urn:lex:br:federal:lei:1997-12-17;9553", ementa:"Autoriza o Poder Executivo a abrir a