al/leis-ordinarias/2019/lei-13888-2019-10-17.md"}}, {id:"federal:BR:L:13922/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-04", numero:"13922", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-04;13922", titulo:"Lei nº 13.922 de 04/12/2019", vigente:true, urn:"urn:lex:br:federal:lei:2019-12-04;13922", ementa:"Institui o Dia Nacional do Rodeio.", arquivo:"federal/leis-ordinarias/2019/lei-13922-2019-12-04.md"}}, {id:"federal:BR:L:13866/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-08-26", numero:"13866", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-08-26;13866", vigente:true, titulo:"Lei nº 13.866 de 26/08/2019", urn:"urn:lex:br:federal:lei:2019-08-26;13866", ementa:"Altera a Lei nº 8.443, de 16 de julho de 1992, que dispõe sobre a Lei Orgânica do Tribunal de Contas da União, para tratar do sigilo das denúncias formuladas ao Tribunal de Contas da União.", arquivo:"federal/leis-ordinarias/2019/lei-13866-2019-08-26.md"}}, {id:"federal:BR:L:13810/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-03-08", numero:"13810", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-03-08;13810", vigente:true, titulo:"Lei nº 13.810 de 08/03/2019", urn:"urn:lex:br:federal:lei:2019-03-08;13810", ementa:"Dispõe sobre o cumprimento de sanções impostas por resoluções do Conselho de Segurança das Nações Unidas, incluída a indisponibilidade de ativos de pessoas naturais e jurídicas e de entidades, e a designação nacional de pessoas investigadas ou acusadas de terrorismo, de seu financiamento ou de atos a ele correlacionados; e revoga a Lei nº 13.170, de 16 de outubro de 2015.", arquivo:"federal/leis-ordinarias/2019/lei-13810-2019-03-08.md"}}, {id:"federal:BR:L:13933/2019", pro