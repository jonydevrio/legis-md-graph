55/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-02-08", numero:"1555", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-02-08;1555", vigente:true, titulo:"Lei nº 1.555 de 08/02/1952", urn:"urn:lex:br:federal:lei:1952-02-08;1555", ementa:"Denomina \"Comandante Gustavo Kramer\" o Aeroporto de Bagé, no Estado do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1952/lei-1555-1952-02-08.md"}}, {id:"federal:BR:L:1549/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-02-05", numero:"1549", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-02-05;1549", vigente:true, titulo:"Lei nº 1.549 de 05/02/1952", urn:"urn:lex:br:federal:lei:1952-02-05;1549", ementa:"Estende aos químicos, para efeito de ingresso na carreira especializada de químico agrícola, as vantagens outorgadas pela Lei nº 657, de 21 de março de 1949, que dispõe sobre os cursos de aperfeiçoamento de especialização, criados no Ministério da Agricultura.", arquivo:"federal/leis-ordinarias/1952/lei-1549-1952-02-05.md"}}, {id:"federal:BR:L:1793/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-12-30", numero:"1793", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-12-30;1793", vigente:true, titulo:"Lei nº 1.793 de 30/12/1952", urn:"urn:lex:br:federal:lei:1952-12-30;1793", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Guerra, o crédito especial de Cr$ 571.462,70, destinado ao pagamento da diferença dos vencimentos atrasados aos funcionários abrangidos pela Lei n° 1.329, de 21 de janeiro de 1951.", arquivo:"federal/leis-ordinarias/1952/lei-1793-1952-12-30.md"}}, {id:"federal:BR:L:1592/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-04-23", numero:"1592", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-04-23;1592", vigente:true, titulo:"Lei nº 1.592 de 23/04/1952", urn:"urn:lex:br:federal:lei:1952-04-23;1592", ementa:"Concede pensão especial de Cr$ 1.100,00 mensais a D. Avelina de Almeida Campos, ex-agente postal de Planaltina.", arquivo:"federal/leis-ordinarias/1952/lei-1592-1952-04-23.md"}}, {id:"federal:BR:L:1698/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-10-10", numero:"1698", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-10-10;1698", vigente:true, titulo:"Lei nº 1.698 de 10/10/1952", urn:"urn:lex:br:federal:lei:1952-10-10;1698", ementa:"Abre ao Poder Judiciário - Tribunal Federal de Recursos - o crédito suplementar de Cr$ 2.197.924,50, para atender às despesas decorrentes da Lei nº 1.441, de 24 de setembro de 1951.", arquivo:"federal/leis-ordinarias/1952/lei-1698-1952-10-10.md"}}, {id:"federal:BR:L:1562/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-02-28", numero:"1562", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-02-28;1562", vigente:true, titulo:"Lei nº 1.562 de 28/02/1952", urn:"urn:lex:br:federal:lei:1952-02-28;1562", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Saúde, o crédito especial de Cr$ 10.000.000,00, para ereção, na Capital da República, de um monumento a Rui Barbosa (Art. 33 do Ato das Disposições Constitucionais Transitórias).", arquivo:"federal/leis-ordinarias/1952/lei-1562-1952-02-28.md"}}, {id:"federal:BR:L:1657/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-07-29", numero:"1657", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-07-29;1657", vigente:true, titulo:"Lei nº 1.657 de 29/07/1952", urn:"urn:lex:br:federal:lei:1952-07-29;1657", ementa:"Modifica a Lei n° 1.365, de 7 de maio de 1951, que autoriza a abertura pelo Ministério do Trabalho, Indústria e Comércio, de crédito especial para despesas com as hospedarias de imigrantes de Rio Branco, Manaus, Belém, Fortaleza e Natal.", arquivo:"federal/leis-ordinarias/1952/lei-1657-1952-07-29.md"}}, {id:"federal:BR:L:1599/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-05-09", numero:"1599", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-05-09;1599-a", vigente:true, titulo:"Lei nº 1.599-A de 09/05/1952", urn:"urn:lex:br:federal:lei:1952-05-09;1599-a", ementa:"Considera segurados obrigatórios do Instituto de Aposentadoria e Pensões dos Empregados em Transportes e Cargas os motoristas profissionais, empregados de empresas concessionárias de serviço público.", arquivo:"federal/leis-ordinarias/1952/lei-1599-a-1952-05-09.md"}}, {id:"federal:BR:L:1692/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-10-03", numero:"1692", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-10-03;1692", vigente:true, titulo:"Lei nº 1.692 de 03/10/1952", urn:"urn:lex:br:federal:lei:1952-10-03;1692", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações Exteriores, o crédito especial de Cr$ 700.000,00 para as despesas decorrentes da participação do Brasil na exposição retrospectiva concernente à vida de Santos Dumont organizada em Paris pelo Governo da França.", arquivo:"federal/leis-ordinarias/1952/lei-1692-1952-10-03.md"}}, {id:"federal:BR:L:1556/1952", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-02-12", numero:"1556", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-02-12;1556", vigen