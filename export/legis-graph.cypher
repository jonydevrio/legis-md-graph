o de 1962, o § 3º do art. 12 do Decreto-Lei nº 236, de 28 de fevereiro de 1967, e dá outras providências.", arquivo:"federal/leis-ordinarias/2002/lei-10610-2002-12-20.md"}}, {id:"federal:BR:L:10406/2002", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2002, data:"2002-01-10", numero:"10406", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2002-01-10;10406", titulo:"Lei nº 10.406 de 10/01/2002", vigente:true, urn:"urn:lex:br:federal:lei:2002-01-10;10406", ementa:"Institui o Código Civil.", arquivo:"federal/leis-ordinarias/2002/lei-10406-2002-01-10.md"}}, {id:"federal:BR:L:10402/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2002, data:"2002-01-08", numero:"10402", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2002-01-08;10402", vigente:true, titulo:"Lei nº 10.402 de 08/01/2002", urn:"urn:lex:br:federal:lei:2002-01-08;10402", ementa:"Institui o Dia Nacional do Livro Infantil.", arquivo:"federal/leis-ordinarias/2002/lei-10402-2002-01-08.md"}}, {id:"federal:BR:L:10440/2002", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2002, data:"2002-05-02", numero:"10440", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2002-05-02;10440", vigente:true, titulo:"Lei nº 10.440 de 02/05/2002", urn:"urn:lex:br:federal:lei:2002-05-02;10440", ementa:"Inscreve o nome de Plácido de Castro no \"Livro dos Heróis da Pátria\".", arquivo:"federal/leis-ordinarias/2002/lei-10440-2002-05-02.md"}}, {id:"federal:BR:L:10449/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2002, data:"2002-05-09", numero:"10449", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2002-05-09;10449", vigente:true, titulo:"Lei nº 10.449 de 09/05/2002", urn:"urn:lex:br:federal: