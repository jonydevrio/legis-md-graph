ogada=false", ano:1950, data:"1950-11-20", numero:"1239", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-11-20;1239-a", vigente:true, titulo:"Lei nº 1.239-A de 20/11/1950", urn:"urn:lex:br:federal:lei:1950-11-20;1239-a", ementa:"Dispõe sôbre as contribuições em atraso devidas as instituições de   previdência social.", arquivo:"federal/leis-ordinarias/1950/lei-1239-a-1950-11-20.md"}}, {id:"federal:BR:L:1068/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-03-08", numero:"1068", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-03-08;1068", vigente:true, titulo:"Lei nº 1.068 de 08/03/1950", urn:"urn:lex:br:federal:lei:1950-03-08;1068", ementa:"Fixa os vencimentos dos Ministros de Estado.", arquivo:"federal/leis-ordinarias/1950/lei-1068-1950-03-08.md"}}, {id:"federal:BR:L:1168/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-08-05", numero:"1168", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-08-05;1168-a", vigente:true, titulo:"Lei nº 1.168-A de 05/08/1950", urn:"urn:lex:br:federal:lei:1950-08-05;1168-a", ementa:"Autoriza concessão de prêmio ao agrônomo Pedrito Silva, pelos relevantes   trabalhos científicos executados no combate biológico à traça do   cacau.", arquivo:"federal/leis-ordinarias/1950/lei-1168-a-1950-08-05.md"}}, {id:"federal:BR:L:1067/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-02-28", numero:"1067", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-02-28;1067", vigente:true, titulo:"Lei nº 1.067 de 28/02/1950", urn:"urn:lex:br:federal:lei:1950-02-28;1067", ementa:"Autoriza o Poder Executivo a dar, por intermédio do Tesouro Nacional, garantia a uma operação de crédito entre o Banco do Brasil e a Companhia Cantareira e Viação Fluminense.", arquivo:"federal/leis-ordinarias/1950/lei-1067-1950-02-28.md"}}, {id:"federal:BR:L:1261/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-12-05", numero:"1261", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-12-05;1261", vigente:true, titulo:"Lei nº 1.261 de 05/12/1950", urn:"urn:lex:br:federal:lei:1950-12-05;1261", ementa:"Autoriza a abertura de crédito especial, ao Congresso Nacional, para   ocorrer ao pagamento das despesas com as obras de pavimentação das ruas do   Jardim do Palácio Monroe.", arquivo:"federal/leis-ordinarias/1950/lei-1261-1950-12-05.md"}}, {id:"federal:BR:L:1064/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-02-14", numero:"1064", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-02-14;1064", vigente:true, titulo:"Lei nº 1.064 de 14/02/1950", urn:"urn:lex:br:federal:lei:1950-02-14;1064", ementa:"Concede isenção de direitos de importação para óleo combustível destinado à Anglo Mexican Petroleum Co.", arquivo:"federal/leis-ordinarias/1950/lei-1064-1950-02-14.md"}}, {id:"federal:BR:L:1199/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-09-14", numero:"1199", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-09-14;1199", vigente:true, titulo:"Lei nº 1.199 de 14/09/1950", urn:"urn:lex:br:federal:lei:1950-09-14;1199", ementa:"Concede isenção de direitos de importação para material destinado à   Venerável Ordem Terceira dos Mínimos de São Francisco de Paula.", arquivo:"federal/leis-ordinarias/1950/lei-1199-1950-09-14.md"}}, {id:"federal:BR:L:1235/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-11-14", numero:"1235", fonte:"https://normas.leg.br/?ur