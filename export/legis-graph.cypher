quivo:"federal/leis-ordinarias/1897/lei-479-1897-12-09.md"}}, {id:"federal:BR:L:433/1897", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1897, data:"1897-06-12", numero:"433", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1897-06-12;433", vigente:true, titulo:"Lei nº 433 de 12/06/1897", urn:"urn:lex:br:federal:lei:1897-06-12;433", ementa:"Fixa a Força Naval para o exercicio de 1898.", arquivo:"federal/leis-ordinarias/1897/lei-433-1897-06-12.md"}}, {id:"federal:BR:L:490/1897", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1897, data:"1897-12-16", numero:"490", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1897-12-16;490", vigente:true, titulo:"Lei nº 490 de 16/12/1897", urn:"urn:lex:br:federal:lei:1897-12-16;490", ementa:"Fixa a despeza geral da Republica dos Estados Unidos do Brazil para o   exercicio de 1898, e dá outras providencias.", arquivo:"federal/leis-ordinarias/1897/lei-490-1897-12-16.md"}}, {id:"federal:BR:L:448/1897", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1897, data:"1897-10-06", numero:"448", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1897-10-06;448", vigente:true, titulo:"Lei nº 448 de 06/10/1897", urn:"urn:lex:br:federal:lei:1897-10-06;448", ementa:"Fixa as Forças de terra, para o exercicio de   1898.", arquivo:"federal/leis-ordinarias/1897/lei-448-1897-10-06.md"}}, {id:"federal:BR:L:13283/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2016, data:"2016-05-04", numero:"13283", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2016-05-04;13283", vigente:true, titulo:"Lei nº 13.283 de 04/05/2016", urn:"urn:lex:br:federal:lei:2016-05-04;13283", ementa:"Dispõe sobre a criação de uma vara federal no Estado do Rio Grande do Sul e sobre a criação de cargos efetivos e em comissão e funções comissionadas no Quadro de Pessoal da Justiça Federal e dá outras providências.", arquivo:"federal/leis-ordinarias/2016/lei-13283-2016-05-04.md"}}, {id:"federal:BR:L:13292/2016", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2016, data:"2016-05-31", numero:"13292", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2016-05-31;13292", vigente:true, titulo:"Lei nº 13.292 de 31/05/2016", urn:"urn:lex:br:federal:lei:2016-05-31;13292", ementa:"Altera a Lei nº 6.704, de 26 de outubro de 1979, para dispor sobre o Seguro de Crédito à Exportação, as Leis nºs 9.818, de 23 de agosto de 1999, e 11.281, de 20 de fevereiro de 2006, para dispor sobre o Fundo de Garantia à Exportação, a Lei nº 12.712, de 30 de agosto de 2012, para dispor sobre a utilização de imóveis da União para integralização de fundo garantidor e sobre a Agência Brasileira Gestora de Fundos Garantidores e Garantias S.A. (ABGF), o Decreto-Lei nº 857, de 11 de setembro de 1969", arquivo:"federal/leis-ordinarias/2016/lei-13292-2016-05-31.md"}}, {id:"federal:BR:L:13377/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2016, data:"2016-12-20", numero:"13377", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2016-12-20;13377", vigente:true, titulo:"Lei nº 13.377 de 20/12/2016", urn:"urn:lex:br:federal:lei:2016-12-20;13377", ementa:"Abre ao Orçamento Fiscal da União, em favor de Transferências a Estados, Distrito Federal e Municípios, crédito suplementar no valor de R$ 893.792.451,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2016/lei-13377-2016-12-20.md"}}, {id:"federal:BR:L:13273/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2016, data:"2016-04-15", numero:"13273", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2016-04-15;13273", vigente:true, titulo:"Lei nº 13.273 de 15/04/2016", urn:"urn:lex:br:federal:lei:2016-04-15;13273", ementa:"Altera os limites do Parque Nacional de São Joaquim, no Estado de Santa Catarina.", arquivo:"federal/leis-ordinarias/2016/lei-13273-2016-04-15.md"}}, {id:"federal:BR:L:13286/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2016, data:"2016-05-10", numero:"13286", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2016-05-10;13286", vigente:true, titulo:"Lei nº 13.286 de 10/05/2016", urn:"urn:lex:br:federal:lei:2016-05-10;13286", ementa:"Dispõe sobre a responsabilidade civil de notários e registradores, alterando o art. 22 da Lei nº 8.935, de 18 de novembro de 1994.", arquivo:"federal/leis-ordinarias/2016/lei-13286-2016-05-10.md"}}, {id:"federal:BR:L:13386/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2016, data:"2016-12-20", numero:"13386", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2016-12-20;13386", vigente:true, titulo:"Lei nº 13.386 de 20/12/2016", urn:"urn:lex:br:federal:lei:2016-12-20;13386", ementa:"Abre ao Orçamento de Investimento para 2016, em favor de empresas estatais, crédito especial no valor de R$ 845.573.216,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2016/lei-13386-2016-12-20.md"}}, {id:"federal:BR:L:13407/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2016, data:"2016-12-26", numero:"13407", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2016-12-26;13407", vigente:true, titulo:"Lei nº 13.407 de 26/12/2016", urn:"urn:lex:br:federal:lei:2016-12-26;13407", ementa:"Institui o Dia Nacional do Psicólogo.", arquivo:"federal/leis-ordinarias/2016/lei-13407-2016-12-26.md"}}, {id:"federal:BR:L:13413/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2016, data:"2016-12-29", numero:"13413", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2016-12-29;13413", vigente:true, titulo:"Lei nº 13.413 de 29/12/2016", urn:"urn:lex:br:federal:lei:2016-12-29;13413", ementa:"Altera a Lei nº 5.700, de 1º de setembro de 1971, que \"dispõe sobre a forma e a apresentação dos Símbolos Nacionais, e dá outras providências\", para determinar que o Hino Nacional seja executado na abertura das competições esportivas nacionais que especifica.", arquivo:"federal/leis-ordinarias/2016/lei-13413-2016-12-29.md"}}, {id:"federal:BR:L:13321/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2016, data:"2016-07-27", numero:"13321", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2016-07-27;13321", vigente:true, titulo:"Lei nº 13.321 de 27/07/2016", urn:"urn:lex:br:federal:lei:2016-07-27;13321", ementa:"Altera o soldo e o escalonamento vertical dos militares das Forças Armadas, constantes da Lei nº 11.784, de 22 de setembro de 2008.", arquivo:"federal/leis-ordinarias/2016/lei-13321-2016-07-27.md"}}, {id:"federal:BR:L:13355/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2016, data:"2016-11-07", numero:"13355", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2016-11-07;13355", vigente:true, titulo:"Lei nº 13.355 de 07/11/2016", urn:"urn:lex:br:federal:lei:2016-11-07;13355", ementa:"Abre ao Orçamento Fiscal da União, em favor de diversos órgãos do Poder Judiciário, crédito suplementar no valor de R$ 187.864.849,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2016/lei-13355-2016-11-07.md"}}, {id:"federal:BR:L:13300/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_