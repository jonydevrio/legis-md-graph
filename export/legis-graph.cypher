a:"1902-12-29", numero:"947", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1902-12-29;947", vigente:true, titulo:"Lei nº 947 de 29/12/1902", urn:"urn:lex:br:federal:lei:1902-12-29;947", ementa:"Reforma o serviço policial no Districto Federal", arquivo:"federal/leis-ordinarias/1902/lei-947-1902-12-29.md"}}, {id:"federal:BR:L:900/1902", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1902, data:"1902-11-07", numero:"900", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1902-11-07;900", vigente:true, titulo:"Lei nº 900 de 07/11/1902", urn:"urn:lex:br:federal:lei:1902-11-07;900", ementa:"Fixa as forças de terra para o exercicio de 1903", arquivo:"federal/leis-ordinarias/1902/lei-900-1902-11-07.md"}}, {id:"federal:BR:L:4230/1920", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1920, data:"1920-12-31", numero:"4230", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1920-12-31;4230", vigente:true, titulo:"Lei nº 4.230 de 31/12/1920", urn:"urn:lex:br:federal:lei:1920-12-31;4230", ementa:"Orça a Receita Geral da Republica dos Estados Unidos do Brasil, para o exercicio de 1921", arquivo:"federal/leis-ordinarias/1920/lei-4230-1920-12-31.md"}}, {id:"federal:BR:L:4028/1920", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1920, data:"1920-01-10", numero:"4028", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1920-01-10;4028", vigente:true, titulo:"Lei nº 4.028 de 10/01/1920", urn:"urn:lex:br:federal:lei:1920-01-10;4028", ementa:"Fixa as forças de terra para o exercicio de 1920.", arquivo:"federal/leis-ordinarias/1920/lei-4028-1920-01-10.md"}}, {id:"federal:BR:L:13865/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-08-08", numero:"13865", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-08-08;13865", vigente:true, titulo:"Lei nº 13.865 de 08/08/2019", urn:"urn:lex:br:federal:lei:2019-08-08;13865", ementa:"Altera a Lei nº 6.015, de 31 de dezembro de 1973 (Lei de Registros Públicos), para dispensar o habite-se na averbação de construção residencial urbana unifamiliar de um só pavimento finalizada há mais de 5 (cinco) anos em área ocupada predominantemente por população de baixa renda.", arquivo:"federal/leis-ordinarias/2019/lei-13865-2019-08-08.md"}}, {id:"federal:BR:L:13959/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-18", numero:"13959", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-18;13959", vigente:true, titulo:"Lei nº 13.959 de 18/12/2019", urn:"urn:lex:br:federal:lei:2019-12-18;13959", ementa:"Institui o Exame Nacional de Revalidação de Diplomas Médicos Expedidos por Instituição de Educação Superior Estrangeira (Revalida).", arquivo:"federal/leis-ordinarias/2019/lei-13959-2019-12-18.md"}}, {id:"federal:BR:L:13921/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-04", numero:"13921", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-04;13921", vigente:true, titulo:"Lei nº 13.921 de 04/12/2019", urn:"urn:lex:br:federal:lei:2019-12-04;13921", ementa:"Institui a região de Angra Doce, nos termos que especifica, como Área Especial de Interesse Turístico.", arquivo:"federal/leis-ordinarias/2019/lei-13921-2019-12-04.md"}}, {id:"federal:BR:L:13932/2019", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-11", numero:"13932", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-11;13932", vigente:true, titulo:"Lei nº 13.932 de 11/12/2019", urn:"urn:lex:br:federal:lei:2019-12-11;13932", ementa:"Altera a Lei Complementar nº 26, de 11 de setembro de 1975, e as Leis nos 8.036, de 11 de maio de 1990, 8.019, de 11 de abril de 1990, e 10.150, de 21 de dezembro de 2000, para instituir a modalidade de saque-aniversário no Fundo de Garantia do Tempo de Serviço (FGTS) e assegurar o equilíbrio econômico-financeiro do Fundo, dispor sobre a movimentação das contas do Programa de Integração Social (PIS) e do Programa de Formação do Patrimônio do Servidor Público (Pasep) e sobre a devolução de recurs", arquivo:"federal/leis-ordinarias/2019/lei-13932-2019-12-11.md"}}, {id:"federal:BR:L:13873/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-09-17", numero:"13873", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-09-17;13873", vigente:true, titulo:"Lei nº 13.873 de 17/09/2019", urn:"urn:lex:br:federal:lei:2019-09-17;13873", ementa:"Altera a Lei nº 13.364, de 29 de novembro de 2016, para incluir o laço, bem como as respectivas expressões artísticas e esportivas, como manifestação cultural nacional, elevar essas atividades à condição de bem de natureza imaterial integrante do patrimônio cultural brasileiro e dispor sobre as modalidades esportivas equestres tradicionais e sobre a proteção ao bem-estar animal.", arquivo:"federal/leis-ordinarias/2019/lei-13873-2019-09-17.md"}}, {id:"federal:BR:L:13821/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-05-03", numero:"13821", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-05-03;13821", vigente:true, titulo:"Lei nº 13.821 de 03/05/2019", urn:"urn:lex:br:federal:lei:2019-05-03;13821", ementa:"Acrescenta parágrafo único ao art. 14 da Lei nº 11.107, de 6 de abril de 2005, para limitar as exigências legais de regularidade, por ocasião da celebração de convênios com a União, ao próprio consórcio público envolvido, sem estendê-las aos entes federativos nele consorciados.", arquivo:"federal/leis-ordinarias/2019/lei-13821-2019-05-03.md"}}, {id:"federal:BR:L:13801/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-01-09", numero:"13801", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-01-09;13801", vigente:true, titulo:"Lei nº 13.801 de 09/01/2019", urn:"urn:lex:br:federal:lei:2019-01-09;13801", ementa:"Altera a Lei nº 8.958, de 20 de dezembro de 1994, que dispõe sobre as relações entre as instituições federais de ensino superior e de pesquisa científica e tecnológica e as fundações de apoio.", arquivo:"federal/leis-ordinarias/2019/lei-13801-2019-01-09.md"}}, {id:"federal:BR:L:13859/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-07-15", numero:"13859", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-07-15;13859", vigente:true, titulo:"Lei nº 13.859 de 15/07/2019", urn:"urn:lex:br:federal:lei:2019-07-15;13859", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério da Justiça e Segurança Pública, crédito especial no valor de R$ 36.050.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/2019/lei-13859-2019-07-15.md"}}, {id:"federal:BR:L:13889/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-10-18", numero:"13889", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-10-18;13889", vigente:true, titulo:"Lei nº 13.889 de 18/10/2019", urn:"urn:lex:br:federal:lei:2019-10-18;13889", ementa:"Denomina Viaduto Arivaldo Angelo Pancera o viaduto transversal localizado à BR-282, no Município de Catanduvas, que liga os bairros Centro-Oeste e Sayonara ao centro da cidade de Catanduvas, Estado de Santa Catarina.", arquivo:"federal/leis-ordinarias/2019/lei-13889-2019-10-18.md"}}, {id:"federal:BR:L:13847/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-06-19", numero:"13847", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-06-19;13847", vigente:true, titulo:"Lei nº 13.847 de 19/06/2019", urn:"urn:lex:br:federal:lei:2019-06-19;13847", ementa:"Altera a Lei nº 8.213, de 24 de julho de 1991, para dispensar de reavaliação pericial a pessoa com HIV/aids aposentada por invalidez.", arquivo:"federal/leis-ordinarias/2019/lei-13847-2019-06-19.md"}}, {id:"federal:BR:L:13905/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-11-21", numero:"13905", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-11-21;13905", vigente:true, titulo:"Lei nº 13.905 de 21/11/2019", urn:"urn:lex:br:federal:lei:2019-11-21;13905", ementa:"Altera a Lei nº 10.753, de 30 de outubro de 2003 (Lei do Livro), para incluir, no rol de ações de difusão do livro incumbidas ao Poder Executivo, a instituição de concursos regionais visando a descobrir e a incentivar novos autores.", arquivo:"federal/leis-ordinarias/2019/lei-13905-2019-11-21.md"}}, {id:"federal:BR:L:13969/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-26", numero:"13969", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-26;13969", vigente:true, titulo:"Lei nº 13.969 de 26/12/2019", urn:"urn:lex:br:federal:lei:2019-12-26;13969", ementa:"Dispõe sobre a política industrial para o setor de tecnologias da informação e comunicação e para o setor de semicondutores e altera a Lei nº 11.484, de 31 de maio de 2007, a Lei nº 8.248, de 23 de outubro de 1991, a Lei nº 10.637, de 30 de dezembro de 2002, e a Lei nº 8.387, de 30 de dezembro de 1991.", arquivo:"federal/leis-ordinarias/2019/lei-13969-2019-12-26.md"}}, {id:"federal:BR:L:13878/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-10-03", numero:"13878", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-10-03;13878", vigente:true, titulo:"Lei nº 13.878 de 03/10/2019", urn:"urn:lex:br:federal:lei:2019-10-03;13878", ementa:"Altera a Lei nº 9.504, de 30 de setembro de 1997, a fim de estabelecer os limites de gastos de campanha para as eleições municipais.", arquivo:"federal/leis-ordinarias/2019/lei-13878-2019-10-03.md"}}, {id:"federal:BR:L:13828/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-05-13", numero:"13828", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-05-13;13828", vigente:true, titulo:"Lei nº 13.828 de 13/05/2019", urn:"urn:lex:br:federal:lei:2019-05-13;13828", ementa:"Altera a Lei nº 12.485, de 12 de setembro de 2011, lei da comunicação audiovisual de acesso condicionado, para incluir como direito dos assinantes a possibilidade de cancelamento dos serviços de TV por assinatura pessoalmente ou pela internet.", arquivo:"federal/leis-ordinarias/2019/lei-13828-2019-05-13.md"}}, {id:"federal:BR:L:13823/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-05-09", numero:"13823", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-05-09;13823", vigente:true, titulo:"Lei nº 13.823 de 09/05/2019", urn:"urn:lex:br:federal:lei:2019-05-09;13823", ementa:"Altera o § 3º do art. 1º da Lei nº 8.001, de 13 de março de 1990, que define os percentuais da distribuição da compensação financeira de que trata a Lei nº 7.990, de 28 de dezembro de 1989, e dá outras providências.", arquivo:"federal/leis-ordinarias/2019/lei-13823-2019-05-09.md"}}, {id:"federal:BR:L:13836/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-06-04", numero:"13836", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-06-04;13836", vigente:true, titulo:"Lei nº 13.836 de 04/06/2019", urn:"urn:lex:br:federal:lei:2019-06-04;13836", ementa:"Acrescenta dispositivo ao art. 12 da Lei nº 11.340, de 7 de agosto de 2006, para tornar obrigatória a informação sobre a condição de pessoa com deficiência da mulher vítima de agressão doméstica ou familiar.", arquivo:"federal/leis-ordinarias/2019/lei-13836-2019-06-04.md"}}, {id:"federal:BR:L:13938/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-13", numero:"13938", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-13;13938", vigente:true, titulo:"Lei nº 13.938 de 13/12/2019", urn:"urn:lex:br:federal:lei:2019-12-13;13938", ementa:"Abre ao Orçamento de Investimento para 2019 crédito suplementar no valor de R$ 490.805.637,00, em favor das empresas Companhia Docas do Espírito Santo - Codesa, Companhia Docas do Estado de São Paulo - Codesp e Empresa Brasileira de Infraestrutura Aeroportuária - Infraero, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2019/lei-13938-2019-12-13.md"}}, {id:"federal:BR:L:13818/2019", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-04-24", numero:"13818", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-04-24;13818", vigente:true, titulo:"Lei nº 13.818 de 24/04/2019", urn:"urn:lex:br:federal:lei:2019-04-24;13818", ementa:"Altera a Lei nº 6.404, de 15 de dezembro de 1976 (Lei das Sociedades Anônimas), para dispor sobre as publicações obrigatórias e ampliar para R$ 10.000.000,00 (dez milhões de reais) o valor máximo admitido de patrimônio líquido para que a sociedade anônima de capital fechado faça jus ao regime simplificado de publicidade de atos societários.", arquivo:"federal/leis-ordinarias/2019/lei-13818-2019-04-24.md"}}, {id:"federal:BR:L:13882/2019", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-10-08", numero:"13882", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-10-08;13882", vigente:true, titulo:"Lei nº 13.882 de 08/10/2019", urn:"urn:lex:br:federal:lei:2019-10-08;13882", ementa:"Altera a Lei nº 11.340, de 7 de agosto de 2006 (Lei Maria da Penha), para garantir a matrícula dos dependentes da mulher vítima de violência doméstica e familiar em instituição de educação básica mais próxima de seu domicílio.", arquivo:"federal/leis-ordinarias/2019/lei-13882-2019-10-08.md"}}, {id:"federal:BR:L:13890/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-10-18", numero:"13890", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-10-18;13890", vigente:true, titulo:"Lei nº 13.890 de 18/10/2019", urn:"urn:lex:br:federal:lei:2019-10-18;13890", ementa:"Denomina Elevado Carlos Joffre do Amaral o elevado da Rodovia BR-282, com acesso pela Avenida Luiz de Camões, no Município de Lages, Estado de Santa Catarina.", arquivo:"federal/leis-ordinarias/2019/lei-13890-2019-10-18.md"}}, {id:"federal:BR:L:13915/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-11-28", numero:"13915", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-11-28;13915", vigente:true, titulo:"Lei nº 13.915 de 28/11/2019", urn:"urn:lex:br:federal:lei:2019-11-28;13915", ementa:"Altera a Lei nº 13.328, de 29 de julho de 2016, para dispor sobre as requisições de pessoal para a Defensoria Pública da União.", arquivo:"federal/leis-ordinarias/2019/lei-13915-2019-11-28.md"}}, {id:"federal:BR:L:13896/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-10-30", numero:"13896", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-10-30;13896", vigente:true, titulo:"Lei nº 13.896 de 30/10/2019", urn:"urn:lex:br:federal:lei:2019-10-30;13896", ementa:"Altera a Lei nº 12.732, de 22 de novembro de 2012, para que os exames relacionados ao diagnóstico de neoplasia maligna sejam realizados no prazo de 30 (trinta) dias, no caso em que especifica.", arquivo:"federal/leis-ordinarias/2019/lei-13896-2019-10-30.md"}}, {id:"federal:BR:L:13953/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-16", numero:"13953", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-16;13953", vigente:true, titulo:"Lei nº 13.953 de 16/12/2019", urn:"urn:lex:br:federal:lei:2019-12-16;13953", ementa:"Abre ao Orçamento Fiscal da União, em favor dos Ministérios da Economia, da Defesa e da Saúde, crédito suplementar no valor de R$ 490.491.903,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2019/lei-13953-2019-12-16.md"}}, {id:"federal:BR:L:13947/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-13", numero:"13947", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-13;13947", vigente:true, titulo:"Lei nº 13.947 de 13/12/2019", urn:"urn:lex:br:federal:lei:2019-12-13;13947", ementa:"Abre ao Orçamento Fiscal da União em favor dos Ministérios da Agricultura, Pecuária e Abastecimento, do Meio Ambiente e da Defesa, crédito especial no valor de R$ 1.024.000.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2019/lei-13947-2019-12-13.md"}}, {id:"federal:BR:L:13797/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-01-03", numero:"13797", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-01-03;13797", vigente:true, titulo:"Lei nº 13.797 de 03/01/2019", urn:"urn:lex:br:federal:lei:2019-01-03;13797", ementa:"Altera a Lei nº 12.213, de 20 de janeiro de 2010, para autorizar a pessoa física a realizar doações aos fundos controlados pelos Conselhos Municipais, Estaduais e Nacional do Idoso diretamente em sua declaração de Ajuste Anual do Imposto sobre a Renda da Pessoa Física.", arquivo:"federal/leis-ordinarias/2019/lei-13797-2019-01-03.md"}}, {id:"federal:BR:L:13832/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-06-04", numero:"13832", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-06-04;13832", vigente:true, titulo:"Lei nº 13.832 de 04/06/2019", urn:"urn:lex:br:federal:lei:2019-06-04;13832", ementa:"Altera a Lei nº 8.036, de 11 de maio de 1990, que dispõe sobre o Fundo de Garantia do Tempo de Serviço (FGTS), para viabilizar a aplicação de recursos do Fundo em operações de crédito destinadas às entidades hospitalares filantrópicas, bem como a instituições que atuam no campo para pessoas com deficiência, sem fins lucrativos, que participem de forma complementar do Sistema Único de Saúde (SUS).", arquivo:"federal/leis-ordinarias/2019/lei-13832-2019-06-04.md"}}, {id:"federal:BR:L:13808/2019", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-01-15", numero:"13808", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-01-15;13808", vigente:true, titulo:"Lei nº 13.808 de 15/01/2019", urn:"urn:lex:br:federal:lei:2019-01-15;13808", ementa:"Estima a receita e fixa a despesa da União para o exercício financeiro de 2019.", arquivo:"federal/leis-ordinarias/2019/lei-13808-2019-01-15.md"}}, {id:"federal:BR:L:13928/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-10", numero:"13928", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-10;13928", vigente:true, titulo:"Lei nº 13.928 de 10/12/2019", urn:"urn:lex:br:federal:lei:2019-12-10;13928", ementa:"Institui o Dia Nacional da Economia Solidária.", arquivo:"federal/leis-ordinarias/2019/lei-13928-2019-12-10.md"}}, {id:"federal:BR:L:13914/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-11-25", numero:"13914", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-11-25;13914", vigente:true, titulo:"Lei nº 13.914 de 25/11/2019", urn:"urn:lex:br:federal:lei:2019-11-25;13914", ementa:"Abre ao Orçamento Fiscal da União, em favor das Justiças Federal e Eleitoral, crédito especial no valor de R$ 3.665.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2019/lei-13914-2019-11-25.md"}}, {id:"federal:BR:L:13920/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-11-28", numero:"13920", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-11-28;13920", vigente:true, titulo:"Lei nº 13.920 de 28/11/2019", urn:"urn:lex:br:federal:lei:2019-11-28;13920", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor dos Ministérios da Ciência, Tecnologia, Inovações e Comunicações, da Educação, da Cidadania e da Mulher, da Família e dos Direitos Humanos, crédito suplementar no valor de R$ 1.369.984.032,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2019/lei-13920-2019-11-28.md"}}, {id:"federal:BR:L:13925/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-04", numero:"13925", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-04;13925", vigente:true, titulo:"Lei nº 13.925 de 04/12/2019", urn:"urn:lex:br:federal:lei:2019-12-04;13925", ementa:"Institui o dia 20 de outubro como o Dia Nacional da Filantropia.", arquivo:"federal/leis-ordinarias/2019/lei-13925-2019-12-04.md"}}, {id:"federal:BR:L:13963/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-20", numero:"13963", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-20;13963", vigente:true, titulo:"Lei nº 13.963 de 20/12/2019", urn:"urn:lex:br:federal:lei:2019-12-20;13963", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor de diversos órgãos do Poder Executivo, crédito suplementar no valor de R$ 2.124.281.608,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2019/lei-13963-2019-12-20.md"}}, {id:"federal:BR:L:13840/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-06-05", numero:"13840", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-06-05;13840", vigente:true, titulo:"Lei nº 13.840 de 05/06/2019", urn:"urn:lex:br:federal:lei:2019-06-05;13840", ementa:"Altera as Leis nºs 11.343, de 23 de agosto de 2006, 7.560, de 19 de dezembro de 1986, 9.250, de 26 de dezembro de 1995, 9.532, de 10 de dezembro de 1997, 8.981, de 20 de janeiro de 1995, 8.315, de 23 de dezembro de 1991, 8.706, de 14 de setembro de 1993, 8.069, de 13 de julho de 1990, 9.394, de 20 de dezembro de 1996, e 9.503, de 23 de setembro de 1997, os Decretos-Lei nos 4.048, de 22 de janeiro de 1942, 8.621, de 10 de janeiro de 1946, e 5.452, e 1º de maio de 1943, para dispor sobre o Sistema", arquivo:"federal/leis-ordinarias/2019/lei-13840-2019-06-05.md"}}, {id:"federal:BR:L:13909/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-11-21", numero:"13909", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-11-21;13909", vigente:true, titulo:"Lei nº 13.909 de 21/11/2019", urn:"urn:lex:br:federal:lei:2019-11-21;13909", ementa:"Abre ao Orçamento Fiscal da União, em favor da Controladoria-Geral da União e dos Ministérios da Infraestrutura e do Desenvolvimento Regional, crédito especial no valor de R$ 12.574.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2019/lei-13909-2019-11-21.md"}}, {id:"federal:BR:L:13943/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-13", numero:"13943", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-13;13943", vigente:true, titulo:"Lei nº 13.943 de 13/12/2019", urn:"urn:lex:br:federal:lei:2019-12-13;13943", ementa:"Abre ao Orçamento de Investimento para 2019, em favor de empresas estatais, crédito suplementar no valor de R$ 691.020.920,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2019/lei-13943-2019-12-13.md"}}, {id:"federal:BR:L:13793/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-01-03", numero:"13793", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-01-03;13793", vigente:true, titulo:"Lei nº 13.793 de 03/01/2019", urn:"urn:lex:br:federal:lei:2019-01-03;13793", ementa:"Altera as Leis nos 8.906, de 4 de julho de 1994, 11.419, de 19 de dezembro de 2006, e 13.105, de 16 de março de 2015 (Código de Processo Civil), para assegurar a advogados o exame e a obtenção de cópias de atos e documentos de processos e de procedimentos eletrônicos.", arquivo:"federal/leis-ordinarias/2019/lei-13793-2019-01-03.md"}}, {id:"federal:BR:L:13965/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-26", numero:"13965", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-26;13965", vigente:true, titulo:"Lei nº 13.965 de 26/12/2019", urn:"urn:lex:br:federal:lei:2019-12-26;13965", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor de diversos órgãos do Poder Executivo, de Encargos Financeiros da União e de Operações Oficiais de Crédito, crédito suplementar no valor de R$ 2.077.898.774,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2019/lei-13965-2019-12-26.md"}}, {id:"federal:BR:L:13875/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-09-20", numero:"13875", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-09-20;13875", vigente:true, titulo:"Lei nº 13.875 de 20/09/2019", urn:"urn:lex:br:federal:lei:2019-09-20;13875", ementa:"Altera o § 2º do art. 63 da Lei nº 8.906, de 4 de julho de 1994, que dispõe sobre o Estatuto da Advocacia e a Ordem dos Advogados do Brasil (OAB), para tratar dos prazos de exercício da profissão para participação nas eleições dos membros dos órgãos da OAB.", arquivo:"federal/leis-ordinarias/2019/lei-13875-2019-09-20.md"}}, {id:"federal:BR:L:13956/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-17", numero:"13956", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-17;13956", vigente:true, titulo:"Lei nº 13.956 de 17/12/2019", urn:"urn:lex:br:federal:lei:2019-12-17;13956", ementa:"Abre ao Orçamento Fiscal da União, em favor dos Ministérios da Infraestrutura e do Desenvolvimento Regional, e de Transferências a Estados, Distrito Federal e Municípios, crédito especial no valor de R$ 5.846.700.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2019/lei-13956-2019-12-17.md"}}, {id:"federal:BR:L:13973/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-27", numero:"13973", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-27;13973", vigente:true, titulo:"Lei nº 13.973 de 27/12/2019", urn:"urn:lex:br:federal:lei:2019-12-27;13973", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor dos Ministérios da Agricultura, Pecuária e Abastecimento, da Ciência, Tecnologia, Inovações e Comunicações, da Educação, da Saúde, da Infraestrutura, do Desenvolvimento Regional, da Cidadania e da Mulher, da Família e dos Direitos Humanos, crédito suplementar no valor de R$ 146.525.834,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2019/lei-13973-2019-12-27.md"}}, {id:"federal:BR:L:13805/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-01-10", numero:"13805", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-01-10;13805", vigente:true, titulo:"Lei nº 13.805 de 10/01/2019", urn:"urn:lex:br:federal:lei:2019-01-10;13805", ementa:"Altera as Leis nºs 9.012, de 30 de março de 1995, e 8.036, de 11 de maio de 1990, a fim de exigir certidão que comprove inexistência de débito com o Fundo de Garantia do Tempo de Serviço (FGTS) para concessão, com lastro em recursos públicos, de crédito e de benefícios a pessoas jurídicas.", arquivo:"federal/leis-ordinarias/2019/lei-13805-2019-01-10.md"}}, {id:"federal:BR:L:13853/2019", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-07-08", numero:"13853", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-07-08;13853", vigente:true, titulo:"Lei nº 13.853 de 08/07/2019", urn:"urn:lex:br:federal:lei:2019-07-08;13853", ementa:"Altera a Lei nº 13.709, de 14 de agosto de 2018, para dispor sobre a proteção de dados pessoais e para criar a Autoridade Nacional de Proteção de Dados; e dá outras providências.", arquivo:"federal/leis-ordinarias/2019/lei-13853-2019-07-08.md"}}, {id:"federal:BR:L:13919/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-11-28", numero:"13919", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-11-28;13919", vigente:true, titulo:"Lei nº 13.919 de 28/11/2019", urn:"urn:lex:br:federal:lei:2019-11-28;13919", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério do Desenvolvimento Regional, crédito especial no valor de R$ 56.542.840,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2019/lei-13919-2019-11-28.md"}}, {id:"federal:BR:L:13861/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-07-18", numero:"13861", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-07-18;13861", vigente:true, titulo:"Lei nº 13.861 de 18/07/2019", urn:"urn:lex:br:federal:lei:2019-07-18;13861", ementa:"Altera a Lei nº 7.853, de 24 de outubro de 1989, para incluir as especificidades inerentes ao transtorno do espectro autista nos censos demográficos.", arquivo:"federal/leis-ordinarias/2019/lei-13861-2019-07-18.md"}}, {id:"federal:BR:L:13910/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-11-21", numero:"13910", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-11-21;13910", vigente:true, titulo:"Lei nº 13.910 de 21/11/2019", urn:"urn:lex:br:federal:lei:2019-11-21;13910", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor dos Ministérios da Justiça e Segurança Pública, da Saúde e do Desenvolvimento Regional, crédito suplementar no valor de R$ 177.171.361,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2019/lei-13910-2019-11-21.md"}}, {id:"federal:BR:L:13886/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-10-17", numero:"13886", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-10-17;13886", vigente:true, titulo:"Lei nº 13.886 de 17/10/2019", urn:"urn:lex:br:federal:lei:2019-10-17;13886", ementa:"Altera as Leis nos 7.560, de 19 de dezembro de 1986, 10.826, de 22 de dezembro de 2003, 11.343, de 23 de agosto de 2006, 9.503, de 23 de setembro de 1997 (Código de Trânsito Brasileiro), 8.745, de 9 de dezembro de 1993, e 13.756, de 12 de dezembro de 2018, para acelerar a destinação de bens apreendidos ou sequestrados que tenham vinculação com o tráfico ilícito de drogas.", arquivo:"federal/leis-ordinarias/2019/lei-13886-2019-10-17.md"}}, {id:"federal:BR:L:13844/2019", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-06-18", numero:"13844", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-06-18;13844", vigente:true, titulo:"Lei nº 13.844 de 18/06/2019", urn:"urn:lex:br:federal:lei:2019-06-18;13844", ementa:"Estabelece a organização básica dos órgãos da Presidência da República e dos Ministérios; altera as Leis nos 13.334, de 13 de setembro de 2016, 9.069, de 29 de junho de 1995, 11.457, de 16 de março de 2007, 9.984, de 17 de julho de 2000, 9.433, de 8 de janeiro de 1997, 8.001, de 13 de março de 1990, 11.952, de 25 de junho de 2009, 10.559, de 13 de novembro de 2002, 11.440, de 29 de dezembro de 2006, 9.613, de 3 de março de 1998, 11.473, de 10 de maio de 2007, e 13.346, de 10 de outubro de 2016; ", arquivo:"federal/leis-ordinarias/2019/lei-13844-2019-06-18.md"}}, {id:"federal:BR:L:13950/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-13", numero:"13950", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-13;13950", vigente:true, titulo:"Lei nº 13.950 de 13/12/2019", urn:"urn:lex:br:federal:lei:2019-12-13;13950", ementa:"Abre ao Orçamento Fiscal da União, em favor do Conselho Nacional de Justiça, crédito especial no valor de R$ 7.700.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/2019/lei-13950-2019-12-13.md"}}, {id:"federal:BR:L:13812/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-03-16", numero:"13812", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-03-16;13812", vigente:true, titulo:"Lei nº 13.812 de 16/03/2019", urn:"urn:lex:br:federal:lei:2019-03-16;13812", ementa:"Institui a Política Nacional de Busca de Pessoas Desaparecidas, cria o Cadastro Nacional de Pessoas Desaparecidas e altera a Lei nº 8.069, de 13 de julho de 1990 (Estatuto da Criança e do Adolescente).", arquivo:"federal/leis-ordinarias/2019/lei-13812-2019-03-16.md"}}, {id:"federal:BR:L:13934/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-11", numero:"13934", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-11;13934", vigente:true, titulo:"Lei nº 13.934 de 11/12/2019", urn:"urn:lex:br:federal:lei:2019-12-11;13934", ementa:"Regulamenta o contrato referido no § 8º do art. 37 da Constituição Federal, denominado \"contrato de desempenho\", no âmbito da administração pública federal direta de qualquer dos Poderes da União e das autarquias e fundações públicas federais.", arquivo:"federal/leis-ordinarias/2019/lei-13934-2019-12-11.md"}}, {id:"federal:BR:L:13912/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-11-25", numero:"13912", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-11-25;13912", vigente:true, titulo:"Lei nº 13.912 de 25/11/2019", urn:"urn:lex:br:federal:lei:2019-11-25;13912", ementa:"Altera a Lei nº 10.671, de 15 de maio de 2003 (Estatuto de Defesa do Torcedor), para ampliar o prazo de impedimento de que trata o art. 39-A, estender sua incidência a atos praticados em datas e locais distintos dos eventos esportivos e instituir novas hipóteses de responsabilidade civil objetiva de torcidas organizadas.", arquivo:"federal/leis-ordinarias/2019/lei-13912-2019-11-25.md"}}, {id:"federal:BR:L:13867/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-08-26", numero:"13867", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-08-26;13867", vigente:true, titulo:"Lei nº 13.867 de 26/08/2019", urn:"urn:lex:br:federal:lei:2019-08-26;13867", ementa:"Altera o Decreto-Lei nº 3.365, de 21 de junho de 1941, para possibilitar a opção pela mediação ou pela via arbitral para a definição dos valores de indenização nas desapropriações por utilidade pública, nas condições que especifica.", arquivo:"federal/leis-ordinarias/2019/lei-13867-2019-08-26.md"}}, {id:"federal:BR:L:13923/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-04", numero:"13923", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-04;13923", vigente:true, titulo:"Lei nº 13.923 de 04/12/2019", urn:"urn:lex:br:federal:lei:2019-12-04;13923", ementa:"Outorga o título de Patrono do Quadro de Oficiais Especialistas em Controle de Tráfego Aéreo da Aeronáutica ao Tenente-Coronel Especialista em Controle de Tráfego Aéreo Aldo Augusto Voigt.", arquivo:"federal/leis-ordinarias/2019/lei-13923-2019-12-04.md"}}, {id:"federal:BR:L:13907/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-11-21", numero:"13907", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-11-21;13907", vigente:true, titulo:"Lei nº 13.907 de 21/11/2019", urn:"urn:lex:br:federal:lei:2019-11-21;13907", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério de Minas e Energia e de Encargos Financeiros da União, crédito especial no valor de R$ 1.849.010.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2019/lei-13907-2019-11-21.md"}}, {id:"federal:BR:L:13941/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-13", numero:"13941", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-13;13941", vigente:true, titulo:"Lei nº 13.941 de 13/12/2019", urn:"urn:lex:br:federal:lei:2019-12-13;13941", ementa:"Abre ao Orçamento Fiscal da União, em favor das Justiças Federal e do Trabalho, crédito especial no valor de R$ 36.669.543,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2019/lei-13941-2019-12-13.md"}}, {id:"federal:BR:L:13869/2019", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-09-05", numero:"13869", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-09-05;13869", vigente:true, titulo:"Lei nº 13.869 de 05/09/2019", urn:"urn:lex:br:federal:lei:2019-09-05;13869", ementa:"Dispõe sobre os crimes de abuso de autoridade; altera a Lei nº 7.960, de 21 de dezembro de 1989, a Lei nº 9.296, de 24 de julho de 1996, a Lei nº 8.069, de 13 de julho de 1990, e a Lei nº 8.906, de 4 de julho de 1994; e revoga a Lei nº 4.898, de 9 de dezembro de 1965, e dispositivos do Decreto-Lei nº 2.848, de 7 de dezembro de 1940 (Código Penal).", arquivo:"federal/leis-ordinarias/2019/lei-13869-2019-09-05.md"}}, {id:"federal:BR:L:13791/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vi