:begin
UNWIND [{id:"federal:BR:LC:211/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2024, data:"2024-12-30", numero:"211", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2024-12-30;211", vigente:true, titulo:"Lei Complementar nº 211 de 30/12/2024", urn:"urn:lex:br:federal:lei.complementar:2024-12-30;211", ementa:"Altera a Lei Complementar nº 200, de 30 de agosto de 2023, que institui regime fiscal sustentável para garantir a estabilidade macroeconômica do País e criar as condições adequadas ao crescimento socioeconômico; revoga a Lei Complementar nº 207, de 16 de maio de 2024; e dá outras providências.", arquivo:"federal/leis-complementares/2024/lcp-211-2024-12-30.md"}}, {id:"federal:BR:LC:210/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2024, data:"2024-11-25", numero:"210", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2024-11-25;210", vigente:true, titulo:"Lei Complementar nº 210 de 25/11/2024", urn:"urn:lex:br:federal:lei.complementar:2024-11-25;210", ementa:"Dispõe sobre a proposição e a execução de emendas parlamentares na lei orçamentária anual; e dá outras providências.", arquivo:"federal/leis-complementares/2024/lcp-210-2024-11-25.md"}}, {id:"federal:BR:LC:206/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2024, data:"2024-05-16", numero:"206", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2024-05-16;206", vigente:true, titulo:"Lei Complementar nº 206 de 16/05/2024", urn:"urn:lex:br:federal:lei.complementar:2024-05-16;206", ementa:"Autoriza a União a postergar o pagamento da dívida de entes federativos afetados por calamidade pública reconhecida pelo Congresso Nacional, mediante proposta do Poder Executivo federal, e a reduzir a taxa de juros dos contratos de dívida dos referidos entes com a União; e altera a Lei Complementar nº 101, de 4 de maio de 2000 (Lei de Responsabilidade Fiscal), e a Lei Complementar nº 159, de 19 de maio de 2017.", arquivo:"federal/leis-complementares/2024/lcp-206-2024-05-16.md"}}, {id:"federal:BR:LC:209/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2024, data:"2024-10-03", numero:"209", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2024-10-03;209", vigente:true, titulo:"Lei Complementar nº 209 de 03/10/2024", urn:"urn:lex:br:federal:lei.complementar:2024-10-03;209", ementa:"Altera a Lei Complementar nº 141, de 13 de janeiro de 2012, que regulamenta o § 3º do art. 198 da Constituição Federal, para dispor sobre as despesas de custeio e de investimento com os hospitais universitários federais, para fins de apuração do gasto mínimo constitucional em saúde.", arquivo:"federal/leis-complementares/2024/lcp-209-2024-10-03.md"}}, {id:"federal:BR:LC:208/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2024, data:"2024-07-02", numero:"208", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2024-07-02;208", vigente:true, titulo:"Lei Complementar nº 208 de 02/07/2024", urn:"urn:lex:br:federal:lei.complementar:2024-07-02;208", ementa:"Altera a Lei nº 4.320, de 17 de março de 1964, para dispor sobre a cessão de direitos creditórios originados de créditos tributários e não tributários dos entes da Federação, e a Lei nº 5.172, de 25 de outubro de 1966 (Código Tributário Nacional), para prever o protesto extrajudicial como causa de interrupção da prescrição e para autorizar a administração tributária a requisitar informações a entidades e órgãos públicos ou privados.", arquivo:"federal/leis-complementares/2024/lcp-208-2024-07-02.md"}}, {id:"federal:BR:LC:205/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2024, data:"2024-05-09", numero:"205", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2024-05-09;205", vigente:true, titulo:"Lei Complementar nº 205 de 09/05/2024", urn:"urn:lex:br:federal:lei.complementar:2024-05-09;205", ementa:"Altera a Lei Complementar nº 172, de 15 de abril de 2020, a fim de conceder prazo aos Estados, ao Distrito Federal e aos Municípios para executar atos de transposição e de transferência.", arquivo:"federal/leis-complementares/2024/lcp-205-2024-05-09.md"}}, {id:"federal:BR:LC:123/2006", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2006, data:"2006-12-14", numero:"123", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2006-12-14;123", vigente:true, titulo:"Lei Complementar nº 123 de 14/12/2006", urn:"urn:lex:br:federal:lei.complementar:2006-12-14;123", ementa:"Institui o Estatuto Nacional da Microempresa e da Empresa de Pequeno Porte; altera dispositivos das Leis nºs 8.212 e 8.213, ambas de 24 de julho de 1991, da Consolidação das Leis do Trabalho - CLT, aprovada pelo Decreto-Lei nº 5.452, de 1º de maio de 1943, da Lei nº 10.189, de 14 de fevereiro de 2001, da Lei Complementar nº 63, de 11 de janeiro de 1990; e revoga as Leis nºs 9.317, de 5 de dezembro de 1996, e 9.841, de 5 de outubro de 1999.", arquivo:"federal/leis-complementares/2006/lcp-123-2006-12-14.md"}}, {id:"federal:BR:LC:121/2006", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2006, data:"2006-02-09", numero:"121", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2006-02-09;121", vigente:true, titulo:"Lei Complementar nº 121 de 09/02/2006", urn:"urn:lex:br:federal:lei.complementar:2006-02-09;121", ementa:"Cria o Sistema Nacional de Prevenção, Fiscalização e Repressão ao Furto e Roubo de Veículos e Cargas e dá outras providências.", arquivo:"federal/leis-complementares/2006/lcp-121-2006-02-09.md"}}, {id:"federal:BR:LC:122/2006", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2006, data:"2006-12-12", numero:"122", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2006-12-12;122", vigente:true, titulo:"Lei Complementar nº 122 de 12/12/2006", urn:"urn:lex:br:federal:lei.complementar:2006-12-12;122", ementa:"Altera o art. 33 da Lei Complementar nº 87, de 13 de setembro de 1996, que dispõe sobre o imposto dos Estados e do Distrito Federal sobre operações relativas à circulação de mercadorias e sobre prestações de serviços de transporte interestadual e intermunicipal e de comunicação, para prorrogar os prazos previstos em relação à apropriação dos créditos do ICMS.", arquivo:"federal/leis-complementares/2006/lcp-122-2006-12-12.md"}}, {id:"federal:BR:LC:52/1986", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1986, data:"1986-04-16", numero:"52", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1986-04-16;52", vigente:true, titulo:"Lei Complementar nº 52 de 16/04/1986", urn:"urn:lex:br:federal:lei.complementar:1986-04-16;52", ementa:"Inclui o Município de Maracanaú, recém-desmembrado do Município de   Maranguape, na região metropolitana de Fortaleza, alterando o § 8º do art. 1º da   Lei Complementar nº 14, de 8 de junho de 1973.", arquivo:"federal/leis-complementares/1986/lcp-52-1986-04-16.md"}}, {id:"federal:BR:LC:54/1986", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1986, data:"1986-12-22", numero:"54", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1986-12-22;54", vigente:true, titulo:"Lei Complementar nº 54 de 22/12/1986", urn:"urn:lex:br:federal:lei.complementar:1986-12-22;54", ementa:"Dispõe sobre nova redação e revogação de artigos da Lei Complementar nº   35, de 14 de março de 1979.", arquivo:"federal/leis-complementares/1986/lcp-54-1986-12-22.md"}}, {id:"federal:BR:LC:53/1986", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1986, data:"1986-12-19", numero:"53", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1986-12-19;53", vigente:true, titulo:"Lei Complementar nº 53 de 19/12/1986", urn:"urn:lex:br:federal:lei.complementar:1986-12-19;53", ementa:"Concede isenção do Imposto sobre Circulação de Mercadorias - ICM para   veículos destinadas a uso exclusivo de paraplégicos ou de pessoas portadoras de   defeitos físicos.", arquivo:"federal/leis-complementares/1986/lcp-53-1986-12-19.md"}}, {id:"federal:BR:LC:30/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1977, data:"1977-06-27", numero:"30", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1977-06-27;30", vigente:true, titulo:"Lei Complementar nº 30 de 27/06/1977", urn:"urn:lex:br:federal:lei.complementar:1977-06-27;30", ementa:"Permite aposentadoria voluntária, nas condições que especifica, aos   funcionários públicos do Distrito Federal incluídos em Quadro Suplementar ou   postos em disponibilidade.", arquivo:"federal/leis-complementares/1977/lcp-30-1977-06-27.md"}}, {id:"federal:BR:LC:32/1977", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1977, data:"1977-12-26", numero:"32", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1977-12-26;32", vigente:true, titulo:"Lei Complementar nº 32 de 26/12/1977", urn:"urn:lex:br:federal:lei.complementar:1977-12-26;32", ementa:"Altera a redação do artigo 5º, caput , da Lei Complementar nº 1,   de 9 de novembro de 1967, que dispõe sobre a criação de novos Municípios, e dá   outras providências.", arquivo:"federal/leis-complementares/1977/lcp-32-1977-12-26.md"}}, {id:"federal:BR:LC:31/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1977, data:"1977-10-11", numero:"31", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1977-10-11;31", vigente:true, titulo:"Lei Complementar nº 31 de 11/10/1977", urn:"urn:lex:br:federal:lei.complementar:1977-10-11;31", ementa:"Cria o Estado de Mato Grosso do Sul e dá outras providências.", arquivo:"federal/leis-complementares/1977/lcp-31-1977-10-11.md"}}, {id:"federal:BR:LC:152/2015", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2015, data:"2015-12-03", numero:"152", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2015-12-03;152", vigente:true, titulo:"Lei Complementar nº 152 de 03/12/2015", urn:"urn:lex:br:federal:lei.complementar:2015-12-03;152", ementa:"Dispõe sobre a aposentadoria compulsória por idade, com proventos proporcionais, nos termos do inciso II do § 1º do art. 40 da Constituição Federal.", arquivo:"federal/leis-complementares/2015/lcp-152-2015-12-03.md"}}, {id:"federal:BR:LC:149/2015", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2015, data:"2015-01-12", numero:"149", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2015-01-12;149", vigente:true, titulo:"Lei Complementar nº 149 de 12/01/2015", urn:"urn:lex:br:federal:lei.complementar:2015-01-12;149", ementa:"Altera a Lei Complementar nº 90, de 1º de outubro de 1997, que determina os casos em que forças estrangeiras possam transitar pelo território nacional ou nele permanecer temporariamente.", arquivo:"federal/leis-complementares/2015/lcp-149-2015-01-12.md"}}, {id:"federal:BR:LC:151/2015", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2015, data:"2015-08-05", numero:"151", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2015-08-05;151", vigente:true, titulo:"Lei Complementar nº 151 de 05/08/2015", urn:"urn:lex:br:federal:lei.complementar:2015-08-05;151", ementa:"Altera a Lei Complementar nº 148, de 25 de novembro de 2014; revoga as Leis nºs 10.819, de 16 de dezembro de 2003, e 11.429, de 26 de dezembro de 2006; e dá outras providências.", arquivo:"federal/leis-complementares/2015/lcp-151-2015-08-05.md"}}, {id:"federal:BR:LC:150/2015", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2015, data:"2015-06-01", numero:"150", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2015-06-01;150", vigente:true, titulo:"Lei Complementar nº 150 de 01/06/2015", urn:"urn:lex:br:federal:lei.complementar:2015-06-01;150", ementa:"Dispõe sobre o contrato de trabalho doméstico; altera as Leis nº 8.212, de 24 de julho de 1991, nº 8.213, de 24 de julho de 1991, e nº 11.196, de 21 de novembro de 2005; revoga o inciso I do art. 3º da Lei nº 8.009, de 29 de março de 1990, o art. 36 da Lei nº 8.213, de 24 de julho de 1991, a Lei nº 5.859, de 11 de dezembro de 1972, e o inciso VII do art. 12 da Lei nº 9.250, de 26 de dezembro 1995; e dá outras providências.", arquivo:"federal/leis-complementares/2015/lcp-150-2015-06-01.md"}}, {id:"federal:BR:LC:153/2015", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2015, data:"2015-12-09", numero:"153", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2015-12-09;153", vigente:true, titulo:"Lei Complementar nº 153 de 09/12/2015", urn:"urn:lex:br:federal:lei.complementar:2015-12-09;153", ementa:"Altera o art. 3º da Lei Complementar nº 79, de 7 de janeiro de 1994, que cria o Fundo Penitenciário Nacional - FUNPEN, e dá outras providências.", arquivo:"federal/leis-complementares/2015/lcp-153-2015-12-09.md"}}, {id:"federal:BR:LC:83/1995", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1995, data:"1995-09-12", numero:"83", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1995-09-12;83", vigente:true, titulo:"Lei Complementar nº 83 de 12/09/1995", urn:"urn:lex:br:federal:lei.complementar:1995-09-12;83", ementa:"Altera dispositivo da Lei Complementar nº 69, de 23 de julho de 1991, que dispõe sobre as normas gerais para a organização, o preparo e o emprego das Forças Armadas.", arquivo:"federal/leis-complementares/1995/lcp-83-1995-09-12.md"}}, {id:"federal:BR:LC:176/2020", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2020, data:"2020-12-29", numero:"176", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2020-12-29;176", vigente:true, titulo:"Lei Complementar nº 176 de 29/12/2020", urn:"urn:lex:br:federal:lei.complementar:2020-12-29;176", ementa:"Institui transferências obrigatórias da União para os Estados, o Distrito Federal e os Municípios, por prazo ou fato determinado; declara atendida a regra de cessação contida no § 2º do art. 91 do Ato das Disposições Constitucionais Transitórias (ADCT); e altera a Lei nº 13.885, de 17 de outubro de 2019.", arquivo:"federal/leis-complementares/2020/lcp-176-2020-12-29.md"}}, {id:"federal:BR:LC:172/2020", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2020, data:"2020-04-15", numero:"172", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2020-04-15;172", vigente:true, titulo:"Lei Complementar nº 172 de 15/04/2020", urn:"urn:lex:br:federal:lei.complementar:2020-04-15;172", ementa:"Dispõe sobre a transposição e a transferência de saldos financeiros constantes dos Fundos de Saúde dos Estados, do Distrito Federal e dos Municípios, provenientes de repasses federais.", arquivo:"federal/leis-complementares/2020/lcp-172-2020-04-15.md"}}, {id:"federal:BR:LC:175/2020", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2020, data:"2020-09-23", numero:"175", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2020-09-23;175", vigente:true, titulo:"Lei Complementar nº 175 de 23/09/2020", urn:"urn:lex:br:federal:lei.complementar:2020-09-23;175", ementa:"Dispõe sobre o padrão nacional de obrigação acessória do Imposto Sobre Serviços de Qualquer Natureza (ISSQN), de competência dos Municípios e do Distrito Federal, incidente sobre os serviços previstos nos subitens 4.22, 4.23, 5.09, 15.01 e 15.09 da lista de serviços anexa à Lei Complementar nº 116, de 31 de julho de 2003; altera dispositivos da referida Lei Complementar; prevê regra de transição para a partilha do produto da arrecadação do ISSQN entre o Município do local do estabelecimento pres", arquivo:"federal/leis-complementares/2020/lcp-175-2020-09-23.md"}}, {id:"federal:BR:LC:173/2020", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2020, data:"2020-05-27", numero:"173", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2020-05-27;173", vigente:true, titulo:"Lei Complementar nº 173 de 27/05/2020", urn:"urn:lex:br:federal:lei.complementar:2020-05-27;173", ementa:"Estabelece o Programa Federativo de Enfrentamento ao Coronavírus SARS-CoV-2 (Covid-19), altera a Lei Complementar nº 101, de 4 de maio de 2000, e dá outras providências.", arquivo:"federal/leis-complementares/2020/lcp-173-2020-05-27.md"}}, {id:"federal:BR:LC:174/2020", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2020, data:"2020-08-05", numero:"174", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2020-08-05;174", vigente:true, titulo:"Lei Complementar nº 174 de 05/08/2020", urn:"urn:lex:br:federal:lei.complementar:2020-08-05;174", ementa:"Autoriza a extinção de créditos tributários apurados na forma do Regime Especial Unificado de Arrecadação de Tributos e Contribuições devidos pelas Microempresas e Empresas de Pequeno Porte (Simples Nacional), mediante celebração de transação resolutiva de litígio; e prorroga o prazo para enquadramento no Simples Nacional em todo o território brasileiro, no ano de 2020, para microempresas e empresas de pequeno porte em início de atividade.", arquivo:"federal/leis-complementares/2020/lcp-174-2020-08-05.md"}}, {id:"federal:BR:LC:115/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2002, data:"2002-12-26", numero:"115", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2002-12-26;115", vigente:true, titulo:"Lei Complementar nº 115 de 26/12/2002", urn:"urn:lex:br:federal:lei.complementar:2002-12-26;115", ementa:"Altera as Leis Complementares nºs 87, de 13 de setembro de 1996, e 102, de 11 de julho de 2000.", arquivo:"federal/leis-complementares/2002/lcp-115-2002-12-26.md"}}, {id:"federal:BR:LC:114/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2002, data:"2002-12-16", numero:"114", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2002-12-16;114", vigente:true, titulo:"Lei Complementar nº 114 de 16/12/2002", urn:"urn:lex:br:federal:lei.complementar:2002-12-16;114", ementa:"Altera dispositivos da Lei Complementar nº 87, de 13 de setembro de 1996, que dispõe sobre o imposto dos Estados e do Distrito Federal sobre operações relativas à circulação de mercadorias e sobre prestações de serviços de transporte interestadual e intermunicipal e de comunicação, e dá outras providências.", arquivo:"federal/leis-complementares/2002/lcp-114-2002-12-16.md"}}, {id:"federal:BR:LC:42/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1982, data:"1982-02-01", numero:"42", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1982-02-01;42", vigente:true, titulo:"Lei Complementar nº 42 de 01/02/1982", urn:"urn:lex:br:federal:lei.complementar:1982-02-01;42", ementa:"Altera a Lei Complementar nº 5, de 29 de abril de 1970, que estabelece, de   acordo com o art. 151 e seu parágrafo único da Emenda Constitucional nº 1, de 17   de outubro de 1969, casos de inelegibilidade, e dá outras providências.", arquivo:"federal/leis-complementares/1982/lcp-42-1982-02-01.md"}}, {id:"federal:BR:LC:15/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1973, data:"1973-08-13", numero:"15", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1973-08-13;15", vigente:true, titulo:"Lei Complementar nº 15 de 13/08/1973", urn:"urn:lex:br:federal:lei.complementar:1973-08-13;15", ementa:"Regula a composição e o funcionamento do colégio que elegerá o Presidente   da República, e dá outras providências.", arquivo:"federal/leis-complementares/1973/lcp-15-1973-08-13.md"}}, {id:"federal:BR:LC:17/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1973, data:"1973-12-12", numero:"17", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1973-12-12;17", vigente:true, titulo:"Lei Complementar nº 17 de 12/12/1973", urn:"urn:lex:br:federal:lei.complementar:1973-12-12;17", ementa:"Dispõe sobre o Programa de Integração Social de que trata a Lei   Complementar nº 7, de 7 de setembro de 1970, e dá outras providências.", arquivo:"federal/leis-complementares/1973/lcp-17-1973-12-12.md"}}, {id:"federal:BR:LC:16/1973", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1973, data:"1973-10-30", numero:"16", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1973-10-30;16", vigente:true, titulo:"Lei Complementar nº 16 de 30/10/1973", urn:"urn:lex:br:federal:lei.complementar:1973-10-30;16", ementa:"Altera a redação de dispositivos da Lei Complementar nº 11, de 25 de maio   de 1971, e dá outras providências.", arquivo:"federal/leis-complementares/1973/lcp-16-1973-10-30.md"}}, {id:"federal:BR:LC:14/1973", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1973, data:"1973-06-08", numero:"14", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1973-06-08;14", vigente:true, titulo:"Lei Complementar nº 14 de 08/06/1973", urn:"urn:lex:br:federal:lei.complementar:1973-06-08;14", ementa:"Estabelece as regiões metropolitanas de São Paulo, Belo Horizonte, Porto   Alegre, Recife, Salvador, Curitiba, Belém e Fortaleza.", arquivo:"federal/leis-complementares/1973/lcp-14-1973-06-08.md"}}, {id:"federal:BR:LC:140/2011", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2011, data:"2011-12-08", numero:"140", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2011-12-08;140", vigente:true, titulo:"Lei Complementar nº 140 de 08/12/2011", urn:"urn:lex:br:federal:lei.complementar:2011-12-08;140", ementa:"Fixa normas, nos termos dos incisos III, VI e VII do caput e do parágrafo único do art. 23 da Constituição Federal, para a cooperação entre a União, os Estados, o Distrito Federal e os Municípios nas ações administrativas decorrentes do exercício da competência comum relativas à proteção das paisagens naturais notáveis, à proteção do meio ambiente, ao combate à poluição em qualquer de suas formas e à preservação das florestas, da fauna e da flora; e altera a Lei nº 6.938, de 31 de agosto de 1981", arquivo:"federal/leis-complementares/2011/lcp-140-2011-12-08.md"}}, {id:"federal:BR:LC:139/2011", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2011, data:"2011-11-10", numero:"139", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2011-11-10;139", vigente:true, titulo:"Lei Complementar nº 139 de 10/11/2011", urn:"urn:lex:br:federal:lei.complementar:2011-11-10;139", ementa:"Altera dispositivos da Lei Complementar nº 123, de 14 de dezembro de 2006, e dá outras providências.", arquivo:"federal/leis-complementares/2011/lcp-139-2011-11-10.md"}}, {id:"federal:BR:LC:70/1991", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1991, data:"1991-12-30", numero:"70", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1991-12-30;70", vigente:true, titulo:"Lei Complementar nº 70 de 30/12/1991", urn:"urn:lex:br:federal:lei.complementar:1991-12-30;70", ementa:"Institui contribuição para financiamento da Seguridade Social, eleva a alíquota da contribuição social sobre o lucro das instituições financeiras e dá outras providências.", arquivo:"federal/leis-complementares/1991/lcp-70-1991-12-30.md"}}, {id:"federal:BR:LC:65/1991", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1991, data:"1991-04-15", numero:"65", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1991-04-15;65", vigente:true, titulo:"Lei Complementar nº 65 de 15/04/1991", urn:"urn:lex:br:federal:lei.complementar:1991-04-15;65", ementa:"Define na forma da alínea \"a\" do inciso X do art. 155 da Constituição, os   produtos semi-elaborados que podem ser tributados pelos Estados e Distrito   Federal, quando de sua exportação para o exterior.", arquivo:"federal/leis-complementares/1991/lcp-65-1991-04-15.md"}}, {id:"federal:BR:LC:168/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2019, data:"2019-06-12", numero:"168", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2019-06-12;168", vigente:true, titulo:"Lei Complementar nº 168 de 12/06/2019", urn:"urn:lex:br:federal:lei.complementar:2019-06-12;168", ementa:"Autoriza, no prazo que especifica, o retorno ao Regime Especial Unificado de Arrecadação de Tributos e Contribuições devidos pelas Microempresas e Empresas de Pequeno Porte (Simples Nacional) dos optantes excluídos desse regime tributário em 1º de janeiro de 2018.", arquivo:"federal/leis-complementares/2019/lcp-168-2019-06-12.md"}}, {id:"federal:BR:LC:167/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2019, data:"2019-04-24", numero:"167", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2019-04-24;167", vigente:true, titulo:"Lei Complementar nº 167 de 24/04/2019", urn:"urn:lex:br:federal:lei.complementar:2019-04-24;167", ementa:"Dispõe sobre a Empresa Simples de Crédito (ESC) e altera a Lei nº 9.613, de 3 de março de 1998 (Lei de Lavagem de Dinheiro), a Lei nº 9.249, de 26 de dezembro de 1995, e a Lei Complementar nº 123, de 14 de dezembro de 2006 (Lei do Simples Nacional), para regulamentar a ESC e instituir o Inova Simples.", arquivo:"federal/leis-complementares/2019/lcp-167-2019-04-24.md"}}, {id:"federal:BR:LC:165/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2019, data:"2019-01-03", numero:"165", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2019-01-03;165", vigente:true, titulo:"Lei Complementar nº 165 de 03/01/2019", urn:"urn:lex:br:federal:lei.complementar:2019-01-03;165", ementa:"Acrescenta o § 3º ao art. 2º da Lei Complementar nº 91, de 22 de dezembro de 1997, que dispõe sobre a fixação dos coeficientes de distribuição dos recursos do Fundo de Participação dos Municípios (FPM).", arquivo:"federal/leis-complementares/2019/lcp-165-2019-01-03.md"}}, {id:"federal:BR:LC:170/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-19", numero:"170", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2019-12-19;170", vigente:true, titulo:"Lei Complementar nº 170 de 19/12/2019", urn:"urn:lex:br:federal:lei.complementar:2019-12-19;170", ementa:"Altera a Lei Complementar nº 160, de 7 de agosto de 2017, para permitir a prorrogação, por até 15 (quinze) anos, das isenções, dos incentivos e dos benefícios fiscais ou financeiro-fiscais vinculados ao Imposto sobre Operações Relativas à Circulação de Mercadorias e sobre Prestações de Serviços de Transporte Interestadual e Intermunicipal e de comunicação (ICMS) e destinados a templos de qualquer culto e a entidades beneficentes de assistência social.", arquivo:"federal/leis-complementares/2019/lcp-170-2019-12-19.md"}}, {id:"federal:BR:LC:171/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-27", numero:"171", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2019-12-27;171", vigente:true, titulo:"Lei Complementar nº 171 de 27/12/2019", urn:"urn:lex:br:federal:lei.complementar:2019-12-27;171", ementa:"Altera a Lei Complementar nº 87, de 13 de setembro de 1996 (Lei Kandir), para prorrogar prazos em relação à apropriação dos créditos do imposto estadual sobre operações relativas à circulação de mercadorias e sobre prestações de serviços de transporte interestadual e intermunicipal e de comunicação (ICMS).", arquivo:"federal/leis-complementares/2019/lcp-171-2019-12-27.md"}}, {id:"federal:BR:LC:169/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-02", numero:"169", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2019-12-02;169", vigente:true, titulo:"Lei Complementar nº 169 de 02/12/2019", urn:"urn:lex:br:federal:lei.complementar:2019-12-02;169", ementa:"Altera a Lei Complementar nº 123, de 14 de dezembro de 2006 (Lei do Simples Nacional), para autorizar a constituição de sociedade de garantia solidária e de sociedade de contragarantia.", arquivo:"federal/leis-complementares/2019/lcp-169-2019-12-02.md"}}, {id:"federal:BR:LC:166/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2019, data:"2019-04-08", numero:"166", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2019-04-08;166", vigente:true, titulo:"Lei Complementar nº 166 de 08/04/2019", urn:"urn:lex:br:federal:lei.complementar:2019-04-08;166", ementa:"Altera a Lei Complementar nº 105, de 10 de janeiro de 2001, e a Lei nº 12.414, de 9 de junho de 2011, para dispor sobre os cadastros positivos de crédito e regular a responsabilidade civil dos operadores.", arquivo:"federal/leis-complementares/2019/lcp-166-2019-04-08.md"}}, {id:"federal:BR:LC:98/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-03", numero:"98", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1999-12-03;98", vigente:true, titulo:"Lei Complementar nº 98 de 03/12/1999", urn:"urn:lex:br:federal:lei.complementar:1999-12-03;98", ementa:"Altera dispositivos da Lei Complementar nº 80, de 12 de janeiro de 1994.", arquivo:"federal/leis-complementares/1999/lcp-98-1999-12-03.md"}}, {id:"federal:BR:LC:99/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-20", numero:"99", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1999-12-20;99", vigente:true, titulo:"Lei Complementar nº 99 de 20/12/1999", urn:"urn:lex:br:federal:lei.complementar:1999-12-20;99", ementa:"Dá nova redação ao inciso I do art. 33 da Lei Complementar nº 87, de 13 de setembro de 1996, que dispõe sobre o imposto dos Estados e do Distrito Federal sobre operações relativas à circulação de mercadorias e sobre prestações de serviços de transporte interestadual e intermunicipal e de comunicação, e dá outras providências.", arquivo:"federal/leis-complementares/1999/lcp-99-1999-12-20.md"}}, {id:"federal:BR:LC:97/1999", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1999, data:"1999-06-09", numero:"97", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1999-06-09;97", vigente:true, titulo:"Lei Complementar nº 97 de 09/06/1999", urn:"urn:lex:br:federal:lei.complementar:1999-06-09;97", ementa:"Dispõe sobre as normas gerais para a organização, o preparo e o emprego das Forças Armadas.", arquivo:"federal/leis-complementares/1999/lcp-97-1999-06-09.md"}}, {id:"federal:BR:LC:1/1962", properties:{esfera:"federal", versao_texto:"texto da fonte oficial", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1962, data:"1962-07-17", numero:"1", fonte:"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp01-62.htm", vigente:true, titulo:"Lei Complementar nº 1 de 17/07/1962", urn:"urn:lex:br:federal:lei.complementar:1962-07-17;1", ementa:"Complementa a organização do sistema parlamentar de Govêrno, e  estabelece outras disposições.", arquivo:"federal/leis-complementares/1962/lcp-1-1962-07-17.md"}}, {id:"federal:BR:LC:2/1962", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1962, data:"1962-09-16", numero:"2", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1962-09-16;2", vigente:true, titulo:"Lei Complementar nº 2 de 16/09/1962", urn:"urn:lex:br:federal:lei.complementar:1962-09-16;2", ementa:"Dispõe sôbre a vacância ministerial, e dá outras providências.", arquivo:"federal/leis-complementares/1962/lcp-2-1962-09-16.md"}}, {id:"federal:BR:LC:102/2000", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2000, data:"2000-07-11", numero:"102", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2000-07-11;102", vigente:true, titulo:"Lei Complementar nº 102 de 11/07/2000", urn:"urn:lex:br:federal:lei.complementar:2000-07-11;102", ementa:"Altera dispositivos da Lei Complementar nº 87, de 13 de setembro de 1996, que dispõe sobre o imposto dos Estados e do Distrito Federal sobre operações relativas à circulação de mercadorias e sobre prestações de serviços de transporte interestadual e intermunicipal e de comunicação, e dá outras providências.", arquivo:"federal/leis-complementares/2000/lcp-102-2000-07-11.md"}}, {id:"federal:BR:LC:103/2000", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2000, data:"2000-07-14", numero:"103", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2000-07-14;103", vigente:true, titulo:"Lei Complementar nº 103 de 14/07/2000", urn:"urn:lex:br:federal:lei.complementar:2000-07-14;103", ementa:"Autoriza os Estados e o Distrito Federal a instituir o piso salarial a que se refere o inciso V do art. 7º da Constituição Federal, por aplicação do disposto no parágrafo único do seu art. 22.", arquivo:"federal/leis-complementares/2000/lcp-103-2000-07-14.md"}}, {id:"federal:BR:LC:101/2000", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2000, data:"2000-05-04", numero:"101", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2000-05-04;101", vigente:true, titulo:"Lei Complementar nº 101 de 04/05/2000", urn:"urn:lex:br:federal:lei.complementar:2000-05-04;101", ementa:"Estabelece normas de finanças públicas voltadas para a responsabilidade na gestão fiscal e dá outras providências.", arquivo:"federal/leis-complementares/2000/lcp-101-2000-05-04.md"}}, {id:"federal:BR:LC:39/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-10", numero:"39", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1980-12-10;39", vigente:true, titulo:"Lei Complementar nº 39 de 10/12/1980", urn:"urn:lex:br:federal:lei.complementar:1980-12-10;39", ementa:"Altera a redação do art. 6º da Lei Complementar nº 28, de 18 de novembro   de 1975, e dá outras providências.", arquivo:"federal/leis-complementares/1980/lcp-39-1980-12-10.md"}}, {id:"federal:BR:LC:10/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1971, data:"1971-05-06", numero:"10", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1971-05-06;10", vigente:true, titulo:"Lei Complementar nº 10 de 06/05/1971", urn:"urn:lex:br:federal:lei.complementar:1971-05-06;10", ementa:"Fixa normas para o cumprimento do disposto nos artigos 98 e 108, ;§   1º, da Constituição.", arquivo:"federal/leis-complementares/1971/lcp-10-1971-05-06.md"}}, {id:"federal:BR:LC:11/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1971, data:"1971-05-25", numero:"11", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1971-05-25;11", vigente:true, titulo:"Lei Complementar nº 11 de 25/05/1971", urn:"urn:lex:br:federal:lei.complementar:1971-05-25;11", ementa:"Institui o Programa de Assistência ao Trabalhador Rural, e dá outras   providências.", arquivo:"federal/leis-complementares/1971/lcp-11-1971-05-25.md"}}, {id:"federal:BR:LC:12/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1971, data:"1971-11-08", numero:"12", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1971-11-08;12", vigente:true, titulo:"Lei Complementar nº 12 de 08/11/1971", urn:"urn:lex:br:federal:lei.complementar:1971-11-08;12", ementa:"Regula o artigo 69 da Constituição e dá outras providências.", arquivo:"federal/leis-complementares/1971/lcp-12-1971-11-08.md"}}, {id:"federal:BR:LC:236/2026", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2026, data:"2026-09-04", numero:"236", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2026-09-04;236", vigente:true, titulo:"Lei Complementar nº 236 de 04/09/2026", urn:"urn:lex:br:federal:lei.complementar:2026-09-04;236", ementa:"Altera a Lei nº 5.172, de 25 de outubro de 1966 (Código Tributário Nacional), para dispor sobre normas gerais para solução de controvérsias, consensualidade e processo administrativo em matéria tributária e aduaneira, e revoga dispositivo da Lei nº 9.430, de 27 de dezembro de 1996.", arquivo:"federal/leis-complementares/2026/lcp-236-2026-09-04.md"}}, {id:"federal:BR:LC:233/2026", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2026, data:"2026-07-01", numero:"233", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2026-07-01;233", vigente:true, titulo:"Lei Complementar nº 233 de 01/07/2026", urn:"urn:lex:br:federal:lei.complementar:2026-07-01;233", ementa:"Altera a Lei Complementar nº 79, de 7 de janeiro de 1994, para destinar recursos do Fundo Penitenciário Nacional (Funpen) à formação, ao aperfeiçoamento, à especialização e à capacitação continuada dos servidores do sistema penitenciário nacional e dos policiais penais.", arquivo:"federal/leis-complementares/2026/lcp-233-2026-07-01.md"}}, {id:"federal:BR:LC:227/2026", properties:{esfera:"federal", versao_texto:"texto da fonte oficial", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2026, data:"2026-01-13", numero:"227", fonte:"https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp227.htm", vigente:true, titulo:"Lei Complementar nº 227 de 13/01/2026", urn:"urn:lex:br:federal:lei.complementar:2026-01-13;227", ementa:"Institui o Comitê Gestor do Imposto sobre Bens e Serviços (CGIBS); dispõe sobre o processo administrativo tributário do Imposto sobre Bens e Serviços (IBS) e sobre a distribuição do produto da arrecadação do IBS aos entes federativos; institui normais gerais relativas ao Imposto sobre Transmissão Causa mortis e Doação de Quaisquer Bens ou Direitos (ITCMD); altera a Lei nº 5.172, de 25 de outubro de 1966 (Código Tributário Nacional), a Lei nº 1.079, de 10 de abril de 1950, a Lei nº 9.430, de 27 d", arquivo:"federal/leis-complementares/2026/lcp-227-2026-01-13.md"}}, {id:"federal:BR:LC:226/2026", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2026, data:"2026-01-12", numero:"226", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2026-01-12;226", vigente:true, titulo:"Lei Complementar nº 226 de 12/01/2026", urn:"urn:lex:br:federal:lei.complementar:2026-01-12;226", ementa:"Altera a Lei Complementar nº 173, de 27 de maio de 2020, para prever a autorização de pagamentos retroativos de anuênio, triênio, quinquênio, sexta-parte, licença-prêmio e demais mecanismos equivalentes ao quadro de pessoal de entes federativos que decretaram estado de calamidade pública decorrente da pandemia da covid-19.", arquivo:"federal/leis-complementares/2026/lcp-226-2026-01-12.md"}}, {id:"federal:BR:LC:225/2026", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2026, data:"2026-01-08", numero:"225", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2026-01-08;225", vigente:true, titulo:"Lei Complementar nº 225 de 08/01/2026", urn:"urn:lex:br:federal:lei.complementar:2026-01-08;225", ementa:"Institui o Código de Defesa do Contribuinte.", arquivo:"federal/leis-complementares/2026/lcp-225-2026-01-08.md"}}, {id:"federal:BR:LC:232/2026", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2026, data:"2026-06-26", numero:"232", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2026-06-26;232", vigente:true, titulo:"Lei Complementar nº 232 de 26/06/2026", urn:"urn:lex:br:federal:lei.complementar:2026-06-26;232", ementa:"Estabelece condições à concessão de isenção do Imposto sobre Serviços de Qualquer Natureza (ISS) para fatos geradores relacionados à organização ou à realização da Copa do Mundo Feminina da FIFA 2027.", arquivo:"federal/leis-complementares/2026/lcp-232-2026-06-26.md"}}, {id:"federal:BR:LC:228/2026", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2026, data:"2026-03-19", numero:"228", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2026-03-19;228", vigente:true, titulo:"Lei Complementar nº 228 de 19/03/2026", urn:"urn:lex:br:federal:lei.complementar:2026-03-19;228", ementa:"Dispõe sobre a redução de alíquotas da Contribuição para o PIS/Pasep e da Cofins incidentes sobre a indústria química e petroquímica, e altera as Leis nºs 11.196, de 21 de novembro de 2005, e 10.865, de 30 de abril de 2004.", arquivo:"federal/leis-complementares/2026/lcp-228-2026-03-19.md"}}, {id:"federal:BR:LC:234/2026", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2026, data:"2026-08-06", numero:"234", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2026-08-06;234", vigente:true, titulo:"Lei Complementar nº 234 de 06/08/2026", urn:"urn:lex:br:federal:lei.complementar:2026-08-06;234", ementa:"Altera a Lei Complementar nº 141, de 13 de janeiro de 2012, para permitir que o serviço de atendimento pré-hospitalar dos corpos de bombeiros militares dos Estados e do Distrito Federal perceba emendas parlamentares destinadas às ações e serviços públicos de saúde.", arquivo:"federal/leis-complementares/2026/lcp-234-2026-08-06.md"}}, {id:"federal:BR:LC:230/2026", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2026, data:"2026-04-15", numero:"230", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2026-04-15;230", vigente:true, titulo:"Lei Complementar nº 230 de 15/04/2026", urn:"urn:lex:br:federal:lei.complementar:2026-04-15;230", ementa:"Dispõe sobre normas gerais aplicáveis ao desmembramento de parte de um Município para incorporação a outro, limítrofe, nos termos do § 4º do art. 18 da Constituição Federal.", arquivo:"federal/leis-complementares/2026/lcp-230-2026-04-15.md"}}, {id:"federal:BR:LC:235/2026", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2026, data:"2026-08-27", numero:"235", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2026-08-27;235", vigente:true, titulo:"Lei Complementar nº 235 de 27/08/2026", urn:"urn:lex:br:federal:lei.complementar:2026-08-27;235", ementa:"Dispõe sobre regras para renúncias de receita com o objetivo de mitigar os impactos econômicos causados pelo choque no mercado internacional de energia decorrente do conflito no Oriente Médio e excepcionaliza os benefícios tributários destinados à Política Nacional de Minerais Críticos e Estratégicos, ao Programa de Desenvolvimento da Indústria de Fertilizantes e à realização da Copa do Mundo Feminina, e dá outras providências.", arquivo:"federal/leis-complementares/2026/lcp-235-2026-08-27.md"}}, {id:"federal:BR:LC:237/2026", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2026, data:"2026-09-15", numero:"237", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2026-09-15;237", vigente:true, titulo:"Lei Complementar nº 237 de 15/09/2026", urn:"urn:lex:br:federal:lei.complementar:2026-09-15;237", ementa:"Altera a Lei Complementar nº 229, de 30 de março de 2026, para incluir o regime especial de tributação para serviços de datacenter, os programas federais de financiamento de ações de apoio às pessoas com câncer e às pessoas com deficiência, bem como a desoneração do Imposto sobre a Renda das Pessoas Jurídicas (IRPJ) e da Contribuição Social sobre o Lucro Líquido (CSLL) das sociedades resseguradoras locais, entre as exceções às regras aplicáveis à concessão de benefícios tributários; e altera a L", arquivo:"federal/leis-complementares/2026/lcp-237-2026-09-15.md"}}, {id:"federal:BR:LC:229/2026", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2026, data:"2026-03-30", numero:"229", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2026-03-30;229", vigente:true, titulo:"Lei Complementar nº 229 de 30/03/2026", urn:"urn:lex:br:federal:lei.complementar:2026-03-30;229", ementa:"Dispõe sobre regras relativas a benefícios tributários e despesas obrigatórias no exercício de 2026.", arquivo:"federal/leis-complementares/2026/lcp-229-2026-03-30.md"}}, {id:"federal:BR:LC:231/2026", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2026, data:"2026-06-16", numero:"231", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2026-06-16;231", vigente:true, titulo:"Lei Complementar nº 231 de 16/06/2026", urn:"urn:lex:br:federal:lei.complementar:2026-06-16;231", ementa:"Altera a Medida Provisória nº 2.156-5, de 24 de agosto de 2001, a Medida Provisória nº 2.157-5, de 24 de agosto de 2001, e a Lei Complementar nº 129, de 8 de janeiro de 2009, para permitir que as cooperativas sejam beneficiárias dos recursos do Fundo de Desenvolvimento do Nordeste (FDNE), do Fundo de Desenvolvimento da Amazônia (FDA) e do Fundo de Desenvolvimento do Centro-Oeste (FDCO).", arquivo:"federal/leis-complementares/2026/lcp-231-2026-06-16.md"}}, {id:"federal:BR:LC:128/2008", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:2008, data:"2008-12-19", numero:"128", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:2008-12-19;128", vigente:true, titulo:"Lei Complementar nº 128 de 19/12/2008", urn:"urn:lex:br:federal:lei.complementar:2008-12-19;128", ementa:"Altera a Lei Complementar nº 123, de 14 de dezembro de 2006, altera as Leis nºs 8.212, de 24 de julho de 1991, 8.213, de 24 de julho de 1991, 10.406, de 10 de janeiro de 2002 - Código Civil, 8.029, de 12 de abril de 1990, e dá outras providências.", arquivo:"federal/leis-complementares/2008/lcp-128-2008-12-19.md"}}, {id:"federal:BR:LC:59/1988", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1988, data:"1988-12-22", numero:"59", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1988-12-22;59", vigente:true, titulo:"Lei Complementar nº 59 de 22/12/1988", urn:"urn:lex:br:federal:lei.complementar:1988-12-22;59", ementa:"Dá nova redação ao § 3º do art. 91 da Lei nº 5.172, de 25 de outubro de 1966 (Código Tributário Nacional).", arquivo:"federal/leis-complementares/1988/lcp-59-1988-12-22.md"}}, {id:"federal:BR:LC:58/1988", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Complementar", vigencia_origem:"revogada=false", ano:1988, data:"1988-01-21", numero:"58", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei.complementar:1988-01-21;58", vigente:true, titulo:"Lei Complementar nº 58 de 21/01/1988", urn:"urn:lex:br:federal:lei.complementar:1988-01-21;58", ementa:"Dispõe sobre aposentadoria voluntária, nas condições que especifica, aos servidores civis que trabalham em estabelecimentos industriais da União, produtores de munições e explosivos.", arquivo:"federal/leis-complementares/1988/lcp-58-1988-01-21.md"}}] AS row
CREATE (n:Norma{id: row.id}) SET n += row.properties SET n:LeiComplementar;
UNWIND [{id:"federal:BR:L:679/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-04-25", numero:"679", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-04-25;679", vigente:true, titulo:"Lei nº 679 de 25/04/1949", urn:"urn:lex:br:federal:lei:1949-04-25;679", ementa:"Concede pensão especial aos herdeiros de Semião Mourão.", arquivo:"federal/leis-ordinarias/1949/lei-679-1949-04-25.md"}}, {id:"federal:BR:L:685/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-04-28", numero:"685", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-04-28;685", vigente:true, titulo:"Lei nº 685 de 28/04/1949", urn:"urn:lex:br:federal:lei:1949-04-28;685", ementa:"Autoriza a abertura de crédito especial para o pagamento da contribuição   do Brasil à Corte Permanente de Arbitragem, em Haia.", arquivo:"federal/leis-ordinarias/1949/lei-685-1949-04-28.md"}}, {id:"federal:BR:L:605/1949", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-01-05", numero:"605", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-01-05;605", vigente:true, titulo:"Lei nº 605 de 05/01/1949", urn:"urn:lex:br:federal:lei:1949-01-05;605", ementa:"Dispõe sobre o repouso semanal remunerado e o pagamento de salário nos dias feriados civis e religiosos.", arquivo:"federal/leis-ordinarias/1949/lei-605-1949-01-05.md"}}, {id:"federal:BR:L:997/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-12-23", numero:"997", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-12-23;997", vigente:true, titulo:"Lei nº 997 de 23/12/1949", urn:"urn:lex:br:federal:lei:1949-12-23;997", ementa:"Autoriza a abertura ao Poder Judiciário de crédito especial para pagamento   de gratificação.", arquivo:"federal/leis-ordinarias/1949/lei-997-1949-12-23.md"}}, {id:"federal:BR:L:700/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-05-14", numero:"700", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-05-14;700", vigente:true, titulo:"Lei nº 700 de 14/05/1949", urn:"urn:lex:br:federal:lei:1949-05-14;700", ementa:"Autoriza a abertura de crédito especial para pagamento de gratificação de   magistério ao Prof. Mário Tarquínio.", arquivo:"federal/leis-ordinarias/1949/lei-700-1949-05-14.md"}}, {id:"federal:BR:L:898/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-10-25", numero:"898", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-10-25;898", vigente:true, titulo:"Lei nº 898 de 25/10/1949", urn:"urn:lex:br:federal:lei:1949-10-25;898", ementa:"Autoriza a abertura, ao Poder Judiciário, de crédito especial para despesa   com aquisição de material.", arquivo:"federal/leis-ordinarias/1949/lei-898-1949-10-25.md"}}, {id:"federal:BR:L:775/1949", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-08-06", numero:"775", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-08-06;775", vigente:true, titulo:"Lei nº 775 de 06/08/1949", urn:"urn:lex:br:federal:lei:1949-08-06;775", ementa:"Dispõe sobre ensino de enfermagem no País e dá outras providências.", arquivo:"federal/leis-ordinarias/1949/lei-775-1949-08-06.md"}}, {id:"federal:BR:L:940/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-12-01", numero:"940", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-12-01;940", vigente:true, titulo:"Lei nº 940 de 01/12/1949", urn:"urn: