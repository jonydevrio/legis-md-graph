990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-12-28", numero:"8145", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-12-28;8145", vigente:true, titulo:"Lei nº 8.145 de 28/12/1990", urn:"urn:lex:br:federal:lei:1990-12-28;8145", ementa:"Autoriza o Poder Executivo a abrir, ao Orçamento Fiscal da União, crédito suplementar no valor de Cr$ 127.120.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1990/lei-8145-1990-12-28.md"}}, {id:"federal:BR:L:7992/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-01-03", numero:"7992", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-01-03;7992", vigente:true, titulo:"Lei nº 7.992 de 03/01/1990", urn:"urn:lex:br:federal:lei:1990-01-03;7992", ementa:"Cria cargos no Quadro de Pessoal da Secretaria do Tribunal Superior do Trabalho, e dá outras providências.", arquivo:"federal/leis-ordinarias/1990/lei-7992-1990-01-03.md"}}, {id:"federal:BR:L:2249/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-06-26", numero:"2249", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-06-26;2249", vigente:true, titulo:"Lei nº 2.249 de 26/06/1954", urn:"urn:lex:br:federal:lei:1954-06-26;2249", ementa:"Modifica o art. 22 e seus parágrafos do Decreto-Lei nº 7.036, de 10 de   novembro de 1944, alterado pela Lei nº 599-A, de 26 de dezembro de   1948.", arquivo:"federal/leis-ordinarias/1954/lei-2249-1954-06-26.md"}}, {id:"federal:BR:L:2212/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-05-31", numero:"2212", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-05-31;2212", vigente:true, titulo:"Lei nº 2.212 de 31/05/1954", urn:"urn:lex:br:federal:lei:1954-05-31;2212", ementa:"Dispõe sobre a aplicação do artigo 2º da Lei nº 705, de 16 de maio de 1949, por que   se regula o provimento de cargos da carreira de Comissário de Polícia do Quadro   Permanente do Ministério da Justiça e Negócios Interiores.", arquivo:"federal/leis-ordinarias/1954/lei-2212-1954-05-31.md"}}, {id:"federal:BR:L:2223/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-06-10", numero:"2223", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-06-10;2223", vigente:true, titulo:"Lei nº 2.223 de 10/06/1954", urn:"urn:lex:br:federal:lei:1954-06-10;2223", ementa:"Concede o auxílio especial de Cr$ 1.000.000,00, às comemorações do   bicentenário da fundação da Paróquia do Triunfo e para conserto geral da   histórica Igreja Matriz da cidade do mesmo nome, no Estado do Rio Grande do   Sul.", arquivo:"federal/leis-ordinarias/1954/lei-2223-1954-06-10.md"}}, {id:"federal:BR:L:2283/1954", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-08-09", numero:"2283", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-08-09;2283", vigente:true, titulo:"Lei nº 2.283 de 09/08/1954", urn:"urn:lex:br:federal:lei:1954-08-09;2283", ementa:"Altera dispositivos da Lei nº 1.316, de 20 de janeiro de 1951 (Código de Vencimentos e Vantagens dos Militares).", arquivo:"federal/leis-ordinarias/1954/lei-2283-1954-08-09.md"}}, {id:"federal:BR:L:2341/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-11-22", numero:"2341", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-11-22;2341", vigente:true, titulo:"Lei nº 2.341 de 22/11/1954", urn:"urn:lex:br:federal:lei:1954-11-22;2341", ementa:"Autoriza o Poder Executivo a financiar operações imobiliárias realizadas   pelo Clube Naval.", arquivo:"federal/leis-ordinarias/1954/lei-2341-1954-11-22.md"}}, {id:"federal:BR:L:2296/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-08-23", numero:"2296", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-08-23;2296", vigente:true, titulo:"Lei nº 2.296 de 23/08/1954", urn:"urn:lex:br:federal:lei:1954-08-23;2296", ementa:"Estabelece a obrigatoriedade para o comércio atacadista e varejista, os   hotéis, restaurantes, boites e casas de pasto, da apresentação à venda de vinho   nacionais.", arquivo:"federal/leis-ordinarias/1954/lei-2296-1954-08-23.md"}}, {id:"federal:BR:L:2155/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-01-02", numero:"2155", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-01-02;2155", vigente:true, titulo:"Lei nº 2.155 de 02/01/1954", urn:"urn:lex:br:federal:lei:1954-01-02;2155", ementa:"Provê sobre a eleição dos Conselhos Fiscais dos Institutos de   Aposentadoria e Pensões.", arquivo:"federal/leis-ordinarias/1954/lei-2155-1954-01-02.md"}}, {id:"federal:BR:L:2369/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-12-09", numero:"2369", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-12-09;2369", vigente:true, titulo:"Lei nº 2.369 de 09/12/1954", urn:"urn:lex:br:federal:lei:1954-12-09;2369", ementa:"Reorganiza as Secretarias do Ministério Público Federal, cria o respectivo   quadro do pessoal, reajusta seus servidores, cargos e vencimentos, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1954/lei-2369-1954-12-09.md"}}, {id:"federal:BR:L:2213/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-06-02", numero:"2213", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-06-02;2213", vigente:true, titulo:"Lei nº 2.213 de 02/06/1954", urn:"urn:lex:br:federal:lei:1954-06-02;2213", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações   Exteriores, o crédito especial de Cr$ 14.000.000,00, para auxiliar as despesas   com a realização do XXXI Congresso Eucaristíco Internacional.", arquivo:"federal/leis-ordinarias/1954/lei-2213-1954-06-02.md"}}, {id:"federal:BR:L:2203/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-04-23", numero:"2203", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-04-23;2203", vigente:true, titulo:"Lei nº 2.203 de 23/04/1954", urn:"urn:lex:br:federal:lei:1954-04-23;2203", ementa:"Concede ;pensão especial de Cr$ 3.000,00 mensais à viúva de Aureliano   Silveira, ex-agente do Imposto de Consumo.", arquivo:"federal/leis-ordinarias/1954/lei-2203-1954-04-23.md"}}, {id:"federal:BR:L:2346/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-11-25", numero:"2346", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-11-25;2346", vigente:true, titulo:"Lei nº 2.346 de 25/11/1954", urn:"urn:lex:br:federal:lei:1954-11-25;2346", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Guerra, o crédito   especial de Cr$ 2.487.026,00, para atender ao pagamento à Administração do Porto   do Rio de Janeiro, corresponde a despesas de permanência de volumes destinados   àquele Ministério.", arquivo:"federal/leis-ordinarias/1954/lei-2346-1954-11-25.md"}}, {id:"federal:BR:L:2227/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-06-14", numero:"2227", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-06-14;2227", vigente:true, titulo:"Lei nº 2.227 de 14/06/1954", urn:"urn:lex:br:federal:lei:1954-06-14;2227", ementa:"Altera o Plano Salte e dispõe sobre a sua execução.", arquivo:"federal/leis-ordinarias/1954/lei-2227-1954-06-14.md"}}, {id:"federal:BR:L:2238/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-06-21", numero:"2238", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-06-21;2238", vigente:true, titulo:"Lei nº 2.238 de 21/06/1954", urn:"urn:lex:br:federal:lei:1954-06-21;2238", ementa:"Revoga o art. 19 e seus parágrafos do Decreto-Lei nº 794, de 19 de   outubro de 1938 (Código de Pesca).", arquivo:"federal/leis-ordinarias/1954/lei-2238-1954-06-21.md"}}, {id:"federal:BR:L:2335/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-11-18", numero:"2335", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-11-18;2335", vigente:true, titulo:"Lei nº 2.335 de 18/11/1954", urn:"urn:lex:br:federal:lei:1954-11-18;2335", ementa:"Concede a pensão especial de Cr$ 2.000,00 mensais a Ezequiel Pompeu   Ribeiro de Siqueira, neto do Tenente Antônio João Ribeiro.", arquivo:"federal/leis-ordinarias/1954/lei-2335-1954-11-18.md"}}, {id:"federal:BR:L:2209/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-05-24", numero:"2209", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-05-24;2209", vigente:true, titulo:"Lei nº 2.209 de 24/05/1954", urn:"urn:lex:br:federal:lei:1954-05-24;2209", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o   crédito especial de Cr$ 14.000.000,00, destinado a atender ao pagamento da   contribuição do Brasil para manutenção do Escritório Técnico de Agricultura,   órgão executor do Acordo para execução de um programa de cooperação agrícola,   firmado entre o Brasil e os Estados Unidos da América.", arquivo:"federal/leis-ordinarias/1954/lei-2209-1954-05-24.md"}}, {id:"federal:BR:L:2326/1954", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-09-20", numero:"2326", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-09-20;2326", vigente:true, titulo:"Lei nº 2.326 de 20/09/1954", urn:"urn:lex:br:federal:lei:1954-09-20;2326", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Guerra, o crédito especial até a importância de Cr$ 150.000.000,00, para pagamento de pensões aos veteranos, às viúvas e aos herdeiros dos ex-combatentes da campanha do Uruguai e da guerra do Paraguai.", arquivo:"federal/leis-ordinarias/1954/lei-2326-1954-09-20.md"}}, {id:"federal:BR:L:2264/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-07-12", numero:"2264", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-07-12;2264", vigente:true, titulo:"Lei nº 2.264 de 12/07/1954", urn:"urn:lex:br:federal:lei:1954-07-12;2264", ementa:"Autoriza o Poder Executivo a adquirir um terreno para construção da Escola   Industrial de Aracaju, Estado de Sergipe.", arquivo:"federal/leis-ordinarias/1954/lei-2264-1954-07-12.md"}}, {id:"federal:BR:L:2372/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-12-16", numero:"2372", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-12-16;2372", vigente:true, titulo:"Lei nº 2.372 de 16/12/1954", urn:"urn:lex:br:federal:lei:1954-12-16;2372", ementa:"Transfere para o Quadro Permanente do Ministério da Guerra, cargo isolado,   de provimento efetivo.", arquivo:"federal/leis-ordinarias/1954/lei-2372-1954-12-16.md"}}, {id:"federal:BR:L:2195/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-03-31", numero:"2195", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-03-31;2195", vigente:true, titulo:"Lei nº 2.195 de 31/03/1954", urn:"urn:lex:br:federal:lei:1954-03-31;2195", ementa:"Autoriza o Poder Executivo a ampliar as concessões em vigor para   exploração do serviço telegráfico interior, por empresas que possuem cabos   submarinos ou subfluviais.", arquivo:"federal/leis-ordinarias/1954/lei-2195-1954-03-31.md"}}, {id:"federal:BR:L:2290/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-08-21", numero:"2290", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-08-21;2290", vigente:true, titulo:"Lei nº 2.290 de 21/08/1954", urn:"urn:lex:br:federal:lei:1954-08-21;2290", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Justiça e Negócios   Interiores, o crédito especial de Cr$ 205.660,80, para pagamento de gratificação   adicional a servidores do mesmo Ministério.", arquivo:"federal/leis-ordinarias/1954/lei-2290-1954-08-21.md"}}, {id:"federal:BR:L:2316/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-09-03", numero:"2316", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-09-03;2316", vigente:true, titulo:"Lei nº 2.316 de 03/09/1954", urn:"urn:lex:br:federal:lei:1954-09-03;2316", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura, o   crédito especial de Cr$ 25.000.000,00, para pagamento, no corrente exercício,   de subvenções a estabelecimentos de ensino superior do pais, na conformidade das   Leis nºs 2.106, de 23 de novembro de 1953, 2152, 2153 e 2154, de 30 de dezembro   de 1953.", arquivo:"federal/leis-ordinarias/1954/lei-2316-1954-09-03.md"}}, {id:"federal:BR:L:2218/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-06-05", numero:"2218", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-06-05;2218", vigente:true, titulo:"Lei nº 2.218 de 05/06/1954", urn:"urn:lex:br:federal:lei:1954-06-05;2218", ementa:"Autoriza o Poder Executivo a abrir pelo Ministério da Marinha, o crédito   especial de Cr$ 321.048.000,00, para ocorrer ao pagamento dos cruzadores \"Saint   Louis\" e \"Philadelphia\", adquiridos do Governo dos Estados Unidos da   América.", arquivo:"federal/leis-ordinarias/1954/lei-2218-1954-06-05.md"}}, {id:"federal:BR:L:2207/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-05-17", numero:"2207", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-05-17;2207", vigente:true, titulo:"Lei nº 2.207 de 17/05/1954", urn:"urn:lex:br:federal:lei:1954-05-17;2207", ementa:"Autoriza o Poder Executivo abrir, pelo Ministério da Educação e Cultura, o   crédito especial de Cr$ 400.000,00 (quatrocentos mil cruzeiros), como auxílio ao   II Congresso Latino Americano de Sociologia.", arquivo:"federal/leis-ordinarias/1954/lei-2207-1954-05-17.md"}}, {id:"federal:BR:L:2318/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-09-10", numero:"2318", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-09-10;2318", vigente:true, titulo:"Lei nº 2.318 de 10/09/1954", urn:"urn:lex:br:federal:lei:1954-09-10;2318", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras   Públicas, o crédito especial de Cr$ 688.000,00 para pagamento da parte restante   da despesa realizada pelo Departamento dos Correios e Telégrafos com aquisição   de uma central telefônica automática.", arquivo:"federal/leis-ordinarias/1954/lei-2318-1954-09-10.md"}}, {id:"federal:BR:L:2336/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-11-19", numero:"2336", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-11-19;2336", vigente:true, titulo:"Lei nº 2.336-A de 19/11/1954", urn:"urn:lex:br:federal:lei:1954-11-19;2336", ementa:"Altera o Quadro de Pessoal do Tribunal Superior do Trabalho, e dá outras providências.", arquivo:"federal/leis-ordinarias/1954/lei-2336-1954-11-19.md"}}, {id:"federal:BR:L:2178/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-02-04", numero:"2178", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-02-04;2178", vigente:true, titulo:"Lei nº 2.178 de 04/02/1954", urn:"urn:lex:br:federal:lei:1954-02-04;2178", ementa:"Autoriza o Tesouro Nacional a garantir empréstimo a ser contraido pela   Companhia Siderúrgica Nacional para ampliar as instalações industriais da Usina   de Volta Redonda.", arquivo:"federal/leis-ordinarias/1954/lei-2178-1954-02-04.md"}}, {id:"federal:BR:L:2182/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-02-09", numero:"2182", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-02-09;2182", vigente:true, titulo:"Lei nº 2.182 de 09/02/1954", urn:"urn:lex:br:federal:lei:1954-02-09;2182", ementa:"Dá a garantia do Tesouro Nacional ao aval do Banco do Brasil S.A. nas   promissórias de responsabilidade do Lóide Brasileiro-Patrimônio   Nacional.", arquivo:"federal/leis-ordinarias/1954/lei-2182-1954-02-09.md"}}, {id:"federal:BR:L:2376/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-12-21", numero:"2376", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-12-21;2376", vigente:true, titulo:"Lei nº 2.376 de 21/12/1954", urn:"urn:lex:br:federal:lei:1954-12-21;2376", ementa:"Revigora, pelo prazo de dois anos, o crédito especial de Cr$   1.000.000.000,00, autorizado pela Lei nº 1.705, de 22 de outubro de 1952, para   ocorrer a despesas de exercícios findos.", arquivo:"federal/leis-ordinarias/1954/lei-2376-1954-12-21.md"}}, {id:"federal:BR:L:2174/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-01-18", numero:"2174", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-01-18;2174", vigente:true, titulo:"Lei nº 2.174 de 18/01/1954", urn:"urn:lex:br:federal:lei:1954-01-18;2174", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito   suplementar de Cr$ 4.500.000,00, em reforço da Verba 3, do anexo n° 19, do   vigente Orçamento (Lei de nº 1.757, de 10 de novembro de 1952).", arquivo:"federal/leis-ordinarias/1954/lei-2174-1954-01-18.md"}}, {id:"federal:BR:L:2304/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-08-30", numero:"2304", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-08-30;2304", vigente:true, titulo:"Lei nº 2.304 de 30/08/1954", urn:"urn:lex:br:federal:lei:1954-08-30;2304", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras   Públicas, o crédito especial de Cr$ 52.707,50, para regularizar o pagamento de   gratificação a servidores do Departamento de Administração do mesmo   Ministério.", arquivo:"federal/leis-ordinarias/1954/lei-2304-1954-08-30.md"}}, {id:"federal:BR:L:2342/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-11-25", numero:"2342", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-11-25;2342", vigente:true, titulo:"Lei nº 2.342 de 25/11/1954", urn:"urn:lex:br:federal:lei:1954-11-25;2342", ementa:"Dispõe sobre a cooperação financeira da União em favor do ensino de grau   médio.", arquivo:"federal/leis-ordinarias/1954/lei-2342-1954-11-25.md"}}, {id:"federal:BR:L:2322/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-09-20", numero:"2322", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-09-20;2322", vigente:true, titulo:"Lei nº 2.322 de 20/09/1954", urn:"urn:lex:br:federal:lei:1954-09-20;2322", ementa:"Concede isenção de direitos de importação, impostos de consumo e taxas   aduaneiras para uma imagem destinada à Igreja de Nossa Senhora da Ajuda de   Petrópolis.", arquivo:"federal/leis-ordinarias/1954/lei-2322-1954-09-20.md"}}, {id:"federal:BR:L:2190/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-03-05", numero:"2190", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-03-05;2190", vigente:true, titulo:"Lei nº 2.190 de 05/03/1954", urn:"urn:lex:br:federal:lei:1954-03-05;2190", ementa:"Modifica o art. 7º da Lei nº 1.815, de 18 de fevereiro de   1953.", arquivo:"federal/leis-ordinarias/1954/lei-2190-1954-03-05.md"}}, {id:"federal:BR:L:2332/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-11-08", numero:"2332", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-11-08;2332", vigente:true, titulo:"Lei nº 2.332 de 08/11/1954", urn:"urn:lex:br:federal:lei:1954-11-08;2332", ementa:"Modifica o art. 2º da Lei nº 1.050, de 3 de janeiro de 1950.", arquivo:"federal/leis-ordinarias/1954/lei-2332-1954-11-08.md"}}, {id:"federal:BR:L:2242/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-06-22", numero:"2242", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-06-22;2242", vigente:true, titulo:"Lei nº 2.242 de 22/06/1954", urn:"urn:lex:br:federal:lei:1954-06-22;2242", ementa:"Concede a inclusão da Escola de Medicina e Cirurgia do Rio de Janeiro na   categoria de estabelecimentos subvencionados pelo Governo Federal.", arquivo:"federal/leis-ordinarias/1954/lei-2242-1954-06-22.md"}}, {id:"federal:BR:L:2253/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-07-01", numero:"2253", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-07-01;2253", vigente:true, titulo:"Lei nº 2.253 de 01/07/1954", urn:"urn:lex:br:federal:lei:1954-07-01;2253", ementa:"Isenta de pagamento de direitos de importação e taxas aduaneiras, exceto a   de previdência social, materiais destinados à instalação do Hospital Barão de   Lucena, no Estado de Pernambuco.", arquivo:"federal/leis-ordinarias/1954/lei-2253-1954-07-01.md"}}, {id:"federal:BR:L:2225/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-06-12", numero:"2225", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-06-12;2225", vigente:true, titulo:"Lei nº 2.225 de 12/06/1954", urn:"urn:lex:br:federal:lei:1954-06-12;2225", ementa:"Cria a Medalha Naval de Serviços Distintos, e dá outras providências.", arquivo:"federal/leis-ordinarias/1954/lei-2225-1954-06-12.md"}}, {id:"federal:BR:L:2350/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-11-26", numero:"2350", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-11-26;2350", vigente:true, titulo:"Lei nº 2.350 de 26/11/1954", urn:"urn:lex:br:federal:lei:1954-11-26;2350", ementa:"Autoriza o Poder Executivo a abrir, ao Poder Judiciário - Justiça do   Trabalho - o crédito especial de Cr$ 96.000,00 para pagamento de gratificação de   representação aos presidentes dos Tribunais Regionais do Trabalho.", arquivo:"federal/leis-ordinarias/1954/lei-2350-1954-11-26.md"}}, {id:"federal:BR:L:2338/1954", properties:{esfe