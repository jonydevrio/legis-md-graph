.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2009/lei-12045-2009-10-09.md"}}, {id:"federal:BR:L:11995/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-07-27", numero:"11995", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-07-27;11995", vigente:true, titulo:"Lei nº 11.995 de 27/07/2009", urn:"urn:lex:br:federal:lei:2009-07-27;11995", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério da Fazenda, crédito suplementar no valor de R$ 501.561.242,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2009/lei-11995-2009-07-27.md"}}, {id:"federal:BR:L:12064/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-10-29", numero:"12064", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-10-29;12064", vigente:true, titulo:"Lei nº 12.064 de 29/10/2009", urn:"urn:lex:br:federal:lei:2009-10-29;12064", ementa:"Dispõe sobre a criação do Dia Nacional de Combate ao Trabalho Escravo, bem como da Semana Nacional de Combate ao Trabalho Escravo.", arquivo:"federal/leis-ordinarias/2009/lei-12064-2009-10-29.md"}}, {id:"federal:BR:L:12109/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-09", numero:"12109", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-09;12109", vigente:true, titulo:"Lei nº 12.109 de 09/12/2009", urn:"urn:lex:br:federal:lei:2009-12-09;12109", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério da Agricultura, Pecuária e Abastecimento, crédito suplementar no valor de R$ 90.000.000,00, para reforço de dotação constante da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2009/lei-12109-2009-12-09.md"}}, {id:"federal:BR:L:12016/2009", properties:{esfera: