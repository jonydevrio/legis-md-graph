as.leg.br/?urn=urn:lex:br:federal:lei:2004-12-29;11048", vigente:true, titulo:"Lei nº 11.048 de 29/12/2004", urn:"urn:lex:br:federal:lei:2004-12-29;11048", ementa:"Abre ao Orçamento de Investimento, para 2004, em favor de empresas do Grupo ELETROBRÁS, crédito especial no valor total de R$ 139.346.339,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2004/lei-11048-2004-12-29.md"}}, {id:"federal:BR:L:10905/2004", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2004, data:"2004-07-15", numero:"10905", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2004-07-15;10905", vigente:true, titulo:"Lei nº 10.905 de 15/07/2004", urn:"urn:lex:br:federal:lei:2004-07-15;10905", ementa:"Amplia o limite a que se refere o item III.4 do Anexo VII da Lei nº 10.837, de 16 de janeiro de 2004.", arquivo:"federal/leis-ordinarias/2004/lei-10905-2004-07-15.md"}}, {id:"federal:BR:L:7255/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-11-26", numero:"7255", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-11-26;7255", vigente:true, titulo:"Lei nº 7.255 de 26/11/1984", urn:"urn:lex:br:federal:lei:1984-11-26;7255", ementa:"Autoriza a reversão ao Município de São Francisco do Sul, Estado de Santa   Catarina, do terreno que menciona.", arquivo:"federal/leis-ordinarias/1984/lei-7255-1984-11-26.md"}}, {id:"federal:BR:L:7194/1984", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-06-11", numero:"7194", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-06-11;7194", vigente:true, titulo:"Lei nº 7.194 de 11/06/1984", urn:"urn:lex:br:federal:lei:1984-06-11;7194", ementa:"Autoriza a inclusão de recursos nos Orçamentos da União, e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7194-1984-06-11.md"}}, {id:"federal:BR:L:7296/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-20", numero:"7296", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-20;7296", vigente:true, titulo:"Lei nº 7.296 de 20/12/1984", urn:"urn:lex:br:federal:lei:1984-12-20;7296", ementa:"Concede pensão especial a Inaldo Raul de Araújo e dá outras   providências.", arquivo:"federal/leis-ordinarias/1984/lei-7296-1984-12-20.md"}}, {id:"federal:BR:L:7279/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-10", numero:"7279", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-10;7279", vigente:true, titulo:"Lei nº 7.279 de 10/12/1984", urn:"urn:lex:br:federal:lei:1984-12-10;7279", ementa:"Autoriza o Governo do Distrito Federal a contratar operação de crédito no valor de Cr$ 169.375.407.930 (cento e sessenta e nove bilhões, trezentos e setenta e cinco milhões, quatrocentos e sete mil, novecentos e trinta cruzeiros).", arquivo:"federal/leis-ordinarias/1984/lei-7279-1984-12-10.md"}}, {id:"federal:BR:L:7208/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-07-05", numero:"7208", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-07-05;7208", vigente:true, titulo:"Lei nº 7.208 de 05/07/1984", urn:"urn:lex:br:federal:lei:1984-07-05;7208", ementa:"Dispõe sobre a escala de níveis de classificação dos cargos de provimento   em comissão, integrantes do Grupo-Direção e Assessoramento Superiores, do Quadro   Permanente da Secretaria-Geral do Tribunal de Contas da União, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1984/lei-7208-1984-07-05.md"}}, {id:"federal:BR:L:7259/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-03", numero:"7259", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-03;7259", vigente:true, titulo:"Lei nº 7.259 de 03/12/1984", urn:"urn:lex:br:federal:lei:1984-12-03;7259", ementa:"Reajusta os valores de vencimentos, salários e proventos dos servidores da   Câmara dos Deputados, e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7259-1984-12-03.md"}}, {id:"federal:BR:L:7235/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-10-29", numero:"7235", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-10-29;7235", vigente:true, titulo:"Lei nº 7.235 de 29/10/1984", urn:"urn:lex:br:federal:lei:1984-10-29;7235", ementa:"Altera a estrutura da Categoria Funcional de Bibliotecário, do   Grupo-Outras Atividades de Nível Superior, de que trata a Lei nº 5.920, de 19 de   setembro de 1973, e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7235-1984-10-29.md"}}, {id:"federal:BR:L:7218/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-09-19", numero:"7218", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-09-19;7218", vigente:true, titulo:"Lei nº 7.218 de 19/09/1984", urn:"urn:lex:br:federal:lei:1984-09-19;7218", ementa:"Altera a estrutura e a denominação da Categoria Funcional de Técnico em   Reabilitação, do Grupo-Outras Atividades de Nível Superior, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1984/lei-7218-1984-09-19.md"}}, {id:"federal:BR:L:7212/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-07-20", numero:"7212", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-07-20;7212", vigente:true, titulo:"Lei nº 7.212 de 20/07/1984", urn:"urn:lex:br:federal:lei:1984-07-20;7212", ementa:"Institui o dia 1º de outubro como o \" Dia Nacional do Vereador   \".", arquivo:"federal/leis-ordinarias/1984/lei-7212-1984-07-20.md"}}, {id:"federal:BR:L:7260/1984", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-03", numero:"7260", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-03;7260", vigente:true, titulo:"Lei nº 7.260 de 03/12/1984", urn:"urn:lex:br:federal:lei:1984-12-03;7260", ementa:"Reajusta os atuais valores de vencimentos e proventos dos servidores ativos e inativos do Senado Federal, e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7260-1984-12-03.md"}}, {id:"federal:BR:L:7241/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-11-05", numero:"7241", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-11-05;7241", vigente:true, titulo:"Lei nº 7.241 de 05/11/1984", urn:"urn:lex:br:federal:lei:1984-11-05;7241", ementa:"Concede pensão especial ao Frei José Maria Carneiro de Lima -   OSM.", arquivo:"federal/leis-ordinarias/1984/lei-7241-1984-11-05.md"}}, {id:"federal:BR:L:7271/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-10", numero:"7271", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-10;7271", vigente:true, titulo:"Lei nº 7.271 de 10/12/1984", urn:"urn:lex:br:federal:lei:1984-12-10;7271", ementa:"Autoriza a reversão ao Município de Rio Pomba, Estado de Minas Gerais, do   imóvel que menciona.", arquivo:"federal/leis-ordinarias/1984/lei-7271-1984-12-10.md"}}, {id:"federal:BR:L:7250/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-11-14", numero:"7250", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-11-14;7250", vigente:true, titulo:"Lei nº 7.250 de 14/11/1984", urn:"urn:lex:br:federal:lei:1984-11-14;7250", ementa:"Acrescenta parágrafo ao artigo 1º da Lei nº 883, de 21 de outubro de 1949, que dispõe sobre o reconhecimento de filhos ilegítimos.", arquivo:"federal/leis-ordinarias/1984/lei-7250-1984-11-14.md"}}, {id:"federal:BR:L:7288/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-18", numero:"7288", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-18;7288", vigente:true, titulo:"Lei nº 7.288 de 18/12/1984", urn:"urn:lex:br:federal:lei:1984-12-18;7288", ementa:"Acrescenta parágrafo único ao art. 3º da Lei nº 1.060, de 5 de fevereiro de 1950, que trata da assistência judiciária aos necessitados.", arquivo:"federal/leis-ordinarias/1984/lei-7288-1984-12-18.md"}}, {id:"federal:BR:L:7223/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-10-02", numero:"7223", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-10-02;7223", vigente:true, titulo:"Lei nº 7.223 de 02/10/1984", urn:"urn:lex:br:federal:lei:1984-10-02;7223", ementa:"Modifica a redação do § 4º do art. 543 da Consolidação das Leis do Trabalho.", arquivo:"federal/leis-ordinarias/1984/lei-7223-1984-10-02.md"}}, {id:"federal:BR:L:7196/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-06-13", numero:"7196", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-06-13;7196", vigente:true, titulo:"Lei nº 7.196 de 13/06/1984", urn:"urn:lex:br:federal:lei:1984-06-13;7196", ementa:"Institui o Plano Nacional de Moradia - PLAMO, destinado a atender as   necessidades de moradia das pessoas de renda mensal regular até 5 (cinco)   salários mínimos e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7196-1984-06-13.md"}}, {id:"federal:BR:L:7257/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-11-28", numero:"7257", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-11-28;7257", vigente:true, titulo:"Lei nº 7.257 de 28/11/1984", urn:"urn:lex:br:federal:lei:1984-11-28;7257", ementa:"Fixa o efetivo da Polícia Militar do Território Federal de Roraima, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7257-1984-11-28.md"}}, {id:"federal:BR:L:7193/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-06-07", numero:"7193", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-06-07;7193", vigente:true, titulo:"Lei nº 7.193 de 07/06/1984", urn:"urn:lex:br:federal:lei:1984-06-07;7193", ementa:"Introduz alteração na Lei n° ;6.251, de 08 de outubro de 1975, que   \"institui normas gerais sobre desportos\".", arquivo:"federal/leis-ordinarias/1984/lei-7193-1984-06-07.md"}}, {id:"federal:BR:L:7230/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-10-22", numero:"7230", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-10-22;7230", vigente:true, titulo:"Lei nº 7.230 de 22/10/1984", urn:"urn:lex:br:federal:lei:1984-10-22;7230", ementa:"Autoriza o Instituto Nacional de Colonização e Reforma Agrária - INCRA a   doar o imóvel que menciona.", arquivo:"federal/leis-ordinarias/1984/lei-7230-1984-10-22.md"}}, {id:"federal:BR:L:7292/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-19", numero:"7292", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-19;7292", vigente:true, titulo:"Lei nº 7.292 de 19/12/1984", urn:"urn:lex:br:federal:lei:1984-12-19;7292", ementa:"Autoriza o Departamento Nacional de Registro do Comércio a estabelecer   modelos e cláusulas padronizadas destinadas a simplificar a constituição de   sociedades mercantis.", arquivo:"federal/leis-ordinarias/1984/lei-7292-1984-12-19.md"}}, {id:"federal:BR:L:7229/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-10-22", numero:"7229", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-10-22;7229", vigente:true, titulo:"Lei nº 7.229 de 22/10/1984", urn:"urn:lex:br:federal:lei:1984-10-22;7229", ementa:"Fixa o efetivo da Polícia Militar do Território Federal do Amapá, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7229-1984-10-22.md"}}, {id:"federal:BR:L:7204/1984", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-07-05", numero:"7204", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-07-05;7204", vigente:true, titulo:"Lei nº 7.204 de 05/07/1984", urn:"urn:lex:br:federal:lei:1984-07-05;7204", ementa:"Reajusta os atuais valores de vencimentos e proventos dos servidores ativos e inativos do Senado Federal, bem como os das pensões, e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7204-1984-07-05.md"}}, {id:"federal:BR:L:7211/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-07-16", numero:"7211", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-07-16;7211", vigente:true, titulo:"Lei nº 7.211 de 16/07/1984", urn:"urn:lex:br:federal:lei:1984-07-16;7211", ementa:"Autoriza a admissão, pela Caixa Econômica Federal, dos empregados das   extintas empresas Delfin Rio S.A. Crédito Imobiliário e Delfin S.A. Crédito   Imobiliário, em situação de liquidação extrajudicial, decretada pelo Banco   Central do Brasil, e dá outras providências", arquivo:"federal/leis-ordinarias/1984/lei-7211-1984-07-16.md"}}, {id:"federal:BR:L:7198/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-06-19", numero:"7198", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-06-19;7198", vigente:true, titulo:"Lei nº 7.198 de 19/06/1984", urn:"urn:lex:br:federal:lei:1984-06-19;7198", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério da Educação e Cultura, crédito especial até o limite de Cr$ 3.816.400.000,00 ( três bilhões, oitocentos e dezesseis milhões e quatrocentos mil cruzeiros ) para o fim que especifica.", arquivo:"federal/leis-ordinarias/1984/lei-7198-1984-06-19.md"}}, {id:"federal:BR:L:7246/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-11-13", numero:"7246", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-11-13;7246", vigente:true, titulo:"Lei nº 7.246 de 13/11/1984", urn:"urn:lex:br:federal:lei:1984-11-13;7246", ementa:"Dispõe sobre a criação de cargos no Quadro Permanente das Secretarias das   Seções Judiciárias da Justiça Federal de Primeira Instância, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1984/lei-7246-1984-11-13.md"}}, {id:"federal:BR:L:7202/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-06-26", numero:"7202", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-06-26;7202", vigente:true, titulo:"Lei nº 7.202 de 26/06/1984", urn:"urn:lex:br:federal:lei:1984-06-26;7202", ementa:"Dispõe sobre a progressão funcional a que se refere a Lei nº 5.920, de 19   de setembro de 1973.", arquivo:"federal/leis-ordinarias/1984/lei-7202-1984-06-26.md"}}, {id:"federal:BR:L:7227/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", 