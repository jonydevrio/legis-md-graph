996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1996, data:"1996-05-30", numero:"9280", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-05-30;9280", vigente:true, titulo:"Lei nº 9.280 de 30/05/1996", urn:"urn:lex:br:federal:lei:1996-05-30;9280", ementa:"Acrescenta um § 2º ao art. 1.031 do Código de Processo Civil, transformando o atual parágrafo único em § 1º.", arquivo:"federal/leis-ordinarias/1996/lei-9280-1996-05-30.md"}}, {id:"federal:BR:L:9362/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1996, data:"1996-12-13", numero:"9362", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-12-13;9362", vigente:true, titulo:"Lei nº 9.362 de 13/12/1996", urn:"urn:lex:br:federal:lei:1996-12-13;9362", ementa:"Dispõe sobre medidas reguladoras do abastecimento do mercado interno de produtos do setor sucroalcooleiro", arquivo:"federal/leis-ordinarias/1996/lei-9362-1996-12-13.md"}}, {id:"federal:BR:L:9265/1996", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1996, data:"1996-02-12", numero:"9265", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-02-12;9265", vigente:true, titulo:"Lei nº 9.265 de 12/02/1996", urn:"urn:lex:br:federal:lei:1996-02-12;9265", ementa:"Regulamenta o inciso LXXVII do art. 5º da Constituição, dispondo sobre a gratuidade dos atos necessários ao exercício da cidadania.", arquivo:"federal/leis-ordinarias/1996/lei-9265-1996-02-12.md"}}, {id:"federal:BR:L:9302/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1996, data:"1996-09-04", numero:"9302", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-09-04;9302", vigente:true, titulo:"Lei nº 9.302 de 04/09/1996", urn:"urn:lex:br:federal:lei:1996-09-04;9302", ementa: