quivo:"federal/leis-ordinarias/1959/lei-3567-1959-06-11.md"}}, {id:"federal:BR:L:3659/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-11-13", numero:"3659", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-11-13;3659", vigente:true, titulo:"Lei nº 3.659 de 13/11/1959", urn:"urn:lex:br:federal:lei:1959-11-13;3659", ementa:"Concede a pensão especial de Cr$ 5.000,00 mensais a Maria Oliveira   Mendonça Sarmento, viúva do Dr. José Paulino de Albuquerque   Sarmento.", arquivo:"federal/leis-ordinarias/1959/lei-3659-1959-11-13.md"}}, {id:"federal:BR:L:3620/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-08-28", numero:"3620", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-08-28;3620", vigente:true, titulo:"Lei nº 3.620 de 28/08/1959", urn:"urn:lex:br:federal:lei:1959-08-28;3620", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Justiça e Negócios   Interiores, o crédito especial de Cr$ 5.000.000,00, para atender a despesas com   os trabalhos desenvolvidos pela Comissão de Supervisão de Órgãos   Autônomos.", arquivo:"federal/leis-ordinarias/1959/lei-3620-1959-08-28.md"}}, {id:"federal:BR:L:3553/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-04-27", numero:"3553", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-04-27;3553", vigente:true, titulo:"Lei nº 3.553 de 27/04/1959", urn:"urn:lex:br:federal:lei:1959-04-27;3553", ementa:"Altera a legislação do Imposto de Renda.", arquivo:"federal/leis-ordinarias/1959/lei-3553-1959-04-27.md"}}, {id:"federal:BR:L:3604/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-08-08", numero:"3604", fonte:"https://normas.leg.br/?urn=urn: