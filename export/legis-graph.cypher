?urn=urn:lex:br:federal:lei:1956-12-21;3050", vigente:true, titulo:"Lei nº 3.050 de 21/12/1956", urn:"urn:lex:br:federal:lei:1956-12-21;3050", ementa:"Equipara a função de administrador das Estradas de Ferro Leopoldina,   Santos a Jundiaí e Ilhéus, quando exercida por funcionário público nomeado pelo   Presidente da República, aos cargos em comissão de que trata o art. 180 do   Estatuto dos Funcionários Públicos Civis da União, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1956/lei-3050-1956-12-21.md"}}, {id:"federal:BR:L:2880/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-09-21", numero:"2880", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-09-21;2880", vigente:true, titulo:"Lei nº 2.880 de 21/09/1956", urn:"urn:lex:br:federal:lei:1956-09-21;2880", ementa:"Abre ao Ministério da Justiça e Negócios Interiores o crédito especial de   Cr$ 6.108,60 para atender a despesas com o tratamento e transporte do   funcionário do Tribunal Regional Eleitoral do Estado do Amazonas, Antônio   Pinheiro de Lima.", arquivo:"federal/leis-ordinarias/1956/lei-2880-1956-09-21.md"}}, {id:"federal:BR:L:2954/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-17", numero:"2954", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-17;2954", vigente:true, titulo:"Lei nº 2.954 de 17/11/1956", urn:"urn:lex:br:federal:lei:1956-11-17;2954", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Saúde, o crédito   especial de Cr$ 28.000.000,00, destinado ao pagamento da dívida contraída pela   Associação Paulista de Combate ao Câncer.", arquivo:"federal/leis-ordinarias/1956/lei-2954-1956-11-17.md"}}, {id:"federal:BR:L:2986/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-30", numero:"2986", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-30;2986", vigente:true, titulo:"Lei nº 2.986 de 30/11/1956", urn:"urn:lex:br:federal:lei:1956-11-30;2986", ementa:"Concede o auxílio especial de Cr$ 300.000,00 ao tenente José Natividade   Rocha para sua viagem e tratamento.", arquivo:"federal/leis-ordinarias/1956/lei-2986-1956-11-30.md"}}, {id:"federal:BR:L:2771/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-05-08", numero:"2771", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-05-08;2771", vigente:true, titulo:"Lei nº 2.771 de 08/05/1956", urn:"urn:lex:br:federal:lei:1956-05-08;2771", ementa:"Autoriza o Poder Executivo a doar à Associação Rural Arrôio do Meio e à Sociedade Divina Providência os bens situados na cidade de Arrôio do Meio, Estado do Rio Grande do Sul, havidos por arrecadação da herança jacente de Agnes Lammel Zenkner.", arquivo:"federal/leis-ordinarias/1956/lei-2771-1956-05-08.md"}}, {id:"federal:BR:L:3003/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-14", numero:"3003", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-14;3003", vigente:true, titulo:"Lei nº 3.003 de 14/12/1956", urn:"urn:lex:br:federal:lei:1956-12-14;3003", ementa:"Autoriza o Poder Executivo a abrir ao Ministério da Saúde, o crédito   suplementar de Cr$ 45.000.000,00 para o fim que especifica.", arquivo:"federal/leis-ordinarias/1956/lei-3003-1956-12-14.md"}}, {id:"federal:BR:L:2834/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-07-24", numero:"2834", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-07-24;2834", vigente:true, titulo:"Lei nº 2.834 de 24/07/1956", urn:"urn:lex:br:federal:lei:1956-07-24;2834", ementa:"Concede a inclusão da Escola de Sociologia e Política de São Paulo entre os estabelecimentos subvencionados pelo Governo Federal.", arquivo:"federal/leis-ordinarias/1956/lei-2834-1956-07-24.md"}}, {id:"federal:BR:L:2895/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-05", numero:"2895", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-05;2895", vigente:true, titulo:"Lei nº 2.895 de 05/10/1956", urn:"urn:lex:br:federal:lei:1956-10-05;2895", ementa:"Autoriza o Poder Executivo a abrir ao Poder   Judiciário - Supremo Tribunal Militar - o crédito especial de Cr$ 416.712,00   para atender ao pagamento de vencimentos e adicionais, no exercício de 1956, aos   advogados de 2ª entrância da Justiça Militar, Renato Dardeau de Albuquerque e   Alfredo Ribeiro Sacramento.", arquivo:"federal/leis-ordinarias/1956/lei-2895-1956-10-05.md"}}, {id:"federal:BR:L:2719/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-01-28", numero:"2719", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-01-28;2719", vigente:true, titulo:"Lei nº 2.719 de 28/01/1956", urn:"urn:lex:br:federal:lei:1956-01-28;2719", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça do   Trabalho - crédito especial para pagamento de gratificação adicional, diferença   de vencimentos e diferença de gratificação adicional de membro do Tribunal   Superior do Trabalho e funcionário de sua Secretaria.", arquivo:"federal/leis-ordinarias/1956/lei-2719-1956-01-28.md"}}, {id:"federal:BR:L:2737/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-02-18", numero:"2737", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-02-18;2737", vigente:true, titulo:"Lei nº 2.737 de 18/02/1956", urn:"urn:lex:br:federal:lei:1956-02-18;2737", ementa:"Concede a inclusão da Faculdade de Filosofia do Recife da Universidade do   Recife entre os estabelecimentos subvencionados pelo Governo   Federal.", arquivo:"federal/leis-ordinarias/1956/lei-2737-1956-02-18.md"}}, {id:"federal:BR:L:2755/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-04-16", numero:"2755", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-04-16;2755", vigente:true, titulo:"Lei nº 2.755 de 16/04/1956", urn:"urn:lex:br:federal:lei:1956-04-16;2755", ementa:"Dispõe sôbre a contribuição de segurados aos Institutos de   Previdência.", arquivo:"federal/leis-ordinarias/1956/lei-2755-1956-04-16.md"}}, {id:"federal:BR:L:2816/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-07-06", numero:"2816", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-07-06;2816", vigente:true, titulo:"Lei nº 2.816 de 06/07/1956", urn:"urn:lex:br:federal:lei:1956-07-06;2816", ementa:"Modifica os arts. 517 e 523 do Código de Processo Civil.", arquivo:"federal/leis-ordinarias/1956/lei-2816-1956-07-06.md"}}, {id:"federal:BR:L:2996/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-10", numero:"2996", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-10;2996", vigente:true, titulo:"Lei nº 2.996 de 10/12/1956", urn:"urn:lex:br:federal:lei:1956-12-10;2996", ementa:"Estima a Receita e fixa a Despesa da União para o exercício de 1957.", arquivo:"federal/leis-ordinarias/1956/lei-2996-1956-12-10.md"}}, {id:"federal:BR:L:2850/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-08-25", numero:"2850", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-08-25;2850", vigente:true, titulo:"Lei nº 2.850 de 25/08/1956", urn:"urn:lex:br:federal:lei:1956-08-25;2850", ementa:"Modifica o art. 300 da Lei n.º 1.316, de 20 de janeiro de 1951 (Código de Vencimentos e Vantagens dos Militares).", arquivo:"federal/leis-ordinarias/1956/lei-2850-1956-08-25.md"}}, {id:"federal:BR:L:2861/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-09-04", numero:"2861", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-09-04;2861", vigente:true, titulo:"Lei nº 2.861 de 04/09/1956", urn:"urn:lex:br:federal:lei:1956-09-04;2861", ementa:"Autoriza o Poder Executivo a conceder ao professor   Manuel Carneiro de Souza Bandeira Filho os proventos e vantagens de professor   catedrático da Universidade do Brasil.", arquivo:"federal/leis-ordinarias/1956/lei-2861-1956-09-04.md"}}, {id:"federal:BR:L:2836/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-07-31", numero:"2836", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-07-31;2836", vigente:true, titulo:"Lei nº 2.836 de 31/07/1956", urn:"urn:lex:br:federal:lei:1956-07-31;2836", ementa:"Autoriza o Poder Executivo a abrir ao Conselho Nacional de Águas e Energia   Elétrica o crédito especial de Cr$ 174.140,80 para atender ao pagamento de   gratificações aos engenheiros lotados naquele Conselho.", arquivo:"federal/leis-ordinarias/1956/lei-2836-1956-07-31.md"}}, {id:"federal:BR:L:2824/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-07-16", numero:"2824", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-07-16;2824", vigente:true, titulo:"Lei nº 2.824 de 16/07/1956", urn:"urn:lex:br:federal:lei:1956-07-16;2824", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 1.750.000,00, como auxílio à Escola Superior de   Química do Paraná.", arquivo:"federal/leis-ordinarias/1956/lei-2824-1956-07-16.md"}}, {id:"federal:BR:L:2757/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-04-23", numero:"2757", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-04-23;2757", vigente:true, titulo:"Lei nº 2.757 de 23/04/1956", urn:"urn:lex:br:federal:lei:1956-04-23;2757", ementa:"Dispõe sôbre a situação dos empregados porteiros, zeladores, faxineiros e serventes de prédios de apartamentos residenciais.", arquivo:"federal/leis-ordinarias/1956/lei-2757-1956-04-23.md"}}, {id:"federal:BR:L:2768/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-05-02", numero:"2768", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-05-02;2768", vigente:true, titulo:"Lei nº 2.768 de 02/05/1956", urn:"urn:lex:br:federal:lei:1956-05-02;2768", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito   extraordinário, que poderá ser utilizado até o limite de Cr$ 70.000.000,00 para   auxílio e indenização de prejuízos ocasionados por fatores naturais em   municípios dos Estados de São Paulo, Minas Gerais, Paraíba, Rio de Janeiro e Rio   Grande do Sul.", arquivo:"federal/leis-ordinarias/1956/lei-2768-1956-05-02.md"}}, {id:"federal:BR:L:3041/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-21", numero:"3041", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-21;3041", vigente:true, titulo:"Lei nº 3.041 de 21/12/1956", urn:"urn:lex:br:federal:lei:1956-12-21;3041", ementa:"Abre pelo Ministério da Viação e Obras Públicas o crédito especial de Cr$   60.000.000,00, destinado à construção de uma ponte sobre o rio Paraná, ligando   os Estados de São Paulo e Mato Grosso, e dá outras providências", arquivo:"federal/leis-ordinarias/1956/lei-3041-1956-12-21.md"}}, {id:"federal:BR:L:2783/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-05-14", numero:"2783", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-05-14;2783", vigente:true, titulo:"Lei nº 2.783 de 14/05/1956", urn:"urn:lex:br:federal:lei:1956-05-14;2783", ementa:"Abre ao Congresso Nacional - Câmara dos Deputados - o crédito suplementar   de Cr$ 67.790.410,00 para pagamento de despesas decorrentes da Resolução n.º 58,   de 1956.", arquivo:"federal/leis-ordinarias/1956/lei-2783-1956-05-14.md"}}, {id:"federal:BR:L:2730/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-02-17", numero:"2730", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-02-17;2730", vigente:true, titulo:"Lei nº 2.730 de 17/02/1956", urn:"urn:lex:br:federal:lei:1956-02-17;2730", ementa:"Acrescenta mais um parágrafo ao artigo 45 da Lei nº 217, de 15 de janeiro   de 1948 ( Lei Orgânica do Distrito Federal ).", arquivo:"federal/leis-ordinarias/1956/lei-2730-1956-02-17.md"}}, {id:"federal:BR:L:2855/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-08-28", numero:"2855", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-08-28;2855", vigente:true, titulo:"Lei nº 2.855 de 28/08/1956", urn:"urn:lex:br:federal:lei:1956-08-28;2855", ementa:"Restitui ao patrimônio do Estado de Minas Gerais, a propriedade de imóvel   doado à União pelo mesmo Estado, em 1912, situado na cidade de Belo Horizonte, e   dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2855-1956-08-28.md"}}, {id:"federal:BR:L:3033/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-19", numero:"3033", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-19;3033", vigente:true, titulo:"Lei nº 3.033 de 19/12/1956", urn:"urn:lex:br:federal:lei:1956-12-19;3033", ementa:"Autoriza a abertura de créditos suplementares que especifica, no total de   Cr$ 6.038.225.736,20.", arquivo:"federal/leis-ordinarias/1956/lei-3033-1956-12-19.md"}}, {id:"federal:BR:L:2925/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-21", numero:"2925", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-21;2925", vigente:true, titulo:"Lei nº 2.925 de 21/10/1956", urn:"urn:lex:br:federal:lei:1956-10-21;2925", ementa:"Autoriza o Poder Executivo a abrir o crédito especial   de Cr$ 1.000.000,00 para a reconstrução dos edifícios em que funcionavam as   obras educacionais e sociais da paróquia de Iraputã, município de Itaiópolis,   Estado de Santa Catarina.", arquivo:"federal/leis-ordinarias/1956/lei-2925-1956-10-21.md"}}, {id:"federal:BR:L:2873/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-09-18", numero:"2873", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-09-18;2873", vigente:true, titulo:"Lei nº 2.873 de 18/09/1956", urn:"urn:lex:br:federal:lei:1956-09-18;2873", ementa:"Modifica o § 3º do art. 17, o parágrafo único do   art.19 e o art. 44 do Decreto-Lei nº 7.036, de 10 de novembro de 1944 (Reforma   da Lei de Acidentes do Trabalho).", arquivo:"federal/leis-ordinarias/1956/lei-2873-1956-09-18.md"}}, {id:"federal:BR:L:3017/1956", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-17", numero:"3017", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-17;3017", vigente:true, titulo:"Lei nº 3.017 de 17/12/1956", urn:"urn:lex:br:federal:lei:1956-12-17;3017", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 500.000,00, destinado a auxiliar as despesas com o   comparecimento da Delegação da Cruz Vermelha Brasileira à 19º Conferencia da   Cruz Vermelha Internacional.", arquivo:"federal/leis-ordinarias/1956/lei-3017-1956-12-17.md"}}, {id:"federal:BR:L:2720/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-01-28", numero:"2720", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-01-28;2720", vigente:true, titulo:"Lei nº 2.720 de 28/01/1956", urn:"urn:lex:br:federal:lei:1956-01-28;2720", ementa:"Denomina Mello Vianna o aeroporto de Três Corações, no Estado de Minas   Gerais.", arquivo:"federal/leis-ordinarias/1956/lei-2720-1956-01-28.md"}}, {id:"federal:BR:L:3066/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-22", numero:"3066", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-22;3066", vigente:true, titulo:"Lei nº 3.066 de 22/12/1956", urn:"urn:lex:br:federal:lei:1956-12-22;3066", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério   da Educação e Cultura, os créditos especiais de Cr$ 2.000.000,00 e de Cr$   1.000.000,00 como auxílios aos Colégios da Imaculada Conceição, no Distrito   Federal, e Santa Rita, no Estado da Paraíba.", arquivo:"federal/leis-ordinarias/1956/lei-3066-1956-12-22.md"}}, {id:"federal:BR:L:2907/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-12", numero:"2907", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-12;2907", vigente:true, titulo:"Lei nº 2.907 de 12/10/1956", urn:"urn:lex:br:federal:lei:1956-10-12;2907", ementa:"Autoriza a emissão de selos comemorativos do 36º Congresso Eucarístico   Internacional.", arquivo:"federal/leis-ordinarias/1956/lei-2907-1956-10-12.md"}}, {id:"federal:BR:L:2847/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-08-18", numero:"2847", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-08-18;2847", vigente:true, titulo:"Lei nº 2.847 de 18/08/1956", urn:"urn:lex:br:federal:lei:1956-08-18;2847", ementa:"Concede isenção de direitos de importação e taxas aduaneiras para material   importado pelo Estado da Paraíba.", arquivo:"federal/leis-ordinarias/1956/lei-2847-1956-08-18.md"}}, {id:"federal:BR:L:3057/1956", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-22", numero:"3057", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-22;3057", vigente:true, titulo:"Lei nº 3.057 de 22/12/1956", urn:"urn:lex:br:federal:lei:1956-12-22;3057", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito   especial de Cr$ 30.000.000,00, destinado às despesas com o aperfeiçoamento e à   inspeção dos serviços fazendários...(vetado).", arquivo:"federal/leis-ordinarias/1956/lei-3057-1956-12-22.md"}}, {id:"federal:BR:L:2715/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-01-24", numero:"2715", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-01-24;2715", vigente:true, titulo:"Lei nº 2.715 de 24/01/1956", urn:"urn:lex:br:federal:lei:1956-01-24;2715", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 277.859,00 para pagamento de gratificação de   magistério a professores do mesmo Ministério.", arquivo:"federal/leis-ordinarias/1956/lei-2715-1956-01-24.md"}}, {id:"federal:BR:L:2750/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-04-04", numero:"2750", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-04-04;2750", vigente:true, titulo:"Lei nº 2.750 de 04/04/1956", urn:"urn:lex:br:federal:lei:1956-04-04;2750", ementa:"Cria, no Exército, o Quadro Auxiliar de Administração (   Q.A.A.).", arquivo:"federal/leis-ordinarias/1956/lei-2750-1956-04-04.md"}}, {id:"federal:BR:L:2891/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-01", numero:"2891", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-01;2891", vigente:true, titulo:"Lei nº 2.891 de 01/10/1956", urn:"urn:lex:br:federal:lei:1956-10-01;2891", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da   Gerra, o crédito especial de Cr$ 7.958.472,90 para atender ao pagamento de   remuneração dos servidores tranferidos da Southern Brazil Lumber and   Colonization Co. para aquele Ministério.", arquivo:"federal/leis-ordinarias/1956/lei-2891-1956-10-01.md"}}, {id:"federal:BR:L:2798/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-06-15", numero:"2798", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-06-15;2798", vigente:true, titulo:"Lei nº 2.798 de 15/06/1956", urn:"urn:lex:br:federal:lei:1956-06-15;2798", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça do   Trabalho - o crédito especial de Cr$ 32.890,00, destinado ao pagamento de   gratificação adicional por tempo de serviço ao Dr. Henoch da Silva Reis, Juiz   Presidente da Junta de Conciliação de Julgamento de Manaus, Estado do Amazonas,   no exercício de 1954.", arquivo:"federal/leis-ordinarias/1956/lei-2798-1956-06-15.md"}}, {id:"federal:BR:L:2933/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-31", numero:"2933", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-31;2933", vigente:true, titulo:"Lei nº 2.933 de 31/10/1956", urn:"urn:lex:br:federal:lei:1956-10-31;2933", ementa:"Modifica o art. 33 do Código da Justiça Militar.", arquivo:"federal/leis-ordinarias/1956/lei-2933-1956-10-31.md"}}, {id:"federal:BR:L:2879/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-09-21", numero:"2879", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-09-21;2879", vigente:true, titulo:"Lei nº 2.879 de 21/09/1956", urn:"urn:lex:br:federal:lei:1956-09-21;2879", ementa:"Modifica o art.42, e seu parágrafo único do Decreto-Lei nº 4.014, de 13 de janeiro de 1942, alterado pelo Decreto-Lei nº 9.832, de 11 de setembro de 1946.", arquivo:"federal/leis-ordinarias/1956/lei-2879-1956-09-21.md"}}, {id:"federal:BR:L:2803/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-06-21", numero:"2803", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-06-21;2803", vigente:true, titulo:"Lei nº 2.803 de 21/06/1956", urn:"urn:lex:br:federal:lei:1956-06-21;2803", ementa:"Dispõe sôbre o pagamento de Cr$ 50.000.000,00 ao Estado de Pernambuco, a   título de indenização pelo Território da Ilha de Fernando de   Noronha.", arquivo:"federal/leis-ordinarias/1956/lei-2803-1956-06-21.md"}}, {id:"federal:BR:L:3049/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-21", numero:"3049", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-21;3049", vigente:true, titulo:"Lei nº 3.049 de 21/12/1956", urn:"urn:lex:br:federal:lei:1956-12-21;3049", ementa:"Concede isenção de direitos de importação, taxas aduaneiras e imposto de   consumo para o material importado e a importar pelo Instituto Sul-Rio-Grandense   de Carnes, necessário à construção e funcionamento do matadouro e fábrica de   produtos de carnes e derivados, denominados \" Frigorífico-Charqueada de   Tupanciretã\", na cidade de Tupanciretã, Estado do Rio Grande do   Sul.", arquivo:"federal/leis-ordinarias/1956/lei-3049-1956-12-21.md"}}, {id:"federal:BR:L:2915/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-13", numero:"2915", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-13;2915", vigente:true, titulo:"Lei nº 2.915 de 13/10/1956", urn:"urn:lex:br:federal:lei:1956-10-13;2915", ementa:"Estende aos concursos de ciências econômicas, contábeis e atuariais o   disposto no art. 61, do Decreto-Lei nº 1.190 de 4 de abril de 1939, alterado   pelo Decreto-Lei nº 8.195, de 20 de novembro de 1945.", arquivo:"federal/leis-ordinarias/1956/lei-2915-1956-10-13.md"}}, {id:"federal:BR:L:3024/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-19", numero:"3024", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-19;3024", vigente:true, titulo:"Lei nº 3.024 de 19/12/1956", urn:"urn:lex:br:federal:lei:1956-12-19;3024", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério   da Viação e Obras Públicas, o crédito especial de Cr$ 3.616.919,30 destinado a   regularizar os pagamentos com a liquidação de compromissos acumulados e   contraídos pelo Serviço de Navegação da Bacia do Prata.", arquivo:"federal/leis-ordinarias/1956/lei-3024-1956-12-19.md"}}, {id:"federal:BR:L:3075/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-22", numero:"3075", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-22;3075", vigente:true, titulo:"Lei nº 3.075 de 22/12/1956", urn:"urn:lex:br:federal:lei:1956-12-22;3075", ementa:"Autoriza o Poder Executivo a abrir, Pelo Ministério da Saúde, o crédito   especial de Cr$ 1.000.000,00 para ocorrer às despesas com a realização do 1º   Congresso Médico Brasileiro, na Cidade de Ribeirão Preto, Estado de São   Paulo.", arquivo:"federal/leis-ordinarias/1956/lei-3075-1956-12-22.md"}}, {id:"federal:BR:L:2920/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-13", numero:"2920", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-13;2920", vigente:true, titulo:"Lei nº 2.920 de 13/10/1956", urn:"urn:lex:br:federal:lei:1956-10-13;2920", ementa:"Cria cargos no Quadro Permanente do Ministério da Agricultura e dá outras   providências.", arquivo:"federal/leis-ordinarias/1956/lei-2920-1956-10-13.md"}}, {id:"federal:BR:L:2958/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-17", numero:"2958", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-17;2958", vigente:true, titulo:"Lei nº 2.958 de 17/11/1956", urn:"urn:lex:br:federal:lei:1956-11-17;2958", ementa:"Cria diversos cargos no Quadro do Pessoal do Tribunal Regional do Trabalho   da 1ª Região, e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2958-1956-11-17.md"}}, {id:"federal:BR:L:2969/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-24", numero:"2969", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-24;2969", vigente:true, titulo:"Lei nº 2.969 de 24/11/1956", urn:"urn:lex:br:federal:lei:1956-11-24;2969", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Tribunais   Regionais do Trabalho da 3ª, 4ª e 5ª Regiões - os créditos especiais de Cr$   413.181,00, Cr$ 142.177,00, Cr$ 371.916,00 e Cr$ 102.002,00.", arquivo:"federal/leis-ordinarias/1956/lei-2969-1956-11-24.md"}}, {id:"federal:BR:L:2975/1956", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-27", numero:"2975", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-27;2975", vigente:true, titulo:"Lei nº 2.975 de 27/11/1956", urn:"urn:lex:br:federal:lei:1956-11-27;2975", ementa:"Altera a legislação do imposto único sôbre combustíveis e lubrificantes líquidos e gasosos, e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2975-1956-11-27.md"}}, {id:"federal:BR:L:3080/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-22", numero:"3080", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-22;3080", vigente:true, titulo:"Lei nº 3.080 de 22/12/1956", urn:"urn:lex:br:federal:lei:1956-12-22;3080", ementa:"Isenta de direitos de importação, imposto de consumo   e taxas aduaneiras, os materiais, um grupo moto-nivelador e um caminhão   importados pela Prefeitura Municipal de Crato, no Estado do Ceará, para reforma   e ampliação de sua hidrelétrica, e pelas Prefeituras Municipais de Bom Jardim,   João Alfredo e Vicência, no Estado de Pernambuco, para construção e conservação   de rodovias municipais.", arquivo:"federal/leis-ordinarias/1956/lei-3080-1956-12-22.md"}}, {id:"federal:BR:L:3013/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-17", numero:"3013", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-17;3013", vigente:true, titulo:"Lei nº 3.013 de 17/12/1956", urn:"urn:lex:br:federal:lei:1956-12-17;3013", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito   especial de Cr$ 370.997.056,60 para completar o pagamento de percentagem devida   aos municípios, no exercício de 1955.", arquivo:"federal/leis-ordinarias/1956/lei-3013-1956-12-17.md"}}, {id:"federal:BR:L:2758/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-04-26", numero:"2758", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-04-26;2758", vigente:true, titulo:"Lei nº 2.758 de 26/04/1956", urn:"urn:lex:br:federal:lei:1956-04-26;2758", ementa:"Autoriza o Poder Executivo a abrir ao Tribunal de Contas da União o   crédito especial de Cr$ 60.000,00 para atender ao pagamento de salários-família   devidos a pessoal do mesmo Tribunal.", arquivo:"federal/leis-ordinarias/1956/lei-2758-1956-04-26.md"}}, {id:"federal:BR:L:3089/1956", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-29", numero:"3089", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-29;3089", vigente:true, titulo:"Lei nº 3.089 de 29/12/1956", urn:"urn:lex:br:federal:lei:1956-12-29;3089", ementa:"Concede as subvenções anuais de Cr$ 1.000.000,00 e Cr$ 500.000,00 à   Academia Brasileira de Ciências e ao Instituto do Nordeste.", arquivo:"federal/leis-ordinarias/1956/lei-3089-1956-12-29.md"}}, {id:"federal:BR:L:2921/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-21", numero:"2921", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-21;2921", vigente:true, titulo:"Lei nº 2.921 de 21/10/1956", urn:"urn:lex:br:federal:lei:1956-10-21;2921", ementa:"Concede a inclusão da Faculdade de Ciências Econômicas do Ceará entre os   estabelicimentos de ensino subvencionados pelo Governo Federal.", arquivo:"federal/leis-ordinarias/1956/lei-2921-1956-10-21.md"}}, {id:"federal:BR:L:2901/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-05", numero:"2901", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-05;2901", vigente:true, titulo:"Lei nº 2.901 de 05/10/1956", urn:"urn:lex:br:federal:lei:1956-10-05;2901", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 500.000,00, para atender a despesas com a realização   do I Congresso Pan-Americano de Estudantes de Arquitetura e   Urbanismo.", arquivo:"federal/leis-ordinarias/1956/lei-2901-1956-10-05.md"}}, {id:"federal:BR:L:2791/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-05-28", numero:"2791", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-05-28;2791", vigente:true, titulo:"Lei nº 2.791 de 28/05/1956", urn:"urn:lex:br:federal:lei:1956-05-28;2791", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o   crédito especial de Cr$ 9.000.000,00 para atender no exercício de 1955, ao que   dispõe o art. 3º da Lei nº 2.470, de 28 de abril de 1955.", arquivo:"federal/leis-ordinarias/1956/lei-2791-1956-05-28.md"}}, {id:"federal:BR:L:2740/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-03-02", numero:"2740", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-03-02;2740", vigente:true, titulo:"Lei nº 2.740 de 02/03/1956", urn:"urn:lex:br:federal:lei:1956-03-02;2740", ementa:"Autoriza o Governo do Território Federal do Amapá a organizar a Companhia de Eletricidade do Amapá.", arquivo:"federal/leis-ordinarias/1956/lei-2740-1956-03-02.md"}}, {id:"federal:BR:L:2912/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-12", numero:"2912", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-12;2912", vigente:true, titulo:"Lei nº 2.912 de 12/10/1956", urn:"urn:lex:br:federal:lei:1956-10-12;2912", ementa:"Concede à Companhia Mogiana de Estradas de Ferro isenção de direitos de   importação e taxas aduaneiras, exceto a de previdência social, para materiais   destinados à ampliação e melhoramento de seus serviços.", arquivo:"federal/leis-ordinarias/1956/lei-2912-1956-10-12.md"}}, {id:"federal:BR:L:2899/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-05", numero:"2899", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-05;2899", vigente:true, titulo:"Lei nº 2.899 de 05/10/1956", urn:"urn:lex:br:federal:lei:1956-10-05;2899", ementa:"Provê sôbre o pagamento de cooperações financeiras destinadas ao ensino   médio.", arquivo:"federal/leis-ordinarias/1956/lei-2899-1956-10-05.md"}}, {id:"federal:BR:L:2707/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-01-10", numero:"2707", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-01-10;2707", vigente:true, titulo:"Lei nº 2.707 de 10/01/1956", urn:"urn:lex:br:federal:lei:1956-01-10;2707", ementa:"Concede a pensão especial de Cr$ 2.000,00 mensais a Gabriela Portela   Fagundes, progenitora do Capitão Mário Portela Fagundes.", arquivo:"federal/leis-ordinarias/1956/lei-2707-1956-01-10.md"}}, {id:"federal:BR:L:2876/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-09-20", numero:"2876", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-09-20;2876", vigente:true, titulo:"Lei nº 2.876 de 20/09/1956", urn:"urn:lex:br:federal:lei:1956-09-20;2876", ementa:"Concede o auxílio de Cr$ 1.000.000,00 ao Instituto Oceanográfico da   Universidade de São Paulo.", arquivo:"federal/leis-ordinarias/1956/lei-2876-1956-09-20.md"}}, {id:"federal:BR:L:2778/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-05-14", numero:"2778", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-05-14;2778", vigente:true, titulo:"Lei nº 2.778 de 14/05/1956", urn:"urn:lex:br:federal:lei:1956-05-14;2778", ementa:"Concede a pensão especial de Cr$ 3.000,00 mensais a Auta Gomes Monteiro   Machado, Maria Helena Gomes Machado e Célia Gomes Machado, viúva e filhas de   José Monteiro Machado, ex-funcionário do Ministério da   Agricultura.", arquivo:"federal/leis-ordinarias/1956/lei-2778-1956-05-14.md"}}, {id:"federal:BR:L:3062/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-22", numero:"3062", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-22;3062", vigente:true, titulo:"Lei nº 3.062 de 22/12/1956", urn:"urn:lex:br:federal:lei:1956-12-22;3062", ementa:"Desdobra o atual Serviço Nacional de Fiscalização da Medicina em Serviço   Nacional de Fiscalização da Medicina e Farmácia e Serviço Nacional de   Fiscalização de Odontologia, e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-3062-1956-12-22.md"}}, {id:"federal:BR:L:2999/1956", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-11", numero:"2999", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-11;2999", vigente:true, titulo:"Lei nº 2.999 de 11/12/1956", urn:"urn:lex:br:federal:lei:1956-12-11;2999", ementa:"Fixa os efetivos dos quadros de oficiais aviadores, intendentes, médicos, farmacêuticos, especialistas de avião, em comunicações, em armamento, em fotografia, em metereologia, em contrôle de tráfego aéreo, em suprimento técnico de infantaria ou guarda e de administração do Corpo de Oficiais da Aeronáutica, e dá outras previdências.", arquivo:"federal/leis-ordinarias/1956/lei-2999-1956-12-11.md"}}, {id:"federal:BR:L:2785/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-05-16", numero:"2785", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-05-16;2785", vigente:true, titulo:"Lei nº 2.785 de 16/05/1956", urn:"urn:lex:br:federal:lei:1956-05-16;2785", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações   Exteriores, o crédito especial de Cr$ 382.000,00 para atender às despesas com a   representação do Brasil à Reunião da Fundação da União Internacional de   Magistrados.", arquivo:"federal/leis-ordinarias/1956/lei-2785-1956-05-16.md"}}, {id:"federal:BR:L:3006/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-15", numero:"3006", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-15;3006", vigente:true, titulo:"Lei nº 3.006 de 15/12/1956", urn:"urn:lex:br:federal:lei:1956-12-15;3006", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Justiça e Negócios   Interiores, o crédito especial até Cr$ 10.000.000,00, a título de auxílio   extraordinário, à Fundação Abrigo do Cristo Redentor.", arquivo:"federal/leis-ordinarias/1956/lei-3006-1956-12-15.md"}}, {id:"federal:BR:L:3053/1956", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-22", numero:"3053", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-22;3053", vigente:true, titulo:"Lei nº 3.053 de 22/12/1956", urn:"urn:lex:br:federal:lei:1956-12-22;3053", ementa:"Prorroga, até 30 de junho de 1957, a vigência do regime de Licença prévia a que refere a Lei n° 2.145, de 29 de dezembro de 1953, e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-3053-1956-12-22.md"}}, {id:"federal:BR:L:2817/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-07-09", numero:"2817", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-07-09;2817", vigente:true, titulo:"Lei nº 2.817 de 09/07/1956", urn:"urn:lex:br:federal:lei:1956-07-09;2817", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras   Públicas, o crédito especial de Cr$ 10.700,00, para pagamento de indenização a   Urbano Teixeira de Menezes.", arquivo:"federal/leis-ordinarias/1956/lei-2817-1956-07-09.md"}}, {id:"federal:BR:L:2863/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-09-06", numero:"2863", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-09-06;2863", vigente:true, titulo:"Lei nº 2.863 de 06/09/1956", urn:"urn:lex:br:federal:lei:1956-09-06;2863", ementa:"Autoriza o Poder Executivo a abrir,   pelo Ministério da Viação e Obras Públicas, o crédito especial de Cr$   669.763,232,50, destinado a regularizar as despesas ;feitas, mediante adiantamento, com a execução   de obras de emergência na região nordestina assolada pela seca.", arquivo:"federal/leis-ordinarias/1956/lei-2863-1956-09-06.md"}}, {id:"federal:BR:L:2870/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-09-17", numero:"2870", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-09-17;2870", vigente:true, titulo:"Lei nº 2.870 de 17/09/1956", urn:"urn:lex:br:federal:lei:1956-09-17;2870", ementa:"Autoriza o Poder Executivo a celebrar o 1º centenário   da visita do Imperador Dom Pedro II ao Baixo São Francisco e a Cachoeira de   Paulo Afonso, e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2870-1956-09-17.md"}}, {id:"federal:BR:L:3071/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-22", numero:"3071", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-22;3071", vigente:true, titulo:"Lei nº 3.071 de 22/12/1956", urn:"urn:lex:br:federal:lei:1956-12-22;3071", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério   da Viação e Obras Públicas, o crédito especial de Cr$ 764.912,50, para atender   ao pagamento do débito da Viação Férrea Federal Leste Brasileiro à Caixa de   Aposentadoria e Pensões dos Ferroviários e de Serviços Públicos dos Estados da   Bahia e de Sergipe.", arquivo:"federal/leis-ordinarias/1956/lei-3071-1956-12-22.md"}}, {id:"federal:BR:L:2949/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-17", numero:"2949", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-17;2949", vigente:true, titulo:"Lei nº 2.949 de 17/11/1956", urn:"urn:lex:br:federal:lei:1956-11-17;2949", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário   - Superior Tribunal Militar - o crédito especial de Cr$ 27.444,30 para ocorrer   despesas correspondentes aos exercícios de 1951, 1953 e 1954, com o pagamento de   salário-família, gratificação adicional e diferença de vencimentos e atrasados a   funcionários daquele Tribunal.", arquivo:"federal/leis-ordinarias/1956/lei-2949-1956-11-17.md"}}, {id:"federal:BR:L:3045/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-21", numero:"3045", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-21;3045", vigente:true, titulo:"Lei nº 3.045 de 21/12/1956", urn:"urn:lex:br:federal:lei:1956-12-21;3045", ementa:"Manda reverter às fileiras do Exército o ex-primeiro tenente Dinarte   Silveira.", arquivo:"federal/leis-ordinarias/1956/lei-3045-1956-12-21.md"}}, {id:"federal:BR:L:3037/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-19", numero:"3037", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-19;3037", vigente:true, titulo:"Lei nº 3.037 de 19/12/1956", urn:"urn:lex:br:federal:lei:1956-12-19;3037", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério   da Viação e Obras Públicas, o crédito especial de Cr$ 150.000.000,00, destinado   às obras de remodelação do ramal de São Paulo e da linha do centro da Estrada de   Ferro Central do Brasil.", arquivo:"federal/leis-ordinarias/1956/lei-3037-1956-12-19.md"}}, {id:"federal:BR:L:2970/1956", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-24", numero:"2970", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-24;2970", vigente:true, titulo:"Lei nº 2.970 de 24/11/1956", urn:"urn:lex:br:federal:lei:1956-11-24;2970", ementa:"Modifica o art. 875, \"caput\", do Código de Processo Civil.", arquivo:"federal/leis-ordinarias/1956/lei-2970-1956-11-24.md"}}, {id:"federal:BR:L:2764/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-05-02", numero:"2764", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-05-02;2764", vigente:true, titulo:"Lei nº 2.764 de 02/05/1956", urn:"urn:lex:br:federal:lei:1956-05-02;2764", ementa:"Denomina \"Delmiro Gouveia\" a atual barragem construída pela Companhia   Hidrelétrica do São Francisco, na cachoeira de Paulo Afonso.", arquivo:"federal/leis-ordinarias/1956/lei-2764-1956-05-02.md"}}, {id:"federal:BR:L:2991/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-30", numero:"2991", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-30;2991", vigente:true, titulo:"Lei nº 2.991 de 30/11/1956", urn:"urn:lex:br:federal:lei:1956-11-30;2991", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério   das Relações Exteriores, o crédito especial de Cr$ 12.000.000,00, destinado à   compra e pagamento de vagões-tanques e às despesas complementares   indispensáveis.", arquivo:"federal/leis-ordinarias/1956/lei-2991-1956-11-30.md"}}, {id:"federal:BR:L:2801/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-06-18", numero:"2801", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-06-18;2801", vigente:true, titulo:"Lei nº 2.801 de 18/06/1956", urn:"urn:lex:br:federal:lei:1956-06-18;2801", ementa:"Extingue a Escola de Marinha Mercante do Rio de Janeiro, cria uma Escola de Marinha Mercante no Ministério da Marinha, e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2801-1956-06-18.md"}}, {id:"federal:BR:L:3090/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-29", numero:"3090", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-29;3090", vigente:true, titulo:"Lei nº 3.090 de 29/12/1956", urn:"urn:lex:br:federal:lei:1956-12-29;3090", ementa:"Concede isenção de direitos de importação para um órgão, dois   tone-cabinets e um motor-gerador, destinados aos Padres Franciscanos sediados na   cidade de Pires do Rio, no Estado de Goiás.", arquivo:"federal/leis-ordinarias/1956/lei-3090-1956-12-29.md"}}, {id:"federal:BR:L:2822/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-07-14", numero:"2822", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-07-14;2822", vigente:true, titulo:"Lei nº 2.822 de 14/07/1956", urn:"urn:lex:br:federal:lei:1956-07-14;2822", ementa:"Dispõe sobre o registro de diploma de enfermeiro, expedido até o ano de 1950, por escolas estaduais de enfermagem não equiparadas nos termos do Decreto n.º 20.109, de 15 de junho de 1931, e da Lei n.º 775, de 6 de agosto de 1949, e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2822-1956-07-14.md"}}, {id:"federal:BR:L:2962/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-23", numero:"2962", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-23;2962", vigente:true, titulo:"Lei nº 2.962 de 23/11/1956", urn:"urn:lex:br:federal:lei:1956-11-23;2962", ementa:"Abre ao Poder Legislativo - Câmara dos Deputados o crédito especial de Cr$   5.000.000,00 para a instalação de aparelhagem destinada à votação por processo   mecânico.", arquivo:"federal/leis-ordinarias/1956/lei-2962-1956-11-23.md"}}, {id:"federal:BR:L:2869/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-09-17", numero:"2869", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-09-17;2869", vigente:true, titulo:"Lei nº 2.869 de 17/09/1956", urn:"urn:lex:br:federal:lei:1956-09-17;2869", ementa:"Concede isenção de direitos de importação e mais   taxas aduaneiras, exclusive a de Previdência Social, para um equipamento   completo destinado à instalação de uma fábrica produtora de Anidrido Ftálico,   importado da Alemanha pela Empresa Produtos Químicos \"Elekeiroz\" Sociedade   Anônima.", arquivo:"federal/leis-ordinarias/1956/lei-2869-1956-09-17.md"}}, {id:"federal:BR:L:2840/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-08-04", numero:"2840", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-08-04;2840", vigente:true, titulo:"Lei nº 2.840 de 04/08/1956", urn:"urn:lex:br:federal:lei:1956-08-04;2840", ementa:"Abre ao Poder Judiciário - Tribunal Regional   Eleitoral do Piauí - o crédito especial de Cr$ 92.400,00, destinado ao pagamento   de gratificação eleitoral.", arquivo:"federal/leis-ordinarias/1956/lei-2840-1956-08-04.md"}}, {id:"federal:BR:L:2744/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-03-06", numero:"2744", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-03-06;2744", vigente:true, titulo:"Lei nº 2.744 de 06/03/1956", urn:"urn:lex:br:federal:lei:1956-03-06;2744", ementa:"Altera o quadro da Secretaria do Tribunal Regional Eleitoral do Estado do   Rio de Janeiro e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2744-1956-03-06.md"}}, {id:"federal:BR:L:2927/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-23", numero:"2927", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-23;2927", vigente:true, titulo:"Lei nº 2.927 de 23/10/1956", urn:"urn:lex:br:federal:lei:1956-10-23;2927", ementa:"Altera o Decreto-lei nº 5.878, de 4 de outubro de   1943, que autoriza a instituição da Fundação Brasil Central e dispõe sobre o seu   funcionamento.", arquivo:"federal/leis-ordinarias/1956/lei-2927-1956-10-23.md"}}, {id:"federal:BR:L:2938/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-02", numero:"2938", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-02;2938", vigente:true, titulo:"Lei nº 2.938 de 02/11/1956", urn:"urn:lex:br:federal:lei:1956-11-02;2938", ementa:"Dispõe sôbre os programas de ensino que servirão de base ao concurso de   cargos de magistério.", arquivo:"federal/leis-ordinarias/1956/lei-2938-1956-11-02.md"}}, {id:"federal:BR:L:2886/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-09-27", numero:"2886", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-09-27;2886", vigente:true, titulo:"Lei nº 2.886 de 27/09/1956", urn:"urn:lex:br:federal:lei:1956-09-27;2886", ementa:"Concede a pensão especial de Cr$ 1.000,00 mensais a Maria do Carmo Martins   de Andrade, viúva do ex-médico da Saúde dos Portos, Floro da Silveira   Andrade.", arquivo:"federal/leis-ordinarias/1956/lei-2886-1956-09-27.md"}}, {id:"federal:BR:L:2739/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-03-02", numero:"2739", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-03-02;2739", vigente:true, titulo:"Lei nº 2.739 de 02/03/1956", urn:"urn:lex:br:federal:lei:1956-03-02;2739", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações   Exteriores, o crédito especial de Cr$ 8.000.000,00, para atender às despesas de   qualquer espécie, decorrentes da posse do Presidente da República.", arquivo:"federal/leis-ordinarias/1956/lei-2739-1956-03-02.md"}}, {id:"federal:BR:L:2774/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-05-10", numero:"2774", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-05-10;2774", vigente:true, titulo:"Lei nº 2.774 de 10/05/1956", urn:"urn:lex:br:federal:lei:1956-05-10;2774", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Saúde, o crédito   especial de Cr$ 300.000,00 para pagamento de auxílio ao Capítulo Brasileiro do   Colégio Internacional de Cirurgiões, em São Paulo, capital do Estado de São   Paulo.", arquivo:"federal/leis-ordinarias/1956/lei-2774-1956-05-10.md"}}, {id:"federal:BR:L:2858/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-08-29", numero:"2858", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-08-29;2858", vigente:true, titulo:"Lei nº 2.858 de 29/08/1956", urn:"urn:lex:br:federal:lei:1956-08-29;2858", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Justiça e Negócios   Interiores, o crédito especial de Cr$ 700.000,00 a fim de auxiliar às populações   dos municípios de Feijó e Tarauacá, no Território do Acre, vitimadas pelas   enchentes em 1955.", arquivo:"federal/leis-ordinarias/1956/lei-2858-1956-08-29.md"}}, {id:"federal:BR:L:2733/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-02-18", numero:"2733", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-02-18;2733", vigente:true, titulo:"Lei nº 2.733 de 18/02/1956", urn:"urn:lex:br:federal:lei:1956-02-18;2733", ementa:"Concede a pensão especial de Cr$ 1.000,00 mensais à Olga Ferreira Girardi,   viúva do ex-extranumerário diarista da Fábrica de Juiz de Fora, José Geraldo   Girardi.", arquivo:"federal/leis-ordinarias/1956/lei-2733-1956-02-18.md"}}, {id:"federal:BR:L:2941/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-08", numero:"2941", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-08;2941", vigente:true, titulo:"Lei nº 2.941 de 08/11/1956", urn:"urn:lex:br:federal:lei:1956-11-08;2941", ementa:"Acrescenta parágrafo único ao art. 102 do Decreto-lei nº 7.036, de 10 de   novembro de 1944 (Reforma a Lei de Acidentes de trabalho).", arquivo:"federal/leis-ordinarias/1956/lei-2941-1956-11-08.md"}}, {id:"federal:BR:L:2746/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-03-13", numero:"2746", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-03-13;2746", vigente:true, titulo:"Lei nº 2.746 de 13/03/1956", urn:"urn:lex:br:federal:lei:1956-03-13;2746", ementa:"Modifica o art. 13 da Lei nº 217, de 15 de janeiro de 1948 ( Lei Orgânica   do Distrito Federal ).", arquivo:"federal/leis-ordinarias/1956/lei-2746-1956-03-13.md"}}, {id:"federal:BR:L:2937/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-31", numero:"2937", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-31;2937", vigente:true, titulo:"Lei nº 2.937 de 31/10/1956", urn:"urn:lex:br:federal:lei:1956-10-31;2937", ementa:"Autoriza a abertura, ao Tribunal de Contas, do crédito suplementar de Cr$   600.000,00, em reforço de dotações do orçamento em vigor.", arquivo:"federal/leis-ordinarias/1956/lei-2937-1956-10-31.md"}}, {id:"federal:BR:L:2724/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-02-09", numero:"2724", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-02-09;2724", vigente:true, titulo:"Lei nº 2.724 de 09/02/1956", urn:"urn:lex:br:federal:lei:1956-02-09;2724", ementa:"Incorpora a cadeira de Direito Industrial, nas Faculdades de Direito do   País, à de Direito Comercial, e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2724-1956-02-09.md"}}, {id:"federal:BR:L:2982/1956", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-30", numero:"2982", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-30;2982", vigente:true, titulo:"Lei nº 2.982 de 30/11/1956", urn:"urn:lex:br:federal:lei:1956-11-30;2982", ementa:"Modifica dispositivos da Lei n.º 2.550, de 25 de julho de 1955, que altera o Código Eleitoral (Lei nº 1.164, de 24 de julho de 1950), e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2982-1956-11-30.md"}}, {id:"federal:BR:L:3079/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-22", numero:"3079", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-22;3079", vigente:true, titulo:"Lei nº 3.079 de 22/12/1956", urn:"urn:lex:br:federal:lei:1956-12-22;3079", ementa:"Cria Caixas Econômicas Federais nos Territórios Federais do Acre, Amapá,   Rondônia e Rio Branco.", arquivo:"federal/leis-ordinarias/1956/lei-3079-1956-12-22.md"}}, {id:"federal:BR:L:2919/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-13", numero:"2919", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-13;2919", vigente:true, titulo:"Lei nº 2.919 de 13/10/1956", urn:"urn:lex:br:federal:lei:1956-10-13;2919", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério   da Justiça e Negócios Interiores, o crédito especial de Cr$ 2.500,00, destinado   a indenizar o guarda-civil Ibrahim Generoso da Silva das despesas realizadas com   seu tratamento, em consequência de acidente em serviço.", arquivo:"federal/leis-ordinarias/1956/lei-2919-1956-10-13.md"}}, {id:"federal:BR:L:3028/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-19", numero:"3028", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-19;3028", vigente:true, titulo:"Lei nº 3.028 de 19/12/1956", urn:"urn:lex:br:federal:lei:1956-12-19;3028", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 3.000.000,00 para ocorrer a despesas com a realização   do XIX Congresso Nacional de Estudantes.", arquivo:"federal/leis-ordinarias/1956/lei-3028-1956-12-19.md"}}, {id:"federal:BR:L:2950/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-17", numero:"2950", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-17;2950", vigente:true, titulo:"Lei nº 2.950 de 17/11/1956", urn:"urn:lex:br:federal:lei:1956-11-17;2950", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 300.000,00 para auxiliar a realização da III   Conferência Nacional de Jornalistas, na cidade de Goiânia, Estado de   Goiás.", arquivo:"federal/leis-ordinarias/1956/lei-2950-1956-11-17.md"}}, {id:"federal:BR:L:2839/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-08-02", numero:"2839", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-08-02;2839", vigente:true, titulo:"Lei nº 2.839 de 02/08/1956", urn:"urn:lex:br:federal:lei:1956-08-02;2839", ementa:"Dispõe sôbre cancelamento de penalidades aplicadas a servidores civis e o   abono de faltas não justificadas.", arquivo:"federal/leis-ordinarias/1956/lei-2839-1956-08-02.md"}}, {id:"federal:BR:L:3087/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-29", numero:"3087", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-29;3087", vigente:true, titulo:"Lei nº 3.087 de 29/12/1956", urn:"urn:lex:br:federal:lei:1956-12-29;3087", ementa:"Retifica, sem ônus a Lei nº 2.665, de 6 de dezembro   de 1955, que estima a Receita e fixa a Despesa da União para o exercício de   1956.", arquivo:"federal/leis-ordinarias/1956/lei-3087-1956-12-29.md"}}, {id:"federal:BR:L:2988/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-30", numero:"2988", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-30;2988", vigente:true, titulo:"Lei nº 2.988 de 30/11/1956", urn:"urn:lex:br:federal:lei:1956-11-30;2988", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério   da Aeronáutica, o crédito especial de Cr$ 1.870.000,00, para atender às despesas   decorrentes do cumprimento da segurança impetrada em favor de Pedro Mariani   Serra, Maurilio Monteiro Pereira da Cunha, Ayrton Bittencourt Lobo, Armando   Pereira de Andrade e Carlos Miguez Garrido.", arquivo:"federal/leis-ordinarias/1956/lei-2988-1956-11-30.md"}}, {id:"federal:BR:L:2773/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-05-08", numero:"2773", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-05-08;2773", vigente:true, titulo:"Lei nº 2.773 de 08/05/1956", urn:"urn:lex:br:federal:lei:1956-05-08;2773", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o   crédito especial de Cr$ 1.000.000,00 para atender às despesas com a realização   da IV Conferência Rural Brasileira, em Fortaleza, Capital do Estado do   Ceará.", arquivo:"federal/leis-ordinarias/1956/lei-2773-1956-05-08.md"}}, {id:"federal:BR:L:3011/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-17", numero:"3011", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-17;3011", vigente:true, titulo:"Lei nº 3.011 de 17/12/1956", urn:"urn:lex:br:federal:lei:1956-12-17;3011", ementa:"Abre ao Poder Judiciário - Supremo Tribunal Federal -   o crédito suplementar de Cr$ 57.996,00, em reforço da verba 1.0.00, Consignação   1.1.00, Subconsignação 1.1.11, do vigente Orçamento.", arquivo:"federal/leis-ordinarias/1956/lei-3011-1956-12-17.md"}}, {id:"federal:BR:L:3052/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-21", numero:"3052", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-21;3052", vigente:true, titulo:"Lei nº 3.052 de 21/12/1956", urn:"urn:lex:br:federal:lei:1956-12-21;3052", ementa:"Retifica, sem ônus a Lei nº 2.665, de 6 de dezembro de 1955, a qual   estima a Receita e fixa a Despesa da União para o exercício financeiro de   1956.", arquivo:"federal/leis-ordinarias/1956/lei-3052-1956-12-21.md"}}, {id:"federal:BR:L:2882/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-09-21", numero:"2882", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-09-21;2882", vigente:true, titulo:"Lei nº 2.882 de 21/09/1956", urn:"urn:lex:br:federal:lei:1956-09-21;2882", ementa:"Abre, ao Poder Legislativo, os créditos: suplementar de Cr$ 24.920.000,00,   sendo Cr$ 16.520.000,00 à Câmara dos Deputados e Cr$ 8.400.000,00 ao Senado   Federal, em reforço de dotações orçamentárias vigentes; e especial de Cr$   27.041,10, para pagamento de diferenças de salário-família e gratificação   adicional no período de 1951 a 1955.", arquivo:"federal/leis-ordinarias/1956/lei-2882-1956-09-21.md"}}, {id:"federal:BR:L:2956/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-17", numero:"2956", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-17;2956", vigente:true, titulo:"Lei nº 2.956 de 17/11/1956", urn:"urn:lex:br:federal:lei:1956-11-17;2956", ementa:"Majora a subvenção concedida ao Instituto Histórico e Geográfico   Brasileiro e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2956-1956-11-17.md"}}, {id:"federal:BR:L:2721/1956", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-01-30", numero:"2721", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-01-30;2721", vigente:true, titulo:"Lei nº 2.721 de 30/01/1956", urn:"urn:lex:br:federal:lei:1956-01-30;2721", ementa:"Federaliza a Faculdade de Direito de Niterói e o Instituto Eletrotécnico de Itajubá; subvenciona a Faculdade de Ciências Econômicas de Pelotas, no Estado do Rio Grande do Sul e a Faculdade de Direito no Rio Grande do Norte, em Natal; e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2721-1956-01-30.md"}}, {id:"federal:BR:L:2967/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-24", numero:"2967", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-24;2967", vigente:true, titulo:"Lei nº 2.967 de 24/11/1956", urn:"urn:lex:br:federal:lei:1956-11-24;2967", ementa:"Concede a pensão especial de Cr$ 5.000,00 mensais ao jornalista Hamilton   Barata.", arquivo:"federal/leis-ordinarias/1956/lei-2967-1956-11-24.md"}}, {id:"federal:BR:L:2846/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-08-13", numero:"2846", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-08-13;2846", vigente:true, titulo:"Lei nº 2.846 de 13/08/1956", urn:"urn:lex:br:federal:lei:1956-08-13;2846", ementa:"Abre ao Tribunal de Contas o crédito especial de Cr$ 5.445.200,00 para   atender ao pagamento do abono especial temporário dos funcionários e   extranumerários da Secretaria daquele Tribunal, no exercício de   1956.", arquivo:"federal/leis-ordinarias/1956/lei-2846-1956-08-13.md"}}, {id:"federal:BR:L:2997/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-11", numero:"2997", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-11;2997", vigente:true, titulo:"Lei nº 2.997 de 11/12/1956", urn:"urn:lex:br:federal:lei:1956-12-11;2997", ementa:"Autoriza o Poder Executivo a abrir o crédito especial   de Cr$ 2.760.000,00, pela realização dos XIII Jogos Universitários Brasileiros,   em Porto Alegre, Estado do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1956/lei-2997-1956-12-11.md"}}, {id:"federal:BR:L:2712/1956", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-01-21", numero:"2712", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-01-21;2712", vigente:true, titulo:"Lei nº 2.712 de 21/01/1956", urn:"urn:lex:br:federal:lei:1956-01-21;2712", ementa:"Federaliza a Escola Paulista de Medicina, cria a Faculdade de Medicina em Santa Maria, integrada na Universidade do Rio Grande do Sul, e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2712-1956-01-21.md"}}, {id:"federal:BR:L:3060/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-22", numero:"3060", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-22;3060", vigente:true, titulo:"Lei nº 3.060 de 22/12/1956", urn:"urn:lex:br:federal:lei:1956-12-22;3060", ementa:"Autoriza o Poder Executivo a abrir ao Poder   Judiciário - Justiça Eleitoral - Tribunal Regional Eleitoral do Ceará o crédito   especial de Cr$ 76.993,00 para ocorrer às despesas de gratificações adicionais a   funcionários de sua secretaria e de gratificações de natureza eleitoral a juíz e   auxiliares de cartório.", arquivo:"federal/leis-ordinarias/1956/lei-3060-1956-12-22.md"}}, {id:"federal:BR:L:2825/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-07-17", numero:"2825", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-07-17;2825", vigente:true, titulo:"Lei nº 2.825 de 17/07/1956", urn:"urn:lex:br:federal:lei:1956-07-17;2825", ementa:"Extingue a Câmara do Reajustamento Econômico.", arquivo:"federal/leis-ordinarias/1956/lei-2825-1956-07-17.md"}}, {id:"federal:BR:L:2910/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-12", numero:"2910", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-12;2910", vigente:true, titulo:"Lei nº 2.910 de 12/10/1956", urn:"urn:lex:br:federal:lei:1956-10-12;2910", ementa:"Modifica o Código de Organização Judiciária do Distrito Federal, no   concernente ao serviço do Registro Civil das Pessoas Naturais e dá outras   providências.", arquivo:"federal/leis-ordinarias/1956/lei-2910-1956-10-12.md"}}, {id:"federal:BR:L:2897/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-05", numero:"2897", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-05;2897", vigente:true, titulo:"Lei nº 2.897 de 05/10/1956", urn:"urn:lex:br:federal:lei:1956-10-05;2897", ementa:"Concede isenção de direitos de importação, taxas   aduaneiras e imposto de consumo para material doado ao Convento dos Franciscanos   de Periperi, no Estado do Piauí, e destinado à Igreja Matriz de Nossa Senhora   dos Remédios.", arquivo:"federal/leis-ordinarias/1956/lei-2897-1956-10-05.md"}}, {id:"federal:BR:L:3020/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-17", numero:"3020", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-17;3020", vigente:true, titulo:"Lei nº 3.020 de 17/12/1956", urn:"urn:lex:br:federal:lei:1956-12-17;3020", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito   especial de Cr$ 1.500.000,00 como auxílio à II Conferência de Peritos em   Siderurgia Latino-Americana e Indústrias de Transformação do Aço.", arquivo:"federal/leis-ordinarias/1956/lei-3020-1956-12-17.md"}}, {id:"federal:BR:L:2993/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-06", numero:"2993", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-06;2993", vigente:true, titulo:"Lei nº 2.993 de 06/12/1956", urn:"urn:lex:br:federal:lei:1956-12-06;2993", ementa:"Concede pelo prazo de 30 meses, isenção de direitos, adicionais, imposto de consumo e taxas aduaneiras, exceto a de previdencia social , para importação de material automobilístico que especifica e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2993-1956-12-06.md"}}, {id:"federal:BR:L:2852/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-08-25", numero:"2852", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-08-25;2852", vigente:true, titulo:"Lei nº 2.852 de 25/08/1956", urn:"urn:lex:br:federal:lei:1956-08-25;2852", ementa:"Assegura estabilidade no serviço ativo militar dos Sargentos das Forças   Armadas, da Polícia Militar e do Corpo de Bombeiros do Distrito Federal, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2852-1956-08-25.md"}}, {id:"federal:BR:L:3043/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-21", numero:"3043", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-21;3043", vigente:true, titulo:"Lei nº 3.043 de 21/12/1956", urn:"urn:lex:br:federal:lei:1956-12-21;3043", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito   suplementar de Cr$ 38.033.056,60 para completar o pagamento de percentagem   devida aos municípios, no exercício de 1956, \"ex-vi\", do art. 15, § 4º, da   Constituição Federal.", arquivo:"federal/leis-ordinarias/1956/lei-3043-1956-12-21.md"}}, {id:"federal:BR:L:2947/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-17", numero:"2947", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-17;2947", vigente:true, titulo:"Lei nº 2.947 de 17/11/1956", urn:"urn:lex:br:federal:lei:1956-11-17;2947", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça Eleitoral   - o crédito especial de Cr$ 309.000,00, para atender a despesas com gratificação   de natureza eleitoral realizadas no exercício de 1954 pelos Tribunais Regionais   Eleitorais de Minas Gerais, Piauí e São Paulo.", arquivo:"federal/leis-ordinarias/1956/lei-2947-1956-11-17.md"}}, {id:"federal:BR:L:2835/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-07-25", numero:"2835", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-07-25;2835", vigente:true, titulo:"Lei nº 2.835 de 25/07/1956", urn:"urn:lex:br:federal:lei:1956-07-25;2835", ementa:"Dispõe sôbre o tempo de serviço prestado por funcionário ou extranumerário federal ocupante do cargo de Engenheiro-Chefe da Comissão Mista Ferroviária Brasileiro-Boliviana.", arquivo:"federal/leis-ordinarias/1956/lei-2835-1956-07-25.md"}}, {id:"federal:BR:L:2974/1956", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-26", numero:"2974", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-26;2974", vigente:true, titulo:"Lei nº 2.974 de 26/11/1956", urn:"urn:lex:br:federal:lei:1956-11-26;2974", ementa:"Altera disposições do Decreto nº 26.149, de 5 de janeiro de 1949 (Consolidação das Leis do Imposto de Consumo), e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2974-1956-11-26.md"}}, {id:"federal:BR:L:2979/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-30", numero:"2979", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-30;2979", vigente:true, titulo:"Lei nº 2.979 de 30/11/1956", urn:"urn:lex:br:federal:lei:1956-11-30;2979", ementa:"Modifica a denominação da Escola Industrial de Maceió para Escola   Industrial Deodoro da Fonseca.", arquivo:"federal/leis-ordinarias/1956/lei-2979-1956-11-30.md"}}, {id:"federal:BR:L:2756/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-04-17", numero:"2756", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-04-17;2756", vigente:true, titulo:"Lei nº 2.756 de 17/04/1956", urn:"urn:lex:br:federal:lei:1956-04-17;2756", ementa:"Concede isenção de selo nos recibos das contribuições destinadas a   quaisquer instituições de assistência social, que estejam registradas no   Conselho Nacional de Serviço Social.", arquivo:"federal/leis-ordinarias/1956/lei-2756-1956-04-17.md"}}, {id:"federal:BR:L:2929/1956", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-27", numero:"2929", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-27;2929", vigente:true, titulo:"Lei nº 2.929 de 27/10/1956", urn:"urn:lex:br:federal:lei:1956-10-27;2929", ementa:"Disciplina o processo de alteração ou retificação de idade dos oficiais   das Forças Armadas e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2929-1956-10-27.md"}}, {id:"federal:BR:L:3000/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-11", numero:"3000", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-11;3000", vigente:true, titulo:"Lei nº 3.000 de 11/12/1956", urn:"urn:lex:br:federal:lei:1956-12-11;3000", ementa:"Dispõe sôbre o Fundo Aeronáutico e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-3000-1956-12-11.md"}}, {id:"federal:BR:L:3019/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-17", numero:"3019", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-17;3019", vigente:true, titulo:"Lei nº 3.019 de 17/12/1956", urn:"urn:lex:br:federal:lei:1956-12-17;3019", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Justiça e Negócios   Interiores, o crédito especial de Cr$ 2.500.000,00, para auxílio à realização do   Congresso Nacional das Assembléias Legislativas.", arquivo:"federal/leis-ordinarias/1956/lei-3019-1956-12-17.md"}}, {id:"federal:BR:L:2762/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-04-30", numero:"2762", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-04-30;2762", vigente:true, titulo:"Lei nº 2.762 de 30/04/1956", urn:"urn:lex:br:federal:lei:1956-04-30;2762", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Saúde, o crédito   especial de Cr$ 1.000.000,00 como auxílio ao Colégio Brasileiro de Cirurgiões   para realização do X Congresso Interamericano de Cirurgia.", arquivo:"federal/leis-ordinarias/1956/lei-2762-1956-04-30.md"}}, {id:"federal:BR:L:3035/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-19", numero:"3035", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-19;3035", vigente:true, titulo:"Lei nº 3.035 de 19/12/1956", urn:"urn:lex:br:federal:lei:1956-12-19;3035", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito   especial de Cr$ 500.000.000,00, para atender a despesas de exercícios   findos.", arquivo:"federal/leis-ordinarias/1956/lei-3035-1956-12-19.md"}}, {id:"federal:BR:L:2745/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-03-12", numero:"2745", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-03-12;2745", vigente:true, titulo:"Lei nº 2.745 de 12/03/1956", urn:"urn:lex:br:federal:lei:1956-03-12;2745", ementa:"Dispõe sôbre os padrões de vencimentos e as referências de salários dos servidores civis da União e dos Territórios e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2745-1956-03-12.md"}}, {id:"federal:BR:L:2732/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-02-17", numero:"2732", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-02-17;2732", vigente:true, titulo:"Lei nº 2.732 de 17/02/1956", urn:"urn:lex:br:federal:lei:1956-02-17;2732", ementa:"Cria cargos de Capelães Militares no Corpo de Bombeiros e na Polícia   Militar do Distrito Federal e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2732-1956-02-17.md"}}, {id:"federal:BR:L:3068/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-22", numero:"3068", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-22;3068", vigente:true, titulo:"Lei nº 3.068 de 22/12/1956", urn:"urn:lex:br:federal:lei:1956-12-22;3068", ementa:"Concede a pensão de cinco mil cruzeiros (Cr$ 5.000,00) mensais a Francisca   Silveira Martins.", arquivo:"federal/leis-ordinarias/1956/lei-3068-1956-12-22.md"}}, {id:"federal:BR:L:2742/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-03-06", numero:"2742", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-03-06;2742", vigente:true, titulo:"Lei nº 2.742 de 06/03/1956", urn:"urn:lex:br:federal:lei:1956-03-06;2742", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda o crédito   especial de Cr$ 885.000,00, destinado a atender às despesas com a participação   do Brasil na IX Reunião das Altas Partes Contratantes do Acordo Geral sobre   Tarifas Aduaneiras e Comércio.", arquivo:"federal/leis-ordinarias/1956/lei-2742-1956-03-06.md"}}, {id:"federal:BR:L:2960/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-23", numero:"2960", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-23;2960", vigente:true, titulo:"Lei nº 2.960 de 23/11/1956", urn:"urn:lex:br:federal:lei:1956-11-23;2960", ementa:"Modifica o art. 1º do Decreto-lei número 7.199, de 28   de dezembro de 1944, alterado pelo Decreto-lei número 8.005, de 27 de setembro   de 1945 (Autoriza a concessão de subvenção à Fundação Brasil Central), e dá   outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2960-1956-11-23.md"}}, {id:"federal:BR:L:2856/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-08-29", numero:"2856", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-08-29;2856", vigente:true, titulo:"Lei nº 2.856 de 29/08/1956", urn:"urn:lex:br:federal:lei:1956-08-29;2856", ementa:"Autoriza o Poder Executivo abrir, pelo Ministério da Fazenda, o crédito   especial de Cr$ 500.000.000,00, destinado a atender a despesas com a execução,   no exercício de 1955, da Lei n° 2.453, de 15 de abril de 1955.", arquivo:"federal/leis-ordinarias/1956/lei-2856-1956-08-29.md"}}, {id:"federal:BR:L:2717/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-01-24", numero:"2717", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-01-24;2717", vigente:true, titulo:"Lei nº 2.717 de 24/01/1956", urn:"urn:lex:br:federal:lei:1956-01-24;2717", ementa:"Reconhece a Federação das Bandeirantes do Brasil como órgão máximo do   escotismo feminino.", arquivo:"federal/leis-ordinarias/1956/lei-2717-1956-01-24.md"}}, {id:"federal:BR:L:3059/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-22", numero:"3059", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-22;3059", vigente:true, titulo:"Lei nº 3.059 de 22/12/1956", urn:"urn:lex:br:federal:lei:1956-12-22;3059", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Saúde, o crédito   especial de Cr$ 10.000.000,00 para a conclusão das obras do Hospital dos   Radialistas e aquisição do respectivo equipamento.", arquivo:"federal/leis-ordinarias/1956/lei-3059-1956-12-22.md"}}, {id:"federal:BR:L:2832/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-07-20", numero:"2832", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-07-20;2832", vigente:true, titulo:"Lei nº 2.832 de 20/07/1956", urn:"urn:lex:br:federal:lei:1956-07-20;2832", ementa:"Abre ao Poder Judiciário - Justiça Eleitoral - o crédito especial de Cr$   830.400,00 para atender ao pagamento de despesas com substituições de pessoal,   salário-família e aluguéis de imóveis, no exercício de 1954.", arquivo:"federal/leis-ordinarias/1956/lei-2832-1956-07-20.md"}}, {id:"federal:BR:L:2893/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-01", numero:"2893", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-01;2893", vigente:true, titulo:"Lei nº 2.893 de 01/10/1956", urn:"urn:lex:br:federal:lei:1956-10-01;2893", ementa:"Isenta de direitos de importação, imposto de consumo   e taxas aduaneiras, dois pianos e um aparelho de televisão destinados,   respectivamente, aos Externatos Nossa Senhora da Assunção, em Niterói, Estado do   Rio de Janeiro e Nossa Senhora das Mercês, no Distrito Federal.", arquivo:"federal/leis-ordinarias/1956/lei-2893-1956-10-01.md"}}, {id:"federal:BR:L:2874/1956", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-09-19", numero:"2874", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-09-19;2874", vigente:true, titulo:"Lei nº 2.874 de 19/09/1956", urn:"urn:lex:br:federal:lei:1956-09-19;2874", ementa:"Dispõe sôbre a mudança da Capital Federal e dá outra providências.", arquivo:"federal/leis-ordinarias/1956/lei-2874-1956-09-19.md"}}, {id:"federal:BR:L:2904/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-08", numero:"2904", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-08;2904", vigente:true, titulo:"Lei nº 2.904 de 08/10/1956", urn:"urn:lex:br:federal:lei:1956-10-08;2904", ementa:"Revigora por 30 dias o prazo concedido no § 7º do art   6º da Lei nº 2.193, de 9 de março de 1954 (Dispõe sobre a execução dos serviços   a cargo da Superintendência das Empresas Incorporadas ao Patrimônio Nacional).", arquivo:"federal/leis-ordinarias/1956/lei-2904-1956-10-08.md"}}, {id:"federal:BR:L:2909/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-12", numero:"2909", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-12;2909", vigente:true, titulo:"Lei nº 2.909 de 12/10/1956", urn:"urn:lex:br:federal:lei:1956-10-12;2909", ementa:"Altera o quadro do pessoal da Secretaria do Tribunal Regional Eleitoral do   Estado do Paraná, e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2909-1956-10-12.md"}}, {id:"federal:BR:L:3026/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-19", numero:"3026", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-19;3026", vigente:true, titulo:"Lei nº 3.026 de 19/12/1956", urn:"urn:lex:br:federal:lei:1956-12-19;3026", ementa:"Dispõe sôbre a aplicação dos créditos especiais de   Cr$ 177.000.000,00 autorizados pelo art. 5º da Lei nº 2.599, de 13 de setembro   de 1955, e de Cr$ 40.000.000,00 referentes aos saldos orçamentários do anexo do   São Francisco, no exercício de 1955.", arquivo:"federal/leis-ordinarias/1956/lei-3026-1956-12-19.md"}}, {id:"federal:BR:L:2917/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-13", numero:"2917", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-13;2917", vigente:true, titulo:"Lei nº 2.917 de 13/10/1956", urn:"urn:lex:br:federal:lei:1956-10-13;2917", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 2.500.000,00, para atender ao pagamento da subvenção   devida à Faculdade de Ciências Econômicas de Pelotas, Estado do Rio Grande do   Sul.", arquivo:"federal/leis-ordinarias/1956/lei-2917-1956-10-13.md"}}, {id:"federal:BR:L:3077/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-22", numero:"3077", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-22;3077", vigente:true, titulo:"Lei nº 3.077 de 22/12/1956", urn:"urn:lex:br:federal:lei:1956-12-22;3077", ementa:"Autoriza o Governo Federal a incorporar ao Patrimônio da União a Faculdade de Farmácia e Odontologia do Estado do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1956/lei-3077-1956-12-22.md"}}, {id:"federal:BR:L:2935/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-31", numero:"2935", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-31;2935", vigente:true, titulo:"Lei nº 2.935 de 31/10/1956", urn:"urn:lex:br:federal:lei:1956-10-31;2935", ementa:"Concede a inclusão da Escola Superior de Agricultura de Lavras entre os   estabelecimentos subvencionados pelo Govêrno Federal.", arquivo:"federal/leis-ordinarias/1956/lei-2935-1956-10-31.md"}}, {id:"federal:BR:L:2738/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-02-20", numero:"2738", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-02-20;2738", vigente:true, titulo:"Lei nº 2.738 de 20/02/1956", urn:"urn:lex:br:federal:lei:1956-02-20;2738", ementa:"Dispõe sôbre o afastamento do oficial que de revelar incompatível com o exercício de suas funções, quer em situação normal, quer por ocasião de provas de instrução, de manobras ou operações de guerra, e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2738-1956-02-20.md"}}, {id:"federal:BR:L:2930/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-27", numero:"2930", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-27;2930", vigente:true, titulo:"Lei nº 2.930 de 27/10/1956", urn:"urn:lex:br:federal:lei:1956-10-27;2930", ementa:"Modifica o art. 92, da tabela constante do Decreto nº 32.392, de 9 de março de 1953 (Consolidação das Leis do Imposto do Selo).", arquivo:"federal/leis-ordinarias/1956/lei-2930-1956-10-27.md"}}, {id:"federal:BR:L:2980/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-30", numero:"2980", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-30;2980", vigente:true, titulo:"Lei nº 2.980 de 30/11/1956", urn:"urn:lex:br:federal:lei:1956-11-30;2980", ementa:"Concede a pensão especial de Cr$ 3.000,00 mensais a Alina de Carvalho   Costa, viúva de Antenor Golçalves Costa, mestre de Oficina, aposentado, do   Arsenal de Guerra do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1956/lei-2980-1956-11-30.md"}}, {id:"federal:BR:L:3015/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-17", numero:"3015", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-17;3015", vigente:true, titulo:"Lei nº 3.015 de 17/12/1956", urn:"urn:lex:br:federal:lei:1956-12-17;3015", ementa:"Estende à Comarca de Nova Lima à Cidade Industrial a jurisdição das juntas   de Conciliação e Julgamento de Belo Horizonte.", arquivo:"federal/leis-ordinarias/1956/lei-3015-1956-12-17.md"}}, {id:"federal:BR:L:2923/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-21", numero:"2923", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-21;2923", vigente:true, titulo:"Lei nº 2.923 de 21/10/1956", urn:"urn:lex:br:federal:lei:1956-10-21;2923", ementa:"Revigora o inciso IX, do § 6º do art. 178, da Lei nº 3.071, de 1º de janeiro de 1916 (Código civil)", arquivo:"federal/leis-ordinarias/1956/lei-2923-1956-10-21.md"}}, {id:"federal:BR:L:2853/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-08-28", numero:"2853", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-08-28;2853", vigente:true, titulo:"Lei nº 2.853 de 28/08/1956", urn:"urn:lex:br:federal:lei:1956-08-28;2853", ementa:"Altera a Lei n.º 1.046, de 2 de janeiro de 1950 (Dispõe sobre consignação em folha de pagamento).", arquivo:"federal/leis-ordinarias/1956/lei-2853-1956-08-28.md"}}, {id:"federal:BR:L:3082/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-22", numero:"3082", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-22;3082", vigente:true, titulo:"Lei nº 3.082 de 22/12/1956", urn:"urn:lex:br:federal:lei:1956-12-22;3082", ementa:"Concede à Associação Baiana de Imprensa e à Associação Cearense de   Imprensa o auxílio de Cr$ 1.500.000,00 para cada uma, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1956/lei-3082-1956-12-22.md"}}, {id:"federal:BR:L:3031/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-19", numero:"3031", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-19;3031", vigente:true, titulo:"Lei nº 3.031 de 19/12/1956", urn:"urn:lex:br:federal:lei:1956-12-19;3031", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda o crédito   suplementar de Cr$ 1.100.000,00.", arquivo:"federal/leis-ordinarias/1956/lei-3031-1956-12-19.md"}}, {id:"federal:BR:L:3064/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-22", numero:"3064", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-22;3064", vigente:true, titulo:"Lei nº 3.064 de 22/12/1956", urn:"urn:lex:br:federal:lei:1956-12-22;3064", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o   crédito especial de Cr$ 15.000.000,00 para obras e equipamentos necessários ao   funcionamento do Centro Pan-Americano de Febre Aftosa.", arquivo:"federal/leis-ordinarias/1956/lei-3064-1956-12-22.md"}}, {id:"federal:BR:L:2704/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-01-06", numero:"2704", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-01-06;2704", vigente:true, titulo:"Lei nº 2.704 de 06/01/1956", urn:"urn:lex:br:federal:lei:1956-01-06;2704", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério   do Trabalho, Indústria e Comércio, o crédito especial de Cr$ 103.000,00, para   atender às despesas com o pagamento de sentença arbitral e honorários de   advogado, proferida em lide para revisão de aluguel do imóvel ocupado pelo   Escritório de Propaganda e Expansão Comercial do Brasil na França.", arquivo:"federal/leis-ordinarias/1956/lei-2704-1956-01-06.md"}}, {id:"federal:BR:L:2867/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-09-13", numero:"2867", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-09-13;2867", vigente:true, titulo:"Lei nº 2.867 de 13/09/1956", urn:"urn:lex:br:federal:lei:1956-09-13;2867", ementa:"Releva a prescrição em que incorreu o direito de Francisco Pereira Veras,   servidor do Território Federal do Acre, de pedir aposentadoria.", arquivo:"federal/leis-ordinarias/1956/lei-2867-1956-09-13.md"}}, {id:"federal:BR:L:2787/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-05-25", numero:"2787", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-05-25;2787", vigente:true, titulo:"Lei nº 2.787 de 25/05/1956", urn:"urn:lex:br:federal:lei:1956-05-25;2787", ementa:"Concede a inclusão da Faculdade de Direito da Pontifícia Universidade   Católica do Rio de Janeiro entre os estabelecimentos subvencionados pelo Governo   Federal.", arquivo:"federal/leis-ordinarias/1956/lei-2787-1956-05-25.md"}}, {id:"federal:BR:L:2903/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-05", numero:"2903", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-05;2903", vigente:true, titulo:"Lei nº 2.903 de 05/10/1956", urn:"urn:lex:br:federal:lei:1956-10-05;2903", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Saúde, o crédito   especial de Cr$ 2.000.000,00 para ocorrer às despesas de desapropriação, por   utilidade pública, de imóvel situado em Recife, capital do Estado de   Pernambuco.", arquivo:"federal/leis-ordinarias/1956/lei-2903-1956-10-05.md"}}, {id:"federal:BR:L:2819/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-07-09", numero:"2819", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-07-09;2819", vigente:true, titulo:"Lei nº 2.819 de 09/07/1956", urn:"urn:lex:br:federal:lei:1956-07-09;2819", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Tribunal Regional   do Trabalho da 1ª Região - o crédito especial de Cr$ 19.299,50, destinado ao   pagamento de gratificação adicional por tempo de serviço a funcionários do mesmo   Tribunal.", arquivo:"federal/leis-ordinarias/1956/lei-2819-1956-07-09.md"}}, {id:"federal:BR:L:3055/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-22", numero:"3055", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-22;3055", vigente:true, titulo:"Lei nº 3.055 de 22/12/1956", urn:"urn:lex:br:federal:lei:1956-12-22;3055", ementa:"Fixa a divisão administrativa e judiciária do   Território Federal do Amapá, para o quinqüênio 1954-1958.", arquivo:"federal/leis-ordinarias/1956/lei-3055-1956-12-22.md"}}, {id:"federal:BR:L:2976/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-28", numero:"2976", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-28;2976", vigente:true, titulo:"Lei nº 2.976 de 28/11/1956", urn:"urn:lex:br:federal:lei:1956-11-28;2976", ementa:"Dispõe sôbre o Plano de Valorização Econômica da Região da fronteira sudoeste do País.", arquivo:"federal/leis-ordinarias/1956/lei-2976-1956-11-28.md"}}, {id:"federal:BR:L:3039/1956", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-20", numero:"3039", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-20;3039", vigente:true, titulo:"Lei nº 3.039 de 20/12/1956", urn:"urn:lex:br:federal:lei:1956-12-20;3039", ementa:"Concede contribuição financeira às empresas de transporte aéreo, que explorem linhas dentro do país, para fins de reaparelhamento de material de vôo.", arquivo:"federal/leis-ordinarias/1956/lei-3039-1956-12-20.md"}}, {id:"federal:BR:L:3008/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-15", numero:"3008", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-15;3008", vigente:true, titulo:"Lei nº 3.008 de 15/12/1956", urn:"urn:lex:br:federal:lei:1956-12-15;3008", ementa:"Concede a pensão especial de Cr$ 3.000,00 mensais a Angelina de Gois   Cabral, viúva do legionário Laurênio Cabral, que fez parte da Força   Expedicionária do Acre.", arquivo:"federal/leis-ordinarias/1956/lei-3008-1956-12-15.md"}}, {id:"federal:BR:L:2810/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-07-02", numero:"2810", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-07-02;2810", vigente:true, titulo:"Lei nº 2.810 de 02/07/1956", urn:"urn:lex:br:federal:lei:1956-07-02;2810", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério   da Educação e Cultura, o crédito especial de Cr$ 1.500.000,00 concedidos como   auxílio ao Instituto Brasileiro de História da Medicina na realização do   Primeiro Congresso Pan-Americano de História da Medicina e Terceiro Congresso   Brasileiro de História da Medicina.", arquivo:"federal/leis-ordinarias/1956/lei-2810-1956-07-02.md"}}, {id:"federal:BR:L:2828/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-07-18", numero:"2828", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-07-18;2828", vigente:true, titulo:"Lei nº 2.828 de 18/07/1956", urn:"urn:lex:br:federal:lei:1956-07-18;2828", ementa:"Retifica a importância e modifica o parágrafo único do art. 7º da Lei n.º   2.712, de 21 de janeiro de 1956 (Federaliza a Escola Paulista de Medicina, cria   a Faculdade de Medicina em Santa Maria integrada na Universidade do Rio Grande   do Sul e dá outras providências).", arquivo:"federal/leis-ordinarias/1956/lei-2828-1956-07-18.md"}}, {id:"federal:BR:L:2705/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-01-06", numero:"2705", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-01-06;2705", vigente:true, titulo:"Lei nº 2.705 de 06/01/1956", urn:"urn:lex:br:federal:lei:1956-01-06;2705", ementa:"Autoriza o Poder Executivo a doar à União Beneficente de Cariús prédio e   respectivo terreno situados à Praça 15 de novembro, em Cariús, no Estado do   Ceará.", arquivo:"federal/leis-ordinarias/1956/lei-2705-1956-01-06.md"}}, {id:"federal:BR:L:3073/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-22", numero:"3073", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-22;3073", vigente:true, titulo:"Lei nº 3.073 de 22/12/1956", urn:"urn:lex:br:federal:lei:1956-12-22;3073", ementa:"Autoriza o Governo Federal a auxiliar com a importância de Cr$   500.000.000,00 o Governo do Paraná na realização de novos estudos,   prosseguimento, equipamento e tráfego da ligação ferroviária Apucarana-Ponta   Grossa.", arquivo:"federal/leis-ordinarias/1956/lei-3073-1956-12-22.md"}}, {id:"federal:BR:L:2708/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-01-11", numero:"2708", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-01-11;2708", vigente:true, titulo:"Lei nº 2.708 de 11/01/1956", urn:"urn:lex:br:federal:lei:1956-01-11;2708", ementa:"Autoriza o Poder Executivo a transferir, sem ônus, para a Prefeitura de   Ribeirão Vermelho, Estado de Minas Gerais, o serviço de abastecimento de água   que a Rêde Mineira de Viação possui naquela localidade.", arquivo:"federal/leis-ordinarias/1956/lei-2708-1956-01-11.md"}}, {id:"federal:BR:L:2883/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-09-24", numero:"2883", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-09-24;2883", vigente:true, titulo:"Lei nº 2.883 de 24/09/1956", urn:"urn:lex:br:federal:lei:1956-09-24;2883", ementa:"Concede a pensão especial de Cr$ 5.000,00 mensais a Antonieta Moreira,   viúva do jornalista Nestor Moreira.", arquivo:"federal/leis-ordinarias/1956/lei-2883-1956-09-24.md"}}, {id:"federal:BR:L:3047/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-21", numero:"3047", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-21;3047", vigente:true, titulo:"Lei nº 3.047 de 21/12/1956", urn:"urn:lex:br:federal:lei:1956-12-21;3047", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério   da Viação e Obras Públicas, os créditos especiais de Cr$ 1.000.000,00, Cr$   2.000.000,00 e Cr$ 3.000.000,00, destinados às construções e reconstrução de   estações da Estrada de Ferro Leopoldina e da Estrada de Ferro Noroeste do   Brasil, nas cidades de Castelo, Lins e Itaperuna, nos Estados do Espírito Santo,   de São Paulo e do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1956/lei-3047-1956-12-21.md"}}, {id:"federal:BR:L:3022/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-19", numero:"3022", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-19;3022", vigente:true, titulo:"Lei nº 3.022 de 19/12/1956", urn:"urn:lex:br:federal:lei:1956-12-19;3022", ementa:"Modofica a alínea \"c\" do art. 580 do Decreto-Lei nº 5.452, de 1 de maio de 1943 (Consolidação das Leis do Trabalho).", arquivo:"federal/leis-ordinarias/1956/lei-3022-1956-12-19.md"}}, {id:"federal:BR:L:2913/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-13", numero:"2913", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-13;2913", vigente:true, titulo:"Lei nº 2.913 de 13/10/1956", urn:"urn:lex:br:federal:lei:1956-10-13;2913", ementa:"Retifica a Lei n.º 2.493, de 21 de maio de 1955   (autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura, o   crédito especial de Cr$ 694.844,60 para atender ao pagamento de fornecimentos   feitos, no exercício de 1952, a diversos orgãos do mesmo Ministério).", arquivo:"federal/leis-ordinarias/1956/lei-2913-1956-10-13.md"}}, {id:"federal:BR:L:2865/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-09-06", numero:"2865", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-09-06;2865", vigente:true, titulo:"Lei nº 2.865 de 06/09/1956", urn:"urn:lex:br:federal:lei:1956-09-06;2865", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério   da Viação e Obras Públicas, o crédito especial de Cr$ 102.520.840,00, destinado   a saldar os compromissos assumidos pelos Serviços de Navegação da Amazônia e   Administração do Porto do Pará (S.N.A.P.P), com a renovação de sua frota.", arquivo:"federal/leis-ordinarias/1956/lei-2865-1956-09-06.md"}}, {id:"federal:BR:L:2766/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-05-02", numero:"2766", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-05-02;2766", vigente:true, titulo:"Lei nº 2.766 de 02/05/1956", urn:"urn:lex:br:federal:lei:1956-05-02;2766", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito   especial de Cr$ 500.000,00 para atender às despesas com a realização do 2º   Congresso Eucarístico de Niteroí.", arquivo:"federal/leis-ordinarias/1956/lei-2766-1956-05-02.md"}}, {id:"federal:BR:L:2888/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-01", numero:"2888", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-01;2888", vigente:true, titulo:"Lei nº 2.888 de 01/10/1956", urn:"urn:lex:br:federal:lei:1956-10-01;2888", ementa:"Abre ao Poder Judiciário - Justiça do Trabalho - o crédito especial de Cr$ 7.460,00 para atender ao pagamento de diárias e salário-família, devidos nos exercícios de 1947 a 1954, a juizes suplentes e funcionários do Tribunal Regional do Trabalho da 4ª Região.", arquivo:"federal/leis-ordinarias/1956/lei-2888-1956-10-01.md"}}, {id:"federal:BR:L:3092/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-29", numero:"3092", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-29;3092", vigente:true, titulo:"Lei nº 3.092 de 29/12/1956", urn:"urn:lex:br:federal:lei:1956-12-29;3092", ementa:"Cria a Escola Agrícola de Rio Pomba, no Estado de Minas Gerais, e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-3092-1956-12-29.md"}}, {id:"federal:BR:L:2761/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-04-26", numero:"2761", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-04-26;2761", vigente:true, titulo:"Lei nº 2.761 de 26/04/1956", urn:"urn:lex:br:federal:lei:1956-04-26;2761", ementa:"Dá nova redação ao § 2º do artigo 6º da Lei n.º 605, de 5 de janeiro de 1949, que regula o repouso semanal remunerado.", arquivo:"federal/leis-ordinarias/1956/lei-2761-1956-04-26.md"}}, {id:"federal:BR:L:2994/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-10", numero:"2994", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-10;2994", vigente:true, titulo:"Lei nº 2.994 de 10/12/1956", urn:"urn:lex:br:federal:lei:1956-12-10;2994", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras   Públicas, o crédito especial de Cr$ 50.000.000,00, destinado a atender às   despesas resultantes de várias obras, serviços e trabalhos de qualquer natureza   contratados pelo Departamento Nacional de Portos, Rios e Canais.", arquivo:"federal/leis-ordinarias/1956/lei-2994-1956-12-10.md"}}, {id:"federal:BR:L:2972/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-24", numero:"2972", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-24;2972", vigente:true, titulo:"Lei nº 2.972 de 24/11/1956", urn:"urn:lex:br:federal:lei:1956-11-24;2972", ementa:"Revoga o Decreto-Lei n.º 8.887, de 24 de janeiro de 1946, que criou a   Colônia de Férias da Aeronáutica de Rodeio.", arquivo:"federal/leis-ordinarias/1956/lei-2972-1956-11-24.md"}}, {id:"federal:BR:L:2809/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-07-02", numero:"2809", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-07-02;2809", vigente:true, titulo:"Lei nº 2.809 de 02/07/1956", urn:"urn:lex:br:federal:lei:1956-07-02;2809", ementa:"Cria cargos no Quadro Permanete do Ministério da   Educação e Cultura para atender à autonomia das Faculdades de Farmácia e   Odontologia das Universidades da Bahia e do Rio Grande do Sul, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1956/lei-2809-1956-07-02.md"}}, {id:"federal:BR:L:2781/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-05-14", numero:"2781", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-05-14;2781", vigente:true, titulo:"Lei nº 2.781 de 14/05/1956", urn:"urn:lex:br:federal:lei:1956-05-14;2781", ementa:"Cria cargos no Quadro do Pessoal do Trbunal Regional do Trabalho da   Terceira Região.", arquivo:"federal/leis-ordinarias/1956/lei-2781-1956-05-14.md"}}, {id:"federal:BR:L:2749/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-04-02", numero:"2749", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-04-02;2749", vigente:true, titulo:"Lei nº 2.749 de 02/04/1956", urn:"urn:lex:br:federal:lei:1956-04-02;2749", ementa:"Dá norma ao gênero dos nomes designativos das funções   públicas.", arquivo:"federal/leis-ordinarias/1956/lei-2749-1956-04-02.md"}}, {id:"federal:BR:L:2793/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-06-01", numero:"2793", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-06-01;2793", vigente:true, titulo:"Lei nº 2.793 de 01/06/1956", urn:"urn:lex:br:federal:lei:1956-06-01;2793", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 10.000.000,00, destinado a auxiliar a Academia   Brasileira de Ciências, do Distrito Federal, na aquisição ou construção do   imóvel para sua sede própria.", arquivo:"federal/leis-ordinarias/1956/lei-2793-1956-06-01.md"}}, {id:"federal:BR:L:2728/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-02-16", numero:"2728", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-02-16;2728", vigente:true, titulo:"Lei nº 2.728 de 16/02/1956", urn:"urn:lex:br:federal:lei:1956-02-16;2728", ementa:"Modifica o art. 52 da Lei nº 2.083, de 12 de novembro de 1953, que regula a Liberdade de Imprensa.", arquivo:"federal/leis-ordinarias/1956/lei-2728-1956-02-16.md"}}, {id:"federal:BR:L:2814/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-07-06", numero:"2814", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-07-06;2814", vigente:true, titulo:"Lei nº 2.814 de 06/07/1956", urn:"urn:lex:br:federal:lei:1956-07-06;2814", ementa:"Dispõe sôbre a concessão de auxílio aos municípios situados no Polígono   das Secas, para instalação de serviços públicos de abastecimento   dágua.", arquivo:"federal/leis-ordinarias/1956/lei-2814-1956-07-06.md"}}, {id:"federal:BR:L:2735/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-02-18", numero:"2735", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-02-18;2735", vigente:true, titulo:"Lei nº 2.735 de 18/02/1956", urn:"urn:lex:br:federal:lei:1956-02-18;2735", ementa:"Fixa o período de estágio probatório do funcionário nomeado para cargo de   provimento efetivo e aos extranumerários mensalistas da União e das   Autarquias.", arquivo:"federal/leis-ordinarias/1956/lei-2735-1956-02-18.md"}}, {id:"federal:BR:L:2943/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-08", numero:"2943", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-08;2943", vigente:true, titulo:"Lei nº 2.943 de 08/11/1956", urn:"urn:lex:br:federal:lei:1956-11-08;2943", ementa:"Modifica a alínea \"c\" do artigo terceiro do   Decreto-Lei número nove mil oitocentos e cinqüenta e nove de teze de setembro de   mil novecentos e quarenta e seis (Autoriza o Departamento Nacional de Estradas   de Ferro a contrair com o Instituto de Aposentadoria e Pensões dos Industriários   Empréstimos destinados a custear a construção, no País, de material rodante e a   eletrificação de linha de Viação Férrea Federal Leste Brasileiro).", arquivo:"federal/leis-ordinarias/1956/lei-2943-1956-11-08.md"}}, {id:"federal:BR:L:2748/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-03-13", numero:"2748", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-03-13;2748", vigente:true, titulo:"Lei nº 2.748 de 13/03/1956", urn:"urn:lex:br:federal:lei:1956-03-13;2748", ementa:"Concede isenção de direitos e mais taxas aduaneiras e imposto de consumo   para importação da Alemanha de um automóvel e uma camioneta, marca Opel   Capitain, e de 400 toneladas de ferro, destinados à Escola, Lactário e   Ambulatório da Matriz de São Cosme e São Damião, no Distrito   Federal.", arquivo:"federal/leis-ordinarias/1956/lei-2748-1956-03-13.md"}}, {id:"federal:BR:L:2776/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-05-10", numero:"2776", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-05-10;2776", vigente:true, titulo:"Lei nº 2.776 de 10/05/1956", urn:"urn:lex:br:federal:lei:1956-05-10;2776", ementa:"Autoriza o Poder Executivo a abrir, pela Comissão do Vale de São   Francisco, o crédito especial de Cr$ 42.958,10, destinado ao pagamento de   diferença de vencimentos aos servidores Renato Mascarenhas de Souza e Benedito   Brandão Reis.", arquivo:"federal/leis-ordinarias/1956/lei-2776-1956-05-10.md"}}, {id:"federal:BR:L:2952/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-17", numero:"2952", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-17;2952", vigente:true, titulo:"Lei nº 2.952 de 17/11/1956", urn:"urn:lex:br:federal:lei:1956-11-17;2952", ementa:"Autoriza o Poder Executivo a abrir ao Poder   Judiciário - Justiça Eleitoral - o crédito especial de Cr$ 791.406,50 para   atender a despesas diversas realizadas no exercício de mil novecentos e   cinqüenta e cinco, pelos Tribunais Regionais Eleitorais de Alagoas, Maranhão,   São Paulo, Amazonas, Ceará, Paraná e Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1956/lei-2952-1956-11-17.md"}}, {id:"federal:BR:L:2860/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-08-31", numero:"2860", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-08-31;2860", vigente:true, titulo:"Lei nº 2.860 de 31/08/1956", urn:"urn:lex:br:federal:lei:1956-08-31;2860", ementa:"Estabelece prisão especial para dirigentes de entidades sindicais e para o empregado no exercício de representação profissional ou cargo de administração sindical.", arquivo:"federal/leis-ordinarias/1956/lei-2860-1956-08-31.md"}}, {id:"federal:BR:L:2726/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-02-09", numero:"2726", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-02-09;2726", vigente:true, titulo:"Lei nº 2.726 de 09/02/1956", urn:"urn:lex:br:federal:lei:1956-02-09;2726", ementa:"Suspende o estado de sítio decretado na conformidade da Lei nº 2.713, de   21 de janeiro de 1956.", arquivo:"federal/leis-ordinarias/1956/lei-2726-1956-02-09.md"}}, {id:"federal:BR:L:2984/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-30", numero:"2984", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-30;2984", vigente:true, titulo:"Lei nº 2.984 de 30/11/1956", urn:"urn:lex:br:federal:lei:1956-11-30;2984", ementa:"Inclui a Faculdade de Filosofia e a Escola Politécnica da Universidade   Católica de Pernambuco entre os estabelecimentos subvencionados pelo Governo   Federal.", arquivo:"federal/leis-ordinarias/1956/lei-2984-1956-11-30.md"}}, {id:"federal:BR:L:2805/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-06-25", numero:"2805", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-06-25;2805", vigente:true, titulo:"Lei nº 2.805 de 25/06/1956", urn:"urn:lex:br:federal:lei:1956-06-25;2805", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   os créditos especiais, respectivamente, de Cr$ 10.000.000,00 e Cr$ 5.000.000,00   para auxiliar a Pontifícia Universidade Católica a terminar a construção e   instalação da Universidade à rua Marquês de São Vicente, no Distrito Federal, e   Pontifícia Universidade Católica do Rio Grande do Sul, nas obras de ampliação de   suas instalações.", arquivo:"federal/leis-ordinarias/1956/lei-2805-1956-06-25.md"}}, {id:"federal:BR:L:2896/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-10-05", numero:"2896", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-10-05;2896", vigente:true, titulo:"Lei nº 2.896 de 05/10/1956", urn:"urn:lex:br:federal:lei:1956-10-05;2896", ementa:"Modifica o art. 5º do Regulamento das Caixas Econômicas Federais, a que se   refere o Decreto nº 24.427 de 19 de junho de 1934.", arquivo:"federal/leis-ordinarias/1956/lei-2896-1956-10-05.md"}}, {id:"federal:BR:L:2806/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-06-27", numero:"2806", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-06-27;2806", vigente:true, titulo:"Lei nº 2.806 de 27/06/1956", urn:"urn:lex:br:federal:lei:1956-06-27;2806", ementa:"Dispensa, até 31 de dezembro de 1958, a exigência do curso da Escola de   Aperfeiçoamento de Oficiais, para os Capitães, do Quadro dos Serviços do   Exército.", arquivo:"federal/leis-ordinarias/1956/lei-2806-1956-06-27.md"}}, {id:"federal:BR:L:2786/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-05-21", numero:"2786", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-05-21;2786", vigente:true, titulo:"Lei nº 2.786 de 21/05/1956", urn:"urn:lex:br:federal:lei:1956-05-21;2786", ementa:"Altera a lei sôbre desapropriação por utilidade pública.", arquivo:"federal/leis-ordinarias/1956/lei-2786-1956-05-21.md"}}, {id:"federal:BR:L:2711/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-01-21", numero:"2711", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-01-21;2711", vigente:true, titulo:"Lei nº 2.711 de 21/01/1956", urn:"urn:lex:br:federal:lei:1956-01-21;2711", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Justiça e Negócios   Interiores, crédito especial até a importância de Cr$ 40.000.000,00, para início   da construção de um prédio destinado ao Palácio da Justiça, no Distrito Federal,   e dá outras providências.", arquivo:"federal/leis-ordinarias/1956/lei-2711-1956-01-21.md"}}, {id:"federal:BR:L:2838/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-08-02", numero:"2838", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-08-02;2838", vigente:true, titulo:"Lei nº 2.838 de 02/08/1956", urn:"urn:lex:br:federal:lei:1956-08-02;2838", ementa:"Concede isenção de tributos a duas imagens, um   relógio e materiais destinados à Prelazia de Pinheiro, à Igreja de São João de   Tauape, à Matriz de Sumaré e à Associação Maternidade de São Paulo.", arquivo:"federal/leis-ordinarias/1956/lei-2838-1956-08-02.md"}}, {id:"federal:BR:L:3086/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-29", numero:"3086", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-29;3086", vigente:true, titulo:"Lei nº 3.086 de 29/12/1956", urn:"urn:lex:br:federal:lei:1956-12-29;3086", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério   da Viação e Obras Públicas, os créditos especiais de Cr$10.000.000,00 e Cr$   2.000.000,00 para auxiliar as comemorações dos primeiros centenários de elevação   de Juiz de Fora, no Estado de Minas Gerais, e Marquês de Valença, no Estado do   Rio de Janeiro, à categoria de cidades.", arquivo:"federal/leis-ordinarias/1956/lei-3086-1956-12-29.md"}}, {id:"federal:BR:L:2987/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-30", numero:"2987", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-30;2987", vigente:true, titulo:"Lei nº 2.987 de 30/11/1956", urn:"urn:lex:br:federal:lei:1956-11-30;2987", ementa:"Altera disposições da Lei nº 2.368, de 9 de dezembro de 1954 - Orçamento   da União para 1955.", arquivo:"federal/leis-ordinarias/1956/lei-2987-1956-11-30.md"}}, {id:"federal:BR:L:2772/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-05-08", numero:"2772", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-05-08;2772", vigente:true, titulo:"Lei nº 2.772 de 08/05/1956", urn:"urn:lex:br:federal:lei:1956-05-08;2772", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Saúde, o crédito   especial de Cr$ 2.500.000,00 para atender a despesas decorrentes da execução da   Lei n.º 1.944, de 14 da agosto de 1953.", arquivo:"federal/leis-ordinarias/1956/lei-2772-1956-05-08.md"}}, {id:"federal:BR:L:3004/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-14", numero:"3004", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-14;3004", vigente:true, titulo:"Lei nº 3.004 de 14/12/1956", urn:"urn:lex:br:federal:lei:1956-12-14;3004", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério   da Saúde, o crédito suplementar de Cr$ 1.680.000,00 para atender a despesas de   aluguel de imóveis ocupados por órgãos do Ministério.", arquivo:"federal/leis-ordinarias/1956/lei-3004-1956-12-14.md"}}, {id:"federal:BR:L:3051/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-12-21", numero:"3051", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-12-21;3051", vigente:true, titulo:"Lei nº 3.051 de 21/12/1956", urn:"urn:lex:br:federal:lei:1956-12-21;3051", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério   da Justiça e Negócios Interiores, o crédito especial de Cr$ 1.564.467,00,   destinado ao pagamento de servidores do Departamento de Produção do Território   do Acre.", arquivo:"federal/leis-ordinarias/1956/lei-3051-1956-12-21.md"}}, {id:"federal:BR:L:2881/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-09-21", numero:"2881", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-09-21;2881", vigente:true, titulo:"Lei nº 2.881 de 21/09/1956", urn:"urn:lex:br:federal:lei:1956-09-21;2881", ementa:"Autoriza o Poder Executivo a emitir pelo Ministério da Viação e Obras   Públicas - Departamento dos Correios e Telégrafos - uma série de selos   comemorativos do primeiro centenário da fundação do Colégio Arquidiocesano de   São Paulo.", arquivo:"federal/leis-ordinarias/1956/lei-2881-1956-09-21.md"}}, {id:"federal:BR:L:2955/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-17", numero:"2955", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-17;2955", vigente:true, titulo:"Lei nº 2.955 de 17/11/1956", urn:"urn:lex:br:federal:lei:1956-11-17;2955", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Justiça e Negócios Interiores,   o crédito especial de Cr$ 60.000.000,00, destinado a atender às despesas   com o reaparelhamento da rede de estabelecimentos penais do Distrito   Federal.", arquivo:"federal/leis-ordinarias/1956/lei-2955-1956-11-17.md"}}, {id:"federal:BR:L:2845/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-08-13", numero:"2845", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-08-13;2845", vigente:true, titulo:"Lei nº 2.845 de 13/08/1956", urn:"urn:lex:br:federal:lei:1956-08-13;2845", ementa:"Concede a pensão especial de Cr$ 1.000,00 a Maria   Gurgel Braga Herbster, viúva de Raimundo Herbster, coletor federal aposentado em   Maranguape, Estado do Ceará, falecido em 1941.", arquivo:"federal/leis-ordinarias/1956/lei-2845-1956-08-13.md"}}, {id:"federal:BR:L:2966/1956", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-24", numero:"2966", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-24;2966", vigente:true, titulo:"Lei nº 2.966 de 24/11/1956", urn:"urn:lex:br:federal:lei:1956-11-24;2966", ementa:"Concede a pensão especial de Cr$ 3.000,00 mensais a Amarilis de Azevedo   Moreira, viúva do major da revolução acreana Leôncio Moreira.", arquivo:"federal/leis-ordinarias/1956/lei-2966-1956-11-24.md"}}, {id:"federal:BR:L:2973/1956", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1956, data:"1956-11-26", numero:"2973", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1956-11-26;2973", vigente:true, titulo:"Lei nº 2.973 de 26/11/1956", urn:"urn:lex:br:federal:lei:1956-11-26;2973", ementa:"Prorroga a vigência das medidas de ordem financeira relacionadas com a execução do Plano de Desenvolvimento Econômico previstas nas Leis n.º 1.474, de 26 de novembro de 1951, e 1.628, de 20 de junho de 1952, e dá outras providências.", arquivo:"federal/leis-o