cia_origem:"revogada=false", ano:1984, data:"1984-12-10", numero:"7276", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-10;7276", vigente:true, titulo:"Lei nº 7.276 de 10/12/1984", urn:"urn:lex:br:federal:lei:1984-12-10;7276", ementa:"Estima a Receita e fixa a Despesa da União para o Exercício Financeiro de 1985.", arquivo:"federal/leis-ordinarias/1984/lei-7276-1984-12-10.md"}}, {id:"federal:BR:L:7247/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-11-13", numero:"7247", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-11-13;7247", vigente:true, titulo:"Lei nº 7.247 de 13/11/1984", urn:"urn:lex:br:federal:lei:1984-11-13;7247", ementa:"Dispõe sobre a criação e extinção de cargos na Secretaria do Tribunal do   Trabalho de Terceira Região e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7247-1984-11-13.md"}}, {id:"federal:BR:L:7228/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-10-15", numero:"7228", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-10-15;7228", vigente:true, titulo:"Lei nº 7.228 de 15/10/1984", urn:"urn:lex:br:federal:lei:1984-10-15;7228", ementa:"Autoriza o Poder Executivo a abrir à Presidência da República, em favor do Hospital das Forças Armadas, o crédito especial de Cr$ 112.000.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/1984/lei-7228-1984-10-15.md"}}] AS row
