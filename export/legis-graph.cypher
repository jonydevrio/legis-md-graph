/lei-1125-1950-06-07.md"}}, {id:"federal:BR:L:1174/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-08-10", numero:"1174", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-08-10;1174", vigente:true, titulo:"Lei nº 1.174 de 10/08/1950", urn:"urn:lex:br:federal:lei:1950-08-10;1174", ementa:"Derroga o art. 30 do Decreto-Lei n° 5.625, de 28 de junho de 1943,   referente ao magistério militar.", arquivo:"federal/leis-ordinarias/1950/lei-1174-1950-08-10.md"}}, {id:"federal:BR:L:1155/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-07-12", numero:"1155", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-07-12;1155", vigente:true, titulo:"Lei nº 1.155 de 12/07/1950", urn:"urn:lex:br:federal:lei:1950-07-12;1155", ementa:"Dá nova denominação à Estrada de Ferro Central do Rio Grande do Norte.", arquivo:"federal/leis-ordinarias/1950/lei-1155-1950-07-12.md"}}, {id:"federal:BR:L:1079/1950", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-04-10", numero:"1079", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-04-10;1079", vigente:true, titulo:"Lei nº 1.079 de 10/04/1950", urn:"urn:lex:br:federal:lei:1950-04-10;1079", ementa:"Define os crimes de responsabilidade e regula o respectivo processo de julgamento.", arquivo:"federal/leis-ordinarias/1950/lei-1079-1950-04-10.md"}}, {id:"federal:BR:L:1140/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-06-19", numero:"1140", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-06-19;1140", vigente:true, titulo:"Lei nº 1.140 de 19/06/1950", urn:"urn:lex:br:federal:lei:1950-06-19;1140", ementa:"Concede isenção de direitos de importa