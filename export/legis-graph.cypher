iginal", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-10-27", numero:"9852", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-10-27;9852", vigente:true, titulo:"Lei nº 9.852 de 27/10/1999", urn:"urn:lex:br:federal:lei:1999-10-27;9852", ementa:"Altera a Lei n. 5917, de 10 de setembro de 1973, que aprova o Plano Nacional de Viação, de modo a incluir na Relação Descritiva dos Portos Marítimos, Fluviais e Lacustres do Sistema Portuário Nacional os portos que especifica.", arquivo:"federal/leis-ordinarias/1999/lei-9852-1999-10-27.md"}}, {id:"federal:BR:L:9868/1999", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-11-10", numero:"9868", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-11-10;9868", vigente:true, titulo:"Lei nº 9.868 de 10/11/1999", urn:"urn:lex:br:federal:lei:1999-11-10;9868", ementa:"Dispõe sobre o processo e julgamento da ação direta de inconstitucionalidade e da ação declaratória de constitucionalidade perante o Supremo Tribunal Federal.", arquivo:"federal/leis-ordinarias/1999/lei-9868-1999-11-10.md"}}, {id:"federal:BR:L:9945/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-22", numero:"9945", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-12-22;9945", vigente:true, titulo:"Lei nº 9.945 de 22/12/1999", urn:"urn:lex:br:federal:lei:1999-12-22;9945", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor de diversos Órgãos, crédito suplementar no valor global de R$ 5.438.926,00, para reforço de dotações consignadas nos vigentes orçamentos.", arquivo:"federal/leis-ordinarias/1999/lei-9945-1999-12-22.md"}}, {id:"federal:BR:L:9908/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-14", 