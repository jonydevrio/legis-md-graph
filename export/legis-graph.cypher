tulo:"Lei nº 4.162 de 04/12/1962", urn:"urn:lex:br:federal:lei:1962-12-04;4162", ementa:"Altera a redação da letra \"l\", do artigo 88 do Código de Justiça Militar (Decreto-lei nº 925, de 2 de dezembro de 1938).", arquivo:"federal/leis-ordinarias/1962/lei-4162-1962-12-04.md"}}, {id:"federal:BR:L:4076/1962", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1962, data:"1962-06-23", numero:"4076", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1962-06-23;4076", vigente:true, titulo:"Lei nº 4.076 de 23/06/1962", urn:"urn:lex:br:federal:lei:1962-06-23;4076", ementa:"Que regula o exercício da profissão de geólogo.", arquivo:"federal/leis-ordinarias/1962/lei-4076-1962-06-23.md"}}, {id:"federal:BR:L:4184/1962", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1962, data:"1962-12-17", numero:"4184", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1962-12-17;4184", vigente:true, titulo:"Lei nº 4.184 de 17/12/1962", urn:"urn:lex:br:federal:lei:1962-12-17;4184", ementa:"Concede isenção de lincença prévia e de imposto de importação e outros tributos e taxas para donativos consignados à Conferência de Bispos do Brasil.", arquivo:"federal/leis-ordinarias/1962/lei-4184-1962-12-17.md"}}, {id:"federal:BR:L:4156/1962", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1962, data:"1962-11-28", numero:"4156", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1962-11-28;4156", vigente:true, titulo:"Lei nº 4.156 de 28/11/1962", urn:"urn:lex:br:federal:lei:1962-11-28;4156", ementa:"Altera a legislação sobre o Fundo Federal de Eletrificação e dá outras providências.", arquivo:"federal/leis-ordinarias/1962/lei-4156-1962-11-28.md"}}, {id:"federal:BR:L:4195/1962", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", v