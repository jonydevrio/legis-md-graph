ementa:"Institui o Conselho Nacional de Transportes e dá outras providências.", arquivo:"federal/leis-ordinarias/1964/lei-4563-1964-12-11.md"}}, {id:"federal:BR:L:4590/1964", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-12-11", numero:"4590", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-12-11;4590", vigente:true, titulo:"Lei nº 4.590 de 11/12/1964", urn:"urn:lex:br:federal:lei:1964-12-11;4590", ementa:"Dispõe sobre o custeio pela União, no exercício de 1960, dos serviços públicos transferidos para o Estado da Guanabara pela Lei n. 3752, de 14 de abril de 1960.", arquivo:"federal/leis-ordinarias/1964/lei-4590-1964-12-11.md"}}, {id:"federal:BR:L:4491/1964", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-11-21", numero:"4491", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-11-21;4491", vigente:true, titulo:"Lei nº 4.491 de 21/11/1964", urn:"urn:lex:br:federal:lei:1964-11-21;4491", ementa:"Altera disposições de Lei nº 3780, de 12 de julho de 1960 (Plano de Reclassificação), relativas às séries de classes de Impressor, Encadernador, Mestre e Técnico de Artes Gráficas e dá outras providências.", arquivo:"federal/leis-ordinarias/1964/lei-4491-1964-11-21.md"}}, {id:"federal:BR:L:4424/1964", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-10-08", numero:"4424", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-10-08;4424", vigente:true, titulo:"Lei nº 4.424 de 08/10/1964", urn:"urn:lex:br:federal:lei:1964-10-08;4424", ementa:"Autoriza a abertura de crédito especial ao Tribunal Regional Eleitoral do   Piuaí, para pagamento de dívida de execícios findos.", arquivo:"federal/leis-ordinarias/1964/lei-4424-1964-10-08.md"}}, {id:"federal:BR:L:4480/1964", properties:{esfe