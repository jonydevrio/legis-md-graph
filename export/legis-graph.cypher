ogada=false", ano:1949, data:"1949-06-16", numero:"744", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-06-16;744", vigente:true, titulo:"Lei nº 744 de 16/06/1949", urn:"urn:lex:br:federal:lei:1949-06-16;744", ementa:"Concede auxílio ao Hospital de Caridade Santa Rosália, de Teófilo Otoni,   Minas Gerais.", arquivo:"federal/leis-ordinarias/1949/lei-744-1949-06-16.md"}}, {id:"federal:BR:L:757/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-07-11", numero:"757", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-07-11;757", vigente:true, titulo:"Lei nº 757 de 11/07/1949", urn:"urn:lex:br:federal:lei:1949-07-11;757", ementa:"Abre, pelo Ministério da Agricultura, o crédito especial de Cr$   11.897.045,40, para pagamento da indenização devida pela desapropriação das   terras da Fazenda Nossa Senhora da Ajuda.", arquivo:"federal/leis-ordinarias/1949/lei-757-1949-07-11.md"}}, {id:"federal:BR:L:867/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-10-15", numero:"867", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-10-15;867", vigente:true, titulo:"Lei nº 867 de 15/10/1949", urn:"urn:lex:br:federal:lei:1949-10-15;867", ementa:"Estende ao Pessoal das Secretarias do Tribunal Superior Eleitoral e dos Tribunais Regionais Eleitorais dispositivos da Lei nº 488, de 15 de novembro de 1948.", arquivo:"federal/leis-ordinarias/1949/lei-867-1949-10-15.md"}}, {id:"federal:BR:L:682/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-04-26", numero:"682", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-04-26;682", vigente:true, titulo:"Lei nº 682 de 26/04/1949", urn:"urn:lex:br:federal:lei:1949-04-26;682", ementa:"Dispõe sobre a nomeação para os cargos vagos da classe inicial da carreira   de Bibliotecário dos atuais bibliotecários-auxiliares.", arquivo:"federal/leis-ordinarias/1949/lei-682-1949-04-26.md"}}, {id:"federal:BR:L:638/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-02-27", numero:"638", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-02-27;638", vigente:true, titulo:"Lei nº 638 de 27/02/1949", urn:"urn:lex:br:federal:lei:1949-02-27;638", ementa:"Concede isenção de direitos de importação e taxas aduaneiras e imposto de   consumo social para fim que especifica.", arquivo:"federal/leis-ordinarias/1949/lei-638-1949-02-27.md"}}, {id:"federal:BR:L:949/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-12-03", numero:"949", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-12-03;949", vigente:true, titulo:"Lei nº 949 de 03/12/1949", urn:"urn:lex:br:federal:lei:1949-12-03;949", ementa:"Prorroga o prazo a que se refere a letra a do artigo 5º do Decreto-lei nº   9.544, de 5 de agosto de 1946.", arquivo:"federal/leis-ordinarias/1949/lei-949-1949-12-03.md"}}, {id:"federal:BR:L:664/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-04-08", numero:"664", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-04-08;664", vigente:true, titulo:"Lei nº 664 de 08/04/1949", urn:"urn:lex:br:federal:lei:1949-04-08;664", ementa:"Autoriza a abrir, pelo Ministério da Educação e Saúde, o crédito especial   de Cr$ 18.480,00 para o fim que especifica.", arquivo:"federal/leis-ordinarias/1949/lei-664-1949-04-08.md"}}, {id:"federal:BR:L:934/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-11-28", numero:"934", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:194