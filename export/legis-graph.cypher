"federal/leis-ordinarias/1983/lei-7097-1983-05-23.md"}}, {id:"federal:BR:L:7146/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1983, data:"1983-11-23", numero:"7146", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1983-11-23;7146", vigente:true, titulo:"Lei nº 7.146 de 23/11/1983", urn:"urn:lex:br:federal:lei:1983-11-23;7146", ementa:"Fixa os valores de retribuição do Grupo - Atividades de Comercialização e   Classificação de Café, e dá outras providências.", arquivo:"federal/leis-ordinarias/1983/lei-7146-1983-11-23.md"}}, {id:"federal:BR:L:7135/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1983, data:"1983-10-26", numero:"7135", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1983-10-26;7135", vigente:true, titulo:"Lei nº 7.135 de 26/10/1983", urn:"urn:lex:br:federal:lei:1983-10-26;7135", ementa:"Altera a redação da Lei nº 6686, de 11 de setembro de 1979, que   dispõe sobre o exercício da análise clínico-laboratorial, e determina   outras providências.", arquivo:"federal/leis-ordinarias/1983/lei-7135-1983-10-26.md"}}, {id:"federal:BR:L:7161/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1983, data:"1983-12-07", numero:"7161", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1983-12-07;7161", vigente:true, titulo:"Lei nº 7.161 de 07/12/1983", urn:"urn:lex:br:federal:lei:1983-12-07;7161", ementa:"Cria o Quadro Permanente da Secretaria do Tribunal Regional Eleitoral do   Estado de Rondônia, e dá outras providências.", arquivo:"federal/leis-ordinarias/1983/lei-7161-1983-12-07.md"}}, {id:"federal:BR:L:7172/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1983, data:"1983-12-14", numero:"7172", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei: