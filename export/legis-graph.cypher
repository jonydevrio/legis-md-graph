br/?urn=urn:lex:br:federal:lei:1947-09-09;87", vigente:true, titulo:"Lei nº 87 de 09/09/1947", urn:"urn:lex:br:federal:lei:1947-09-09;87", ementa:"Dispõe sôbre o tratamento dos Juízes do Tribunal Federal de   Recursos.", arquivo:"federal/leis-ordinarias/1947/lei-87-1947-09-09.md"}}, {id:"federal:BR:L:56/1947", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1947, data:"1947-08-06", numero:"56", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1947-08-06;56", vigente:true, titulo:"Lei nº 56 de 06/08/1947", urn:"urn:lex:br:federal:lei:1947-08-06;56", ementa:"Autoriza a abertura do crédito especial de Cr$ 300.000,00 para despesas   com o transporte do Arquivo da Casa Imperial.", arquivo:"federal/leis-ordinarias/1947/lei-56-1947-08-06.md"}}, {id:"federal:BR:L:45/1947", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1947, data:"1947-07-09", numero:"45", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1947-07-09;45", vigente:true, titulo:"Lei nº 45 de 09/07/1947", urn:"urn:lex:br:federal:lei:1947-07-09;45", ementa:"Abre ao Ministério da Viação e Obras Públicas o crédito especial de Cr$   14.543.120,00, para atender a despesas com melhoramentos e aparelhamento do   Estrada de Ferro Dona Teresa Cristina.", arquivo:"federal/leis-ordinarias/1947/lei-45-1947-07-09.md"}}, {id:"federal:BR:L:131/1947", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1947, data:"1947-10-30", numero:"131", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1947-10-30;131", vigente:true, titulo:"Lei nº 131 de 30/10/1947", urn:"urn:lex:br:federal:lei:1947-10-30;131", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Saúde, o   crédito especial de Cr$ 8.229,20 para pagar diferença de gratificação de   magistério ao Professor Ataliba.", arquivo:"federal/leis