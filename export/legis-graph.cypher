06-03;8881", ementa:"Dá nova redação ao caput     do art. 11 da Lei Delegada nº 4, de 26 de   setembro de 1962, e dá outras providências.", arquivo:"federal/leis-ordinarias/1994/lei-8881-1994-06-03.md"}}, {id:"federal:BR:L:8890/1994", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1994, data:"1994-06-21", numero:"8890", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1994-06-21;8890", vigente:true, titulo:"Lei nº 8.890 de 21/06/1994", urn:"urn:lex:br:federal:lei:1994-06-21;8890", ementa:"Concede abono especial aos servidores públicos civis   e militares da Administração Federal direta, autárquica e fundacional e dá outras   providências.", arquivo:"federal/leis-ordinarias/1994/lei-8890-1994-06-21.md"}}, {id:"federal:BR:L:8906/1994", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1994, data:"1994-07-04", numero:"8906", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1994-07-04;8906", vigente:true, titulo:"Lei nº 8.906 de 04/07/1994", urn:"urn:lex:br:federal:lei:1994-07-04;8906", ementa:"Dispõe sobre o Estatuto da Advocacia e a Ordem dos Advogados do Brasil - OAB.", arquivo:"federal/leis-ordinarias/1994/lei-8906-1994-07-04.md"}}, {id:"federal:BR:L:8936/1994", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1994, data:"1994-11-24", numero:"8936", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1994-11-24;8936", vigente:true, titulo:"Lei nº 8.936 de 24/11/1994", urn:"urn:lex:br:federal:lei:1994-11-24;8936", ementa:"Altera dispositivos dos arts. 9° e 10 da Lei n° 8.918, de 14 de julho de   1994.", arquivo:"federal/leis-ordinarias/1994/lei-8936-1994-11-24.md"}}, {id:"federal:BR:L:8944/1994", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1994, data:"1994-11-25", 