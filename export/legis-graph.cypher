:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-01-11", numero:"2399", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-01-11;2399", vigente:true, titulo:"Lei nº 2.399 de 11/01/1955", urn:"urn:lex:br:federal:lei:1955-01-11;2399", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura   o crédito especial de Cr$ 365.007,60 , para pagamento de fornecimentos e   serviços à Escola Técnica de Manaus.", arquivo:"federal/leis-ordinarias/1955/lei-2399-1955-01-11.md"}}, {id:"federal:BR:L:2493/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-05-21", numero:"2493", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-05-21;2493", vigente:true, titulo:"Lei nº 2.493 de 21/05/1955", urn:"urn:lex:br:federal:lei:1955-05-21;2493", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura o crédito especial de Cr$ 694.844,60, para atender ao pagamento de fornecimentos feitos, no exercício de 1952, a diversos órgãos do mesmo Ministério.", arquivo:"federal/leis-ordinarias/1955/lei-2493-1955-05-21.md"}}, {id:"federal:BR:L:2388/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-01-04", numero:"2388", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-01-04;2388", vigente:true, titulo:"Lei nº 2.388 de 04/01/1955", urn:"urn:lex:br:federal:lei:1955-01-04;2388", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Justiça e Negócios   Interiores, o crédito especial de Cr$ 2.066.000,00 para atender a despesas com o   pagamento de etapas de alimentação do pessoal do Corpo de Bombeiros do Distrito   Federal.", arquivo:"federal/leis-ordinarias/1955/lei-2388-1955-01-04.md"}}, {id:"federal:BR:L:2610/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-09-22", numero:"2610", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-09-22;2610", vigente:true, titulo:"Lei nº 2.610 de 22/09/1955", urn:"urn:lex:br:federal:lei:1955-09-22;2610", ementa:"Estende ;à correspondência da Cruz Vermelha Brasileira o disposto no § 5º do art. 26 da Lei n° 498, de 28 de novembro de 1948 (Reajusta as tarifas postais telegráficas e dá outras providências).", arquivo:"federal/leis-ordinarias/1955/lei-2610-1955-09-22.md"}}, {id:"federal:BR:L:2445/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-03-31", numero:"2445", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-03-31;2445", vigente:true, titulo:"Lei nº 2.445 de 31/03/1955", urn:"urn:lex:br:federal:lei:1955-03-31;2445", ementa:"Concede à Comissão Federal de Abastecimento e Preços isenção de direitos   de importação e mais taxas aduaneiras, para a importação dos gêneros   alimentícios de primeira necessidade e dos artigos de indispensável consumo   popular.", arquivo:"federal/leis-ordinarias/1955/lei-2445-1955-03-31.md"}}, {id:"federal:BR:L:2451/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-04-06", numero:"2451", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-04-06;2451", vigente:true, titulo:"Lei nº 2.451 de 06/04/1955", urn:"urn:lex:br:federal:lei:1955-04-06;2451", ementa:"Concede isenção de direitos, taxas aduaneiras e de imposto de consumo, para cinco imagens de mármore, destinadas ao Colégio Regina Coeli.", arquivo:"federal/leis-ordinarias/1955/lei-2451-1955-04-06.md"}}, {id:"federal:BR:L:2540/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-07-13", numero:"2540", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-07-13;2540", vigente:true, titulo:"Lei nº 2.540 de 13/07/1955", urn:"urn:lex:br:federal:lei:1955-07-13;2540", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 2.500.000,00 para pagamento de subvenção à Faculdade   de Filosofia, Ciência e Letras de São Bento, da Pontifícia Universidade Católica   de São Paulo.", arquivo:"federal/leis-ordinarias/1955/lei-2540-1955-07-13.md"}}, {id:"federal:BR:L:2385/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-01-03", numero:"2385", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-01-03;2385", vigente:true, titulo:"Lei nº 2.385 de 03/01/1955", urn:"urn:lex:br:federal:lei:1955-01-03;2385", ementa:"Concede favores aos devedores hipotecários das Caixas Econômicas   Federais.", arquivo:"federal/leis-ordinarias/1955/lei-2385-1955-01-03.md"}}, {id:"federal:BR:L:2622/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-10-18", numero:"2622", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-10-18;2622", vigente:true, titulo:"Lei nº 2.622 de 18/10/1955", urn:"urn:lex:br:federal:lei:1955-10-18;2622", ementa:"Procede à revisão obrigatória dos proventos dos servidores inativos civis da União, bem como aos dos servidores das autarquias e entidades paraestatais.", arquivo:"federal/leis-ordinarias/1955/lei-2622-1955-10-18.md"}}, {id:"federal:BR:L:2627/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-10-22", numero:"2627", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-10-22;2627", vigente:true, titulo:"Lei nº 2.627 de 22/10/1955", urn:"urn:lex:br:federal:lei:1955-10-22;2627", ementa:"Autoriza o Poder Executivo a abrir, ao Poder Judiciário - Justiça do Trabalho - o crédito suplementar de Cr$ 16.500.000,00, em reforço das Verbas 1 - Pessoal e 3 - Serviços e Encargos - para ocorrer às despesas com o pagamento de vencimentos e gratificações adicional aos magistrados e funcionários e sentenças judiciárias do Tribunal Superior do Trabalho.", arquivo:"federal/leis-ordinarias/1955/lei-2627-1955-10-22.md"}}, {id:"federal:BR:L:2455/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-04-20", numero:"2455", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-04-20;2455", vigente:true, titulo:"Lei nº 2.455 de 20/04/1955", urn:"urn:lex:br:federal:lei:1955-04-20;2455", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça   Eleitoral, Tribunal Regional Eleitoral de Minas Gerais, o crédito especial de   Cr$ 2.280,00, para ocorrer às despesas com mensalistas do quadro da Secretaria   do mesmo Tribunal.", arquivo:"federal/leis-ordinarias/1955/lei-2455-1955-04-20.md"}}, {id:"federal:BR:L:2440/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-03-09", numero:"2440", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-03-09;2440", vigente:true, titulo:"Lei nº 2.440 de 09/03/1955", urn:"urn:lex:br:federal:lei:1955-03-09;2440", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 195.261.000,00 para ocorrer a despesas com concessão de auxílio à Companhia Nacional de Navegação Costeira.", arquivo:"federal/leis-ordinarias/1955/lei-2440-1955-03-09.md"}}, {id:"federal:BR:L:2462/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-04-22", numero:"2462", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-04-22;2462", vigente:true, titulo:"Lei nº 2.462 de 22/04/1955", urn:"urn:lex:br:federal:lei:1955-04-22;2462", ementa:"Concede isenção de direitos de importação e mais taxas aduaneiras para   material a ser importado pela firma Heraud Freres para instalação de uma fábrica   de caldeiras, artigos sanitários e máquinas agrícolas no município de Canoas,   Estado do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1955/lei-2462-1955-04-22.md"}}, {id:"federal:BR:L:2516/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-07-01", numero:"2516", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-07-01;2516", vigente:true, titulo:"Lei nº 2.516 de 01/07/1955", urn:"urn:lex:br:federal:lei:1955-07-01;2516", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o crédito especial de Cr$ 43.966,70, para atender ao pagamento de gratificações de magistério devidas ao Professor Catedrático, padrão \"o\", Leon Monteiro Wilwerth.", arquivo:"federal/leis-ordinarias/1955/lei-2516-1955-07-01.md"}}, {id:"federal:BR:L:2530/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-07-05", numero:"2530", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-07-05;2530", vigente:true, titulo:"Lei nº 2.530 de 05/07/1955", urn:"urn:lex:br:federal:lei:1955-07-05;2530", ementa:"Concede isenção de imposto de consumo para uma custódia destinada às   solenidades do XXXVI Congresso Eucarístico Internacional.", arquivo:"federal/leis-ordinarias/1955/lei-2530-1955-07-05.md"}}, {id:"federal:BR:L:2432/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-02-27", numero:"2432", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-02-27;2432", vigente:true, titulo:"Lei nº 2.432 de 27/02/1955", urn:"urn:lex:br:federal:lei:1955-02-27;2432", ementa:"Modifica o art. 1º da Lei n° 1.122, de 3 de junho de 1950.", arquivo:"federal/leis-ordinarias/1955/lei-2432-1955-02-27.md"}}, {id:"federal:BR:L:2662/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-12-03", numero:"2662", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-12-03;2662", vigente:true, titulo:"Lei nº 2.662 de 03/12/1955", urn:"urn:lex:br:federal:lei:1955-12-03;2662", ementa:"Concede a subvenção anual de Cr$ 1.300.000,00, durante dez anos   consecutivos, ao Colégio Anchieta, de Porto Alegre, Estado do Rio Grande do   Sul.", arquivo:"federal/leis-ordinarias/1955/lei-2662-1955-12-03.md"}}, {id:"federal:BR:L:2395/1955", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-01-11", numero:"2395", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-01-11;2395", vigente:true, titulo:"Lei nº 2.395 de 11/01/1955", urn:"urn:lex:br:federal:lei:1955-01-11;2395", ementa:"Cria dois Distritos de 1ª Classe no Departamento Nacional de Obras e dá   outras providências.", arquivo:"federal/leis-ordinarias/1955/lei-2395-1955-01-11.md"}}, {id:"federal:BR:L:2473/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-04-28", numero:"2473", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-04-28;2473", vigente:true, titulo:"Lei nº 2.473 de 28/04/1955", urn:"urn:lex:br:federal:lei:1955-04-28;2473", ementa:"Autoriza o Poder Executivo a abrir, pelo Conselho Nacional de Economia, o   crédito especial de Cr$ 506.333,00, para pagamento de aluguéis vencidos à   Imobiliária Seguradoras Reunidas S.A.", arquivo:"federal/leis-ordinarias/1955/lei-2473-1955-04-28.md"}}, {id:"federal:BR:L:2467/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-04-25", numero:"2467", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-04-25;2467", vigente:true, titulo:"Lei nº 2.467 de 25/04/1955", urn:"urn:lex:br:federal:lei:1955-04-25;2467", ementa:"Concede isenção de direitos de importação, inclusive imposto de consumo e   mais taxas, para um conjunto completo de trasmissor de televisão destinado à   Rádio Record S.A.", arquivo:"federal/leis-ordinarias/1955/lei-2467-1955-04-25.md"}}, {id:"federal:BR:L:2647/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-11-18", numero:"2647", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-11-18;2647", vigente:true, titulo:"Lei nº 2.647 de 18/11/1955", urn:"urn:lex:br:federal:lei:1955-11-18;2647", ementa:"Autoriza o Poder Executivo a abrir, pelo Mnistério da Educação e Cultura, o crédito especial de Cr$ 600.000,00, destinado a auxiliar a realização do VI Congresso Nacional de Jornalismo, na cidade de Belo Horizonte, Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/1955/lei-2647-1955-11-18.md"}}, {id:"federal:BR:L:2487/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-05-13", numero:"2487", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-05-13;2487", vigente:true, titulo:"Lei nº 2.487 de 13/05/1955", urn:"urn:lex:br:federal:lei:1955-05-13;2487", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações Exteriores, o crédito especial de Cr$ 850.000,00, destinado a ocorrer ao pagamento de contribuição do Brasil para o Programa Ampliado de Assistência Técnica da Organização das Nações Unidas.", arquivo:"federal/leis-ordinarias/1955/lei-2487-1955-05-13.md"}}, {id:"federal:BR:L:2529/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-07-05", numero:"2529", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-07-05;2529", vigente:true, titulo:"Lei nº 2.529 de 05/07/1955", urn:"urn:lex:br:federal:lei:1955-07-05;2529", ementa:"Concede o auxílio especial de Cr$ 400.000,00 destinado ao custeio das   comemorações do centenário da cidade de Bragança, Estado do Pará.", arquivo:"federal/leis-ordinarias/1955/lei-2529-1955-07-05.md"}}, {id:"federal:BR:L:2638/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-11-09", numero:"2638", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-11-09;2638", vigente:true, titulo:"Lei nº 2.638 de 09/11/1955", urn:"urn:lex:br:federal:lei:1955-11-09;2638", ementa:"Retifica, sem ônus, a Lei n° 2.368, de 9 de dezembro de 1954, que estima a receita e fixa a despesa para o exercício financeiro de 1955.", arquivo:"federal/leis-ordinarias/1955/lei-2638-1955-11-09.md"}}, {id:"federal:BR:L:2605/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-09-17", numero:"2605", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-09-17;2605", vigente:true, titulo:"Lei nº 2.605 de 17/09/1955", urn:"urn:lex:br:federal:lei:1955-09-17;2605", ementa:"Extingue o cargo de Diretor, padrão \"L\", no Quadro Suplementar do Ministério da Justiça e Negócios Interiores.", arquivo:"federal/leis-ordinarias/1955/lei-2605-1955-09-17.md"}}, {id:"federal:BR:L:2583/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-08-31", numero:"2583", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-08-31;2583", vigente:true, titulo:"Lei nº 2.583 de 31/08/1955", urn:"urn:lex:br:federal:lei:1955-08-31;2583", ementa:"Concede pensão especial de Cr$ 2.400,00, à Corina da Rocha Paraíso Godinho.", arquivo:"federal/leis-ordinarias/1955/lei-2583-1955-08-31.md"}}, {id:"federal:BR:L:2667/