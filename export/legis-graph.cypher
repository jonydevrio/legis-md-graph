11/2003", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2003, data:"2003-12-12", numero:"10811", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2003-12-12;10811", vigente:true, titulo:"Lei nº 10.811 de 12/12/2003", urn:"urn:lex:br:federal:lei:2003-12-12;10811", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor dos Ministérios da Previdência Social, do Trabalho e Emprego e da Assistência Social, crédito suplementar no valor global de R$ 230.475.440,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2003/lei-10811-2003-12-12.md"}}, {id:"federal:BR:L:10698/2003", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2003, data:"2003-07-02", numero:"10698", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2003-07-02;10698", vigente:true, titulo:"Lei nº 10.698 de 02/07/2003", urn:"urn:lex:br:federal:lei:2003-07-02;10698", ementa:"Dispõe sobre a instituição de vantagem pecuniária individual devida aos servidores públicos civis da Administração Federal direta, autárquica e fundacional.", arquivo:"federal/leis-ordinarias/2003/lei-10698-2003-07-02.md"}}, {id:"federal:BR:L:10692/2003", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2003, data:"2003-06-18", numero:"10692", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2003-06-18;10692", vigente:true, titulo:"Lei nº 10.692 de 18/06/2003", urn:"urn:lex:br:federal:lei:2003-06-18;10692", ementa:"Altera o Quadro VI da Lei nº 10.640, de 14 de janeiro de 2003.", arquivo:"federal/leis-ordinarias/2003/lei-10692-2003-06-18.md"}}, {id:"federal:BR:L:10803/2003", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2003, data:"2003-12-11", numero:"10803", fonte:"https://normas.