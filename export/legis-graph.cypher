i Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-11-24", numero:"5739", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-11-24;5739", vigente:true, titulo:"Lei nº 5.739 de 24/11/1971", urn:"urn:lex:br:federal:lei:1971-11-24;5739", ementa:"Dispõe sobre cargos do Quadro da Secretaria do Supremo Tribunal   Federal.", arquivo:"federal/leis-ordinarias/1971/lei-5739-1971-11-24.md"}}, {id:"federal:BR:L:5653/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-04-27", numero:"5653", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-04-27;5653", vigente:true, titulo:"Lei nº 5.653 de 27/04/1971", urn:"urn:lex:br:federal:lei:1971-04-27;5653", ementa:"Altera o art. 19 do Decreto-Lei nº 3.200, de 19 de abril de 1941, alterado   pela Lei n. 2514, de 27 de junho de 1955, que dispõe sobre bem de   família.", arquivo:"federal/leis-ordinarias/1971/lei-5653-1971-04-27.md"}}, {id:"federal:BR:L:5666/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-06-21", numero:"5666", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-06-21;5666", vigente:true, titulo:"Lei nº 5.666 de 21/06/1971", urn:"urn:lex:br:federal:lei:1971-06-21;5666", ementa:"Concede pensão especial vitalícia à pianista Aurora Bruzon   Majdalany.", arquivo:"federal/leis-ordinarias/1971/lei-5666-1971-06-21.md"}}, {id:"federal:BR:L:5759/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-03", numero:"5759", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-03;5759", vigente:true, titulo:"Lei nº 5.759 de 03/12/1971", urn:"urn:lex:br:federal:lei:1971-12-03;5759", ementa:"Acrescenta parágrafos ao artigo 11 do Decreto-lei nº ;55, de 18 de novembro de 1966, que define a política nacional do turismo, cria o Conselho Nacional do Turismo e a Empresa Brasileira de Turismo e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5759-1971-12-03.md"}}, {id:"federal:BR:L:5674/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-07-12", numero:"5674", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-07-12;5674", vigente:true, titulo:"Lei nº 5.674 de 12/07/1971", urn:"urn:lex:br:federal:lei:1971-07-12;5674", ementa:"Concede aumento de vencimentos aos Funcionários da Secretaria da Câmara dos Deputados, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5674-1971-07-12.md"}}, {id:"federal:BR:L:5764/1971", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-16", numero:"5764", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-16;5764", vigente:true, titulo:"Lei nº 5.764 de 16/12/1971", urn:"urn:lex:br:federal:lei:1971-12-16;5764", ementa:"Define a Política Nacional de Cooperativismo, institui o regime jurídico das sociedades cooperativas, e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5764-1971-12-16.md"}}, {id:"federal:BR:L:5769/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-12-20", numero:"5769", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1971-12-20;5769", vigente:true, titulo:"Lei nº 5.769 de 20/12/1971", urn:"urn:lex:br:federal:lei:1971-12-20;5769", ementa:"Dispõe sobre a remuneração dos funcionários do Fisco do Distrito Federal,   e dá outras providências.", arquivo:"federal/leis-ordinarias/1971/lei-5769-1971-12-20.md"}}, {id:"federal:BR:L:5683/1971", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1971, data:"1971-07-21", numero:"5683",