3/lei-4268-1963-10-19.md"}}, {id:"federal:BR:L:3144/1882", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1882, data:"1882-10-30", numero:"3144", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1882-10-30;3144", vigente:true, titulo:"Lei nº 3.144 de 30/10/1882", urn:"urn:lex:br:federal:lei:1882-10-30;3144", ementa:"ABRE, AO MINISTERIO DOS NEGOCIOS DA AGRICULTURA, COMERCIO E OBRAS PUBLICAS UM CREDITO EXTRAORDINARIO DE 367:981$716, AFIM DE SER APLICADO A REPARAÇÕES NA FERROVIA DOM PEDRO II.", arquivo:"federal/leis-ordinarias/1882/lei-3144-1882-10-30.md"}}, {id:"federal:BR:L:3063/1882", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1882, data:"1882-04-08", numero:"3063", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1882-04-08;3063", vigente:true, titulo:"Lei nº 3.063 de 08/04/1882", urn:"urn:lex:br:federal:lei:1882-04-08;3063", ementa:"ABRE AO MINISTERIO DA MARINHA UM CREDITO SUPLEMENTAR DE 23:609$146, PARA SER APLICADO A DESPESA DA VERBA REFORMADOS, DO EXERCICIO DE 1879-1880.", arquivo:"federal/leis-ordinarias/1882/lei-3063-1882-04-08.md"}}, {id:"federal:BR:L:3085/1882", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1882, data:"1882-07-01", numero:"3085", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1882-07-01;3085", vigente:true, titulo:"Lei nº 3.085 de 01/07/1882", urn:"urn:lex:br:federal:lei:1882-07-01;3085", ementa:"AUTORIZA O GOVERNO A PAGAR, PELA VERBA - EXERCICIOS FINDOS - DO ORÇAMENTO VIGENTE A QUANTIA DE 2:400$000, NA IMPORTANCIA DE VENCIMENTOS DEVIDOS AO DESENHISTA DA REPARTIÇÃO HIDROGRAFICA, LAURIANO JOSE MARTINS PENHA JUNIOR, NOS EXERCICIOS DE 1877 - 1878 E 1878 - 1879.", arquivo:"federal/leis-ordinarias/1882/lei-3085-1882-07-01.md"}}, {id:"federal:BR:L:3111/1882", properties:{esfera:"federal", versao_texto:"original", ti