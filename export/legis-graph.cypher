aria.", arquivo:"federal/leis-ordinarias/1936/lei-240-1936-08-21.md"}}, {id:"federal:BR:L:273/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-10-13", numero:"273", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-10-13;273", vigente:true, titulo:"Lei nº 273 de 13/10/1936", urn:"urn:lex:br:federal:lei:1936-10-13;273", ementa:"Autoriza a abertura de um credito supplementar de réis   800:000$ á verba 4ª ; consignação \"Pessoal\", sub-consignação nº 1, do   orçamento do Ministerio das Relações Exteriores.", arquivo:"federal/leis-ordinarias/1936/lei-273-1936-10-13.md"}}, {id:"federal:BR:L:183/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-01-13", numero:"183", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-01-13;183", vigente:true, titulo:"Lei nº 183 de 13/01/1936", urn:"urn:lex:br:federal:lei:1936-01-13;183", ementa:"Concede abono provisório de vencimentos a todo o funccionário civil da União e dá outras providencias", arquivo:"federal/leis-ordinarias/1936/lei-183-1936-01-13.md"}}, {id:"federal:BR:L:172/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-01-06", numero:"172", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-01-06;172", vigente:true, titulo:"Lei nº 172 de 06/01/1936", urn:"urn:lex:br:federal:lei:1936-01-06;172", ementa:"Autoriza a abertura de credito para pagamento de subvenções", arquivo:"federal/leis-ordinarias/1936/lei-172-1936-01-06.md"}}, {id:"federal:BR:L:305/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-11-16", numero:"305", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-11