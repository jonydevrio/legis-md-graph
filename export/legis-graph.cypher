is-ordinarias/1978/lei-6564-1978-09-19.md"}}, {id:"federal:BR:L:6602/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-12-07", numero:"6602", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-12-07;6602", vigente:true, titulo:"Lei nº 6.602 de 07/12/1978", urn:"urn:lex:br:federal:lei:1978-12-07;6602", ementa:"Altera a redação da alínea i do artigo 5º do Decreto-lei nº 3.365, de 21 de junho de 1941, que dispõe sobre desapropriações por utilidade pública, e acrescenta parágrafos ao mesmo artigo.", arquivo:"federal/leis-ordinarias/1978/lei-6602-1978-12-07.md"}}, {id:"federal:BR:L:6611/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-12-07", numero:"6611", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-12-07;6611", vigente:true, titulo:"Lei nº 6.611 de 07/12/1978", urn:"urn:lex:br:federal:lei:1978-12-07;6611", ementa:"Dispõe sobre a criação de fundo especial, de natureza contábil, denominado Fundo   de Desenvolvimento de Recursos Humanos do Distrito Federal -   FUNDO-IDR.", arquivo:"federal/leis-ordinarias/1978/lei-6611-1978-12-07.md"}}, {id:"federal:BR:L:6568/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-09-24", numero:"6568", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-09-24;6568", vigente:true, titulo:"Lei nº 6.568 de 24/09/1978", urn:"urn:lex:br:federal:lei:1978-09-24;6568", ementa:"Autoriza a cessão ao Estado do Rio de Janeiro do imóvel que menciona e dá   outras providências.", arquivo:"federal/leis-ordinarias/1978/lei-6568-1978-09-24.md"}}, {id:"federal:BR:L:6582/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-10-20", numero:"6582", fonte:"https://normas.leg.br/?u