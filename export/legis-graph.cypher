 ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça Eleitoral - Tribunais Regionais Eleitorais do Rio Grande do Sul, do Estado do Rio de Janeiro e de Minas Gerais - o crédito especial de Cr$ 285.180,30 (duzentos e oitenta e cinco mil, cento e oitenta cruzeiros e trinta centavos), para atender às despesas correspondentes aos exercícios de 1958 e 1959.", arquivo:"federal/leis-ordinarias/1966/lei-5121-1966-09-27.md"}}, {id:"federal:BR:L:5092/1966", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1966, data:"1966-08-30", numero:"5092", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1966-08-30;5092", vigente:true, titulo:"Lei nº 5.092 de 30/08/1966", urn:"urn:lex:br:federal:lei:1966-08-30;5092", ementa:"Autoriza o Poder Executivo, pelo Ministério da Fazenda, a doar Obrigações Reajustáveis do Tesouro Nacional à Academia Brasileira de Ciências.", arquivo:"federal/leis-ordinarias/1966/lei-5092-1966-08-30.md"}}, {id:"federal:BR:L:5008/1966", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1966, data:"1966-05-27", numero:"5008", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1966-05-27;5008", vigente:true, titulo:"Lei nº 5.008 de 27/05/1966", urn:"urn:lex:br:federal:lei:1966-05-27;5008", ementa:"Isenta de tributos e emolumentos consulares bens destinados ao Mosteiro de São Bento, situado na Cidade de Salvador - Bahia.", arquivo:"federal/leis-ordinarias/1966/lei-5008-1966-05-27.md"}}, {id:"federal:BR:L:5064/1966", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1966, data:"1966-07-05", numero:"5064", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1966-07-05;5064", vigente:true, titulo:"Lei nº 5.064 de 05/07/1966", urn:"urn:lex:br:federal:lei:1966-07-05;5064", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação 