21", numero:"7076", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-12-21;7076", vigente:true, titulo:"Lei nº 7.076 de 21/12/1982", urn:"urn:lex:br:federal:lei:1982-12-21;7076", ementa:"Autoriza a Universidade Federal do Rio Grande do Sul a transferir, para o   patrimônio da Universidade Federal de Santa Maria, bens imóveis localizados em   Santa Maria, Estado do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1982/lei-7076-1982-12-21.md"}}, {id:"federal:BR:L:7013/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-07-08", numero:"7013", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-07-08;7013", vigente:true, titulo:"Lei nº 7.013 de 08/07/1982", urn:"urn:lex:br:federal:lei:1982-07-08;7013", ementa:"Dispõe sobre a criação de cargos na Secretaria do Tribunal Regional   Eleitoral do Estado de Pernambuco e dá outras providências.", arquivo:"federal/leis-ordinarias/1982/lei-7013-1982-07-08.md"}}, {id:"federal:BR:L:7064/1982", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-12-06", numero:"7064", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-12-06;7064", vigente:true, titulo:"Lei nº 7.064 de 06/12/1982", urn:"urn:lex:br:federal:lei:1982-12-06;7064", ementa:"Dispõe sobre a situação de trabalhadores contratados ou transferidos para prestar serviços no exterior.", arquivo:"federal/leis-ordinarias/1982/lei-7064-1982-12-06.md"}}, {id:"federal:BR:L:7017/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-08-30", numero:"7017", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-08-30;7017", vigente:true, titulo:"Lei nº 7.017 de 30/08/1982", urn:"urn:lex:br:federal:lei:1982-08-30;7017", ementa:"Dispõe sobre o desmembramento dos Conselhos Federal e   Regionais de Biomedicina e de Biologia.", arquivo:"federal/leis-ordinarias/1982/lei-7017-1982-08-30.md"}}, {id:"federal:BR:L:7085/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-12-21", numero:"7085", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-12-21;7085", vigente:true, titulo:"Lei nº 7.085 de 21/12/1982", urn:"urn:lex:br:federal:lei:1982-12-21;7085", ementa:"Modifica dispositivos do Decreto-Lei n. 227, de 28 de   fevereiro de 1967 - Código de Mineração, com as alterações posteriores.", arquivo:"federal/leis-ordinarias/1982/lei-7085-1982-12-21.md"}}, {id:"federal:BR:L:7055/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-12-06", numero:"7055", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-12-06;7055", vigente:true, titulo:"Lei nº 7.055 de 06/12/1982", urn:"urn:lex:br:federal:lei:1982-12-06;7055", ementa:"Concede pensão especial a Giusepe Bressan, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1982/lei-7055-1982-12-06.md"}}, {id:"federal:BR:L:7022/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-09-06", numero:"7022", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-09-06;7022", vigente:true, titulo:"Lei nº 7.022 de 06/09/1982", urn:"urn:lex:br:federal:lei:1982-09-06;7022", ementa:"Concede pensão especial à atriz Henriette Fernande   Zoé Morineau.", arquivo:"federal/leis-ordinarias/1982/lei-7022-1982-09-06.md"}}, {id:"federal:BR:L:7072/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1982, data:"1982-12-21", numero:"7072", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1982-12-21;7072", vigente:true, titulo:"Lei nº 7.072 de 21/12/1982", urn:"urn:lex:br:fe