UNWIND [{id:"federal:BR:L:5364/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-12-01", numero:"5364", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-12-01;5364", vigente:true, titulo:"Lei nº 5.364 de 01/12/1967", urn:"urn:lex:br:federal:lei:1967-12-01;5364", ementa:"Autoriza a Companhia Urbanizadora da Nova Capital do Brasil - NOVACAP - a alienar lotes rurais de sua propriedade no Distrito Federal.", arquivo:"federal/leis-ordinarias/1967/lei-5364-1967-12-01.md"}}, {id:"federal:BR:L:5351/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-11-06", numero:"5351", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-11-06;5351", vigente:true, titulo:"Lei nº 5.351 de 06/11/1967", urn:"urn:lex:br:federal:lei:1967-11-06;5351", ementa:"Retifica a relação nominal a que se refere o artigo 2º da Lei nº 1.564, de 1º de março de 1952, que altera, sem aumento de despesa, as carreiras de Marinheiro e Patrão do Quadro Suplementar do Ministério da Fazenda.", arquivo:"federal/leis-ordinarias/1967/lei-5351-1967-11-06.md"}}, {id:"federal:BR:L:5345/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-11-03", numero:"5345", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-11-03;5345", vigente:true, titulo:"Lei nº 5.345 de 03/11/1967", urn:"urn:lex:br:federal:lei:1967-11-03;5345", ementa:"Dispõe sôbre a Justiça Federal de primeira instância, alterando a Lei nº 5.010, de 30 de maio de 1966, modificada pelo Decreto-lei nº 253, de 28 de fevereiro de 1967.", arquivo:"federal/leis-ordinarias/1967/lei-5345-1967-11-03.md"}}, {id:"federal:BR:L:5207/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-16", numero:"5207", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-16;5207", vigente:true, titulo:"Lei nº 5.207 de 16/01/1967", urn:"urn:lex:br:federal:lei:1967-01-16;5207", ementa:"Desdobra em duas unidades universitárias distintas a atual Faculdade de Farmácia e Odontologia da Universidade Federal de Goiás.", arquivo:"federal/leis-ordinarias/1967/lei-5207-1967-01-16.md"}}, {id:"federal:BR:L:5363/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-11-30", numero:"5363", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-11-30;5363", vigente:true, titulo:"Lei nº 5.363 de 30/11/1967", urn:"urn:lex:br:federal:lei:1967-11-30;5363", ementa:"Regula, nos termos do art. 183 da Constituição, a complementação da mudança de órgãos da Administração Federal para a Capital da União, e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5363-1967-11-30.md"}}, {id:"federal:BR:L:5224/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-17", numero:"5224", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-17;5224", vigente:true, titulo:"Lei nº 5.224 de 17/01/1967", urn:"urn:lex:br:federal:lei:1967-01-17;5224", ementa:"Isenta do imposto de importação equipamento de televisão importado pela Rádio Difusora do Maranhão Ltda.", arquivo:"federal/leis-ordinarias/1967/lei-5224-1967-01-17.md"}}, {id:"federal:BR:L:5246/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-31", numero:"5246", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-31;5246", vigente:true, titulo:"Lei nº 5.246 de 31/01/1967", urn:"urn:lex:br:federal:lei:1967-01-31;5246", ementa:"Autoriza o Poder Executivo a abrir créditos especiais no montante de Cr$ 3.190.666.338,20 (três bilhões, cento e noventa milhões, seiscentos e sessenta e seis mil trezentos e trinta e oito cruzeiros e vinte centavos), para atender a despesas de diversos Ministérios.", arquivo:"federal/leis-ordinarias/1967/lei-5246-1967-01-31.md"}}, {id:"federal:BR:L:5270/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-22", numero:"5270", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-22;5270", vigente:true, titulo:"Lei nº 5.270 de 22/04/1967", urn:"urn:lex:br:federal:lei:1967-04-22;5270", ementa:"Institui o \"Dia da Comunidade Luso-Brasileira. e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5270-1967-04-22.md"}}, {id:"federal:BR:L:5216/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-16", numero:"5216", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-16;5216", vigente:true, titulo:"Lei nº 5.216 de 16/01/1967", urn:"urn:lex:br:federal:lei:1967-01-16;5216", ementa:"Concede isenção dos impostos e taxa que menciona para equipamento importado pela S.A. Empresa de Viação Aérea Rio Grandense. - \"VARIG\".", arquivo:"federal/leis-ordinarias/1967/lei-5216-1967-01-16.md"}}, {id:"federal:BR:L:5319/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-09-29", numero:"5319", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-09-29;5319", vigente:true, titulo:"Lei nº 5.319 de 29/09/1967", urn:"urn:lex:br:federal:lei:1967-09-29;5319", ementa:"Autoriza o Poder Executivo a doar material e equipamentos a entidades públicas e privadas que menciona e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5319-1967-09-29.md"}}, {id:"federal:BR:L:5304/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-07-03", numero:"5304", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-07-03;5304", vigente:true, titulo:"Lei nº 5.304 de 03/07/1967", urn:"urn:lex:br:federal:lei:1967-07-03;5304", ementa:"Dispensa do despacho consular os documentos exigidos para a entrada no Brasil, de aeronaves das empresas de transporte aéreo, nacionais e estrangeiras, que operam serviços regulares.", arquivo:"federal/leis-ordinarias/1967/lei-5304-1967-07-03.md"}}, {id:"federal:BR:L:5324/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-09-29", numero:"5324", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-09-29;5324", vigente:true, titulo:"Lei nº 5.324 de 29/09/1967", urn:"urn:lex:br:federal:lei:1967-09-29;5324", ementa:"Isenta dos impostos de importação e sobre produtos industrializados, bem como da taxa de despacho aduaneiro, material importado pela firma \" Rupturita S.A. Explosivos \" e destinado à recuperação de suas instalações, para o fabrico de nitroglicerina.", arquivo:"federal/leis-ordinarias/1967/lei-5324-1967-09-29.md"}}, {id:"federal:BR:L:5318/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-09-26", numero:"5318", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-09-26;5318", vigente:true, titulo:"Lei nº 5.318 de 26/09/1967", urn:"urn:lex:br:federal:lei:1967-09-26;5318", ementa:"Institui a Política Nacional de Saneamento e cria o Conselho Nacional de Saneamento.", arquivo:"federal/leis-ordinarias/1967/lei-5318-1967-09-26.md"}}, {id:"federal:BR:L:5287/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-05-25", numero:"5287", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-05-25;5287", vigente:true, titulo:"Lei nº 5.287 de 25/05/1967", urn:"urn:lex:br:federal:lei:1967-05-25;5287", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério da Agricultura, o crédito especial de NCr$ 1.980,00 (um mil novecentos e oitenta cruzeiros novos), para ocorrer a despesa realizada em 1959 com a execução de obras de construção no Instituto de Biologia Animal, no Km 47 da antiga Rodovia Rio-São Paulo.", arquivo:"federal/leis-ordinarias/1967/lei-5287-1967-05-25.md"}}, {id:"federal:BR:L:5295/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-06-16", numero:"5295", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-06-16;5295", vigente:true, titulo:"Lei nº 5.295 de 16/06/1967", urn:"urn:lex:br:federal:lei:1967-06-16;5295", ementa:"Concede isenção de tributos às Usinas Siderúrgicas de Minas Gerais (USIMINAS), à Companhia Siderúrgica Paulista (COSIPA), à Companhia Ferro e Aço de Vitória, à Siderurgia de Santa Catarina S.A. (SIDESC) e à Aço de Minas Gerais S.A. (AÇOMINAS).", arquivo:"federal/leis-ordinarias/1967/lei-5295-1967-06-16.md"}}, {id:"federal:BR:L:5301/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-06-30", numero:"5301", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-06-30;5301", vigente:true, titulo:"Lei nº 5.301 de 30/06/1967", urn:"urn:lex:br:federal:lei:1967-06-30;5301", ementa:"Estende a jurisdição de Juntas de Conciliação e Julgamento da 4ª Região (Rio Grande do Sul e Santa Catarina) e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5301-1967-06-30.md"}}, {id:"federal:BR:L:5298/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-06-22", numero:"5298", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-06-22;5298", vigente:true, titulo:"Lei nº 5.298 de 22/06/1967", urn:"urn:lex:br:federal:lei:1967-06-22;5298", ementa:"Cria uma Junta de Conciliação e Julgamento em Santo André, Estado de São Paulo, e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5298-1967-06-22.md"}}, {id:"federal:BR:L:5242/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-31", numero:"5242", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-31;5242", vigente:true, titulo:"Lei nº 5.242 de 31/01/1967", urn:"urn:lex:br:federal:lei:1967-01-31;5242", ementa:"Autoriza o Poder Executivo a abrir, à Presidência da República, o crédito especial de Cr$ 32.874.000,00 (trinta e dois milhões oitocentos e setenta e quatro mil cruzeiros), para ocorrer a despesas com os próprios presidênciais em Brasília, Rio de Janeiro e Petrópolis.", arquivo:"federal/leis-ordinarias/1967/lei-5242-1967-01-31.md"}}, {id:"federal:BR:L:5220/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-17", numero:"5220", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-17;5220", vigente:true, titulo:"Lei nº 5.220 de 17/01/1967", urn:"urn:lex:br:federal:lei:1967-01-17;5220", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações Exteriores, o crédito especial de Cr$ 120.000.000 (cento e vinte milhões de cruzeiros) para atender às despesas decorrentes da visita ao Brasil de Sua Alteza Eminentíssima Frei Angelo de Mojana di Cologna.", arquivo:"federal/leis-ordinarias/1967/lei-5220-1967-01-17.md"}}, {id:"federal:BR:L:5325/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-10-02", numero:"5325", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-10-02;5325", titulo:"Lei nº 5.325 de 02/10/1967", vigente:true, urn:"urn:lex:br:federal:lei:1967-10-02;5325", ementa:"Institui a duplicata fiscal.", arquivo:"federal/leis-ordinarias/1967/lei-5325-1967-10-02.md"}}, {id:"federal:BR:L:5212/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-16", numero:"5212", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-16;5212", vigente:true, titulo:"Lei nº 5.212 de 16/01/1967", urn:"urn:lex:br:federal:lei:1967-01-16;5212", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 18.997.062.214 (dezoito bilhões novecentos e noventa e sete milhões sessenta e dois mil duzentos e quatorze cruzeiros), em favor da Polícia Militar do Estado da Guanabara, para atender aos encargos decorrentes da aplicação do Decreto-Lei nº 10, de 28 de junho de 1966.", arquivo:"federal/leis-ordinarias/1967/lei-5212-1967-01-16.md"}}, {id:"federal:BR:L:5337/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-10-16", numero:"5337", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-10-16;5337", vigente:true, titulo:"Lei nº 5.337 de 16/10/1967", urn:"urn:lex:br:federal:lei:1967-10-16;5337", ementa:"Dispõe sôbre a aplicação da multa prevista pelo artigo 8º do Código Eleitoral ( Lei nº 4.737, de 15 de julho de 1965 ).", arquivo:"federal/leis-ordinarias/1967/lei-5337-1967-10-16.md"}}, {id:"federal:BR:L:5219/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-17", numero:"5219", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-17;5219", vigente:true, titulo:"Lei nº 5.219 de 17/01/1967", urn:"urn:lex:br:federal:lei:1967-01-17;5219", ementa:"Concede pensão especial mensal a Alice Luz Ferreira, viúva de Alfredo da Silva Ferreira.", arquivo:"federal/leis-ordinarias/1967/lei-5219-1967-01-17.md"}}, {id:"federal:BR:L:5284/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-05-02", numero:"5284", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-05-02;5284", vigente:true, titulo:"Lei nº 5.284 de 02/05/1967", urn:"urn:lex:br:federal:lei:1967-05-02;5284", ementa:"Abre ao Tribunal Regional Eleitoral do Ceará o crédito especial de NCr$ 22,97 (vinte e dois cruzeiros novos e noventa e sete centavos), destinado a atender ao pagamento de despesas com tratamento médico e hospitalar do Juiz da 77ª Zona Eleitoral do Ceará.", arquivo:"federal/leis-ordinarias/1967/lei-5284-1967-05-02.md"}}, {id:"federal:BR:L:5252/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-03-09", numero:"5252", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-03-09;5252", vigente:true, titulo:"Lei nº 5.252 de 09/03/1967", urn:"urn:lex:br:federal:lei:1967-03-09;5252", ementa:"Revalida a tranferência gratutita, à Fundação Darcy Vargas, do terreno de acrescido de marinha descrito no Decreto-Lei nº 5.440, de 30 de abril de 1943.", arquivo:"federal/leis-ordinarias/1967/lei-5252-1967-03-09.md"}}, {id:"federal:BR:L:5368/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-12-01", numero:"5368", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-12-01;5368", vigente:true, titulo:"Lei nº 5.368 de 01/12/1967", urn:"urn:lex:br:federal:lei:1967-12-01;5368", ementa:"Reajusta os vencimentos dos servidores civis e militares da União, reformula alíquotas de Imposto sôbre Produtos Industrializados, e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5368-1967-12-01.md"}}, {id:"federal:BR:L:5349/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-11-03", numero:"5349", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-11-03;5349", vigente:true, titulo:"Lei nº 5.349 de 03/11/1967", urn:"urn:lex:br:federal:lei:1967-11-03;5349", ementa:"Dá nova redação ao Cápitulo III do Título IX do Código de Processo Penal .", arquivo:"federal/leis-ordinarias/1967/lei-5349-1967-11-03.md"}}, {id:"federal:BR:L:5255/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-05", numero:"5255", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-05;5255", vigente:true, titulo:"Lei nº 5.255 de 05/04/1967", urn:"urn:lex:br:federal:lei:1967-04-05;5255", ementa:"Unifica as 1ª e 2ª Classes de Bombeiros, do Corpo de Bombeiros do Distrito Federal.", arquivo:"federal/leis-ordinarias/1967/lei-5255-1967-04-05.md"}}, {id:"federal:BR:L:5197/1967", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-03", numero:"5197", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-03;5197", vigente:true, titulo:"Lei nº 5.197 de 03/01/1967", urn:"urn:lex:br:federal:lei:1967-01-03;5197", ementa:"Dispõe sôbre a proteção à fauna e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5197-1967-01-03.md"}}, {id:"federal:BR:L:5291/1967", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-05-31", numero:"5291", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-05-31;5291", vigente:true, titulo:"Lei nº 5.291 de 31/05/1967", urn:"urn:lex:br:federal:lei:1967-05-31;5291", ementa:"Corrige desigualdade de situação entre servidores do Ministério da Fazenda e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5291-1967-05-31.md"}}, {id:"federal:BR:L:5372/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-12-06", numero:"5372", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-12-06;5372", vigente:true, titulo:"Lei nº 5.372 de 06/12/1967", urn:"urn:lex:br:federal:lei:1967-12-06;5372", ementa:"Estende às sociedades concessionárias de serviço público de energia elétrica, cujo controle acionário tiver sido ou vier a ser adquirido pelas Centrais Elétricas Brasileiras S.A. - ELETROBRÁS, o disposto no artigo 16 da Lei n. 3890-A, de 25 de abril de 1961, e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5372-1967-12-06.md"}}, {id:"federal:BR:L:5343/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-10-28", numero:"5343", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-10-28;5343", vigente:true, titulo:"Lei nº 5.343 de 28/10/1967", urn:"urn:lex:br:federal:lei:1967-10-28;5343", ementa:"Altera a redação de artigos do Decreto-Lei nº 313, de 7 de março de 1967, estabelece novos prazos e dá outras prvidências.", arquivo:"federal/leis-ordinarias/1967/lei-5343-1967-10-28.md"}}, {id:"federal:BR:L:5306/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-07-05", numero:"5306", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-07-05;5306", vigente:true, titulo:"Lei nº 5.306 de 05/07/1967", urn:"urn:lex:br:federal:lei:1967-07-05;5306", ementa:"Fixa datas para a realização das convenções para eleição do Diretório Nacional e dos Diretórios Regionais e Municipais dos Partidos Políticos e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5306-1967-07-05.md"}}, {id:"federal:BR:L:5315/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-09-12", numero:"5315", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-09-12;5315", vigente:true, titulo:"Lei nº 5.315 de 12/09/1967", urn:"urn:lex:br:federal:lei:1967-09-12;5315", ementa:"Regulamenta o art. 178 da Constituição do Brasil, que dispõe sobre os ex-combatentes da 2ª Guerra Mundial.", arquivo:"federal/leis-ordinarias/1967/lei-5315-1967-09-12.md"}}, {id:"federal:BR:L:5329/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-10-06", numero:"5329", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-10-06;5329", vigente:true, titulo:"Lei nº 5.329 de 06/10/1967", urn:"urn:lex:br:federal:lei:1967-10-06;5329", ementa:"Revoga as Leis nºs 3.739, de 4 de abril de 1960, e 5.039, de 20 de junho de 1966 que autorizam o Poder Executivo a doar imóvel Prefeitura Municipal de Corumbá, Estado de Mato Grosso.", arquivo:"federal/leis-ordinarias/1967/lei-5329-1967-10-06.md"}}, {id:"federal:BR:L:5272/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-24", numero:"5272", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-24;5272", vigente:true, titulo:"Lei nº 5.272 de 24/04/1967", urn:"urn:lex:br:federal:lei:1967-04-24;5272", ementa:"Autoriza o Poder Executivo, a abrir, ao Ministério das Relações Exteriores, o crédito especial de NCr$ 60.924,21 (sessenta mil, novecentos e vinte e quatro cruzeiros novos e vinte e um centavos), destinado a atender a despesas com a participação do Brasil na IV Feira Internacional de Nova York, realizada em 1960.", arquivo:"federal/leis-ordinarias/1967/lei-5272-1967-04-24.md"}}, {id:"federal:BR:L:5310/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-08-18", numero:"5310", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-08-18;5310", vigente:true, titulo:"Lei nº 5.310 de 18/08/1967", urn:"urn:lex:br:federal:lei:1967-08-18;5310", ementa:"Cria, na Justiça do Trabalho da Terceira Região, uma Junta de Conciliação e Julgamento, com sede em Monte Claros, Minas Gerais, e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5310-1967-08-18.md"}}, {id:"federal:BR:L:5275/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-24", numero:"5275", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-24;5275", vigente:true, titulo:"Lei nº 5.275 de 24/04/1967", urn:"urn:lex:br:federal:lei:1967-04-24;5275", ementa:"Reorganiza o Quadro de Pessoal do Tribunal Regional do Trabalho da Primeira Região, e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5275-1967-04-24.md"}}, {id:"federal:BR:L:5281/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-27", numero:"5281", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-27;5281", vigente:true, titulo:"Lei nº 5.281 de 27/04/1967", urn:"urn:lex:br:federal:lei:1967-04-27;5281", ementa:"Modifica o prazo da vigência da Lei nº 4.426, de 8 de outubro de 1964, que \"dispõe sobre a venda de vinho em recipientes de volume superior ao estabelecido pela legislação em vigor e dá outras providências\".", arquivo:"federal/leis-ordinarias/1967/lei-5281-1967-04-27.md"}}, {id:"federal:BR:L:5202/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-12", numero:"5202", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-12;5202", vigente:true, titulo:"Lei nº 5.202 de 12/01/1967", urn:"urn:lex:br:federal:lei:1967-01-12;5202", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações Exteriores, o crédito especial de Cr$ 22.200.000 (vinte e dois milhões e duzentos mil cruzeiros), destinado a auxiliar a Arquidiocesse da cidade do México na construção de um templo dedicado a Nossa Senhora da Aparecida, naquela Capital.", arquivo:"federal/leis-ordinarias/1967/lei-5202-1967-01-12.md"}}, {id:"federal:BR:L:5264/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-17", numero:"5264", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-17;5264", vigente:true, titulo:"Lei nº 5.264 de 17/04/1967", urn:"urn:lex:br:federal:lei:1967-04-17;5264", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério das Relações Exteriores, o crédito especial de NCr$ 144.569,27 (cento e quarenta e quatro mil, quinhentos e sessenta e nove cruzeiros novos e vinte e sete centavos), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1967/lei-5264-1967-04-17.md"}}, {id:"federal:BR:L:5359/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-11-23", numero:"5359", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-11-23;5359", vigente:true, titulo:"Lei nº 5.359 de 23/11/1967", urn:"urn:lex:br:federal:lei:1967-11-23;5359", ementa:"Transfere um cargo da Série de Classes de Técnico de Administração, nível 22-C, do Departamento Administrativo do Pessoal Civil para o Ministério da Fazenda.", arquivo:"federal/leis-ordinarias/1967/lei-5359-1967-11-23.md"}}, {id:"federal:BR:L:5356/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-11-17", numero:"5356", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-11-17;5356", vigente:true, titulo:"Lei nº 5.356 de 17/11/1967", urn:"urn:lex:br:federal:lei:1967-11-17;5356", ementa:"Revoga o Decreto-Lei nº 142, de 2 de fevereiro de 1967, que dispõe sôbre o Plano Rodoviário Nacional.", arquivo:"federal/leis-ordinarias/1967/lei-5356-1967-11-17.md"}}, {id:"federal:BR:L:5307/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-07-07", numero:"5307", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-07-07;5307", vigente:true, titulo:"Lei nº 5.307 de 07/07/1967", urn:"urn:lex:br:federal:lei:1967-07-07;5307", ementa:"Dispõe sobre a pensão devida à família de Diplomata.", arquivo:"federal/leis-ordinarias/1967/lei-5307-1967-07-07.md"}}, {id:"federal:BR:L:5374/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-12-07", numero:"5374", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-12-07;5374", vigente:true, titulo:"Lei nº 5.374 de 07/12/1967", urn:"urn:lex:br:federal:lei:1967-12-07;5374", ementa:"Altera dispositivos da Lei nº 5173, de 27 de outubro de 1966, que dispõe sobre o Plano de Valorização Econômica da Amazônia, extingue a Superintendência do Plano de Valorização Econômica da Amazônia (SPVEA), cria a Superintendência do Desenvolvimento da Amazônia (SUDAM), e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5374-1967-12-07.md"}}, {id:"federal:BR:L:5206/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-16", numero:"5206", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-16;5206", vigente:true, titulo:"Lei nº 5.206 de 16/01/1967", urn:"urn:lex:br:federal:lei:1967-01-16;5206", ementa:"Autoriza o Poder Executivo a abrir o crédito especial de Cr$ 8.500.000.000 (oito bilhões e quinhentos milhões de cruzeiros) destinado a atender a despesas de qualquer natureza do Grupo Executivo de Integração da Política de Transportes - GEIPOT, para a realização de estudos de engenharia específica.", arquivo:"federal/leis-ordinarias/1967/lei-5206-1967-01-16.md"}}, {id:"federal:BR:L:5360/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-11-23", numero:"5360", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-11-23;5360", vigente:true, titulo:"Lei nº 5.360 de 23/11/1967", urn:"urn:lex:br:federal:lei:1967-11-23;5360", ementa:"Concede dedução da contribuição devida ao INDA, prevista no art. 3º do Decreto-Lei nº 58, de 21 de novembro de 1966.", arquivo:"federal/leis-ordinarias/1967/lei-5360-1967-11-23.md"}}, {id:"federal:BR:L:5230/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-19", numero:"5230", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-19;5230", vigente:true, titulo:"Lei nº 5.230 de 19/01/1967", urn:"urn:lex:br:federal:lei:1967-01-19;5230", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça do Trabalho - Tribunal Regional do Trabalho da 2º Região, o crédito especial de Cr$ 301.983 (trezentos e um mil novecentos e oitenta e três cruzeiros), para atender ao pagamento de gratificação pela execução de serviço de natureza especial.", arquivo:"federal/leis-ordinarias/1967/lei-5230-1967-01-19.md"}}, {id:"federal:BR:L:5261/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-12", numero:"5261", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-12;5261", vigente:true, titulo:"Lei nº 5.261 de 12/04/1967", urn:"urn:lex:br:federal:lei:1967-04-12;5261", ementa:"Concede isenção de tributos para equipamento telefônico destinado à Sociedade Telefônica do Paraná S/A, sediada em Maringá, Estado do Paraná.", arquivo:"federal/leis-ordinarias/1967/lei-5261-1967-04-12.md"}}, {id:"federal:BR:L:5344/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-10-31", numero:"5344", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-10-31;5344", vigente:true, titulo:"Lei nº 5.344 de 31/10/1967", urn:"urn:lex:br:federal:lei:1967-10-31;5344", ementa:"Altera o Fundo de Reserva criado pelo Decreto-Lei nº 81, de 21 de dezembro de 1966, e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5344-1967-10-31.md"}}, {id:"federal:BR:L:5350/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-11-06", numero:"5350", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-11-06;5350", vigente:true, titulo:"Lei nº 5.350 de 06/11/1967", urn:"urn:lex:br:federal:lei:1967-11-06;5350", ementa:"Estende aos funcionários da Polícia Civil dos Estados e Territórios Federais, ocupantes de cargos de atividade policial, o regime de prisão especial estabelecido pela Lei nº 4.878, de 3 de dezembro de 1965.", arquivo:"federal/leis-ordinarias/1967/lei-5350-1967-11-06.md"}}, {id:"federal:BR:L:5303/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-07-03", numero:"5303", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-07-03;5303", vigente:true, titulo:"Lei nº 5.303 de 03/07/1967", urn:"urn:lex:br:federal:lei:1967-07-03;5303", ementa:"Dispõe sobre o recolhimento da taxa de fiscalização criada pela Lei número 5.070, de 7 de julho de 1966, que cria o Fundo de Fiscalização das Telecomunicações e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5303-1967-07-03.md"}}, {id:"federal:BR:L:5215/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-16", numero:"5215", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-16;5215", vigente:true, titulo:"Lei nº 5.215 de 16/01/1967", urn:"urn:lex:br:federal:lei:1967-01-16;5215", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério da Fazenda, o crédito especial de Cr$ 1.200.000.000 (um bilhão e duzentos milhões de cruzeiros), para atender a despesas com o reaparelhamento dos órgãos centrais e regionais do Departamento do Imposto de Renda.", arquivo:"federal/leis-ordinarias/1967/lei-5215-1967-01-16.md"}}, {id:"federal:BR:L:5362/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-11-30", numero:"5362", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-11-30;5362", vigente:true, titulo:"Lei nº 5.362 de 30/11/1967", urn:"urn:lex:br:federal:lei:1967-11-30;5362", ementa:"Modifica artigos da Lei nº 4595, de 31 de dezembro de 1964 que dispõe sobre a Política e as Instituições Monetárias, Bancárias e creditícias, cria o Conselho Monetário Nacional e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5362-1967-11-30.md"}}, {id:"federal:BR:L:5223/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-17", numero:"5223", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-17;5223", vigente:true, titulo:"Lei nº 5.223 de 17/01/1967", urn:"urn:lex:br:federal:lei:1967-01-17;5223", ementa:"Isenta dos impostos de importação e de consumo, bem como da taxa de despacho aduaneiro, equipamentos importados pela Companhia Estadual de Águas da Guanabara.", arquivo:"federal/leis-ordinarias/1967/lei-5223-1967-01-17.md"}}, {id:"federal:BR:L:5245/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-31", numero:"5245", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-31;5245", vigente:true, titulo:"Lei nº 5.245 de 31/01/1967", urn:"urn:lex:br:federal:lei:1967-01-31;5245", ementa:"Autoriza o Poder Executivo a abrir, através do Ministério da Fazenda, o crédito especial de Cr$ 715.773.407,70 (setecentos e quinze milhões, setecentos e setenta e três mil, quatrocentos e sete cruzeiros e setenta centavos), para atender à regularização de adiantamento ao Instituto de Aposentadoria e Pensões dos Ferroviários e Empregados em Serviços Públicos.", arquivo:"federal/leis-ordinarias/1967/lei-5245-1967-01-31.md"}}, {id:"federal:BR:L:5268/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-17", numero:"5268", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-17;5268", vigente:true, titulo:"Lei nº 5.268 de 17/04/1967", urn:"urn:lex:br:federal:lei:1967-04-17;5268", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério dos Transportes, o crédito especial de NCr$ 100.000,00 (cem mil cruzeiros novos), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1967/lei-5268-1967-04-17.md"}}, {id:"federal:BR:L:5309/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-08-17", numero:"5309", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-08-17;5309", vigente:true, titulo:"Lei nº 5.309 de 17/08/1967", urn:"urn:lex:br:federal:lei:1967-08-17;5309", ementa:"Concede a pensão especial de NCr$ 20,00 ( vinte cruzeiros novos ) mensais, a Herundina Martins da Silva, filha do ex-tesoureiro aposentado Francisco Josephino Maria da Silva.", arquivo:"federal/leis-ordinarias/1967/lei-5309-1967-08-17.md"}}, {id:"federal:BR:L:5379/1967", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-12-15", numero:"5379", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-12-15;5379", vigente:true, titulo:"Lei nº 5.379 de 15/12/1967", urn:"urn:lex:br:federal:lei:1967-12-15;5379", ementa:"Provê sobre a alfabetização funcional e a educação continuada de adolescentes e adultos.", arquivo:"federal/leis-ordinarias/1967/lei-5379-1967-12-15.md"}}, {id:"federal:BR:L:5323/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-09-29", numero:"5323", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-09-29;5323", vigente:true, titulo:"Lei nº 5.323 de 29/09/1967", urn:"urn:lex:br:federal:lei:1967-09-29;5323", ementa:"Revoga a Lei nº 4.555, de 10 de dezembro de 1964, que concede isenção de direitos de importação para materiais, máquinas e equipamentos adquiridos pela Refinaria de Petróleo de Manguinhos S.A., no Estado da Guanabara.", arquivo:"federal/leis-ordinarias/1967/lei-5323-1967-09-29.md"}}, {id:"federal:BR:L:5211/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-16", numero:"5211", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-16;5211", vigente:true, titulo:"Lei nº 5.211 de 16/01/1967", urn:"urn:lex:br:federal:lei:1967-01-16;5211", ementa:"Concede pensão especial mensal ao Senhor Deolindo de Araújo Costa.", arquivo:"federal/leis-ordinarias/1967/lei-5211-1967-01-16.md"}}, {id:"federal:BR:L:5241/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-31", numero:"5241", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-31;5241", vigente:true, titulo:"Lei nº 5.241 de 31/01/1967", urn:"urn:lex:br:federal:lei:1967-01-31;5241", ementa:"Cria cargos de Professor Catedrático na Faculdade de Filisofia, Ciências e Letras da Universidade Federal do Espírito Santo.", arquivo:"federal/leis-ordinarias/1967/lei-5241-1967-01-31.md"}}, {id:"federal:BR:L:5234/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-20", numero:"5234", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-20;5234", vigente:true, titulo:"Lei nº 5.234 de 20/01/1967", urn:"urn:lex:br:federal:lei:1967-01-20;5234", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Justiça e Negócios Interiores, o crédito especial de Cr$ 700.000.000 (setecentos milhões de cruzeiros) para a instalação, organização e funcinamento do Estado do Acre, e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5234-1967-01-20.md"}}, {id:"federal:BR:L:5352/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-11-08", numero:"5352", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-11-08;5352", vigente:true, titulo:"Lei nº 5.352 de 08/11/1967", urn:"urn:lex:br:federal:lei:1967-11-08;5352", ementa:"Institui o \"Dia Nacional da Saúde\".", arquivo:"federal/leis-ordinarias/1967/lei-5352-1967-11-08.md"}}, {id:"federal:BR:L:5336/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-10-16", numero:"5336", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-10-16;5336", vigente:true, titulo:"Lei nº 5.336 de 16/10/1967", urn:"urn:lex:br:federal:lei:1967-10-16;5336", ementa:"Abre, ao Ministério do Trabalho e Previdência Social, o crédito especial de NCr$ 42.000,00 (quarenta e dois mil cruzeiros novos) para atender, no corrente exercício, a despesas com gratificações na Secretaria Executiva do Conselho Nacional de Política Salarial.", arquivo:"federal/leis-ordinarias/1967/lei-5336-1967-10-16.md"}}, {id:"federal:BR:L:5251/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-03-09", numero:"5251", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-03-09;5251", vigente:true, titulo:"Lei nº 5.251 de 09/03/1967", urn:"urn:lex:br:federal:lei:1967-03-09;5251", ementa:"Autoriza o Poder Executivo a abrir pelo Ministério da Fazenda, o crédito especial de NCr$ 14.027.673,00 (quatorze milhões, vinte e sete mil, seiscentos e setenta e três cruzeiros novos), para indenizar a Companhia Port of Pará.", arquivo:"federal/leis-ordinarias/1967/lei-5251-1967-03-09.md"}}, {id:"federal:BR:L:5367/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-12-01", numero:"5367", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-12-01;5367", vigente:true, titulo:"Lei nº 5.367 de 01/12/1967", urn:"urn:lex:br:federal:lei:1967-12-01;5367", ementa:"Concede pensão especial à família do Inspetor Eletrotécnico Arlete de Souza .", arquivo:"federal/leis-ordinarias/1967/lei-5367-1967-12-01.md"}}, {id:"federal:BR:L:5348/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-11-03", numero:"5348", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-11-03;5348", vigente:true, titulo:"Lei nº 5.348 de 03/11/1967", urn:"urn:lex:br:federal:lei:1967-11-03;5348", ementa:"Revoga o art. 3º do Decreto-Lei número 212, de 27 de fevereiro de 1967, que dispõe sobre medidas de segurança sanitária do País.", arquivo:"federal/leis-ordinarias/1967/lei-5348-1967-11-03.md"}}, {id:"federal:BR:L:5342/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-10-28", numero:"5342", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-10-28;5342", vigente:true, titulo:"Lei nº 5.342 de 28/10/1967", urn:"urn:lex:br:federal:lei:1967-10-28;5342", ementa:"Autoriza o Poder Executivo a abrir, através do Ministério dos Transportes, o crédito especial de NCr$ 391.000,00 (trezentos e noventa e um mil cruzeiros novos), para atender ao pagamento de despesas inadiáveis da Companhia Nacional de Navegação Costeira.", arquivo:"federal/leis-ordinarias/1967/lei-5342-1967-10-28.md"}}, {id:"federal:BR:L:5271/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-24", numero:"5271", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-24;5271", vigente:true, titulo:"Lei nº 5.271 de 24/04/1967", urn:"urn:lex:br:federal:lei:1967-04-24;5271", ementa:"Autoriza o Poder Executivo a abrir ao Ministério da Justiça o crédito especial de NCr$ 3.291.576,93 (três milhões, duzentos e noventa e um mil, quinhentos e setenta e seis cruzeiros novos e noventa e três centavos), destinado a atender a despesas decorrentes do pagamento de gratificação de função policial instituída pelo nº 4878, de 3 de dezembro de 1965.", arquivo:"federal/leis-ordinarias/1967/lei-5271-1967-04-24.md"}}, {id:"federal:BR:L:5313/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-09-04", numero:"5313", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-09-04;5313", vigente:true, titulo:"Lei nº 5.313 de 04/09/1967", urn:"urn:lex:br:federal:lei:1967-09-04;5313", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Justiça, o crédito especial de NCr$ 3.000.000,00 ( três milhões de cruzeiros novos ), para a instalação da Justiça Federal no Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1967/lei-5313-1967-09-04.md"}}, {id:"federal:BR:L:5266/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-17", numero:"5266", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-17;5266", vigente:true, titulo:"Lei nº 5.266 de 17/04/1967", urn:"urn:lex:br:federal:lei:1967-04-17;5266", ementa:"Autoriza o Poder Executivo a abrir, ao Poder Judiciário - Justiça Eleitoral - Tribunal Regional Eleitoral do Distrito Federal, o crédito especial de NCr$ 917,70 (novecentos e dezessete cruzeiros novos e setenta centavos), para pagamento de despesas de exercícios encerrados.", arquivo:"federal/leis-ordinarias/1967/lei-5266-1967-04-17.md"}}, {id:"federal:BR:L:5277/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-24", numero:"5277", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-24;5277", vigente:true, titulo:"Lei nº 5.277 de 24/04/1967", urn:"urn:lex:br:federal:lei:1967-04-24;5277", ementa:"Autoriza o Poder Executivo a abrir, ao Congresso Nacional, o crédito especial de NCr$ 3.000.000,00 (três milhões de cruzeiros novos), destinado a atender a despesas docorrentes de pagamento de passagens aéreas de âmbito nacional, necessárias ao deslocamento dos Congressistas, e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5277-1967-04-24.md"}}, {id:"federal:BR:L:5204/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-12", numero:"5204", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-12;5204", vigente:true, titulo:"Lei nº 5.204 de 12/01/1967", urn:"urn:lex:br:federal:lei:1967-01-12;5204", ementa:"Isenta dos impostos de importação e de consumo, bem como da taxa de despacho aduaneiro, materiais destinados à Companhia Mogiana de Estradas de Ferro, do Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1967/lei-5204-1967-01-12.md"}}, {id:"federal:BR:L:5321/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-09-29", numero:"5321", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-09-29;5321", vigente:true, titulo:"Lei nº 5.321 de 29/09/1967", urn:"urn:lex:br:federal:lei:1967-09-29;5321", ementa:"Dispõe sobre as comemorações do centenário de Nilo Peçanha, e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5321-1967-09-29.md"}}, {id:"federal:BR:L:5358/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-11-17", numero:"5358", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-11-17;5358", vigente:true, titulo:"Lei nº 5.358 de 17/11/1967", urn:"urn:lex:br:federal:lei:1967-11-17;5358", ementa:"Estima a Receita e fixa a Despesa do Distrito Federal para o exercício financeiro de 1968.", arquivo:"federal/leis-ordinarias/1967/lei-5358-1967-11-17.md"}}, {id:"federal:BR:L:5249/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-02-09", numero:"5249", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-02-09;5249", vigente:true, titulo:"Lei nº 5.249 de 09/02/1967", urn:"urn:lex:br:federal:lei:1967-02-09;5249", ementa:"Dispõe sôbre a Ação Pública de Crime de Responsabilidade.", arquivo:"federal/leis-ordinarias/1967/lei-5249-1967-02-09.md"}}, {id:"federal:BR:L:5282/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-28", numero:"5282", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-28;5282", vigente:true, titulo:"Lei nº 5.282 de 28/04/1967", urn:"urn:lex:br:federal:lei:1967-04-28;5282", ementa:"Autoriza o Poder Executivo a abrir, à Presidência da República, o crédito especial de NCr$ 7.714.834,29 (sete milhões, setecentos e quatorze mil, oitocentos e trinta e quatro cruzeiros novos e vinte e nove centavos), para aplicação em obras do Plano do Carvão Nacional.", arquivo:"federal/leis-ordinarias/1967/lei-5282-1967-04-28.md"}}, {id:"federal:BR:L:5293/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-06-15", numero:"5293", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-06-15;5293", vigente:true, titulo:"Lei nº 5.293 de 15/06/1967", urn:"urn:lex:br:federal:lei:1967-06-15;5293", ementa:"Retifica número de certificado cambial constante do artigo 1º da Lei número 5087, de 30 de agosto de 1966, que isenta do imposto de importação maquinaria destinada à confecção de embalagem metálica.", arquivo:"federal/leis-ordinarias/1967/lei-5293-1967-06-15.md"}}, {id:"federal:BR:L:5232/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-20", numero:"5232", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-20;5232", vigente:true, titulo:"Lei nº 5.232 de 20/01/1967", urn:"urn:lex:br:federal:lei:1967-01-20;5232", ementa:"Acrescenta parágrafos ao artigo 33 da Lei nº 4.494, de 25 de novembro de 1964, que regula a locação de prédios urbanos.", arquivo:"federal/leis-ordinarias/1967/lei-5232-1967-01-20.md"}}, {id:"federal:BR:L:5340/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-10-20", numero:"5340", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-10-20;5340", vigente:true, titulo:"Lei nº 5.340 de 20/10/1967", urn:"urn:lex:br:federal:lei:1967-10-20;5340", ementa:"Prorroga, pelo prazo de 24 (vinte e quatro) meses, a isenção de que tratam as letras b e c do item I do art. 1º da Lei nº 4.622, de 3 de maio de 1965.", arquivo:"federal/leis-ordinarias/1967/lei-5340-1967-10-20.md"}}, {id:"federal:BR:L:5208/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-16", numero:"5208", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-16;5208", vigente:true, titulo:"Lei nº 5.208 de 16/01/1967", urn:"urn:lex:br:federal:lei:1967-01-16;5208", ementa:"Autoriza o Poder Executivo a ceder ao Estado do Rio Grande do Sul as quotas do Serviço Marítimo Sul Brasil Ltda. - SEMASUL.", arquivo:"federal/leis-ordinarias/1967/lei-5208-1967-01-16.md"}}, {id:"federal:BR:L:5341/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-10-27", numero:"5341", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-10-27;5341", vigente:true, titulo:"Lei nº 5.341 de 27/10/1967", urn:"urn:lex:br:federal:lei:1967-10-27;5341", ementa:"Dispõe sobre o leilão de mercadorias realizado pelas repartições aduaneiras e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5341-1967-10-27.md"}}, {id:"federal:BR:L:5248/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-02-02", numero:"5248", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-02-02;5248", vigente:true, titulo:"Lei nº 5.248 de 02/02/1967", urn:"urn:lex:br:federal:lei:1967-02-02;5248", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Aeronáutica, o crédito especial de Cr$ 2.227.440 (dois milhões, duzentos e vinte e sete mil, quatrocentos e quarenta cruzeiros), para pagamento de sentença judicial proferida em favor de diaristas de obras da 5ª Zona Aérea - Pôrto Alegre.", arquivo:"federal/leis-ordinarias/1967/lei-5248-1967-02-02.md"}}, {id:"federal:BR:L:5365/1967", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-12-01", numero:"5365", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-12-01;5365", vigente:true, titulo:"Lei nº 5.365 de 01/12/1967", urn:"urn:lex:br:federal:lei:1967-12-01;5365", ementa:"Cria a Superintendência do Desenvolvimento da Região Centro-Oeste (SUDECO), e dá outras providências. /Há veto/", arquivo:"federal/leis-ordinarias/1967/lei-5365-1967-12-01.md"}}, {id:"federal:BR:L:5346/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-11-03", numero:"5346", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-11-03;5346", vigente:true, titulo:"Lei nº 5.346 de 03/11/1967", urn:"urn:lex:br:federal:lei:1967-11-03;5346", ementa:"Altera dispositivos do Código Penal, visando a proteger serviços de utilidade pública.", arquivo:"federal/leis-ordinarias/1967/lei-5346-1967-11-03.md"}}, {id:"federal:BR:L:5250/1967", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-02-09", numero:"5250", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-02-09;5250", vigente:true, titulo:"Lei nº 5.250 de 09/02/1967", urn:"urn:lex:br:federal:lei:1967-02-09;5250", ementa:"Regula a liberdade de manifestação de pensamento e de informação.", arquivo:"federal/leis-ordinarias/1967/lei-5250-1967-02-09.md"}}, {id:"federal:BR:L:5238/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-31", numero:"5238", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-31;5238", vigente:true, titulo:"Lei nº 5.238 de 31/01/1967", urn:"urn:lex:br:federal:lei:1967-01-31;5238", ementa:"Autoriza a Prefeitura do Distrito Federal a transferir recursos para o Instituto Brasileiro de Geografia e Estatística (IBGE) e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5238-1967-01-31.md"}}, {id:"federal:BR:L:5217/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-16", numero:"5217", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-16;5217", vigente:true, titulo:"Lei nº 5.217 de 16/01/1967", urn:"urn:lex:br:federal:lei:1967-01-16;5217", ementa:"Autoriza o Poder Executivo a abrir ao Ministério da Educação e Cultura o crédito especial de Cr$ 322.930.000 (trezentos e vinte e dois milhões novecentos e trinta mil cruzeiros), para atender ao pagamento da parte do auxílio consignado no Orçamento Geral da União de 1965, em favor da Universidade Federal da Paraíba.", arquivo:"federal/leis-ordinarias/1967/lei-5217-1967-01-16.md"}}, {id:"federal:BR:L:5297/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-06-19", numero:"5297", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-06-19;5297", vigente:true, titulo:"Lei nº 5.297 de 19/06/1967", urn:"urn:lex:br:federal:lei:1967-06-19;5297", ementa:"Autoriza a abertura de créditos especiais, num montante de NCr$ 27.413,56, (vinte e sete mil, quatrocentos e treze cruzeiros novos e cinquenta e seis centavos) destinados a atender ao pagamento de aluguéis de prédios locados às Exatorias Federais no Estado de São Paulo e à Superintendência do Serviço de Repressão ao Contrabando no Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1967/lei-5297-1967-06-19.md"}}, {id:"federal:BR:L:5328/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-10-04", numero:"5328", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-10-04;5328", vigente:true, titulo:"Lei nº 5.328 de 04/10/1967", urn:"urn:lex:br:federal:lei:1967-10-04;5328", ementa:"Dispõe sobre a contagem do tempo de serviço dos servidores pertencentes a estabelecimentos de ensino superior antes de federalizados por leis especiais.", arquivo:"federal/leis-ordinarias/1967/lei-5328-1967-10-04.md"}}, {id:"federal:BR:L:5253/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-04", numero:"5253", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-04;5253", vigente:true, titulo:"Lei nº 5.253 de 04/04/1967", urn:"urn:lex:br:federal:lei:1967-04-04;5253", ementa:"Acrescentar parágrafo ao art. 1º da Lei nº 1.162, de 22 de julho de 1950,   que estabelece normas para a aposentadoria e pensão dos servidores das   autarquias pertencentes ao patrimônio da União.", arquivo:"federal/leis-ordinarias/1967/lei-5253-1967-04-04.md"}}, {id:"federal:BR:L:5225/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-17", numero:"5225", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-17;5225", vigente:true, titulo:"Lei nº 5.225 de 17/01/1967", urn:"urn:lex:br:federal:lei:1967-01-17;5225", ementa:"Atualiza o valor da gratificação concedida aos menbros dos Tribunais Eleitorais, ao Procurador Geral e aos Procuradores Regionais Eleitorais e aos Juízes e Escrivães Eleitorais.", arquivo:"federal/leis-ordinarias/1967/lei-5225-1967-01-17.md"}}, {id:"federal:BR:L:5370/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-12-05", numero:"5370", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-12-05;5370", vigente:true, titulo:"Lei nº 5.370 de 05/12/1967", urn:"urn:lex:br:federal:lei:1967-12-05;5370", ementa:"Fixa data para a realização das Convenções para eleição do Diretório Nacional e dos Diretórios Regionais e Municipais, e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5370-1967-12-05.md"}}, {id:"federal:BR:L:5288/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-05-25", numero:"5288", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-05-25;5288", vigente:true, titulo:"Lei nº 5.288 de 25/05/1967", urn:"urn:lex:br:federal:lei:1967-05-25;5288", ementa:"Autoriza doação de prédio do patrimônio da União à Prefeitura Municipal de Campina Grande, Estado da Paraíba.", arquivo:"federal/leis-ordinarias/1967/lei-5288-1967-05-25.md"}}, {id:"federal:BR:L:5296/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-06-16", numero:"5296", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-06-16;5296", vigente:true, titulo:"Lei nº 5.296 de 16/06/1967", urn:"urn:lex:br:federal:lei:1967-06-16;5296", ementa:"Autoriza a abertura de créditos especiais, num montante de NCr$ 25.785.131,01 (vinte e cinco milhões, setecentos e oitenta e cinco mil, cento e trinta e um cruzeiros novos e um centavo ), à Presidência da República e diversos Ministérios.", arquivo:"federal/leis-ordinarias/1967/lei-5296-1967-06-16.md"}}, {id:"federal:BR:L:5213/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-16", numero:"5213", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-16;5213", vigente:true, titulo:"Lei nº 5.213 de 16/01/1967", urn:"urn:lex:br:federal:lei:1967-01-16;5213", ementa:"Autoriza a Superintendência dos Serviços de Transportes da Baía de Guanabara a vender as embarcações que menciona.", arquivo:"federal/leis-ordinarias/1967/lei-5213-1967-01-16.md"}}, {id:"federal:BR:L:5278/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-27", numero:"5278", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-27;5278", vigente:true, titulo:"Lei nº 5.278 de 27/04/1967", urn:"urn:lex:br:federal:lei:1967-04-27;5278", ementa:"Autoriza o Poder Executivo a abrir ao Ministério das Relações Exteriores, o crédito especial de NCr$ 102.978,03 (cento e dois mil, novecentos e setenta e oito cruzeiros novos e três centavos), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1967/lei-5278-1967-04-27.md"}}, {id:"federal:BR:L:5236/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-20", numero:"5236", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-20;5236", vigente:true, titulo:"Lei nº 5.236 de 20/01/1967", urn:"urn:lex:br:federal:lei:1967-01-20;5236", ementa:"Autoriza a abertura, pela Secretaria de Finanças do Distrito Federal, de créditos especiais no total de Cr$ 60.005.275 (sessenta milhões, cinco mil duzentos e setenta e cinco cruzeiros), para pagamento de despesas realizadas nos exercícios de 1961 a 1966.", arquivo:"federal/leis-ordinarias/1967/lei-5236-1967-01-20.md"}}, {id:"federal:BR:L:5326/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-10-02", numero:"5326", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-10-02;5326", vigente:true, titulo:"Lei nº 5.326 de 02/10/1967", urn:"urn:lex:br:federal:lei:1967-10-02;5326", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 15.000.000,00 ( quinze milhões de cruzeiros novos ) para atendimento do disposto no § 2º do art. 2º do Decreto-lei nº 280, de 28 de fevereiro de 1967.", arquivo:"federal/leis-ordinarias/1967/lei-5326-1967-10-02.md"}}, {id:"federal:BR:L:5221/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-17", numero:"5221", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-17;5221", vigente:true, titulo:"Lei nº 5.221 de 17/01/1967", urn:"urn:lex:br:federal:lei:1967-01-17;5221", ementa:"Concede pensão especial a Fausta Gama Ribeiro e igual pensão a Lucy de Lima Campos e seus filhos menores.", arquivo:"federal/leis-ordinarias/1967/lei-5221-1967-01-17.md"}}, {id:"federal:BR:L:5243/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-31", numero:"5243", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-31;5243", vigente:true, titulo:"Lei nº 5.243 de 31/01/1967", urn:"urn:lex:br:federal:lei:1967-01-31;5243", ementa:"Autoriza a abertura, pelo Ministério da Viação e Obras Públicas, do crédito especial de Cr$ 450.000.000 (quatrocentos e cinqüenta milhões de cruzeiros), para atender ao pagamento de diferença salarial devida a servidores da Administração do Porto do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1967/lei-5243-1967-01-31.md"}}, {id:"federal:BR:L:5228/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-18", numero:"5228", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-18;5228", vigente:true, titulo:"Lei nº 5.228 de 18/01/1967", urn:"urn:lex:br:federal:lei:1967-01-18;5228", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério das Minas e Energia, o crédito especial de Cr$ 40.000.000.000 (Quarenta bilhões de cruzeiros), em reforço do Fundo Federal de Eletrificação.", arquivo:"federal/leis-ordinarias/1967/lei-5228-1967-01-18.md"}}, {id:"federal:BR:L:5373/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-12-06", numero:"5373", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-12-06;5373", vigente:true, titulo:"Lei nº 5.373 de 06/12/1967", urn:"urn:lex:br:federal:lei:1967-12-06;5373", ementa:"Estima a Receita e Fixa a Despesa da União para o exercício financeiro de 1968.", arquivo:"federal/leis-ordinarias/1967/lei-5373-1967-12-06.md"}}, {id:"federal:BR:L:5286/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-05-10", numero:"5286", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-05-10;5286", vigente:true, titulo:"Lei nº 5.286 de 10/05/1967", urn:"urn:lex:br:federal:lei:1967-05-10;5286", ementa:"Estende à Comarca de Guarujá, Estado de São Paulo, a jurisdição da Junta de Conciliação e Julgamento de Santos.", arquivo:"federal/leis-ordinarias/1967/lei-5286-1967-05-10.md"}}, {id:"federal:BR:L:5198/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-03", numero:"5198", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-03;5198", vigente:true, titulo:"Lei nº 5.198 de 03/01/1967", urn:"urn:lex:br:federal:lei:1967-01-03;5198", ementa:"Cria, sob a forma de Fundação, o Centro Brasileiro de TV Educativa.", arquivo:"federal/leis-ordinarias/1967/lei-5198-1967-01-03.md"}}, {id:"federal:BR:L:5338/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-10-16", numero:"5338", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-10-16;5338", vigente:true, titulo:"Lei nº 5.338 de 16/10/1967", urn:"urn:lex:br:federal:lei:1967-10-16;5338", ementa:"Dá nova redação ao item 79-01, alíneas 001 e 002, da Seção XV da Tarifa que acompanha a Lei nº 3.244 de 14 de agosto de 1957.", arquivo:"federal/leis-ordinarias/1967/lei-5338-1967-10-16.md"}}, {id:"federal:BR:L:5377/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-12-11", numero:"5377", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-12-11;5377", vigente:true, titulo:"Lei nº 5.377 de 11/12/1967", urn:"urn:lex:br:federal:lei:1967-12-11;5377", ementa:"Disciplina a Profissão de Relações Públicas e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5377-1967-12-11.md"}}, {id:"federal:BR:L:5311/1967", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-08-18", numero:"5311", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-08-18;5311", vigente:true, titulo:"Lei nº 5.311 de 18/08/1967", urn:"urn:lex:br:federal:lei:1967-08-18;5311", ementa:"Dispõe sobre a criação de cargos no Quadro de Pessoal do Ministério do Exército para melhor atender as organizações de saúde do Exército.", arquivo:"federal/leis-ordinarias/1967/lei-5311-1967-08-18.md"}}, {id:"federal:BR:L:5273/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-24", numero:"5273", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-24;5273", vigente:true, titulo:"Lei nº 5.273 de 24/04/1967", urn:"urn:lex:br:federal:lei:1967-04-24;5273", ementa:"Amplia o Quadro do Pessoal da Justiça do Trabalho da 8ª Região e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5273-1967-04-24.md"}}, {id:"federal:BR:L:5200/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-12", numero:"5200", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-12;5200", vigente:true, titulo:"Lei nº 5.200 de 12/01/1967", urn:"urn:lex:br:federal:lei:1967-01-12;5200", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Marinha, o crédito especial de Cr$ 424.716.780 (quatrocentos e vinte e quatro milhões setecentos e dezesseis mil setecentos e oitenta cruzeiros), correspondente ao excesso de arrecadação do \"Imposto de Faróis\", nos exercícios de 1963, 1964 e 1965.", arquivo:"federal/leis-ordinarias/1967/lei-5200-1967-01-12.md"}}, {id:"federal:BR:L:3291/1886", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1886, data:"1886-08-14", numero:"3291", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1886-08-14;3291", vigente:true, titulo:"Lei nº 3.291 de 14/08/1886", urn:"urn:lex:br:federal:lei:1886-08-14;3291", ementa:"CONCEDE AO MINISTÉRIO DOS NEGÓCIOS DO IMPÉRIO CRÉDITOS SUPLEMENTARES NA IMPORTÂNCIA DE 960:964$258, DO EXERCÍCIO DE 1884 - 1885.", arquivo:"federal/leis-ordinarias/1886/lei-3291-1886-08-14.md"}}, {id:"federal:BR:L:3275/1886", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1886, data:"1886-06-23", numero:"3275", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1886-06-23;3275", vigente:true, titulo:"Lei nº 3.275 de 23/06/1886", urn:"urn:lex:br:federal:lei:1886-06-23;3275", ementa:"FIXA AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1886 A 1887.", arquivo:"federal/leis-ordinarias/1886/lei-3275-1886-06-23.md"}}, {id:"federal:BR:L:3312/1886", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1886, data:"1886-10-15", numero:"3312", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1886-10-15;3312", vigente:true, titulo:"Lei nº 3.312 de 15/10/1886", urn:"urn:lex:br:federal:lei:1886-10-15;3312", ementa:"CONCEDE AO MINISTERIO DOS NEGOCIOS DA MARINHA, O CREDITO DE TRINTA E NOVE CONTOS SETECENTOS E NOVENTA MIL E DEZ REIS (39:790$010), PARA ATENDER AS DESPESAS DAS VERBAS - CORPO DA ARMADA E CLASSES ANEXAS - E - MUNIÇÕES NAVAIS - DO EXERCICIO DE 1884 - 1885.", arquivo:"federal/leis-ordinarias/1886/lei-3312-1886-10-15.md"}}, {id:"federal:BR:L:3308/1886", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1886, data:"1886-10-09", numero:"3308", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1886-10-09;3308", vigente:true, titulo:"Lei nº 3.308 de 09/10/1886", urn:"urn:lex:br:federal:lei:1886-10-09;3308", ementa:"CONCEDE AO MINISTERIO DOS NEGOCIOS DA AGRICULTURA, COMERCIO E OBRAS PUBLICAS UM CREDITO DE 3.764:097$465 APLICÁVEL A PAGAMENTO DE DIVIDA AO EMPREITEIRO DO PROLONGAMENTO DA ESTRADA DE FERRO DO RECIFE A S. FRANCISCO E RAMAL DO RECIFE A CARUARU.", arquivo:"federal/leis-ordinarias/1886/lei-3308-1886-10-09.md"}}, {id:"federal:BR:L:3310/1886", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1886, data:"1886-10-15", numero:"3310", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1886-10-15;3310", vigente:true, titulo:"Lei nº 3.310 de 15/10/1886", urn:"urn:lex:br:federal:lei:1886-10-15;3310", ementa:"REVOGA O ARTIGO 60, DO CODIGO CRIMINAL E A LEI 4, DE 10 DE JUNHO DE 1835, NA PARTE EM QUE IMPÕE A PENA DE AÇOITES.", arquivo:"federal/leis-ordinarias/1886/lei-3310-1886-10-15.md"}}, {id:"federal:BR:L:3313/1886", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1886, data:"1886-10-16", numero:"3313", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1886-10-16;3313", vigente:true, titulo:"Lei nº 3.313 de 16/10/1886", urn:"urn:lex:br:federal:lei:1886-10-16;3313", ementa:"ORÇA A RECEITA GERAL DO IMPÉRIO PARA O EXERCÍCIO DE 1886 - 1887 E 2º SEMESTRE DO ANO DE 1887, E DÁ OUTRAS PROVIDÊNCIAS.", arquivo:"federal/leis-ordinarias/1886/lei-3313-1886-10-16.md"}}, {id:"federal:BR:L:3286/1886", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1886, data:"1886-08-07", numero:"3286", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1886-08-07;3286", vigente:true, titulo:"Lei nº 3.286 de 07/08/1886", urn:"urn:lex:br:federal:lei:1886-08-07;3286", ementa:"AUMENTA DE 107:000$000 O CREDITO CONCEDIDO A VERBA - OBRAS PUBLICAS - DO EXERCICIO DE 1884 - 1885.", arquivo:"federal/leis-ordinarias/1886/lei-3286-1886-08-07.md"}}, {id:"federal:BR:L:3288/1886", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1886, data:"1886-08-14", numero:"3288", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1886-08-14;3288", vigente:true, titulo:"Lei nº 3.288 de 14/08/1886", urn:"urn:lex:br:federal:lei:1886-08-14;3288", ementa:"ABRE AO MINISTÉRIO DOS NEGÓCIOS DA MARINHA O CRÉDITO SUPLEMENTAR DE 43:526$641 PARA ATENDER AS DESPESAS DAS VERBAS - MUNIÇÕES NAVAIS - E 