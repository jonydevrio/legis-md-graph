ero:"1377", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1951-06-06;1377", vigente:true, titulo:"Lei nº 1.377 de 06/06/1951", urn:"urn:lex:br:federal:lei:1951-06-06;1377", ementa:"Altera os artigos 13 e 14 do Decreto-lei nº 3.347, de 12 de junho de 1941, que institui o regime de benefícios de família.", arquivo:"federal/leis-ordinarias/1951/lei-1377-1951-06-06.md"}}, {id:"federal:BR:L:1308/1951", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1951, data:"1951-01-10", numero:"1308", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1951-01-10;1308", vigente:true, titulo:"Lei nº 1.308 de 10/01/1951", urn:"urn:lex:br:federal:lei:1951-01-10;1308", ementa:"Estende aos servidores civis do Ministério da Aeronáutica, quando   invalidados ou mortos, em virtude de acidente de aviação, as vantagens   concedidas aos militares da Aeronáutica pelos Decretos-leis números 3.269, de 14 de   Maio de 1941, e 6.239, de 3 de Fevereiro de 1944.", arquivo:"federal/leis-ordinarias/1951/lei-1308-1951-01-10.md"}}, {id:"federal:BR:L:1312/1951", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1951, data:"1951-01-15", numero:"1312", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1951-01-15;1312", vigente:true, titulo:"Lei nº 1.312 de 15/01/1951", urn:"urn:lex:br:federal:lei:1951-01-15;1312", ementa:"Autoriza o Tesouro Nacional a garantir empréstimo a ser contraido pela   Companhia Siderúrgica Nacional, para ampliar as instalações indústriais da Usina   de Volta Redonda.", arquivo:"federal/leis-ordinarias/1951/lei-1312-1951-01-15.md"}}, {id:"federal:BR:L:1408/1951", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1951, data:"1951-08-09", numero:"1408", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1951-08-09;1408", vigente:true, titulo:"Lei 