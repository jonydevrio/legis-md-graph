52, data:"1952-03-22", numero:"1582", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-03-22;1582", vigente:true, titulo:"Lei nº 1.582 de 22/03/1952", urn:"urn:lex:br:federal:lei:1952-03-22;1582", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras Públicas, do crédito especial de Cr$ 17.835.400,00, para ocorrer ao pagamento de diversos despesas relativas aos exercícios de 1947 e 1948.", arquivo:"federal/leis-ordinarias/1952/lei-1582-1952-03-22.md"}}, {id:"federal:BR:L:1678/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-09-26", numero:"1678", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-09-26;1678", vigente:true, titulo:"Lei nº 1.678 de 26/09/1952", urn:"urn:lex:br:federal:lei:1952-09-26;1678", ementa:"Isenta do pagamento dos Impostos de importação e taxas aduaneiras, maquinários usados, destinados ao fabrico de sabão, gordura e produtos similares.", arquivo:"federal/leis-ordinarias/1952/lei-1678-1952-09-26.md"}}, {id:"federal:BR:L:1573/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-03-13", numero:"1573", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-03-13;1573", vigente:true, titulo:"Lei nº 1.573 de 13/03/1952", urn:"urn:lex:br:federal:lei:1952-03-13;1573", ementa:"Manda contar, para efeito de disponibilidade e aposentadoria, o tempo de serviço prestado junto ao Serviço Especial de Saúde Pública.", arquivo:"federal/leis-ordinarias/1952/lei-1573-1952-03-13.md"}}, {id:"federal:BR:L:1544/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-01-08", numero:"1544", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-01-08;1544", vigente:true, titulo:"Lei nº 1.544 de 08/01/1952", urn:"urn:lex:br:federal:lei:1952-01-08;1544", e