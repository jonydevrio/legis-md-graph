", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-03-09", numero:"2439", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-03-09;2439", vigente:true, titulo:"Lei nº 2.439 de 09/03/1955", urn:"urn:lex:br:federal:lei:1955-03-09;2439", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito   especial de Cr$ 192.399.473,30, para completar o pagamento da quota do imposto   de renda devida nos municípios e referente ao exercício de 1953.", arquivo:"federal/leis-ordinarias/1955/lei-2439-1955-03-09.md"}}, {id:"federal:BR:L:2694/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-12-24", numero:"2694", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-12-24;2694", vigente:true, titulo:"Lei nº 2.694 de 24/12/1955", urn:"urn:lex:br:federal:lei:1955-12-24;2694", ementa:"Cria Juntas de Conciliação e Julgamento nas 1ª e 2ª Regiões da Justiça do Trabalho.", arquivo:"federal/leis-ordinarias/1955/lei-2694-1955-12-24.md"}}, {id:"federal:BR:L:2539/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-07-13", numero:"2539", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-07-13;2539", vigente:true, titulo:"Lei nº 2.539 de 13/07/1955", urn:"urn:lex:br:federal:lei:1955-07-13;2539", ementa:"Concede isenção de direitos de importação e taxas aduaneiras, para um órgão destinado à Igreja Matriz de Nossa Senhora do Carmo, em Campinas, Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1955/lei-2539-1955-07-13.md"}}, {id:"federal:BR:L:2545/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-07-16", numero:"2545", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-07-16;2545", vigente:true, titulo:"Lei nº 2.545 de 16/07/1955", urn:"urn:lex:br:federal:lei:1955-07-16;2545", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério do Trabalho, Indústria e Comércio, o crédito especial de Cr$ 2.483.500,00 para atender ao pagamento de salários de extranumerários tarefeiros.", arquivo:"federal/leis-ordinarias/1955/lei-2545-1955-07-16.md"}}, {id:"federal:BR:L:2556/1874", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1874, data:"1874-09-26", numero:"2556", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1874-09-26;2556", vigente:true, titulo:"Lei nº 2.556 de 26/09/1874", urn:"urn:lex:br:federal:lei:1874-09-26;2556", ementa:"ESTABELECE O MODO E AS CONDIÇÕES DO RECRUTAMENTO PARA O EXERCITO E ARMADA.", arquivo:"federal/leis-ordinarias/1874/lei-2556-1874-09-26.md"}}, {id:"federal:BR:L:2534/1874", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1874, data:"1874-09-09", numero:"2534", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1874-09-09;2534", vigente:true, titulo:"Lei nº 2.534 de 09/09/1874", urn:"urn:lex:br:federal:lei:1874-09-09;2534", ementa:"FIXA A FORÇA NAVAL PARA O ANNO FINANCEIRO DE MIL OITOCENTOS SETENTA E CINCO A MIL OITOCENTOS SETENTA E SEIS.", arquivo:"federal/leis-ordinarias/1874/lei-2534-1874-09-09.md"}}, {id:"federal:BR:L:2530/1874", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1874, data:"1874-09-09", numero:"2530", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1874-09-09;2530", vigente:true, titulo:"Lei nº 2.530 de 09/09/1874", urn:"urn:lex:br:federal:lei:1874-09-09;2530", ementa:"FIXA AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1875 A 1876.", arquivo:"federal/leis-ordinarias/1874/lei-2530-1874-09-09.md"}}, {id:"federal:BR:L:2497/1911", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1911, data:"1911-11-30", numero:"2497", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1911-11-30;2497", vigente:true, titulo:"Lei nº 2.497 de 30/11/1911", urn:"urn:lex:br:federal:lei:1911-11-30;2497", ementa:"Fixa as forças de terra para o exercicio de 1912", arquivo:"federal/leis-ordinarias/1911/lei-2497-1911-11-30.md"}}, {id:"federal:BR:L:2416/1911", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1911, data:"1911-06-28", numero:"2416", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1911-06-28;2416", vigente:true, titulo:"Lei nº 2.416 de 28/06/1911", urn:"urn:lex:br:federal:lei:1911-06-28;2416", ementa:"Regula a extradição de nacionaes e estrangeiros e o processo e julgamento   dos mesmos, quando, fóra do paiz, perpetrarem algum dos crimes mencionados nesta   lei", arquivo:"federal/leis-ordinarias/1911/lei-2416-1911-06-28.md"}}, {id:"federal:BR:L:2524/1911", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1911, data:"1911-12-31", numero:"2524", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1911-12-31;2524", vigente:true, titulo:"Lei nº 2.524 de 31/12/1911", urn:"urn:lex:br:federal:lei:1911-12-31;2524", ementa:"Orça a receita geral da Republica dos Estalos Unidos do Brazil para o exercicio de 1912", arquivo:"federal/leis-ordinarias/1911/lei-2524-1911-12-31.md"}}, {id:"federal:BR:L:s/n/1830:3775", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-12-07", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-12-07;seq-sf-0", titulo:"Lei  de 07/12/1830", vigente:true, urn:"urn:lex:br:federal:lei:1830-12-07;seq-sf-0", ementa:"EXTINGUE A JUNTA DA DIREÇÃO DA TIPOGRAFIA NACIONAL, DANDO NOVA FORMA A SUA ADMINISTRAÇÃO.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-12-07-s0.md"}}, {id:"federal:BR:L:s/n/1830:3776", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-09-10", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-09-10;seq-sf-0", titulo:"Lei  de 10/09/1830", vigente:true, urn:"urn:lex:br:federal:lei:1830-09-10;seq-sf-0", ementa:"EXTINGUE A MESA DO DESPACHO MARITIMO PASSANDO AS SUAS INCUMBENCIAS PARA AS ESTAÇÕES ARRECADADORAS DOS DIREITOS DE SAIDA.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-09-10-s0.md"}}, {id:"federal:BR:L:s/n/1830:3777", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-12-16", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-12-16;seq-sf-0", titulo:"Lei  de 16/12/1830", vigente:true, urn:"urn:lex:br:federal:lei:1830-12-16;seq-sf-0", ementa:"MANDA EXECUTAR O CODIGO CRIMINAL.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-12-16-s0.md"}}, {id:"federal:BR:L:s/n/1830:3778", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-08-28", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-08-28;seq-sf-0", titulo:"Lei  de 28/08/1830", vigente:true, urn:"urn:lex:br:federal:lei:1830-08-28;seq-sf-0", ementa:"CONCEDE PRIVILEGIO AO QUE DESCOBRIR, INVENTAR OU MELHORAR UMA INDÚSTRIA UTIL E UM PREMIO AO QUE INTRODUZIR UMA INDUSTRIA ESTRANGEIRA, E REGULA SUA CONCESSÃO.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-08-28-s0.md"}}, {id:"federal:BR:L:s/n/1830:3779", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-08-27", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-08-27;seq-sf-1", vigente:true, titulo:"Lei  de 27/08/1830 ( seq-sf: 1 )", urn:"urn:lex:br:federal:lei:1830-08-27;seq-sf-1", ementa:"DECLARA QUE FICAM PERTENCENDO AOS JUÍZES SECULARES AS CONTAS DOS TESTAMENTOS E A DECISÃO DE TODAS AS QUESTÕES A ELES RELATIVAS.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-08-27-s1.md"}}, {id:"federal:BR:L:s/n/1830:3780", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-12-04", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-12-04;seq-sf-1", vigente:true, titulo:"Lei  de 04/12/1830 ( seq-sf: 1 )", urn:"urn:lex:br:federal:lei:1830-12-04;seq-sf-1", ementa:"MANDA CRIAR UMA COMISSÃO PARA TOMAR CONTAS NA CORTE A CAIXA DA LEGAÇÃO DE LONDRES.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-12-04-s1.md"}}, {id:"federal:BR:L:s/n/1830:3781", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-11-24", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-11-24;seq-sf-0", titulo:"Lei  de 24/11/1830", vigente:true, urn:"urn:lex:br:federal:lei:1830-11-24;seq-sf-0", ementa:"FIXA AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1831 - 1832.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-11-24-s0.md"}}, {id:"federal:BR:L:s/n/1830:3782", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-08-26", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-08-26;seq-sf-0", titulo:"Lei  de 26/08/1830", vigente:true, urn:"urn:lex:br:federal:lei:1830-08-26;seq-sf-0", ementa:"CONCEDE FAVORES AOS ESTUDANTES BRASILEIROS QUE REGRESSAREM DA UNIVERSIDADE DE COIMBRA E ESCOLAS DE FRANCA ATE A DATA DA SUA PUBLICAÇÃO.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-08-26-s0.md"}}, {id:"federal:BR:L:s/n/1830:3783", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-12-09", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-12-09;seq-sf-0", titulo:"Lei  de 09/12/1830", vigente:true, urn:"urn:lex:br:federal:lei:1830-12-09;seq-sf-0", ementa:"EXTINGUE A CONGREGAÇÃO DOS PADRES DE SÃO FELIPE NERY, ESTABELECIDA EM PERNAMBUCO, E APLICA OS SEUS BENS PARA PATRIMONIO DE UMA CASA PIA DE EDUCAÇÃO DE ORFÃOS DESVALIDOS DE AMBOS OS SEXOS.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-12-09-s0.md"}}, {id:"federal:BR:L:s/n/1830:3784", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-10-30", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-10-30;seq-sf-0", titulo:"Lei  de 30/10/1830", vigente:true, urn:"urn:lex:br:federal:lei:1830-10-30;seq-sf-0", ementa:"DETERMINA QUE OS ESCRIVÃES  DOS JUIZES DE PAZ FORA DAS CIDADES, OU VILAS, SEJAM OS TABELIÕES DE NOTAS.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-10-30-s0.md"}}, {id:"federal:BR:L:s/n/1830:3785", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-12-04", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-12-04;seq-sf-0", titulo:"Lei  de 04/12/1830", vigente:true, urn:"urn:lex:br:federal:lei:1830-12-04;seq-sf-0", ementa:"REGULA OS DIREITOS DO ALGODÃO E DA CARNE SECA OU CHARQUE.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-12-04-s0.md"}}, {id:"federal:BR:L:s/n/1830:3786", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-09-11", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-09-11;seq-sf-0", titulo:"Lei  de 11/09/1830", vigente:true, urn:"urn:lex:br:federal:lei:1830-09-11;seq-sf-0", ementa:"ESTATUE QUE OS PRESOS, OU AFIANÇADOS, POSSAM SER CITADOS, E DEMANDADOS, SOB CERTAS PROVIDENCIAS, POR QUALQUER FEITO CIVIL.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-09-11-s0.md"}}, {id:"federal:BR:L:s/n/1830:3787", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-09-20", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-09-20;seq-sf-0", titulo:"Lei  de 20/09/1830", vigente:true, urn:"urn:lex:br:federal:lei:1830-09-20;seq-sf-0", ementa:"SOBRE O ABUSO DA LIBERDADE DA IMPRENSA.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-09-20-s0.md"}}, {id:"federal:BR:L:s/n/1830:3788", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-08-27", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-08-27;seq-sf-2", vigente:true, titulo:"Lei  de 27/08/1830 ( seq-sf: 2 )", urn:"urn:lex:br:federal:lei:1830-08-27;seq-sf-2", ementa:"EXTINGUE AS SUPERINTENDENCIAS E JUNTAS DO LANÇAMENTO DA DECIMA URBANA E CRIA COLETORES A QUEM ENCARREGA DESSE SERVIÇO.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-08-27-s2.md"}}, {id:"federal:BR:L:s/n/1830:3789", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-12-04", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-12-04;seq-sf-2", vigente:true, titulo:"Lei  de 04/12/1830 ( seq-sf: 2 )", urn:"urn:lex:br:federal:lei:1830-12-04;seq-sf-2", ementa:"EXTINGUE A CHANCELARIA-MOR DO IMPERIO E A SUPERINTENDENCIA DOS NOVOS DIREITOS.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-12-04-s2.md"}}, {id:"federal:BR:L:s/n/1830:3790", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-11-24", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-11-24;seq-sf-1", vigente:true, titulo:"Lei  de 24/11/1830 ( seq-sf: 1 )", urn:"urn:lex:br:federal:lei:1830-11-24;seq-sf-1", ementa:"EXTINGUE O COMISSARIO GERAL DO EXERCITO DURANTE A PAZ.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-11-24-s1.md"}}, {id:"federal:BR:L:s/n/1830:3791", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-11-25", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-11-25;seq-sf-0", titulo:"Lei  de 25/11/1830", vigente:true, urn:"urn:lex:br:federal:lei:1830-11-25;seq-sf-0", ementa:"REGULA AS FORÇAS NAVAIS PARA O ANO FINANCEIRO DE  1831 - 1832.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-11-25-s0.md"}}, {id:"federal:BR:L:s/n/1830:3792", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-12-15", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-12-15;seq-sf-0", titulo:"Lei  de 15/12/1830", vigente:true, urn:"urn:lex:br:federal:lei:1830-12-15;seq-sf-0", ementa:"ORÇA A RECEITA E FIXA A DESPESA PARA O ANO FINANCEIRO DE 1831 - 1832.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-12-15-s0.md"}}, {id:"federal:BR:L:s/n/1830:3793", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-08-27", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-08-27;seq-sf-0", titulo:"Lei  de 27/08/1830", vigente:true, urn:"urn:lex:br:federal:lei:1830-08-27;seq-sf-0", ementa:"MANDA ABRIR UM CANAL PARA FACILITAR O COMERCIO DA CAPITAL COM O INTERIOR DA PROVINCIA DO MARANHÃO.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-08-27-s0.md"}}, {id:"federal:BR:L:s/n/1830:3794", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-09-13", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-09-13;seq-sf-0", titulo:"Lei  de 13/09/1830", vigente:true, urn:"urn:lex:br:federal:lei:1830-09-13;seq-sf-0", ementa:"REGULA O CONTRATO POR ESCRITO SOBRE  PRESTAÇÃO DE SERVIÇOS FEITOS POR BRASILEIRO OU ESTRANGEIRO DENTRO OU FORA DO IMPERIO.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-09-13-s0.md"}}, {id:"federal:BR:L:s/n/1830:3795", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-12-09", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-12-09;seq-sf-1", vigente:true, titulo:"Lei  de 09/12/1830 ( seq-sf: 1 )", urn:"urn:lex:br:federal:lei:1830-12-09;seq-sf-1", ementa:"DECLARA NULOS E DE NENHUM EFEITO OS CONTRATOS ONEROSOS E ALIENAÇÕES FEITAS PELAS ORDENS REGULARES SEM PRECEDER LICENÇA DO GOVERNO.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-12-09-s1.md"}}, {id:"federal:BR:L:s/n/1830:3796", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1830, data:"1830-11-03", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1830-11-03;seq-sf-0", titulo:"Lei  de 03/11/1830", vigente:true, urn:"urn:lex:br:federal:lei:1830-11-03;seq-sf-0", ementa:"EXTINGUE A PROVEDORIA DE DEFUNTOS E AUSENTES.", arquivo:"federal/leis-ordinarias/1830/lei-sn-1830-11-03-s0.md"}}, {id:"federal:BR:L:953/1902", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1902, data:"1902-12-29", numero:"953", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1902-12-29;953", vigente:true, titulo:"Lei nº 953 de 29/12/1902", urn:"urn:lex:br:federal:lei:1902-12-29;953", ementa:"Orça a receita geral da Republica dos Estados Unidos do Brazil para o exercicio de 1903, e dá outras providencias", arquivo:"federal/leis-ordinarias/1902/lei-953-1902-12-29.md"}}, {id:"federal:BR:L:957/1902", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1902, data:"190