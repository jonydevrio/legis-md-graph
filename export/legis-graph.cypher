encia_origem:"revogada=false", ano:2009, data:"2009-07-03", numero:"11962", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-07-03;11962", vigente:true, titulo:"Lei nº 11.962 de 03/07/2009", urn:"urn:lex:br:federal:lei:2009-07-03;11962", ementa:"Altera o art. 1º da Lei nº 7.064, de 6 de dezembro de 1982, estendendo as regras desse diploma legal a todas as empresas que venham a contratar ou transferir trabalhadores para prestar serviço no exterior.", arquivo:"federal/leis-ordinarias/2009/lei-11962-2009-07-03.md"}}, {id:"federal:BR:L:11951/2009", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-06-24", numero:"11951", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-06-24;11951", vigente:true, titulo:"Lei nº 11.951 de 24/06/2009", urn:"urn:lex:br:federal:lei:2009-06-24;11951", ementa:"Altera o art. 36 da Lei nº 5.991, de 17 de dezembro de 1973, que dispõe sobre o controle sanitário do comércio de drogas, medicamentos, insumos farmacêuticos e correlatos, para proibir a captação de receitas contendo prescrições magistrais e oficinais por outros estabelecimentos de comércio de medicamentos que não as farmácias e vedar a intermediação de outros estabelecimentos.", arquivo:"federal/leis-ordinarias/2009/lei-11951-2009-06-24.md"}}, {id:"federal:BR:L:12033/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-09-29", numero:"12033", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-09-29;12033", vigente:true, titulo:"Lei nº 12.033 de 29/09/2009", urn:"urn:lex:br:federal:lei:2009-09-29;12033", ementa:"Altera a redação do parágrafo único do art. 145 do Decreto-Lei nº 2.848, de 7 de dezembro de 1940 - Código Penal, tornando pública condicionada a ação penal em razão da injúria que especifica.", arquivo:"federal/leis-ordinarias/2009/lei-12033-2009-09-29.md"}}, {