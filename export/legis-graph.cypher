leg.br/?urn=urn:lex:br:federal:lei:1984-10-02;7221", vigente:true, titulo:"Lei nº 7.221 de 02/10/1984", urn:"urn:lex:br:federal:lei:1984-10-02;7221", ementa:"Dispõe sobre os cargos de Suplente de Juiz do Trabalho Presidente de Junta   de Conciliação e Julgamento.", arquivo:"federal/leis-ordinarias/1984/lei-7221-1984-10-02.md"}}, {id:"federal:BR:L:7268/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-05", numero:"7268", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-05;7268", vigente:true, titulo:"Lei nº 7.268 de 05/12/1984", urn:"urn:lex:br:federal:lei:1984-12-05;7268", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério da Educação e Cultura, crédito especial até o limite de Cr$ 2.618.723.000 (dois bilhões, seiscentos e dezoito milhões, setecentos e vinte e três mil cruzeiros) para o fim que especifica.", arquivo:"federal/leis-ordinarias/1984/lei-7268-1984-12-05.md"}}, {id:"federal:BR:L:7184/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-04-16", numero:"7184", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-04-16;7184", vigente:true, titulo:"Lei nº 7.184 de 16/04/1984", urn:"urn:lex:br:federal:lei:1984-04-16;7184", ementa:"Dispõe sobre a incorporação aos proventos de aposentadoria das   Gratificações de Produtividade e de Nível Superior.", arquivo:"federal/leis-ordinarias/1984/lei-7184-1984-04-16.md"}}, {id:"federal:BR:L:7237/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-10-29", numero:"7237", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-10-29;7237", vigente:true, titulo:"Lei nº 7.237 de 29/10/1984", urn:"urn:lex:br:federal:lei:1984-10-29;7237", ementa:"Concede pensão especial a Augusto Bento Cirino e dá outras   providências.", arquivo:"federal/leis-ordinarias/1984/lei-7237-1984-10-29.md"}}, {id:"federal:BR:L:7290/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-19", numero:"7290", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-19;7290", vigente:true, titulo:"Lei nº 7.290 de 19/12/1984", urn:"urn:lex:br:federal:lei:1984-12-19;7290", ementa:"Define a atividade do Transportador Rodoviário Autônomo de Bens e dá   outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7290-1984-12-19.md"}}, {id:"federal:BR:L:7195/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-06-12", numero:"7195", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-06-12;7195", vigente:true, titulo:"Lei nº 7.195 de 12/06/1984", urn:"urn:lex:br:federal:lei:1984-06-12;7195", ementa:"Dispõe sobre a responsabilidade civil das agências de empregados   domésticos.", arquivo:"federal/leis-ordinarias/1984/lei-7195-1984-06-12.md"}}, {id:"federal:BR:L:7252/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-11-23", numero:"7252", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-11-23;7252", vigente:true, titulo:"Lei nº 7.252 de 23/11/1984", urn:"urn:lex:br:federal:lei:1984-11-23;7252", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério da Saúde, crédito especial até o limite de Cr$ 1.700.000.000 (um bilhão e setecentos milhões de cruzeiros) para o fim que especifica.", arquivo:"federal/leis-ordinarias/1984/lei-7252-1984-11-23.md"}}, {id:"federal:BR:L:7298/1984", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-28", numero:"7298", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-28;7298", vigente:true, titulo:"Lei nº 7.298 de 28/12/1984", urn:"urn:lex:br:federal:lei:1984-12-28;7298", ementa:"Autoriza o Poder Executivo a criar o Conselho Nacional de Vitivinicultura - CONAVIN, dispõe sobre o Plano Nacional da Vitivinicultura, o seguro e o preço mínimo da uva, e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7298-1984-12-28.md"}}, {id:"federal:BR:L:7262/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-03", numero:"7262", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-03;7262", vigente:true, titulo:"Lei nº 7.262 de 03/12/1984", urn:"urn:lex:br:federal:lei:1984-12-03;7262", ementa:"Altera dispositivos do Decreto-Lei nº 29, de 14 de novembro de 1966, que suprime a concessão de abatimentos de passagens e fretes no transporte aéreo, dispõe sobre a requisição de transporte, limita a concessão de passagem ou frete aéreo gratuito ou de cortesia, e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7262-1984-12-03.md"}}, {id:"federal:BR:L:7273/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-10", numero:"7273", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-10;7273", vigente:true, titulo:"Lei nº 7.273 de 10/12/1984", urn:"urn:lex:br:federal:lei:1984-12-10;7273", ementa:"Dispõe sobre a Busca e Salvamento de Vida Humana em Perigo no Mar, nos   Portos e nas Vias Navegáveis Interiores.", arquivo:"federal/leis-ordinarias/1984/lei-7273-1984-12-10.md"}}, {id:"federal:BR:L:7225/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-10-15", numero:"7225", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-10-15;7225", vigente:true, titulo:"Lei nº 7.225 de 15/10/1984", urn:"urn:lex:br:federal:lei:1984-10-15;7225", ementa:"Dispõe sobre o reposicionamento de servidores do Plano de Classificação de   Cargos do Serviço Civil do Distrito Federal, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1984/lei-7225-1984-10-15.md"}}, {id:"federal:BR:L:7281/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-11", numero:"7281", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-11;7281", vigente:true, titulo:"Lei nº 7.281 de 11/12/1984", urn:"urn:lex:br:federal:lei:1984-12-11;7281", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério da Educação e Cultura, crédito especial de Cr$ 2.520.700.000 (dois bilhões, quinhentos e vinte milhões e setecentos mil cruzeiros) para o fim que especifica.", arquivo:"federal/leis-ordinarias/1984/lei-7281-1984-12-11.md"}}, {id:"federal:BR:L:7187/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-04-26", numero:"7187", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-04-26;7187", vigente:true, titulo:"Lei nº 7.187 de 26/04/1984", urn:"urn:lex:br:federal:lei:1984-04-26;7187", ementa:"Altera o art. 3º da Lei nº 1.508, de 19 de dezembro de 1951, que regula o   processo das contravenções definidas nos arts. 58 e 60 do Decreto-Lei nº 6.259,   de 10 de fevereiro de 1944.", arquivo:"federal/leis-ordinarias/1984/lei-7187-1984-04-26.md"}}, {id:"federal:BR:L:7231/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-10-23", numero:"7231", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-10-23;7231", vigente:true, titulo:"Lei nº 7.231 de 23/10/1984", urn:"urn:lex:br:federal:lei:1984-10-23;7231", ementa:"Transfere competência do INCRA para o Ministério da Agricultura,   dispõe sobre o regime jurídico do pessoal do INCRA e dá outras   providências.", arquivo:"federal/leis-ordinarias/1984/lei-7231-1984-10-23.md"}}, {id:"federal:BR:L:7189/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-06-04", numero:"7189", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-06-04;7189", vigente:true, titulo:"Lei nº 7.189 de 04/06/1984", urn:"urn:lex:br:federal:lei:1984-06-04;7189", ementa:".Altera a redação do art. 379, da Consolidação das Leis do Trabalho, aprovada   pelo Decreto-Lei nº 5. 452, de 1º de maio de 1943.", arquivo:"federal/leis-ordinarias/1984/lei-7189-1984-06-04.md"}}, {id:"federal:BR:L:7294/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-19", numero:"7294", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-19;7294", vigente:true, titulo:"Lei nº 7.294 de 19/12/1984", urn:"urn:lex:br:federal:lei:1984-12-19;7294", ementa:"Autoriza o Instituto Nacional de Colonização e Reforma Agrária - INCRA a   doar o imóvel que menciona.", arquivo:"federal/leis-ordinarias/1984/lei-7294-1984-12-19.md"}}, {id:"federal:BR:L:7197/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-06-14", numero:"7197", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-06-14;7197", vigente:true, titulo:"Lei nº 7.197 de 14/06/1984", urn:"urn:lex:br:federal:lei:1984-06-14;7197", ementa:"Institui o \"Dia Nacional das Relações Públicas\".", arquivo:"federal/leis-ordinarias/1984/lei-7197-1984-06-14.md"}}, {id:"federal:BR:L:7286/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-18", numero:"7286", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-18;7286", vigente:true, titulo:"Lei nº 7.286 de 18/12/1984", urn:"urn:lex:br:federal:lei:1984-12-18;7286", ementa:"Concede pensão especial a Marcelle Jaulent dos Reis (Beatrix   Reynal).", arquivo:"federal/leis-ordinarias/1984/lei-7286-1984-12-18.md"}}, {id:"federal:BR:L:7210/1984", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-07-11", numero:"7210", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-07-11;7210", vigente:true, titulo:"Lei nº 7.210 de 11/07/1984", urn:"urn:lex:br:federal:lei:1984-07-11;7210", ementa:"Institui a Lei de Execução Penal.", arquivo:"federal/leis-ordinarias/1984/lei-7210-1984-07-11.md"}}, {id:"federal:BR:L:7251/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-11-19", numero:"7251", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-11-19;7251", vigente:true, titulo:"Lei nº 7.251 de 19/11/1984", urn:"urn:lex:br:federal:lei:1984-11-19;7251", ementa:"Dá nova redação ao art. 245 do Decreto-Lei nº 2.848, de 7 de dezembro de 1940 - Código Penal.", arquivo:"federal/leis-ordinarias/1984/lei-7251-1984-11-19.md"}}, {id:"federal:BR:L:7206/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-07-05", numero:"7206", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-07-05;7206", vigente:true, titulo:"Lei nº 7.206 de 05/07/1984", urn:"urn:lex:br:federal:lei:1984-07-05;7206", ementa:"Fixa a data da eleição dos vereadores dos municípios criados pela Lei n° 7.009, de 1º de julho de 1982, e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7206-1984-07-05.md"}}, {id:"federal:BR:L:7190/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-06-04", numero:"7190", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-06-04;7190", vigente:true, titulo:"Lei nº 7.190 de 04/06/1984", urn:"urn:lex:br:federal:lei:1984-06-04;7190", ementa:"Reajusta a pensão especial concedida pela Lei nº 3.919, de 19 de julho de   1961, a HAYDÉA LAGO BITTENCOURT, viúva do Senador LÚCIO   BITTENCOURT.", arquivo:"federal/leis-ordinarias/1984/lei-7190-1984-06-04.md"}}, {id:"federal:BR:L:7265/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-04", numero:"7265", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-04;7265", vigente:true, titulo:"Lei nº 7.265 de 04/12/1984", urn:"urn:lex:br:federal:lei:1984-12-04;7265", ementa:"Institui o Mérito Musical e Popular Lupicínio Rodrigues, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1984/lei-7265-1984-12-04.md"}}, {id:"federal:BR:L:7209/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-07-11", numero:"7209", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-07-11;7209", vigente:true, titulo:"Lei nº 7.209 de 11/07/1984", urn:"urn:lex:br:federal:lei:1984-07-11;7209", ementa:"Altera dispositivos do Decreto-lei nº 2.848, de 7 de dezembro de 1940 - Código Penal, e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7209-1984-07-11.md"}}, {id:"federal:BR:L:7277/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-10", numero:"7277", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-10;7277", vigente:true, titulo:"Lei nº 7.277 de 10/12/1984", urn:"urn:lex:br:federal:lei:1984-12-10;7277", ementa:"Estima a Receita e fixa a Despesa do Distrito Federal para o Exercício Financeiro de 1985.", arquivo:"federal/leis-ordinarias/1984/lei-7277-1984-12-10.md"}}, {id:"federal:BR:L:7248/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-11-13", numero:"7248", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-11-13;7248", vigente:true, titulo:"Lei nº 7.248 de 13/11/1984", urn:"urn:lex:br:federal:lei:1984-11-13;7248", ementa:"Altera vantagens dos Cargos que especifica.", arquivo:"federal/leis-ordinarias/1984/lei-7248-1984-11-13.md"}}, {id:"federal:BR:L:7213/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-08-15", numero:"7213", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-08-15;7213", vigente:true, titulo:"Lei nº 7.213 de 15/08/1984", urn:"urn:lex:br:federal:lei:1984-08-15;7213", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério do Interior, crédito especial até o limite de Cr$ 11.500.000.000,00 ( onze bilhões e quinhentos milhões de cruzeiros ) para o fim que especifica.", arquivo:"federal/leis-ordinarias/1984/lei-7213-1984-08-15.md"}}, {id:"federal:BR:L:7285/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-11", numero:"7285", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-11;7285", vigente:true, titulo:"Lei nº 7.285 de 11/12/1984", urn:"urn:lex:br:federal:lei:1984-12-11;7285", ementa:"Autoriza a reversão ao Município de Barra do Garças, Estado de Mato   Grosso, do terreno que menciona.", arquivo:"federal/leis-ordinarias/1984/lei-7285-1984-12-11.md"}}, {id:"federal:BR:L:7297/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-20", numero:"7297", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-20;7297", vigente:true, titulo:"Lei nº 7.297 de 20/12/1984", urn:"urn:lex:br:federal:lei:1984-12-20;7297", ementa:"Dispõe sobre a criação de cargos no Quadro Permanente da Secretaria do   Tribunal Regional Eleitoral do Estado de Goiás e dá outras   providências.", arquivo:"federal/leis-ordinarias/1984/lei-7297-1984-12-20.md"}}, {id:"federal:BR:L:7220/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-10-02", numero:"7220", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-10-02;7220", vigente:true, titulo:"Lei nº 7.220 de 02/10/1984", urn:"urn:lex:br:federal:lei:1984-10-02;7220", ementa:"Reajusta a pensão especial concedida pela Lei nº 3801, de 2 de agosto de   1960, a Antônia Colombino Souza Naves, viúva do ex-Senador Abilon de Souza   Naves, e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7220-1984-10-02.md"}}, {id:"federal:BR:L:7267/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-05", numero:"7267", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-05;7267", vigente:true, titulo:"Lei nº 7.267 de 05/12/1984", urn:"urn:lex:br:federal:lei:1984-12-05;7267", ementa:"Dispõe sobre a estrutura das Categorias Funcionais do Grupo-Atividades de Apoio Judiciário da Justiça do Trabalho, altera dispositivos pertinentes, e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7267-1984-12-05.md"}}, {id:"federal:BR:L:7182/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-03-27", numero:"7182", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-03-27;7182", vigente:true, titulo:"Lei nº 7.182 de 27/03/1984", urn:"urn:lex:br:federal:lei:1984-03-27;7182", ementa:"Dá nova redação ao parágrafo único do artigo 4º da Lei nº 4.591, de 16 de dezembro de 1964.", arquivo:"federal/leis-ordinarias/1984/lei-7182-1984-03-27.md"}}, {id:"federal:BR:L:7236/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-10-29", numero:"7236", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-10-29;7236", vigente:true, titulo:"Lei nº 7.236 de 29/10/1984", urn:"urn:lex:br:federal:lei:1984-10-29;7236", ementa:"Altera a estrutura das categorias funcionais de Motorista Oficial, Agente   de Portaria e Engenheiro Florestal do Plano de Classificação de Cargos   instituído pela Lei nº 5.920, de 19 de setembro de 1973, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1984/lei-7236-1984-10-29.md"}}, {id:"federal:BR:L:7203/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-07-03", numero:"7203", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-07-03;7203", vigente:true, titulo:"Lei nº 7.203 de 03/07/1984", urn:"urn:lex:br:federal:lei:1984-07-03;7203", ementa:"Dispõe sobre a assistência e salvamento de embarcação, coisa ou bem em   perigo no mar, nos portos e nas vias navegáveis interiores.", arquivo:"federal/leis-ordinarias/1984/lei-7203-1984-07-03.md"}}, {id:"federal:BR:L:7219/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-09-19", numero:"7219", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-09-19;7219", vigente:true, titulo:"Lei nº 7.219 de 19/09/1984", urn:"urn:lex:br:federal:lei:1984-09-19;7219", ementa:"Dá nova redação ao art. 280 da Lei nº 5.869, de 11 de janeiro de 1973 -   Código de Processo Civil.", arquivo:"federal/leis-ordinarias/1984/lei-7219-1984-09-19.md"}}, {id:"federal:BR:L:7280/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-11", numero:"7280", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-11;7280", vigente:true, titulo:"Lei nº 7.280 de 11/12/1984", urn:"urn:lex:br:federal:lei:1984-12-11;7280", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério da Educação e Cultura, crédito especial no valor de Cr$ 4.431.400.000 (quatro bilhões, quatrocentos e trinta e um milhões e quatrocentos mil cruzeiros) para o fim que especifica.", arquivo:"federal/leis-ordinarias/1984/lei-7280-1984-12-11.md"}}, {id:"federal:BR:L:7289/1984", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-18", numero:"7289", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-18;7289", vigente:true, titulo:"Lei nº 7.289 de 18/12/1984", urn:"urn:lex:br:federal:lei:1984-12-18;7289", ementa:"Dispõe sobre o Estatuto dos Policiais-Militares da Polícia Militar do Distrito Federal e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7289-1984-12-18.md"}}, {id:"federal:BR:L:7261/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-03", numero:"7261", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-03;7261", vigente:true, titulo:"Lei nº 7.261 de 03/12/1984", urn:"urn:lex:br:federal:lei:1984-12-03;7261", ementa:"Altera a estrutura da Categoria Funcional de Enfermeiro, do Grupo-Outras   Atividades de Nível Superior, e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7261-1984-12-03.md"}}, {id:"federal:BR:L:7242/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-11-05", numero:"7242", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-11-05;7242", vigente:true, titulo:"Lei nº 7.242 de 05/11/1984", urn:"urn:lex:br:federal:lei:1984-11-05;7242", ementa:"Altera a estrutura de categorias funcionais do Grupo-Outras Atividades de   Nível Superior, de que trata a Lei nº 5.920, de 19 de setembro de 1973, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7242-1984-11-05.md"}}, {id:"federal:BR:L:7272/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-10", numero:"7272", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-10;7272", vigente:true, titulo:"Lei nº 7.272 de 10/12/1984", urn:"urn:lex:br:federal:lei:1984-12-10;7272", ementa:"Altera a estrutura da Categoria Funcional de Meteorologista, do   Grupo-Outras Atividades de Nível Superior, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1984/lei-7272-1984-12-10.md"}}, {id:"federal:BR:L:7224/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-10-15", numero:"7224", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-10-15;7224", vigente:true, titulo:"Lei nº 7.224 de 15/10/1984", urn:"urn:lex:br:federal:lei:1984-10-15;7224", ementa:"Autoriza o Departamento Nacional de Obras Contra as Secas - DNOCS,   Autarquia vinculada ao Ministério do Interior, a doar os imóveis que menciona,   situados no município de Iracema, no Estado do Ceará.", arquivo:"federal/leis-ordinarias/1984/lei-7224-1984-10-15.md"}}, {id:"federal:BR:L:7293/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-19", numero:"7293", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-19;7293", vigente:true, titulo:"Lei nº 7.293 de 19/12/1984", urn:"urn:lex:br:federal:lei:1984-12-19;7293", ementa:"Altera a denominação e o valor de vencimento mensal dos cargos que   especifica e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7293-1984-12-19.md"}}, {id:"federal:BR:L:7215/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-08-30", numero:"7215", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-08-30;7215", vigente:true, titulo:"Lei nº 7.215 de 30/08/1984", urn:"urn:lex:br:federal:lei:1984-08-30;7215", ementa:"Dispõe sobre a criação de cargos na Secretaria do Tribunal Superior do Trabalho e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7215-1984-08-30.md"}}, {id:"federal:BR:L:7264/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-04", numero:"7264", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-04;7264", vigente:true, titulo:"Lei nº 7.264 de 04/12/1984", urn:"urn:lex:br:federal:lei:1984-12-04;7264", ementa:"Dá nova redação a dispositivos da Lei nº 5.292, de 8 de junho de 1967, que dispõe sobre a prestação do Serviço Militar pelos estudantes de Medicina, Farmácia, Odontologia e Veterinária e pelos Médicos, Farmacêuticos, Dentistas e Veterinários, em decorrência de dispositivos da Lei nº 4.375, de 17 de agosto de 1964.", arquivo:"federal/leis-ordinarias/1984/lei-7264-1984-12-04.md"}}, {id:"federal:BR:L:7199/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-06-19", numero:"7199", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-06-19;7199", vigente:true, titulo:"Lei nº 7.199 de 19/06/1984", urn:"urn:lex:br:federal:lei:1984-06-19;7199", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério da Saúde, crédito especial até o limite de Cr$ 1.358.687.000,00 ( um bilhão, trezentos e cinquenta e oito milhões, seiscentos e oitenta e sete mil cruzeiros ) para o fim que especifica.", arquivo:"federal/leis-ordinarias/1984/lei-7199-1984-06-19.md"}}, {id:"federal:BR:L:7216/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-09-10", numero:"7216", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-09-10;7216", vigente:true, titulo:"Lei nº 7.216 de 10/09/1984", urn:"urn:lex:b