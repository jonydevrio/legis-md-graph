"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-04-02", numero:"3379", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-04-02;3379", vigente:true, titulo:"Lei nº 3.379 de 02/04/1958", urn:"urn:lex:br:federal:lei:1958-04-02;3379", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Relações   Exteriores, o crédito especial de Cr$ 10.000.000,00, como reforço para atender   às despesas finais decorrentes da visita, ao Brasil, do Presidente da República   Portuguesa.", arquivo:"federal/leis-ordinarias/1958/lei-3379-1958-04-02.md"}}, {id:"federal:BR:L:3414/1958", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-06-20", numero:"3414", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-06-20;3414", vigente:true, titulo:"Lei nº 3.414 de 20/06/1958", urn:"urn:lex:br:federal:lei:1958-06-20;3414", ementa:"Fixa vencimentos de Juízes e Membros do Ministério Público e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3414-1958-06-20.md"}}, {id:"federal:BR:L:3371/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-03-12", numero:"3371", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-03-12;3371", vigente:true, titulo:"Lei nº 3.371 de 12/03/1958", urn:"urn:lex:br:federal:lei:1958-03-12;3371", ementa:"Concede o auxílio especial de Cr$ 1.000.000,00 à Casa dos Artistas do Rio   de Janeiro.", arquivo:"federal/leis-ordinarias/1958/lei-3371-1958-03-12.md"}}, {id:"federal:BR:L:3472/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-01", numero:"3472", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-01;3472", vigente:true, titulo:"Lei nº 3.472 de 01/12/1958", urn:"urn:lex:br:federal:lei:1958-12-01;3472", ementa:"Autoriza a abertura de créditos especiais no total de Cr$ 2.133.767.323,30   para atender a pagamentos no Departamento Administrativo do Serviço Público e   nos Ministérios da Aeronáutica, Agricultura, Educação e Cultura, Fezenda,   Guerra, Justiça e Negócios Interiores, Marinha, Relações Exteriores, Saúde,   Trabalho, Indústria e Comércio e Viação e Obras Públicas.", arquivo:"federal/leis-ordinarias/1958/lei-3472-1958-12-01.md"}}, {id:"federal:BR:L:3398/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-06-07", numero:"3398", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-06-07;3398", vigente:true, titulo:"Lei nº 3.398 de 07/06/1958", urn:"urn:lex:br:federal:lei:1958-06-07;3398", ementa:"Abre ao Poder Judiciário - Justiça Eleitoral - Tribunal Regional Eleitoral   do Rio Grande do Norte, o crédito especial de Cr$ 172.000,00, para pagamento de   gratificação pela prestação de serviço eleitoral, a Juizes e Escrivães   Eleitorais, no mês de dezembro de 1956.", arquivo:"federal/leis-ordinarias/1958/lei-3398-1958-06-07.md"}}, {id:"federal:BR:L:3503/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-24", numero:"3503", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-24;3503", vigente:true, titulo:"Lei nº 3.503 de 24/12/1958", urn:"urn:lex:br:federal:lei:1958-12-24;3503", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito   especial de Cr$ 38.033.056,60 para completar pagamento da percentagem devida aos   municípios, referente ao exercício de 1956, \"ex vi\" do art. 15, § 4º, da   Constituição Federal.", arquivo:"federal/leis-ordinarias/1958/lei-3503-1958-12-24.md"}}, {id:"federal:BR:L:3463/1958", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-11-20", numero:"3463", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-11-20;3463", vigente:true, titulo:"Lei nº 3.463 de 20/11/1958", urn:"urn:lex:br:federal:lei:1958-11-20;3463", ementa:"Transforma em unidades universitárias os cursos de Odontologia e de Farmácia da Faculdade Fluminense de Medicina do Paraná e de Odontologia da Faculdade Fluminense de Medicina, e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3463-1958-11-20.md"}}, {id:"federal:BR:L:3387/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-05-19", numero:"3387", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-05-19;3387", vigente:true, titulo:"Lei nº 3.387 de 19/05/1958", urn:"urn:lex:br:federal:lei:1958-05-19;3387", ementa:"Retifica, sem ônus, a Lei nº 2.665, de 6 de dezembro de 1955, que estima a receita e fixa a Despesa da União para o exercício de 1956.", arquivo:"federal/leis-ordinarias/1958/lei-3387-1958-05-19.md"}}, {id:"federal:BR:L:3515/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-30", numero:"3515", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-30;3515", vigente:true, titulo:"Lei nº 3.515 de 30/12/1958", urn:"urn:lex:br:federal:lei:1958-12-30;3515", ementa:"Autoriza o Poder Executivo a abrir, pelo Tribunal de Contas, o crédito   especial de Cr$ 23.600.702,20, para atender a despesas decorrentes da Lei nº   3.334, de 10 de setembro de 1957.", arquivo:"federal/leis-ordinarias/1958/lei-3515-1958-12-30.md"}}, {id:"federal:BR:L:3450/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-11-06", numero:"3450", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-11-06;3450", vigente:true, titulo:"Lei nº 3.450 de 06/11/1958", urn:"urn:lex:br:federal:lei:1958-11-06;3450", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações   Exteriores, o crédito especial de Cr$ 5.000.000,00 para atender às despesas   decorrentes da visita ao Brasil do Presidente da República do   Paraguai.", arquivo:"federal/leis-ordinarias/1958/lei-3450-1958-11-06.md"}}, {id:"federal:BR:L:3404/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-06-12", numero:"3404", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-06-12;3404", vigente:true, titulo:"Lei nº 3.404 de 12/06/1958", urn:"urn:lex:br:federal:lei:1958-06-12;3404", ementa:"Autoriza a abertura de créditos especiais no total de Cr$   5.624.520.594,50, para os fins que menciona.", arquivo:"federal/leis-ordinarias/1958/lei-3404-1958-06-12.md"}}, {id:"federal:BR:L:3423/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-07-10", numero:"3423", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-07-10;3423", vigente:true, titulo:"Lei nº 3.423 de 10/07/1958", urn:"urn:lex:br:federal:lei:1958-07-10;3423", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 600.000,00 para auxiliar a realização do I Congresso   de Imprensa do Interior Nordestino.", arquivo:"federal/leis-ordinarias/1958/lei-3423-1958-07-10.md"}}, {id:"federal:BR:L:3459/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-11-18", numero:"3459", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-11-18;3459", vigente:true, titulo:"Lei nº 3.459 de 18/11/1958", urn:"urn:lex:br:federal:lei:1958-11-18;3459", ementa:"Concede isenção de direitos aduaneiros, imposto de consumo e taxas   alfandegárias para materiais e equipamentos importados pela Companhia de   Armazéns Gerais do Estado de Pernambuco - CAGEP.", arquivo:"federal/leis-ordinarias/1958/lei-3459-1958-11-18.md"}}, {id:"federal:BR:L:3386/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-05-16", numero:"3386", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-05-16;3386", vigente:true, titulo:"Lei nº 3.386 de 16/05/1958", urn:"urn:lex:br:federal:lei:1958-05-16;3386", ementa:"Reorganiza os Cursos do Departamento Nacional de Saúde (CDNS) e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3386-1958-05-16.md"}}, {id:"federal:BR:L:3399/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-06-11", numero:"3399", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-06-11;3399", vigente:true, titulo:"Lei nº 3.399 de 11/06/1958", urn:"urn:lex:br:federal:lei:1958-06-11;3399", ementa:"Fixa os efetivos dos Oficiais dos Corpos e Quadros da Marinha de Guerra e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3399-1958-06-11.md"}}, {id:"federal:BR:L:3384/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-04-28", numero:"3384", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-04-28;3384", vigente:true, titulo:"Lei nº 3.384 de 28/04/1958", urn:"urn:lex:br:federal:lei:1958-04-28;3384", ementa:"Dá nova redação à profissão de guarda-livros.", arquivo:"federal/leis-ordinarias/1958/lei-3384-1958-04-28.md"}}, {id:"federal:BR:L:3393/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-05-27", numero:"3393", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-05-27;3393", vigente:true, titulo:"Lei nº 3.393 de 27/05/1958", urn:"urn:lex:br:federal:lei:1958-05-27;3393", ementa:"Faculta aos cafeicultores a liberação da safra agrícola independentemente   do pagamento do débito vencível no ano de 1957, ou de 1958, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1958/lei-3393-1958-05-27.md"}}, {id:"federal:BR:L:3520/1958", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-30", numero:"3520", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-30;3520", vigente:true, titulo:"Lei nº 3.520 de 30/12/1958", urn:"urn:lex:br:federal:lei:1958-12-30;3520", ementa:"Altera a legislação do Imposto de Consumo e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3520-1958-12-30.md"}}, {id:"federal:BR:L:3493/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-19", numero:"3493", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-19;3493", vigente:true, titulo:"Lei nº 3.493 de 19/12/1958", urn:"urn:lex:br:federal:lei:1958-12-19;3493", ementa:"Concede isenção de direitos aduaneiros e mais taxas, inclusive a de   imposto de consumo, para material importado pela Empresa Jornal do Comércio   S.A., com sede no Recife, capital do Estado de Pernambuco.", arquivo:"federal/leis-ordinarias/1958/lei-3493-1958-12-19.md"}}, {id:"federal:BR:L:3511/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-30", numero:"3511", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-30;3511", vigente:true, titulo:"Lei nº 3.511 de 30/12/1958", urn:"urn:lex:br:federal:lei:1958-12-30;3511", ementa:"Concede a pensão especial de Cr$ 3.000,00 mensais a Alina de Carvalho   Costa, viúva de Antenor Gonçalves da Costa, ex-mestre de oficina aposentado do   Arsenal de Guerra do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1958/lei-3511-1958-12-30.md"}}, {id:"federal:BR:L:3467/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-11-28", numero:"3467", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-11-28;3467", vigente:true, titulo:"Lei nº 3.467 de 28/11/1958", urn:"urn:lex:br:federal:lei:1958-11-28;3467", ementa:"Isenta de impostos de importação e de consumo, inclusive a taxa aduaneira de 5%, trilhos de aço e respectivos acessórios, destinados à Companhia Paulista de Estrada de Ferro e mais empresas ferroviárias nas mesmas condições.", arquivo:"federal/leis-ordinarias/1958/lei-3467-1958-11-28.md"}}, {id:"federal:BR:L:3400/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-06-12", numero:"3400", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-06-12;3400", vigente:true, titulo:"Lei nº 3.400 de 12/06/1958", urn:"urn:lex:br:federal:lei:1958-06-12;3400", ementa:"Concede a pensão especial de Cr$ 5.000,00 mensais a Adelina Dutra, filha   do Dr. Antônio Dutra Nicácio, constituinte de 1891.", arquivo:"federal/leis-ordinarias/1958/lei-3400-1958-06-12.md"}}, {id:"federal:BR:L:3380/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-04-15", numero:"3380", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-04-15;3380", vigente:true, titulo:"Lei nº 3.380 de 15/04/1958", urn:"urn:lex:br:federal:lei:1958-04-15;3380", ementa:"Marca novo prazo para a realização do I Congresso Pan-Americano de   História da Medicina e do III Congresso Brasileiro de História da   Medicina.", arquivo:"federal/leis-ordinarias/1958/lei-3380-1958-04-15.md"}}, {id:"federal:BR:L:3476/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-01", numero:"3476", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-01;3476", vigente:true, titulo:"Lei nº 3.476 de 01/12/1958", urn:"urn:lex:br:federal:lei:1958-12-01;3476", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 272.162,00 para atender ao pagamento do abono de Natal, no exercício de 1949, aos servidores da Estrada de Ferro Tocantins.", arquivo:"federal/leis-ordinarias/1958/lei-3476-1958-12-01.md"}}, {id:"federal:BR:L:3375/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-03-12", numero:"3375", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-03-12;3375", vigente:true, titulo:"Lei nº 3.375 de 12/03/1958", urn:"urn:lex:br:federal:lei:1958-03-12;3375", ementa:"Concede isenção de tributos de importação e taxas aduaneiras para material   importado pela Telefonak-Tiebolaget LM Ericsson, destinado à Companhia de   Telefones do Brasil Central, com sede em Uberlândia, Estado de Minas   Gerais.", arquivo:"federal/leis-ordinarias/1958/lei-3375-1958-03-12.md"}}, {id:"federal:BR:L:3485/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-10", numero:"3485", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-10;3485", vigente:true, titulo:"Lei nº 3.485 de 10/12/1958", urn:"urn:lex:br:federal:lei:1958-12-10;3485", ementa:"Assegura promoção ao posto de 2º tenente aos Aspirantes a Oficial e   Sargentos do Corpo de Bombeiros do Distrito Federal, diplomados com o curso da   Escola para Sargentos dessa corporação, e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3485-1958-12-10.md"}}, {id:"federal:BR:L:3406/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-06-14", numero:"3406", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-06-14;3406", vigente:true, titulo:"Lei nº 3.406 de 14/06/1958", urn:"urn:lex:br:federal:lei:1958-06-14;3406", ementa:"Autoriza o Poder Executivo a abrir à Comissão do Vale do São Francisco o   crédito especial de Cr$ 5.000.000,00 para construção de uma ponte sobre o rio   das Velhas, na cidade de Jequitibá, Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/1958/lei-3406-1958-06-14.md"}}, {id:"federal:BR:L:3481/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-05", numero:"3481", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-05;3481", vigente:true, titulo:"Lei nº 3.481 de 05/12/1958", urn:"urn:lex:br:federal:lei:1958-12-05;3481", ementa:"Concede auxílio de Cr$ 12.000.000,00 à Confederação Brasileira de   Desportos para realização de capeonatos nacionais e participação do Brasil em   competições internacionais.", arquivo:"federal/leis-ordinarias/1958/lei-3481-1958-12-05.md"}}, {id:"federal:BR:L:3442/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-09-02", numero:"3442", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-09-02;3442", vigente:true, titulo:"Lei nº 3.442 de 02/09/1958", urn:"urn:lex:br:federal:lei:1958-09-02;3442", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 30.000.000,00 para auxiliar a construção da futura   sede do Instituto Histórico e Geográfico Brasileiro, no Distrito   Federal.", arquivo:"federal/leis-ordinarias/1958/lei-3442-1958-09-02.md"}}, {id:"federal:BR:L:3519/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-30", numero:"3519", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-30;3519", vigente:true, titulo:"Lei nº 3.519 de 30/12/1958", urn:"u