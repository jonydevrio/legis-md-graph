cia_origem:"revogada=false", ano:1984, data:"1984-10-29", numero:"7234", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-10-29;7234", vigente:true, titulo:"Lei nº 7.234 de 29/10/1984", urn:"urn:lex:br:federal:lei:1984-10-29;7234", ementa:"Autoriza o Governo do Distrito Federal a contratar empréstimo interno destinado ao desenvolvimento do Programa Aglomerados Urbanos.", arquivo:"federal/leis-ordinarias/1984/lei-7234-1984-10-29.md"}}, {id:"federal:BR:L:7254/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-11-26", numero:"7254", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-11-26;7254", vigente:true, titulo:"Lei nº 7.254 de 26/11/1984", urn:"urn:lex:br:federal:lei:1984-11-26;7254", ementa:"Altera a estrutura da Categoria Funcional de Psicólogo do Grupo-Outras   Atividades de Nível Superior, de que trata a Lei nº 5.920, de 19 de setembro de   1973, e dá outras providências.", arquivo:"federal/leis-ordinarias/1984/lei-7254-1984-11-26.md"}}, {id:"federal:BR:L:7214/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-08-15", numero:"7214", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-08-15;7214", vigente:true, titulo:"Lei nº 7.214 de 15/08/1984", urn:"urn:lex:br:federal:lei:1984-08-15;7214", ementa:"Extingue a fração do cruzeiro denominada centavo e dá outras   providências.", arquivo:"federal/leis-ordinarias/1984/lei-7214-1984-08-15.md"}}, {id:"federal:BR:L:7249/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-11-13", numero:"7249", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-11-13;7249", vigente:true, titulo:"Lei nº 7.249 de 13/11/1984", urn:"urn:lex:br:federal:lei:1984-11-13;7249", ementa:"Altera a estrutura da Categoria Funcional de Fiscal de 