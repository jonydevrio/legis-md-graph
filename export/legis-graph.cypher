ada=false", ano:1937, data:"1937-01-26", numero:"385", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-01-26;385", vigente:true, titulo:"Lei nº 385 de 26/01/1937", urn:"urn:lex:br:federal:lei:1937-01-26;385", ementa:"Obriga a inclusão de obras de autores brasileiros natos em qualquer programa   musical", arquivo:"federal/leis-ordinarias/1937/lei-385-1937-01-26.md"}}, {id:"federal:BR:L:581/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-11-09", numero:"581", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-11-09;581", vigente:true, titulo:"Lei nº 581 de 09/11/1937", urn:"urn:lex:br:federal:lei:1937-11-09;581", ementa:"Autoriza a abertura do crédito especial de 1.800:000$000, para construção   de dois aviões, pelo Parque Central de Aviação do Exército e dá outras   providências", arquivo:"federal/leis-ordinarias/1937/lei-581-1937-11-09.md"}}, {id:"federal:BR:L:562/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-10-29", numero:"562", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-10-29;562", vigente:true, titulo:"Lei nº 562 de 29/10/1937", urn:"urn:lex:br:federal:lei:1937-10-29;562", ementa:"Autoriza a abertura do credito de 7:753$300, para pagamento de   grafificação adicional ao SrL Aristophanes Monteiro de Barros Barbosa Lima", arquivo:"federal/leis-ordinarias/1937/lei-562-1937-10-29.md"}}, {id:"federal:BR:L:573/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-11-08", numero:"573", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-11-08;573", vigente:true, titulo:"Lei nº 573 de 08/11/1937", urn:"urn:lex:br:federal:lei:1937-11-08;573", ementa:"Dispõe sôbre a tomada de contas em atrazo", arquivo:"federal/leis-ordinarias/1937/lei-573-1937-11-08.md"}}, {id:"federal:BR:L:549/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-10-20", numero:"549", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-10-20;549", vigente:true, titulo:"Lei nº 549 de 20/10/1937", urn:"urn:lex:br:federal:lei:1937-10-20;549", ementa:"Dispõe sobre a fiscalização da produção, circulação e distribuição de   vinhos e derivados e criação do respectivo serviço.", arquivo:"federal/leis-ordinarias/1937/lei-549-1937-10-20.md"}}, {id:"federal:BR:L:409/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-03-23", numero:"409", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-03-23;409", vigente:true, titulo:"Lei nº 409 de 23/03/1937", urn:"urn:lex:br:federal:lei:1937-03-23;409", ementa:"Autoriza o Ministro da Viação e Obras Públicas a indenizar o Estado da   Bahia das despesas feitas com obras realizadas na Estrada Almas-Ipirá.", arquivo:"federal/leis-ordinarias/1937/lei-409-1937-03-23.md"}}, {id:"federal:BR:L:377/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-01-12", numero:"377", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-01-12;377", vigente:true, titulo:"Lei nº 377 de 12/01/1937", urn:"urn:lex:br:federal:lei:1937-01-12;377", ementa:"Eleva os vencimentos dos Ministros da Côrte Suprema e do Procurador Geral da Republica", arquivo:"federal/leis-ordinarias/1937/lei-377-1937-01-12.md"}}, {id:"federal:BR:L:434/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-05-14", numero:"434", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-05-14;434", vigente:true, titulo:"Lei nº 434 de 14/05/1937", urn:"urn:lex:br:federal:lei:1937-05-14;434", ementa:"Promulga dispositivos de lei n. 300, de 13 de novembro de 1936, que orça a   Receita Geral e fixa a Despesa da União para o exercício de   1937.", arquivo:"federal/leis-ordinarias/1937/lei-434-1937-05-14.md"}}, {id:"federal:BR:L:384/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-01-23", numero:"384", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-01-23;384", vigente:true, titulo:"Lei nº 384 de 23/01/1937", urn:"urn:lex:br:federal:lei:1937-01-23;384", ementa:"Reajusta os vencimentos e reorganiza o quadro do pessoal da Secretaria da   Camara dos Deputados", arquivo:"federal/leis-ordinarias/1937/lei-384-1937-01-23.md"}}, {id:"federal:BR:L:451/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-06-23", numero:"451", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-06-23;451", vigente:true, titulo:"Lei nº 451 de 23/06/1937", urn:"urn:lex:br:federal:lei:1937-06-23;451", ementa:"Estabelecer proporrilo dos Deputados para a legislatura de 1938-1942", arquivo:"federal/leis-ordinarias/1937/lei-451-1937-06-23.md"}}, {id:"federal:BR:L:427/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-04-22", numero:"427", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-04-22;427", vigente:true, titulo:"Lei nº 427 de 22/04/1937", urn:"urn:lex:br:federal:lei:1937-04-22;427", ementa:"Permite a dispensa dos serviços judiciários aos magistrados em exercício   no Tribunal Regional de Justiça Eleitoral do Distrito Federal", arquivo:"federal/leis-ordinarias/1937/lei-427-1937-04-22.md"}}, {id:"federal:BR:L:443/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-06-04", numero:"443", fonte:"https://normas.leg.br/?urn=ur