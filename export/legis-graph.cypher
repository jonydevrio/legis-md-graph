rsao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-22", numero:"9946", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-12-22;9946", vigente:true, titulo:"Lei nº 9.946 de 22/12/1999", urn:"urn:lex:br:federal:lei:1999-12-22;9946", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor da Justiça do Trabalho, crédito suplementar no valor de R$ 8.825.405,00, para reforço de dotações consignadas nos vigentes orçamentos.", arquivo:"federal/leis-ordinarias/1999/lei-9946-1999-12-22.md"}}, {id:"federal:BR:L:9925/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-16", numero:"9925", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-12-16;9925", vigente:true, titulo:"Lei nº 9.925 de 16/12/1999", urn:"urn:lex:br:federal:lei:1999-12-16;9925", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério dos Transportes, crédito suplementar no valor de R$ 10.000.000,00, para reforço de dotações consignadas no vigente orçamento.", arquivo:"federal/leis-ordinarias/1999/lei-9925-1999-12-16.md"}}, {id:"federal:BR:L:9814/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-08-23", numero:"9814", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-08-23;9814", vigente:true, titulo:"Lei nº 9.814 de 23/08/1999", urn:"urn:lex:br:federal:lei:1999-08-23;9814", ementa:"Acresce dispositivo às Leis nºs 9.526, de 8 de dezembro de 1997, e 9.496,   de 11 de setembro de 1997.", arquivo:"federal/leis-ordinarias/1999/lei-9814-1999-08-23.md"}}, {id:"federal:BR:L:9916/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-16", numero:"9916", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-12-16;9916", vigente:true, titulo:"Lei nº 9.916 de 16/12/1999", urn:"urn:lex:br:federal:lei:1999-12-16;9916", ementa:"Abre ao Orçamento Fiscal da União, em favor de Operações Oficiais de Crédito, crédito especial no valor de R$ 49.014.700,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1999/lei-9916-1999-12-16.md"}}, {id:"federal:BR:L:9782/1999", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-01-26", numero:"9782", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-01-26;9782", vigente:true, titulo:"Lei nº 9.782 de 26/01/1999", urn:"urn:lex:br:federal:lei:1999-01-26;9782", ementa:"Define o Sistema Nacional de Vigilância Sanitária, cria a Agência Nacional de Vigilância Sanitária, e dá outras providências.", arquivo:"federal/leis-ordinarias/1999/lei-9782-1999-01-26.md"}}, {id:"federal:BR:L:9939/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-20", numero:"9939", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-12-20;9939", vigente:true, titulo:"Lei nº 9.939 de 20/12/1999", urn:"urn:lex:br:federal:lei:1999-12-20;9939", ementa:"Abre ao Orçamento Fiscal da União, em favor de Encargos Financeiros da União, crédito suplementar no valor de R$ 12.458.518.000,00, para reforço de dotações consignadas no vigente orçamento.", arquivo:"federal/leis-ordinarias/1999/lei-9939-1999-12-20.md"}}, {id:"federal:BR:L:9857/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-11-04", numero:"9857", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-11-04;9857", vigente:true, titulo:"Lei nº 9.857 de 04/11/1999", urn:"urn:lex:br:federal:lei:1999-11-04;9857", ementa:"Denomina \"Ponte Ivan Alcides Dias\" a obra-de-arte especial localizada no Município de Camaquã, Estado do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1999/lei-9857-1999-11-04.md"}}, {id:"federal:BR:L:9837/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-09-23", numero:"9837", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-09-23;9837", vigente:true, titulo:"Lei nº 9.837 de 23/09/1999", urn:"urn:lex:br:federal:lei:1999-09-23;9837", ementa:"Dá nova redação a dispositivo da Lei nº 2.929, de 27 de outubro de 1956, que disciplina o processo de alteração ou retificação de idade dos oficiais das Forças Armadas e dá outras providências.", arquivo:"federal/leis-ordinarias/1999/lei-9837-1999-09-23.md"}}, {id:"federal:BR:L:9859/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-11-08", numero:"9859", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-11-08;9859", vigente:true, titulo:"Lei nº 9.859 de 08/11/1999", urn:"urn:lex:br:federal:lei:1999-11-08;9859", ementa:"Abre ao Orçamento de Investimento, em favor da empresa Companhia Docas do Rio de Janeiro, crédito especial até o limite de R$ 1.166.253,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1999/lei-9859-1999-11-08.md"}}, {id:"federal:BR:L:9796/1999", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-05-05", numero:"9796", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-05-05;9796", vigente:true, titulo:"Lei nº 9.796 de 05/05/1999", urn:"urn:lex:br:federal:lei:1999-05-05;9796", ementa:"Dispõe sobre a compensação financeira entre o Regime Geral de Previdência Social e os regimes de previdência dos servidores da União, dos Estados, do Distrito Federal e dos Municípios, nos casos de contagem recíproca de tempo de contribuição para efeito de aposentadoria, e dá outras providências.", arquivo:"federal/leis-ordinarias/1999/lei-9796-1999-05-05.md"}}, {id:"federal:BR:L:9897/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-14", numero:"9897", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-12-14;9897", vigente:true, titulo:"Lei nº 9.897 de 14/12/1999", urn:"urn:lex:br:federal:lei:1999-12-14;9897", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento da Seguridade Social da União, em favor do Ministério do Planejamento e Orçamento, crédito extraordinário no valor de R$ 183.000.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1999/lei-9897-1999-12-14.md"}}] AS row
