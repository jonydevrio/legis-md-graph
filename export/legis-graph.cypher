UNWIND [{id:"federal:BR:L:3787/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-08-02", numero:"3787", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-08-02;3787", vigente:true, titulo:"Lei nº 3.787 de 02/08/1960", urn:"urn:lex:br:federal:lei:1960-08-02;3787", ementa:"Transforma o atual Posto Zootécnico de Olhos d'Água do Acioli, no   Município de Palmeira dos Índios, Estado de Alagoas em Posto Agropecuário de   segundo tipo.", arquivo:"federal/leis-ordinarias/1960/lei-3787-1960-08-02.md"}}, {id:"federal:BR:L:3759/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-04-25", numero:"3759", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-04-25;3759", vigente:true, titulo:"Lei nº 3.759 de 25/04/1960", urn:"urn:lex:br:federal:lei:1960-04-25;3759", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Supremo Tribunal Federal, o crédito especial de Cr$ 1.953.348,00, para pagamento de funcionários.", arquivo:"federal/leis-ordinarias/1960/lei-3759-1960-04-25.md"}}, {id:"federal:BR:L:3809/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-09-06", numero:"3809", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-09-06;3809", vigente:true, titulo:"Lei nº 3.809 de 06/09/1960", urn:"urn:lex:br:federal:lei:1960-09-06;3809", ementa:"Consigna, no Orçamento Geral da União, durante quatro exercícios, a importancia de Cr$ 300.000.000,00, para pavimentação do trecho. Ponta Grossa à Foz do Iguaçu; e dá outras providências.", arquivo:"federal/leis-ordinarias/1960/lei-3809-1960-09-06.md"}}, {id:"federal:BR:L:3796/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-08-02", numero:"3796", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-08-02;3796", vigente:true, titulo:"Lei nº 3.796 de 02/08/1960", urn:"urn:lex:br:federal:lei:1960-08-02;3796", ementa:"Isenta de direitos aduaneiros, imposto de consumo e taxas alfandegárias,   os equipamentos telefônicos importados pela Telefônica Jundiaí S.   A.", arquivo:"federal/leis-ordinarias/1960/lei-3796-1960-08-02.md"}}, {id:"federal:BR:L:3848/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-12-18", numero:"3848", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-12-18;3848", vigente:true, titulo:"Lei nº 3.848 de 18/12/1960", urn:"urn:lex:br:federal:lei:1960-12-18;3848", ementa:"Cria a Universidade do Estado do Rio de Janeiro, e dá outras providências.", arquivo:"federal/leis-ordinarias/1960/lei-3848-1960-12-18.md"}}, {id:"federal:BR:L:3753/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-04-14", numero:"3753", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-04-14;3753", vigente:true, titulo:"Lei nº 3.753 de 14/04/1960", urn:"urn:lex:br:federal:lei:1960-04-14;3753", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras Públicas, o crédito especial de Cr$ 7.000.000.000,00, destinado à pavimentação da rodovia Rio-Bahia.", arquivo:"federal/leis-ordinarias/1960/lei-3753-1960-04-14.md"}}, {id:"federal:BR:L:3733/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-03-08", numero:"3733", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-03-08;3733", vigente:true, titulo:"Lei nº 3.733 de 08/03/1960", urn:"urn:lex:br:federal:lei:1960-03-08;3733", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 25.000.000,00, destinado à regularização de despesas da Superintendência das Empresas Incorporadas ao Patrimônio Nacional.", arquivo:"federal/leis-ordinarias/1960/lei-3733-1960-03-08.md"}}, {id:"federal:BR:L:3760/1960", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-04-25", numero:"3760", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-04-25;3760", vigente:true, titulo:"Lei nº 3.760 de 25/04/1960", urn:"urn:lex:br:federal:lei:1960-04-25;3760", ementa:"Concede a pensão especial de Cr$ 40.000,00 à viúva e filhos do Senador Lameira Bittencourt.", arquivo:"federal/leis-ordinarias/1960/lei-3760-1960-04-25.md"}}, {id:"federal:BR:L:3861/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-12-24", numero:"3861", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-12-24;3861", vigente:true, titulo:"Lei nº 3.861 de 24/12/1960", urn:"urn:lex:br:federal:lei:1960-12-24;3861", ementa:"Concede auxílio especial às Jornadas Médico-Cirúrgicas, de   Uruguaiana.", arquivo:"federal/leis-ordinarias/1960/lei-3861-1960-12-24.md"}}, {id:"federal:BR:L:3814/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-11-09", numero:"3814", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-11-09;3814", vigente:true, titulo:"Lei nº 3.814 de 09/11/1960", urn:"urn:lex:br:federal:lei:1960-11-09;3814", ementa:"Retifica, sem ônus, a Lei nº 3682, de 7 de dezembro de 1959, que estima a   Receita e fixa a Despesa da União para o exercício de 1960.", arquivo:"federal/leis-ordinarias/1960/lei-3814-1960-11-09.md"}}, {id:"federal:BR:L:3756/1960", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-04-20", numero:"3756", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-04-20;3756", vigente:true, titulo:"Lei nº 3.756 de 20/04/1960", urn:"urn:lex:br:federal:lei:1960-04-20;3756", ementa:"Cria uma Recebedoria de Rendas em Belo Horizonte e dá outras providências.", arquivo:"federal/leis-ordinarias/1960/lei-3756-1960-04-20.md"}}, {id:"federal:BR:L:3827/1960", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-11-23", numero:"3827", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-11-23;3827", vigente:true, titulo:"Lei nº 3.827 de 23/11/1960", urn:"urn:lex:br:federal:lei:1960-11-23;3827", ementa:"Concede a pensão especial de Cr$ 20.000,00 mensais ao jornalista Rolando Pedreira.", arquivo:"federal/leis-ordinarias/1960/lei-3827-1960-11-23.md"}}, {id:"federal:BR:L:3780/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-07-12", numero:"3780", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-07-12;3780-a", vigente:true, titulo:"Lei nº 3.780-A de 12/07/1960", urn:"urn:lex:br:federal:lei:1960-07-12;3780-a", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o crédito especial de Cr$ 150.000.000,00, destinado ao combate ao cancro cítrico nos Estados de São Paulo, Paraná, Mato Grosso e Goiás.", arquivo:"federal/leis-ordinarias/1960/lei-3780-a-1960-07-12.md"}}, {id:"federal:BR:L:3806/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-08-02", numero:"3806", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-08-02;3806", vigente:true, titulo:"Lei nº 3.806 de 02/08/1960", urn:"urn:lex:br:federal:lei:1960-08-02;3806", ementa:"Concede isenção dos impostos de consumo e de importação e de taxas aduaneiras para sinos e acessórios destinados às igrejas do Mosteiro de São Bento de Olinda e N.S. dos Prazeres de Monte Guararapes.", arquivo:"federal/leis-ordinarias/1960/lei-3806-1960-08-02.md"}}, {id:"federal:BR:L:3748/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-04-10", numero:"3748", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-04-10;3748", vigente:true, titulo:"Lei nº 3.748 de 10/04/1960", urn:"urn:lex:br:federal:lei:1960-04-10;3748", ementa:"Concede pensão mensal de Cr$ 3.000,00 a Vinda Joana Nery, viúva do ex-servidor público Adalto Domingos Nery.", arquivo:"federal/leis-ordinarias/1960/lei-3748-1960-04-10.md"}}, {id:"federal:BR:L:3735/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-03-15", numero:"3735", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-03-15;3735", vigente:true, titulo:"Lei nº 3.735 de 15/03/1960", urn:"urn:lex:br:federal:lei:1960-03-15;3735", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras Públicas, o crédito especial de Cr$ 2.000.000.000,00, para a conclusão das ligações rodoviárias de Brasília com os Estados da Bahia, Sergipe, Alagoas, Pernambuco, Paraíba, Ceará, Maranhão, Mato Grosso e Goiás.", arquivo:"federal/leis-ordinarias/1960/lei-3735-1960-03-15.md"}}, {id:"federal:BR:L:3831/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-11-28", numero:"3831", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-11-28;3831", vigente:true, titulo:"Lei nº 3.831 de 28/11/1960", urn:"urn:lex:br:federal:lei:1960-11-28;3831", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras Públicas, os créditos especiais de Cr$ 600.000.000,00 e Cr$ 100.000.000,00, para atender, respectivamente, às despesas com a execução de obras de saneamento e aproveitamento do Rio das Velhas, no Estado de Minas Gerais; e estudos, projetos e desapropriações para captação e aproveitamento das águas do Rio Mutuca, Estado de Mato Grosso.", arquivo:"federal/leis-ordinarias/1960/lei-3831-1960-11-28.md"}}, {id:"federal:BR:L:3843/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-12-15", numero:"3843", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-12-15;3843", vigente:true, titulo:"Lei nº 3.843 de 15/12/1960", urn:"urn:lex:br:federal:lei:1960-12-15;3843", ementa:"Concede autonomia à Escola Nacional de Minas e Metalurgia, a qual, desligada da Universidade do Brasil, passará a denominar-se Escola de Minas de Ouro Preto.", arquivo:"federal/leis-ordinarias/1960/lei-3843-1960-12-15.md"}}, {id:"federal:BR:L:3830/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-11-25", numero:"3830", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-11-25;3830-a", vigente:true, titulo:"Lei nº 3.830-A de 25/11/1960", urn:"urn:lex:br:federal:lei:1960-11-25;3830-a", ementa:"Abre ao Poder Legislativo - Senado Federal e Câmara dos Deputados - os créditos suplementares de Cr$ 75.550.000,00 (setenta e cinco milhões, quinhentos e cinquenta mil cruzeiros) e de Cr$ 293.600.000,00 (Duzentos e noventa e três milhões e seiscentos mil cruzeiros) à Lei n. 3682, de 7 de dezembro de 1959, que estima a receita e fixa a despesa da União para o exercício de 1960.", arquivo:"federal/leis-ordinarias/1960/lei-3830-a-1960-11-25.md"}}, {id:"federal:BR:L:3811/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-09-10", numero:"3811", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-09-10;3811", vigente:true, titulo:"Lei nº 3.811 de 10/09/1960", urn:"urn:lex:br:federal:lei:1960-09-10;3811", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o crédito especial de Cr$ 30.000.000,00 para ocorrer às despesas de instalação e funcionamento da Comissão de Desenvolvimento do Planalto de Ibiapaba.", arquivo:"federal/leis-ordinarias/1960/lei-3811-1960-09-10.md"}}, {id:"federal:BR:L:3779/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-06-25", numero:"3779", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-06-25;3779", vigente:true, titulo:"Lei nº 3.779 de 25/06/1960", urn:"urn:lex:br:federal:lei:1960-06-25;3779", ementa:"Concede o domínio útil de um terreno de marinha e outro acrescido de marinha à Prefeitura Municipal de Florianópolis, Estado de Santa Catarina.", arquivo:"federal/leis-ordinarias/1960/lei-3779-1960-06-25.md"}}, {id:"federal:BR:L:3741/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-04-04", numero:"3741", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-04-04;3741", vigente:true, titulo:"Lei nº 3.741 de 04/04/1960", urn:"urn:lex:br:federal:lei:1960-04-04;3741", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura, o crédito especial de Cr$ 5.000.000,00, para auxiliar as despesas com as comemorações do centenário de Itajaí, em Santa Catarina.", arquivo:"federal/leis-ordinarias/1960/lei-3741-1960-04-04.md"}}, {id:"federal:BR:L:3823/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-11-23", numero:"3823", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-11-23;3823", vigente:true, titulo:"Lei nº 3.823 de 23/11/1960", urn:"urn:lex:br:federal:lei:1960-11-23;3823", ementa:"Autoriza o Poder Executivo a abrir o crédito especial de Cr$ 8.000.000,00, para atender a despesas com obras e instalações do Entreposto de Pesca de Aracaju, Sergipe.", arquivo:"federal/leis-ordinarias/1960/lei-3823-1960-11-23.md"}}, {id:"federal:BR:L:3802/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-08-02", numero:"3802", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-08-02;3802", vigente:true, titulo:"Lei nº 3.802 de 02/08/1960", urn:"urn:lex:br:federal:lei:1960-08-02;3802", ementa:"Denomina \"Dom Pedro II\" a nova ponte que liga os Estados da Banhia e Alagoas.", arquivo:"federal/leis-ordinarias/1960/lei-3802-1960-08-02.md"}}, {id:"federal:BR:L:3834/1960", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-12-14", numero:"3834", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-12-14;3834-c", vigente:true, titulo:"Lei nº 3.834-C de 14/12/1960", urn:"urn:lex:br:federal:lei:1960-12-14;3834-c", ementa:"Cria a Universidade Federal de Goiás, e dá outras providências.", arquivo:"federal/leis-ordinarias/1960/lei-3834-c-1960-12-14.md"}}, {id:"federal:BR:L:3764/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-04-25", numero:"3764", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-04-25;3764", vigente:true, titulo:"Lei nº 3.764 de 25/04/1960", urn:"urn:lex:br:federal:lei:1960-04-25;3764", ementa:"Estabelece rito sumaríssimo para retificação no registro civil.", arquivo:"federal/leis-ordinarias/1960/lei-3764-1960-04-25.md"}}, {id:"federal:BR:L:3792/1960", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-08-02", numero:"3792", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-08-02;3792", vigente:true, titulo:"Lei nº 3.792 de 02/08/1960", urn:"urn:lex:br:federal:lei:1960-08-02;3792", ementa:"Concede a pensão especial de Cr$ 20.000,00 mensais à viúva e filhos menores do ex-Deputado Federal Coaraci Gentil Monteiro Nunes.", arquivo:"federal/leis-ordinarias/1960/lei-3792-1960-08-02.md"}}, {id:"federal:BR:L:3818/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-11-09", numero:"3818", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-11-09;3818", vigente:true, titulo:"Lei nº 3.818 de 09/11/1960", urn:"urn:lex:br:federal:lei:1960-11-09;3818", ementa:"Autoriza o Poder Executivo a abrir, ao Poder Judiciário - Justiça Eleitoral - o crédito especial de Cr$ 213.300,00, para atender a despesas correspondentes aos exercícios de 1956 a 1958.", arquivo:"federal/leis-ordinarias/1960/lei-3818-1960-11-09.md"}}, {id:"federal:BR:L:3865/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-12-24", numero:"3865", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-12-24;3865", vigente:true, titulo:"Lei nº 3.865 de 24/12/1960", urn:"urn:lex:br:federal:lei:1960-12-24;3865", ementa:"Torna extensivos aos funcionários dos Territórios Federais dispositivos do Estatuto dos Funcionários Públicos Civis da União (Lei n. 1711, de 28 de outubro de 1952) e dá outras providências.", arquivo:"federal/leis-ordinarias/1960/lei-3865-1960-12-24.md"}}, {id:"federal:BR:L:3774/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-06-13", numero:"3774", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-06-13;3774", vigente:true, titulo:"Lei nº 3.774 de 13/06/1960", urn:"urn:lex:br:federal:lei:1960-06-13;3774", ementa:"Autoriza a abertura de crédito especial de Cr$ 10.307.808,00 para pagamento de diferença de gratificação adicional por tempo de serviço a que têm direito os funcionários do Tribunal de Contas.", arquivo:"federal/leis-ordinarias/1960/lei-3774-1960-06-13.md"}}, {id:"federal:BR:L:3771/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-06-07", numero:"3771", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-06-07;3771", vigente:true, titulo:"Lei nº 3.771 de 07/06/1960", urn:"urn:lex:br:federal:lei:1960-06-07;3771", ementa:"Autoriza o Poder Executivo a abrir pelo Ministério da Saúde, o crédito especial de Cr$ 20.000.000,00 (vinte milhões de cruzeiros), como auxílio à Associação de Assistência à Criança Defeituosa, a dá outras providências.", arquivo:"federal/leis-ordinarias/1960/lei-3771-1960-06-07.md"}}, {id:"federal:BR:L:3829/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-11-25", numero:"3829", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-11-25;3829", vigente:true, titulo:"Lei nº 3.829 de 25/11/1960", urn:"urn:lex:br:federal:lei:1960-11-25;3829", ementa:"Autoriza o Poder Executivo abrir, ao Tribunal de Contas, o crédito especial de Cr$ 130.000.000,00 para ocorrer às despesas com a transferência daquele Tribunal para Brasília.", arquivo:"federal/leis-ordinarias/1960/lei-3829-1960-11-25.md"}}, {id:"federal:BR:L:3783/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-07-30", numero:"3783", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-07-30;3783", vigente:true, titulo:"Lei nº 3.783 de 30/07/1960", urn:"urn:lex:br:federal:lei:1960-07-30;3783", ementa:"Dispôe sobre vencimentos dos militares e dá outras providências.", arquivo:"federal/leis-ordinarias/1960/lei-3783-1960-07-30.md"}}, {id:"federal:BR:L:3853/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-12-18", numero:"3853", fonte:"https://normas.leg.br/?ur