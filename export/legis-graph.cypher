UNWIND [{id:"federal:BR:L:4910/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-17", numero:"4910", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-17;4910", vigente:true, titulo:"Lei nº 4.910 de 17/12/1965", urn:"urn:lex:br:federal:lei:1965-12-17;4910", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações   Exteriores, o crédito especial de Cr$ 10.000.000,00 (dez milhões de cruzeiros),   para atender às despesas decorrentes da viagem do Senhor Presidente da República   ao Chile.", arquivo:"federal/leis-ordinarias/1965/lei-4910-1965-12-17.md"}}, {id:"federal:BR:L:4608/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-03-31", numero:"4608", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-03-31;4608", vigente:true, titulo:"Lei nº 4.608 de 31/03/1965", urn:"urn:lex:br:federal:lei:1965-03-31;4608", ementa:"Fixa novos valôres para os símbolos dos cargos e das funções gratificadas do Quadro de Pessoal da Secretaria do Tribunal Regional do Trabalho da 3ª Região, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4608-1965-03-31.md"}}, {id:"federal:BR:L:4624/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-13", numero:"4624", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-13;4624", vigente:true, titulo:"Lei nº 4.624 de 13/05/1965", urn:"urn:lex:br:federal:lei:1965-05-13;4624", ementa:"Permite a consignação em fôlha de pagamento de mensalidades e descontos em favor da Caixa Beneficente dos Empregados da Alfândega do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1965/lei-4624-1965-05-13.md"}}, {id:"federal:BR:L:4783/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-09-28", numero:"4783", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-09-28;4783", vigente:true, titulo:"Lei nº 4.783 de 28/09/1965", urn:"urn:lex:br:federal:lei:1965-09-28;4783", ementa:"Autoriza a abertura ao Ministério da Justiça e Negócios Interiores de   crédito especial para o custeio dos vencimentos e vantagens dos servidores da   Fundação Brasil Central.", arquivo:"federal/leis-ordinarias/1965/lei-4783-1965-09-28.md"}}, {id:"federal:BR:L:4814/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-25", numero:"4814", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-25;4814", vigente:true, titulo:"Lei nº 4.814 de 25/10/1965", urn:"urn:lex:br:federal:lei:1965-10-25;4814", ementa:"Altera, sem aumento de despesa, o Orçamento Geral da União para 1965.", arquivo:"federal/leis-ordinarias/1965/lei-4814-1965-10-25.md"}}, {id:"federal:BR:L:4889/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-09", numero:"4889", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-09;4889", vigente:true, titulo:"Lei nº 4.889 de 09/12/1965", urn:"urn:lex:br:federal:lei:1965-12-09;4889", ementa:"Fixa novos valores para os símbolos dos cargos e função gratificada do Quadro de Pessoal do Tribunal Regional do Trabalho da 7º Região.", arquivo:"federal/leis-ordinarias/1965/lei-4889-1965-12-09.md"}}, {id:"federal:BR:L:4902/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-16", numero:"4902", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-16;4902", vigente:true, titulo:"Lei nº 4.902 de 16/12/1965", urn:"urn:lex:br:federal:lei:1965-12-16;4902", ementa:"Dispõe sôbre a inatividade dos militares da Marinha, da Aeronáutica e do Exército.", arquivo:"federal/leis-ordinarias/1965/lei-4902-1965-12-16.md"}}, {id:"federal:BR:L:4642/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-31", numero:"4642", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-31;4642", vigente:true, titulo:"Lei nº 4.642 de 31/05/1965", urn:"urn:lex:br:federal:lei:1965-05-31;4642", ementa:"Concede isenção dos impostos de importação e de consumo, bem como da taxa de despacho aduaneiro, para os maquinismos e materiais importados pela \"CEMAT\" - Centrais Elétricas Matogrossense S.A\"., e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4642-1965-05-31.md"}}, {id:"federal:BR:L:4871/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-02", numero:"4871", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-02;4871", vigente:true, titulo:"Lei nº 4.871 de 02/12/1965", urn:"urn:lex:br:federal:lei:1965-12-02;4871", ementa:"Autoriza a abertura, pelo Ministério da Agricultura, do crédito especial de Cr$ 74.344.128,10 (setenta e quatro milhões trezentos e quarenta e quatro mil cento e vinte e oito cruzeiros e dez centavos) para o fim que especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4871-1965-12-02.md"}}, {id:"federal:BR:L:4837/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-10", numero:"4837", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-10;4837", vigente:true, titulo:"Lei nº 4.837 de 10/11/1965", urn:"urn:lex:br:federal:lei:1965-11-10;4837", ementa:"Autoriza o Poder Executivo a abrir, através do Ministério da Marinha, o   crédito especial de Cr$ 300.000.000 (trezentos milhões de cruzeiros), destinado   à construção, organização e instalação do Centro de Instrução de Marítimos   \"Almirante Graça Aranha\".", arquivo:"federal/leis-ordinarias/1965/lei-4837-1965-11-10.md"}}, {id:"federal:BR:L:4792/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-20", numero:"4792", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-20;4792", vigente:true, titulo:"Lei nº 4.792 de 20/10/1965", urn:"urn:lex:br:federal:lei:1965-10-20;4792", ementa:"Autoriza a abertura do crédito especial de Cr$ 200.000.000   (duzentos milhões de cruzeiros) à Superintendência do Plano de Valorização Econômica da   Amazônia, para atender a despesas que especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4792-1965-10-20.md"}}, {id:"federal:BR:L:4824/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-05", numero:"4824", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-05;4824", vigente:true, titulo:"Lei nº 4.824 de 05/11/1965", urn:"urn:lex:br:federal:lei:1965-11-05;4824", ementa:"Altera o § 1º do art. 475, da Consolidação das Leis do   Trabalho.", arquivo:"federal/leis-ordinarias/1965/lei-4824-1965-11-05.md"}}, {id:"federal:BR:L:4661/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-02", numero:"4661", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-02;4661", vigente:true, titulo:"Lei nº 4.661 de 02/06/1965", urn:"urn:lex:br:federal:lei:1965-06-02;4661", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 877.852.800 (oitocentos e setenta e sete milhões,   oitocentos e cinqüenta e dois mil e oitocentos cruzeiros), para atender às   despesas relativas ao enquadramento do pessoal da Universidade da   Bahia.", arquivo:"federal/leis-ordinarias/1965/lei-4661-1965-06-02.md"}}, {id:"federal:BR:L:4651/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-31", numero:"4651", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-31;4651", vigente:true, titulo:"Lei nº 4.651 de 31/05/1965", urn:"urn:lex:br:federal:lei:1965-05-31;4651", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras   Públicas, o crédito especial de Cr$ 2.300.000.000,00 (dois bilhões e trezentos   milhões de cruzeiros), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4651-1965-05-31.md"}}, {id:"federal:BR:L:4922/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-23", numero:"4922", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-23;4922", vigente:true, titulo:"Lei nº 4.922 de 23/12/1965", urn:"urn:lex:br:federal:lei:1965-12-23;4922", ementa:"Retifica, sem ônus para a União, a Lei nº 4.539, de 10 de dezembro de 1964, que estima a receita e fixa a despesa da União para o exercício de 1965.", arquivo:"federal/leis-ordinarias/1965/lei-4922-1965-12-23.md"}}, {id:"federal:BR:L:4849/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-19", numero:"4849", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-19;4849", vigente:true, titulo:"Lei nº 4.849 de 19/11/1965", urn:"urn:lex:br:federal:lei:1965-11-19;4849", ementa:"Autoriza o Poder Executivo ;a abrir, a diversos Órgãos e Ministérios, créditos especiais num montante de Cr$ 15.665.913.118 e suplementares num montante de Cr$ 27.312.000 destinados à regularização de despesas consignadas em orçamentos anteriores.", arquivo:"federal/leis-ordinarias/1965/lei-4849-1965-11-19.md"}}, {id:"federal:BR:L:4806/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-20", numero:"4806", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-20;4806", vigente:true, titulo:"Lei nº 4.806 de 20/10/1965", urn:"urn:lex:br:federal:lei:1965-10-20;4806", ementa:"Extingue a Divisão de Cooperativismo e Organização Rural do Departamento   de Promoção Agropecuária do Ministério da Agricultura, transfere atribuições, e   dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4806-1965-10-20.md"}}, {id:"federal:BR:L:4774/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-09-15", numero:"4774", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-09-15;4774", vigente:true, titulo:"Lei nº 4.774 de 15/09/1965", urn:"urn:lex:br:federal:lei:1965-09-15;4774", ementa:"Concede pensão especial a Paulo Soares, ex-servidor do Ministério da Guerra.", arquivo:"federal/leis-ordinarias/1965/lei-4774-1965-09-15.md"}}, {id:"federal:BR:L:4667/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-08", numero:"4667", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-08;4667", vigente:true, titulo:"Lei nº 4.667 de 08/06/1965", urn:"urn:lex:br:federal:lei:1965-06-08;4667", ementa:"Autoriza a abertura, pelo Ministério da Indústria e   do Comércio, do crédito especial de Cr$ 1.000.000.000, ; destinado à   recuperação do edifício da Praça Mauá, nº 7, na Cidade do Rio de Janeiro, Estado   da Guanabara.", arquivo:"federal/leis-ordinarias/1965/lei-4667-1965-06-08.md"}}, {id:"federal:BR:L:4614/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-04-02", numero:"4614", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-04-02;4614", vigente:true, titulo:"Lei nº 4.614 de 02/04/1965", urn:"urn:lex:br:federal:lei:1965-04-02;4614", ementa:"Denomina \"Rodovia Lauro Müller\" a atual BR-59, que liga o Estado do Paraná   ao Estado do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1965/lei-4614-1965-04-02.md"}}, {id:"federal:BR:L:4810/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-25", numero:"4810", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-25;4810", vigente:true, titulo:"Lei nº 4.810 de 25/10/1965", urn:"urn:lex:br:federal:lei:1965-10-25;4810", ementa:"Transfere cargo do Quadro I - Parte Permanente - do Ministério da Viação e   Obras Públicas para o Quadro do Pessoal do Ministério da Fazenda.", arquivo:"federal/leis-ordinarias/1965/lei-4810-1965-10-25.md"}}, {id:"federal:BR:L:4885/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-09", numero:"4885", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-09;4885", vigente:true, titulo:"Lei nº 4.885 de 09/12/1965", urn:"urn:lex:br:federal:lei:1965-12-09;4885", ementa:"Autoriza o Poder Executivo a abrir, ao Senado Federal, o crédito suplementar de Cr$ 2.415.240.000 (dois bilhões, quatrocentos e quinze milhões, duzentos e quarenta mil cruzeiros), em refôrço a dotações que especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4885-1965-12-09.md"}}, {id:"federal:BR:L:4754/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-08-18", numero:"4754", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-08-18;4754", vigente:true, titulo:"Lei nº 4.754 de 18/08/1965", urn:"urn:lex:br:federal:lei:1965-08-18;4754", ementa:"Retifica vários dispositivos da Lei número 4.375, de 17 de agôsto de 1964 (Lei do Serviço Militar).", arquivo:"federal/leis-ordinarias/1965/lei-4754-1965-08-18.md"}}, {id:"federal:BR:L:4605/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-03-30", numero:"4605", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-03-30;4605", vigente:true, titulo:"Lei nº 4.605 de 30/03/1965", urn:"urn:lex:br:federal:lei:1965-03-30;4605", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Marinha, o crédito especial de Cr$ 400.000.000 (quatrocentos milhões de cruzeiros), para a construção do Quartel de Fuzileiros Navais de Brasília.", arquivo:"federal/leis-ordinarias/1965/lei-4605-1965-03-30.md"}}, {id:"federal:BR:L:4776/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-09-22", numero:"4776", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-09-22;4776", vigente:true, titulo:"Lei nº 4.776 de 22/09/1965", urn:"urn:lex:br:federal:lei:1965-09-22;4776", ementa:"Abre, pelo Ministério da Saúde, o crédito especial de Cr$ 2.500.000.000   (dois bilhões e quinhentos milhões de cruzeiros), destinado ao combate à   malária.", arquivo:"federal/leis-ordinarias/1965/lei-4776-1965-09-22.md"}}, {id:"federal:BR:L:4768/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-09-03", numero:"4768", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-09-03;4768", vigente:true, titulo:"Lei nº 4.768 de 03/09/1965", urn:"urn:lex:br:federal:lei:1965-09-03;4768", ementa:"Isenta de todos os impostos e taxas federais a Fundação Bienal de São   Paulo.", arquivo:"federal/leis-ordinarias/1965/lei-4768-1965-09-03.md"}}, {id:"federal:BR:L:4677/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-16", numero:"4677", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-16;4677", vigente:true, titulo:"Lei nº 4.677 de 16/06/1965", urn:"urn:lex:br:federal:lei:1965-06-16;4677", ementa:"Isenta de impostos de importação e outras contribuições fiscais os bens adquiridos, mediante doação, pelas instituições que se dedicam, sem finalidade lucrativa, à prestação de assistência médico-hospitalar.", arquivo:"federal/leis-ordinarias/1965/lei-4677-1965-06-16.md"}}, {id:"federal:BR:L:4894/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-09", numero:"4894", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-09;4894", vigente:true, titulo:"Lei nº 4.894 de 09/12/1965", urn:"urn:lex:br:federal:lei:1965-12-09;4894", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério do Trabalho e   Previdência Social, o crédito especial de Cr$ 57.482.525,00 (cinqüenta e sete   milhões, quatrocentos e oitenta e dois mil, quinhentos e vinte cinco cruzeiros),   para o fim que especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4894-1965-12-09.md"}}, {id:"federal:BR:L:4861/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-26", numero:"4861", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-26;4861", vigente:true, titulo:"Lei nº 4.861 de 26/11/1965", urn:"urn:lex:br:federal:lei:1965-11-26;4861", ementa:"Autoriza o Poder Executivo a abrir ao Tribunal de Contas o crédito suplementar de Cr$ 2.166.530.000 (dois bilhões, cento e sessenta e seis milhões, quinhentos e trinta mil cruzeiros) para reforço de dotações que especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4861-1965-11-26.md"}}, {id:"federal:BR:L:4850/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-19", numero:"4850", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-19;4850", vigente:true, titulo:"Lei nº 4.850 de 19/11/1965", urn:"urn:lex:br:federal:lei:1965-11-19;4850", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações   Exteriores, o crédito especial de Cr$ 10.000.000 (dez milhões de cruzeiros),   para atender a despesas de qualquer natureza com a realização da Conferência   Conjunta da FAO e da CEPAL.", arquivo:"federal/leis-ordinarias/1965/lei-4850-1965-11-19.md"}}, {id:"federal:BR:L:4866/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-30", numero:"4866", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-30;4866", vigente:true, titulo:"Lei nº 4.866 de 30/11/1965", urn:"urn:lex:br:federal:lei:1965-11-30;4866", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações Exteriores, o crédito especial de Cr$ 120.000.000 (cento e vinte milhões de cruzeiros), para atender às despesas decorrentes da visita ao Brasil do Presidente da República Italiana e da sua comitiva.", arquivo:"federal/leis-ordinarias/1965/lei-4866-1965-11-30.md"}}, {id:"federal:BR:L:4741/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-15", numero:"4741", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-15;4741", vigente:true, titulo:"Lei nº 4.741 de 15/07/1965", urn:"urn:lex:br:federal:lei:1965-07-15;4741", ementa:"Fixa novos valôres dos símbolos do Quadro do Pessoal da Secretaria do Tribunal Regional do Trabalho da 1ª região, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4741-1965-07-15.md"}}, {id:"federal:BR:L:4682/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-21", numero:"4682", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-21;4682", vigente:true, titulo:"Lei nº 4.682 de 21/06/1965", urn:"urn:lex:br:federal:lei:1965-06-21;4682", ementa:"Isenta da taxa de despacho aduaneiro um conjunto eletrônico importado pelo Govêrno do Estado do Paraná.", arquivo:"federal/leis-ordinarias/1965/lei-4682-1965-06-21.md"}}, {id:"federal:BR:L:4914/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-17", numero:"4914", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-17;4914", vigente:true, titulo:"Lei nº 4.914 de 17/12/1965", urn:"urn:lex:br:federal:lei:1965-12-17;4914", ementa:"Autoriza o Poder Executivo a abrir o crédito especial de Cr$ 512.729,00 (quinhentos e doze mil setecentos e vinte e nove cruzeiros) ao Tribunal Regional Eleitoral da Bahia, para atender a despesas dos exercícios de 1958 a 1962.", arquivo:"federal/leis-ordinarias/1965/lei-4914-1965-12-17.md"}}, {id:"federal:BR:L:4632/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-18", numero:"4632", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-18;4632", vigente:true, titulo:"Lei nº 4.632 de 18/05/1965", urn:"urn:lex:br:federal:lei:1965-05-18;4632", ementa:"Altera o art. 64 do Código de Processo Civil (Decreto-lei nº 1.608, de 18 de setembro de 1939).", arquivo:"federal/leis-ordinarias/1965/lei-4632-1965-05-18.md"}}, {id:"federal:BR:L:4725/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-13", numero:"4725", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-13;4725", vigente:true, titulo:"Lei nº 4.725 de 13/07/1965", urn:"urn:lex:br:federal:lei:1965-07-13;4725", ementa:"Estabelece normas para o processo dos dissídios coletivos, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4725-1965-07-13.md"}}, {id:"federal:BR:L:4733/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-07-14", numero:"4733", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-07-14;4733", vigente:true, titulo:"Lei nº 4.733 de 14/07/1965", urn:"urn:lex:br:federal:lei:1965-07-14;4733", ementa:"Isenta do imposto do selo os contratos assinados pela Companhia   Pernambucana de Borracha Sintética - COPERBO sociedade de economia mista   localizada no Município do Cabo, Estado de Pernambuco.", arquivo:"federal/leis-ordinarias/1965/lei-4733-1965-07-14.md"}}, {id:"federal:BR:L:4842/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-18", numero:"4842", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-18;4842", vigente:true, titulo:"Lei nº 4.842 de 18/11/1965", urn:"urn:lex:br:federal:lei:1965-11-18;4842", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações   Exteriores, o crédito especial de Cr$ 15.000.000 para atender às despesas   decorrentes da visita ao Brasil de Governadores Estaduais   norte-americanos.", arquivo:"federal/leis-ordinarias/1965/lei-4842-1965-11-18.md"}}, {id:"federal:BR:L:4656/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-02", numero:"4656", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-02;4656", vigente:true, titulo:"Lei nº 4.656 de 02/06/1965", urn:"urn:lex:br:federal:lei:1965-06-02;4656", ementa:"Concede pensão especial aos beneficiários dos Congressistas que tiveram seus mandatos cassados, dos servidores públicos e autárquicos e dos empregados de sociedade de economia mista, demitidos em decorrência do Ato Institucional, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4656-1965-06-02.md"}}, {id:"federal:BR:L:4628/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-13", numero:"4628", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-13;4628", vigente:true, titulo:"Lei nº 4.628 de 13/05/1965", urn:"urn:lex:br:federal:lei:1965-05-13;4628", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações Exteriores, o crédito especial de Cr$ 25.874.000(vinte e cinco milhões, oitocentos e setenta e quatro mil cruzeiros) para atender às despesas decorrentes da revisão e remodelação das instalações elétricas do Palácio Itamaraty.", arquivo:"federal/leis-ordinarias/1965/lei-4628-1965-05-13.md"}}, {id:"federal:BR:L:4853/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-25", numero:"4853", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-25;4853", vigente:true, titulo:"Lei nº 4.853 de 25/11/1965", urn:"urn:lex:br:federal:lei:1965-11-25;4853", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério da Guerra o crédito especial de Cr$ 300.000.000 para atender às despesas da transferência do Regimento de Cavalaria de Guardas - Dragões da Independência - para Brasília.", arquivo:"federal/leis-ordinarias/1965/lei-4853-1965-11-25.md"}}, {id:"federal:BR:L:4641/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-27", numero:"4641", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-27;4641", vigente:true, titulo:"Lei nº 4.641 de 27/05/1965", urn:"urn:lex:br:federal:lei:1965-05-27;4641", ementa:"Dispõe sobre os cursos de teatro e regulamenta as categorias profissionais correspondentes.", arquivo:"federal/leis-ordinarias/1965/lei-4641-1965-05-27.md"}}, {id:"federal:BR:L:4646/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-05-31", numero:"4646", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-05-31;4646", vigente:true, titulo:"Lei nº 4.646 de 31/05/1965", urn:"urn:lex:br:federal:lei:1965-05-31;4646", ementa:"Autoriza o Poder Executivo a abrir ao Ministério da Justiça e Negócios   Interiores o crédito especial de Cr$ 280.000.000,00 (duzentos e oitenta milhões   de cruzeiros), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1965/lei-4646-1965-05-31.md"}}, {id:"federal:BR:L:4702/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-28", numero:"4702", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-28;4702", vigente:true, titulo:"Lei nº 4.702 de 28/06/1965", urn:"urn:lex:br:federal:lei:1965-06-28;4702", ementa:"Autoriza a abertura de créditos especiais, no montante de Cr$ 47.033.454.687,40 (quarenta e sete bilhões, trinta e três milhões, quatrocentos e cinqüenta e quatro mil, seiscentos e oitenta e sete cruzeiros e quarenta centavos), a orgãos subordinados à Presidência da República e a diversos Ministérios.", arquivo:"federal/leis-ordinarias/1965/lei-4702-1965-06-28.md"}}, {id:"federal:BR:L:4875/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-02", numero:"4875", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-02;4875", vigente:true, titulo:"Lei nº 4.875 de 02/12/1965", urn:"urn:lex:br:federal:lei:1965-12-02;4875", ementa:"Autoriza o Poder Executivo a abrir ao Ministério da Fazenda, o crédito   especial de Cr$ 80.000.000 (oitenta milhões de cruzeiros), destinado a atender   às despesas de viagem e estada no exterior de representantes do aludido   Ministério à reunião do GATT que realizou em Genebra.", arquivo:"federal/leis-ordinarias/1965/lei-4875-1965-12-02.md"}}, {id:"federal:BR:L:4691/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-06-21", numero:"4691", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-06-21;4691", vigente:true, titulo:"Lei nº 4.691 de 21/06/1965", urn:"urn:lex:br:federal:lei:1965-06-21;4691", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações   Exteriores, o crédito especial de Cr$ 80.000.000,00 (oitenta milhões de   cruzeiros), para atender às despesas decorrentes da visita ao Brasil do Xainxá do   Irã.", arquivo:"federal/leis-ordinarias/1965/lei-4691-1965-06-21.md"}}, {id:"federal:BR:L:4809/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-25", numero:"4809", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-25;4809", vigente:true, titulo:"Lei nº 4.809 de 25/10/1965", urn:"urn:lex:br:federal:lei:1965-10-25;4809", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações   Exteriores, o crédito especial de Cr$ 191.364.240,00 (cento e noventa e um   milhões, trezentos e sessenta e quatro mil, duzentos e quarenta cruzeiros), para   atender às despesas com o comparecimento do Episcopado brasileiro à Quarta   Sessão do Concílio Ecumêncio Vaticano II.", arquivo:"federal/leis-ordinarias/1965/lei-4809-1965-10-25.md"}}, {id:"federal:BR:L:4905/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-17", numero:"4905", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-17;4905", vigente:true, titulo:"Lei nº 4.905 de 17/12/1965", urn:"urn:lex:br:federal:lei:1965-12-17;4905", ementa:"Inclui na Receita do Fundo Naval as indenizações a verbas orçamentárias de   exercícios financeiros já encerrados.", arquivo:"federal/leis-ordinarias/1965/lei-4905-1965-12-17.md"}}, {id:"federal:BR:L:4796/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-20", numero:"4796", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-20;4796", vigente:true, titulo:"Lei nº 4.796 de 20/10/1965", urn:"urn:lex:br:federal:lei:1965-10-20;4796", ementa:"Altera, sem ônus, a Lei nº 4.539, de 10 de dezembro de 1964 que estima a   Receita e fixa a Despesa da União para o exercício financeiro de   1965.", arquivo:"federal/leis-ordinarias/1965/lei-4796-1965-10-20.md"}}, {id:"federal:BR:L:4828/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-05", numero:"4828", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-05;4828", vigente:true, titulo:"Lei nº 4.828 de 05/11/1965", urn:"urn:lex:br:federal:lei:1965-11-05;4828", ementa:"Modifica, sem aumento de despesas, distribuição de dotações consignadas na Lei nº 4.539, de 10 de dezembro de 1964, na parte que se refere ao subanexo do Conselho Nacional de Telecomunicações.", arquivo:"federal/leis-ordinarias/1965/lei-4828-1965-11-05.md"}}, {id:"federal:BR:L:4618/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-04-15", numero:"4618", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-04-15;4618", vigente:true, titulo:"Lei nº 4.618 de 15/04/1965", urn:"urn:lex:br:federal:lei:1965-04-15;4618", ementa:"Incorpora os Cursos da Campanha de Formação de Geólogos a Universidades Federais e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4618-1965-04-15.md"}}, {id:"federal:BR:L:4926/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-12-23", numero:"4926", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-23;4926", vigente:true, titulo:"Lei nº 4.926 de 23/12/1965", urn:"urn:lex:br:federal:lei:1965-12-23;4926", ementa:"Isenta dos impostos de importação e de consumo equipamento para produção   de formol a ser importado por \"Resinas Sintéticas e Plásticas S.A.\" - Resimpla -   com sede em Pôrto Alegre e fábrica em Gravataí, Estado do Rio Grande do   Sul.", arquivo:"federal/leis-ordinarias/1965/lei-4926-1965-12-23.md"}}, {id:"federal:BR:L:3230/1884", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1884, data:"1884-09-03", numero:"3230", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1884-09-03;3230", vigente:true, titulo:"Lei nº 3.230 de 03/09/1884", urn:"urn:lex:br:federal:lei:1884-09-03;3230", ementa:"FIXA A DESPESA GERAL DO IMPERIO PARA O EXERCICIO DE 1884-1885, E DA OUTRAS PROVIDENCIAS.", arquivo:"federal/leis-ordinarias/1884/lei-3230-1884-09-03.md"}}, {id:"federal:BR:L:3229/1884", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1884, data:"1884-09-03", numero:"3229", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1884-09-03;3229", vigente:true, titulo:"Lei nº 3.229 de 03/09/1884", urn:"urn:lex:br:federal:lei:1884-09-03;3229", ementa:"ORÇA A RECEITA GERAL DO IMPERIO PARA O EXERCICIO DE 1884-1885, E DA OUTRAS PROVIDENCIAS.", arquivo:"federal/leis-ordinarias/1884/lei-3229-1884-09-03.md"}}, {id:"federal:BR:L:3228/1884", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1884, data:"1884-09-03", numero:"3228", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1884-09-03;3228", vigente:true, titulo:"Lei nº 3.228 de 03/09/1884", urn:"urn:lex:br:federal:lei:1884-09-03;3228", ementa:"AUTORIZA O MINISTERIO DOS NEGOCIOS DO IMPERIO A DESPENDER ATE A QUANTIA DE 500:000$000 COM MEDIDAS PREVENTIVAS CONTRA A INVASÃO DO CHOLERA-MORBUS NO IMPERIO.", arquivo:"federal/leis-ordinarias/1884/lei-3228-1884-09-03.md"}}, {id:"federal:BR:L:3231/1884", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1884, data:"1884-09-03", numero:"3231", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1884-09-03;3231", vigente:true, titulo:"Lei nº 3.231 de 03/09/1884", urn:"urn:lex:br:federal:lei:1884-09-03;3231", ementa:"APROVA A DESPESA EFETUADAS COM ELEVAÇÃO NO NUMERO DE PRAÇAS DO BATALHÃO NAVAL AO ESTADO COMPLETO NO EXERCICIO DE 1883-1884.", arquivo:"federal/leis-ordinarias/1884/lei-3231-1884-09-03.md"}}, {id:"federal:BR:L:5742/1929", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1929, data:"1929-11-28", numero:"5742", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1929-11-28;5742", vigente:true, titulo:"Lei nº 5.742 de 28/11/1929", urn:"urn:lex:br:federal:lei:1929-11-28;5742", ementa:"Fixa as forças de terra para o exercicio de 1930", arquivo:"federal/leis-ordinarias/1929/lei-5742-1929-11-28.md"}}, {id:"federal:BR:L:5753/1929", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1929, data:"1929-12-27", numero:"5753", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1929-12-27;5753", vigente:true, titulo:"Lei nº 5.753 de 27/12/1929", urn:"urn:lex:br:federal:lei:1929-12-27;5753", ementa:"Fixa a despesa geral da Republica dos Estados Unidos do Brasil para o exercicio de 1930", arquivo:"federal/leis-ordinarias/1929/lei-5753-1929-12-27.md"}}, {id:"federal:BR:L:5750/1929", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1929, data:"1929-12-23", numero:"5750", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1929-12-23;5750", vigente:true, titulo:"Lei nº 5.750 de 23/12/1929", urn:"urn:lex:br:federal:lei:1929-12-23;5750", ementa:"Orça a Receita Geral dos Estados Unidos do Brasil para o exercicio de 1930.", arquivo:"federal/leis-ordinarias/1929/lei-5750-1929-12-23.md"}}, {id:"federal:BR:L:14288/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-31", numero:"14288", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-12-31;14288", vigente:true, titulo:"Lei nº 14.288 de 31/12/2021", urn:"urn:lex:br:federal:lei:2021-12-31;14288", ementa:"Altera a Lei nº 12.546, de 14 de dezembro de 2011, para prorrogar o prazo referente à contribuição previdenciária sobre a receita bruta, e a Lei nº 10.865, de 30 de abril de 2004, para prorrogar o prazo referente a acréscimo de alíquota da Contribuição Social para o Financiamento da Seguridade Social devida pelo Importador de Bens Estrangeiros ou Serviços do Exterior (Cofins-Importação), nos termos que especifica.", arquivo:"federal/leis-ordinarias/2021/lei-14288-2021-12-31.md"}}, {id:"federal:BR:L:14184/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-07-14", numero:"14184", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-07-14;14184", vigente:true, titulo:"Lei nº 14.184 de 14/07/2021", urn:"urn:lex:br:federal:lei:2021-07-14;14184", ementa:"Altera a Lei nº 11.508, de 20 de julho de 2007, para fins de modernização do marco legal das Zonas de Processamento de Exportação (ZPE).", arquivo:"federal/leis-ordinarias/2021/lei-14184-2021-07-14.md"}}, {id:"federal:BR:L:14269/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-23", numero:"14269", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-12-23;14269", vigente:true, titulo:"Lei nº 14.269 de 23/12/2021", urn:"urn:lex:br:federal:lei:2021-12-23;14269", ementa:"Abre ao Orçamento da Seguridade Social da União, em favor do Ministério da Saúde, crédito especial no valor de R$ 5.000.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2021/lei-14269-2021-12-23.md"}}, {id:"federal:BR:L:14155/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-05-27", numero:"14155", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-05-27;14155", vigente:true, titulo:"Lei nº 14.155 de 27/05/2021", urn:"urn:lex:br:federal:lei:2021-05-27;14155", ementa:"Altera o Decreto-Lei nº 2.848, de 7 de dezembro de 1940 (Código Penal), para tornar mais graves os crimes de violação de dispositivo informático, furto e estelionato cometidos de forma eletrônica ou pela internet; e o Decreto-Lei nº 3.689, de 3 de outubro de 1941 (Código de Processo Penal), para definir a competência em modalidades de estelionato.", arquivo:"federal/leis-ordinarias/2021/lei-14155-2021-05-27.md"}}, {id:"federal:BR:L:14282/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-28", numero:"14282", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-12-28;14282", vigente:true, titulo:"Lei nº 14.282 de 28/12/2021", urn:"urn:lex:br:federal:lei:2021-12-28;14282", ementa:"Regulamenta o exercício da profissão de despachante documentalista.", arquivo:"federal/leis-ordinarias/2021/lei-14282-2021-12-28.md"}}, {id:"federal:BR:L:14163/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-06-09", numero:"14163", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-06-09;14163", vigente:true, titulo:"Lei nº 14.163 de 09/06/2021", urn:"urn:lex:br:federal:lei:2021-06-09;14163", ementa:"Altera a Lei nº 13.475, de 28 de agosto de 2017, que dispõe sobre o exercício da profissão de tripulante de aeronave.", arquivo:"federal/leis-ordinarias/2021/lei-14163-2021-06-09.md"}}, {id:"federal:BR:L:14238/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-11-19", numero:"14238", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-11-19;14238", vigente:true, titulo:"Lei nº 14.238 de 19/11/2021", urn:"urn:lex:br:federal:lei:2021-11-19;14238", ementa:"Institui o Estatuto da Pessoa com Câncer; e dá outras providências.", arquivo:"federal/leis-ordinarias/2021/lei-14238-2021-11-19.md"}}, {id:"federal:BR:L:14177/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-06-22", numero:"14177", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-06-22;14177", vigente:true, titulo:"Lei nº 14.177 de 22/06/2021", urn:"urn:lex:br:federal:lei:2021-06-22;14177", ementa:"Altera a Lei nº 13.178, de 22 de outubro de 2015, para ampliar o prazo para ratificação dos registros imobiliários referentes aos imóveis rurais com origem em títulos de alienação ou de concessão de terras devolutas expedidos pelos Estados em faixa de fronteira; e dá outras providências.", arquivo:"federal/leis-ordinarias/2021/lei-14177-2021-06-22.md"}}, {id:"federal:BR:L:14216/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-10-07", numero:"14216", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-10-07;14216", vigente:true, titulo:"Lei nº 14.216 de 07/10/2021", urn:"urn:lex:br:federal:lei:2021-10-07;14216", ementa:"Estabelece medidas excepcionais em razão da Emergência em Saúde Pública de Importância Nacional (Espin) decorrente da infecção humana pelo coronavírus SARS-CoV-2, para suspender o cumprimento de medida judicial, extrajudicial ou administrativa que resulte em desocupação ou remoção forçada coletiva em imóvel privado ou público, exclusivamente urbano, e a concessão de liminar em ação de despejo de que trata a Lei nº 8.245, de 18 de outubro de 1991, e para estimular a celebração de acordos nas rela", arquivo:"federal/leis-ordinarias/2021/lei-14216-2021-10-07.md"}}, {id:"federal:BR:L:14223/2021", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-10-18", numero:"14223", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-10-18;14223", vigente:true, titulo:"Lei nº 14.223 de 18/10/2021", urn:"urn:lex:br:federal:lei:2021-10-18;14223", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor de diversos Órgãos do Poder Executivo e de Encargos Financeiros da União, crédito suplementar, no valor de R$ 2.082.617.753,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2021/lei-14223-2021-10-18.md"}}, {id:"federal:BR:L:14172/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-06-10", numero:"14172", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-06-10;14172", vigente:true, titulo:"Lei nº 14.172 de 10/06/2021", urn:"urn:lex:br:federal:lei:2021-06-10;14172", ementa:"Dispõe sobre a garantia de acesso à internet, com fins educacionais, a alunos e a professores da educação básica pública.", arquivo:"federal/leis-ordinarias/2021/lei-14172-2021-06-10.md"}}, {id:"federal:BR:L:14251/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-11-25", numero:"14251", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-11-25;14251", vigente:true, titulo:"Lei nº 14.251 de 25/11/2021", urn:"urn:lex:br:federal:lei:2021-11-25;14251", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor de diversos órgãos do Poder Executivo e de Operações Oficiais de Crédito, crédito suplementar no valor de R$ 721.321.565,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2021/lei-14251-2021-11-25.md"}}, {id:"federal:BR:L:14245/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-11-22", numero:"14245", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-11-22;14245", vigente:true, titulo:"Lei nº 14.245 de 22/11/2021", urn:"urn:lex:br:federal:lei:2021-11-22;14245", ementa:"Altera os Decretos-Leis nºs 2.848, de 7 de dezembro de 1940 (Código Penal), e 3.689, de 3 de outubro de 1941 (Código de Processo Penal), e a Lei nº 9.099, de 26 de setembro de 1995 (Lei dos Juizados Especiais Cíveis e Criminais), para coibir a prática de atos atentatórios à dignidade da vítima e de testemunhas e para estabelecer causa de aumento de pena no crime de coação no curso do processo (Lei Mariana Ferrer).", arquivo:"federal/leis-ordinarias/2021/lei-14245-2021-11-22.md"}}, {id:"federal:BR:L:14270/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-23", numero:"14270", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-12-23;14270", vigente:true, titulo:"Lei nº 14.270 de 23/12/2021", urn:"urn:lex:br:federal:lei:2021-12-23;14270", ementa:"Abre ao Orçamento Fiscal da União, em favor do Conselho Nacional de Justiça, crédito suplementar no valor de R$ 15.000.000,00, para reforço de dotação constante da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2021/lei-14270-2021-12-23.md"}}, {id:"federal:BR:L:14180/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-07-01", numero:"14180", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-07-01;14180", vigente:true, titulo:"Lei nº 14.180 de 01/07/2021", urn:"urn:lex:br:federal:lei:2021-07-01;14180", ementa:"Institui a Política de Inovação Educação Conectada.", arquivo:"federal/leis-ordinarias/2021/lei-14180-2021-07-01.md"}}, {id:"federal:BR:L:14127/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-03-22", numero:"14127", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-03-22;14127", vigente:true, titulo:"Lei nº 14.127 de 22/03/2021", urn:"urn:lex:br:federal:lei:2021-03-22;14127", ementa:"Altera a Lei nº 14.116, de 31 de dezembro de 2020, que dispõe sobre as diretrizes para a elaboração e a execução da Lei Orçamentária de 2021.", arquivo:"federal/leis-ordinarias/2021/lei-14127-2021-03-22.md"}}, {id:"federal:BR:L:14162/2021", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-06-02", numero:"14162", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-06-02;14162", vigente:true, titulo:"Lei nº 14.162 de 02/06/2021", urn:"urn:lex:br:federal:lei:2021-06-02;14162", ementa:"Dispõe sobre a organização básica da Polícia Civil do Distrito Federal.", arquivo:"federal/leis-ordinarias/2021/lei-14162-2021-06-02.md"}}, {id:"federal:BR:L:14144/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-04-22", numero:"14144", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-04-22;14144", vigente:true, titulo:"Lei nº 14.144 de 22/04/2021", urn:"urn:lex:br:federal:lei:2021-04-22;14144", ementa:"Estima a receita e fixa a despesa da União para o exercício financeiro de 2021.", arquivo:"federal/leis-ordinarias/2021/lei-14144-2021-04-22.md"}}, {id:"federal:BR:L:14255/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-11-30", numero:"14255", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-11-30;14255", vigente:true, titulo:"Lei nº 14.255 de 30/11/2021", urn:"urn:lex:br:federal:lei:2021-11-30;14255", ementa:"Confere ao Município de Urupema, no Estado de Santa Catarina, o título de Capital Nacional do Frio.", arquivo:"federal/leis-ordinarias/2021/lei-14255-2021-11-30.md"}}, {id:"federal:BR:L:14231/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-10-28", numero:"14231", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-10-28;14231", vigente:true, titulo:"Lei nº 14.231 de 28/10/2021", urn:"urn:lex:br:federal:lei:2021-10-28;14231", ementa:"Inclui os profissionais fisioterapeuta e terapeuta ocupacional na estratégia de saúde da família.", arquivo:"federal/leis-ordinarias/2021/lei-14231-2021-10-28.md"}}, {id:"federal:BR:L:14229/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-10-21", numero:"14229", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-10-21;14229", vigente:true, titulo:"Lei nº 14.229 de 21/10/2021", urn:"urn:lex:br:federal:lei:2021-10-21;14229", ementa:"Altera a Lei nº 7.408, de 25 de novembro de 1985, e a Lei nº 9.503, de 23 de setembro de 1997 (Código de Trânsito Brasileiro), para dispor sobre a fiscalização do excesso de peso dos veículos; altera a Lei nº 10.209, de 23 de março de 2001, para dispor sobre a prescrição da cobrança de multa ou indenização nos termos que especifica; e dá outras providências.", arquivo:"federal/leis-ordinarias/2021/lei-14229-2021-10-21.md"}}, {id:"federal:BR:L:14208/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-09-28", numero:"14208", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-09-28;14208", vigente:true, titulo:"Lei nº 14.208 de 28/09/2021", urn:"urn:lex:br:federal:lei:2021-09-28;14208", ementa:"Altera a Lei nº 9.096, de 19 de setembro de 1995 (Lei dos Partidos Políticos), e a Lei nº 9.504, de 30 de setembro de 1997 (Lei das Eleições), para instituir as federações de partidos políticos.", arquivo:"federal/leis-ordinarias/2021/lei-14208-2021-09-28.md"}}, {id:"federal:BR:L:14277/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-28", numero:"14277", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-12-28;14277", vigente:true, titulo:"Lei nº 14.277 de 28/12/2021", urn:"urn:lex:br:federal:lei:2021-12-28;14277", ementa:"Abre ao Orçamento Fiscal da União, em favor das Justiças Federal, Eleitoral, e do Trabalho, do Conselho Nacional de Justiça e do Conselho Nacional do Ministério Público, crédito suplementar no valor de R$ 83.402.306,00, para reforço de dotações orçamentárias.", arquivo:"federal/leis-ordinarias/2021/lei-14277-2021-12-28.md"}}, {id:"federal:BR:L:14230/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-10-25", numero:"14230", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-10-25;14230", vigente:true, titulo:"Lei nº 14.230 de 25/10/2021", urn:"urn:lex:br:federal:lei:2021-10-25;14230", ementa:"Altera a Lei nº 8.429, de 2 de junho de 1992, que dispõe sobre improbidade administrativa.", arquivo:"federal/leis-ordinarias/2021/lei-14230-2021-10-25.md"}}, {id:"federal:BR:L:14226/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-10-20", numero:"14226", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-10-20;14226", vigente:true, titulo:"Lei nº 14.226 de 20/10/2021", urn:"urn:lex:br:federal:lei:2021-10-20;14226", ementa:"Dispõe sobre a criação do Tribunal Regional Federal da 6ª Região e altera a Lei nº 11.798, de 29 de outubro de 2008, para modificar a composição do Conselho da Justiça Federal.", arquivo:"federal/leis-ordinarias/2021/lei-14226-2021-10-20.md"}}, {id:"federal:BR:L:14233/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-11-03", numero:"14233", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-11-03;14233", vigente:true, titulo:"Lei nº 14.233 de 03/11/2021", urn:"urn:lex:br:federal:lei:2021-11-03;14233", ementa:"Institui o Dia Nacional de Conscientização e Enfrentamento da Fibromialgia.", arquivo:"federal/leis-ordinarias/2021/lei-14233-2021-11-03.md"}}, {id:"federal:BR:L:14285/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-29", numero:"14285", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-12-29;14285", vigente:true, titulo:"Lei nº 14.285 de 29/12/2021", urn:"urn:lex:br:federal:lei:2021-12-29;14285", ementa:"Altera as Leis nºs 12.651, de 25 de maio de 2012, que dispõe sobre a proteção da vegetação nativa, 11.952, de 25 de junho de 2009, que dispõe sobre regularização fundiária em terras da União, e 6.766, de 19 de dezembro de 1979, que dispõe sobre o parcelamento do solo urbano, para dispor sobre as áreas de preservação permanente no entorno de cursos d'água em áreas urbanas consolidadas.", arquivo:"federal/leis-ordinarias/2021/lei-14285-2021-12-29.md"}}, {id:"federal:BR:L:14187/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-07-15", numero:"14187", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-07-15;14187", vigente:true, titulo:"Lei nº 14.187 de 15/07/2021", urn:"urn:lex:br:federal:lei:2021-07-15;14187", ementa:"Dispõe sobre a autorização para que estruturas industriais destinadas à fabricação de vacinas de uso veterinário sejam utilizadas na produção de insumos farmacêuticos ativos (IFA) e vacinas contra a covid-19 no Brasil.", arquivo:"federal/leis-ordinarias/2021/lei-14187-2021-07-15.md"}}, {id:"federal:BR:L:14200/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-09-02", numero:"14200", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-09-02;14200", vigente:true, titulo:"Lei nº 14.200 de 02/09/2021", urn:"urn:lex:br:federal:lei:2021-09-02;14200", ementa:"Altera a Lei nº 9.279, de 14 de maio de 1996 (Lei de Propriedade Industrial), para dispor sobre a licença compulsória de patentes ou de pedidos de patente nos casos de declaração de emergência nacional ou internacional ou de interesse público, ou de reconhecimento de estado de calamidade pública de âmbito nacional.", arquivo:"federal/leis-ordinarias/2021/lei-14200-2021-09-02.md"}}, {id:"federal:BR:L:14222/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-10-15", numero:"14222", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-10-15;14222", vigente:true, titulo:"Lei nº 14.222 de 15/10/2021", urn:"urn:lex:br:federal:lei:2021-10-15;14222", ementa:"Cria a Autoridade Nacional de Segurança Nuclear (ANSN); altera as Leis n°s 4.118, de 27 de agosto de 1962, 6.189, de 16 de dezembro de 1974, 6.453, de 17 de outubro de 1977, 9.765, de 17 de dezembro de 1998, 8.691, de 28 de julho de 1993, e 10.308, de 20 de novembro de 2001; e revoga a Lei nº 13.976, de 7 de janeiro de 2020.", arquivo:"federal/leis-ordinarias/2021/lei-14222-2021-10-15.md"}}, {id:"federal:BR:L:14198/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-09-02", numero:"14198", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-09-02;14198", vigente:true, titulo:"Lei nº 14.198 de 02/09/2021", urn:"urn:lex:br:federal:lei:2021-09-02;14198", ementa:"Dispõe sobre videochamadas entre pacientes internados em serviços de saúde impossibilitados de receber visitas e seus familiares.", arquivo:"federal/leis-ordinarias/2021/lei-14198-2021-09-02.md"}}, {id:"federal:BR:L:14132/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-03-31", numero:"14132", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-03-31;14132", vigente:true, titulo:"Lei nº 14.132 de 31/03/2021", urn:"urn:lex:br:federal:lei:2021-03-31;14132", ementa:"Acrescenta o art. 147-A ao Decreto-Lei nº 2.848, de 7 de dezembro de 1940 (Código Penal), para prever o crime de perseguição; e revoga o art. 65 do Decreto-Lei nº 3.688, de 3 de outubro de 1941 (Lei das Contravenções Penais).", arquivo:"federal/leis-ordinarias/2021/lei-14132-2021-03-31.md"}}, {id:"federal:BR:L:14258/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-03", numero:"14258", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-12-03;14258", vigente:true, titulo:"Lei nº 14.258 de 03/12/2021", urn:"urn:lex:br:federal:lei:2021-12-03;14258", ementa:"Dispõe sobre o exercício da profissão de compositor.", arquivo:"federal/leis-ordinarias/2021/lei-14258-2021-12-03.md"}}, {id:"federal:BR:L:14142/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-04-19", numero:"14142", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-04-19;14142", vigente:true, titulo:"Lei nº 14.142 de 19/04/2021", urn:"urn:lex:br:federal:lei:2021-04-19;14142", ementa:"Confere à cidade de Três Lagoas, no Estado de Mato Grosso do Sul, o título de Capital Nacional da Celulose.", arquivo:"federal/leis-ordinarias/2021/lei-14142-2021-04-19.md"}}, {id:"federal:BR:L:14136/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-04-16", numero:"14136", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-04-16;14136", vigente:true, titulo:"Lei nº 14.136 de 16/04/2021", urn:"urn:lex:br:federal:lei:2021-04-16;14136", ementa:"Denomina Rodovia José Pereira Alvarez o trecho da rodovia BR-287 entre as cidades de São Borja e Santiago, no Estado do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/2021/lei-14136-2021-04-16.md"}}, {id:"federal:BR:L:14247/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-11-24", numero:"14247", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-11-24;14247", vigente:true, titulo:"Lei nº 14.247 de 24/11/2021", urn:"urn:lex:br:federal:lei:2021-11-24;14247", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor do Ministério do Desenvolvimento Regional, crédito especial no valor de R$ 763.600.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2021/lei-14247-2021-11-24.md"}}, {id:"federal:BR:L:14148/2021", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-05-03", numero:"14148", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-05-03;14148", vigente:true, titulo:"Lei nº 14.148 de 03/05/2021", urn:"urn:lex:br:federal:lei:2021-05-03;14148", ementa:"Dispõe sobre ações emergenciais e temporárias destinadas ao setor de eventos para compensar os efeitos decorrentes das medidas de combate à pandemia da Covid-19; institui o Programa Emergencial de Retomada do Setor de Eventos (Perse) e o Programa de Garantia aos Setores Críticos (PGSC); e altera as Leis n°s 13.756, de 12 de dezembro de 2018, e 8.212, de 24 de julho de 1991.", arquivo:"federal/leis-ordinarias/2021/lei-14148-2021-05-03.md"}}, {id:"federal:BR:L:14274/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-23", numero:"14274", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-12-23;14274", vigente:true, titulo:"Lei nº 14.274 de 23/12/2021", urn:"urn:lex:br:federal:lei:2021-12-23;14274", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor de diversos órgãos do Poder Executivo e de Transferências a Estados, Distrito Federal e Municípios, crédito suplementar no valor de R$ 1.232.472.854,00, para reforço das dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2021/lei-14274-2021-12-23.md"}}, {id:"federal:BR:L:14182/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-07-12", numero:"14182", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-07-12;14182", vigente:true, titulo:"Lei nº 14.182 de 12/07/2021", urn:"urn:lex:br:federal:lei:2021-07-12;14182", ementa:"Dispõe sobre a desestatização da empresa Centrais Elétricas Brasileiras S.A. (Eletrobras); altera as Leis n os 5.899, de 5 de julho de 1973, 9.991, de 24 de julho de 2000, 10.438, de 26 de abril de 2002, 10.848, de 15 de março de 2004, 13.182, de 3 de novembro de 2015, 13.203, de 8 de dezembro de 2015, 14.118, de 13 de janeiro de 2021, 9.648, de 27 de maio de 1998, e 9.074, de 7 de julho de 1995; e revoga dispositivos da Lei nº 3.890-A, de 25 de abril de 1961.", arquivo:"federal/leis-ordinarias/2021/lei-14182-2021-07-12.md"}}, {id:"federal:BR:L:14265/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-23", numero:"14265", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-12-23;14265", vigente:true, titulo:"Lei nº 14.265 de 23/12/2021", urn:"urn:lex:br:federal:lei:2021-12-23;14265", ementa:"Abre ao Orçamento de Investimento para 2021, em favor da Caixa Econômica Federal, da Companhia de Entrepostos e Armazéns Gerais de São Paulo, da Transmissora Sul Litorânea de Energia S.A., da Companhia das Docas do Estado da Bahia e da Companhia Docas do Pará, crédito suplementar no valor de R$ 109.288.191,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2021/lei-14265-2021-12-23.md"}}, {id:"federal:BR:L:14167/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-06-10", numero:"14167", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-06-10;14167", vigente:true, titulo:"Lei nº 14.167 de 10/06/2021", urn:"urn:lex:br:federal:lei:2021-06-10;14167", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor dos Ministérios da Economia e da Cidadania, de Encargos Financeiros da União e de Operações Oficiais de Crédito, crédito suplementar no valor de R$ 19.767.619.840,00 para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2021/lei-14167-2021-06-10.md"}}, {id:"federal:BR:L:14202/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-09-08", numero:"14202", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-09-08;14202", vigente:true, titulo:"Lei nº 14.202 de 08/09/2021", urn:"urn:lex:br:federal:lei:2021-09-08;14202", ementa:"Denomina Aeroporto Prefeito Orlando Marinho o aeroporto situado no Município de Tefé, Estado do Amazonas.", arquivo:"federal/leis-ordinarias/2021/lei-14202-2021-09-08.md"}}, {id:"federal:BR:L:14153/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-05-25", numero:"14153", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-05-25;14153", vigente:true, titulo:"Lei nº 14.153 de 25/05/2021", urn:"urn:lex:br:federal:lei:2021-05-25;14153", ementa:"Denomina Rodovia Deputado Aloízio Santos o trecho da BR-262 do Km 7,2, em Cariacica, até o Km 20, em Viana, no Estado do Espírito Santo.", arquivo:"federal/leis-ordinarias/2021/lei-14153-2021-05-25.md"}}, {id:"federal:BR:L:14243/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-11-19", numero:"14243", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-11-19;14243", vigente:true, titulo:"Lei nº 14.243 de 19/11/2021", urn:"urn:lex:br:federal:lei:2021-11-19;14243", ementa:"Abre ao Orçamento Fiscal da União, em favor da Justiça Federal, crédito especial no valor de R$ 23.300.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2021/lei-14243-2021-11-19.md"}}, {id:"federal:BR:L:14197/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-09-01", numero:"14197", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-09-01;14197", vigente:true, titulo:"Lei nº 14.197 de 01/09/2021", urn:"urn:lex:br:federal:lei:2021-09-01;14197", ementa:"Acrescenta o Título XII na Parte Especial do Decreto-Lei nº 2.848, de 7 de dezembro de 1940 (Código Penal), relativo aos crimes contra o Estado Democrático de Direito; e revoga a Lei nº 7.170, de 14 de dezembro de 1983 (Lei de Segurança Nacional), e dispositivo do Decreto-Lei nº 3.688, de 3 de outubro de 1941 (Lei das Contravenções Penais).", arquivo:"federal/leis-ordinarias/2021/lei-14197-2021-09-01.md"}}, {id:"federal:BR:L:14283/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-29", numero:"14283", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-12-29;14283", vigente:true, titulo:"Lei nº 14.283 de 29/12/2021", urn:"urn:lex:br:federal:lei:2021-12-29;14283", ementa:"Abre ao Orçamento Fiscal da União, em favor dos Ministérios da Agricultura, Pecuária e Abastecimento e da Ciência, Tecnologia e Inovações, crédito suplementar no valor de R$ 279.387.421,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2021/lei-14283-2021-12-29.md"}}, {id:"federal:BR:L:14131/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-03-30", numero:"14131", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-03-30;14131", vigente:true, titulo:"Lei nº 14.131 de 30/03/2021", urn:"urn:lex:br:federal:lei:2021-03-30;14131", ementa:"Dispõe sobre o acréscimo de 5% (cinco por cento) ao percentual máximo para a contratação de operações de crédito com desconto automático em folha de pagamento até 31 de dezembro de 2021; e altera a Lei nº 8.213, de 24 de julho de 1991.", arquivo:"federal/leis-ordinarias/2021/lei-14131-2021-03-30.md"}}, {id:"federal:BR:L:14212/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-10-05", numero:"14212", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-10-05;14212", vigente:true, titulo:"Lei nº 14.212 de 05/10/2021", urn:"urn:lex:br:federal:lei:2021-10-05;14212", ementa:"Altera a Lei nº 14.116, de 31 de dezembro de 2020, que dispõe sobre as diretrizes para a elaboração e a execução da Lei Orçamentária de 2021.", arquivo:"federal/leis-ordinarias/2021/lei-14212-2021-10-05.md"}}, {id:"federal:BR:L:14175/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-06-17", numero:"14175", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-06-17;14175", vigente:true, titulo:"Lei nº 14.175 de 17/06/2021", urn:"urn:lex:br:federal:lei:2021-06-17;14175", ementa:"Abre crédito extraordinário em favor do Ministério do Desenvolvimento Regional, no valor de R$ 450.000.000,00 (quatrocentos e cinquenta milhões de reais), para o fim que especifica.", arquivo:"federal/leis-ordinarias/2021/lei-14175-2021-06-17.md"}}, {id:"federal:BR:L:14122/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-03-03", numero:"14122", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-03-03;14122", vigente:true, titulo:"Lei nº 14.122 de 03/03/2021", urn:"urn:lex:br:federal:lei:2021-03-03;14122", ementa:"Abre crédito extraordinário em favor do Ministério da Saúde, no valor de R$ 2.513.700.000,00 (dois bilhões, quinhentos e treze milhões e setecentos mil reais), para o fim que especifica; e dá outras providências.", arquivo:"federal/leis-ordinarias/2021/lei-14122-2021-03-03.md"}}, {id:"federal:BR:L:14220/2021", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-10-15", numero:"14220", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-10-15;14220", vigente:true, titulo:"Lei nº 14.220 de 15/10/2021", urn:"urn:lex:br:federal:lei:2021-10-15;14220", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor de diversos órgãos do Poder Executivo, crédito suplementar no valor de R$ 690.000.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2021/lei-14220-2021-10-15.md"}}, {id:"federal:BR:L:14124/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-03-10", numero:"14124", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-03-10;14124", vigente:true, titulo:"Lei nº 14.124 de 10/03/2021", urn:"urn:lex:br:federal:lei:2021-03-10;14124", ementa:"Dispõe sobre as medidas excepcionais relativas à aquisição de vacinas e de insumos e à contratação de bens e serviços de logística, de tecnologia da informação e comunicação, de comunicação social e publicitária e de treinamentos destinados à vacinação contra a covid-19 e sobre o Plano Nacional de Operacionalização da Vacinação contra a Covid-19.", arquivo:"federal/leis-ordinarias/2021/lei-14124-2021-03-10.md"}}, {id:"federal:BR:L:14193/2021", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-08-06", numero:"14193", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-08-06;14193", vigente:true, titulo:"Lei nº 14.193 de 06/08/2021", urn:"urn:lex:br:federal:lei:2021-08-06;14193", ementa:"Institui a Sociedade Anônima do Futebol e dispõe sobre normas de constituição, governança, controle e transparência, meios de financiamento da atividade futebolística, tratamento dos passivos das entidades de práticas desportivas e regime tributário específico; e altera as Leis nºs 9.615, de 24 de março de 1998, e 10.406, de 10 de janeiro de 2002 (Código Civil).", arquivo:"federal/leis-ordinarias/2021/lei-14193-2021-08-06.md"}}, {id:"federal:BR:L:14276/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-27", numero:"14276", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-12-27;14276", vigente:true, titulo:"Lei nº 14.276 de 27/12/2021", urn:"urn:lex:br:federal:lei:2021-12-27;14276", ementa:"Altera a Lei nº 14.113, de 25 de dezembro de 2020, que regulamenta o Fundo de Manutenção e Desenvolvimento da Educação Básica e de Valorização dos Profissionais da Educação (Fundeb).", arquivo:"federal/leis-ordinarias/2021/lei-14276-2021-12-27.md"}}, {id:"federal:BR:L:14145/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-04-23", numero:"14145", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-04-23;14145", vigente:true, titulo:"Lei nº 14.145 de 23/04/2021", urn:"urn:lex:br:federal:lei:2021-04-23;14145", ementa:"Autoriza a prorrogação de contratos por tempo determinado no âmbito do Ministério da Educação, do Fundo Nacional de Desenvolvimento da Educação (FNDE), do Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira (Inep), da Coordenação de Aperfeiçoamento de Pessoal de Nível Superior (Capes) e da Agência Nacional de Saúde Suplementar (ANS).", arquivo:"federal/leis-ordinarias/2021/lei-14145-2021-04-23.md"}}, {id:"federal:BR:L:14140/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-04-19", numero:"14140", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-04-19;14140", vigente:true, titulo:"Lei nº 14.140 de 19/04/2021", urn:"urn:lex:br:federal:lei:2021-04-19;14140", ementa:"Institui o Dia Nacional do Sanfoneiro.", arquivo:"federal/leis-ordinarias/2021/lei-14140-2021-04-19.md"}}, {id:"federal:BR:L:14272/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-23", numero:"14272", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-12-23;14272", vigente:true, titulo:"Lei nº 14.272 de 23/12/2021", urn:"urn:lex:br:federal:lei:2021-12-23;14272", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério da Agricultura, Pecuária e Abastecimento, crédito especial no valor de R$ 84.022,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/2021/lei-14272-2021-12-23.md"}}, {id:"federal:BR:L:14189/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-07-28", numero:"14189", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-07-28;14189", vigente:true, titulo:"Lei nº 14.189 de 28/07/2021", urn:"urn:lex:br:federal:lei:2021-07-28;14189", ementa:"Altera a Lei nº 13.992, de 22 de abril de 2020, para prorrogar a suspensão da obrigatoriedade da manutenção das metas quantitativas e qualitativas contratualizadas pelos prestadores de serviço de saúde de qualquer natureza no âmbito do Sistema Único de Saúde (SUS).", arquivo:"federal/leis-ordinarias/2021/lei-14189-2021-07-28.md"}}, {id:"federal:BR:L:14261/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-16", numero:"14261", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-12-16;14261", vigente:true, titulo:"Lei nº 14.261 de 16/12/2021", urn:"urn:lex:br:federal:lei:2021-12-16;14261", ementa:"Cria o Ministério do Trabalho e Previdência; altera as Leis n°s 13.844, de 18 de junho de 2019, 7.998, de 11 de janeiro de 1990, e 8.036, de 11 de maio de 1990, e a Consolidação das Leis do Trabalho (CLT), aprovada pelo Decreto-Lei nº 5.452, de 1º de maio de 1943; revoga dispositivos da Lei nº 13.846, de 18 de junho de 2019; e dá outras providências.", arquivo:"federal/leis-ordinarias/2021/lei-14261-2021-12-16.md"}}, {id:"federal:BR:L:14260/2021", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-08", numero:"14260", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-12-08;14260", vigente:true, titulo:"Lei nº 14.260 de 08/12/2021", urn:"urn:lex:br:federal:lei:2021-12-08;14260", ementa:"Estabelece incentivos à indústria da reciclagem; e cria o Fundo de Apoio para Ações Voltadas à Reciclagem (Favorecicle) e Fundos de Investimentos para Projetos de Reciclagem (ProRecicle).", arquivo:"federal/leis-ordinarias/2021/lei-14260-2021-12-08.md"}}, {id:"federal:BR:L:14165/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-06-10", numero:"14165", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-06-10;14165", vigente:true, titulo:"Lei nº 14.165 de 10/06/2021", urn:"urn:lex:br:federal:lei:2021-06-10;14165", ementa:"Define as diretrizes para a quitação e para a renegociação das dívidas relativas às debêntures emitidas por empresas e subscritas pelos fundos de investimentos regionais e para o desinvestimento, a liquidação e a extinção dos fundos.", arquivo:"federal/leis-ordinarias/2021/lei-14165-2021-06-10.md"}}, {id:"federal:BR:L:14246/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-11-23", numero:"14246", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-11-23;14246", vigente:true, titulo:"Lei nº 14.246 de 23/11/2021", urn:"urn:lex:br:federal:lei:2021-11-23;14246", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor de diversos órgãos do Poder Executivo, crédito suplementar no valor de R$ 3.066.300.000,00, para reforço das dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2021/lei-14246-2021-11-23.md"}}, {id:"federal:BR:L:14156/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-06-01", numero:"14156", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-06-01;14156", vigente:true, titulo:"Lei nº 14.156 de 01/06/2021", urn:"urn:lex:br:federal:lei:2021-06-01;14156", ementa:"Altera a Lei nº 12.343, de 2 de dezembro de 2010, para aumentar o prazo de vigência do Plano Nacional de Cultura (PNC) para 12 (doze) anos.", arquivo:"federal/leis-ordinarias/2021/lei-14156-2021-06-01.md"}}, {id:"federal:BR:L:14241/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-11-19", numero:"14241", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-11-19;14241", vigente:true, titulo:"Lei nº 14.241 de 19/11/2021", urn:"urn:lex:br:federal:lei:2021-11-19;14241", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor de diversos Órgãos do Poder Executivo e de Operações Oficiais de Crédito, crédito suplementar no valor de R$ 4.113.646.125,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2021/lei-14241-2021-11-19.md"}}, {id:"federal:BR:L:14279/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-28", numero:"14279", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-12-28;14279", vigente:true, titulo:"Lei nº 14.279 de 28/12/2021", urn:"urn:lex:br:federal:lei:2021-12-28;14279", ementa:"Reconhece o carnaval do Município de Aracati, no Estado do Ceará, como manifestação da cultura nacional.", arquivo:"federal/leis-ordinarias/2021/lei-14279-2021-12-28.md"}}, {id:"federal:BR:L:14143/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-04-21", numero:"14143", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-04-21;14143", vigente:true, titulo:"Lei nº 14.143 de 21/04/2021", urn:"urn:lex:br:federal:lei:2021-04-21;14143", ementa:"Altera a Lei nº 14.116, de 31 de dezembro de 2020, que \"dispõe sobre as diretrizes para a elaboração e a execução da Lei Orçamentária de 2021\".", arquivo:"federal/leis-ordinarias/2021/lei-14143-2021-04-21.md"}}, {id:"federal:BR:L:14210/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-09-30", numero:"14210", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2021-09-30;14210", vigente:true, titulo:"Lei nº 14.210 de 30/09/2021", urn:"urn:lex:br:federal:lei:2021-09-30;14210", ementa:"Acrescenta o Capítulo XI-A à Lei nº 9.784, de 29 de janeiro de 1999, para dispor sobre a decisão coordenada no âmbito da administração pública federal.", arquivo:"federal/leis-ordinarias/2021/lei-14210-2021-09-30.md"}}, {id:"federal:BR:L:14170/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2021, data:"2021-06-10",