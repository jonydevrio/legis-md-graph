8-09-24-s0.md"}}, {id:"federal:BR:L:s/n/1828:12180", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-09-06", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-09-06;seq-sf-0", titulo:"Lei  de 06/09/1828", vigente:true, urn:"urn:lex:br:federal:lei:1828-09-06;seq-sf-0", ementa:"EXTINGUE O EXCLUSIVO DA NAVEGAÇÃO ENTRE A VILA DE SANTOS E PORTOS INTERIORES DA PROVÍNCIA DE SÃO PAULO E DE NOVO REGULA A ARRECADAÇÃO E APLICAÇÃO DA TAXA VOLUNTÁRIA PARA A ESTRADA DE SANTOS E SÃO PAULO E SUAS RAMIFICAÇÕES.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-09-06-s0.md"}}, {id:"federal:BR:L:s/n/1828:12181", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-10-06", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-10-06;seq-sf-0", titulo:"Lei  de 06/10/1828", vigente:true, urn:"urn:lex:br:federal:lei:1828-10-06;seq-sf-0", ementa:"EXTINGUE O OFICIO DE SELADOR DE FAZENDAS NAS ALFANDEGAS DO IMPERIO, MANDANDO ARRECADAR PARA O TESOURO OS RESPECTIVO EMOLUMENTOS.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-10-06-s0.md"}}, {id:"federal:BR:L:s/n/1828:12182", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-10-01", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-10-01;seq-sf-1", vigente:true, titulo:"Lei  de 01/10/1828 ( seq-sf: 1 )", urn:"urn:lex:br:federal:lei:1828-10-01;seq-sf-1", ementa:"DA NOVA FORMA AS CAMARAS MUNICIPAIS, MARCA SUAS ATRIBUIÇÕES, E O PROCESSO PARA A SUA ELEIÇÃO, E DOS JUIZES DE PAZ.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-10-01-s1.md"}}, {id:"federal:BR:L:s/n/1828:12183", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-08-29", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-08-29;seq-sf-0", titulo:"Lei  de 29/08/1828", vigente:true, urn:"urn:lex:br:federal:lei:1828-08-29;seq-sf-0", ementa:"ESTABELECE REGRAS PARA A CONSTRUÇÃO DAS OBRAS PÚBLICAS, QUE TIVEREM POR OBJETIVO A NAVEGAÇÃO DE RIOS, ABERTURAS DE CANAIS, EDIFICAÇÃO DE ESTRADAS DE PONTES, CALÇADAS OU AQUEDUTOS.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-08-29-s0.md"}}, {id:"federal:BR:L:s/n/1828:12184", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-09-20", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-09-20;seq-sf-0", titulo:"Lei  de 20/09/1828", vigente:true, urn:"urn:lex:br:federal:lei:1828-09-20;seq-sf-0", ementa:"EXTINGUE O TRIBUNAL DA JUNTA DA BULA DA CRUZADA.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-09-20-s0.md"}}, {id:"federal:BR:L:s/n/1828:12185", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-08-30", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-08-30;seq-sf-0", titulo:"Lei  de 30/08/1828", vigente:true, urn:"urn:lex:br:federal:lei:1828-08-30;seq-sf-0", ementa:"EXTINGUE OS LUGARES DE PROVEDOR-MOR E CIRUGIÃO-MOR DO IMPERIO, PASSANDO PARA AS CAMARAS MUNICIPAIS E JUSTIÇAS ORDINARIAS AS ATRIBUIÇÕES QUE LHES COMPETIAM.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-08-30-s0.md"}}, {id:"federal:BR:L:s/n/1828:12186", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-09-25", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-09-25;seq-sf-1", vigente:true, titulo:"Lei  de 25/09/1828 ( seq-sf: 1 )", urn:"urn:lex:br:federal:lei:1828-09-25;seq-sf-1", ementa:"DA DESTINO AOS OFICIAIS DA EXTINTA IMPERIAL BRIGADA DE MARINHA EXCEDENTE DO ESTADO COMPLETO DO ATUAL CORPO DE ARTILHARIA DE MARINHA E MARCA AS GRATIFICAÇÕES QUE COMPETEM AOS OFICIAIS DESTE CORPO.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-09-25-s1.md"}}, {id:"federal:BR:L:s/n/1828:12187", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-08-27", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-08-27;seq-sf-0", titulo:"Lei  de 27/08/1828", vigente:true, urn:"urn:lex:br:federal:lei:1828-08-27;seq-sf-0", ementa:"DA REGIMENTO PARA OS CONSELHOS GERAIS DE PROVINCIA.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-08-27-s0.md"}}, {id:"federal:BR:L:s/n/1828:12188", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-10-08", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-10-08;seq-sf-0", titulo:"Lei  de 08/10/1828", vigente:true, urn:"urn:lex:br:federal:lei:1828-10-08;seq-sf-0", ementa:"ORÇA A RECEITA E FIXA A DESPEZA DO TESOURO PÚBLICO NESTA CÔRTE E PROVÍNCIA DO RIO DE JANEIRO PARA O ANO DE 1829.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-10-08-s0.md"}}, {id:"federal:BR:L:s/n/1828:12189", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-09-22", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-09-22;seq-sf-0", titulo:"Lei  de 22/09/1828", vigente:true, urn:"urn:lex:br:federal:lei:1828-09-22;seq-sf-0", ementa:"EXTINGUE OS TRIBUNAIS DAS MESAS DO DESEMBARGADOR DO PAÇO E DA CONSCIENCIA E ORDENS E REGULA A EXPEDIÇÃO DOS NEGOCIOS QUE LHES PERTENCIAM E FICAM SUBSISTINDO.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-09-22-s0.md"}}, {id:"federal:BR:L:s/n/1828:12190", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-08-30", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-08-30;seq-sf-2", vigente:true, titulo:"Lei  de 30/08/1828 ( seq-sf: 2 )", urn:"urn:lex:br:federal:lei:1828-08-30;seq-sf-2", ementa:"MANDA QUE O IMPOSTO DO QUINTO DOS COUROS NA PROVINCIA DO RIO GRANDE DO SUL SEJA PAGO EM DINHEIRO NA RAZÃO DE 20 POR CENTO DO SEU VALOR, ISENTANDO DESSE IMPOSTO OS DO CONSUMO DO PAIS.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-08-30-s2.md"}}, {id:"federal:BR:L:s/n/1828:12191", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-08-26", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-08-26;seq-sf-0", titulo:"Lei  de 26/08/1828", vigente:true, urn:"urn:lex:br:federal:lei:1828-08-26;seq-sf-0", ementa:"APLICA VARIOS SUBSIDIOS PARA A FATURA ESTRADA DA SERRA DE PARATI E EXTINGUE OS REGISTROS DE CACHOEIRA E DO CURRALINHO E O IMPOSTO DE QUARENTA RS, POR PESSOA E POR ANIMAL QUE NELES PASSAVAM.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-08-26-s0.md"}}, {id:"federal:BR:L:s/n/1828:12192", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-09-24", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-09-24;seq-sf-1", vigente:true, titulo:"Lei  de 24/09/1828 ( seq-sf: 1 )", urn:"urn:lex:br:federal:lei:1828-09-24;seq-sf-1", ementa:"TAXA EM QUINZE POR CENTO PARA TODAS AS NAÇÕES, OS DIREITOS DE IMPORTAÇÃO DE QUAISQUER MERCADORIAS E GENEROS ESTRANGEIROS.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-09-24-s1.md"}}, {id:"federal:BR:L:s/n/1828:12193", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-09-25", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-09-25;seq-sf-0", titulo:"Lei  de 25/09/1828", vigente:true, urn:"urn:lex:br:federal:lei:1828-09-25;seq-sf-0", ementa:"REDUZ A DOIS POR CENTO OS DIREITOS DE BALDEAÇÃO E REEXPORTAÇÃO DE TODAS AS MERCADORIAS IMPORTADAS.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-09-25-s0.md"}}, {id:"federal:BR:L:s/n/1828:12194", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-08-30", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-08-30;seq-sf-1", vigente:true, titulo:"Lei  de 30/08/1828 ( seq-sf: 1 )", urn:"urn:lex:br:federal:lei:1828-08-30;seq-sf-1", ementa:"DECLARA OS CASOS, EM QUE SE PODE PROCEDER A PRISÃO POR CRIMES SEM CULPA FORMADA.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-08-30-s1.md"}}, {id:"federal:BR:L:s/n/1828:12195", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-09-18", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-09-18;seq-sf-0", titulo:"Lei  de 18/09/1828", vigente:true, urn:"urn:lex:br:federal:lei:1828-09-18;seq-sf-0", ementa:"CRIA O SUPREMO TRIBUNAL DE JUSTIÇA E DECLARA SUAS ATRIBUIÇÕES.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-09-18-s0.md"}}, {id:"federal:BR:L:s/n/1828:12196", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-10-01", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-10-01;seq-sf-0", titulo:"Lei  de 01/10/1828", vigente:true, urn:"urn:lex:br:federal:lei:1828-10-01;seq-sf-0", ementa:"DÁ NOVA FORMA ÀS CÂMARAS MUNICIPAIS, MARCA SUAS ATRIBUIÇÕES, E O PROCESSO PARA A SUA ELEIÇÃO, E DOS JUÍZES DE PAZ, CRIANDO EM CADA CIDADE E VILA DO IMPÉRIO CÂMARAS MUNICIPAIS.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-10-01-s0.md"}}, {id:"federal:BR:L:s/n/1828:12197", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-09-25", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-09-25;seq-sf-2", vigente:true, titulo:"Lei  de 25/09/1828 ( seq-sf: 2 )", urn:"urn:lex:br:federal:lei:1828-09-25;seq-sf-2", ementa:"REVOGA O ALVARA DE 5 DE JANEIRO DE 1757, NA PARTE RELATIVA A SUSPENSÃO DOS MINISTROS OU OFICIAIS DE JUSTIÇA, FAZENDA E GUERRA, ACIONISTA DE COMPANHIAS MERCANTES.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-09-25-s2.md"}}, {id:"federal:BR:L:s/n/1828:12198", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1828, data:"1828-09-23", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1828-09-23;seq-sf-0", titulo:"Lei  de 23/09/1828", vigente:true, urn:"urn:lex:br:federal:lei:1828-09-23;seq-sf-0", ementa:"PRESCREVE AS FORMALIDADES QUE SE DEVEM OBSERVAR NOS PROCESSOS CRIMINAIS E A MANEIRA POR QUE DEVEM SER INSTRUÍDOS E PREPARADOS OS QUE FOREM JULGADOS NAS JUNTAS DE JUSTIÇA.", arquivo:"federal/leis-ordinarias/1828/lei-sn-1828-09-23-s0.md"}}, {id:"federal:BR:L:6930/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-07-07", numero:"6930", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-07-07;6930", vigente:true, titulo:"Lei nº 6.930 de 07/07/1981", urn:"urn:lex:br:federal:lei:1981-07-07;6930", ementa:"Dispõe sobre o enquadramento dos servidores remanescentes da implantação   do Plano de Classificação de Cargos instituído pela Lei nº 5920, de 19 de   setembro de 1973, e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6930-1981-07-07.md"}}, {id:"federal:BR:L:6972/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-14", numero:"6972", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-12-14;6972", vigente:true, titulo:"Lei nº 6.972 de 14/12/1981", urn:"urn:lex:br:federal:lei:1981-12-14;6972", ementa:"Acrescenta dispositivo à Lei n. 6849, de 12 de novembro de 1980, que \"fixa   os valores de retribuição da Categoria Funcional de Agente de Vigilância, e dá   outras providências\".", arquivo:"federal/leis-ordinarias/1981/lei-6972-1981-12-14.md"}}, {id:"federal:BR:L:6933/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-07-13", numero:"6933", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-07-13;6933", vigente:true, titulo:"Lei nº 6.933 de 13/07/1981", urn:"urn:lex:br:federal:lei:1981-07-13;6933", ementa:"Inclui ligação rodoviária na Relação Descritiva das Rodovias do Sistema   Rodoviário Federal do Plano Nacional de Viação, instituído pela Lei nº 5917, de   10 de setembro de 1973.", arquivo:"federal/leis-ordinarias/1981/lei-6933-1981-07-13.md"}}, {id:"federal:BR:L:6912/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-05-27", numero:"6912", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-05-27;6912", vigente:true, titulo:"Lei nº 6.912 de 27/05/1981", urn:"urn:lex:br:federal:lei:1981-05-27;6912", ementa:"Cria cargos em comissão e efetivos no Quadro Permanente da Secretaria do   Tribunal Regional do Trabalho da 2ª Região, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1981/lei-6912-1981-05-27.md"}}, {id:"federal:BR:L:6926/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-06-30", numero:"6926", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-06-30;6926", vigente:true, titulo:"Lei nº 6.926 de 30/06/1981", urn:"urn:lex:br:federal:lei:1981-06-30;6926", ementa:"Institui o \"Dia Nacional do Aposentado\", a ser comemorado anualmente a 24 de janeiro.", arquivo:"federal/leis-ordinarias/1981/lei-6926-1981-06-30.md"}}, {id:"federal:BR:L:6967/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-09", numero:"6967", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-12-09;6967", vigente:true, titulo:"Lei nº 6.967 de 09/12/1981", urn:"urn:lex:br:federal:lei:1981-12-09;6967", ementa:"Autoriza o Governo do Distrito Federal a abrir créditos suplementares até   o limite de Cr$ 4.000.000.000,00 (quatro bilhões de cruzeiros) e dá outras   providências.", arquivo:"federal/leis-ordinarias/1981/lei-6967-1981-12-09.md"}}, {id:"federal:BR:L:6900/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-04-14", numero:"6900", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-04-14;6900", vigente:true, titulo:"Lei nº 6.900 de 14/04/1981", urn:"urn:lex:br:federal:lei:1981-04-14;6900", ementa:"Acrescenta parágrafo único ao art. 20 do Decreto-Lei nº 3689, de 3 de outubro de 1941 - Código de Processo Penal.", arquivo:"federal/leis-ordinarias/1981/lei-6900-1981-04-14.md"}}, {id:"federal:BR:L:6929/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-07-07", numero:"6929", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-07-07;6929", vigente:true, titulo:"Lei nº 6.929 de 07/07/1981", urn:"urn:lex:br:federal:lei:1981-07-07;6929", ementa:"Concede pensão especial a Pedro Paulo Kossobuski, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1981/lei-6929-1981-07-07.md"}}, {id:"federal:BR:L:6943/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-09-14", numero:"6943", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-09-14;6943", vigente:true, titulo:"Lei nº 6.943 de 14/09/1981", urn:"urn:lex:br:federal:lei:1981-09-14;6943", ementa:"Dispõe sobre proventos de funcionários aposentados ou postos em   disponibilidade, e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6943-1981-09-14.md"}}, {id:"federal:BR:L:6977/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-22", numero:"6977", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-12-22;6977", vigente:true, titulo:"Lei nº 6.977 de 22/12/1981", urn:"urn:lex:br:federal:lei:1981-12-22;6977", ementa:"Autoriza o Poder Executivo a abrir créditos suplementares ao Orçamento da   União até o limite de Cr$ 13.833.334.000,00, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1981/lei-6977-1981-12-22.md"}}, {id:"federal:BR:L:6976/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-14", numero:"6976", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-12-14;6976", vigente:true, titulo:"Lei nº 6.976 de 14/12/1981", urn:"urn:lex:br:federal:lei:1981-12-14;6976", ementa:"Altera a diretriz da Rodovia BR-222, integrante do Plano Nacional de Viação, aprovado pela Lei nº 5917, de 10 de setembro de 1973.", arquivo:"federal/leis-ordinarias/1981/lei-6976-1981-12-14.md"}}, {id:"federal:BR:L:6955/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-11-18", numero:"6955", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-11-18;6955", vigente:true, titulo:"Lei nº 6.955 de 18/11/1981", urn:"urn:lex:br:federal:lei:1981-11-18;6955", ementa:"Acrescenta dispositivos ao art. 13 da Lei nº 4324, de 14 de abril de 1964,   que \"institui o Conselho Federal e os Conselhos Regionais de Odontologia e dá   outras providências\".", arquivo:"federal/leis-ordinarias/1981/lei-6955-1981-11-18.md"}}, {id:"federal:BR:L:6897/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-03-30", numero:"6897", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-03-30;6897", vigente:true, titulo:"Lei nº 6.897 de 30/03/1981", urn:"urn:lex:br:federal:lei:1981-03-30;6897", ementa:"Autoriza a alienação, sob a forma de doação modal, ao Estado do Pará, do   imóvel que menciona, situado no Município de Marabá, Estado do Pará, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1981/lei-6897-1981-03-30.md"}}, {id:"federal:BR:L:6906/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-05-11", numero:"6906", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-05-11;6906", vigente:true, titulo:"Lei nº 6.906 de 11/05/1981", urn:"urn:lex:br:federal:lei:1981-05-11;6906", ementa:"Fixa os valores de vencimentos ou salário do Grupo-Atividades   Aeroespaciais do Serviço Civil do Poder Executivo, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1981/lei-6906-1981-05-11.md"}}, {id:"federal:BR:L:6899/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-04-08", numero:"6899", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-04-08;6899", vigente:true, titulo:"Lei nº 6.899 de 08/04/1981", urn:"urn:lex:br:federal:lei:1981-04-08;6899", ementa:"Determina a aplicação da correção monetária nos débitos oriundos de decisão judicial e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6899-1981-04-08.md"}}, {id:"federal:BR:L:6915/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-06-01", numero:"6915", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-06-01;6915", vigente:true, titulo:"Lei nº 6.915 de 01/06/1981", urn:"urn:lex:br:federal:lei:1981-06-01;6915", ementa:"Cria a 11ª Região da Justiça do Trabalho, o Tribunal Regional do Trabalho   respectivo, institui a correspondente Procuradoria Regional do Ministério   Público da União junto à Justiça do Trabalho, e dá outras providência.", arquivo:"federal/leis-ordinarias/1981/lei-6915-1981-06-01.md"}}, {id:"federal:BR:L:6963/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-07", numero:"6963", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-12-07;6963", vigente:true, titulo:"Lei nº 6.963 de 07/12/1981", urn:"urn:lex:br:federal:lei:1981-12-07;6963", ementa:"Estima a Receita e fixa a Despesa do Distrito Federal para o exercício de   1982.", arquivo:"federal/leis-ordinarias/1981/lei-6963-1981-12-07.md"}}, {id:"federal:BR:L:6974/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-14", numero:"6974", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-12-14;6974", vigente:true, titulo:"Lei nº 6.974 de 14/12/1981", urn:"urn:lex:br:federal:lei:1981-12-14;6974", ementa:"Altera dispositivo da Lei nº 4878, de 3 de dezembro de 1965, que \"dispõe sobre o regime jurídico peculiar aos funcionários policiais civis da União e do Distrito Federal\".", arquivo:"federal/leis-ordinarias/1981/lei-6974-1981-12-14.md"}}, {id:"federal:BR:L:6941/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-09-14", numero:"6941", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-09-14;6941", vigente:true, titulo:"Lei nº 6.941 de 14/09/1981", urn:"urn:lex:br:federal:lei:1981-09-14;6941", ementa:"Altera a Lei nº 6015, de 31 de dezembro de 1973, que dispõe sobre os Registros Públicos, com a modificação constante da Lei nº 6850, de 12 de novembro de 1980, e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6941-1981-09-14.md"}}, {id:"federal:BR:L:6932/1981", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-07-07", numero:"6932", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-07-07;6932", vigente:true, titulo:"Lei nº 6.932 de 07/07/1981", urn:"urn:lex:br:federal:lei:1981-07-07;6932", ementa:"Dispõe sobre as atividades do médico residente e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6932-1981-07-07.md"}}, {id:"federal:BR:L:6953/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-11-18", numero:"6953", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-11-18;6953", vigente:true, titulo:"Lei nº 6.953 de 18/11/1981", urn:"urn:lex:br:federal:lei:1981-11-18;6953", ementa:"Autoriza o Departamento Nacional de Obras Contra as Secas - DNOCS,   Autarquia vinculada ao Ministério do Interior, a doar o imóvel que menciona,   situado no Município de Pentecoste, no Estado do Ceará.", arquivo:"federal/leis-ordinarias/1981/lei-6953-1981-11-18.md"}}, {id:"federal:BR:L:6935/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-07-13", numero:"6935", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-07-13;6935", vigente:true, titulo:"Lei nº 6.935 de 13/07/1981", urn:"urn:lex:br:federal:lei:1981-07-13;6935", ementa:"Autoriza a Superintendência do Desenvolvimento da Amazônia - SUDAM a   renunciar créditos e financiamentos, à conta de recursos do extinto Fundo de   Financiamento para Água e Esgotos, concedidos a entidades estaduais para   execução de obras e serviços de saneamento na Amazônia Legal, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1981/lei-6935-1981-07-13.md"}}, {id:"federal:BR:L:6969/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-10", numero:"6969", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-12-10;6969", vigente:true, titulo:"Lei nº 6.969 de 10/12/1981", urn:"urn:lex:br:federal:lei:1981-12-10;6969", ementa:"Dispõe sobre a aquisição, por usucapião especial, de imóveis rurais, altera a redação do § 2º do art. 589 do Código Civil e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6969-1981-12-10.md"}}, {id:"federal:BR:L:6970/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-10", numero:"6970", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-12-10;6970", vigente:true, titulo:"Lei nº 6.970 de 10/12/1981", urn:"urn:lex:br:federal:lei:1981-12-10;6970", ementa:"Dispõe sobre o pagamento da Gratificação de Produtividade, nos casos que menciona, e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6970-1981-12-10.md"}}, {id:"federal:BR:L:6950/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-11-04", numero:"6950", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-11-04;6950", vigente:true, titulo:"Lei nº 6.950 de 04/11/1981", urn:"urn:lex:br:federal:lei:1981-11-04;6950", ementa:"Altera a Lei nº 3807, de 26 de agosto de 1960, fixa novo limite máximo do   salário de contribuição previsto na Lei nº 6332, de 18 de maio de 1976, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6950-1981-11-04.md"}}, {id:"federal:BR:L:6904/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-04-30", numero:"6904", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-04-30;6904", vigente:true, titulo:"Lei nº 6.904 de 30/04/1981", urn:"urn:lex:br:federal:lei:1981-04-30;6904", ementa:"Altera a composição dos Tribunais Regionais do Trabalho que menciona, cria   cargos, e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6904-1981-04-30.md"}}, {id:"federal:BR:L:6938/1981", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-08-31", numero:"6938", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-08-31;6938", vigente:true, titulo:"Lei nº 6.938 de 31/08/1981", urn:"urn:lex:br:federal:lei:1981-08-31;6938", ementa:"Dispõe sobre a Política Nacional do Meio Ambiente, seus fins e mecanismos de formulação e aplicação, e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6938-1981-08-31.md"}}, {id:"federal:BR:L:6945/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-09-14", numero:"6945", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-09-14;6945", vigente:true, titulo:"Lei nº 6.945 de 14/09/1981", urn:"urn:lex:br:federal:lei:1981-09-14;6945", ementa:"Institui a Taxa de Limpeza Pública no Distrito Federal e dá outras   providências.", arquivo:"federal/leis-ordinarias/1981/lei-6945-1981-09-14.md"}}, {id:"federal:BR:L:6949/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-10-27", numero:"6949", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-10-27;6949", vigente:true, titulo:"Lei nº 6.949 de 27/10/1981", urn:"urn:lex:br:federal:lei:1981-10-27;6949", ementa:"Dispõe sobre doação de lote à Organização Internacional do Trabalho - OIT,   pela Companhia Imobiliária de Brasília - TERRACAP.", arquivo:"federal/leis-ordinarias/1981/lei-6949-1981-10-27.md"}}, {id:"federal:BR:L:6965/1981", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-09", numero:"6965", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-12-09;6965", vigente:true, titulo:"Lei nº 6.965 de 09/12/1981", urn:"urn:lex:br:federal:lei:1981-12-09;6965", ementa:"Dispõe sobre a regulamentação da profissão de Fonoaudiólogo, e determina outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6965-1981-12-09.md"}}, {id:"federal:BR:L:6924/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-06-29", numero:"6924", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-06-29;6924", vigente:true, titulo:"Lei nº 6.924 de 29/06/1981", urn:"urn:lex:br:federal:lei:1981-06-29;6924", ementa:"Cria, no Ministério da Aeronáutica, o Corpo Feminino da Reserva da   Aeronáutica e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6924-1981-06-29.md"}}, {id:"federal:BR:L:6959/1981", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-11-25", numero:"6959", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-11-25;6959", vigente:true, titulo:"Lei nº 6.959 de 25/11/1981", urn:"urn:lex:br:federal:lei:1981-11-25;6959", ementa:"Cria cargos no Quadro Permanente da Secretaria do Supremo Tribunal Federal, e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6959-1981-11-25.md"}}, {id:"federal:BR:L:6909/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-05-27", numero:"6909", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-05-27;6909", vigente:true, titulo:"Lei nº 6.909 de 27/05/1981", urn:"urn:lex:br:federal:lei:1981-05-27;6909", ementa:"Dispõe sobre a constituição, no Território Federal do Amapá, da Companhia   de Desenvolvimento do Amapá - CODEASA, e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6909-1981-05-27.md"}}, {id:"federal:BR:L:6927/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-07-07", numero:"6927", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-07-07;6927", vigente:true, titulo:"Lei nº 6.927 de 07/07/1981", urn:"urn:lex:br:federal:lei:1981-07-07;6927", ementa:"Cria a 10ª Região da Justiça do Trabalho, o Tribunal Regional do Trabalho   respectivo, e institui a correspondente Procuradoria Regional do Ministério   Público da União junto à Justiça do Trabalho, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1981/lei-6927-1981-07-07.md"}}, {id:"federal:BR:L:6902/1981", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-04-27", numero:"6902", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-04-27;6902", vigente:true, titulo:"Lei nº 6.902 de 27/04/1981", urn:"urn:lex:br:federal:lei:1981-04-27;6902", ementa:"Dispõe sobre a criação de Estações Ecológicas, Áreas de Proteção Ambiental e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6902-1981-04-27.md"}}, {id:"federal:BR:L:6948/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-09-28", numero:"6948", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-09-28;6948", vigente:true, titulo:"Lei nº 6.948 de 28/09/1981", urn:"urn:lex:br:federal:lei:1981-09-28;6948", ementa:"Dispõe sobre a realização de convenções para renovação de diretórios a que   se refere o art. 6º da Lei nº 6767, de 20 de dezembro de 1979, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1981/lei-6948-1981-09-28.md"}}, {id:"federal:BR:L:6907/1981", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-05-21", numero:"6907", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-05-21;6907", vigente:true, titulo:"Lei nº 6.907 de 21/05/1981", urn:"urn:lex:br:federal:lei:1981-05-21;6907", ementa:"Reajusta os vencimentos, salários e proventos dos servidores da Câmara dos   Deputados e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6907-1981-05-21.md"}}, {id:"federal:BR:L:6960/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-11-25", numero:"6960", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-11-25;6960", vigente:true, titulo:"Lei nº 6.960 de 25/11/1981", urn:"urn:lex:br:federal:lei:1981-11-25;6960", ementa:"Dispõe sobre a retribuição dos Grupos Direção e Assessoramento Superiores   e Direção e Assistência Intermediárias dos Territórios Federais do Amapá, de   Rondônia, e de Roraima, e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6960-1981-11-25.md"}}, {id:"federal:BR:L:6952/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-11-06", numero:"6952", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-11-06;6952", vigente:true, titulo:"Lei nº 6.952 de 06/11/1981", urn:"urn:lex:br:federal:lei:1981-11-06;6952", ementa:"Acrescenta parágrafos ao art. 134 da Lei nº 3071, de 1º de janeiro de 1916 - Código Civil.", arquivo:"federal/leis-ordinarias/1981/lei-6952-1981-11-06.md"}}, {id:"federal:BR:L:6910/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-05-27", numero:"6910", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-05-27;6910", vigente:true, titulo:"Lei nº 6.910 de 27/05/1981", urn:"urn:lex:br:federal:lei:1981-05-27;6910", ementa:"Restringe a aplicação do dispositivo no art. 2º da Lei nº 4729, de 14 de   julho de 1965, e no art. 18, § 2º do Decreto-Lei nº 157, de 10 de fevereiro de   1967, e revoga o Decreto-Lei nº 1650, de 19 de dezembro de 1978.", arquivo:"federal/leis-ordinarias/1981/lei-6910-1981-05-27.md"}}, {id:"federal:BR:L:6917/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-06-01", numero:"6917", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-06-01;6917", vigente:true, titulo:"Lei nº 6.917 de 01/06/1981", urn:"urn:lex:br:federal:lei:1981-06-01;6917", ementa:"Autoriza a reversão ao Município de Pinheiro, Estado do Maranhão, do   terreno que menciona.", arquivo:"federal/leis-ordinarias/1981/lei-6917-1981-06-01.md"}}, {id:"federal:BR:L:6934/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-07-13", numero:"6934", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-07-13;6934", vigente:true, titulo:"Lei nº 6.934 de 13/07/1981", urn:"urn:lex:br:federal:lei:1981-07-13;6934", ementa:"Altera a Lei nº 6894, de 16 de dezembro de 1980, que dispõe a inspeção e fiscalização da produção e do comércio de fertilizantes, corretivos, inoculantes, estimulantes ou biofertilizantes, destinados à agricultura, e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6934-1981-07-13.md"}}, {id:"federal:BR:L:6913/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-05-27", numero:"6913", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-05-27;6913", vigente:true, titulo:"Lei nº 6.913 de 27/05/1981", urn:"urn:lex:br:federal:lei:1981-05-27;6913", ementa:"Dá nova redação aos arts. 35 e 36 da Lei nº 5.700, de 1º de setembro de 1971, que dispõe sobre a forma e a apresentação dos símbolos nacionais.", arquivo:"federal/leis-ordinarias/1981/lei-6913-1981-05-27.md"}}, {id:"federal:BR:L:6962/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-07", numero:"6962", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-12-07;6962", vigente:true, titulo:"Lei nº 6.962 de 07/12/1981", urn:"urn:lex:br:federal:lei:1981-12-07;6962", ementa:"Estima a Receita e fixa a Despesa da União para o exercício financeiro de 1982.", arquivo:"federal/leis-ordinarias/1981/lei-6962-1981-12-07.md"}}, {id:"federal:BR:L:6973/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-14", numero:"6973", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-12-14;6973", vigente:true, titulo:"Lei nº 6.973 de 14/12/1981", urn:"urn:lex:br:federal:lei:1981-12-14;6973", ementa:"Estende ao pessoal dos Territórios Federais disposições que especifica,   referentes aos vencimentos e salários dos servidores civis do Poder   Executivo.", arquivo:"federal/leis-ordinarias/1981/lei-6973-1981-12-14.md"}}, {id:"federal:BR:L:6931/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-07-07", numero:"6931", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-07-07;6931", vigente:true, titulo:"Lei nº 6.931 de 07/07/1981", urn:"urn:lex:br:federal:lei:1981-07-07;6931", ementa:"Autoriza o Governo do Distrito Federal a contrair empréstimo com a Caixa   Econômica Federal e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6931-1981-07-07.md"}}, {id:"federal:BR:L:6919/1981", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-06-02", numero:"6919", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-06-02;6919", vigente:true, titulo:"Lei nº 6.919 de 02/06/1981", urn:"urn:lex:br:federal:lei:1981-06-02;6919", ementa:"Faculta a extensão do regime do Fundo de Garantia do Tempo de Serviço a diretores não empregados, e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6919-1981-06-02.md"}}, {id:"federal:BR:L:6922/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-06-17", numero:"6922", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-06-17;6922", vigente:true, titulo:"Lei nº 6.922 de 17/06/1981", urn:"urn:lex:br:federal:lei:1981-06-17;6922", ementa:"Cria cargos no Grupo-Polícia Federal, no Quadro Permanente do Departamento   de Polícia Federal do Ministério da Justiça.", arquivo:"federal/leis-ordinarias/1981/lei-6922-1981-06-17.md"}}, {id:"federal:BR:L:6968/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-09", numero:"6968", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-12-09;6968", vigente:true, titulo:"Lei nº 6.968 de 09/12/1981", urn:"urn:lex:br:federal:lei:1981-12-09;6968", ementa:"Prorroga prazo de vigência da Lei n. 5.755, de 3 de dezembro de 1971, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6968-1981-12-09.md"}}, {id:"federal:BR:L:6936/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-08-18", numero:"6936", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-08-18;6936", vigente:true, titulo:"Lei nº 6.936 de 18/08/1981", urn:"urn:lex:br:federal:lei:1981-08-18;6936", ementa:"Dispõe sobre a averbação, na esfera federal, de tempo de serviço público   estadual ou municipal.", arquivo:"federal/leis-ordinarias/1981/lei-6936-1981-08-18.md"}}, {id:"federal:BR:L:6901/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-04-14", numero:"6901", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-04-14;6901", vigente:true, titulo:"Lei nº 6.901 de 14/04/1981", urn:"urn:lex:br:federal:lei:1981-04-14;6901", ementa:"Torna obrigatório o uso de dístico, recomendando a eliminação das   embalagens de comercialização após sua utilização.", arquivo:"federal/leis-ordinarias/1981/lei-6901-1981-04-14.md"}}, {id:"federal:BR:L:6964/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-09", numero:"6964", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-12-09;6964", vigente:true, titulo:"Lei nº 6.964 de 09/12/1981", urn:"urn:lex:br:federal:lei:1981-12-09;6964", ementa:"Altera disposições da Lei nº 6.815, de 19 de agosto de 1980, que \"define a situação jurídica do estrangeiro no Brasil, cria o Conselho Nacional de Imigração, e dá outras providências\".", arquivo:"federal/leis-ordinarias/1981/lei-6964-1981-12-09.md"}}, {id:"federal:BR:L:6937/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-08-31", numero:"6937", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-08-31;6937", vigente:true, titulo:"Lei nº 6.937 de 31/08/1981", urn:"urn:lex:br:federal:lei:1981-08-31;6937", ementa:"Dispõe sobre isenção da multa prevista no art. 8º da Lei nº 4737, de 15 de   julho de 1965 - Código Eleitoral, estabelece critérios para distribuição dos   recursos do fundo partidário referentes aos exercícios de 1979 e 1980, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6937-1981-08-31.md"}}, {id:"federal:BR:L:6944/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-09-14", numero:"6944", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-09-14;6944", vigente:true, titulo:"Lei nº 6.944 de 14/09/1981", urn:"urn:lex:br:federal:lei:1981-09-14;6944", ementa:"Dispõe sobre o parcelamento especial de débitos no âmbito da Previdência e Assistência Social e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6944-1981-09-14.md"}}, {id:"federal:BR:L:6940/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-09-09", numero:"6940", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-09-09;6940", vigente:true, titulo:"Lei nº 6.940 de 09/09/1981", urn:"urn:lex:br:federal:lei:1981-09-09;6940", ementa:"Autoriza o Poder Executivo a abrir créditos adicionais até o limite de Cr$   342.394.500.000,00 ( trezentos e quarenta e dois bilhões, trezentos e noventa e   quatro milhões e quinhentos mil cruzeiros ) para os fins que   especifica.", arquivo:"federal/leis-ordinarias/1981/lei-6940-1981-09-09.md"}}, {id:"federal:BR:L:6898/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-03-30", numero:"6898", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-03-30;6898", vigente:true, titulo:"Lei nº 6.898 de 30/03/1981", urn:"urn:lex:br:federal:lei:1981-03-30;6898", ementa:"Altera o art. 242 do Decreto-Lei nº 2848, de 7 de dezembro de 1940 - Código Penal.", arquivo:"federal/leis-ordinarias/1981/lei-6898-1981-03-30.md"}}, {id:"federal:BR:L:6923/1981", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-06-29", numero:"6923", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-06-29;6923", vigente:true, titulo:"Lei nº 6.923 de 29/06/1981", urn:"urn:lex:br:federal:lei:1981-06-29;6923", ementa:"Dispõe sobre o Serviço de Assistência Religiosa nas Forças Armadas.", arquivo:"federal/leis-ordinarias/1981/lei-6923-1981-06-29.md"}}, {id:"federal:BR:L:6916/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-06-01", numero:"6916", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-06-01;6916", vigente:true, titulo:"Lei nº 6.916 de 01/06/1981", urn:"urn:lex:br:federal:lei:1981-06-01;6916", ementa:"Autoriza a reversão, à Caixa Econômica do Estado de São Paulo S/A, do   terreno que menciona.", arquivo:"federal/leis-ordinarias/1981/lei-6916-1981-06-01.md"}}, {id:"federal:BR:L:6951/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-11-06", numero:"6951", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-11-06;6951", vigente:true, titulo:"Lei nº 6.951 de 06/11/1981", urn:"urn:lex:br:federal:lei:1981-11-06;6951", ementa:"Autoriza o Poder Executivo a instituir a Fundação Universidade da   Fronteira Oeste do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1981/lei-6951-1981-11-06.md"}}, {id:"federal:BR:L:6954/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-11-18", numero:"6954", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-11-18;6954", vigente:true, titulo:"Lei nº 6.954 de 18/11/1981", urn:"urn:lex:br:federal:lei:1981-11-18;6954", ementa:"Dispõe sobre aproveitamento de pessoal na Universidade Federal de Juiz de   Fora.", arquivo:"federal/leis-ordinarias/1981/lei-6954-1981-11-18.md"}}, {id:"federal:BR:L:6942/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-09-14", numero:"6942", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-09-14;6942", vigente:true, titulo:"Lei nº 6.942 de 14/09/1981", urn:"urn:lex:br:federal:lei:1981-09-14;6942", ementa:"Autoriza o Poder Executivo a abrir à Justiça Federal de 1ª Instância o   crédito especial de Cr$ 10.500.000,00 (dez milhões e quinhentos mil cruzeiros)   para o fim que especifica.", arquivo:"federal/leis-ordinarias/1981/lei-6942-1981-09-14.md"}}, {id:"federal:BR:L:6975/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-14", numero:"6975", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-12-14;6975", vigente:true, titulo:"Lei nº 6.975 de 14/12/1981", urn:"urn:lex:br:federal:lei:1981-12-14;6975", ementa:"Autoriza o Senhor Presidente da República a conceder pensão   especial.", arquivo:"federal/leis-ordinarias/1981/lei-6975-1981-12-14.md"}}, {id:"federal:BR:L:6958/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-11-23", numero:"6958", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-11-23;6958", vigente:true, titulo:"Lei nº 6.958 de 23/11/1981", urn:"urn:lex:br:federal:lei:1981-11-23;6958", ementa:"Autoriza o Poder Executivo a abrir créditos adicionais até o limite de Cr$   3.621.201.000,00 ( três bilhões, seiscentos e vinte e um milhões e duzentos e um   mil cruzeiros ) e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6958-1981-11-23.md"}}, {id:"federal:BR:L:6896/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-03-30", numero:"6896", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-03-30;6896", vigente:true, titulo:"Lei nº 6.896 de 30/03/1981", urn:"urn:lex:br:federal:lei:1981-03-30;6896", ementa:"Dispõe sobre o provimento de cargos de Juiz de Direito dos Territórios,   nas condições que menciona, e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6896-1981-03-30.md"}}, {id:"federal:BR:L:6920/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-06-04", numero:"6920", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-06-04;6920", vigente:true, titulo:"Lei nº 6.920 de 04/06/1981", urn:"urn:lex:br:federal:lei:1981-06-04;6920", ementa:"Autoriza a reversão ao Município de Caicó, Estado do Rio Grande do Norte,   do terreno que menciona.", arquivo:"federal/leis-ordinarias/1981/lei-6920-1981-06-04.md"}}, {id:"federal:BR:L:6947/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-09-17", numero:"6947", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-09-17;6947", vigente:true, titulo:"Lei nº 6.947 de 17/09/1981", urn:"urn:lex:br:federal:lei:1981-09-17;6947", ementa:"Estabelece normas para criação e funcionamento de Juntas de Conciliação e   Julgamento e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6947-1981-09-17.md"}}, {id:"federal:BR:L:6966/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-09", numero:"6966", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-12-09;6966", vigente:true, titulo:"Lei nº 6.966 de 09/12/1981", urn:"urn:lex:br:federal:lei:1981-12-09;6966", ementa:"Autoriza o Poder Executivo a abrir ao Ministério da Educação e Cultura, em   favor da Empresa Brasileira de Filmes S.A., o crédito especial de Cr$   200.000.000,00 ( duzentos milhões de cruzeiros ), para fins que   especifica.", arquivo:"federal/leis-ordinarias/1981/lei-6966-1981-12-09.md"}}, {id:"federal:BR:L:6928/1981", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-07-07", numero:"6928", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-07-07;6928", vigente:true, titulo:"Lei nº 6.928 de 07/07/1981", urn:"urn:lex:br:federal:lei:1981-07-07;6928", ementa:"Cria a 12ª Região da Justiça do Trabalho, o Tribunal Regional do Trabalho respectivo, institui a correspondente Procuradoria Regional do Ministério Público da União junto à Justiça do Trabalho, e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6928-1981-07-07.md"}}, {id:"federal:BR:L:6925/1981", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-06-29", numero:"6925", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-06-29;6925", vigente:true, titulo:"Lei nº 6.925 de 29/06/1981", urn:"urn:lex:br:federal:lei:1981-06-29;6925", ementa:"Altera dispositivos do Decreto-Lei nº 1.414, de 18 de agosto de 1975, e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6925-1981-06-29.md"}}, {id:"federal:BR:L:6908/1981", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-05-21", numero:"6908", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-05-21;6908", vigente:true, titulo:"Lei nº 6.908 de 21/05/1981", urn:"urn:lex:br:federal:lei:1981-05-21;6908", ementa:"Reajusta os valores de vencimentos e proventos dos servidores ativos e inativos do Senado Federal e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6908-1981-05-21.md"}}, {id:"federal:BR:L:6921/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-06-16", numero:"6921", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-06-16;6921", vigente:true, titulo:"Lei nº 6.921 de 16/06/1981", urn:"urn:lex:br:federal:lei:1981-06-16;6921", ementa:"Autoriza ;a criação de municípios no Território Federal de Rondônia, altera   a Lei nº 6.448, de 11 de outubro de 1977, e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6921-1981-06-16.md"}}, {id:"federal:BR:L:6918/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-06-01", numero:"6918", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-06-01;6918", vigente:true, titulo:"Lei nº 6.918 de 01/06/1981", urn:"urn:lex:br:federal:lei:1981-06-01;6918", ementa:"Autoriza o Departamento Nacional de Obras Contras as Secas - DNOCS,   autarquia vinculada ao Ministério do Interior, a doar o imóvel que menciona,   situado no Município de Icó, Estado do Ceará, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1981/lei-6918-1981-06-01.md"}}, {id:"federal:BR:L:6971/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1981, data:"1981-12-14", numero:"6971", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1981-12-14;6971", vigente:true, titulo:"Lei nº 6.971 de 14/12/1981", urn:"urn:lex:br:federal:lei:1981-12-14;6971", ementa:"Dispõe sobre a administração do Território Federal de Fernando de Noronha   e dá outras providências.", arquivo:"federal/leis-ordinarias/1981/lei-6971-1981-12-14.md"}}, {id:"federal:BR:L:1204/1864", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1864, data:"1864-05-13", numero:"1204", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1864-05-13;1204", vigente:true, titulo:"Lei nº 1.204 de 13/05/1864", urn:"urn:lex:br:federal:lei:1864-05-13;1204", ementa:"FIXA A FORÇA NAVAL PARA O ANO FINANCEIRO DE 1864 - 1865.", arquivo:"federal/leis-ordinarias/1864/lei-1204-1864-05-13.md"}}, {id:"federal:BR:L:1237/1864", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1864, data:"1864-09-24", numero:"1237", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1864-09-24;1237", vigente:true, titulo:"Lei nº 1.237 de 24/09/1864", urn:"urn:lex:br:federal:lei:1864-09-24;1237", ementa:"REFORMA A LEGISLAÇÃO HYPOTHECARIA, E ESTABELECE AS BASES DA SOCIEDADE DE CRÉDITO REAL.", arquivo:"federal/leis-ordinarias/1864/lei-1237-1864-09-24.md"}}, {id:"federal:BR:L:1207/1864", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1864, data:"1864-05-25", numero:"1207", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1864-05-25;1207", vigente:true, titulo:"Lei nº 1.207 de 25/05/1864", urn:"urn:lex:br:federal:lei:1864-05-25;1207", ementa:"CONCEDE AO MINISTÉRIO DA MARINHA O CRÉDITO DE 750:000$000 PARA SER DISTRIBUÍDOS PELAS RUBRICAS - MATERIAL E OBRAS - DO EXERCÍCIO DE 1863 - 1864.", arquivo:"federal/leis-ordinarias/1864/lei-1207-1864-05-25.md"}}, {id:"federal:BR:L:1220/1864", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1864, data:"1864-07-20", numero:"1220", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1864-07-20;1220", vigente:true, titulo:"Lei nº 1.220 de 20/07/1864", urn:"urn:lex:br:federal:lei:1864-07-20;1220", ementa:"FIXA AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1864 A 1865.", arquivo:"federal/leis-ordinarias/1864/lei-1220-1864-07-20.md"}}, {id:"federal:BR:L:1217/1864", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1864, data:"1864-07-07", numero:"1217", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1864-07-07;1217", vigente:true, titulo:"Lei nº 1.217 de 07/07/1864", urn:"urn:lex:br:federal:lei:1864-07-07;1217", ementa:"ESTABELECE A DOTAÇÃO DE SUAS ALTEZAS IMPERIAIS, QUANDO HOUVE DE REALIZAR-SE O SEU CONSÓRCIO.", arquivo:"federal/leis-ordinarias/1864/lei-1217-1864-07-07.md"}}, {id:"federal:BR:L:1208/1864", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1864, data:"1864-05-27", numero:"1208", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1864-05-27;1208", vigente:true, titulo:"Lei nº 1.208 de 27/05/1864", urn:"urn:lex:br:federal:lei:1864-05-27;1208", ementa:"ABRE, AO MINISTÉRIO DA GUERRA, UM CRÉDITO SUPLEMENTAR PARA DESPESAS DO EXERCÍCIO DE 1863-1864.", arquivo:"federal/leis-ordinarias/1864/lei-1208-1864-05-27.md"}}, {id:"federal:BR:L:5792/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-07-11", numero:"5792", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-07-11;5792", vigente:true, titulo:"Lei nº 5.792 de 11/07/1972", urn:"urn:lex:br:federal:lei:1972-07-11;5792", ementa:"Institui política de exploração de serviços de telecomunicações, autoriza o Poder Executivo a constituir a empresa Telecomunicações Brasileiras S.A. - TELEBRÁS, e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5792-1972-07-11.md"}}, {id:"federal:BR:L:5803/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-09-25", numero:"5803", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-09-25;5803", vigente:true, titulo:"Lei nº 5.803 de 25/09/1972", urn:"urn:lex:br:federal:lei:1972-09-25;5803", ementa:"Extingue o cargo de Superintendente do Serviço Gráfico do Senado   Federal.", arquivo:"federal/leis-ordinarias/1972/lei-5803-1972-09-25.md"}}, {id:"federal:BR:L:5854/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-07", numero:"5854", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-07;5854", vigente:true, titulo:"Lei nº 5.854 de 07/12/1972", urn:"urn:lex:br:federal:lei:1972-12-07;5854", ementa:"Autoriza o Poder Executivo a abrir à Universidade Federal do Rio Grande do   Sul, o crédito especial de Cr$ 900.000,00 para o fim que   especifica.", arquivo:"federal/leis-ordinarias/1972/lei-5854-1972-12-07.md"}}, {id:"federal:BR:L:5867/1972", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-12", numero:"5867", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-12;5867", vigente:true, titulo:"Lei nº 5.867 de 12/12/1972", urn:"urn:lex:br:federal:lei:1972-12-12;5867", ementa:"Retifica, sem ônus, a Lei nº 5.754, de 3 de dezembro de 1971, que \"Estima a   Receita e fixa a Despesa da União para o exercício financeiro de 1972   \".", arquivo:"federal/leis-ordinarias/1972/lei-5867-1972-12-12.md"}}, {id:"federal:BR:L:5846/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-06", numero:"5846", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-06;5846", vigente:true, titulo:"Lei nº 5.846 de 06/12/1972", urn:"urn:lex:br:federal:lei:1972-12-06;5846", ementa:"Fixa os valores de vencimentos dos cargos do Grupo Diplomacia e dá outras   providências.", arquivo:"federal/leis-ordinarias/1972/lei-5846-1972-12-06.md"}}, {id:"federal:BR:L:5794/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-07-17", numero:"5794", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-07-17;5794", vigente:true, titulo:"Lei nº 5.794 de 17/07/1972", urn:"urn:lex:br:federal:lei:1972-07-17;5794", ementa:"Cria cargos nos Quadros de Pessoal da Justiça do Trabalho para o   funcionamento de 74 Juntas de Conciliação e Julgamento.", arquivo:"federal/leis-ordinarias/1972/lei-5794-1972-07-17.md"}}, {id:"federal:BR:L:5815/1972", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-10-31", numero:"5815", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-10-31;5815", vigente:true, titulo:"Lei nº 5.815 de 31/10/1972", urn:"urn:lex:br:federal:lei:1972-10-31;5815", ementa:"Prorroga o prazo de validade para as carteiras de identidade de estrangeiros \"modelo19\".", arquivo:"federal/leis-ordinarias/1972/lei-5815-1972-10-31.md"}}, {id:"federal:BR:L:5809/1972", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-10-10", numero:"5809", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-10-10;5809", vigente:true, titulo:"Lei nº 5.809 de 10/10/1972", urn:"urn:lex:br:federal:lei:1972-10-10;5809", ementa:"Dispõe sobre a retribuição e direitos do pessoal civil e militar em serviço da União no exterior, e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5809-1972-10-10.md"}}, {id:"federal:BR:L:5777/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-05-09", numero:"5777", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-05-09;5777", vigente:true, titulo:"Lei nº 5.777 de 09/05/1972", urn:"urn:lex:br:federal:lei:1972-05-09;5777", ementa:"Concede aumento de vencimentos aos funcinários da Secretaria da Câmara dos   Deputados e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5777-1972-05-09.md"}}, {id:"federal:BR:L:5860/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-11", numero:"5860", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-11;5860", vigente:true, titulo:"Lei nº 5.860 de 11/12/1972", urn:"urn:lex:br:federal:lei:1972-12-11;5860", ementa:"Autoriza a reversão do imóvel que menciona, situado em Goiânia, Estado de   Goiás, à Sociedade Goiana de Pecuária e Agricultura e dá outras   providências.", arquivo:"federal/leis-ordinarias/1972/lei-5860-1972-12-11.md"}}, {id:"federal:BR:L:5807/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-10-03", numero:"5807", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-10-03;5807", vigente:true, titulo:"Lei nº 5.807 de 03/10/1972", urn:"urn:lex:br:federal:lei:1972-10-03;5807", ementa:"Modifica o artigo 1º do Decreto-lei nº 954, de 13 de outubro de 1969, que   concede pensão especial ao pintor Homero Massena.", arquivo:"federal/leis-ordinarias/1972/lei-5807-1972-10-03.md"}}, {id:"federal:BR:L:5828/1972", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-11-29", numero:"5828", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-11-29;5828", vigente:true, titulo:"Lei nº 5.828 de 29/11/1972", urn:"urn:lex:br:federal:lei:1972-11-29;5828", ementa:"Reajusta o valor das gratificações concedidas ao Procurador-Geral e Procuradores Regionais da Justiça Eleitoral e aos Juízes e Escrivães Eleitorais.", arquivo:"federal/leis-ordinarias/1972/lei-5828-1972-11-29.md"}}, {id:"federal:BR:L:5849/1972", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-07", numero:"5849", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-07;5849", vigente:true, titulo:"Lei nº 5.849 de 07/12/1972", urn:"urn:lex:br:federal:lei:1972-12-07;5849", ementa:"Altera os Quadros de Pessoal da Secretaria do Superior Tribunal Militar e dos Cartórios das Auditorias da Justiça Militar e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5849-1972-12-07.md"}}, {id:"federal:BR:L:5785/1972", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-06-23", numero:"5785", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-06-23;5785", vigente:true, titulo:"Lei nº 5.785 de 23/06/1972", urn:"urn:lex:br:federal:lei:1972-06-23;5785", ementa:"Prorroga o prazo das concessões e permissões para a execução dos serviços de radiodifusão sonora que especifica e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5785-1972-06-23.md"}}, {id:"federal:BR:L:5834/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-05", numero:"5834", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-05;5834", vigente:true, titulo:"Lei nº 5.834 de 05/12/1972", urn:"urn:lex:br:federal:lei:1972-12-05;5834", ementa:"Institui incentivos para realização de trabalhos de geologia e engenharia   de minas e jazidas de minerais carentes e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5834-1972-12-05.md"}}, {id:"federal:BR:L:5863/1972", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-12", numero:"5863", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-12;5863", vigente:true, titulo:"Lei nº 5.863 de 12/12/1972", urn:"urn:lex:br:federal:lei:1972-12-12;5863", ementa:"Concede pensão especial a Maria da Penha da Silva.", arquivo:"federal/leis-ordinarias/1972/lei-5863-1972-12-12.md"}}, {id:"federal:BR:L:5789/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-06-27", numero:"5789", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-06-27;5789", vigente:true, titulo:"Lei nº 5.789 de 27/06/1972", urn:"urn:lex:br:federal:lei:1972-06-27;5789", ementa:"Dá nova redação ao artigo 6º do Decreto-lei nº 464, de 11 de fevereiro de   1969, que estabelece normas complementares à Lei nº 5.540, de 28 de novembro de   1968, e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5789-1972-06-27.md"}}, {id:"federal:BR:L:5811/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-10-11", numero:"5811", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-10-11;5811", vigente:true, titulo:"Lei nº 5.811 de 11/10/1972", urn:"urn:lex:br:federal:lei:1972-10-11;5811", ementa:"Dispõe sobre o regime de trabalho dos empregados nas atividades de   exploração, perfuração, produção e refinação de petróleo, industrialização do   xisto, indústria petroquímica e transporte de petróleo e seus derivados por meio   de dutos.", arquivo:"federal/leis-ordinarias/1972/lei-5811-1972-10-11.md"}}, {id:"federal:BR:L:5856/1972", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-07", numero:"5856", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-07;5856", vigente:true, titulo:"Lei nº 5.856 de 07/12/1972", urn:"urn:lex:br:federal:lei:1972-12-07;5856", ementa:"Prorroga o prazo de que trata o artigo 6º, da Lei nº 4.813, de 25 de outubro de 1965, alterado pelo Decreto-lei nº 447, de 3 de fevereiro de 1969, e pela Lei nº 5629, de 2 de dezembro de 1970.", arquivo:"federal/leis-ordinarias/1972/lei-5856-1972-12-07.md"}}, {id:"federal:BR:L:5790/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-07-06", numero:"5790", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-07-06;5790", vigente:true, titulo:"Lei nº 5.790 de 06/07/1972", urn:"urn:lex:br:federal:lei:1972-07-06;5790", ementa:"Modifica o artigo 1º da Lei nº 4.811, de 25 de outubro de 1965, que concede pensão mensal a Dona Maria Luíza Vitória Rui Barbosa Guerra.", arquivo:"federal/leis-ordinarias/1972/lei-5790-1972-07-06.md"}}, {id:"federal:BR:L:5824/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-11-14", numero:"5824", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-11-14;5824", vigente:true, titulo:"Lei nº 5.824 de 14/11/1972", urn:"urn:lex:br:federal:lei:1972-11-14;5824", ementa:"Dispõe sobre empréstimo compulsório, em favor da Centrais Elétricas Brasileiras S.A. - ELETROBRÁS.", arquivo:"federal/leis-ordinarias/1972/lei-5824-1972-11-14.md"}}, {id:"federal:BR:L:5802/1972", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-09-11", numero:"5802", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-09-11;5802", vigente:true, titulo:"Lei nº 5.802 de 11/09/1972", urn:"urn:lex:br:federal:lei:1972-09-11;5802", ementa:"Dispõe sobre a inscrição em prova de habilitação à livre-docência.", arquivo:"federal/leis-ordinarias/1972/lei-5802-1972-09-11.md"}}, {id:"federal:BR:L:5861/1972", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-12", numero:"5861", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-12;5861", vigente:true, titulo:"Lei nº 5.861 de 12/12/1972", urn:"urn:lex:br:federal:lei:1972-12-12;5861", ementa:"Autoriza o desmembramento da Companhia Urbanizadora da Nova Capital do Brasil - NOVACAP, mediante alteração de seu objeto e constituição da Companhia Imobiliária de Brasília - TERRACAP, e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5861-1972-12-12.md"}}, {id:"federal:BR:L:5799/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-08-31", numero:"5799", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-08-31;5799", vigente:true, titulo:"Lei nº 5.799 de 31/08/1972", urn:"urn:lex:br:federal:lei:1972-08-31;5799", ementa:"Dispõe sobre a isenção do imposto sobre produtos industrializados na   aquisição de veículos automotores de fabricação nacional.", arquivo:"federal/leis-ordinarias/1972/lei-5799-1972-08-31.md"}}, {id:"federal:BR:L:5787/1972", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-06-27", numero:"5787", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-06-27;5787", vigente:true, titulo:"Lei nº 5.787 de 27/06/1972", urn:"urn:lex:br:federal:lei:1972-06-27;5787", ementa:"Dispõe sobre ;a remuneração dos militares e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5787-1972-06-27.md"}}, {id:"federal:BR:L:5813/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-10-13", numero:"5813", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-10-13;5813", vigente:true, titulo:"Lei nº 5.813 de 13/10/1972", urn:"urn:lex:br:federal:lei:1972-10-13;5813", ementa:"Autoriza a Comissão de Financiamento da Produção a alienar o imóvel que   especifica, e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5813-1972-10-13.md"}}, {id:"federal:BR:L:5805/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-10-03", numero:"5805", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-10-03;5805", vigente:true, titulo:"Lei nº 5.805 de 03/10/1972", urn:"urn:lex:br:federal:lei:1972-10-03;5805", ementa:"Estabelece normas destinadas a preservar a autenticidade das obras   literárias caídas em domínio público.", arquivo:"federal/leis-ordinarias/1972/lei-5805-1972-10-03.md"}}, {id:"federal:BR:L:5852/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-07", numero:"5852", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-07;5852", vigente:true, titulo:"Lei nº 5.852 de 07/12/1972", urn:"urn:lex:br:federal:lei:1972-12-07;5852", ementa:"Autoriza o Poder Executivo a abrir a Encargos Gerais da União - Recursos   sob Supervisão do Ministério da Fazenda o crédito especial de Cr$ 2.605.000,00 (   dois milhões, seiscentos e cinco mil cruzeiros ), para o fim que   especifica.", arquivo:"federal/leis-ordinarias/1972/lei-5852-1972-12-07.md"}}, {id:"federal:BR:L:5836/1972", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-05", numero:"5836", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-05;5836", vigente:true, titulo:"Lei nº 5.836 de 05/12/1972", urn:"urn:lex:br:federal:lei:1972-12-05;5836", ementa:"Dispõe sobre o Conselho de Justificação e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5836-1972-12-05.md"}}, {id:"federal:BR:L:5865/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-12", numero:"5865", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-12;5865", vigente:true, titulo:"Lei nº 5.865 de 12/12/1972", urn:"urn:lex:br:federal:lei:1972-12-12;5865", ementa:"Estima a receita e fixa a despesa do Distrito Federal para o exercício financeiro de 1973.", arquivo:"federal/leis-ordinarias/1972/lei-5865-1972-12-12.md"}}, {id:"federal:BR:L:5818/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-11-06", numero:"5818", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-11-06;5818", vigente:true, titulo:"Lei nº 5.818 de 06/11/1972", urn:"urn:lex:br:federal:lei:1972-11-06;5818", ementa:"Autoriza o Poder Executivo a abrir crédito suplementar em reforço de   dotação que especifica, constante do Orçamento Geral da União para o exercício   financeiro de 1972, e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5818-1972-11-06.md"}}, {id:"federal:BR:L:5793/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-07-11", numero:"5793", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-07-11;5793", vigente:true, titulo:"Lei nº 5.793 de 11/07/1972", urn:"urn:lex:br:federal:lei:1972-07-11;5793", ementa:"Concede pensão especial, vitalícia e intransferível, a Luiz Fernando Cassal   Rodrigues.", arquivo:"federal/leis-ordinarias/1972/lei-5793-1972-07-11.md"}}, {id:"federal:BR:L:5810/1972", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-10-11", numero:"5810", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-10-11;5810", vigente:true, titulo:"Lei nº 5.810 de 11/10/1972", urn:"urn:lex:br:federal:lei:1972-10-11;5810", ementa:"Dispõe sobre transformação de cargos em comissão e funções gratificadas no Quadro de Pessoal da Secretaria da Câmara dos Deputados e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5810-1972-10-11.md"}}, {id:"federal:BR:L:5868/1972", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-12", numero:"5868", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-12;5868", vigente:true, titulo:"Lei nº 5.868 de 12/12/1972", urn:"urn:lex:br:federal:lei:1972-12-12;5868", ementa:"Cria o Sistema Nacional de Cadastro Rural e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5868-1972-12-12.md"}}, {id:"federal:BR:L:5847/1972", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-06", numero:"5847", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-06;5847", vigente:true, titulo:"Lei nº 5.847 de 06/12/1972", urn:"urn:lex:br:federal:lei:1972-12-06;5847", ementa:"Estima a Receita e Fixa a Despesa da União para o Exercício Financeiro de 1973.", arquivo:"federal/leis-ordinarias/1972/lei-5847-1972-12-06.md"}}, {id:"federal:BR:L:5855/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-07", numero:"5855", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-07;5855", vigente:true, titulo:"Lei nº 5.855 de 07/12/1972", urn:"urn:lex:br:federal:lei:1972-12-07;5855", ementa:"Dá nova redação ao artigo 10, da Lei nº 4.024, de 20 de dezembro de 1961, que fixa as Diretrizes e Bases da Educação Nacional.", arquivo:"federal/leis-ordinarias/1972/lei-5855-1972-12-07.md"}}, {id:"federal:BR:L:5839/1972", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-05", numero:"5839", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-05;5839", vigente:true, titulo:"Lei nº 5.839 de 05/12/1972", urn:"urn:lex:br:federal:lei:1972-12-05;5839", ementa:"Dá nova redação ao art. 674 da Consolidação das Leis do Trabalho, aprovada pelo Decreto-lei nº 5.452, de 1º de maio de 1943.", arquivo:"federal/leis-ordinarias/1972/lei-5839-1972-12-05.md"}}, {id:"federal:BR:L:5798/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-08-31", numero:"5798", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-08-31;5798", vigente:true, titulo:"Lei nº 5.798 de 31/08/1972", urn:"urn:lex:br:federal:lei:1972-08-31;5798", ementa:"Acrescenta § 4º ao art. 461 da Consolidação das Leis do Trabalho, aprovada   pelo Decreto-lei nº 5.452, de 1º de maio de 1943.", arquivo:"federal/leis-ordinarias/1972/lei-5798-1972-08-31.md"}}, {id:"federal:BR:L:5801/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-09-11", numero:"5801", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-09-11;5801", vigente:true, titulo:"Lei nº 5.801 de 11/09/1972", urn:"urn:lex:br:federal:lei:1972-09-11;5801", ementa:"Acrescenta parágrafo ao art. 131 da Consolidação das Leis do Trabalho, aprovada pelo Decreto-lei nº 5452, de 1º de maio de 1943.", arquivo:"federal/leis-ordinarias/1972/lei-5801-1972-09-11.md"}}, {id:"federal:BR:L:5795/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-07-17", numero:"5795", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-07-17;5795", vigente:true, titulo:"Lei nº 5.795 de 17/07/1972", urn:"urn:lex:br:federal:lei:1972-07-17;5795", ementa:"Retifica o Anexo II, do Quadro de Pessoal - Pessoal Permanente, da Lei nº 5.188, de 8 de dezembro de 1966, que institui o Quadro de Pessoal do Ministério da Minas e Energia e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5795-1972-07-17.md"}}, {id:"federal:BR:L:5816/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-10-31", numero:"5816", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-10-31;5816", vigente:true, titulo:"Lei nº 5.816 de 31/10/1972", urn:"urn:lex:br:federal:lei:1972-10-31;5816", ementa:"Autoriza o Instituto do Açúcar e do Álcool a alienar as Destilarias   Centrais, de Pernambuco, Alagoas, Bahia, Rio de janeiro e Minas Gerais, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5816-1972-10-31.md"}}, {id:"federal:BR:L:5808/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-10-03", numero:"5808", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-10-03;5808", vigente:true, titulo:"Lei nº 5.808 de 03/10/1972", urn:"urn:lex:br:federal:lei:1972-10-03;5808", ementa:"Autoriza o Poder Executivo a doar 5.000 (cinco mil) sacas de café dos   estoques governamentais, como contribuição do Brasil ao Programa Mundial de   Alimentos (PMA), da Organização das Nações Unidas (ONU) e da Organização das   Nações Unidas para Alimentação e Agricultura (FAO), relativa ao período de   1973/1974.", arquivo:"federal/leis-ordinarias/1972/lei-5808-1972-10-03.md"}}, {id:"federal:BR:L:5840/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-05", numero:"5840", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-05;5840", vigente:true, titulo:"Lei nº 5.840 de 05/12/1972", urn:"urn:lex:br:federal:lei:1972-12-05;5840", ementa:"Dispõe sobre a jurisdição de Juntas de Conciliação e Julgamento da 5ª   Região da Justiça do Trabalho.", arquivo:"federal/leis-ordinarias/1972/lei-5840-1972-12-05.md"}}, {id:"federal:BR:L:5783/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-06-08", numero:"5783", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-06-08;5783", vigente:true, titulo:"Lei nº 5.783 de 08/06/1972", urn:"urn:lex:br:federal:lei:1972-06-08;5783", ementa:"Altera a redação de dispositivos da Lei nº 5.020, de 07 de junho de 1966,   que dispõe sobre as promoções dos Oficiais da Ativa da Aeronáutica, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1972/lei-5783-1972-06-08.md"}}, {id:"federal:BR:L:5812/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-10-13", numero:"5812", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-10-13;5812", vigente:true, titulo:"Lei nº 5.812 de 13/10/1972", urn:"urn:lex:br:federal:lei:1972-10-13;5812", ementa:"Modifica os incisos IV do artigo 13 e III do artigo 18 da Lei nº 5.700, de   1º de setembro de 1971, que dispõe sobre a forma e a apresentação dos Símbolos   Nacionais e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5812-1972-10-13.md"}}, {id:"federal:BR:L:5796/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-07-21", numero:"5796", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-07-21;5796", vigente:true, titulo:"Lei nº 5.796 de 21/07/1972", urn:"urn:lex:br:federal:lei:1972-07-21;5796", ementa:"Retifica, sem ônus, a Lei nº 5.628, de 1º de dezembro de 1970, que \"estima   a Receita e fixa a Despesa da União para o exercício financeiro de   1971\".", arquivo:"federal/leis-ordinarias/1972/lei-5796-1972-07-21.md"}}, {id:"federal:BR:L:5804/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-10-03", numero:"5804", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-10-03;5804", vigente:true, titulo:"Lei nº 5.804 de 03/10/1972", urn:"urn:lex:br:federal:lei:1972-10-03;5804", ementa:"Dá nova redação ao artigo 6º, do Decreto-lei nº 161, de 13 de fevereiro de 1967, que autorizou o Poder Executivo a instituir a Fundação Instituto Brasileiro de Geografia e Estatística, e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5804-1972-10-03.md"}}, {id:"federal:BR:L:5830/1972", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-11-30", numero:"5830", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-11-30;5830", vigente:true, titulo:"Lei nº 5.830 de 30/11/1972", urn:"urn:lex:br:federal:lei:1972-11-30;5830", ementa:"Dispõe sobre a carreira de Procurador da Fazenda Nacional e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5830-1972-11-30.md"}}, {id:"federal:BR:L:5797/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-08-10", numero:"5797", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-08-10;5797", vigente:true, titulo:"Lei nº 5.797 de 10/08/1972", urn:"urn:lex:br:federal:lei:1972-08-10;5797", ementa:"Cria pensão especial por morte de servidor vítima de agressão em função   policial ou de segurança.", arquivo:"federal/leis-ordinarias/1972/lei-5797-1972-08-10.md"}}, {id:"federal:BR:L:5864/1972", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-12", numero:"5864", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-12;5864", vigente:true, titulo:"Lei nº 5.864 de 12/12/1972", urn:"urn:lex:br:federal:lei:1972-12-12;5864", ementa:"Dá nova redação ao artigo 4º da Lei nº 5.768, de 20 de dezembro de 1971, que altera a legislação sobre distribuição gratuita de prêmios, mediante sorteio, vale-brinde ou concurso, a título de propaganda, estabelece normas de proteção à poupança popular e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5864-1972-12-12.md"}}, {id:"federal:BR:L:5843/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-06", numero:"5843", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-06;5843", vigente:true, titulo:"Lei nº 5.843 de 06/12/1972", urn:"urn:lex:br:federal:lei:1972-12-06;5843", ementa:"Fixa os valores de vencimento dos cargos do Grupo-Direção e Assessoramento   Superiores do Serviço Civil da União e das autarquias federais e dá outras   providências.", arquivo:"federal/leis-ordinarias/1972/lei-5843-1972-12-06.md"}}, {id:"federal:BR:L:5851/1972", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-07", numero:"5851", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-07;5851", vigente:true, titulo:"Lei nº 5.851 de 07/12/1972", urn:"urn:lex:br:federal:lei:1972-12-07;5851", ementa:"Autoriza o Poder Executivo a instituir empresa pública, sob a denominação de Empresa Brasileira de Pesquisa Agropecuária (EMBRAPA) e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5851-1972-12-07.md"}}, {id:"federal:BR:L:5829/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-11-30", numero:"5829", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-11-30;5829", vigente:true, titulo:"Lei nº 5.829 de 30/11/1972", urn:"urn:lex:br:federal:lei:1972-11-30;5829", ementa:"Cria o Instituto Nacional de Alimentação e Nutrição (INAN) e dá outras   providências.", arquivo:"federal/leis-ordinarias/1972/lei-5829-1972-11-30.md"}}, {id:"federal:BR:L:5835/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-05", numero:"5835", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-05;5835", vigente:true, titulo:"Lei nº 5.835 de 05/12/1972", urn:"urn:lex:br:federal:lei:1972-12-05;5835", ementa:"Autoriza o Instituto Brasileiro do Café a ceder área de terra que menciona   ao Estado de São Paulo, para uso da Faculdade de Ciências Médicas e Biológicas   de Botucatu, e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5835-1972-12-05.md"}}, {id:"federal:BR:L:5817/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-11-06", numero:"5817", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-11-06;5817", vigente:true, titulo:"Lei nº 5.817 de 06/11/1972", urn:"urn:lex:br:federal:lei:1972-11-06;5817", ementa:"Regula a indicação de candidatos a cargos eletivos onde as convenções partidárias não a fizeram e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5817-1972-11-06.md"}}, {id:"federal:BR:L:5827/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-11-23", numero:"5827", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-11-23;5827", vigente:true, titulo:"Lei nº 5.827 de 23/11/1972", urn:"urn:lex:br:federal:lei:1972-11-23;5827", ementa:"Dá nova redação ao artigo 693 do Código Civil.", arquivo:"federal/leis-ordinarias/1972/lei-5827-1972-11-23.md"}}, {id:"federal:BR:L:5848/1972", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-07", numero:"5848", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-07;5848", vigente:true, titulo:"Lei nº 5.848 de 07/12/1972", urn:"urn:lex:br:federal:lei:1972-12-07;5848", ementa:"Altera os artigos 24, 36 e 37 do Decreto-lei nº 43, de 18 de novembro   de 1966, que \"cria o Instituto Nacional do Cinema, torna da exclusiva competência   da União a censura de filmes, estende aos pagamentos do exterior de filmes   adquiridos a preços fixos o disposto no art. 45 da Lei nº 4.131, de 3 de setembro   de 1962, prorroga por 6 (seis) meses dispositivos de legislação sobre a exibição   de filmes nacionais e dá outras providências.\"", arquivo:"federal/leis-ordinarias/1972/lei-5848-1972-12-07.md"}}, {id:"federal:BR:L:5784/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-06-14", numero:"5784", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-06-14;5784", vigente:true, titulo:"Lei nº 5.784 de 14/06/1972", urn:"urn:lex:br:federal:lei:1972-06-14;5784", ementa:"Reduz o prazo para o registro de chapas de candidatos a membros de   Diretórios Municipais no ano de 1972, fixa normas para escolha de candidatos nas   eleições de 15 de novembro do mesmo ano e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5784-1972-06-14.md"}}, {id:"federal:BR:L:5821/1972", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-11-10", numero:"5821", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-11-10;5821", vigente:true, titulo:"Lei nº 5.821 de 10/11/1972", urn:"urn:lex:br:federal:lei:1972-11-10;5821", ementa:"Dispõe sobre as promoções dos oficiais da ativa das Forças Armadas e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5821-1972-11-10.md"}}, {id:"federal:BR:L:5791/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-07-06", numero:"5791", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-07-06;5791", vigente:true, titulo:"Lei nº 5.791 de 06/07/1972", urn:"urn:lex:br:federal:lei:1972-07-06;5791", ementa:"Revigora até 31 de dezembro de 1974 o prazo a que se refere a Lei nº   4.331, de 1 de junho de 1964 - alterada pelo Decreto-lei nº 607, de 3 de junho   de 1969 - que dispõe sobre a aquisição, por Governos estrangeiros, no Distrito   Federal de imóveis necessários à residência dos agentes diplomáticos das   respectivas Missões Diplomáticas.", arquivo:"federal/leis-ordinarias/1972/lei-5791-1972-07-06.md"}}, {id:"federal:BR:L:5862/1972", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-12", numero:"5862", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-12;5862", vigente:true, titulo:"Lei nº 5.862 de 12/12/1972", urn:"urn:lex:br:federal:lei:1972-12-12;5862", ementa:"Autoriza o Poder Executivo a constituir a empresa pública denominada Empresa Brasileira de Infra-Estrutura Aeroportuária - INFRAERO, e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5862-1972-12-12.md"}}, {id:"federal:BR:L:5825/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-11-14", numero:"5825", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-11-14;5825", vigente:true, titulo:"Lei nº 5.825 de 14/11/1972", urn:"urn:lex:br:federal:lei:1972-11-14;5825", ementa:"Autoriza o Instituto Brasileiro de Desenvolvimento Florestal - IBDF - a   alienar imóveis que menciona.", arquivo:"federal/leis-ordinarias/1972/lei-5825-1972-11-14.md"}}, {id:"federal:BR:L:5826/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-11-22", numero:"5826", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-11-22;5826", vigente:true, titulo:"Lei nº 5.826 de 22/11/1972", urn:"urn:lex:br:federal:lei:1972-11-22;5826", ementa:"Dá nova redação ao artigo 5º da Lei nº 5.775, de 27 de dezembro de 1971,   que estima a Receita e fixa a Despesa do Distrito Federal para o Exercício de   1972.", arquivo:"federal/leis-ordinarias/1972/lei-5826-1972-11-22.md"}}, {id:"federal:BR:L:5788/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-06-27", numero:"5788", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-06-27;5788", vigente:true, titulo:"Lei nº 5.788 de 27/06/1972", urn:"urn:lex:br:federal:lei:1972-06-27;5788", ementa:"Extingue a garantia de instância a que se refere o art. 259 da Lei nº   4191, de 24 de dezembro de 1962, para a interposição de recurso voluntário no   processo administrativo fiscal do Distrito Federal.", arquivo:"federal/leis-ordinarias/1972/lei-5788-1972-06-27.md"}}, {id:"federal:BR:L:5776/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-05-09", numero:"5776", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-05-09;5776", vigente:true, titulo:"Lei nº 5.776 de 09/05/1972", urn:"urn:lex:br:federal:lei:1972-05-09;5776", ementa:"Concede aumento de vencimentos aos servidores do Senado Federal e dá   outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5776-1972-05-09.md"}}, {id:"federal:BR:L:5800/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-09-01", numero:"5800", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-09-01;5800", vigente:true, titulo:"Lei nº 5.800 de 01/09/1972", urn:"urn:lex:br:federal:lei:1972-09-01;5800", ementa:"Revoga os §§ 1º e 2º do artigo 6º e o parágrafo único do artigo 19 da Lei   nº 4.878, de 3 de dezembro de 1965, que dispõe sobre o regime jurídico peculiar   aos funcionários policiais civis da União e do Distrito Federal.", arquivo:"federal/leis-ordinarias/1972/lei-5800-1972-09-01.md"}}, {id:"federal:BR:L:5833/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-01", numero:"5833", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-01;5833", vigente:true, titulo:"Lei nº 5.833 de 01/12/1972", urn:"urn:lex:br:federal:lei:1972-12-01;5833", ementa:"Institui, no Ministério das Minas e Energia, o Plano de Formação e   Aperfeiçoamento do Pessoal de Nível Superior - PLANFAP, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1972/lei-5833-1972-12-01.md"}}, {id:"federal:BR:L:5814/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-10-31", numero:"5814", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-10-31;5814", vigente:true, titulo:"Lei nº 5.814 de 31/10/1972", urn:"urn:lex:br:federal:lei:1972-10-31;5814", ementa:"Autoriza o Poder Executivo a abrir à Presidência da República, em favor   da Agência Nacional, o crédito especial de Cr$ 475.000,00 (quatrocentos e setenta   e cinco mil cruzeiros), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1972/lei-5814-1972-10-31.md"}}, {id:"federal:BR:L:5822/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-11-13", numero:"5822", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-11-13;5822", vigente:true, titulo:"Lei nº 5.822 de 13/11/1972", urn:"urn:lex:br:federal:lei:1972-11-13;5822", ementa:"Dispõe sobre o apostilamento de títulos e os proventos dos antigos ocupantes   de cargos que correspondiam aos de Coletor Federal, Escrivão de Coletoria   e Auxiliar de Coletoria, aposentados com mais de 30 (trinta) anos de   serviço.", arquivo:"federal/leis-ordinarias/1972/lei-5822-1972-11-13.md"}}, {id:"federal:BR:L:5806/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-10-03", numero:"5806", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-10-03;5806", vigente:true, titulo:"Lei nº 5.806 de 03/10/1972", urn:"urn:lex:br:federal:lei:1972-10-03;5806", ementa:"Concede pensão especial à Senhora Maria Câmara de Souza Costa, viúva do   ex-Ministro da Fazenda Artur de Souza Costa.", arquivo:"federal/leis-ordinarias/1972/lei-5806-1972-10-03.md"}}, {id:"federal:BR:L:5778/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-05-16", numero:"5778", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-05-16;5778", vigente:true, titulo:"Lei nº 5.778 de 16/05/1972", urn:"urn:lex:br:federal:lei:1972-05-16;5778", ementa:"Dispõe sobre o processo e julgamento das representações de que trata a   alínea \"d\" do § 3º do artigo 15 da Constituição Federal e dá outras   providências.", arquivo:"federal/leis-ordinarias/1972/lei-5778-1972-05-16.md"}}, {id:"federal:BR:L:5845/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-06", numero:"5845", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-06;5845", vigente:true, titulo:"Lei nº 5.845 de 06/12/1972", urn:"urn:lex:br:federal:lei:1972-12-06;5845", ementa:"Fixa os valores de vencimentos dos cargos do Grupo-Serviços Auxiliares do Serviço Civil da União e das autarquias federais e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5845-1972-12-06.md"}}, {id:"federal:BR:L:5780/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-06-05", numero:"5780", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-06-05;5780", vigente:true, titulo:"Lei nº 5.780 de 05/06/1972", urn:"urn:lex:br:federal:lei:1972-06-05;5780", ementa:"Dispõe sobre a dispensa da multa prevista pelo artigo 8º do Código   Eleitoral (Lei nº 4.737, de 1965)", arquivo:"federal/leis-ordinarias/1972/lei-5780-1972-06-05.md"}}, {id:"federal:BR:L:5837/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-05", numero:"5837", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-05;5837", vigente:true, titulo:"Lei nº 5.837 de 05/12/1972", urn:"urn:lex:br:federal:lei:1972-12-05;5837", ementa:"Concede pensão especial ao Inventor Demerval Neves   Rodrigues.", arquivo:"federal/leis-ordinarias/1972/lei-5837-1972-12-05.md"}}, {id:"federal:BR:L:5858/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-11", numero:"5858", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-11;5858", vigente:true, titulo:"Lei nº 5.858 de 11/12/1972", urn:"urn:lex:br:federal:lei:1972-12-11;5858", ementa:"Dá nova redação ao artigo 6º, do Decreto-lei nº 67, de 21 de novembro de 1966, que dispõe sobre os bens e pessoal vinculado aos serviços de navegação e de reparos navais explorados pelo Lloyd Brasileiro - Patrimônio Nacional e pela Companhia Nacional de Navegação Costeira - Autarquia Federal, extingue estas autarquias, autoriza a constituição da Companhia de Navegação Lloyd Brasileiro e da Empresa de Reparos Navais \"Costeira\" S.A. e dá outras providências.", arquivo:"federal/leis-ordinarias/1972/lei-5858-1972-12-11.md"}}, {id:"federal:BR:L:5853/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-12-07", numero:"5853", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-12-07;5853", vigente:true, titulo:"Lei nº 5.853 de 07/12/1972", urn:"urn:lex:br:federal:lei:1972-12-07;5853", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento Geral da   União, em Encargos Gerais da União - Recursos sob Supervisão do Ministério da   Fazenda, o crédito especial de Cr$ 6.640.000,00 (seis milhões, seiscentos e quarenta   mil cruzeiros), para fins que especifica.", arquivo:"federal/leis-ordinarias/1972/lei-5853-1972-12-07.md"}}, {id:"federal:BR:L:5819/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1972, data:"1972-11-06", numero:"5819", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1972-11-06;5819", vigente:true, titulo:"Lei nº 5.819 de 06/11/1972", urn:"urn:lex:br:federal:lei:1972-11-06;5819", ementa:"Dá nova redação ao artigo 576, da Consolidação das Leis do Trabalho, aprovada pelo Decreto-lei nº 5.452, de 1º de maio de 1943.", arquivo:"federal/leis-ordinarias/1972/lei-5819-1972-11-06.md"}}, {id:"federal:BR:L:2/1891", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1891, data:"1891-08-08", numero:"2", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1891-08-08;2", vigente:true, titulo:"Lei nº 2 de 08/08/1891", urn:"urn:lex:br:federal:lei:1891-08-08;2", ementa:"Providencia sobre creditos supplementares ás verbas   -Subsidios dos senadores e dos deputados- e secretarias do Senado e da Camara   dos Deputados, do exercicio de 1891.", arquivo:"federal/leis-ordinarias/1891/lei-2-1891-08-08.md"}}, {id:"federal:BR:L:21/1891", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1891, data:"1891-10-24", numero:"21", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1891-10-24;21", vigente:true, titulo:"Lei nº 21 de 24/10/1891", urn:"urn:lex:br:federal:lei:1891-10-24;21", ementa:"Manda que continuem em vigor as disposições do decreto   n.3163 de 7 de julho de 1883.", arquivo:"federal/leis-ordinarias/1891/lei-21-1891-10-24.md"}}, {id:"federal:BR:L:26/1891", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1891, data:"1891-12-30", numero:"26", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1891-12-30;26", vigente:true, titulo:"Lei nº 26 de 30/12/1891", urn:"urn:lex:br:federal:lei:1891-12-30;26", ementa:"Fixa despeza geral da Republica dos Estados Unidos do   Brazil para o exercicio de 1892, e da outras providencias.", arquivo:"federal/leis-ordinarias/1891/lei-26-1891-12-30.md"}}, {id:"federal:BR:L:23/1891", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1891, data:"1891-10-30", numero:"23", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1891-10-30;23", vigente:true, titulo:"Lei nº 23 de 30/10/1891", urn:"urn:lex:br:federal:lei:1891-10-30;23", ementa:"Reorganiza os serviços da Administração   Federal.", arquivo:"federal/leis-ordinarias/1891/lei-23-1891-10-30.md"}}, {id:"federal:BR:L:9/1891", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1891, data:"1891-09-12", numero:"9", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1891-09-12;9", vigente:true, titulo:"Lei nº 9 de 12/09/1891", urn:"urn:lex:br:federal:lei:1891-09-12;9", ementa:"Fixa os subsidios do Presidente e Vice-Presidente da   Republica para o periodo de 15 de novembro de 1894 a 15 de novembro de 1893 e   autoriza a abertura de credito para pagamento do subsidio do Vice-Presidente, no   corrente exercício.", arquivo:"federal/leis-ordinarias/1891/lei-9-1891-09-12.md"}}, {id:"federal:BR:L:25/1891", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1891, data:"1891-12-30", numero:"25", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1891-12-30;25", vigente:true, titulo:"Lei nº 25 de 30/12/1891", urn:"urn:lex:br:federal:lei:1891-12-30;25", ementa:"Orça a receita geral da Republica dos Estados Unidos do Brazil   para o exerciciode 1892, e da outras providencias.", arquivo:"federal/leis-ordinarias/1891/lei-25-1891-12-30.md"}}, {id:"federal:BR:L:14/1891", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1891, data:"1891-10-16", numero:"14", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1891-10-16;14-a", vigente:true, titulo:"Lei nº 14-A de 16/10/1891", urn:"urn:lex:br:federal:lei:1891-10-16;14-a", ementa:"Approva o accordo feito entre o Brazil e o Perú sobre a   execução de cartas rogatórias.", arquivo:"federal/leis-ordinarias/1891/lei-14-a-1891-10-16.md"}}, {id:"federal:BR:L:20/1891", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1891, data:"1891-10-22", numero:"20", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1891-10-22;20", vigente:true, titulo:"Lei nº 20 de 22/10/1891", urn:"urn:lex:br:federal:lei:1891-10-22;20", ementa:"Fixa em 120:000$ annuaes a pensão a que tem direito D.   Pedro de Alcantara, ex-Imperador do Brazil.", arquivo:"federal/leis-ordinarias/1891/lei-20-1891-10-22.md"}}, {id:"federal:BR:L:205/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-05-22", numero:"205", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-05-22;205", vigente:true, titulo:"Lei nº 205 de 22/05/1936", urn:"urn:lex:br:federal:lei:1936-05-22;205", ementa:"Autoriza o Poder Executivo a abrir o credito especial de réis 1.877:962$300, pelo Ministerio da Viação para ultimar a execução de obras com a installação de estações de radio.", arquivo:"federal/leis-ordinarias/1936/lei-205-1936-05-22.md"}}, {id:"federal:BR:L:166/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-01-02", numero:"166", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-01-02;166", vigente:true, titulo:"Lei nº 166 de 02/01/1936", urn:"urn:lex:br:federal:lei:1936-01-02;166", ementa:"Abre o credito especial de 8:037$530, pelo Ministério da Justiça, para pagar a gratificação de exercício devida ao Dr. Otávio Kelly", arquivo:"federal/leis-ordinarias/1936/lei-166-1936-01-02.md"}}, {id:"federal:BR:L:230/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-07-31", numero:"230", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-07-31;230", vigente:true, titulo:"Lei nº 230 de 31/07/1936", urn:"urn:lex:br:federal:lei:1936-07-31;230", ementa:"Providencia sobre a organização dos archivos eleitorais   e registro de obito de eleitores.", arquivo:"federal/leis-ordinarias/1936/lei-230-1936-07-31.md"}}, {id:"federal:BR:L:282/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-10-21", numero:"282", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-10-21;282", vigente:true, titulo:"Lei nº 282 de 21/10/1936", urn:"urn:lex:br:federal:lei:1936-10-21;282", ementa:"Autoriza o Poder Executivo a ceder á Prefeitura do Distrito Federal um terreno pertencente á Estrada de Ferro Central do Brasil", arquivo:"federal/leis-ordinarias/1936/lei-282-1936-10-21.md"}}, {id:"federal:BR:L:212/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-06-05", numero:"212", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-06-05;212", vigente:true, titulo:"Lei nº 212 de 05/06/1936", urn:"urn:lex:br:federal:lei:1936-06-05;212", ementa:"Regula o modo de pagamento de auxilios e subvenções", arquivo:"federal/leis-ordinarias/1936/lei-212-1936-06-05.md"}}, {id:"federal:BR:L:322/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-11-25", numero:"322", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-11-25;322", vigente:true, titulo:"Lei nº 322 de 25/11/1936", urn:"urn:lex:br:federal:lei:1936-11-25;322", ementa:"Autoriza o Poder Executivo a contractar sete ajudantes technicos de 3ª classe e dous auxiliares de escripta, tambem de 3ª classe, para os serviços ; do Laboratorio Nacional de Analyses, na Alfandega de Santos.", arquivo:"federal/leis-ordinarias/1936/lei-322-1936-11-25.md"}}, {id:"federal:BR:L:315/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-11-23", numero:"315", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-11-23;315", vigente:true, titulo:"Lei nº 315 de 23/11/1936", urn:"urn:lex:br:federal:lei:1936-11-23;315", ementa:"Concede a S. 0. S. (Serviços de Obras Sociaes) o dominio pleno do terreno que actualmente occupa, isentando-o de impostos federaes, bem como os immoveis alli existentes e os que forem construidos", arquivo:"federal/leis-ordinarias/1936/lei-315-1936-11-23.md"}}, {id:"federal:BR:L:343/1936", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-12-12", numero:"343", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-12-12;343", vigente:true, titulo:"Lei nº 343 de 12/12/1936", urn:"urn:lex:br:federal:lei:1936-12-12;343", ementa:"Autoriza o Governo a commemorar o centenario do nascimento ao Dr. Francisco Pereira Passos.", arquivo:"federal/leis-ordinarias/1936/lei-343-1936-12-12.md"}}, {id:"federal:BR:L:304/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-11-16", numero:"304", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-11-16;304", vigente:true, titulo:"Lei nº 304 de 16/11/1936", urn:"urn:lex:br:federal:lei:1936-11-16;304", ementa:"Estabelece novas normas sobre as regalias de cartas de provisionados, solicitadores e o exercicio dessas profissões", arquivo:"federal/leis-ordinarias/1936/lei-304-1936-11-16.md"}}, {id:"federal:BR:L:350/1936", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-12-23", numero:"350", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-12-23;350", vigente:true, titulo:"Lei nº 350 de 23/12/1936", urn:"urn:lex:br:federal:lei:1936-12-23;350", ementa:"Autoriza o poder Executivo a abrir o credito supplementar de 549:850$000 para reforço de diversas verbas do orçamento do Ministerio da Agricultura", arquivo:"federal/leis-ordinarias/1936/lei-350-1936-12-23.md"}}, {id:"federal:BR:L:171/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-01-06", numero:"171", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-01-06;171", vigente:true, titulo:"Lei nº 171 de 06/01/1936", urn:"urn:lex:br:federal:lei:1936-01-06;171", ementa:"Approva o Convenio celebrado, em julho de 1935, entre os Estados productores de café", arquivo:"federal/leis-ordinarias/1936/lei-171-1936-01-06.md"}}, {id:"federal:BR:L:272/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-10-13", numero:"272", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-10-13;272", vigente:true, titulo:"Lei nº 272 de 13/10/1936", urn:"urn:lex:br:federal:lei:1936-10-13;272", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministerio da   Guerra o credito especial de 5.000:000$000, para compra de aviões de   treinamento", arquivo:"federal/leis-ordinarias/1936/lei-272-1936-10-13.md"}}, {id:"federal:BR:L:334/1936", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-12-03", numero:"334", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-12-03;334", vigente:true, titulo:"Lei nº 334 de 03/12/1936", urn:"urn:lex:br:federal:lei:1936-12-03;334", ementa:"Prorroga até 31 de dezembro de 1937, o prazo a que se refere a lei n. 24, de 13 de fevereiro de 1935", arquivo:"federal/leis-ordinarias/1936/lei-334-1936-12-03.md"}}, {id:"federal:BR:L:200/1936", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1936, data:"1936-01-23", numero:"200", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1936-01-23;200", vigente:true, titulo:"Lei nº 200 de 23/01/1936", urn:"urn:lex:br:federal:lei:1936-01-23;200", ementa:"Autoriza a abrir, pelo Ministerio da Educação e Saude Publica, o credito de 76:800$000, para ocorrer ao pagamento do professor em disponibilidade, Dr. Irineu de Mello Mac