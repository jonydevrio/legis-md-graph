, ementa:"Suspende, nos meses de dezembro de 1947 e janeiro de 1948, os descontos de   consignação em folha de pagamento dos funcionários públicos civis e   militares.", arquivo:"federal/leis-ordinarias/1947/lei-169-1947-12-12.md"}}, {id:"federal:BR:L:182/1947", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1947, data:"1947-12-17", numero:"182", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1947-12-17;182", vigente:true, titulo:"Lei nº 182 de 17/12/1947", urn:"urn:lex:br:federal:lei:1947-12-17;182", ementa:"Concede isenção de direitos e demais taxas aduaneiras   para a importação de ;8 aviões \"Douglas DC-3\", destinados à emprêsa ;\"Serviços Aéreos ;Cruzeiro do Sul   Ltda.", arquivo:"federal/leis-ordinarias/1947/lei-182-1947-12-17.md"}}, {id:"federal:BR:L:193/1947", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1947, data:"1947-12-24", numero:"193", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1947-12-24;193", vigente:true, titulo:"Lei nº 193 de 24/12/1947", urn:"urn:lex:br:federal:lei:1947-12-24;193", ementa:"Promove ao posto de capitão os primeiros tenentes da ativa das Forças   Armadas que contem, presentemente, 10 anos como subalternos.", arquivo:"federal/leis-ordinarias/1947/lei-193-1947-12-24.md"}}, {id:"federal:BR:L:83/1947", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1947, data:"1947-08-30", numero:"83", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1947-08-30;83", vigente:true, titulo:"Lei nº 83 de 30/08/1947", urn:"urn:lex:br:federal:lei:1947-08-30;83", ementa:"Autoriza o Poder Executivo a abrir crédito suplementar para recepções,   hospedagens e demais homenagens a serem prestadas a representantes de governos   estrangeiros e personalidades, em visita ao Brasil.", arquivo:"federal/leis-ordinarias/1947/lei-83-1947-08-30.md"}}, {id:"federal:BR:L:74/1947", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1947, data:"1947-08-21", numero:"74", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1947-08-21;74", vigente:true, titulo:"Lei nº 74 de 21/08/1947", urn:"urn:lex:br:federal:lei:1947-08-21;74", ementa:"Abre ao Ministério da Justiça e Negócios Interiores o crédito   extraordinário de Cr$ 2.000.000,00 para atender às despesas com socorro aos   refugiados do Paraguai.", arquivo:"federal/leis-ordinarias/1947/lei-74-1947-08-21.md"}}, {id:"federal:BR:L:63/1947", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1947, data:"1947-08-14", numero:"63", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1947-08-14;63", vigente:true, titulo:"Lei nº 63 de 14/08/1947", urn:"urn:lex:br:federal:lei:1947-08-14;63", ementa:"Abre crédito especial de Cr$ 6.584.047,80 para pagamento de   concessionários de portos.", arquivo:"federal/leis-ordinarias/1947/lei-63-1947-08-14.md"}}, {id:"federal:BR:L:174/1947", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1947, data:"1947-12-16", numero:"174", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1947-12-16;174", vigente:true, titulo:"Lei nº 174 de 16/12/1947", urn:"urn:lex:br:federal:lei:1947-12-16;174", ementa:"Abre, ao Ministério da Educação e Saúde, crédito especial para atender ao   pagamento de diferença de gratificação de magistério.", arquivo:"federal/leis-ordinarias/1947/lei-174-1947-12-16.md"}}, {id:"federal:BR:L:100/1947", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1947, data:"1947-09-17", numero:"100", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1947-09-17;100", vigente:true, titulo:"Lei nº 100 de 17/09/1947", urn:"urn:lex:br:federal:lei:1947-0