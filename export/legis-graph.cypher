"1958-06-16", numero:"3411", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-06-16;3411", vigente:true, titulo:"Lei nº 3.411 de 16/06/1958", urn:"urn:lex:br:federal:lei:1958-06-16;3411", ementa:"Concede, durante cinco anos, o auxílio de Cr$ 25.000.000,00 ao Museu de   Arte Moderna do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1958/lei-3411-1958-06-16.md"}}, {id:"federal:BR:L:3415/1958", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-06-30", numero:"3415", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-06-30;3415", vigente:true, titulo:"Lei nº 3.415 de 30/06/1958", urn:"urn:lex:br:federal:lei:1958-06-30;3415", ementa:"Revigora pelo prazo máximo de um ano a Lei nº 1.522, de 26 de dezembro de   1951, com as alterações constantes da Lei nº 3.084, de 29 de dezembro de 1956, e   prorrogada pela de n° 3.344, de 14 de dezembro de 1957.", arquivo:"federal/leis-ordinarias/1958/lei-3415-1958-06-30.md"}}, {id:"federal:BR:L:3505/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-24", numero:"3505", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-24;3505", vigente:true, titulo:"Lei nº 3.505 de 24/12/1958", urn:"urn:lex:br:federal:lei:1958-12-24;3505", ementa:"Cria cargos na Justiça do Distrito Federal, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1958/lei-3505-1958-12-24.md"}}, {id:"federal:BR:L:3517/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-30", numero:"3517", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-30;3517", vigente:true, titulo:"Lei nº 3.517 de 30/12/1958", urn:"urn:lex:br:federal:lei:1958-12-30;3517", ementa:"Concede isenção de direitos aduaneiros, inclusive o adicional de 10%,   imposto de consumo e mais taxas aduaneiras para materiais importados pela   Companhia Telefônica Cuiabana.", arquivo:"federal/leis-ordinarias/1958/lei-3517-1958-12-30.md"}}, {id:"federal:BR:L:3425/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-07-10", numero:"3425", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-07-10;3425", vigente:true, titulo:"Lei nº 3.425 de 10/07/1958", urn:"urn:lex:br:federal:lei:1958-07-10;3425", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o   crédito especial de Cr$ 3.000.000,00 para a construção do primeiro pavilhão para   alunos internos do Aprendizado Agrícola Juvenil Monsenhor Giordano, no Município   de Jundiaí, Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1958/lei-3425-1958-07-10.md"}}, {id:"federal:BR:L:3452/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-11-06", numero:"3452", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-11-06;3452", vigente:true, titulo:"Lei nº 3.452 de 06/11/1958", urn:"urn:lex:br:federal:lei:1958-11-06;3452", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o   crédito especial de Cr$ 5.000.000,00 para auxiliar a realização da Festa da Uva   e da Exposição Agro-Industrial, em Caxias do Sul, Estado do Rio Grande do   Sul.", arquivo:"federal/leis-ordinarias/1958/lei-3452-1958-11-06.md"}}, {id:"federal:BR:L:3395/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-05-27", numero:"3395", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-05-27;3395", vigente:true, titulo:"Lei nº 3.395 de 27/05/1958", urn:"urn:lex:br:federal:lei:1958-05-27;3395", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 7.050.000,00 para ser distribuído a entidades   esportivas.", arquivo:"federal/leis-ordinarias/1958/lei-3395-1958-05-27.md"}}, {id:"federal:BR:L:3489/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-16", numero:"3489", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-16;3489", vigente:true, titulo:"Lei nº 3.489 de 16/12/1958", urn:"urn:lex:br:federal:lei:1958-12-16;3489", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Guerra, o crédito   especial de Cr$ 65.000.000,00 para a conclusão da construção do Monumento   Nacional, destinado a representar a participação ativa do Brasil na Segunda   Guerra e a guardar os despojos dos brasileiros tombados durante as operações de   guerra.", arquivo:"federal/leis-ordinarias/1958/lei-3489-1958-12-16.md"}}, {id:"federal:BR:L:3513/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-30", numero:"3513", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-30;3513", vigente:true, titulo:"Lei nº 3.513 de 30/12/1958", urn:"urn:lex:br:federal:lei:1958-12-30;3513", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura, o crédito especial de Cr$ 1.000.000,00, destinados à comemoração do bicentenário da criação do Município de Rio Pomba, no Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/1958/lei-3513-1958-12-30.md"}}, {id:"federal:BR:L:3402/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-06-12", numero:"3402", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-06-12;3402", vigente:true, titulo:"Lei nº 3.402 de 12/06/1958", urn:"urn:lex:br:federal:lei:1958-06-12;3402", ementa:"Altera o Quadro da Secretaria do Tribunal Regional Eleitoral de   Pernambuco, e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3402-1958-06-12.md"}}, {id:"federal:BR:L:3421/1958", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-07-10", numero:"3421", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-07-10;3421", vigente:true, titulo:"Lei nº 3.421 de 10/07/1958", urn:"urn:lex:br:federal:lei:1958-07-10;3421", ementa:"Cria o Fundo Portuário Nacional, a Taxa de Melhoramentos dos Portos, e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3421-1958-07-10.md"}}, {id:"federal:BR:L:3469/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-11-28", numero:"3469", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-11-28;3469", vigente:true, titulo:"Lei nº 3.469 de 28/11/1958", urn:"urn:lex:br:federal:lei:1958-11-28;3469", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o   crédito especial de Cr$ 10.000.000,00, para combater a erosão que assola o   Estado do Paraná.", arquivo:"federal/leis-ordinarias/1958/lei-3469-1958-11-28.md"}}, {id:"federal:BR:L:3385/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-05-09", numero:"3385", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-05-09;3385", vigente:true, titulo:"Lei nº 3.385 de 09/05/1958", urn:"urn:lex:br:federal:lei:1958-05-09;3385", ementa:"Cria cargo na carreira de oficial judiciário no Quadro da Secretaria do   Tribunal Regional Eleitoral do Espírito Santo.", arquivo:"federal/leis-ordinarias/1958/lei-3385-1958-05-09.md"}}, {id:"federal:BR:L:3435/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-07-22", numero:"3435", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-07-22;3435", vigente:true, titulo:"Lei nº 3.435 de 22/07/1958", urn:"urn:lex:br:federal:lei:1958-07-22;3435", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras Públicas,   o crédito especial de Cr$ 30.400.000,00 para atender às despesas com a   criação de funções de extranumerário-tarefeiro no Departamento dos Correios e   Telégrafos, e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3435-1958-07-22.md"}}, {id:"federal:BR:L:3487/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-10", numero:"3487", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-10;3487", vigente:true, titulo:"Lei nº 3.487 de 10/12/1958", urn:"urn:lex:br:federal:lei:1958-12-10;3487", ementa:"Estima a Receita e fixa a Despesa da União para o exercício financeiro de 1959.", arquivo:"federal/leis-ordinarias/1958/lei-3487-1958-12-10.md"}}, {id:"federal:BR:L:3413/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-06-18", numero:"3413", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-06-18;3413", vigente:true, titulo:"Lei nº 3.413 de 18/06/1958", urn:"urn:lex:br:federal:lei:1958-06-18;3413", ementa:"Retifica a Lei nº 2.996, de 10 de dezembro de 1956, que estima a Receita   e fixa Despesa da União para o exercício de 1957.", arquivo:"federal/leis-ordinarias/1958/lei-3413-1958-06-18.md"}}, {id:"federal:BR:L:3443/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-09-03", numero:"3443", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-09-03;3443", vigente:true, titulo:"Lei nº 3.443 de 03/09/1958", urn:"urn:lex:br:federal:lei:1958-09-03;3443", ementa:"Abre, pelo Ministério da Viação e Obras Públicas, crédito especial para   socorrer vitimas de explosão em Gramacho, Município de Duque de Caxias, estado   do Rio de Janeiro, e de incêndio em Guaratinguetá, Estado de São Paulo, bem como   reparar prejuizo resultante do desabamento do Edifício São Luiz Rei, na Capital   Federal.", arquivo:"federal/leis-ordinarias/1958/lei-3443-1958-09-03.md"}}, {id:"federal:BR:L:3490/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-16", numero:"3490", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-16;3490", vigente:true, titulo:"Lei nº 3.490 de 16/12/1958", urn:"urn:lex:br:federal:lei:1958-12-16;3490", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Guerra, o crédito   especial de Cr$ 4.788.300,00, destinado a atender ao pagamento de vencimentos,   salário-família e gratificação adicional por tempo de serviço aos servidores do   Estabelecimento Comercial de Material de Intendência.", arquivo:"federal/leis-ordinarias/1958/lei-3490-1958-12-16.md"}}, {id:"federal:BR:L:3382/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-04-24", numero:"3382", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-04-24;3382", vigente:true, titulo:"Lei nº 3.382 de 24/04/1958", urn:"urn:lex:br:federal:lei:1958-04-24;3382", ementa:"Dispõe sobre aposentadoria dos servidores civis que trabalham em   estabelecimentos industriais da União, produtores de munições e   explosivos.", arquivo:"federal/leis-ordinarias/1958/lei-3382-1958-04-24.md"}}, {id:"federal:BR:L:3377/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-03-21", numero:"3377", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-03-21;3377", vigente:true, titulo:"Lei nº 3.377 de 21/03/1958", urn:"urn:lex:br:federal:lei:1958-03-21;3377", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o crédito especial de Cr$ 15.000.000,00 para auxílios a Municípios do Estado do Rio Grande do Sul atingidos por violento temporal.", arquivo:"federal/leis-ordinarias/1958/lei-3377-1958-03-21.md"}}, {id:"federal:BR:L:3461/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-11-19", numero:"3461", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-11-19;3461", vigente:true, titulo:"Lei nº 3.461 de 19/11/1958", urn:"urn:lex:br:federal:lei:1958-11-19;3461", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura, o crédito especial de Cr$ 10.000.000,00, para auxiliar a Federação Universitária Paulista de Esportes, na construção de um Estádio Universitário.", arquivo:"federal/leis-ordinarias/1958/lei-3461-1958-11-19.md"}}, {id:"federal:BR:L:3506/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-27", numero:"3506", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-27;3506", vigente:true, titulo:"Lei nº 3.506 de 27/12/1958", urn:"urn:lex:br:federal:lei:1958-12-27;3506", ementa:"Regula a situação dos servidores civis e militares candidatos a cargos   eletivos ou diplomados para o exercício de mandato legislativo   federal.", arquivo:"federal/leis-ordinarias/1958/lei-3506-1958-12-27.md"}}, {id:"federal:BR:L:3368/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-02-22", numero:"3368", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-02-22;3368", vigente:true, titulo:"Lei nº 3.368 de 22/02/1958", urn:"urn:lex:br:federal:lei:1958-02-22;3368", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Tribunal Superior   do Trabalho - o crédito especial de Cr$ 31.830.454,40 para atender despesas com   o pagamento de sentenças judiciárias, salário-família e gratificação de   função.", arquivo:"federal/leis-ordinarias/1958/lei-3368-1958-02-22.md"}}, {id:"federal:BR:L:3470/1958", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-11-28", numero:"3470", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-11-28;3470", vigente:true, titulo:"Lei nº 3.470 de 28/11/1958", urn:"urn:lex:br:federal:lei:1958-11-28;3470", ementa:"Altera a legislação do Imposto de Renda e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3470-1958-11-28.md"}}, {id:"federal:BR:L:3419/1958", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-07-05", numero:"3419", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-07-05;3419", vigente:true, titulo:"Lei nº 3.419 de 05/07/1958", urn:"urn:lex:br:federal:lei:1958-07-05;3419", ementa:"Autoriza o Poder Executivo a doar aos seus ocupantes as porções que integram o terreno situado na cidade de Manaus, Estado do Amazonas, incorporado ao Patrimônio da União Federal em virtude de deferimento, em seu favor, de herança jacente de Julia Costa e Zulmira Amorim, e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3419-1958-07-05.md"}}, {id:"federal:BR:L:3409/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-06-16", numero:"3409", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-06-16;3409", vigente:true, titulo:"Lei nº 3.409 de 16/06/1958", urn:"urn:lex:br:federal:lei:1958-06-16;3409", ementa:"Concede isenção de direitos de importação, imposto de consumo e taxas   aduaneiras para um trator e seus acessórios e uma máquina para olaria doados à   Prelazia do Xingu, no Estado do Pará.", arquivo:"federal/leis-ordinarias/1958/lei-3409-1958-06-16.md"}}, {id:"federal:BR:L:3438/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-08-21", numero:"3438", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-08-21;3438", vigente:true, titulo:"Lei nº 3.438 de 21/08/1958", urn:"urn:lex:br:federal:lei:1958-08-21;3438", ementa:"Retifica a Lei nº 2.996, de 10-12-56, que estima a Receita e fixa a Despesa da União para o exercício financeiro de 1957.", arquivo:"federal/leis-ordinarias/1958/lei-3438-1958-08-21.md"}}, {id:"federal:BR:L:3478/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-04", numero:"3478", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-04;3478", vigente:true, titulo:"Lei nº 3.478 de 04/12/1958", urn:"urn:lex:br:federal:lei:1958-12-04;3478", ementa:"Cria o Quadro da Secretaria da Procuradoria Geral da Justiça Militar, e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3478-1958-12-04.md"}}, {id:"federal:BR:L:3456/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-11-18", numero:"3456", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-11-18;3456", vigente:true, titulo:"Lei nº 3.456 de 18/11/1958", urn:"urn:lex:br:federal:lei:1958-11-18;3456", ementa:"Altera, sem aumento de despesa, a Lei número 2.996, de 10 de dezembro de   1956, que estima a Receita e fixa a Despesa da União para o exercício de 1957; e   dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3456-1958-11-18.md"}}, {id:"federal:BR:L:3491/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-18", numero:"3491", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-18;3491", vigente:true, titulo:"Lei nº 3.491 de 18/12/1958", urn:"urn:lex:br:federal:lei:1958-12-18;3491", ementa:"Altera a redação da Lei nº 3.346, de 17 de dezembro de 1957.", arquivo:"federal/leis-ordinarias/1958/lei-3491-1958-12-18.md"}}, {id:"federal:BR:L:3497/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-21", numero:"3497", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-21;3497", vigente:true, titulo:"Lei nº 3.497 de 21/12/1958", urn:"urn:lex:br:federal:lei:1958-12-21;3497", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras   Públicas, o crédito especial de Cr$ 31.400.237,30, para completar o pagamento do   que é devido à Companhia Ferroviária Este Brasileiro.", arquivo:"federal/leis-ordinarias/1958/lei-3497-1958-12-21.md"}}, {id:"federal:BR:L:3441/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-08-27", numero:"3441", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-08-27;3441", vigente:true, titulo:"Lei nº 3.441 de 27/08/1958", urn:"urn:lex:br:federal:lei:1958-08-27;3441", ementa:"Concede isençao de licença prévia de todos os impostos de importação,   consumo e taxas alfandegárias para o material de propaganda da Campanha de Nossa   Senhora de Fátima no Brasil.", arquivo:"federal/leis-ordinarias/1958/lei-3441-1958-08-27.md"}}, {id:"federal:BR:L:3396/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-06-02", numero:"3396", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-06-02;3396", vigente:true, titulo:"Lei nº 3.396 de 02/06/1958", urn:"urn:lex:br:federal:lei:1958-06-02;3396", ementa:"Altera a redação dos arts. 864 e 865 do Código de Processo Civil.", arquivo:"federal/leis-ordinarias/1958/lei-3396-1958-06-02.md"}}, {id:"federal:BR:L:3488/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-12", numero:"3488", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-12;3488", vigente:true, titulo:"Lei nº 3.488 de 12/12/1958", urn:"urn:lex:br:federal:lei:1958-12-12;3488", ementa:"Modifica o art. 226 da Consolidação das Leis do Trabalho.", arquivo:"federal/leis-ordinarias/1958/lei-3488-1958-12-12.md"}}, {id:"federal:BR:L:3466/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-11-26", numero:"3466", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-11-26;3466", vigente:true, titulo:"Lei nº 3.466 de 26/11/1958", urn:"urn:lex:br:federal:lei:1958-11-26;3466", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o   crédito especial de Cr$ 3.000.000,00, destinado a auxiliar a Prefeitura   Minicipal de Estrela, no Estado do Rio Grande do Sul, na realização da I   Exposição Nacional de Suínos.", arquivo:"federal/leis-ordinarias/1958/lei-3466-1958-11-26.md"}}, {id:"federal:BR:L:3483/1958", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-08", numero:"3483", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-08;3483", vigente:true, titulo:"Lei nº 3.483 de 08/12/1958", urn:"urn:lex:br:federal:lei:1958-12-08;3483", ementa:"Equipara servidores da União e das autarquias federais à categoria de extranumerários mensalistas, desde que contem ou venham a contar cinco anos de exercício, e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3483-1958-12-08.md"}}, {id:"federal:BR:L:3433/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-07-18", numero:"3433", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-07-18;3433", vigente:true, titulo:"Lei nº 3.433 de 18/07/1958", urn:"urn:lex:br:federal:lei:1958-07-18;3433", ementa:"Dispõe sobre contagem de tempo de serviço prestado à Superintendência e às   Empresas Incorporadas do Patrimônio Nacional, a que se refere a Lei nº 2.193,   de 9 de março de 1954, e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3433-1958-07-18.md"}}, {id:"federal:BR:L:3504/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-24", numero:"3504", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-24;3504", vigente:true, titulo:"Lei nº 3.504 de 24/12/1958", urn:"urn:lex:br:federal:lei:1958-12-24;3504", ementa:"Institui o \"Dia da Saúde Dentária\".", arquivo:"federal/leis-ordinarias/1958/lei-3504-1958-12-24.md"}}, {id:"federal:BR:L:3420/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-07-05", numero:"3420", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-07-05;3420", vigente:true, titulo:"Lei nº 3.420 de 05/07/1958", urn:"urn:lex:br:federal:lei:1958-07-05;3420", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério do Trabalho, Indústria   e Comércio, o crédito especial de Cr$ 5.000.000,00 para atender as despesas com   a realização da I Exposição Brasileira de Alimentação.", arquivo:"federal/leis-ordinarias/1958/lei-3420-1958-07-05.md"}}, {id:"federal:BR:L:3372/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-03-12", numero:"3372", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-03-12;3372", vigente:true, titulo:"Lei nº 3.372 de 12/03/1958", urn:"urn:lex:br:federal:lei:1958-03-12;3372", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Saúde, o crédito   especial de Cr$ 10.000.000,00 como auxílio ao Hospital Pro-Matre, no Distrito   Federal.", arquivo:"federal/leis-ordinarias/1958/lei-3372-1958-03-12.md"}}, {id:"federal:BR:L:3473/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-01", numero:"3473", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-01;3473", vigente:true, titulo:"Lei nº 3.473 de 01/12/1958", urn:"urn:lex:br:federal:lei:1958-12-01;3473", ementa:"Autoriza o Poder Executivo a financiar operações imobiliárias realizadas   pela Associação dos Suboficiais da Armada, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1958/lei-3473-1958-12-01.md"}}, {id:"federal:BR:L:3410/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-06-16", numero:"3410", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-06-16;3410", vigente:true, titulo:"Lei nº 3.410 de 16/06/1958", urn:"urn:lex:br:federal:lei:1958-06-16;3410", ementa:"Inclui nas funções de extranumerário mensalista das Tabelas Únicas do   Ministério da Marinha os professores do Colégio Naval, dos Centros de Instrução,   das Escolas de Aprendizes Marinheiros e Escolas Técnicas Profissionais, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3410-1958-06-16.md"}}, {id:"federal:BR:L:3451/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-11-06", numero:"3451", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-11-06;3451", vigente:true, titulo:"Lei nº 3.451 de 06/11/1958", urn:"urn:lex:br:federal:lei:1958-11-06;3451", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério do Trabalho, Indústria   e Comércio, o crédito especial de Cr$ 36.611.240,00 para atender ao pagamento   dos benefícios do abono familiar.", arquivo:"federal/leis-ordinarias/1958/lei-3451-1958-11-06.md"}}, {id:"federal:BR:L:3424/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-07-10", numero:"3424", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-07-10;3424", vigente:true, titulo:"Lei nº 3.424 de 10/07/1958", urn:"urn:lex:br:federal:lei:1958-07-10;3424", ementa:"Abre pelo Ministério da Educação e Cultura, o crédito especial de Cr$   2.000.000,00, para auxiliar as festas comemorativas do I centenário de Brusque,   Estado de Santa Catarina.", arquivo:"federal/leis-ordinarias/1958/lei-3424-1958-07-10.md"}}, {id:"federal:BR:L:3516/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-30", numero:"3516", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-30;3516", vigente:true, titulo:"Lei nº 3.516 de 30/12/1958", urn:"urn:lex:br:federal:lei:1958-12-30;3516", ementa:"Revigora a vigência dos créditos especiais de Cr$ 150.000.000,00 e Cr$ 120.000.000,00, para atender às despesas com as obras e instalações da usina termelétrica e da mina de Candiota, no Estado do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1958/lei-3516-1958-12-30.md"}}, {id:"federal:BR:L:3446/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-09-29", numero:"3446", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-09-29;3446", vigente:true, titulo:"Lei nº 3.446 de 29/09/1958", urn:"urn:lex:br:federal:lei:1958-09-29;3446", ementa:"Retifica, sem ônus, as Leis Orçamentárias para os exercícios financeiros   de 1952, 1953, 1954, 1955, 1956, 1957 e 1958.", arquivo:"federal/leis-ordinarias/1958/lei-3446-1958-09-29.md"}}, {id:"federal:BR:L:3394/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-05-27", numero:"3394", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-05-27;3394", vigente:true, titulo:"Lei nº 3.394 de 27/05/1958", urn:"urn:lex:br:federal:lei:1958-05-27;3394", ementa:"Concede isenção de direitos taxas aduaneiras e imposto de consumo para   material a ser importado pela Telefônica de Sete Lagoas S.A., no Estado de Minas   Gerais.", arquivo:"federal/leis-ordinarias/1958/lei-3394-1958-05-27.md"}}, {id:"federal:BR:L:3468/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-11-28", numero:"3468", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-11-28;3468", vigente:true, titulo:"Lei nº 3.468 de 28/11/1958", urn:"urn:lex:br:federal:lei:1958-11-28;3468", ementa:"Concede a pensão especial de Cr$ 3.222,50 mensais a Hermelinda Franco de   Godoy, viúva do ex-oficial administrativo aposentado do antigo Ministério da   Educação e Saúde Avelino de Godoy.", arquivo:"federal/leis-ordinarias/1958/lei-3468-1958-11-28.md"}}, {id:"federal:BR:L:3401/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-06-12", numero:"3401", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-06-12;3401", vigente:true, titulo:"Lei nº 3.401 de 12/06/1958", urn:"urn:lex:br:federal:lei:1958-06-12;3401", ementa:"Transforma em unidades-universitárias os atuais cursos de Odontologia e de   Farmácia da Faculdade de Medicina da Universidade do Recife.", arquivo:"federal/leis-ordinarias/1958/lei-3401-1958-06-12.md"}}, {id:"federal:BR:L:3512/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-30", numero:"3512", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-30;3512", vigente:true, titulo:"Lei nº 3.512 de 30/12/1958", urn:"urn:lex:br:federal:lei:1958-12-30;3512", ementa:"Revigora, pelo prazo de dois anos, os créditos especiais de Cr$   100.000.000,00, Cr$ 300.000.000,00 e Cr$ 30.000.000,00 para atender despesas   necessárias ao reaparelhamento de órgãos da União e das repartições aduaneiras e   aperfeiçoamento e inspeção dos serviços fazendários, inclusive pessoal e   material.", arquivo:"federal/leis-ordinarias/1958/lei-3512-1958-12-30.md"}}, {id:"federal:BR:L:3486/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-10", numero:"3486", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-10;3486", vigente:true, titulo:"Lei nº 3.486 de 10/12/1958", urn:"urn:lex:br:federal:lei:1958-12-10;3486", ementa:"Cria no Tribunal Regional do Trabalho da 2ª Região dos cargos de Juíz, e   dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3486-1958-12-10.md"}}, {id:"federal:BR:L:3412/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-06-18", numero:"3412", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-06-18;3412", vigente:true, titulo:"Lei nº 3.412 de 18/06/1958", urn:"urn:lex:br:federal:lei:1958-06-18;3412", ementa:"Denomina Escola Industrial Coriolano de Medeiros a Escola Industrial de   João Pessôa.", arquivo:"federal/leis-ordinarias/1958/lei-3412-1958-06-18.md"}}, {id:"federal:BR:L:3391/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-05-22", numero:"3391", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-05-22;3391", vigente:true, titulo:"Lei nº 3.391 de 22/05/1958", urn:"urn:lex:br:federal:lei:1958-05-22;3391", ementa:"Autoriza o Poder Executivo a abrir pelo Ministério da Fazenda, o crédito   especial Cr$ 500.000,00 para auxiliar a Sociedade Corpo de Bombeiros Voluntários   de Joinville, no Estado de Santa Catarina.", arquivo:"federal/leis-ordinarias/1958/lei-3391-1958-05-22.md"}}, {id:"federal:BR:L:3460/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-11-19", numero:"3460", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-11-19;3460", vigente:true, titulo:"Lei nº 3.460 de 19/11/1958", urn:"urn:lex:br:federal:lei:1958-11-19;3460", ementa:"Altera o quadro da Secretaria do Tribunal Regional Eleitoral, do Estado de   Santa Catarina, e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3460-1958-11-19.md"}}, {id:"federal:BR:L:3397/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-06-03", numero:"3397", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-06-03;3397", vigente:true, titulo:"Lei nº 3.397 de 03/06/1958", urn:"urn:lex:br:federal:lei:1958-06-03;3397", ementa:"Autoriza a União a constituir uma sociedade por ações que se denominará   Companhia Hidroelétrica de Campo Grande, com fôro e sede na cidade do mesmo   nome, no Estado de Mato Grosso.", arquivo:"federal/leis-ordinarias/1958/lei-3397-1958-06-03.md"}}, {id:"federal:BR:L:3437/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-08-15", numero:"3437", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-08-15;3437", vigente:true, titulo:"Lei nº 3.437 de 15/08/1958", urn:"urn:lex:br:federal:lei:1958-08-15;3437", ementa:"Denomina \"Ponte Presidente Eurico Dutra\" a ponte da Estrada de Ferro Noroeste do Brasil sobre o rio Paraguai, no Estado do Mato Grosso.", arquivo:"federal/leis-ordinarias/1958/lei-3437-1958-08-15.md"}}, {id:"federal:BR:L:3383/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-04-28", numero:"3383", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-04-28;3383", vigente:true, titulo:"Lei nº 3.383 de 28/04/1958", urn:"urn:lex:br:federal:lei:1958-04-28;3383", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça do   Trabalho - Tribunal Regional do Trabalho da 4ª Região, o crédito especial de Cr$   5.550,00 para pagamento de salário-família nos exercícios de 1952 a   1955.", arquivo:"federal/leis-ordinarias/1958/lei-3383-1958-04-28.md"}}, {id:"federal:BR:L:3458/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-11-18", numero:"3458", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-11-18;3458", vigente:true, titulo:"Lei nº 3.458 de 18/11/1958", urn:"urn:lex:br:federal:lei:1958-11-18;3458", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 10.000.000,00, destinado à Província Brasileira dos   Irmãos Lassalistas - Sociedade Porvir Científico, com sede em Porto Alegre,   Estado do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1958/lei-3458-1958-11-18.md"}}, {id:"federal:BR:L:3389/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-05-21", numero:"3389", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-05-21;3389", vigente:true, titulo:"Lei nº 3.389 de 21/05/1958", urn:"urn:lex:br:federal:lei:1958-05-21;3389", ementa:"Autoriza o Poder Executivo a abrir, Ministério do Trabalho, Indústria e   Comércio, o crédito especial de Cr$ 500.000,00, para custear despesas com a   realização do 3º Congresso de Trabalhadores, em Porto Alegre, Estado do Rio   Grande do Sul.", arquivo:"federal/leis-ordinarias/1958/lei-3389-1958-05-21.md"}}, {id:"federal:BR:L:3499/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-21", numero:"3499", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-21;3499", vigente:true, titulo:"Lei nº 3.499 de 21/12/1958", urn:"urn:lex:br:federal:lei:1958-12-21;3499", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 126.000.000,00, para atender ao prosseguimento das   obras da Cidade Universitária, da Universidade do Brasil, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1958/lei-3499-1958-12-21.md"}}, {id:"federal:BR:L:3376/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-03-18", numero:"3376", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-03-18;3376", vigente:true, titulo:"Lei nº 3.376 de 18/03/1958", urn:"urn:lex:br:federal:lei:1958-03-18;3376", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 100.000.000,00 destinado a atender às despesas com a   concessão de matrículas e bolsas de estudos a estudantes.", arquivo:"federal/leis-ordinarias/1958/lei-3376-1958-03-18.md"}}, {id:"federal:BR:L:3429/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-07-15", numero:"3429", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-07-15;3429", vigente:true, titulo:"Lei nº 3.429 de 15/07/1958", urn:"urn:lex:br:federal:lei:1958-07-15;3429", ementa:"Modifica o art. 11 da Lei nº 3.338, de 14 de dezembro de 1957.", arquivo:"federal/leis-ordinarias/1958/lei-3429-1958-07-15.md"}}, {id:"federal:BR:L:3510/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-30", numero:"3510", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-30;3510", vigente:true, titulo:"Lei nº 3.510 de 30/12/1958", urn:"urn:lex:br:federal:lei:1958-12-30;3510", ementa:"Autoriza o Poder Executivo a subscrever ações da Companhia Siderúrgica   Paulista - COSIPA, e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3510-1958-12-30.md"}}, {id:"federal:BR:L:3370/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-02-26", numero:"3370", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-02-26;3370", vigente:true, titulo:"Lei nº 3.370 de 26/02/1958", urn:"urn:lex:br:federal:lei:1958-02-26;3370", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito   especial de Cr$ 28.500.000,00 para atender às despesas com juros e amortização   das apólices emitidas em decorrência das leis de reajustamento da   pecuária.", arquivo:"federal/leis-ordinarias/1958/lei-3370-1958-02-26.md"}}, {id:"federal:BR:L:3484/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-10", numero:"3484", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-10;3484", vigente:true, titulo:"Lei nº 3.484 de 10/12/1958", urn:"urn:lex:br:federal:lei:1958-12-10;3484", ementa:"Suprime a alínea \"e   \" do art. 4º do Decreto-Lei nº 6.920, de 3 de outubro   de 1944.", arquivo:"federal/leis-ordinarias/1958/lei-3484-1958-12-10.md"}}, {id:"federal:BR:L:3434/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-07-20", numero:"3434", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-07-20;3434", vigente:true, titulo:"Lei nº 3.434 de 20/07/1958", urn:"urn:lex:br:federal:lei:1958-07-20;3434", ementa:"Dispõe sobre o código do Ministério Público do Distrito Federal, e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3434-1958-07-20.md"}}, {id:"federal:BR:L:3416/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia