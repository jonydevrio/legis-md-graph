1-16.md"}}, {id:"federal:BR:L:8715/1993", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1993, data:"1993-10-06", numero:"8715", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1993-10-06;8715", vigente:true, titulo:"Lei nº 8.715 de 06/10/1993", urn:"urn:lex:br:federal:lei:1993-10-06;8715", ementa:"Cria Superintendências Regionais da Polícia Federal nos Estados do   Tocantins, Roraima e Amapá, e correspondentes cargos em comissão e funções de   confiança.", arquivo:"federal/leis-ordinarias/1993/lei-8715-1993-10-06.md"}}, {id:"federal:BR:L:3366/1957", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-12-26", numero:"3366", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1957-12-26;3366", vigente:true, titulo:"Lei nº 3.366 de 26/12/1957", urn:"urn:lex:br:federal:lei:1957-12-26;3366", ementa:"Concede a pensão especial de Cr$ 3.000,00 mensais a Delmira de Faria Fonseca, viúva de Benedito Garibaldi da Fonseca, ex-funcionário do Ministério da Viação e Obras Públicas.", arquivo:"federal/leis-ordinarias/1957/lei-3366-1957-12-26.md"}}, {id:"federal:BR:L:3293/1957", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-10-29", numero:"3293", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1957-10-29;3293", vigente:true, titulo:"Lei nº 3.293 de 29/10/1957", urn:"urn:lex:br:federal:lei:1957-10-29;3293", ementa:"Modifica o art. 91 e revoga os arts. 92 e 93 da Lei Orgânica do Ensino   Secundário (Decreto-Lei n° 4.244, de 9 de abril de 1942).", arquivo:"federal/leis-ordinarias/1957/lei-3293-1957-10-29.md"}}, {id:"federal:BR:L:3279/1957", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-10-07", numero:"3279", fonte:"https://normas.leg.br/?urn=urn:lex