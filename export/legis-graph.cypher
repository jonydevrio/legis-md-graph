/leis-ordinarias/1959/lei-3695-1959-12-18.md"}}, {id:"federal:BR:L:3636/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-09-22", numero:"3636", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-09-22;3636", vigente:true, titulo:"Lei nº 3.636 de 22/09/1959", urn:"urn:lex:br:federal:lei:1959-09-22;3636", ementa:"Concede ao Tenente-Brigadeiro-do-Ar Alberto Santos Dumont o posto   honorífico de Marechal-do-Ar.", arquivo:"federal/leis-ordinarias/1959/lei-3636-1959-09-22.md"}}, {id:"federal:BR:L:3572/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-06-26", numero:"3572", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-06-26;3572", vigente:true, titulo:"Lei nº 3.572 de 26/06/1959", urn:"urn:lex:br:federal:lei:1959-06-26;3572", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Justiça e Negócios   Interiores, o crédito especial de Cr$ 600.000,00, destinado à aquisição, para a   Escola Agrícola Arthur Bernardes, de Viçosa, Estado de Minas Gerais, de um   transformador de energia elétrica e do equipamento necessário à sua instalação e   proteção.", arquivo:"federal/leis-ordinarias/1959/lei-3572-1959-06-26.md"}}, {id:"federal:BR:L:3640/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-10-10", numero:"3640", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-10-10;3640", vigente:true, titulo:"Lei nº 3.640 de 10/10/1959", urn:"urn:lex:br:federal:lei:1959-10-10;3640", ementa:"Revigora o Decreto-lei nº 8.778, de 22 de janeiro de 1946, e lhe altera o alcance do art. 1º", arquivo:"federal/leis-ordinarias/1959/lei-3640-1959-10-10.md"}}, {id:"federal:BR:L:3678/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=fal