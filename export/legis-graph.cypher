mero:"14716", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-10-30;14716", vigente:true, titulo:"Lei nº 14.716 de 30/10/2023", urn:"urn:lex:br:federal:lei:2023-10-30;14716", ementa:"Confere ao Município de Arraial do Cabo, no Estado do Rio de Janeiro, o título de Capital Nacional do Mergulho.", arquivo:"federal/leis-ordinarias/2023/lei-14716-2023-10-30.md"}}, {id:"federal:BR:L:14698/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-10-19", numero:"14698", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-10-19;14698", vigente:true, titulo:"Lei nº 14.698 de 19/10/2023", urn:"urn:lex:br:federal:lei:2023-10-19;14698", ementa:"Erige em monumento nacional o Caminho da Estrada Real, que abrange os Estados de Minas Gerais, Rio de Janeiro e São Paulo.", arquivo:"federal/leis-ordinarias/2023/lei-14698-2023-10-19.md"}}, {id:"federal:BR:L:14778/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-27", numero:"14778", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-27;14778", vigente:true, titulo:"Lei nº 14.778 de 27/12/2023", urn:"urn:lex:br:federal:lei:2023-12-27;14778", ementa:"Abre ao Orçamento Fiscal da União, em favor dos Ministérios da Justiça e Segurança Pública, e da Integração e do Desenvolvimento Regional, crédito especial no valor de R$ 3.143.559,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2023/lei-14778-2023-12-27.md"}}, {id:"federal:BR:L:14723/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-11-13", numero:"14723", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-11-13;14723", vigente:true, titulo:"Lei nº 14.723 de 13/11/2023", urn:"urn:lex:br:federal:lei:2023-11-13;14723", ementa:"Altera a Lei nº 12.711, de 29 de agosto de 2012, para dispor sobre o programa especial para o acesso às instituições federais de educação superior e de ensino técnico de nível médio de estudantes pretos, pardos, indígenas e quilombolas e de pessoas com deficiência, bem como daqueles que tenham cursado integralmente o ensino médio ou fundamental em escola pública.", arquivo:"federal/leis-ordinarias/2023/lei-14723-2023-11-13.md"}}, {id:"federal:BR:L:14750/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-12", numero:"14750", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-12;14750", vigente:true, titulo:"Lei nº 14.750 de 12/12/2023", urn:"urn:lex:br:federal:lei:2023-12-12;14750", ementa:"Altera as Leis nºs 12.608, de 10 de abril de 2012, e 12.340, de 1º de dezembro de 2010, para aprimorar os instrumentos de prevenção de acidentes ou desastres e de recuperação de áreas por eles atingidas, as ações de monitoramento de riscos de acidentes ou desastres e a produção de alertas antecipados.", arquivo:"federal/leis-ordinarias/2023/lei-14750-2023-12-12.md"}}, {id:"federal:BR:L:14786/2023", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-28", numero:"14786", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-28;14786", vigente:true, titulo:"Lei nº 14.786 de 28/12/2023", urn:"urn:lex:br:federal:lei:2023-12-28;14786", ementa:"Cria o protocolo \"Não é Não\", para prevenção ao constrangimento e à violência contra a mulher e para proteção à vítima; institui o selo \"Não é Não - Mulheres Seguras\"; e altera a Lei nº 14.597, de 14 de junho de 2023 (Lei Geral do Esporte).", arquivo:"federal/leis-ordinarias/2023/lei-14786-2023-12-28.md"}}, {id:"federal:BR:L:14720/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-11-07", numero:"14720", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-11-07;14720", vigente:true, titulo:"Lei nº 14.720 de 07/11/2023", urn:"urn:lex:br:federal:lei:2023-11-07;14720", ementa:"Reconhece o forró como manifestação da cultura nacional.", arquivo:"federal/leis-ordinarias/2023/lei-14720-2023-11-07.md"}}, {id:"federal:BR:L:14611/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-03", numero:"14611", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-03;14611", vigente:true, titulo:"Lei nº 14.611 de 03/07/2023", urn:"urn:lex:br:federal:lei:2023-07-03;14611", ementa:"Dispõe sobre a igualdade salarial e de critérios remuneratórios entre mulheres e homens; e altera a Consolidação das Leis do Trabalho, aprovada pelo Decreto-Lei nº 5.452, de 1º de maio de 1943.", arquivo:"federal/leis-ordinarias/2023/lei-14611-2023-07-03.md"}}, {id:"federal:BR:L:14604/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-06-20", numero:"14604", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-06-20;14604", vigente:true, titulo:"Lei nº 14.604 de 20/06/2023", urn:"urn:lex:br:federal:lei:2023-06-20;14604", ementa:"Denomina \"Ponte Joaquim Machado de Souza\" a ponte sobre o rio Envira na rodovia BR-364, no Município de Feijó, Estado do Acre.", arquivo:"federal/leis-ordinarias/2023/lei-14604-2023-06-20.md"}}, {id:"federal:BR:L:14685/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-09-20", numero:"14685", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-09-20;14685", vigente:true, titulo:"Lei nº 14.685 de 20/09/2023", urn:"urn:lex:br:federal:lei:2023-09-20;14685", ementa:"Acrescenta dispositivo à Lei nº 9.394, de 20 de dezembro de 1996 (Lei de Diretrizes e Bases da Educaçã