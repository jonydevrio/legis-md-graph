UNWIND [{id:"federal:BR:L:11297/2006", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2006, data:"2006-05-09", numero:"11297", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2006-05-09;11297", vigente:true, titulo:"Lei nº 11.297 de 09/05/2006", urn:"urn:lex:br:federal:lei:2006-05-09;11297", ementa:"Acrescenta e altera dispositivos na Lei nº 5.917, de 10 de setembro de 1973, que aprova o Plano Nacional de Viação; revoga o art. 3º da Medida Provisória nº 2.217-3, de 4 de setembro de 2001; e dá outras providências.", arquivo:"federal/leis-ordinarias/2006/lei-11297-2006-05-09.md"}}, {id:"federal:BR:L:11347/2006", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2006, data:"2006-09-27", numero:"11347", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2006-09-27;11347", vigente:true, titulo:"Lei nº 11.347 de 27/09/2006", urn:"urn:lex:br:federal:lei:2006-09-27;11347", ementa:"Dispõe sobre a distribuição gratuita de medicamentos e materiais necessários à sua aplicação e à monitoração da glicemia capilar aos portadores de diabetes inscritos em programas de educação para diabéticos.", arquivo:"federal/leis-ordinarias/2006/lei-11347-2006-09-27.md"}}, {id:"federal:BR:L:11424/2006", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2006, data:"2006-12-21", numero:"11424", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2006-12-21;11424", vigente:true, titulo:"Lei nº 11.424 de 21/12/2006", urn:"urn:lex:br:federal:lei:2006-12-21;11424", ementa:"Abre ao Orçamento Fiscal, em favor do Ministério da Educação, crédito especial no valor de R$ 18.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2006/lei-11424-2006-12-21.md"}}, {id:"federal:BR:L:11381/2006", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2006, data:"2006-12-01", numero:"11381", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2006-12-01;11381", vigente:true, titulo:"Lei nº 11.381 de 01/12/2006", urn:"urn:lex:br:federal:lei:2006-12-01;11381", ementa:"Altera a Lei nº 6.932, de 7 de julho de 1981, que dispõe sobre as atividades do médico residente, e revoga dispositivos da Lei nº 10.405, de 9 de janeiro de 2002.", arquivo:"federal/leis-ordinarias/2006/lei-11381-2006-12-01.md"}}, {id:"federal:BR:L:11266/2006", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2006, data:"2006-01-10", numero:"11266", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2006-01-10;11266", vigente:true, titulo:"Lei nº 11.266 de 10/01/2006", urn:"urn:lex:br:federal:lei:2006-01-10;11266", ementa:"Abre crédito extraordinário, em favor do Ministério da Previdência Social e de Encargos Financeiros da União, no valor global de R$ 933.400.000,00 (novecentos e trinta e três milhões e quatrocentos mil reais) para os fins que especifica.", arquivo:"federal/leis-ordinarias/2006/lei-11266-2006-01-10.md"}}, {id:"federal:BR:L:11403/2006", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2006, data:"2006-12-15", numero:"11403", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2006-12-15;11403", vigente:true, titulo:"Lei nº 11.403 de 15/12/2006", urn:"urn:lex:br:federal:lei:2006-12-15;11403", ementa:"Abre ao Orçamento da Seguridade Social da União, em favor do Ministério do Desenvolvimento Social e Combate à Fome, crédito especial no valor de R$ 112.400,00 para os fins que especifica, e dá outras providências.", arquivo:"federal/leis-ordinarias/2006/lei-11403-2006-12-15.md"}}, {id:"federal:BR:L:11385/2006", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2006, data:"2006-12-14", n