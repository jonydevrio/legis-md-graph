:"urn:lex:br:federal:lei:1948-12-15;543", ementa:"Dispõe sôbre o quadro da Secretaria do Supremo Tribunal   Federal.", arquivo:"federal/leis-ordinarias/1948/lei-543-1948-12-15.md"}}, {id:"federal:BR:L:410/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-09-25", numero:"410", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-09-25;410", vigente:true, titulo:"Lei nº 410 de 25/09/1948", urn:"urn:lex:br:federal:lei:1948-09-25;410", ementa:"Autoriza a abertura, pelo Ministério da Educação e Saúde, de crédito   especial, para indenização de despesas ao Dr. Mario Kroeff.", arquivo:"federal/leis-ordinarias/1948/lei-410-1948-09-25.md"}}, {id:"federal:BR:L:316/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-07-31", numero:"316", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-07-31;316", vigente:true, titulo:"Lei nº 316 de 31/07/1948", urn:"urn:lex:br:federal:lei:1948-07-31;316", ementa:"Autoriza a abertura, pelo Ministério da Viação e Obras Públicas, de   crédito especial destinado ao desenvolvimento econômico dos Estados do Maranhão,   Piauí, Ceará, Rio Grande do Norte, Paraíba, Sergipe, Alagoas, Espírito Santo,   Goiás e Mato Grosso.", arquivo:"federal/leis-ordinarias/1948/lei-316-1948-07-31.md"}}, {id:"federal:BR:L:361/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-09-02", numero:"361", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-09-02;361", vigente:true, titulo:"Lei nº 361 de 02/09/1948", urn:"urn:lex:br:federal:lei:1948-09-02;361", ementa:"Autoriza a doação ao Município de Tupanciretã, do Estado do Rio Grande do   Sul, de duas faixas de terrenos, de propriedade da Viação Férrea do Rio Grande   do Sul.", arquivo:"federal/leis-ordinarias/1948/lei-361-1948-09-02.md"}}, {id:"federal:BR:L:333/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-08-13", numero:"333", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-08-13;333", vigente:true, titulo:"Lei nº 333 de 13/08/1948", urn:"urn:lex:br:federal:lei:1948-08-13;333", ementa:"Autoriza a abertura, pelo Ministério do Trabalho, Indústria e Comércio, de   crédito especial para ocorrer a despesas com o pagamento do abono   família.", arquivo:"federal/leis-ordinarias/1948/lei-333-1948-08-13.md"}}, {id:"federal:BR:L:245/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-02-17", numero:"245", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-02-17;245", vigente:true, titulo:"Lei nº 245 de 17/02/1948", urn:"urn:lex:br:federal:lei:1948-02-17;245", ementa:"Autoriza a abertura pelo Ministério da Educação e Saúde, de crédito especial para pagamento de gratificação de magistério.", arquivo:"federal/leis-ordinarias/1948/lei-245-1948-02-17.md"}}, {id:"federal:BR:L:274/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-04-22", numero:"274", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-04-22;274", vigente:true, titulo:"Lei nº 274 de 22/04/1948", urn:"urn:lex:br:federal:lei:1948-04-22;274", ementa:"Cria cargo isolado, de provimento efetivo, no Quadro Permanete do   Ministério da Marinha.", arquivo:"federal/leis-ordinarias/1948/lei-274-1948-04-22.md"}}, {id:"federal:BR:L:581/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-12-22", numero:"581", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-12-22;581", vigente:true, titulo:"Lei nº 581 de 22/12/1948", urn:"urn:lex:br:federal:lei:1948-12-22;581", ementa:"Autoriza o Poder Executivo a conceder pensão especial a Belmira Botelho de   Arruda Medeiros, viúva de Antônio Medeiros.", arquivo:"federal/leis-ordinarias/1948/lei-581-1948-12-22.md"}}, {id:"federal:BR:L:473/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-11-06", numero:"473", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-11-06;473-a", vigente:true, titulo:"Lei nº 473-A de 06/11/1948", urn:"urn:lex:br:federal:lei:1948-11-06;473-a", ementa:"Abre, ao Poder Judiciário, crédito suplementar de Cr$ 46.800,00 para   ocorrer ao pagamento de gratificações de representação aos Membros do Tribunal   Regional Eleitoral do Estado da Paraíba.", arquivo:"federal/leis-ordinarias/1948/lei-473-a-1948-11-06.md"}}, {id:"federal:BR:L:565/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-12-20", numero:"565", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-12-20;565", vigente:true, titulo:"Lei nº 565 de 20/12/1948", urn:"urn:lex:br:federal:lei:1948-12-20;565", ementa:"Concede isenção de direitos de importação e taxas aduaneiras, inclusive de   imposto de consumo, para 2 caixas com aparelhos físicos de matéria plástica,   destinadas ao Instituto de Eletrotécnica do Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1948/lei-565-1948-12-20.md"}}, {id:"federal:BR:L:512/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-11-29", numero:"512", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-11-29;512", vigente:true, titulo:"Lei nº 512 de 29/11/1948", urn:"urn:lex:br:federal:lei:1948-11-29;512", ementa:"Autoriza a abertura, pelo Ministério da Educação e Saúde de um crédito   especial de Cr$ 300.000,00, para custeamento das despesas com o IV congresso   Nacional de Tuberculose.", arquivo:"federal/leis-ordinarias/1948/lei-512-1948-11-29.md"}}, {id:"federal:BR:L:465/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-11-04", numero:"465", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-11-04;465", vigente:true, titulo:"Lei nº 465 de 04/11/1948", urn:"urn:lex:br:federal:lei:1948-11-04;465", ementa:"Manda erigir na Capital da República monumento ao ex-Presidente da   República, Conselheiro Francisco de Paula Rodrigues Alves e dá outras   providências.", arquivo:"federal/leis-ordinarias/1948/lei-465-1948-11-04.md"}}, {id:"federal:BR:L:371/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-09-10", numero:"371", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-09-10;371", vigente:true, titulo:"Lei nº 371 de 10/09/1948", urn:"urn:lex:br:federal:lei:1948-09-10;371", ementa:"Autoriza a abertura, pelo Ministério da Educação e Saúde, de crédito   especial de Cr$ 10.600,00 para atender a pagamento de gratificação de magistério   a Vicente Grassani.", arquivo:"federal/leis-ordinarias/1948/lei-371-1948-09-10.md"}}, {id:"federal:BR:L:253/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-02-18", numero:"253", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-02-18;253", vigente:true, titulo:"Lei nº 253 de 18/02/1948", urn:"urn:lex:br:federal:lei:1948-02-18;253", ementa:"Abre ao Ministério da Fazenda crédito especial para indenização do acervo   da Companhia Indústrias Brasileiras de Papel, Empresa de Armazéns Frigoríficos e   Southern Brasil Lumber and Colonization Company, e autoriza a alienação dessas   Emprêsas.", arquivo:"federal/leis-ordinarias/1948/lei-253-1948-02-18.md"}}, {id:"federal:BR:L:264/1948", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-02-25", numero:"264", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-02-25;264", vigente:true, titulo:"Lei nº 264 de 25/02/1948", urn:"urn:lex:br:federal:lei:1948-02-25;264", ementa:"Dispõe sôbre os padrões de vencimentos dos cargos que integram o quadro da Secretaria do Supremo Tribunal Federal.", arquivo:"federal/leis-ordinarias/1948/lei-264-1948-02-25.md"}}, {id:"federal:BR:L:218/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-01-23", numero:"218", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-01-23;218", vigente:true, titulo:"Lei nº 218 de 23/01/1948", urn:"urn:lex:br:federal:lei:1948-01-23;218", ementa:"Autoriza a abertura pelo Ministério da Educação e Saúde, de crédito   especial, para pagamento de gratificação de magistério.", arquivo:"federal/leis-ordinarias/1948/lei-218-1948-01-23.md"}}, {id:"federal:BR:L:385/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-09-17", numero:"385", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-09-17;385", vigente:true, titulo:"Lei nº 385 de 17/09/1948", urn:"urn:lex:br:federal:lei:1948-09-17;385", ementa:"Retifica o Decreto-lei nº 9.548, de 5 de agosto de 1946, que alterou, com   redução de despesa, os Quadros Permanente e Suplementar do Ministério da   Marinha.", arquivo:"federal/leis-ordinarias/1948/lei-385-1948-09-17.md"}}, {id:"federal:BR:L:217/1948", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-01-15", numero:"217", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-01-15;217", vigente:true, titulo:"Lei nº 217 de 15/01/1948", urn:"urn:lex:br:federal:lei:1948-01-15;217", ementa:"Lei Orgânica do Distrito Federal.", arquivo:"federal/leis-ordinarias/1948/lei-217-1948-01-15.md"}}, {id:"federal:BR:L:250/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-02-17", numero:"250", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-02-17;250", vigente:true, titulo:"Lei nº 250 de 17/02/1948", urn:"urn:lex:br:federal:lei:1948-02-17;250", ementa:"Autoriza a abertura, pelo Ministério da Viação e Obras Públicas, de crédito especial para a aquisição de vagões postais.", arquivo:"federal/leis-ordinarias/1948/lei-250-1948-02-17.md"}}, {id:"federal:BR:L:366/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-09-09", numero:"366", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-09-09;366", vigente:true, titulo:"Lei nº 366 de 09/09/1948", urn:"urn:lex:br:federal:lei:1948-09-09;366", ementa:"Autoriza a abertura, pelo Ministério da Aeronáutica, do crédito especial   de Cr$ 6.000.000,00, para pagamento de despesas em 1947, com   pessoal.", arquivo:"federal/leis-ordinarias/1948/lei-366-1948-09-09.md"}}, {id:"federal:BR:L:398/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-09-22", numero:"398", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-09-22;398", vigente:true, titulo:"Lei nº 398 de 22/09/1948", urn:"urn:lex:br:federal:lei:1948-09-22;398", ementa:"Autoriza a abertura, pelo Ministério da Agricultura, de crédito   suplementar para pagamento de gratificação de magistério.", arquivo:"federal/leis-ordinarias/1948/lei-398-1948-09-22.md"}}, {id:"federal:BR:L:516/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-11-30", numero:"516", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-11-30;516", vigente:true, titulo:"Lei nº 516 de 30/11/1948", urn:"urn:lex:br:federal:lei:1948-11-30;516", ementa:"Autoriza a abertura, pelo Ministério da Justiça e Negócios Interiores, do   crédito especial de Cr$ 19.800,00, para pagamento de gratificação adicional ao   Ministro do Supremo Tribunal Federal Álvaro Moutinho Ribeiro da   Costa.", arquivo:"federal/leis-ordinarias/1948/lei-516-1948-11-30.md"}}, {id:"federal:BR:L:428/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-10-11", numero:"428", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-10-11;428", vigente:true, titulo:"Lei nº 428 de 11/10/1948", urn:"urn:lex:br:federal:lei:1948-10-11;428", ementa:"Autoriza a abertura, pelo Ministério das Relações Exteriores, de crédito   especial para pagamento de despesas realizadas durante a visita do Governador   Geral do Canadá ao Brasil.", arquivo:"federal/leis-ordinarias/1948/lei-428-1948-10-11.md"}}, {id:"federal:BR:L:434/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-10-14", numero:"434", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-10-14;434", vigente:true, titulo:"Lei nº 434 de 14/10/1948", urn:"urn:lex:br:federal:lei:1948-10-14;434", ementa:"Cria no Q.S. do Ministério da Guerra, um cargo isolado de Professor   Catedrático.", arquivo:"federal/leis-ordinarias/1948/lei-434-1948-10-14.md"}}, {id:"federal:BR:L:423/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-10-07", numero:"423", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-10-07;423", vigente:true, titulo:"Lei nº 423 de 07/10/1948", urn:"urn:lex:br:federal:lei:1948-10-07;423", ementa:"Autoriza a abertura, pelo Ministério da Educação e Saúde, de crédito   especial para pagamento de gratificação de magistério.", arquivo:"federal/leis-ordinarias/1948/lei-423-1948-10-07.md"}}, {id:"federal:BR:L:400/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-09-22", numero:"400", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-09-22;400", vigente:true, titulo:"Lei nº 400 de 22/09/1948", urn:"urn:lex:br:federal:lei:1948-09-22;400", ementa:"Autoriza a abertura, ao Congresso Nacional, de crédito suplementar para   ocorrer a despesas com subsídio, ajuda de custo, pessoal e   material.", arquivo:"federal/leis-ordinarias/1948/lei-400-1948-09-22.md"}}, {id:"federal:BR:L:340/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-08-20", numero:"340", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-08-20;340", vigente:true, titulo:"Lei nº 340 de 20/08/1948", urn:"urn:lex:br:federal:lei:1948-08-20;340", ementa:"Autoriza a abertura, pelo Ministério da Agricultura, do crédito especial   para pagamento de gratificação de magistério.", arquivo:"federal/leis-ordinarias/1948/lei-340-1948-08-20.md"}}, {id:"federal:BR:L:313/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-07-30", numero:"313", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-07-30;313", vigente:true, titulo:"Lei nº 313 de 30/07/1948", urn:"urn:lex:br:federal:lei:1948-07-30;313", ementa:"Autoriza o Poder Executivo a Aplicar, provisóriamente, o Acôrdo Geral sôbre Tarifas Aduaneiras e Comércio; reajusta a Tarifa das Alfândegas, e dá outras providências.", arquivo:"federal/leis-ordinarias/1948/lei-313-1948-07-30.md"}}, {id:"federal:BR:L:446/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-10-20", numero:"446", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-10-20;446", vigente:true, titulo:"Lei nº 446 de 20/10/1948", urn:"urn:lex:br:federal:lei:1948-10-20;446", ementa:"Autoriza a abertura, pelo Ministério da Educação e Saúde, de crédito   especial para atender ao pagamento com a impressão dos Anais do VI Congresso   Brasileiro de Higiene.", arquivo:"federal/leis-ordinarias/1948/lei-446-1948-10-20.md"}}, {id:"federal:BR:L:452/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-10-23", numero:"452", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-10-23;452", vigente:true, titulo:"Lei nº 452 de 23/10/1948", urn:"urn:lex:br:federal:lei:1948-10-23;452", ementa:"Autoriza o Poder Executivo a doar à Congregação dos Salesianos uma área do   terreno pertencente à Escola Agro-Técnica de Barbacena, em Minas   Gerais.", arquivo:"federal/leis-ordinarias/1948/lei-452-1948-10-23.md"}}, {id:"federal:BR:L:418/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-10-03", numero:"418", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-10-03;418", vigente:true, titulo:"Lei nº 418 de 03/10/1948", urn:"urn:lex:br:federal:lei:1948-10-03;418", ementa:"Autoriza a abertura, pelo Ministério da Educação e Saúde, de crédito   especial para pagamento da publicação dos \"Anais da IV Conferência Regional de   Tuberculose\".", arquivo:"federal/leis-ordinarias/1948/lei-418-1948-10-03.md"}}, {id:"federal:BR:L:223/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-01-27", numero:"223", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-01-27;223", vigente:true, titulo:"Lei nº 223 de 27/01/1948", urn:"urn:lex:br:federal:lei:1948-01-27;223", ementa:"Autoriza dar garantia, por intermédio do Tesouro Nacional, à operação de   compra d