2", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2018-01-04;13592", vigente:true, titulo:"Lei nº 13.592 de 04/01/2018", urn:"urn:lex:br:federal:lei:2018-01-04;13592", ementa:"Denomina Israel Guedes Ferreira o edifício da Agência Central do INSS no Município de Alagoa Grande, no Estado da Paraíba.", arquivo:"federal/leis-ordinarias/2018/lei-13592-2018-01-04.md"}}, {id:"federal:BR:L:13637/2018", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2018, data:"2018-03-20", numero:"13637", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2018-03-20;13637", vigente:true, titulo:"Lei nº 13.637 de 20/03/2018", urn:"urn:lex:br:federal:lei:2018-03-20;13637", ementa:"Cria a Universidade Federal de Rondonópolis, por desmembramento de campus da Universidade Federal de Mato Grosso.", arquivo:"federal/leis-ordinarias/2018/lei-13637-2018-03-20.md"}}, {id:"federal:BR:L:13630/2018", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2018, data:"2018-02-28", numero:"13630", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2018-02-28;13630", vigente:true, titulo:"Lei nº 13.630 de 28/02/2018", urn:"urn:lex:br:federal:lei:2018-02-28;13630", ementa:"Altera a Lei nº 13.606, de 9 de janeiro de 2018, para prorrogar o prazo de adesão ao Programa de Regularização Tributária Rural (PRR) para 30 de abril de 2018.", arquivo:"federal/leis-ordinarias/2018/lei-13630-2018-02-28.md"}}, {id:"federal:BR:L:13669/2018", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2018, data:"2018-05-30", numero:"13669", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2018-05-30;13669", vigente:true, titulo:"Lei nº 13.669 de 30/05/2018", urn:"urn:lex:br:federal:lei:2018-05-30;13669", ementa:"Autoriza a União a doar recursos ao Estado da Palestina para a restauração da Basílica da Natividade.", arquivo:"federal/leis-ordinarias/2018/lei-13669-2018-05-30.md"}}, {id:"federal:BR:L:13709/2018", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2018, data:"2018-08-14", numero:"13709", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2018-08-14;13709", vigente:true, titulo:"Lei nº 13.709 de 14/08/2018", urn:"urn:lex:br:federal:lei:2018-08-14;13709", ementa:"Lei Geral de Proteção de Dados Pessoais (LGPD).", arquivo:"federal/leis-ordinarias/2018/lei-13709-2018-08-14.md"}}, {id:"federal:BR:L:13765/2018", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2018, data:"2018-12-17", numero:"13765", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2018-12-17;13765", vigente:true, titulo:"Lei nº 13.765 de 17/12/2018", urn:"urn:lex:br:federal:lei:2018-12-17;13765", ementa:"Abre ao Orçamento de Investimento para 2018, em favor da Empresa Gerencial de Projetos Navais - Emgepron, crédito especial no valor de R$ 100.000.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2018/lei-13765-2018-12-17.md"}}, {id:"federal:BR:L:13721/2018", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2018, data:"2018-10-02", numero:"13721", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2018-10-02;13721", vigente:true, titulo:"Lei nº 13.721 de 02/10/2018", urn:"urn:lex:br:federal:lei:2018-10-02;13721", ementa:"Altera o Decreto-Lei nº 3.689, de 3 de outubro de 1941 (Código de Processo Penal), para estabelecer que será dada prioridade à realização do exame de corpo de delito quando se tratar de crime que envolva violência doméstica e familiar contra mulher ou violência contra criança, adolescente, idoso ou pessoa com deficiência.", arquivo:"federal/leis-ordinarias/2018/lei-13721-2018-10-02.md"}}, {id:"federal:BR:L:13646/2018", properties:{esf