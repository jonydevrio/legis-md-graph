2-31.md"}}, {id:"federal:BR:L:981/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-12-17", numero:"981", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-12-17;981", vigente:true, titulo:"Lei nº 981 de 17/12/1949", urn:"urn:lex:br:federal:lei:1949-12-17;981", ementa:"Autoriza a abertura de crédito especial para pagamento de gratificação de   magistério a Raimundo Juliano Rêgo.", arquivo:"federal/leis-ordinarias/1949/lei-981-1949-12-17.md"}}, {id:"federal:BR:L:987/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-12-20", numero:"987", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-12-20;987", vigente:true, titulo:"Lei nº 987 de 20/12/1949", urn:"urn:lex:br:federal:lei:1949-12-20;987", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça Militar -   créditos suplementar e especial, para despesas que especifica.", arquivo:"federal/leis-ordinarias/1949/lei-987-1949-12-20.md"}}, {id:"federal:BR:L:827/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-09-21", numero:"827", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-09-21;827", vigente:true, titulo:"Lei nº 827 de 21/09/1949", urn:"urn:lex:br:federal:lei:1949-09-21;827", ementa:"Concede isenção de direitos para dois motores a serem importados pela   Prefeitura de Campo Maior, Estado do Piauí.", arquivo:"federal/leis-ordinarias/1949/lei-827-1949-09-21.md"}}, {id:"federal:BR:L:963/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-12-08", numero:"963", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-12-08;963", vigente:true, titulo:"Lei nº 963 de 08/12/1949", urn:"urn:lex:br:federal:lei:1949-12-08;