"federal/leis-ordinarias/1978/lei-6534-1978-05-26.md"}}, {id:"federal:BR:L:6618/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-12-16", numero:"6618", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-12-16;6618", vigente:true, titulo:"Lei nº 6.618 de 16/12/1978", urn:"urn:lex:br:federal:lei:1978-12-16;6618", ementa:"Dispõe sobre a alteração da denominação da Fundação Centro Nacional de   Segurança, Higiene e Medicina do Trabalho.", arquivo:"federal/leis-ordinarias/1978/lei-6618-1978-12-16.md"}}, {id:"federal:BR:L:6518/1978", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-03-17", numero:"6518", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-03-17;6518", vigente:true, titulo:"Lei nº 6.518 de 17/03/1978", urn:"urn:lex:br:federal:lei:1978-03-17;6518", ementa:"Reajusta os vencimentos dos servidores do Senado Federal e dá outras providências.", arquivo:"federal/leis-ordinarias/1978/lei-6518-1978-03-17.md"}}, {id:"federal:BR:L:6554/1978", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-08-21", numero:"6554", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-08-21;6554", vigente:true, titulo:"Lei nº 6.554 de 21/08/1978", urn:"urn:lex:br:federal:lei:1978-08-21;6554", ementa:"Dispõe sobre novas inscrições de magistrados federais no Montepio Civil da União e dá outras providências.", arquivo:"federal/leis-ordinarias/1978/lei-6554-1978-08-21.md"}}, {id:"federal:BR:L:6539/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-06-28", numero:"6539", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-06-28;6539", vigente:true, titulo:"Lei nº 6.539 de 28/06/1978", urn:"urn:lex:br:federal:lei:1978-06-28;6539", ementa:"Dispõe sobre a representação judicial das entidades do Sistema Nacional de   Previdência Social nas comarcas do interior do País e a sua representação   administrativa nos municípios onde não possua órgão próprio.", arquivo:"federal/leis-ordinarias/1978/lei-6539-1978-06-28.md"}}, {id:"federal:BR:L:6563/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-09-19", numero:"6563", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-09-19;6563", vigente:true, titulo:"Lei nº 6.563 de 19/09/1978", urn:"urn:lex:br:federal:lei:1978-09-19;6563", ementa:"Cria Juntas de Conciliação e Julgamento nas Regiões da Justiça do Trabalho, define Jurisdições, e dá outras providências.", arquivo:"federal/leis-ordinarias/1978/lei-6563-1978-09-19.md"}}, {id:"federal:BR:L:6601/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-12-07", numero:"6601", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-12-07;6601", vigente:true, titulo:"Lei nº 6.601 de 07/12/1978", urn:"urn:lex:br:federal:lei:1978-12-07;6601", ementa:"Retifica, sem ônus, a Lei n. 6486, de 6 de dezembro de 1977, que \"estima a   Receita e fixa a Despesa da União para o exercício financeiro de   1978\".", arquivo:"federal/leis-ordinarias/1978/lei-6601-1978-12-07.md"}}, {id:"federal:BR:L:6581/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-10-20", numero:"6581", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-10-20;6581", vigente:true, titulo:"Lei nº 6.581 de 20/10/1978", urn:"urn:lex:br:federal:lei:1978-10-20;6581", ementa:"Dispõe sobre cargos em comissão das Secretarias do Tribunal Federal de   Recursos e do Conselho da Justiça Federal, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1978/lei-6581-1978-10-20.md"}}, {id:"federal:BR:L:6524/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-04-11", numero:"6524", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-04-11;6524", vigente:true, titulo:"Lei nº 6.524 de 11/04/1978", urn:"urn:lex:br:federal:lei:1978-04-11;6524", ementa:"Autoriza a União a promover medidas no sentido de tornar efetiva a   conversão das ações ordinárias que possua no capital da Indústria Carboquímica   Catarinense - ICC, em ações preferenciais sem direito a voto e dá outras   providências.", arquivo:"federal/leis-ordinarias/1978/lei-6524-1978-04-11.md"}}, {id:"federal:BR:L:6610/1978", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-12-07", numero:"6610", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-12-07;6610", vigente:true, titulo:"Lei nº 6.610 de 07/12/1978", urn:"urn:lex:br:federal:lei:1978-12-07;6610", ementa:"Concede pensão especial a Walter dos Santos Siqueira e dá outras providências.", arquivo:"federal/leis-ordinarias/1978/lei-6610-1978-12-07.md"}}, {id:"federal:BR:L:6567/1978", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-09-24", numero:"6567", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-09-24;6567", vigente:true, titulo:"Lei nº 6.567 de 24/09/1978", urn:"urn:lex:br:federal:lei:1978-09-24;6567", ementa:"Dispõe sobre regime especial para exploração e o aproveitamento das substâncias minerais que especifica e dá outras providências.", arquivo:"federal/leis-ordinarias/1978/lei-6567-1978-09-24.md"}}, {id:"federal:BR:L:6578/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-10-11", numero:"6578", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-10-11;6578", vigente:true, titulo:"Lei nº 6.578 de 11/10/1978", urn:"urn:lex:br:federal:lei:1978-10-11;6578", ementa:"Revoga o Decreto-lei nº 1.004, de 21 de outubro de 1969, e as Leis nºs 6.016,   de 1973, e 6.063 de 1974.", arquivo:"federal/leis-ordinarias/1978/lei-6578-1978-10-11.md"}}, {id:"federal:BR:L:6580/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-10-18", numero:"6580", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-10-18;6580", vigente:true, titulo:"Lei nº 6.580 de 18/10/1978", urn:"urn:lex:br:federal:lei:1978-10-18;6580", ementa:"Altera a redação do art. 1º da Lei nº 6.466, de 14 de novembro de   1977.", arquivo:"federal/leis-ordinarias/1978/lei-6580-1978-10-18.md"}}, {id:"federal:BR:L:6529/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-05-11", numero:"6529", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-05-11;6529", vigente:true, titulo:"Lei nº 6.529 de 11/05/1978", urn:"urn:lex:br:federal:lei:1978-05-11;6529", ementa:"Autoriza a reversão, ao Município de Santarém, Estado do Pará, do imóvel   que menciona.", arquivo:"federal/leis-ordinarias/1978/lei-6529-1978-05-11.md"}}, {id:"federal:BR:L:6616/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-12-16", numero:"6616", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-12-16;6616", vigente:true, titulo:"Lei nº 6.616 de 16/12/1978", urn:"urn:lex:br:federal:lei:1978-12-16;6616", ementa:"Acrescenta artigos à Lei n. 6385, de 7 de dezembro de 1976, que dispõe   sobre o mercado de valores mobiliários e cria a Comissão de Valores   Mobiliários.", arquivo:"federal/leis-ordinarias/1978/lei-6616-1978-12-16.md"}}, {id:"federal:BR:L:6607/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-12-07", numero:"6607", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-12-07;6607", vigente:true, titulo:"Lei nº 6.607 de 07/12/1978", urn:"urn:lex:br:federal:lei:1978-12-07;6607", ementa:"Declara o Pau-Brasil árvore nacional, institui o Dia do Pau-Brasil, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1978/lei-6607-1978-12-07.md"}}, {id:"federal:BR:L:6551/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-07-05", numero:"6551", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-07-05;6551", vigente:true, titulo:"Lei nº 6.551 de 05/07/1978", urn:"urn:lex:br:federal:lei:1978-07-05;6551", ementa:"Concede ao Distrito Federal isenção do pagamento de custas e emolumentos   relativos à prática de quaisquer atos, pelos Ofícios e Cartórios de Registro de   Imóveis, de Registro de Títulos e Documentos e de Notas, situados dentro de seus   limites territóriais.", arquivo:"federal/leis-ordinarias/1978/lei-6551-1978-07-05.md"}}, {id:"federal:BR:L:6545/1978", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-06-30", numero:"6545", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-06-30;6545", vigente:true, titulo:"Lei nº 6.545 de 30/06/1978", urn:"urn:lex:br:federal:lei:1978-06-30;6545", ementa:"Dispõe sobre a transformação das Escolas Técnicas Federais de Minas Gerais, do Paraná e Celso Suckow da Fonseca em Centros Federais de Educação Tecnológica e dá outras providências.", arquivo:"federal/leis-ordinarias/1978/lei-6545-1978-06-30.md"}}, {id:"federal:BR:L:6589/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-11-16", numero:"6589", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-11-16;6589", vigente:true, titulo:"Lei nº 6.589 de 16/11/1978", urn:"urn:lex:br:federal:lei:1978-11-16;6589", ementa:"Autoriza o Poder Executivo a abrir, a Transferências a Estados, Distrito   Federal e Municípios - Transferências ao Governo do Distrito Federal, o crédito   especial de até Cr$ 38.005.300,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/1978/lei-6589-1978-11-16.md"}}, {id:"federal:BR:L:6577/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-09-30", numero:"6577", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-09-30;6577", vigente:true, titulo:"Lei nº 6.577 de 30/09/1978", urn:"urn:lex:br:federal:lei:1978-09-30;6577", ementa:"Dispõe sobre o Conselho de Justificação da Polícia Militar e do Corpo de Bombeiros do Distrito Federal, e dá outras providências.", arquivo:"federal/leis-ordinarias/1978/lei-6577-1978-09-30.md"}}, {id:"federal:BR:L:6562/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-09-18", numero:"6562", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-09-18;6562", vigente:true, titulo:"Lei nº 6.562 de 18/09/1978", urn:"urn:lex:br:federal:lei:1978-09-18;6562", ementa:"Altera a redação dos artigos 48 e 169 do Decreto-Lei nº 37, de 18 de novembro de 1966, e dá outras providências.", arquivo:"federal/leis-ordinarias/1978/lei-6562-1978-09-18.md"}}, {id:"federal:BR:L:6553/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-08-19", numero:"6553", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-08-19;6553", vigente:true, titulo:"Lei nº 6.553 de 19/08/1978", urn:"urn:lex:br:federal:lei:1978-08-19;6553", ementa:"Altera e acrescenta parágrafo ao artigo 101 da Lei n. 4737, de 15 de julho   de 1965 (dispõe sobre o preenchimento de vaga e a substituição de candidato às   eleições proporcionais ou majoritárias).", arquivo:"federal/leis-ordinarias/1978/lei-6553-1978-08-19.md"}}, {id:"federal:BR:L:6579/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-10-18", numero:"6579", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-10-18;6579", vigente:true, titulo:"Lei nº 6.579 de 18/10/1978", urn:"urn:lex:br:federal:lei:1978-10-18;6579", ementa:"Autoriza o Distrito Federal a contrair empréstimos destinados a cobrir as   despesas com a sua participação no Plano Nacional de Habitação Popular - PLANHAP   - e dá outras providências.", arquivo:"federal/leis-ordinarias/1978/lei-6579-1978-10-18.md"}}, {id:"federal:BR:L:6557/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-09-05", numero:"6557", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-09-05;6557", vigente:true, titulo:"Lei nº 6.557 de 05/09/1978", urn:"urn:lex:br:federal:lei:1978-09-05;6557", ementa:"Dispõe sobre doação, à União, pelo Distrito Federal, de bens móveis   colocados à disposição da Presidência da República em 17 de novembro de   1967.", arquivo:"federal/leis-ordinarias/1978/lei-6557-1978-09-05.md"}}, {id:"federal:BR:L:6537/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-06-19", numero:"6537", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-06-19;6537", vigente:true, titulo:"Lei nº 6.537 de 19/06/1978", urn:"urn:lex:br:federal:lei:1978-06-19;6537", ementa:"Altera dispositivos da Lei n° ;1.411, de 13 de agosto de 1951, que   \"dispõe sobre a profissão de Economista\".", arquivo:"federal/leis-ordinarias/1978/lei-6537-1978-06-19.md"}}, {id:"federal:BR:L:6555/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-08-22", numero:"6555", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-08-22;6555", vigente:true, titulo:"Lei nº 6.555 de 22/08/1978", urn:"urn:lex:br:federal:lei:1978-08-22;6555", ementa:"Altera a Relação Descritiva das Rodovias do Plano Nacional de Viação,   aprovado pela Lei n. 5917, de 10 de setembro de 1973.", arquivo:"federal/leis-ordinarias/1978/lei-6555-1978-08-22.md"}}, {id:"federal:BR:L:6586/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-11-06", numero:"6586", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-11-06;6586", vigente:true, titulo:"Lei nº 6.586 de 06/11/1978", urn:"urn:lex:br:federal:lei:1978-11-06;6586", ementa:"Classifica o comerciante ambulante para fins trabalhistas e   previdenciários.", arquivo:"federal/leis-ordinarias/1978/lei-6586-1978-11-06.md"}}, {id:"federal:BR:L:6536/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-06-16", numero:"6536", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-06-16;6536", vigente:true, titulo:"Lei nº 6.536 de 16/06/1978", urn:"urn:lex:br:federal:lei:1978-06-16;6536", ementa:"Dá nova redação a dispositivos do Decreto-lei nº 835, de 8 de setembro de 1969, e da Lei nº 5.692, de 11 de agosto de 1971.", arquivo:"federal/leis-ordinarias/1978/lei-6536-1978-06-16.md"}}, {id:"federal:BR:L:6599/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-12-01", numero:"6599", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-12-01;6599", vigente:true, titulo:"Lei nº 6.599 de 01/12/1978", urn:"urn:lex:br:federal:lei:1978-12-01;6599", ementa:"Estima a Receita e fixa a Despesa do Distrito Federal para o Exercício Financeiro de 1979.", arquivo:"federal/leis-ordinarias/1978/lei-6599-1978-12-01.md"}}, {id:"federal:BR:L:6573/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-09-30", numero:"6573", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-09-30;6573", vigente:true, titulo:"Lei nº 6.573 de 30/09/1978", urn:"urn:lex:br:federal:lei:1978-09-30;6573", ementa:"Autoriza o Instituto Nacional de Colonização e Reforma Agrária - INCRA - a   doar os imóveis que menciona.", arquivo:"federal/leis-ordinarias/1978/lei-6573-1978-09-30.md"}}, {id:"federal:BR:L:6542/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-06-28", numero:"6542", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-06-28;6542", vigente:true, titulo:"Lei nº 6.542 de 28/06/1978", urn:"urn:lex:br:federal:lei:1978-06-28;6542", ementa:"Dispõe sobre incentivos fiscais para programas de formação profissional e   alimentação do trabalhador nas áreas da SUDENE e da SUDAM.", arquivo:"federal/leis-ordinarias/1978/lei-6542-1978-06-28.md"}}, {id:"federal:BR:L:6547/1978", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-07-04", numero:"6547", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-07-04;6547", vigente:true, titulo:"Lei nº 6.547 de 04/07/1978", urn:"urn:lex:br:federal:lei:1978-07-04;6547", ementa:"Dá nova redação a dispositivos das Leis nº 6.022, de 3 de janeiro de 1974   (Estatuto dos bombeiros-militares do Corpo de Bombeiros do Distrito Federal) e   nº 6.023, de 3 de janeiro de 1974 (Estatuto dos policiais-militares da Polícia   Militar do Distrito Federal).", arquivo:"federal/leis-ordinarias/1978/lei-6547-1978-07-04.md"}}, {id:"federal:BR:L:6603/1978", properties:{esfera:"federal