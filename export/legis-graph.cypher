6-1870-07-08.md"}}, {id:"federal:BR:L:1765/1870", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1870, data:"1870-06-28", numero:"1765", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1870-06-28;1765", vigente:true, titulo:"Lei nº 1.765 de 28/06/1870", urn:"urn:lex:br:federal:lei:1870-06-28;1765", ementa:"FIXA AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1870-71.", arquivo:"federal/leis-ordinarias/1870/lei-1765-1870-06-28.md"}}, {id:"federal:BR:L:1904/1870", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1870, data:"1870-10-17", numero:"1904", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1870-10-17;1904", vigente:true, titulo:"Lei nº 1.904 de 17/10/1870", urn:"urn:lex:br:federal:lei:1870-10-17;1904", ementa:"ESTABELECE PARA SUA ALTEZA IMPERIAL A SENHORA DONA IZABEL CHIRSTINA E SEU AUGUSTO ESPOSO, NOS TERMOS DO RESPECTIVO CONTRATO MATRIMONIAL,UM PATRIMÔNIO EM TERRAS NAS PROVÍNCIAS DE SANTA CATARINA E SERGIPE.", arquivo:"federal/leis-ordinarias/1870/lei-1904-1870-10-17.md"}}, {id:"federal:BR:L:1843/1870", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1870, data:"1870-10-06", numero:"1843", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1870-10-06;1843", vigente:true, titulo:"Lei nº 1.843 de 06/10/1870", urn:"urn:lex:br:federal:lei:1870-10-06;1843", ementa:"FIXA AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1871 A 1872.", arquivo:"federal/leis-ordinarias/1870/lei-1843-1870-10-06.md"}}, {id:"federal:BR:L:1837/1870", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1870, data:"1870-09-27", numero:"1837", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1870-09-27;1837", vigente:true, titulo:"Lei nº 1.837 de 27/09/1870", urn:"urn:lex:br:federal:lei:1870-09-27;1837", ementa:"AUTORIZA O GOVERNO A DESPENDER A QUANTIA DE 450:000$ PARA FAZER CUNHAR E PÔR EM CIRCULAÇÃO CEM MIL QUILOGRAMOS DE MOEDA DE NÍQUEL.", arquivo:"federal/leis-ordinarias/1870/lei-1837-1870-09-27.md"}}, {id:"federal:BR:L:1805/1870", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1870, data:"1870-08-12", numero:"1805", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1870-08-12;1805", vigente:true, titulo:"Lei nº 1.805 de 12/08/1870", urn:"urn:lex:br:federal:lei:1870-08-12;1805", ementa:"FIXA A FORÇA NAVAL PARA O ANO FINANCEIRO DE 1871-1872.", arquivo:"federal/leis-ordinarias/1870/lei-1805-1870-08-12.md"}}, {id:"federal:BR:L:1818/1870", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1870, data:"1870-09-06", numero:"1818", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1870-09-06;1818", vigente:true, titulo:"Lei nº 1.818 de 06/09/1870", urn:"urn:lex:br:federal:lei:1870-09-06;1818", ementa:"ABRE AO MINISTERIO DO IMPERIO UM CREDITO SUPLEMENTAR PARA DESPESAS DA VERBA - SOCORROS PUBLICOS E MELHORAMENTO DO ESTADO SANITARIO - DO EXERCICIO DE 1869-1870.", arquivo:"federal/leis-ordinarias/1870/lei-1818-1870-09-06.md"}}, {id:"federal:BR:L:1836/1870", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1870, data:"1870-09-27", numero:"1836", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1870-09-27;1836", vigente:true, titulo:"Lei nº 1.836 de 27/09/1870", urn:"urn:lex:br:federal:lei:1870-09-27;1836", ementa:"FIXA A DESPESA E ORÇA A RECEITA GERAL DO IMPÉRIO PARA O EXERCÍCIO DE 1871-1872, E DÁ OUTRAS PROVIDÊNCIAS.", arquivo:"federal/leis-ordinarias/1870/lei-1836-1870-09-27.md"}}, {id:"federal:BR:L:1905/1870", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1870, data:"1870-10-17", numero:"1905", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1870-10-17;1905", vigente:true, titulo:"Lei nº 1.905 de 17/10/1870", urn:"urn:lex:br:federal:lei:1870-10-17;1905", ementa:"ESTABELECE PARA SUA ALTEZA IMPERIAL A SENHORA DONA LEOPOLDINA  E SEU AUGUSTO ESPOSO, NOS TERMOS DO RESPECTIVO CONTRATO MATRIMONIAL, UM PATRIMONIO EM TERRAS NAS PROVINCIAS DO PARANA E ESPIRITO SANTO.", arquivo:"federal/leis-ordinarias/1870/lei-1905-1870-10-17.md"}}, {id:"federal:BR:L:1832/1870", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1870, data:"1870-09-09", numero:"1832", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1870-09-09;1832", vigente:true, titulo:"Lei nº 1.832 de 09/09/1870", urn:"urn:lex:br:federal:lei:1870-09-09;1832", ementa:"AUTORIZA O GOVERNO A DESPENDER ATE A QUANTIA DE 1.000:00$000, COM O ABASTECIMENTO D'AGUA A CAPITAL DO IMPERIO, E A DESAPROPIAR OS TERRENOS E PREDIOS INDISPENSAVEIS A AQUISIÇÃO, CONSERVAÇÃO E DISTRIBUIÇÃO DOS MANANCIAIS.", arquivo:"federal/leis-ordinarias/1870/lei-1832-1870-09-09.md"}}, {id:"federal:BR:L:1829/1870", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1870, data:"1870-09-09", numero:"1829", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1870-09-09;1829", vigente:true, titulo:"Lei nº 1.829 de 09/09/1870", urn:"urn:lex:br:federal:lei:1870-09-09;1829", ementa:"SANCIONA O DECRETO DA ASSEMBLEIA GERAL QUE MANDA PROCEDER O RECENSEAMENTO DA POPULAÇÃO DO IMPERIO.", arquivo:"federal/leis-ordinarias/1870/lei-1829-1870-09-09.md"}}, {id:"federal:BR:L:1764/1870", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1870, data:"1870-06-28", numero:"1764", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1870-06-28;1764", vigente:true, titulo:"Lei nº 1.764 de 28/06/1870", urn:"urn:lex:br:federal:lei:1870-06-28;1764", ementa:"FIXA A DESPESA E ORÇA A RECEITA GERAL DO IMPÉRIO PARA O EXERCÍCIO DE 1870-1871, E DÁ OUTRAS PROVIDÊNCIAS.", arquivo:"federal/leis-ordinarias/1870/lei-1764-1870-06-28.md"}}, {id:"federal:BR:L:5460/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-06-24", numero:"5460", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-06-24;5460", vigente:true, titulo:"Lei nº 5.460 de 24/06/1968", urn:"urn:lex:br:federal:lei:1968-06-24;5460", ementa:"Dispõe sobre a isenção estabelecida pelo Decreto-lei nº 332, de 12 de outubro de 1967.", arquivo:"federal/leis-ordinarias/1968/lei-5460-1968-06-24.md"}}, {id:"federal:BR:L:5481/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-08-10", numero:"5481", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-08-10;5481", vigente:true, titulo:"Lei nº 5.481 de 10/08/1968", urn:"urn:lex:br:federal:lei:1968-08-10;5481", ementa:"Revigora o prazo estabelecido pelo art. 1º do Decreto-lei nº 148, de 8 de   fevereiro de 1967, que dispõe sobre a organização da vida rural, investidura das   Associações Rurais, nas funções e prerrogativas do órgão sindical.", arquivo:"federal/leis-ordinarias/1968/lei-5481-1968-08-10.md"}}, {id:"federal:BR:L:5553/1968", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-12-06", numero:"5553", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-12-06;5553", vigente:true, titulo:"Lei nº 5.553 de 06/12/1968", urn:"urn:lex:br:federal:lei:1968-12-06;5553", ementa:"Dispõe sobre a apresentação e uso de documentos de identificação pessoal.", arquivo:"federal/leis-ordinarias/1968/lei-5553-1968-12-06.md"}}, {id:"federal:BR:L:5529/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-11-13", numero:"5529", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-11-13;5529", vigente:true, titulo:"Lei nº 5.529 de 13/11/1968", urn:"urn:lex:br:federal:lei:1968-11-13;5529", ementa:"Autoriza o Poder Executivo a abrir ao Ministério do Interior, em favor da   Superintendência do Desenvolvimento da Região Centro-Oeste, o crédito especial   de NCr$ 6.000.000,00 ( seis milhões de cruzeiros novos ), para fins que   especifica, e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5529-1968-11-13.md"}}, {id:"federal:BR:L:5463/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-07-02", numero:"5463", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-07-02;5463", vigente:true, titulo:"Lei nº 5.463 de 02/07/1968", urn:"urn:lex:br:federal:lei:1968-07-02;5463", ementa:"Declara prescritas as contas que menciona e dá outras   providências.", arquivo:"federal/leis-ordinarias/1968/lei-5463-1968-07-02.md"}}, {id:"federal:BR:L:5417/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-15", numero:"5417", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-15;5417", vigente:true, titulo:"Lei nº 5.417 de 15/04/1968", urn:"urn:lex:br:federal:lei:1968-04-15;5417", ementa:"Autoriza o Poder Executivo a permutar imóvel de propriedade da União com a   Associação Leopoldina Juvenil, na cidade de Porto Alegre, Estado do Rio Grande   do Sul.", arquivo:"federal/leis-ordinarias/1968/lei-5417-1968-04-15.md"}}, {id:"federal:BR:L:5384/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-02-14", numero:"5384", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-02-14;5384", vigente:true, titulo:"Lei nº 5.384 de 14/02/1968", urn:"urn:lex:br:federal:lei:1968-02-14;5384", ementa:"Concede estimulos à indústria de artefatos têxteis e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5384-1968-02-14.md"}}, {id:"federal:BR:L:5538/1968", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-11-22", numero:"5538", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-11-22;5538", vigente:true, titulo:"Lei nº 5.538 de 22/11/1968", urn:"urn:lex:br:federal:lei:1968-11-22;5538", ementa:"Dispõe sobre a organização do Tribunal de Contas do Distrito Federal, e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5538-1968-11-22.md"}}, {id:"federal:BR:L:5429/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-30", numero:"5429", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-30;5429", vigente:true, titulo:"Lei nº 5.429 de 30/04/1968", urn:"urn:lex:br:federal:lei:1968-04-30;5429", ementa:"Reajusta os vencimentos dos funcionários das Secretarias da Justiça do Trabalho.", arquivo:"federal/leis-ordinarias/1968/lei-5429-1968-04-30.md"}}, {id:"federal:BR:L:5438/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-05-20", numero:"5438", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-05-20;5438", vigente:true, titulo:"Lei nº 5.438 de 20/05/1968", urn:"urn:lex:br:federal:lei:1968-05-20;5438", ementa:"Altera o art. 4 do Decreto-Lei nº 221, de 28 de fevereiro de 1967, que dispõe sobre a proteção e estímulos à pesca, e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5438-1968-05-20.md"}}, {id:"federal:BR:L:5386/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-02-21", numero:"5386", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-02-21;5386", vigente:true, titulo:"Lei nº 5.386 de 21/02/1968", urn:"urn:lex:br:federal:lei:1968-02-21;5386", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Comunicações, o crédito especial de Ncr$ 2.000.000,00 (dois milhões de cruzeiros novos), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1968/lei-5386-1968-02-21.md"}}, {id:"federal:BR:L:5541/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-11-28", numero:"5541", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-11-28;5541", vigente:true, titulo:"Lei nº 5.541 de 28/11/1968", urn:"urn:lex:br:federal:lei:1968-11-28;5541", ementa:"Revigora o prazo previsto no item IX, alínea \"b\" do art. 1º. da Lei nº 4.622, de 3 de maio de 1965, que concede isenção de tributos para importação de bens e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5541-1968-11-28.md"}}, {id:"federal:BR:L:5548/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-12-02", numero:"5548", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-12-02;5548", vigente:true, titulo:"Lei nº 5.548 de 02/12/1968", urn:"urn:lex:br:federal:lei:1968-12-02;5548", ementa:"Estima a Receita e fixa Despesa do Distrito Federal para o Exercício financeiro de 1969.", arquivo:"federal/leis-ordinarias/1968/lei-5548-1968-12-02.md"}}, {id:"federal:BR:L:5404/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-03-29", numero:"5404", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-03-29;5404", vigente:true, titulo:"Lei nº 5.404 de 29/03/1968", urn:"urn:lex:br:federal:lei:1968-03-29;5404", ementa:"Altera e revoga dispositivos do Decreto-Lei nº 205, de 27 de fevereiro de   1967, que dispõe sobre a organização, funcionamento e extinção de aeroclubes, e   dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5404-1968-03-29.md"}}, {id:"federal:BR:L:5405/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-09", numero:"5405", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-09;5405", vigente:true, titulo:"Lei nº 5.405 de 09/04/1968", urn:"urn:lex:br:federal:lei:1968-04-09;5405", ementa:"Estende à Comarca de Leopoldina a Jurisdição da Junta de Conciliação e   Julgamento de Cataguases, no Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/1968/lei-5405-1968-04-09.md"}}, {id:"federal:BR:L:5473/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-07-10", numero:"5473", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-07-10;5473", vigente:true, titulo:"Lei nº 5.473 de 10/07/1968", urn:"urn:lex:br:federal:lei:1968-07-10;5473", ementa:"Regula o provimento de cargos e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5473-1968-07-10.md"}}, {id:"federal:BR:L:5435/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-05-14", numero:"5435", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-05-14;5435", vigente:true, titulo:"Lei nº 5.435 de 14/05/1968", urn:"urn:lex:br:federal:lei:1968-05-14;5435", ementa:"Reajusta a pensão especial concedida a Nicolau Janrô, ex-extranumerário   diarista do Arsenal de Marinha do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1968/lei-5435-1968-05-14.md"}}, {id:"federal:BR:L:5414/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-10", numero:"5414", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-10;5414", vigente:true, titulo:"Lei nº 5.414 de 10/04/1968", urn:"urn:lex:br:federal:lei:1968-04-10;5414", ementa:"Altera o Quadro do Pessoal da Secretaria do Tribunal Federal de Recursos e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5414-1968-04-10.md"}}, {id:"federal:BR:L:5504/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-10-04", numero:"5504", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-10-04;5504", vigente:true, titulo:"Lei nº 5.504 de 04/10/1968", urn:"urn:lex:br:federal:lei:1968-10-04;5504", ementa:"Modifica dispositivo da Lei nº 4.908, de 17 de dezembro de 1965 e transfere   ações da União para a ELETROBRÁS.", arquivo:"federal/leis-ordinarias/1968/lei-5504-1968-10-04.md"}}, {id:"federal:BR:L:5511/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-10-15", numero:"5511", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-10-15;5511", vigente:true, titulo:"Lei nº 5.511 de 15/10/1968", urn:"urn:lex:br:federal:lei:1968-10-15;5511", ementa:"Submete a Campanha Nacional Contra a Lepra ao regime previsto na Lei nº   5.026, de 14 de junho de 1966, e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5511-1968-10-15.md"}}, {id:"federal:BR:L:5493/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-09-05", numero:"5493", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-09-05;5493", vigente:true, titulo:"Lei nº 5.493 de 05/09/1968", urn:"urn:lex:br:federal:lei:1968-09-05;5493", ementa:"Concede pensão especial à Senhora Joaquina Gomes de Araújo Lima, viúva de   Joaquim de Araújo Lima, falecido em acidente em serviço, no exercício do cargo   de Engenheiro da Estrada de Ferro Madeira-Mamoré.", arquivo:"federal/leis-ordinarias/1968/lei-5493-1968-09-05.md"}}, {id:"federal:BR:L:5530/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-11-13", numero:"5530", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-11-13;5530", vigente:true, titulo:"Lei nº 5.530 de 13/11/1968", urn:"urn:lex:br:federal:lei:1968-11-13;5530", ementa:"Dispõe sobre o exercício da profissão de químico pelos portadores de   carteira expedida pelo Ministério do Trabalho e Previdência Social, até o   advento da Lei nº 2.800, de 18 de junho de 1956.", arquivo:"federal/leis-ordinarias/1968/lei-5530-1968-11-13.md"}}, {id:"federal:BR:L:5521/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-11-04", numero:"5521", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-11-04;5521", vigente:true, titulo:"Lei nº 5.521 de 04/11/1968", urn:"urn:lex:br:federal:lei:1968-11-04;5521", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério dos Transporte, o   créditos especial de NCr$ 11.000.000,00 ( onze milhões de cruzeiros novos ),   para o fim que menciona.", arquivo:"federal/leis-ordinarias/1968/lei-5521-1968-11-04.md"}}, {id:"federal:BR:L:5455/1968", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-06-19", numero:"5455", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-06-19;5455", vigente:true, titulo:"Lei nº 5.455 de 19/06/1968", urn:"urn:lex:br:federal:lei:1968-06-19;5455", ementa:"Altera dispositivos da Lei nº 4.380, de 21 de agosto de 1964, que institui a correção monetária nos contratos imobiliários, de interesse social, o sistema financeiro para aquisição da casa própria, cria o Banco Nacional de Habitação (BNH), e sociedade de Crédito Imobiliário, as Letras Imobiliárias, o Serviço Federal de Habitação e Urbanismo, e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5455-1968-06-19.md"}}, {id:"federal:BR:L:5507/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-10-10", numero:"5507", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-10-10;5507", vigente:true, titulo:"Lei nº 5.507 de 10/10/1968", urn:"urn:lex:br:federal:lei:1968-10-10;5507", ementa:"Estabelece prioridade para matrícula nos estabelecimentos de ensino público de curso médio e dispõe sobre a concessão de bolsas de estudo para os filhos de ex-combatentes e órfãos menores carentes de recursos.", arquivo:"federal/leis-ordinarias/1968/lei-5507-1968-10-10.md"}}, {id:"federal:BR:L:5514/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-10-21", numero:"5514", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-10-21;5514", vigente:true, titulo:"Lei nº 5.514 de 21/10/1968", urn:"urn:lex:br:federal:lei:1968-10-21;5514", ementa:"Autoriza o Ministro da Fazenda a conceder remissão de crédito   tributário.", arquivo:"federal/leis-ordinarias/1968/lei-5514-1968-10-21.md"}}, {id:"federal:BR:L:5430/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-05-02", numero:"5430", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-05-02;5430", vigente:true, titulo:"Lei nº 5.430 de 02/05/1968", urn:"urn:lex:br:federal:lei:1968-05-02;5430", ementa:"Reajusta os vencimentos dos servidores da Justiça Militar.", arquivo:"federal/leis-ordinarias/1968/lei-5430-1968-05-02.md"}}, {id:"federal:BR:L:5476/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-07-24", numero:"5476", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-07-24;5476", vigente:true, titulo:"Lei nº 5.476 de 24/07/1968", urn:"urn:lex:br:federal:lei:1968-07-24;5476", ementa:"Autoriza o Poder Executivo a constituir a sociedade de economia mista   Banco de Roraima S.A.", arquivo:"federal/leis-ordinarias/1968/lei-5476-1968-07-24.md"}}, {id:"federal:BR:L:5458/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-06-21", numero:"5458", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-06-21;5458", vigente:true, titulo:"Lei nº 5.458 de 21/06/1968", urn:"urn:lex:br:federal:lei:1968-06-21;5458", ementa:"Dispõe sobre os vencimentos do Pessoal dos Serviços Auxiliares da Justiça Federal de Primeira Instância.", arquivo:"federal/leis-ordinarias/1968/lei-5458-1968-06-21.md"}}, {id:"federal:BR:L:5544/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-11-29", numero:"5544", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-11-29;5544", vigente:true, titulo:"Lei nº 5.544 de 29/11/1968", urn:"urn:lex:br:federal:lei:1968-11-29;5544", ementa:"Autoriza o Poder Executivo a abrir ao Ministério dos Transportes, em favor do Grupo Executivo de Integração da Política de Transportes (GEIPOT), o crédito especial de NCr$ 2.800.000,00 (dois milhões e oitocentos mil cruzeiros novos), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1968/lei-5544-1968-11-29.md"}}, {id:"federal:BR:L:5491/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-09-03", numero:"5491", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-09-03;5491", vigente:true, titulo:"Lei nº 5.491 de 03/09/1968", urn:"urn:lex:br:federal:lei:1968-09-03;5491", ementa:"Autoriza o Poder Executivo a abrir ao Ministério da Educação e Cultura, em   favor da Escola de Engenharia Industrial do Rio Grande, o crédito especial de   NC$ 32.460,00 ( trinta e dois mil, quatrocentos e sessenta cruzeiros novos ),   para o fim que especifica.", arquivo:"federal/leis-ordinarias/1968/lei-5491-1968-09-03.md"}}, {id:"federal:BR:L:5400/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-03-21", numero:"5400", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-03-21;5400", vigente:true, titulo:"Lei nº 5.400 de 21/03/1968", urn:"urn:lex:br:federal:lei:1968-03-21;5400", ementa:"Provê sobre a alfabetização de adultos em idade militar.", arquivo:"federal/leis-ordinarias/1968/lei-5400-1968-03-21.md"}}, {id:"federal:BR:L:5437/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-05-16", numero:"5437", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-05-16;5437", vigente:true, titulo:"Lei nº 5.437 de 16/05/1968", urn:"urn:lex:br:federal:lei:1968-05-16;5437", ementa:"Altera os Quadros Permanente e Provisório do Distrito Federal e dá outras   providências.", arquivo:"federal/leis-ordinarias/1968/lei-5437-1968-05-16.md"}}, {id:"federal:BR:L:5503/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-10-01", numero:"5503", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-10-01;5503", vigente:true, titulo:"Lei nº 5.503 de 01/10/1968", urn:"urn:lex:br:federal:lei:1968-10-01;5503", ementa:"Dá nova redação ao art. 1º da Lei nº 5.311, de 18 de agosto de 1967, que   dispõe sobre a criação de cargos no Quadro de Pessoal do Ministério do Exército   para melhor atender às organizações de saúde do Exército.", arquivo:"federal/leis-ordinarias/1968/lei-5503-1968-10-01.md"}}, {id:"federal:BR:L:5470/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-07-08", numero:"5470", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-07-08;5470", vigente:true, titulo:"Lei nº 5.470 de 08/07/1968", urn:"urn:lex:br:federal:lei:1968-07-08;5470", ementa:"Autoriza o Poder Executivo a promover, por ato de bravura, o Cabo da   Aeronáutica Nelson Odir da Silva Barros.", arquivo:"federal/leis-ordinarias/1968/lei-5470-1968-07-08.md"}}, {id:"federal:BR:L:5399/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-03-20", numero:"5399", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-03-20;5399", vigente:true, titulo:"Lei nº 5.399 de 20/03/1968", urn:"urn:lex:br:federal:lei:1968-03-20;5399", ementa:"Dá nova redação ao artigo 75 da Lei nº 5.292, de 8 de junho de 1967, que   dispõe sôbre a prestação do Serviço Militar pelos estudantes de Medicina,   Farmácia, Odontologia e Veterinária e pelos médicos, Farmacêuticos, Dentistas e   Veterinários.", arquivo:"federal/leis-ordinarias/1968/lei-5399-1968-03-20.md"}}, {id:"federal:BR:L:5425/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-29", numero:"5425", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-29;5425", vigente:true, titulo:"Lei nº 5.425 de 29/04/1968", urn:"urn:lex:br:federal:lei:1968-04-29;5425", ementa:"Dispõe sobre serviços de despachantes aduaneiros e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5425-1968-04-29.md"}}, {id:"federal:BR:L:5518/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-10-29", numero:"5518", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-10-29;5518", vigente:true, titulo:"Lei nº 5.518 de 29/10/1968", urn:"urn:lex:br:federal:lei:1968-10-29;5518", ementa:"Altera o artigo 3º da Lei nº 2.391, de 7 de janeiro de 1955 alterada pela   Lei nº 4.446, de 20 de outubro de 1964.", arquivo:"federal/leis-ordinarias/1968/lei-5518-1968-10-29.md"}}, {id:"federal:BR:L:5409/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-09", numero:"5409", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-09;5409", vigente:true, titulo:"Lei nº 5.409 de 09/04/1968", urn:"urn:lex:br:federal:lei:1968-04-09;5409", ementa:"Autoriza o Tesouro Nacional a promover a elevação do capital da Companhia   Siderúrgica Nacional, e garantir empréstimo externo para ampliar as instalações   industriais da Usina de Volta Redonda e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5409-1968-04-09.md"}}, {id:"federal:BR:L:5469/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-07-08", numero:"5469", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-07-08;5469", vigente:true, titulo:"Lei nº 5.469 de 08/07/1968", urn:"urn:lex:br:federal:lei:1968-07-08;5469", ementa:"Dispõe sôbre o Conselho Nacional de Turismo.", arquivo:"federal/leis-ordinarias/1968/lei-5469-1968-07-08.md"}}, {id:"federal:BR:L:5421/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-25", numero:"5421", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-25;5421", vigente:true, titulo:"Lei nº 5.421 de 25/04/1968", urn:"urn:lex:br:federal:lei:1968-04-25;5421", ementa:"Dispõe sôbre medidas financeiras referentes à arrecadação da Dívida Ativa da União, juros de mora nos débitos para com a Fazenda Nacional e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5421-1968-04-25.md"}}, {id:"federal:BR:L:5516/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-10-23", numero:"5516", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-10-23;5516", titulo:"Lei nº 5.516 de 23/10/1968", vigente:true, urn:"urn:lex:br:federal:lei:1968-10-23;5516", ementa:"Institui o Dia do Município.", arquivo:"federal/leis-ordinarias/1968/lei-5516-1968-10-23.md"}}, {id:"federal:BR:L:5497/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-09-05", numero:"5497", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-09-05;5497", vigente:true, titulo:"Lei nº 5.497 de 05/09/1968", urn:"urn:lex:br:federal:lei:1968-09-05;5497", ementa:"Dispõe sôbre a elevação da cobrança do sêlo da taxa adicional para NCr$   0,05 (cinco centavos) a que se refere a Lei nº 909, de 8 de novembro de 1949,   que autoriza emissão de selos em benefício dos filhos de lázaros.", arquivo:"federal/leis-ordinarias/1968/lei-5497-1968-09-05.md"}}, {id:"federal:BR:L:5561/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-12-12", numero:"5561", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-12-12;5561", vigente:true, titulo:"Lei nº 5.561 de 12/12/1968", urn:"urn:lex:br:federal:lei:1968-12-12;5561", ementa:"Retifica, sem ônus, a Lei nº 5.373, de 6 de dezembro de 1967, que estima a Receita e fixa a Despesa da União para o Exercício de 1968.", arquivo:"federal/leis-ordinarias/1968/lei-5561-1968-12-12.md"}}, {id:"federal:BR:L:5513/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-10-17", numero:"5513", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-10-17;5513", vigente:true, titulo:"Lei nº 5.513 de 17/10/1968", urn:"urn:lex:br:federal:lei:1968-10-17;5513", ementa:"Dispõe sobre construções nas proximidades das Fortificações Costeiras do   Exército.", arquivo:"federal/leis-ordinarias/1968/lei-5513-1968-10-17.md"}}, {id:"federal:BR:L:5533/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-11-14", numero:"5533", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-11-14;5533", vigente:true, titulo:"Lei nº 5.533 de 14/11/1968", urn:"urn:lex:br:federal:lei:1968-11-14;5533", ementa:"Autoriza o Poder Executivo a doar, através do Instituto   Brasileiro do Café, ao Programa Mundial de Alimentos da Organização das Nações Unidas   para a Alimentação e a Agricultura, 5000 (cinco mil) sacas de café.", arquivo:"federal/leis-ordinarias/1968/lei-5533-1968-11-14.md"}}, {id:"federal:BR:L:5551/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-12-04", numero:"5551", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-12-04;5551", vigente:true, titulo:"Lei nº 5.551 de 04/12/1968", urn:"urn:lex:br:federal:lei:1968-12-04;5551", ementa:"Autoriza o Poder Executivo do Distrito Federal a abrir crédito especial de NCr$ 150.000,00 (cento e cinquenta mil cruzeiros novos), para o fim que especifica, e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5551-1968-12-04.md"}}, {id:"federal:BR:L:5524/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-11-05", numero:"5524", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-11-05;5524", vigente:true, titulo:"Lei nº 5.524 de 05/11/1968", urn:"urn:lex:br:federal:lei:1968-11-05;5524", ementa:"Dispõe sobre o exercício da profissão de Técnico Industrial de nível   médio.", arquivo:"federal/leis-ordinarias/1968/lei-5524-1968-11-05.md"}}, {id:"federal:BR:L:5410/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-09", numero:"5410", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-09;5410", vigente:true, titulo:"Lei nº 5.410 de 09/04/1968", urn:"urn:lex:br:federal:lei:1968-04-09;5410", ementa:"Dispõe sobre o regime de previdência social dos servidores e empregados   das autarquias controladoras do exercício profissional.", arquivo:"federal/leis-ordinarias/1968/lei-5410-1968-04-09.md"}}, {id:"federal:BR:L:5549/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-12-03", numero:"5549", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-12-03;5549", vigente:true, titulo:"Lei nº 5.549 de 03/12/1968", urn:"urn:lex:br:federal:lei:1968-12-03;5549", ementa:"Autoriza a Universidade Federal do Rio de Janeiro a contrair empréstimo no valor de US$ 10.000.000,0 (dez milhões de dólares) com banqueiros privados norte-americanos, e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5549-1968-12-03.md"}}, {id:"federal:BR:L:5555/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-12-06", numero:"5555", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-12-06;5555", vigente:true, titulo:"Lei nº 5.555 de 06/12/1968", urn:"urn:lex:br:federal:lei:1968-12-06;5555", ementa:"Concede pensão especial ao escultor Celso Antônio de Menezes.", arquivo:"federal/leis-ordinarias/1968/lei-5555-1968-12-06.md"}}, {id:"federal:BR:L:5446/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-06-04", numero:"5446", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-06-04;5446", vigente:true, titulo:"Lei nº 5.446 de 04/06/1968", urn:"urn:lex:br:federal:lei:1968-06-04;5446", ementa:"Concede pensão especial ao cidadão brasileiro Assis Almeida e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5446-1968-06-04.md"}}, {id:"federal:BR:L:5461/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-06-25", numero:"5461", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-06-25;5461", vigente:true, titulo:"Lei nº 5.461 de 25/06/1968", urn:"urn:lex:br:federal:lei:1968-06-25;5461", ementa:"Dispõe sobre as contribuições de que tratam o art. 1º do Decreto-lei número 6.246, de 5 de fevereiro de 1944, e o art. 23 da Lei nº 5.107, de 13 de setembro de 1966.", arquivo:"federal/leis-ordinarias/1968/lei-5461-1968-06-25.md"}}, {id:"federal:BR:L:5559/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-12-11", numero:"5559", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-12-11;5559", vigente:true, titulo:"Lei nº 5.559 de 11/12/1968", urn:"urn:lex:br:federal:lei:1968-12-11;5559", ementa:"Estende o direito ao salário-família instituído pela Lei nº 4.266, de 3 de outubro de 1963, e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5559-1968-12-11.md"}}, {id:"federal:BR:L:5382/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-02-09", numero:"5382", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-02-09;5382", vigente:true, titulo:"Lei nº 5.382 de 09/02/1968", urn:"urn:lex:br:federal:lei:1968-02-09;5382", ementa:"Prorroga o prazo de vigência de isenção tributária concedida à Companhia Hidro Elétrica de São Francisco.", arquivo:"federal/leis-ordinarias/1968/lei-5382-1968-02-09.md"}}, {id:"federal:BR:L:5499/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-09-09", numero:"5499", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-09-09;5499", vigente:true, titulo:"Lei nº 5.499 de 09/09/1968", urn:"urn:lex:br:federal:lei:1968-09-09;5499", ementa:"Dispõe sôbre a jurisdição da Junta de Conciliação e Julgamento de Ribeirão   Preto, no Estado de São Paulo, e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5499-1968-09-09.md"}}, {id:"federal:BR:L:5388/1968", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-02-21", numero:"5388", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-02-21;5388", vigente:true, titulo:"Lei nº 5.388 de 21/02/1968", urn:"urn:lex:br:federal:lei:1968-02-21;5388", ementa:"Provê sobre a isenção do pagamento das taxas de Melhoramentos dos Portos e Renovação da Marinha Mercante, dos equipamentos importados pelo Ministério da Educação e Cultura, nas condições que especifica.", arquivo:"federal/leis-ordinarias/1968/lei-5388-1968-02-21.md"}}, {id:"federal:BR:L:5407/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-09", numero:"5407", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-09;5407", vigente:true, titulo:"Lei nº 5.407 de 09/04/1968", urn:"urn:lex:br:federal:lei:1968-04-09;5407", ementa:"Reajusta os vencimentos dos servidores da Secretaria do Supremo Tribunal   Federal e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5407-1968-04-09.md"}}, {id:"federal:BR:L:5457/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-06-20", numero:"5457", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-06-20;5457", vigente:true, titulo:"Lei nº 5.457 de 20/06/1968", urn:"urn:lex:br:federal:lei:1968-06-20;5457", ementa:"Altera o § 1º do art. 1º e alíneas \"a\" e \"c\" do art. 6º da Lei nº 5.365,   de 1º de dezembro de 1967, que cria a Superintendência do Desenvolvimento da   Região Centro-Oeste (SUDECO), e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5457-1968-06-20.md"}}, {id:"federal:BR:L:5501/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-09-27", numero:"5501", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-09-27;5501", vigente:true, titulo:"Lei nº 5.501 de 27/09/1968", urn:"urn:lex:br:federal:lei:1968-09-27;5501", ementa:"Isenta dos impostos de importação e sôbre produtos industrializados,   material destinado à fabricação de café solúvel.", arquivo:"federal/leis-ordinarias/1968/lei-5501-1968-09-27.md"}}, {id:"federal:BR:L:5489/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-08-30", numero:"5489", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-08-30;5489", vigente:true, titulo:"Lei nº 5.489 de 30/08/1968", urn:"urn:lex:br:federal:lei:1968-08-30;5489", ementa:"Concede isenção de impôsto de importação para equipamentos de produção   cinematográfica.", arquivo:"federal/leis-ordinarias/1968/lei-5489-1968-08-30.md"}}, {id:"federal:BR:L:5495/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-09-05", numero:"5495", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-09-05;5495", vigente:true, titulo:"Lei nº 5.495 de 05/09/1968", urn:"urn:lex:br:federal:lei:1968-09-05;5495", ementa:"Concede pensão especial às famílias dos mortos em consequência de explosão   verificada no Parque 13 de Maio, na Cidade do Recife, Estado de   Pernambuco.", arquivo:"federal/leis-ordinarias/1968/lei-5495-1968-09-05.md"}}, {id:"federal:BR:L:5416/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-10", numero:"5416", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-10;5416", vigente:true, titulo:"Lei nº 5.416 de 10/04/1968", urn:"urn:lex:br:federal:lei:1968-04-10;5416", ementa:"Altera o parágrafo 2 do art. 26 da Lei nº 4239, de 27 de junho de 1963, que aprova o Plano Diretor do Desenvolvimento do Nordeste para os anos de 1963, 1964 e 1965, e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5416-1968-04-10.md"}}, {id:"federal:BR:L:5440/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-05-22", numero:"5440", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-05-22;5440", vigente:true, titulo:"Lei nº 5.440 de 22/05/1968", urn:"urn:lex:br:federal:lei:1968-05-22;5440", ementa:"Reajusta os vencimentos dos servidores da Secretaria e dos Serviços   Auxiliares do Tribunal de Justiça do Distrito Federal e dá outras   providências.", arquivo:"federal/leis-ordinarias/1968/lei-5440-1968-05-22.md"}}, {id:"federal:BR:L:5477/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-07-25", numero:"5477", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-07-25;5477", vigente:true, titulo:"Lei nº 5.477 de 25/07/1968", urn:"urn:lex:br:federal:lei:1968-07-25;5477", ementa:"Concede franquia postal às precatórias criminais e à correspondência dos   Conselhos Penitenciários Estaduais.", arquivo:"federal/leis-ordinarias/1968/lei-5477-1968-07-25.md"}}, {id:"federal:BR:L:5523/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-11-04", numero:"5523", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-11-04;5523", vigente:true, titulo:"Lei nº 5.523 de 04/11/1968", urn:"urn:lex:br:federal:lei:1968-11-04;5523", ementa:"Autoriza o Poder Executivo a constituir as Sociedades de Economia Mista -   Centrais Elétricas de Roraima S.A. CER e Centrais Elétricas de Rondônia S.A. -   CERON.", arquivo:"federal/leis-ordinarias/1968/lei-5523-1968-11-04.md"}}, {id:"federal:BR:L:5508/1968", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-10-11", numero:"5508", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-10-11;5508", vigente:true, titulo:"Lei nº 5.508 de 11/10/1968", urn:"urn:lex:br:federal:lei:1968-10-11;5508", ementa:"Aprova a Quarta Etapa do Plano Diretor de Desenvolvimento Econômico e Social do Nordeste, para os anos de 1969, 1970, 1971, 1972 e 1973, e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5508-1968-10-11.md"}}, {id:"federal:BR:L:5475/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-07-23", numero:"5475", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-07-23;5475", vigente:true, titulo:"Lei nº 5.475 de 23/07/1968", urn:"urn:lex:br:federal:lei:1968-07-23;5475", ementa:"Dá nova redação ao art. 3º e seu § 2º da Lei nº 3.765, de 4 de maio de   1960, que dispõe sôbre as pensões militares.", arquivo:"federal/leis-ordinarias/1968/lei-5475-1968-07-23.md"}}, {id:"federal:BR:L:5471/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-07-09", numero:"5471", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-07-09;5471", vigente:true, titulo:"Lei nº 5.471 de 09/07/1968", urn:"urn:lex:br:federal:lei:1968-07-09;5471", ementa:"Dispõe sôbre a exportação de livros antigos e conjuntos bibliográficos brasileiros.", arquivo:"federal/leis-ordinarias/1968/lei-5471-1968-07-09.md"}}, {id:"federal:BR:L:5467/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-07-05", numero:"5467", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-07-05;5467", vigente:true, titulo:"Lei nº 5.467 de 05/07/1968", urn:"urn:lex:br:federal:lei:1968-07-05;5467", ementa:"Dá nova redação aos artigos 119 e 120 do Código Penal, que dispõem sobre a   reabilitação criminal.", arquivo:"federal/leis-ordinarias/1968/lei-5467-1968-07-05.md"}}, {id:"federal:BR:L:5546/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-11-29", numero:"5546", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-11-29;5546", vigente:true, titulo:"Lei nº 5.546 de 29/11/1968", urn:"urn:lex:br:federal:lei:1968-11-29;5546", ementa:"Estima a Receita e fixa a Despesa da União para o Exercício financeiro de 1969.", arquivo:"federal/leis-ordinarias/1968/lei-5546-1968-11-29.md"}}, {id:"federal:BR:L:5520/1968", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-10-31", numero:"5520", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-10-31;5520", vigente:true, titulo:"Lei nº 5.520 de 31/10/1968", urn:"urn:lex:br:federal:lei:1968-10-31;5520", ementa:"Fixa os efetivos dos Oficiais dos Corpos e Quadros da Marinha de Guerra, e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5520-1968-10-31.md"}}, {id:"federal:BR:L:5466/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-07-05", numero:"5466", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-07-05;5466", vigente:true, titulo:"Lei nº 5.466 de 05/07/1968", urn:"urn:lex:br:federal:lei:1968-07-05;5466", ementa:"Autoriza o Poder Executivo a doar à Fundação Universidade Norte Mineira   terreno situado na gleba do Colégio Agrícola \"Antônio Versiani Athayde\", no   município de Montes Claros, Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/1968/lei-5466-1968-07-05.md"}}, {id:"federal:BR:L:5539/1968", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-11-27", numero:"5539", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-11-27;5539", vigente:true, titulo:"Lei nº 5.539 de 27/11/1968", urn:"urn:lex:br:federal:lei:1968-11-27;5539", ementa:"Modifica dispositivos da Lei número 4.881-A, de 6 de dezembro de 1965, que dispõe sobre o Estatuto do Magistério Superior, e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5539-1968-11-27.md"}}, {id:"federal:BR:L:5396/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-02-26", numero:"5396", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-02-26;5396", vigente:true, titulo:"Lei nº 5.396 de 26/02/1968", urn:"urn:lex:br:federal:lei:1968-02-26;5396", ementa:"Acrescenta itens ao Art. 165 do Decreto-Lei nº 200, de 25 de fevereiro de 1967.", arquivo:"federal/leis-ordinarias/1968/lei-5396-1968-02-26.md"}}, {id:"federal:BR:L:5506/1968", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-10-08", numero:"5506", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-10-08;5506", vigente:true, titulo:"Lei nº 5.506 de 08/10/1968", urn:"urn:lex:br:federal:lei:1968-10-08;5506", ementa:"Concede aos funcionários do extinto Território do Acre o direito de retorno aos serviços da União.", arquivo:"federal/leis-ordinarias/1968/lei-5506-1968-10-08.md"}}, {id:"federal:BR:L:5537/1968", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-11-21", numero:"5537", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-11-21;5537", vigente:true, titulo:"Lei nº 5.537 de 21/11/1968", urn:"urn:lex:br:federal:lei:1968-11-21;5537", ementa:"Cria o Instituto Nacional de Desenvolvimento da Educação e Pesquisa (INDEP), e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5537-1968-11-21.md"}}, {id:"federal:BR:L:5452/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-06-12", numero:"5452", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-06-12;5452", vigente:true, titulo:"Lei nº 5.452 de 12/06/1968", urn:"urn:lex:br:federal:lei:1968-06-12;5452", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Tribunal Regional do   Trabalho da 4ª Região - o crédito especial de NCr$ 60,45 (sessenta cruzeiros   novos e quarenta e cinco centavos), para atender ao pagamento de salário-família   ao Juiz daquele Tribunal - Doutor Dilermano Xavier Porto.", arquivo:"federal/leis-ordinarias/1968/lei-5452-1968-06-12.md"}}, {id:"federal:BR:L:5528/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-11-12", numero:"5528", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-11-12;5528", vigente:true, titulo:"Lei nº 5.528 de 12/11/1968", urn:"urn:lex:br:federal:lei:1968-11-12;5528", ementa:"Autoriza o Poder Executivo a instituir a Universidade Federal do Piauí e   dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5528-1968-11-12.md"}}, {id:"federal:BR:L:5402/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-03-29", numero:"5402", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-03-29;5402", vigente:true, titulo:"Lei nº 5.402 de 29/03/1968", urn:"urn:lex:br:federal:lei:1968-03-29;5402", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério do Interior, o crédito   especial de NCr$ 406.000,00 (quatrocentos e seis mil cruzeiros novos), para   atender a programa especial de migrações internas.", arquivo:"federal/leis-ordinarias/1968/lei-5402-1968-03-29.md"}}, {id:"federal:BR:L:5427/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-30", numero:"5427", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-30;5427", vigente:true, titulo:"Lei nº 5.427 de 30/04/1968", urn:"urn:lex:br:federal:lei:1968-04-30;5427", ementa:"Reajusta os vencimentos dos funcionários da Secretaria do Tribunal Federal   de Recursos.", arquivo:"federal/leis-ordinarias/1968/lei-5427-1968-04-30.md"}}, {id:"federal:BR:L:5487/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-08-27", numero:"5487", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-08-27;5487", vigente:true, titulo:"Lei nº 5.487 de 27/08/1968", urn:"urn:lex:br:federal:lei:1968-08-27;5487", ementa:"Concede pensões especiais a beneficiários legais de servidores falecidos em   acidente com avião da Força Aérea Brasileira na Selva amazônica e dá outras   providências.", arquivo:"federal/leis-ordinarias/1968/lei-5487-1968-08-27.md"}}, {id:"federal:BR:L:5412/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-09", numero:"5412", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-09;5412", vigente:true, titulo:"Lei nº 5.412 de 09/04/1968", urn:"urn:lex:br:federal:lei:1968-04-09;5412", ementa:"Autoriza a Prefeitura do Distrito Federal e a Fundação Zoobotânica do   Distrito Federal a cancelarem contrato de financiamento.", arquivo:"federal/leis-ordinarias/1968/lei-5412-1968-04-09.md"}}, {id:"federal:BR:L:5450/1968", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-06-05", numero:"5450", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-06-05;5450", vigente:true, titulo:"Lei nº 5.450 de 05/06/1968", urn:"urn:lex:br:federal:lei:1968-06-05;5450", ementa:"Aprova o Orçamento Plurianual de Investimentos para o triênio 1968-1970.", arquivo:"federal/leis-ordinarias/1968/lei-5450-1968-06-05.md"}}, {id:"federal:BR:L:5391/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-02-23", numero:"5391", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-02-23;5391", vigente:true, titulo:"Lei nº 5.391 de 23/02/1968", urn:"urn:lex:br:federal:lei:1968-02-23;5391", ementa:"Atribui recursos para melhoria das condiçoes de segurança do sistema rodoviário.", arquivo:"federal/leis-ordinarias/1968/lei-5391-1968-02-23.md"}}, {id:"federal:BR:L:5464/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-07-02", numero:"5464", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-07-02;5464", vigente:true, titulo:"Lei nº 5.464 de 02/07/1968", urn:"urn:lex:br:federal:lei:1968-07-02;5464", ementa:"Considera de utilidade pública a Fundação Ford (The Ford Foundation), com   sede em New York, Estados Unidos da América do Norte.", arquivo:"federal/leis-ordinarias/1968/lei-5464-1968-07-02.md"}}, {id:"federal:BR:L:5418/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-15", numero:"5418", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-15;5418", vigente:true, titulo:"Lei nº 5.418 de 15/04/1968", urn:"urn:lex:br:federal:lei:1968-04-15;5418", ementa:"Concede isenção dos impostos de importação e sobre produtos   industrializados para equipamentos importados pela Companhia Estadual de   Telefones da Guanabara - CETEL.", arquivo:"federal/leis-ordinarias/1968/lei-5418-1968-04-15.md"}}, {id:"federal:BR:L:5482/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-08-10", numero:"5482", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-08-10;5482", vigente:true, titulo:"Lei nº 5.482 de 10/08/1968", urn:"urn:lex:br:federal:lei:1968-08-10;5482", ementa:"Autoriza o Poder Executivo a desapropriar em favor da Empresa Brasileira   de Telecomunicações - EMBRATEL o imóvel que especifica de propriedade da   Prefeitura Municipal de Belo Horizonte.", arquivo:"federal/leis-ordinarias/1968/lei-5482-1968-08-10.md"}}, {id:"federal:BR:L:5554/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-12-06", numero:"5554", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-12-06;5554", vigente:true, titulo:"Lei nº 5.554 de 06/12/1968", urn:"urn:lex:br:federal:lei:1968-12-06;5554", ementa:"Altera o Decreto-lei nº 960, de 17 de dezembro de 1938, que dispõe sobre a cobrança judicial da dívida ativa da Fazenda Pública.", arquivo:"federal/leis-ordinarias/1968/lei-5554-1968-12-06.md"}}, {id:"federal:BR:L:5424/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-27", numero:"5424", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-27;5424", vigente:true, titulo:"Lei nº 5.424 de 27/04/1968", urn:"urn:lex:br:federal:lei:1968-04-27;5424", ementa:"Concede, pelo prazo de um ano, isenção dos impostos de importação e sobre   produtos industrializados, para material destinado à fabricação, no País, de   centrais telefônicas automáticas. /Há veto/", arquivo:"federal/leis-ordinarias/1968/lei-5424-1968-04-27.md"}}, {id:"federal:BR:L:5406/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-09", numero:"5406", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-09;5406", vigente:true, titulo:"Lei nº 5.406 de 09/04/1968", urn:"urn:lex:br:federal:lei:1968-04-09;5406", ementa:"Revigora, por 30 (trinta) dias, dispositivo do Decreto-Lei nº 194, de 24   de fevereiro de 1967, que dispõe sobre a aplicação da legislação sobre o Fundo   de Garantia de Tempo de Serviço às entidades de fins   filantrópicos.", arquivo:"federal/leis-ordinarias/1968/lei-5406-1968-04-09.md"}}, {id:"federal:BR:L:5558/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-12-11", numero:"5558", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-12-11;5558", vigente:true, titulo:"Lei nº 5.558 de 11/12/1968", urn:"urn:lex:br:federal:lei:1968-12-11;5558", ementa:"Renova, por cinco anos, o prazo legal para fruição, pelos herdeiros, dos direitos autorais das obras do Maestro Antônio Carlos Gomes.", arquivo:"federal/leis-ordinarias/1968/lei-5558-1968-12-11.md"}}, {id:"federal:BR:L:5542/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-11-28", numero:"5542", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-11-28;5542", vigente:true, titulo:"Lei nº 5.542 de 28/11/1968", urn:"urn:lex:br:federal:lei:1968-11-28;5542", ementa:"Autoriza o Poder Executivo a abrir ao Ministério dos Transportes, em favor do Grupo Executivo de Integração da Política de Transportes (GEIPOT), o crédito especial de NCr$ 4.200.000,00 (quatro milhões e duzentos mil cruzeiros novos), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1968/lei-5542-1968-11-28.md"}}, {id:"federal:BR:L:5433/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-05-08", numero:"5433", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-05-08;5433", vigente:true, titulo:"Lei nº 5.433 de 08/05/1968", urn:"urn:lex:br:federal:lei:1968-05-08;5433", ementa:"Regula a microfilmagem de documentos oficiais e dá outras   providências.", arquivo:"federal/leis-ordinarias/1968/lei-5433-1968-05-08.md"}}, {id:"federal:BR:L:5381/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-02-09", numero:"5381", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-02-09;5381", vigente:true, titulo:"Lei nº 5.381 de 09/02/1968", urn:"urn:lex:br:federal:lei:1968-02-09;5381", ementa:"Acrescenta parágrafos ao art. 86, da Consolidação das Leis do Trabalho, aprovada pelo Decreto-Lei nº 5.452, de 1 de maio de 1943.", arquivo:"federal/leis-ordinarias/1968/lei-5381-1968-02-09.md"}}, {id:"federal:BR:L:5498/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-09-09", numero:"5498", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-09-09;5498", vigente:true, titulo:"Lei nº 5.498 de 09/09/1968", urn:"urn:lex:br:federal:lei:1968-09-09;5498", ementa:"Extingue a punibilidade de crimes previstos na Lei nº 4.729, de 14 de   julho de 1965, que define o crime de sonegação fiscal e dá outras   providências.", arquivo:"federal/leis-ordinarias/1968/lei-5498-1968-09-09.md"}}, {id:"federal:BR:L:5387/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-02-21", numero:"5387", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-02-21;5387", vigente:true, titulo:"Lei nº 5.387 de 21/02/1968", urn:"urn:lex:br:federal:lei:1968-02-21;5387", ementa:"Altera o artigo 1º da Lei nº 3.378, de 2 de abril de 1958, que eleva para Cr$ 35.000.000,00 (trinta e cinco milhões de cruzeiros) a ajuda financeira concedida às Missões Salesianas do Amazonas - Prelazia do Rio Negro, e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5387-1968-02-21.md"}}, {id:"federal:BR:L:5522/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-11-04", numero:"5522", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-11-04;5522", vigente:true, titulo:"Lei nº 5.522 de 04/11/1968", urn:"urn:lex:br:federal:lei:1968-11-04;5522", ementa:"Concede pensão especial à viúva do ex-Professor da Faculdade de Medicina   da Universidade Federal de Pernambuco, Aggeu de Godoy Magalhães.", arquivo:"federal/leis-ordinarias/1968/lei-5522-1968-11-04.md"}}, {id:"federal:BR:L:5401/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-03-25", numero:"5401", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-03-25;5401", vigente:true, titulo:"Lei nº 5.401 de 25/03/1968", urn:"urn:lex:br:federal:lei:1968-03-25;5401", ementa:"Isenta dos impostos de importação e sobre produtos industrializados   equipamentos destinados à implantação da rede de telecomunicações no Estado do   Paraná, e importados pela Companhia de Telecomunicações do Paraná -   TELEPAR.", arquivo:"federal/leis-ordinarias/1968/lei-5401-1968-03-25.md"}}, {id:"federal:BR:L:5494/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-09-05", numero:"5494", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-09-05;5494", vigente:true, titulo:"Lei nº 5.494 de 05/09/1968", urn:"urn:lex:br:federal:lei:1968-09-05;5494", ementa:"Cria, no Quadro de Pessoal do Ministério da Aeronáutica, cargo em comissão   de Consultor Jurídico.", arquivo:"federal/leis-ordinarias/1968/lei-5494-1968-09-05.md"}}, {id:"federal:BR:L:5505/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-10-04", numero:"5505", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-10-04;5505", vigente:true, titulo:"Lei nº 5.505 de 04/10/1968", urn:"urn:lex:br:federal:lei:1968-10-04;5505", ementa:"Autoriza o Poder Executivo do Distrito Federal a abrir crédito especial no   valor de NCr$ 8.275.000,00 ( oito milhões duzentos e setenta e cinco mil   cruzeiros novos ), para integralização do Capital da Companhia de Telefones de   Brasília Ltda. - COTELB.", arquivo:"federal/leis-ordinarias/1968/lei-5505-1968-10-04.md"}}, {id:"federal:BR:L:5415/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-04-10", numero:"5415", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-04-10;5415", vigente:true, titulo:"Lei nº 5.415 de 10/04/1968", urn:"urn:lex:br:federal:lei:1968-04-10;5415", ementa:"Concede estímulos fiscais às indústrias de celuloses, de pasta mecânica e   de papel em geral e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5415-1968-04-10.md"}}, {id:"federal:BR:L:5474/1968", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-07-18", numero:"5474", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-07-18;5474", vigente:true, titulo:"Lei nº 5.474 de 18/07/1968", urn:"urn:lex:br:federal:lei:1968-07-18;5474", ementa:"Dispõe sôbre as Duplicatas, e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5474-1968-07-18.md"}}, {id:"federal:BR:L:5397/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-02-28", numero:"5397", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-02-28;5397", vigente:true, titulo:"Lei nº 5.397 de 28/02/1968", urn:"urn:lex:br:federal:lei:1968-02-28;5397", ementa:"Altera o parágrafo 4º do art 12 do Decreto-Lei nº 236, de 28 de fevereiro de 1967, que complementou e modificou a Lei nº 4.117, de 27 de agosto de 1962.", arquivo:"federal/leis-ordinarias/1968/lei-5397-1968-02-28.md"}}, {id:"federal:BR:L:5545/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-11-29", numero:"5545", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-11-29;5545", vigente:true, titulo:"Lei nº 5.545 de 29/11/1968", urn:"urn:lex:br:federal:lei:1968-11-29;5545", ementa:"Autoriza o Poder Executivo a abrir ao Ministério da Fazenda, em favor dos Municípios situados nos Territórios Federais, o crédito especial de NCr$ 150.000,00 (cento e cinquenta mil cruzeiros novos), para o fim que especifica.", arquivo:"federal/leis-ordinarias/1968/lei-5545-1968-11-29.md"}}] AS row
