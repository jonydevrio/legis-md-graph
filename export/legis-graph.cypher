1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-10", numero:"7270", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-10;7270", vigente:true, titulo:"Lei nº 7.270 de 10/12/1984", urn:"urn:lex:br:federal:lei:1984-12-10;7270", ementa:"Acrescenta parágrafo ao artigo 145, da Lei nº 5.869, de 11 de janeiro de   1973 - Código de Processo Civil.", arquivo:"federal/leis-ordinarias/1984/lei-7270-1984-12-10.md"}}, {id:"federal:BR:L:7295/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-19", numero:"7295", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-19;7295", vigente:true, titulo:"Lei nº 7.295 de 19/12/1984", urn:"urn:lex:br:federal:lei:1984-12-19;7295", ementa:"Dispõe sobre o processo de fiscalização pela Câmara dos Deputados e pelo Senado Federal, dos atos do Poder Executivo e os da administração indireta.", arquivo:"federal/leis-ordinarias/1984/lei-7295-1984-12-19.md"}}, {id:"federal:BR:L:7191/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-06-04", numero:"7191", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-06-04;7191", vigente:true, titulo:"Lei nº 7.191 de 04/06/1984", urn:"urn:lex:br:federal:lei:1984-06-04;7191", ementa:"Altera os arts. 16 e 25 da Lei nº 4.737, de 15 de julho de 1965 - Código Eleitoral.", arquivo:"federal/leis-ordinarias/1984/lei-7191-1984-06-04.md"}}, {id:"federal:BR:L:7266/1984", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1984, data:"1984-12-04", numero:"7266", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1984-12-04;7266", vigente:true, titulo:"Lei nº 7.266 de 04/12/1984", urn:"urn:lex:br:federal:lei:1984-12-04;7266", ementa:"Altera as contribuiçõ