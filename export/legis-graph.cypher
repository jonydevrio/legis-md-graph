se", ano:1952, data:"1952-12-31", numero:"1797", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-12-31;1797", vigente:true, titulo:"Lei nº 1.797 de 31/12/1952", urn:"urn:lex:br:federal:lei:1952-12-31;1797", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Justiça e Negócios Interiores, o crédito suplementar de Cr$ 2.600.000,00, à dotação atribuída à Verba 3 do Anexo n° 21, da Lei n° 1.487, de 6 de dezembro de 1951.", arquivo:"federal/leis-ordinarias/1952/lei-1797-1952-12-31.md"}}, {id:"federal:BR:L:1747/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-11-28", numero:"1747", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-11-28;1747", vigente:true, titulo:"Lei nº 1.747 de 28/11/1952", urn:"urn:lex:br:federal:lei:1952-11-28;1747", ementa:"Altera o Decreto nº 4.655, de 3 de setembro de 1942, que dispõe sobre o Imposto do Selo.", arquivo:"federal/leis-ordinarias/1952/lei-1747-1952-11-28.md"}}, {id:"federal:BR:L:1660/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-08-19", numero:"1660", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-08-19;1660", vigente:true, titulo:"Lei nº 1.660 de 19/08/1952", urn:"urn:lex:br:federal:lei:1952-08-19;1660", ementa:"Autoriza o Poder Executivo a abrir pelo Ministério do Trabalho, Indústria e Comércio, crédito especial para pagamento de despesas com ajuda de custo e passagens do pessoal dos Escritórios e Agências de Propaganda no Exterior.", arquivo:"federal/leis-ordinarias/1952/lei-1660-1952-08-19.md"}}, {id:"federal:BR:L:1700/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-10-15", numero:"1700", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-10-15;1700", vigente:true, titulo:"Lei nº 1.700 de 15/10/1952", urn:"urn:lex:br:federal:lei:1952-10-15;1700", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Justiça e Negócios Interiores, o crédito especial de Cr$ 600.000,00, destinado à regularização de despesa efetuada, no exercício de 1950, pela Polícia Militar do Distrito Federal.", arquivo:"federal/leis-ordinarias/1952/lei-1700-1952-10-15.md"}}, {id:"federal:BR:L:1559/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-02-18", numero:"1559", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-02-18;1559", vigente:true, titulo:"Lei nº 1.559 de 18/02/1952", urn:"urn:lex:br:federal:lei:1952-02-18;1559", ementa:"Reconhece aos antigos encarregados e escrivães dos postos fiscais do Território do Acre os direitos assegurados pela Lei nº 3.454, de 6 de janeiro de 1918, e confirmados pelo Decreto n. 15.220, de 29 de setembro de 1921.", arquivo:"federal/leis-ordinarias/1952/lei-1559-1952-02-18.md"}}, {id:"federal:BR:L:1789/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-12-30", numero:"1789", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-12-30;1789", vigente:true, titulo:"Lei nº 1.789 de 30/12/1952", urn:"urn:lex:br:federal:lei:1952-12-30;1789", ementa:"Concede a pensão especial de Cr$ 2.000,00 mensais a Laura Lins Arcoverde, viúva do engenheiro Leonardo de Siqueira Barbosa Arcoverde.", arquivo:"federal/leis-ordinarias/1952/lei-1789-1952-12-30.md"}}, {id:"federal:BR:L:1639/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-07-14", numero:"1639", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-07-14;1639", vigente:true, titulo:"Lei nº 1.639 de 14/07/1952", urn:"urn:lex:br:federal:lei:1952-07-14;1639", ementa:"Altera a carreira de Comissário de Polícia do Quadro Permanente do Ministério da Justiça e Negócios Interiores, e dá outras providências.", arquivo:"federal/leis-ordinarias/1952/lei-1639-1952-07-14.md"}}, {id:"federal:BR:L:1779/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-12-22", numero:"1779", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-12-22;1779", vigente:true, titulo:"Lei nº 1.779 de 22/12/1952", urn:"urn:lex:br:federal:lei:1952-12-22;1779", ementa:"Cria o Instituto Brasileiro do Café, e dá outras providências.", arquivo:"federal/leis-ordinarias/1952/lei-1779-1952-12-22.md"}}, {id:"federal:BR:L:1646/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-07-16", numero:"1646", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-07-16;1646", vigente:true, titulo:"Lei nº 1.646 de 16/07/1952", urn:"urn:lex:br:federal:lei:1952-07-16;1646", ementa:"Concede licença às entidades sindicais brasileiras, de 2º e 3º graus para que se filiem à Confederação Internacional das Organizações Sindicais Livres.", arquivo:"federal/leis-ordinarias/1952/lei-1646-1952-07-16.md"}}, {id:"federal:BR:L:1627/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-06-18", numero:"1627", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-06-18;1627", vigente:true, titulo:"Lei nº 1.627 de 18/06/1952", urn:"urn:lex:br:federal:lei:1952-06-18;1627", ementa:"Assegura aos oficiais da reserva de 2ª classe da Aeronáutica aproveitados no serviço ativo da FAB a inscrição como contribuinte do Montepio Militar.", arquivo:"federal/leis-ordinarias/1952/lei-1627-1952-06-18.md"}}, {id:"federal:BR:L:1730/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-11-11", numero:"1730", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-11-11;1730", vigente:true, titulo:"Lei nº 1.730 de 11/11/1952", urn:"urn:lex:br:federal:lei:1952-11-11;1730", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Tribunal Federal de Recursos - o crédito suplementar de Cr$ 100.000.000,00 para pagamento de sentenças judiciárias.", arquivo:"federal/leis-ordinarias/1952/lei-1730-1952-11-11.md"}}, {id:"federal:BR:L:1577/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-03-17", numero:"1577", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-03-17;1577", vigente:true, titulo:"Lei nº 1.577 de 17/03/1952", urn:"urn:lex:br:federal:lei:1952-03-17;1577", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 93.600.000,00, para pagamento de compromissos de guerra.", arquivo:"federal/leis-ordinarias/1952/lei-1577-1952-03-17.md"}}, {id:"federal:BR:L:1674/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-09-19", numero:"1674", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-09-19;1674", vigente:true, titulo:"Lei nº 1.674 de 19/09/1952", urn:"urn:lex:br:federal:lei:1952-09-19;1674", ementa:"Autoriza a abrir, pelo Ministério da Viação e Obras Públicas, o crédito especial de Cr$ 2.270.000,00, destinado ao Departamento Nacional de Estradas de Ferro (Estrada de Ferro de Goiás).", arquivo:"federal/leis-ordinarias/1952/lei-1674-1952-09-19.md"}}, {id:"federal:BR:L:1728/1952", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-11-10", numero:"1728", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-11-10;1728", vigente:true, titulo:"Lei nº 1.728 de 10/11/1952", urn:"urn:lex:br:federal:lei:1952-11-10;1728", ementa:"Dispõe sobre a forma de pagamento das dívidas dos criadores e recriadores de gado bovino, e dá outras providências.", arquivo:"federal/leis-ordinarias/1952/lei-1728-1952-11-10.md"}}, {id:"federal:BR:L:1615/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-05-30", numero:"1615", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-05-30;1615", vigente:true, titulo:"Lei nº 1.615 de 30/05/1952", urn:"urn:lex:br:federal:lei:1952-05-30;1615", ementa:"Concede isenção de impostos e taxas, exceto a de Previdência Social, a dois volumes contendo paramentos sacerdotais, adquiridos na França, e destinados à Imperial Irmandade de N. S. da Glória do Outeiro, desta capital.", arquivo:"federal/leis-ordinarias/1952/lei-1615-1952-05-30.md"}}, {id:"federal:BR:L:1581/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-03-21", numero:"1581", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-03-21;1581", vigente:true, titulo:"Lei nº 1.581 de 21/03/1952", urn:"urn:lex:br:federal:lei:1952-03-21;1581", ementa:"Autoriza o Poder Executivo a abrir, ao Poder Judiciário - Justiça Eleitoral - o crédito especial de Cr$ 45.900,00 a fim de atender ao pagamento de gratificação de representação devido aos juízes do Tribunal Regional Eleitoral do Estado de Mato Grosso, relativamente ao exercício de 1947.", arquivo:"federal/leis-ordinarias/1952/lei-1581-1952-03-21.md"}}, {id:"federal:BR:L:1719/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-11-01", numero:"1719", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-11-01;1719", vigente:true, titulo:"Lei nº 1.719 de 01/11/1952", urn:"urn:lex:br:federal:lei:1952-11-01;1719", ementa:"Amplia o prazo de execução da Lei nº 1.003, de 24 de dezembro de 1949, relativo a financiamento da lavoura de café.", arquivo:"federal/leis-ordinarias/1952/lei-1719-1952-11-01.md"}}, {id:"federal:BR:L:1691/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-10-03", numero:"1691", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-10-03;1691", vigente:true, titulo:"Lei nº 1.691 de 03/10/1952", urn:"urn:lex:br:federal:lei:1952-10-03;1691", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras Públicas, crédito especial para pagamento de salário-família.", arquivo:"federal/leis-ordinarias/1952/lei-1691-1952-10-03.md"}}, {id:"federal:BR:L:1751/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-12-04", numero:"1751", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-12-04;1751", vigente:true, titulo:"Lei nº 1.751 de 04/12/1952", urn:"urn:lex:br:federal:lei:1952-12-04;1751", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito de Cr$ 14.000.000,00 suplementar à Verba 2 - Material, do Anexo n° 19, do Orçamento da União de 1952 ( Lei nº 1.487, de 6-12-51 ).", arquivo:"federal/leis-ordinarias/1952/lei-1751-1952-12-04.md"}}, {id:"federal:BR:L:1538/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-01-03", numero:"1538", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-01-03;1538", vigente:true, titulo:"Lei nº 1.538 de 03/01/1952", urn:"urn:lex:br:federal:lei:1952-01-03;1538", ementa:"Concede isenção de tributos, exclusive a taxa de previdência Social, a materiais importados pela Creche Regina Apostolorum, de Sete Lagoas, e outras instituições.", arquivo:"federal/leis-ordinarias/1952/lei-1538-1952-01-03.md"}}, {id:"federal:BR:L:1733/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-11-14", numero:"1733", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-11-14;1733", vigente:true, titulo:"Lei nº 1.733 de 14/11/1952", urn:"urn:lex:br:federal:lei:1952-11-14;1733", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito suplementar de Cr$ 252.440.000,00, em reforço da Verba 3, Anexo 19 - Auxílios aos Municípios - do Orçamento de 1952.", arquivo:"federal/leis-ordinarias/1952/lei-1733-1952-11-14.md"}}, {id:"federal:BR:L:1633/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-07-01", numero:"1633", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-07-01;1633", vigente:true, titulo:"Lei nº 1.633 de 01/07/1952", urn:"urn:lex:br:federal:lei:1952-07-01;1633", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça do Trabalho - dois créditos especiais, um de Cr$ 12.469,00 e outro de Cr$ 29.908,00, para atender, respectivamente, ao pagamento de despesas relativas aos exercícios de 1947, 1948 e 1949.", arquivo:"federal/leis-ordinarias/1952/lei-1633-1952-07-01.md"}}, {id:"federal:BR:L:1649/1952", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-07-19", numero:"1649", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-07-19;1649", vigente:true, titulo:"Lei nº 1.649 de 19/07/1952", urn:"urn:lex:br:federal:lei:1952-07-19;1649", ementa:"Cria o Banco do Nordeste do Brasil e dá outras providências.", arquivo:"federal/leis-ordinarias/1952/lei-1649-1952-07-19.md"}}, {id:"federal:BR:L:1551/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-02-07", numero:"1551", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-02-07;1551", vigente:true, titulo:"Lei nº 1.551 de 07/02/1952", urn:"urn:lex:br:federal:lei:1952-02-07;1551", ementa:"Fixa o prazo para o Conselho de Segurança Nacional emitir parecer nos termos do § 2º do art. 28 da Constituição Federal.", arquivo:"federal/leis-ordinarias/1952/lei-1551-1952-02-07.md"}}, {id:"federal:BR:L:1707/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-10-23", numero:"1707", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-10-23;1707", vigente:true, titulo:"Lei nº 1.707 de 23/10/1952", urn:"urn:lex:br:federal:lei:1952-10-23;1707", ementa:"Altera dispositivos do Decreto-lei nº 3.832, de 18 de novembro de 1941, que dispõe sobre a situação perante o Instituto de Aposentadoria e Pensões dos Marítimos, dos armadores de pesca e dos pescadores e empregados em profissões conexas com a indústria da pesca.", arquivo:"federal/leis-ordinarias/1952/lei-1707-1952-10-23.md"}}, {id:"federal:BR:L:1676/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-09-26", numero:"1676", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-09-26;1676", vigente:true, titulo:"Lei nº 1.676 de 26/09/1952", urn:"urn:lex:br:federal:lei:1952-09-26;1676", ementa:"Faculta a contribuição para diversos Institutos de Previdência e dá outras providências.", arquivo:"federal/leis-ordinarias/1952/lei-1676-1952-09-26.md"}}, {id:"federal:BR:L:1666/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-09-01", numero:"1666", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-09-01;1666", vigente:true, titulo:"Lei nº 1.666 de 01/09/1952", urn:"urn:lex:br:federal:lei:1952-09-01;1666", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Aviação e Obras Públicas, o crédito especial de Cr$ 1.563.337,10, para pagamento da parte restante das despesas realizadas pelo Departamento dos Correios e Telégrafos com a aquisição de carros-correio.", arquivo:"federal/leis-ordinarias/1952/lei-1666-1952-09-01.md"}}, {id:"federal:BR:L:1626/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-06-17", numero:"1626", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-06-17;1626", vigente:true, titulo:"Lei nº 1.626 de 17/06/1952", urn:"urn:lex:br:federal:lei:1952-06-17;1626", ementa:"Estende a todos os chefes e servidores dos Postos de Atração e Pacificação dos Índios, quando em expedição pelas regiões habitadas pelos índios não aldeados os benefícios do Decreto-Lei n° 5.801, de 8 de dezembro de 1943, que considera de interesse militar a Expedição Roncador-Xingú.", arquivo:"federal/leis-ordinarias/1952/lei-1626-1952-06-17.md"}}, {id:"federal:BR:L:1795/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-12-31", numero:"1795", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-12-31;1795", vigente:true, titulo:"Lei nº 1.795 de 31/12/1952", urn:"urn:lex:br:federal:lei:1952-12-31;1795", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito suplementar de Cr$ 135.200,00, em reforço de verbas do Anexo 19 do Orçamento Geral da União (Lei nº 1.487, de 6 de dezembro de 1951).", arquivo:"federal/leis-ordinarias/1952/lei-1795-1952-12-31.md"}}, {id:"federal:BR:L:1588/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-03-31", numero:"1588", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-03-31;1588", vigente:true, titulo:"Lei nº 1.588 de 31/03/1952", urn:"urn:lex:br:federal:lei:1952-03-31;1588", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério do Trabalho, Indústria e Comércio, o crédito especial Cr$ 980.023,20 (novecentos e oitenta mil, vinte e três cruzeiros e vinte centavos), para atender às despesas do Ministério Público do Trabalho.", arquivo:"federal/leis-ordinarias/1952/lei-1588-1952-03-31.md"}}, {id:"federal:BR:L:1637/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-07-14", numero:"1637", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-07-14;1637", vigente:true, titulo:"Lei nº 1.637 de 14/07/1952", urn:"urn:lex:br:federal:lei:1952-07-14;1637", ementa:"Cria, no Quadro Suplementar do Ministério da Educação e Saúde, um cargo isolado, de provimento efetivo, de Entomologista, padrão M.", arquivo:"federal/leis-ordinarias/1952/lei-1637-1952-07-14.md"}}, {id:"federal:BR:L:1787/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-12-30", numero:"1787", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-12-30;1787", vigente:true, titulo:"Lei nº 1.787 de 30/12/1952", urn:"urn:lex:br:federal:lei:1952-12-30;1787", ementa:"Amplia o programa de Primeira Urgência, constante nos arts. 21 e 22 da Lei nº 302 de 13 de julho de 1948.", arquivo:"federal/leis-ordinarias/1952/lei-1787-1952-12-30.md"}}, {id:"federal:BR:L:1695/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-10-07", numero:"1695", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-10-07;1695", vigente:true, titulo:"Lei nº 1.695 de 07/10/1952", urn:"urn:lex:br:federal:lei:1952-10-07;1695", ementa:"Cria um cargo isolado de provimento efetivo, padrão \"M\", de Consul Privativo, no Quadro Permanente do Ministério das Relações Exteriores, e dá outras providências.", arquivo:"federal/leis-ordinarias/1952/lei-1695-1952-10-07.md"}}, {id:"federal:BR:L:1597/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-05-02", numero:"1597", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-05-02;1597", vigente:true, titulo:"Lei nº 1.597 de 02/05/1952", urn:"urn:lex:br:federal:lei:1952-05-02;1597", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Saúde, o crédito especial de Cr$ 711.800,00, para atender ao pagamento de despesas decorrentes de fornecimento e instalação de equipamento do laboratório para microfilmagem, pela firma Microfilme Técnica Limitada.", arquivo:"federal/leis-ordinarias/1952/lei-1597-1952-05-02.md"}}, {id:"federal:BR:L:1644/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-07-16", numero:"1644", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-07-16;1644", vigente:true, titulo:"Lei nº 1.644 de 16/07/1952", urn:"urn:lex:br:federal:lei:1952-07-16;1644", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 15.000.000,00, como auxílio à Fundação Abrigo do Cristo Redentor.", arquivo:"federal/leis-ordinarias/1952/lei-1644-1952-07-16.md"}}, {id:"federal:BR:L:1650/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-07-19", numero:"1650", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-07-19;1650", vigente:true, titulo:"Lei nº 1.650 de 19/07/1952", urn:"urn:lex:br:federal:lei:1952-07-19;1650", ementa:"Cria uma seção de organização na Direção Geral da Fazenda Nacional do Ministério da Fazenda, e outra em cada um dos departamentos de administração dos demais Ministérios civis, e dá outras providências.", arquivo:"federal/leis-ordinarias/1952/lei-1650-1952-07-19.md"}}, {id:"federal:BR:L:1764/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-12-17", numero:"1764", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-12-17;1764", vigente:true, titulo:"Lei nº 1.764 de 17/12/1952", urn:"urn:lex:br:federal:lei:1952-12-17;1764", ementa:"Cria, na Terceira Região da Justiça do Trabalho, uma Junta de Conciliação e Julgamento.", arquivo:"federal/leis-ordinarias/1952/lei-1764-1952-12-17.md"}}, {id:"federal:BR:L:1687/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-10-02", numero:"1687", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-10-02;1687", vigente:true, titulo:"Lei nº 1.687 de 02/10/1952", urn:"urn:lex:br:federal:lei:1952-10-02;1687", ementa:"Concede pensão especial à menor Maria Edite de Oliveira, filha de João Rodrigues de Oliveira, extranumerário diarista da Estrada de Ferro Central do Piauí, falecido em consequência de acidente no Trabalho.", arquivo:"federal/leis-ordinarias/1952/lei-1687-1952-10-02.md"}}, {id:"federal:BR:L:1548/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-02-05", numero:"1548", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-02-05;1548", vigente:true, titulo:"Lei nº 1.548 de 05/02/1952", urn:"urn:lex:br:federal:lei:1952-02-05;1548", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o crédito especial de Cr$ 300.000,00, como auxílio à Prefeitura Municipal de Uberaba e à Sociedade Rural do Triângulo Mineiro de Uberaba, Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/1952/lei-1548-1952-02-05.md"}}, {id:"federal:BR:L:1554/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-02-08", numero:"1554", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-02-08;1554", vigente:true, titulo:"Lei nº 1.554 de 08/02/1952", urn:"urn:lex:br:federal:lei:1952-02-08;1554", ementa:"Manda incluir, no ensino da cadeira de Farmácia Galênica, as noções fundamentais de Farmácia Homeopática.", arquivo:"federal/leis-ordinarias/1952/lei-1554-1952-02-08.md"}}, {id:"federal:BR:L:1652/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-07-22", numero:"1652", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-07-22;1652", vigente:true, titulo:"Lei nº 1.652 de 22/07/1952", urn:"urn:lex:br:federal:lei:1952-07-22;1652", ementa:"Considera ferroviários, para os efeitos das leis do Trabalho e Previdência Social, os empregados dos carros restaurantes das estradas de ferro e dá outras providências.", arquivo:"federal/leis-ordinarias/1952/lei-1652-1952-07-22.md"}}, {id:"federal:BR:L:1621/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-06-09", numero:"1621", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-06-09;1621", vigente:true, titulo:"Lei nº 1.621 de 09/06/1952", urn:"urn:lex:br:federal:lei:1952-06-09;1621", ementa:"Autoriza a abertura pelo Ministério da Fazenda, do crédito especial de Cr$ 34.307,10, destinado à regularização da despesa do exercício de 1950, com o estudo de letras hipotecárias e escriturada em conta de ordem pela Contadoria Geral da República.", arquivo:"federal/leis-ordinarias/1952/lei-1621-1952-06-09.md"}}, {id:"federal:BR:L:1739/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-11-21", numero:"1739", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-11-21;1739", vigente:true, titulo:"Lei nº 1.739 de 21/11/1952", urn:"urn:lex:br:federal:lei:1952-11-21;1739", ementa:"Concede a pensão especial de Cr$ 1.145,30 mensais à viuva do Engenheiro José Maia Filho.", arquivo:"federal/leis-ordinarias/1952/lei-1739-1952-11-21.md"}}, {id:"federal:BR:L:1631/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-06-26", numero:"1631", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-06-26;1631", vigente:true, titulo:"Lei nº 1.631 de 26/06/1952", urn:"urn:lex:br:federal:lei:1952-06-26;1631", ementa:"Concede uma pensão especial de Cr$ 463,00 a Hilda Ribeiro de Almeida, e outra de Cr$ 558,00 a Teresa Giancecchi Moreira.", arquivo:"federal/leis-ordinarias/1952/lei-1631-1952-06-26.md"}}, {id:"federal:BR:L:1725/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-11-08", numero:"1725", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-11-08;1725", vigente:true, titulo:"Lei nº 1.725 de 08/11/1952", urn:"urn:lex:br:federal:lei:1952-11-08;1725", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Guerra, o crédito especial de Cr$ 6.080,00, para atender às despesas com o pagamento de honorários, por exercícios findos, aos Professores Alcides Fonseca e Virgílio José Athayde Fernandes Pinheiro.", arquivo:"federal/leis-ordinarias/1952/lei-1725-1952-11-08.md"}}, {id:"federal:BR:L:1612/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-05-28", numero:"1612", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-05-28;1612", vigente:true, titulo:"Lei nº 1.612 de 28/05/1952", urn:"urn:lex:br:federal:lei:1952-05-28;1612", ementa:"Autoriza o Poder Executivo a abrir o crédito especial de Cr$ 356.649,00, para pagamento à Serviços Hollerith S.A., em decorrência do Decreto Legislativo nº 2, de 5 de fevereiro de 1948.", arquivo:"federal/leis-ordinarias/1952/lei-1612-1952-05-28.md"}}, {id:"federal:BR:L:1617/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-06-04", numero:"1617", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-06-04;1617", vigente:true, titulo:"Lei nº 1.617 de 04/06/1952", urn:"urn:lex:br:federal:lei:1952-06-04;1617", ementa:"Concede pensão especial à viúva e filhos menores de Pedro Inácio de Freitas, auxiliar de artífice da Estrada de Ferro Goiás, falecido em consequência de acidente no trabalho, quando em exercício de suas funções.", arquivo:"federal/leis-ordinarias/1952/lei-1617-1952-06-04.md"}}, {id:"federal:BR:L:1714/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-10-29", numero:"1714", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-10-29;1714", vigente:true, titulo:"Lei nº 1.714 de 29/10/1952", urn:"urn:lex:br:federal:lei:1952-10-29;1714", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras Públicas, o crédito especial de Cr$ 13.799.805,20, correspondente a cota que fizeram juz as Companhias carboníferas que especifica, pela quantidade de carvão \"lavador\" fornecida, de julho de 1949 a dezembro de 1950, à Companhia Siderúrgica Nacional.", arquivo:"federal/leis-ordinarias/1952/lei-1714-1952-10-29.md"}}, {id:"federal:BR:L:1679/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-10-01", numero:"1679", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-10-01;1679", vigente:true, titulo:"Lei nº 1.679 de 01/10/1952", urn:"urn:lex:br:federal:lei:1952-10-01;1679", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Justiça e Negócios Interiores, o crédito especial de Cr$ 480.000,00 para pagamento de pensão especial aos veteranos da Revolução Acreana.", arquivo:"federal/leis-ordinarias/1952/lei-1679-1952-10-01.md"}}, {id:"federal:BR:L:1743/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-11-26", numero:"1743", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-11-26;1743", vigente:true, titulo:"Lei nº 1.743 de 26/11/1952", urn:"urn:lex:br:federal:lei:1952-11-26;1743", ementa:"Exclui da classificação constante do art. 1º da Lei nº 121, de 22 de outubro de 1947, o município de Santos, no Estado de São Paulo, e o de Natal, no Estado do Rio Grande do Norte.", arquivo:"federal/leis-ordinarias/1952/lei-1743-1952-11-26.md"}}, {id:"federal:BR:L:1606/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-05-16", numero:"1606", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-05-16;1606", vigente:true, titulo:"Lei nº 1.606 de 16/05/1952", urn:"urn:lex:br:federal:lei:1952-05-16;1606", ementa:"Declara de utilidade pública a Associação dos Servidores Públicos de Sergipe.", arquivo:"federal/leis-ordinarias/1952/lei-1606-1952-05-16.md"}}, {id:"federal:BR:L:1697/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-10-10", numero:"1697", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-10-10;1697", vigente:true, titulo:"Lei nº 1.697 de 10/10/1952", urn:"urn:lex:br:federal:lei:1952-10-10;1697", ementa:"Autoriza o Poder Executivo a abrir o crédito especial de Cr$ 16.200,00, para atender ao pagamento de diferença de aluguéis, relativos a 1950, das salas em que funciona a 2ª Junta de Conciliação e Julgamento de Niterói.", arquivo:"federal/leis-ordinarias/1952/lei-1697-1952-10-10.md"}}, {id:"federal:BR:L:1628/1952", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-06-20", numero:"1628", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-06-20;1628", vigente:true, titulo:"Lei nº 1.628 de 20/06/1952", urn:"urn:lex:br:federal:lei:1952-06-20;1628", ementa:"Dispõe sôbre a restituição dos adicionais criados pelo art. 3º da Lei n° 1.474, de 26 de novembro de 1951, e fixa a respectiva bonificação; autoriza a emissão de obrigações da Dívida Pública Federal; cria o Banco Nacional do Desenvolvimento Econômico; abre crédito especial e dá outras providências.", arquivo:"federal/leis-ordinarias/1952/lei-1628-1952-06-20.md"}}, {id:"federal:BR:L:1609/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-05-22", numero:"1609", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-05-22;1609", vigente:true, titulo:"Lei nº 1.609 de 22/05/1952", urn:"urn:lex:br:federal:lei:1952-05-22;1609", ementa:"Estende os dispositivos da Lei n° 1.195, de 9 de setembro de 1950, aos reformados por incapacidade física, anteriormente à vigência da citada Lei.", arquivo:"federal/leis-ordinarias/1952/lei-1609-1952-05-22.md"}}, {id:"federal:BR:L:1781/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-12-23", numero:"1781", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-12-23;1781", vigente:true, titulo:"Lei nº 1.781 de 23/12/1952", urn:"urn:lex:br:federal:lei:1952-12-23;1781", ementa:"Abre ao Congresso Nacional - Câmara dos Deputados - o crédito especial de Cr$ 101.780,60, para pagamento aos herdeiros do ex-funcionário desta Casa do Congresso, Dr. Leônidas Resende, e dá outras providências.", arquivo:"federal/leis-ordinarias/1952/lei-1781-1952-12-23.md"}}, {id:"federal:BR:L:1636/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-07-11", numero:"1636", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-07-11;1636", vigente:true, titulo:"Lei nº 1.636 de 11/07/1952", urn:"urn:lex:br:federal:lei:1952-07-11;1636", ementa:"Estende aos servidores das estradas de ferro da União, sob regime de autarquia, os direitos e vantagens previstos na Lei nº 1.163, de 22 de julho de 1950, que dispõe sobre a Estrada de Ferro Central do Brasil.", arquivo:"federal/leis-ordinarias/1952/lei-1636-1952-07-11.md"}}, {id:"federal:BR:L:1642/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-07-14", numero:"1642", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-07-14;1642", vigente:true, titulo:"Lei nº 1.642 de 14/07/1952", urn:"urn:lex:br:federal:lei:1952-07-14;1642", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o crédito especial de Cr$ 2.000.000,00, para aquisição de instalação do equipamento para o Matadouro do Núcleo Agro-Industrial São Francisco.", arquivo:"federal/leis-ordinarias/1952/lei-1642-1952-07-14.md"}}, {id:"federal:BR:L:1792/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-12-30", numero:"1792", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-12-30;1792", vigente:true, titulo:"Lei nº 1.792 de 30/12/1952", urn:"urn:lex:br:federal:lei:1952-12-30;1792", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Guerra, o crédito especial de Cr$ 2.325.996,00, para pagamento de gratificação de paraquedismo ao pessoal formado pelo antigo Núcleo de Formação de Paraquedistas do Exército, no exercício de 1949.", arquivo:"federal/leis-ordinarias/1952/lei-1792-1952-12-30.md"}}, {id:"federal:BR:L:1799/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-12-31", numero:"1799", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-12-31;1799", vigente:true, titulo:"Lei nº 1.799 de 31/12/1952", urn:"urn:lex:br:federal:lei:1952-12-31;1799", ementa:"Autoriza o Poder Executivo a abrir, ao Poder Judiciário, o crédito especial de Cr$ 400.000,00 para pagamento de despesas de material com a reinstalação do Tribunal Regional Eleitoral do Estado do Maranhão.", arquivo:"federal/leis-ordinarias/1952/lei-1799-1952-12-31.md"}}, {id:"federal:BR:L:1749/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-11-28", numero:"1749", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-11-28;1749", vigente:true, titulo:"Lei nº 1.749 de 28/11/1952", urn:"urn:lex:br:federal:lei:1952-11-28;1749", ementa:"Dispõe sobre o imposto único dos lubrificantes e combustíveis líquidos ou gasosos de qualquer origem ou natureza.", arquivo:"federal/leis-ordinarias/1952/lei-1749-1952-11-28.md"}}, {id:"federal:BR:L:1767/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-12-18", numero:"1767", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-12-18;1767", vigente:true, titulo:"Lei nº 1.767 de 18/12/1952", urn:"urn:lex:br:federal:lei:1952-12-18;1767", ementa:"Exclui da classificação constante do artigo 1º, da Lei nº 121, de 23 de outubro de 1947, o município de Corumbá, no Estado de Mato Grosso.", arquivo:"federal/leis-ordinarias/1952/lei-1767-1952-12-18.md"}}, {id:"federal:BR:L:1740/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-11-21", numero:"1740", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-11-21;1740", vigente:true, titulo:"Lei nº 1.740 de 21/11/1952", urn:"urn:lex:br:federal:lei:1952-11-21;1740", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Justiça e Negócios Interiores, o crédito especial de Cr$ 500.000,00 para instalação da 1ª Conferência Regional das Nações Unidas da América Latina.", arquivo:"federal/leis-ordinarias/1952/lei-1740-1952-11-21.md"}}, {id:"federal:BR:L:1680/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-10-01", numero:"1680", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-10-01;1680", vigente:true, titulo:"Lei nº 1.680 de 01/10/1952", urn:"urn:lex:br:federal:lei:1952-10-01;1680", ementa:"Autoriza o Poder executivo a construir e pavimentar o trecho Itumbiara-Monte Alegre de Minas, da BR-14 do Plano Rodoviário Nacional, e a ligação Monte Alegre-Uberlândia.", arquivo:"federal/leis-ordinarias/1952/lei-1680-1952-10-01.md"}}, {id:"federal:BR:L:1663/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-08-27", numero:"1663", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-08-27;1663", vigente:true, titulo:"Lei nº 1.663 de 27/08/1952", urn:"urn:lex:br:federal:lei:1952-08-27;1663", ementa:"Autoriza a abertura ao Poder Judiciário - Superior Tribunal Militar - do crédito especial de Cr$ 792.000,00, para atender às despesas com pagamento de gratificações adicionais aos Ministros daquele Tribunal.", arquivo:"federal/leis-ordinarias/1952/lei-1663-1952-08-27.md"}}, {id:"federal:BR:L:1775/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-12-19", numero:"1775", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-12-19;1775", vigente:true, titulo:"Lei nº 1.775 de 19/12/1952", urn:"urn:lex:br:federal:lei:1952-12-19;1775", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações Exteriores, o crédito especial de Cr$ 1.942.911,50 , para atender ao pagamento da contribuição do Brasil, em favor do Comité Provisório Intergovernamental, para os movimentos migratórios da Europa.", arquivo:"federal/leis-ordinarias/1952/lei-1775-1952-12-19.md"}}, {id:"federal:BR:L:1654/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-07-28", numero:"1654", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-07-28;1654", vigente:true, titulo:"Lei nº 1.654 de 28/07/1952", urn:"urn:lex:br:federal:lei:1952-07-28;1654", ementa:"Autoriza a União a constituir, com o Estado do Amazonas e o município de sua capital, a \"Companhia de Eletricidade de Manaus\", e dá outras providências.", arquivo:"federal/leis-ordinarias/1952/lei-1654-1952-07-28.md"}}, {id:"federal:BR:L:1702/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-10-15", numero:"1702", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-10-15;1702", vigente:true, titulo:"Lei nº 1.702 de 15/10/1952", urn:"urn:lex:br:federal:lei:1952-10-15;1702", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações Exteriores, o crédito especial de Cr$ 308.674,26, para atender ao pagamento das despesas efetuadas pelo Governo dos Estados Unidos da América, com a repatriação de brasileiros que se encontravam na Ásia.", arquivo:"federal/leis-ordinarias/1952/lei-1702-1952-10-15.md"}}, {id:"federal:BR:L:1560/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-02-21", numero:"1560", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-02-21;1560", vigente:true, titulo:"Lei nº 1.560 de 21/02/1952", urn:"urn:lex:br:federal:lei:1952-02-21;1560", ementa:"Autoriza o Poder Executivo a abrir ao Ministério das Relações Exteriores o crédito especial de Cr$ 600.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/1952/lei-1560-1952-02-21.md"}}, {id:"federal:BR:L:1721/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-11-04", numero:"1721", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-11-04;1721", vigente:true, titulo:"Lei nº 1.721 de 04/11/1952", urn:"urn:lex:br:federal:lei:1952-11-04;1721", ementa:"Dispõe sobre as carreiras de contínuo e servente do serviço público federal, e dá outras providências.", arquivo:"federal/leis-ordinarias/1952/lei-1721-1952-11-04.md"}}, {id:"federal:BR:L:1541/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-01-05", numero:"1541", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-01-05;1541", vigente:true, titulo:"Lei nº 1.541 de 05/01/1952", urn:"urn:lex:br:federal:lei:1952-01-05;1541", ementa:"Autoriza a abertura ao Poder Judiciário - Justiça do Trabalho - de crédito especial de Cr$ 3.807.847,40, para pagamento de despesas relativas ao exercicío de 1951.", arquivo:"federal/leis-ordinarias/1952/lei-1541-1952-01-05.md"}}, {id:"federal:BR:L:1570/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-03-10", numero:"1570", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-03-10;1570", vigente:true, titulo:"Lei nº 1.570 de 10/03/1952", urn:"urn:lex:br:federal:lei:1952-03-10;1570", ementa:"Autoriza a abertura, pelo Ministério da Agricultura, de crédito especial de Cr$ 1.000.000,00, para ressarcimento das despesas e trabalhos realizados por Manoel Inácio Bastos e Oscar Salvador Cordeiro.", arquivo:"federal/leis-ordinarias/1952/lei-1570-1952-03-10.md"}}, {id:"federal:BR:L:1997/1871", properties:{esfera:"federal", situacao:"Não Informado", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"situacao:Não Informado", ano:1871, data:"1871-08-19", numero:"1997", fonte:"https://www2.camara.leg.br/legin/fed/leimp/1824-1899/lei-1997-19-agosto-1871-551922-publicacaooriginal-68779-pl.html", vigente:true, titulo:"Lei nº 1.997, de 19 de Agosto de 1871", urn:"urn:lex:br:federal:lei:1871-08-19;1997", ementa:"Fixa a Força Naval para o anno financeiro de 1872-1873.", arquivo:"federal/leis-ordinarias/1871/lei-1997-1871-08-19.md"}}, {id:"federal:BR:L:1996/1871", properties:{esfera:"federal", situacao:"Não Informado", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"situacao:Não Informado", ano:1871, data:"1871-08-16", numero:"1996", fonte:"https://www2.camara.leg.br/legin/fed/leimp/1824-1899/lei-1996-16-agosto-1871-551921-publicacaooriginal-68778-pl.html", vigente:true, titulo:"Lei nº 1.996, de 16 de Agosto de 1871", urn:"urn:lex:br:federal:lei:1871-08-16;1996", ementa:"Marca ajudas de custo aos Sacerdotes eleitos e confirmados Bispos", arquivo:"federal/leis-ordinarias/1871/lei-1996-1871-08-16.md"}}, {id:"federal:BR:L:2033/1871", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1871, data:"1871-09-20", numero:"2033", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1871-09-20;2033", vigente:true, titulo:"Lei nº 2.033 de 20/09/1871", urn:"urn:lex:br:federal:lei:1871-09-20;2033", ementa:"ALTERA DIFERENTES DISPOSIÇÕES DA LEGISLAÇÃO JUDICIARIA.", arquivo:"federal/leis-ordinarias/1871/lei-2033-1871-09-20.md"}}, {id:"federal:BR:L:1913/1871", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1871, data:"1871-05-17", numero:"1913", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1871-05-17;1913", vigente:true, titulo:"Lei nº 1.913 de 17/05/1871", urn:"urn:lex:br:federal:lei:1871-05-17;1913", ementa:"OUTORGA O CONSENTIMENTO, DE QUE TRATA O ARTIGO 104 DA CONSTITUIÇÃO, PARA QUE SUA MAJESTADE O IMPERADOR POSSA SAIR DO IMPÉRIO, E DECLARA QUE, DURANTE SUA AUSÊNCIA GOVERNARÁ COMO REGENTE A PRINCESA IMPERIAL A SENHORA D. ISABEL.", arquivo:"federal/leis-ordinarias/1871/lei-1913-1871-05-17.md"}}, {id:"federal:BR:L:1973/1871", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1871, data:"1871-08-09", numero:"1973", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1871-08-09;1973", vigente:true, titulo:"Lei nº 1.973 de 09/08/1871", urn:"urn:lex:br:federal:lei:1871-08-09;1973", ementa:"FIXA AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1872 A 1873.", arquivo:"federal/leis-ordinarias/1871/lei-1973-1871-08-09.md"}}, {id:"federal:BR:L:2040/1871", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1871, data:"1871-09-28", numero:"2040", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1871-09-28;2040", vigente:true, titulo:"Lei nº 2.040 de 28/09/1871", urn:"urn:lex:br:federal:lei:1871-09-28;2040", ementa:"DECLARA DE CONDIÇÃO LIVRE OS FILHOS DE MULHER ESCRAVA QUE NASCEREM DESDE A DATA DESTA LEI, LIBERTOS OS ESCRAVOS DA NAÇÃO E OUTROS, E PROVIDÊNCIA SOBRE A CRIAÇÃO E TRATAMENTO DAQUELES FILHOS MENORES E SOBRE A LIBERTAÇÃO ANUAL DE ESCRAVOS.", arquivo:"federal/leis-ordinarias/1871/lei-2040-1871-09-28.md"}}, {id:"federal:BR:L:1953/1871", properties:{esfera:"federal", situacao:"Não Informado", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"situacao:Não Informado", ano:1871, data:"1871-07-17", numero:"1953", fonte:"https://www2.camara.leg.br/legin/fed/leimp/1824-1899/lei-1953-17-julho-1871-551973-publicacaooriginal-68868-pl.html", vigente:true, titulo:"Lei nº 1.953, de 17 de Julho de 1871", urn:"urn:lex:br:federal:lei:1871-07-17;1953", ementa:"Abrindo um credito de 20.000:000$000, para o prolongamento da estrada de ferro de D. Pedro II, e dando providencias para o das estradas de ferro subvencionadas pelo Thesouro Nacional.", arquivo:"federal/leis-ordinarias/1871/lei-1953-1871-07-17.md"}}, {id:"federal:BR:L:5566/1969", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1969, data:"1969-11-19", numero:"5566", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1969-11-19;5566", vigente:true, titulo:"Lei nº 5.566 de 19/11/1969", urn:"urn:lex:br:federal:lei:1969-11-19;5566", ementa:"Assegura inscrição nos concursos de habilitação para ingresso nos cursos de ensino superior aos graduados em escolas normais.", arquivo:"federal/leis-ordinarias/1969/lei-5566-1969-11-19.md"}}, {id:"federal:BR:L:5569/1969", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1969, data:"1969-11-25", numero:"5569", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1969-11-25;5569", vigente:true, titulo:"Lei nº 5.569 de 25/11/1969", urn:"urn:lex:br:federal:lei:1969-11-25;5569", ementa:"Acrescenta dispositivos ao artigo 1º da Lei nº 4.729, de 14 de julho de 1965, que define o crime de sonegação fiscal, e dá outras providências.", arquivo:"federal/leis-ordinarias/1969/lei-5569-1969-11-25.md"}}, {id:"federal:BR:L:5571/1969", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1969, data:"1969-11-28", numero:"5571", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1969-11-28;5571", vigente:true, titulo:"Lei nº 5.571 de 28/11/1969", urn:"urn:lex:br:federal:lei:1969-11-28;5571", ementa:"Denomina \"Dia da Independência\" a data de sete de setembro e traça normas para a sua comemoração.", arquivo:"federal/leis-ordinarias/1969/lei-5571-1969-11-28.md"}}, {id:"federal:BR:L:5565/1969", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1969, data:"1969-11-05", numero:"5565", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1969-11-05;5565", vigente:true, titulo:"Lei nº 5.565 de 05/11/1969", urn:"urn:lex:br:federal:lei:1969-11-05;5565", ementa:"Altera os artigos 517, 520 e 523 do Código de Processo Civil.", arquivo:"federal/leis-ordinarias/1969/lei-5565-1969-11-05.md"}}, {id:"federal:BR:L:5567/1969", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1969, data:"1969-11-25", numero:"5567", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1969-11-25;5567", vigente:true, titulo:"Lei nº 5.567 de 25/11/1969", urn:"urn:lex:br:federal:lei:1969-11-25;5567", ementa:"Dá nova redação ao \"caput\" do artigo 1º da Lei nº 94, de 16 de setembro de 1947, que permite aos Juízes da Fazenda Pública a requisição de processos administrativos para a extração de peças.", arquivo:"federal/leis-ordinarias/1969/lei-5567-1969-11-25.md"}}, {id:"federal:BR:L:5572/1969", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1969, data:"1969-12-01", numero:"5572", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1969-12-01;5572", vigente:true, titulo:"Lei nº 5.572 de 01/12/1969", urn:"urn:lex:br:federal:lei:1969-12-01;5572", ementa:"Concede pensão especial ao ex-servidor Leopoldo Vieira Machado, da então Diretoria Regional dos Correios e Telégrafos em Vitória, Estado do Espírito Santo.", arquivo:"federal/leis-ordinarias/1969/lei-5572-1969-12-01.md"}}, {id:"federal:BR:L:5570/1969", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1969, data:"1969-11-28", numero:"5570", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1969-11-28;5570", vigente:true, titulo:"Lei nº 5.570 de 28/11/1969", urn:"urn:lex:br:federal:lei:1969-11-28;5570", ementa:"Dispõe sôbre a adaptação dos Tribunais de Contas ao disposto no artigo 13, IX, e artigo 200, ambos da Constituição da República Federativa do Brasil.", arquivo:"federal/leis-ordinarias/1969/lei-5570-1969-11-28.md"}}, {id:"federal:BR:L:5575/1969", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1969, data:"1969-12-17", numero:"5575", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1969-12-17;5575", vigente:true, titulo:"Lei nº 5.575 de 17/12/1969", urn:"urn:lex:br:federal:lei:1969-12-17;5575", ementa:"Reconhece de utilidade pública as unidades do \"Lions Clube\" e do Rotary Club do Brasil e dá outras providências.", arquivo:"federal/leis-ordinarias/1969/lei-5575-1969-12-17.md"}}, {id:"federal:BR:L:5568/1969", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1969, data:"1969-11-25", numero:"5568", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1969-11-25;5568", vigente:true, titulo:"Lei nº 5.568 de 25/11/1969", urn:"urn:lex:br:federal:lei:1969-11-25;5568", ementa:"Dispõe sôbre a aplicação do Estatuto do Trabalhor Rural onde não funciona o Conselho Arbitral .", arquivo:"federal/leis-ordinarias/1969/lei-5568-1969-11-25.md"}}, {id:"federal:BR:L:5574/1969", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1969, data:"1969-12-10", numero:"5574", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1969-12-10;5574", vigente:true, titulo:"Lei nº 5.574 de 10/12/1969", urn:"urn:lex:br:federal:lei:1969-12-10;5574", ementa:"Denomina Ginásio Agrícola \"Clemente Medrado\", o atual Ginásio Agrícola de Salinas, no Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/1969/lei-5574-1969-12-10.md"}}, {id:"federal:BR:L:3376/1888", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1888, data:"1888-10-06", numero:"3376", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1888-10-06;3376", vigente:true, titulo:"Lei nº 3.376 de 06/10/1888", urn:"urn:lex:br:federal:lei:1888-10-06;3376", ementa:"ABRE AO MINISTÉRIO DA MARINHA O CRÉDITO DE  442:303$129 PARA - FORÇA NAVAL -, 3$000 PARA - ETAPAS - E 103:862$506 PARA - MUNIÇÕES NAVAIS - DO EXERCÍCIO DE 1886-1887.", arquivo:"federal/leis-ordinarias/1888/lei-3376-1888-10-06.md"}}, {id:"federal:BR:L:3367/1888", properties:{esfera:"federal", versao_texto:"original", t