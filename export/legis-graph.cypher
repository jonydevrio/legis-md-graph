is-ordinarias/1978/lei-6613-1978-12-07.md"}}, {id:"federal:BR:L:6604/1978", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-12-07", numero:"6604", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-12-07;6604", vigente:true, titulo:"Lei nº 6.604 de 07/12/1978", urn:"urn:lex:br:federal:lei:1978-12-07;6604", ementa:"Dispõe sobre a criação e extinção de cargos no Quadro de Pessoal dos Serviços Auxiliares do Tribunal de Contas do Distrito Federal, e dá outras providências.", arquivo:"federal/leis-ordinarias/1978/lei-6604-1978-12-07.md"}}, {id:"federal:BR:L:6521/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-04-08", numero:"6521", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-04-08;6521", vigente:true, titulo:"Lei nº 6.521 de 08/04/1978", urn:"urn:lex:br:federal:lei:1978-04-08;6521", ementa:"Autoriza o Instituto Brasileiro do Café, autarquia federal vinculada ao   Ministério da Indústria e do Comércio, a alienar imóvel de sua propriedade,   localizado na capital do Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1978/lei-6521-1978-04-08.md"}}, {id:"federal:BR:L:6566/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-09-19", numero:"6566", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-09-19;6566", vigente:true, titulo:"Lei nº 6.566 de 19/09/1978", urn:"urn:lex:br:federal:lei:1978-09-19;6566", ementa:"Autoriza o Instituto Nacional de Colonização e Reforma Agrária - INCRA - a   doar o imóvel que menciona.", arquivo:"federal/leis-ordinarias/1978/lei-6566-1978-09-19.md"}}, {id:"federal:BR:L:6519/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-03-28", numero:"6519", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-03-28;6519", vigente:true, titulo:"Lei nº 6.519 de 28/03/1978", urn:"urn:lex:br:federal:lei:1978-03-28;6519", ementa:"Autoriza o Poder Executivo a subscrever ações do Banco do Brasil S.A.,   abrir crédito especial até o limite de Cr$ 3.500.000.000,00 ( três bilhões e   quinhentos milhões de cruzeiros ) para esse fim, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1978/lei-6519-1978-03-28.md"}}, {id:"federal:BR:L:6574/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-09-30", numero:"6574", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-09-30;6574", vigente:true, titulo:"Lei nº 6.574 de 30/09/1978", urn:"urn:lex:br:federal:lei:1978-09-30;6574", ementa:"Altera a diretriz da ferrovia EF-463 integrante do Plano Nacional de Viação, aprovado pela Lei nº 5.917, de 10 de setembro de 1973.", arquivo:"federal/leis-ordinarias/1978/lei-6574-1978-09-30.md"}}, {id:"federal:BR:L:6548/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-07-04", numero:"6548", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-07-04;6548", vigente:true, titulo:"Lei nº 6.548 de 04/07/1978", urn:"urn:lex:br:federal:lei:1978-07-04;6548", ementa:"Concede pensão especial a Maria Aparecida da Silva Fonseca, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1978/lei-6548-1978-07-04.md"}}, {id:"federal:BR:L:6570/1978", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-09-30", numero:"6570", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-09-30;6570", vigente:true, titulo:"Lei nº 6.570 de 30/09/1978", urn:"urn:lex:br:federal:lei:1978-09-30;6570", ementa:"Prorroga o prazo de validade da carteira de identidade para estrangeiros.", arquivo:"federal/leis-ordinarias/1978/lei-6570-1978-09-30.md"}}, {id:"federal:BR:L:6596/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-12-01", numero:"6596", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-12-01;6596", vigente:true, titulo:"Lei nº 6.596 de 01/12/1978", urn:"urn:lex:br:federal:lei:1978-12-01;6596", ementa:"Eleva, em até Cr$ 1.280.000.000,00, o limite concedido ao Governo do   Distrito Federal para promover abertura de créditos suplementares ao Orçamento   vigente.", arquivo:"federal/leis-ordinarias/1978/lei-6596-1978-12-01.md"}}, {id:"federal:BR:L:6608/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-12-07", numero:"6608", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-12-07;6608", vigente:true, titulo:"Lei nº 6.608 de 07/12/1978", urn:"urn:lex:br:federal:lei:1978-12-07;6608", ementa:"Autoriza a alienação do imóvel que menciona, situado na Cidade e Estado do   Rio de Janeiro e dá outras providências.", arquivo:"federal/leis-ordinarias/1978/lei-6608-1978-12-07.md"}}, {id:"federal:BR:L:6552/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-07-05", numero:"6552", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1978-07-05;6552", vigente:true, titulo:"Lei nº 6.552 de 05/07/1978", urn:"urn:lex:br:federal:lei:1978-07-05;6552", ementa:"Concede pensão especial a Elisa Trachtemberg, viúva do Médico Sanitarista   Noel Nutels.", arquivo:"federal/leis-ordinarias/1978/lei-6552-1978-07-05.md"}}, {id:"federal:BR:L:6517/1978", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1978, data:"1978-03-17", numero:"6517", fonte:"https://normas.leg.br/?urn=urn:lex:br:f