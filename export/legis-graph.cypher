5", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-06-05;14595", vigente:true, titulo:"Lei nº 14.595 de 05/06/2023", urn:"urn:lex:br:federal:lei:2023-06-05;14595", ementa:"Altera a Lei nº 12.651, de 25 de maio de 2012, de forma a regulamentar prazos e condições para a adesão ao Programa de Regularização Ambiental (PRA), e a Lei nº 11.428, de 22 de dezembro de 2006.", arquivo:"federal/leis-ordinarias/2023/lei-14595-2023-06-05.md"}}, {id:"federal:BR:L:14637/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-25", numero:"14637", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-25;14637", vigente:true, titulo:"Lei nº 14.637 de 25/07/2023", urn:"urn:lex:br:federal:lei:2023-07-25;14637", ementa:"Institui a Política Nacional de Incentivo à Cultura de Flores e de Plantas Ornamentais de Qualidade.", arquivo:"federal/leis-ordinarias/2023/lei-14637-2023-07-25.md"}}, {id:"federal:BR:L:14738/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-11-28", numero:"14738", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-11-28;14738", vigente:true, titulo:"Lei nº 14.738 de 28/11/2023", urn:"urn:lex:br:federal:lei:2023-11-28;14738", ementa:"Confere ao Município de Canela, no Estado do Rio Grande do Sul, o título de Capital Nacional dos Parques Temáticos.", arquivo:"federal/leis-ordinarias/2023/lei-14738-2023-11-28.md"}}, {id:"federal:BR:L:14665/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-09-04", numero:"14665", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-09-04;14665", vigente:true, titulo:"Lei nº 14.665 de 04/09/2023", urn:"urn:lex:br:federal:lei:2023-09-04;14665", ementa:"Institui o Dia Nacional dos Desbravadores.", arquivo:"federal/leis-ordinarias/2023/lei-14665-2023-09-04.md"}}, {id:"federal:BR:L:14585/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-05-16", numero:"14585", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-05-16;14585", vigente:true, titulo:"Lei nº 14.585 de 16/05/2023", urn:"urn:lex:br:federal:lei:2023-05-16;14585", ementa:"Cria o Dia Nacional de Conscientização sobre a Hemoglobinúria Paroxística Noturna (HPN) e o Dia Nacional de Conscientização sobre a Síndrome Hemolítico-Urêmica atípica (SHUa).", arquivo:"federal/leis-ordinarias/2023/lei-14585-2023-05-16.md"}}, {id:"federal:BR:L:14783/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-27", numero:"14783", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-27;14783", vigente:true, titulo:"Lei nº 14.783 de 27/12/2023", urn:"urn:lex:br:federal:lei:2023-12-27;14783", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor de diversos Órgãos do Poder Executivo, crédito suplementar no valor de R$ 869.013.628,00 para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2023/lei-14783-2023-12-27.md"}}, {id:"federal:BR:L:14569/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-05-05", numero:"14569", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-05-05;14569", vigente:true, titulo:"Lei nº 14.569 de 05/05/2023", urn:"urn:lex:br:federal:lei:2023-05-05;14569", ementa:"Confere ao Município de Guabiju, no Estado do Rio Grande do Sul, o título de Capital Nacional do Guabiju.", arquivo:"federal/leis-ordinarias/2023/lei-14569-2023-05-05.md"}}, {id:"federal:BR:L:14790/2023", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false"