UNWIND [{id:"federal:BR:L:5449/1968", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-06-04", numero:"5449", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-06-04;5449", vigente:true, titulo:"Lei nº 5.449 de 04/06/1968", urn:"urn:lex:br:federal:lei:1968-06-04;5449", ementa:"Declara de interesse da segurança nacional, nos termos do art 16, § 1º, alínea b, da Constituição, os Municípios que especifica, e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5449-1968-06-04.md"}}, {id:"federal:BR:L:5454/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-06-17", numero:"5454", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-06-17;5454", vigente:true, titulo:"Lei nº 5.454 de 17/06/1968", urn:"urn:lex:br:federal:lei:1968-06-17;5454", ementa:"Concede pensão especial ao Professor Robert Joachimovits.", arquivo:"federal/leis-ordinarias/1968/lei-5454-1968-06-17.md"}}, {id:"federal:BR:L:5484/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-08-21", numero:"5484", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-08-21;5484", vigente:true, titulo:"Lei nº 5.484 de 21/08/1968", urn:"urn:lex:br:federal:lei:1968-08-21;5484", ementa:"Isenta do Imposto de importação e do imposto sobre produtos   industrializados material doado à Igreja Metodista Central de Belo Horizonte,   Minas Gerais.", arquivo:"federal/leis-ordinarias/1968/lei-5484-1968-08-21.md"}}, {id:"federal:BR:L:5562/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-12-12", numero:"5562", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-12-12;5562", vigente:true, titulo:"Lei nº 5.562 de 12/12/1968", urn:"urn:lex:br:federal:lei:1968-12-12;5562", ementa:"Altera disposições da Consolidação das Leis do Trabalho, aprovada pelo   Decreto-Lei nº 5.452, de 1º de maio de 1943, e revoga as Leis nºs. 4.066, de 28   de maio de 1962 e 5.472, de 9 de julho de 1968, que dispõem sobre a validade de   pedido de demissão ou recibo de quitação contratual, firmado por empregado.", arquivo:"federal/leis-ordinarias/1968/lei-5562-1968-12-12.md"}}, {id:"federal:BR:L:5451/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-06-12", numero:"5451", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-06-12;5451", vigente:true, titulo:"Lei nº 5.451 de 12/06/1968", urn:"urn:lex:br:federal:lei:1968-06-12;5451", ementa:"Dispõe sobre reajustamento salarial.", arquivo:"federal/leis-ordinarias/1968/lei-5451-1968-06-12.md"}}, {id:"federal:BR:L:5536/1968", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-11-21", numero:"5536", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-11-21;5536", vigente:true, titulo:"Lei nº 5.536 de 21/11/1968", urn:"urn:lex:br:federal:lei:1968-11-21;5536", ementa:"Dispõe sobre a censura de obras teatrais e cinematográficas, cria o Conselho Superior de Censura, e dá outras providências.", arquivo:"federal/leis-ordinarias/1968/lei-5536-1968-11-21.md"}}, {id:"federal:BR:L:5517/1968", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1968, data:"1968-10-23", numero:"5517", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1968-10-23;5517", vigente:true, titulo:"Lei nº 5.517 de 23/10/1968", urn:"urn:lex:br:federal:lei:1968-10-23;5517", ementa:"Dispõe sobre o exercício da profissão de médico-veterinário e cria os Conselhos Federal e Regionais de Medicina Veterinária.", arquivo:"federal/leis-ordinaria