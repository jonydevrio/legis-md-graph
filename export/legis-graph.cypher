federal/leis-ordinarias/2002/lei-10462-2002-05-23.md"}}, {id:"federal:BR:L:10617/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2002, data:"2002-12-23", numero:"10617", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2002-12-23;10617", vigente:true, titulo:"Lei nº 10.617 de 23/12/2002", urn:"urn:lex:br:federal:lei:2002-12-23;10617", ementa:"Abre ao Orçamento de Investimento, para 2002, em favor de diversas empresas do Grupo PETROBRÁS, crédito suplementar no valor total de R$ 1.843.369.241,00 e reduz o Orçamento de Investimento das mesmas empresas no valor global de R$ 2.367.078.669,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2002/lei-10617-2002-12-23.md"}}, {id:"federal:BR:L:10622/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2002, data:"2002-12-23", numero:"10622", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2002-12-23;10622", vigente:true, titulo:"Lei nº 10.622 de 23/12/2002", urn:"urn:lex:br:federal:lei:2002-12-23;10622", ementa:"Abre crédito suplementar aos Orçamentos Fiscal e da Seguridade Social da União, em favor dos Ministérios da Agricultura, Pecuária e Abastecimento e do Desenvolvimento Agrário, no valor global de R$ 28.205.505,00 para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2002/lei-10622-2002-12-23.md"}}, {id:"federal:BR:L:10496/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2002, data:"2002-07-08", numero:"10496", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2002-07-08;10496", vigente:true, titulo:"Lei nº 10.496 de 08/07/2002", urn:"urn:lex:br:federal:lei:2002-07-08;10496", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério da Educação,   crédito especial no valor de R$ 3.000.000,00, para os fins que especifica", arquivo:"federal/leis-ordinarias/2002/lei-10496-2002-07-08.md"}}, {id:"federal:BR:L:10513/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2002, data:"2002-07-11", numero:"10513", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2002-07-11;10513", vigente:true, titulo:"Lei nº 10.513 de 11/07/2002", urn:"urn:lex:br:federal:lei:2002-07-11;10513", ementa:"Abre ao Orçamento de Investimento, para 2002, em favor de diversas   empresas, crédito suplementar no valor total de R$ 4.125.562,00, para os fins   que especifica.", arquivo:"federal/leis-ordinarias/2002/lei-10513-2002-07-11.md"}}, {id:"federal:BR:L:10561/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2002, data:"2002-11-13", numero:"10561", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2002-11-13;10561", vigente:true, titulo:"Lei nº 10.561 de 13/11/2002", urn:"urn:lex:br:federal:lei:2002-11-13;10561", ementa:"Altera as Leis nºs 10.209, de 23 de março de 2001, e 10.233, de 5 de junho de 2001, e dá outras providências.", arquivo:"federal/leis-ordinarias/2002/lei-10561-2002-11-13.md"}}, {id:"federal:BR:L:10544/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2002, data:"2002-11-12", numero:"10544", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2002-11-12;10544", vigente:true, titulo:"Lei nº 10.544 de 12/11/2002", urn:"urn:lex:br:federal:lei:2002-11-12;10544", ementa:"Abre ao Orçamento da Seguridade Social da União crédito suplementar no valor de R$ 467.434,00, em favor do Ministério da Previdência e Assistência Social, para reforço de dotações constantes do orçamento vigente.", arquivo:"federal/leis-ordinarias/2002/lei-10544-2002-11-12.md"}}, {id:"federal:BR:L:10404/2002", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária",