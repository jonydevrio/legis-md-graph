/?urn=urn:lex:br:federal:lei:1957-11-18;3316", vigente:true, titulo:"Lei nº 3.316 de 18/11/1957", urn:"urn:lex:br:federal:lei:1957-11-18;3316", ementa:"Concede a pensão especial de Cr$ 3.000,00 mensais a Aldina Cordeiro Côrtes, viúva do jornalista e historiador José Saboia Côrtes.", arquivo:"federal/leis-ordinarias/1957/lei-3316-1957-11-18.md"}}, {id:"federal:BR:L:3224/1957", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-07-24", numero:"3224", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1957-07-24;3224", vigente:true, titulo:"Lei nº 3.224 de 24/07/1957", urn:"urn:lex:br:federal:lei:1957-07-24;3224", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, os créditos especiais de Cr$ 4.000.000,00 e Cr$ 2.000.000,00 para auxiliar a realização das Exposições Industriais e Viti-vinícolas de Jundiaí e São Roque, no Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1957/lei-3224-1957-07-24.md"}}, {id:"federal:BR:L:3175/1957", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-06-11", numero:"3175", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1957-06-11;3175", vigente:true, titulo:"Lei nº 3.175 de 11/06/1957", urn:"urn:lex:br:federal:lei:1957-06-11;3175", ementa:"Autoriza o Poder Executivo a emitir pelo Ministério da Viação e Obras Públicas - Departamento dos Correios e Telégrafos - uma série de selos postais comemorativos do transcurso do centenário da fundação da cidade de Brusque, Estado da Santa Catarina.", arquivo:"federal/leis-ordinarias/1957/lei-3175-1957-06-11.md"}}, {id:"federal:BR:L:3237/1957", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-08-01", numero:"3237", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1957-08-01;3237", vigente:true, titulo:"Lei nº 3.237 de 01/08/1957", urn:"urn:lex:br:federal:lei:1957-08-01;3237", ementa:"Concede a pensão especial de Cr$ 2.000,00 mensais a Alexandrina Almeida Antunes e Florentina Almeida Antunes, filhas da funcionária dos Correios e Telégrafos, já falecida, Maria Arcelina de Almeida.", arquivo:"federal/leis-ordinarias/1957/lei-3237-1957-08-01.md"}}, {id:"federal:BR:L:3296/1957", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-10-30", numero:"3296", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1957-10-30;3296", vigente:true, titulo:"Lei nº 3.296 de 30/10/1957", urn:"urn:lex:br:federal:lei:1957-10-30;3296", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o crédito especial de Cr$ 2.000.000,00 para auxiliar a realização da II Exposição Agro-Avícola-Industrial no Município de Canoinhas, Estado de Santa Catarina.", arquivo:"federal/leis-ordinarias/1957/lei-3296-1957-10-30.md"}}, {id:"federal:BR:L:3097/1957", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-01-31", numero:"3097", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1957-01-31;3097", vigente:true, titulo:"Lei nº 3.097 de 31/01/1957", urn:"urn:lex:br:federal:lei:1957-01-31;3097", ementa:"Dispõe sobre as anuidades devidas aos Conselhos de Engenharia e   Arquitetura pelos profissionais e firmas que lhes estejam jurisdicionados.", arquivo:"federal/leis-ordinarias/1957/lei-3097-1957-01-31.md"}}, {id:"federal:BR:L:3211/1957", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-07-19", numero:"3211", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1957-07-19;3211", vigente:true, titulo:"Lei nº 3.211 de 19/07/1957", urn:"urn:lex:br:federal:lei:1957-07-19;3211", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça Eleitoral - Tribunal Regional Eleitoral de Goiás - o crédito especial de Cr$ 138.912,60, para ocorrer ao pagamento de gratificações adicionais, por tempo de serviço, aos servidores do Quadro de Pessoal da Secretaria do mesmo Tribunal.", arquivo:"federal/leis-ordinarias/1957/lei-3211-1957-07-19.md"}}, {id:"federal:BR:L:3171/1957", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-06-06", numero:"3171", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1957-06-06;3171", vigente:true, titulo:"Lei nº 3.171 de 06/06/1957", urn:"urn:lex:br:federal:lei:1957-06-06;3171", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura, o crédito especial de Cr$ 1.200.000,00, para auxiliar o desenvolvimento das obras educativas e assistenciais da Província Franciscana de Santo Antônio, sediada no Estado de Pernambuco, ao ensejo do Transcurso de seu terceiro centenário e da realização do certame histórico-cultural.", arquivo:"federal/leis-ordinarias/1957/lei-3171-1957-06-06.md"}}, {id:"federal:BR:L:3154/1957", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-05-24", numero:"3154", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1957-05-24;3154", vigente:true, titulo:"Lei nº 3.154 de 24/05/1957", urn:"urn:lex:br:federal:lei:1957-05-24;3154", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 250.000,00 para ocorrer as despesas com o pagamento de trabalhos extraordinários executados pelos funcionários do Serviço de Importação Aérea da Alfândega do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1957/lei-3154-1957-05-24.md"}}, {id:"federal:BR:L:3148/1957", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1957, data:"1957-05-21", numero:"3148", fonte