-ordinarias/2012/lei-12651-2012-05-25.md"}}, {id:"federal:BR:L:12614/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-04-27", numero:"12614", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-04-27;12614", vigente:true, titulo:"Lei nº 12.614 de 27/04/2012", urn:"urn:lex:br:federal:lei:2012-04-27;12614", ementa:"Dispõe sobre a inscrição do nome do Padre Roberto Landell de Moura no Livro dos Heróis da Pátria.", arquivo:"federal/leis-ordinarias/2012/lei-12614-2012-04-27.md"}}, {id:"federal:BR:L:12742/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-12-17", numero:"12742", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-12-17;12742", vigente:true, titulo:"Lei nº 12.742 de 17/12/2012", urn:"urn:lex:br:federal:lei:2012-12-17;12742", ementa:"Dispõe sobre a criação de cargos em comissão do Grupo-Direção e Assessoramento Superiores - DAS e de Funções Gratificadas, destinados ao Ministério da Integração Nacional, à Superintendência do Desenvolvimento do Centro-Oeste - SUDECO, à Superintendência do Desenvolvimento do Nordeste - SUDENE, à Superintendência do Desenvolvimento da Amazônia - SUDAM e ao Departamento Nacional de Infraestrutura de Transporte - DNIT.", arquivo:"federal/leis-ordinarias/2012/lei-12742-2012-12-17.md"}}, {id:"federal:BR:L:12689/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-07-19", numero:"12689", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-07-19;12689", vigente:true, titulo:"Lei nº 12.689 de 19/07/2012", urn:"urn:lex:br:federal:lei:2012-07-19;12689", ementa:"Altera o Decreto-Lei nº 467, de 13 de fevereiro de 1969, para estabelecer o medicamento genérico de uso veterinário; e dispõe sobre o registro, a aquisição pelo poder público, a prescrição, a fabricação, o regime econômico-fiscal, a distribuição e a dispensação de medicamentos genéricos de uso veterinário, bem como sobre a promoção de programas de desenvolvimento técnico- científico e de incentivo à cooperação técnica para aferição da qualidade e da eficácia de produtos farmacêuticos de uso vete", arquivo:"federal/leis-ordinarias/2012/lei-12689-2012-07-19.md"}}, {id:"federal:BR:L:12590/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-01-09", numero:"12590", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-01-09;12590", vigente:true, titulo:"Lei nº 12.590 de 09/01/2012", urn:"urn:lex:br:federal:lei:2012-01-09;12590", ementa:"Altera a Lei nº 8.313, de 23 de dezembro de 1991 - Lei Rouanet - para reconhecer a música gospel e os eventos a ela relacionados como manifestação cultural.", arquivo:"federal/leis-ordinarias/2012/lei-12590-2012-01-09.md"}}, {id:"federal:BR:L:12661/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-06-05", numero:"12661", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-06-05;12661", vigente:true, titulo:"Lei nº 12.661 de 05/06/2012", urn:"urn:lex:br:federal:lei:2012-06-05;12661", ementa:"Dispõe sobre a criação de Vara do Trabalho na jurisdição do Tribunal Regional do Trabalho da 19ª Região e dá outras providências.", arquivo:"federal/leis-ordinarias/2012/lei-12661-2012-06-05.md"}}, {id:"federal:BR:L:12655/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-05-30", numero:"12655", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-05-30;12655", vigente:true, titulo:"Lei nº 12.655 de 30/05/2012", urn:"urn:lex:br:federal:lei:2012-05-30;12655", ementa:"Altera o art. 4º da Lei nº 10.931, de 2 de agosto de 2004, e o art. 1º da Lei nº 10.925, de 23 de julho de 2004.", arquivo:"federal/leis-ordinarias/2012/lei-12655-2012-05-30.md"}}, {id:"federal:BR:L:12643/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-05-15", numero:"12643", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-05-15;12643", vigente:true, titulo:"Lei nº 12.643 de 15/05/2012", urn:"urn:lex:br:federal:lei:2012-05-15;12643", ementa:"Institui o Dia Nacional da Silvicultura.", arquivo:"federal/leis-ordinarias/2012/lei-12643-2012-05-15.md"}}, {id:"federal:BR:L:12702/2012", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-08-07", numero:"12702", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-08-07;12702", vigente:true, titulo:"Lei nº 12.702 de 07/08/2012", urn:"urn:lex:br:federal:lei:2012-08-07;12702", ementa:"Dispõe sobre servidores do Instituto Nacional de Meteorologia, da Comissão Executiva do Plano da Lavoura Cacaueira, da Agência Brasileira de Inteligência, da Comissão de Valores Mobiliários, do Instituto Evandro Chagas, do Centro Nacional de Primatas, da Fundação Oswaldo Cruz, do Instituto de Pesquisa Econômica Aplicada, do Instituto Nacional do Seguro Social, da Superintendência de Seguros Privados, do Instituto Nacional de Metrologia, Qualidade e Tecnologia, da Superintendência Nacional de Pre", arquivo:"federal/leis-ordinarias/2012/lei-12702-2012-08-07.md"}}, {id:"federal:BR:L:12635/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-05-14", numero:"12635", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-05-14;12635", vigente:true, titulo:"Lei nº 12.635 de 14/05/2012", urn:"urn:lex:br:federal:lei:2012-05-14;12635", ementa:"Institui o Dia Nacional do Suinocultor.", arquivo:"federal/leis-ordinarias/2012/lei-12635-2012-05-14.m