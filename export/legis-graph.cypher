ordinarias/1949/lei-626-1949-02-21.md"}}, {id:"federal:BR:L:721/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-05-31", numero:"721", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-05-31;721", vigente:true, titulo:"Lei nº 721 de 31/05/1949", urn:"urn:lex:br:federal:lei:1949-05-31;721", ementa:"Estende a vários oficiais generais, a um almirante e a um oficial médico   da Polícia Militar do Distrito Federal, os benefícios do Decreto-Lei nº 9.050,   de 11 de março de 1946.", arquivo:"federal/leis-ordinarias/1949/lei-721-1949-05-31.md"}}, {id:"federal:BR:L:799/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-09-01", numero:"799", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-09-01;799", vigente:true, titulo:"Lei nº 799 de 01/09/1949", urn:"urn:lex:br:federal:lei:1949-09-01;799", ementa:"Modifica o art. 295 do Código de Processo Penal.", arquivo:"federal/leis-ordinarias/1949/lei-799-1949-09-01.md"}}, {id:"federal:BR:L:906/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-10-30", numero:"906", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-10-30;906", vigente:true, titulo:"Lei nº 906 de 30/10/1949", urn:"urn:lex:br:federal:lei:1949-10-30;906", ementa:"Autoriza a abertura, ao Poder Judiciário, de Crédito suplementar para   atender a despesas no corrente ano, e de crédito especial para pagamento de   gratificação.", arquivo:"federal/leis-ordinarias/1949/lei-906-1949-10-30.md"}}, {id:"federal:BR:L:788/1949", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1949, data:"1949-08-22", numero:"788", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1949-08-22;788", vigente:true, titulo:"Lei nº 788 