}}, {id:"federal:BR:L:1164/1862", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1862, data:"1862-08-01", numero:"1164", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1862-08-01;1164", vigente:true, titulo:"Lei nº 1.164 de 01/08/1862", urn:"urn:lex:br:federal:lei:1862-08-01;1164", ementa:"FIXA A FORÇA NAVAL PARA O ANO FINANCEIRO DE 1863-1864.", arquivo:"federal/leis-ordinarias/1862/lei-1164-1862-08-01.md"}}, {id:"federal:BR:L:1179/1862", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1862, data:"1862-09-15", numero:"1179", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1862-09-15;1179", vigente:true, titulo:"Lei nº 1.179 de 15/09/1862", urn:"urn:lex:br:federal:lei:1862-09-15;1179", ementa:"ABRE AO MINISTÉRIO DA GUERRA O CRÉDITO SUPLEMENTAR  PARA AS DESPESAS DO EXERCÍCIO DE 1861-1862.", arquivo:"federal/leis-ordinarias/1862/lei-1179-1862-09-15.md"}}, {id:"federal:BR:L:5587/1970", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1970, data:"1970-07-02", numero:"5587", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1970-07-02;5587", vigente:true, titulo:"Lei nº 5.587 de 02/07/1970", urn:"urn:lex:br:federal:lei:1970-07-02;5587", ementa:"Altera a redação do artigo 2º ;do Decreto-lei nº 499, de 17 de março de 1969, que institui nova carteira de indentidade estrangeira e dá outras providências.", arquivo:"federal/leis-ordinarias/1970/lei-5587-1970-07-02.md"}}, {id:"federal:BR:L:5591/1970", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1970, data:"1970-07-16", numero:"5591", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1970-07-16;5591", vigente:true, titulo:"Lei nº 5.591 de 16/07/1970", urn:"urn:lex:br:federal:lei:1970-07-16;5591", ementa:"Dispõe sobre a instituição de regime especial de trabalho para servidores da Fundação Instituto Brasileiro de Geografia e Estatística que participarem diretamente da execução do VIII Recenseamento Geral do Brasil e dá outras providências.", arquivo:"federal/leis-ordinarias/1970/lei-5591-1970-07-16.md"}}, {id:"federal:BR:L:5583/1970", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1970, data:"1970-06-25", numero:"5583", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1970-06-25;5583", vigente:true, titulo:"Lei nº 5.583 de 25/06/1970", urn:"urn:lex:br:federal:lei:1970-06-25;5583", ementa:"Autoriza o Poder Executivo a subscrever ações do aumento de capital de Aços Finos Piratini S.A., altera os arts. 8º e 10 da Lei nº 3.972, de 13 de outubro de 1961, e dá outras providências.", arquivo:"federal/leis-ordinarias/1970/lei-5583-1970-06-25.md"}}, {id:"federal:BR:L:5605/1970", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1970, data:"1970-09-09", numero:"5605", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1970-09-09;5605", vigente:true, titulo:"Lei nº 5.605 de 09/09/1970", urn:"urn:lex:br:federal:lei:1970-09-09;5605", ementa:"Declara de utilidade pública o \"Real Gabinete Português de Leitura\", com   sede na cidade do Rio de Janeiro, Estado da Guanabara.", arquivo:"federal/leis-ordinarias/1970/lei-5605-1970-09-09.md"}}, {id:"federal:BR:L:5647/1970", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1970, data:"1970-12-10", numero:"5647", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1970-12-10;5647", vigente:true, titulo:"Lei nº 5.647 de 10/12/1970", urn:"urn:lex:br:federal:lei:1970-12-10;5647", ementa:"Autoriza o Poder Executivo a instituir a Fundação Universidade Federal de Mato Grosso, e dá outras providências.", arquivo:"federal/leis-ordinarias/1970/lei-5647-1970-12-10.md"}}, {id:"federal:BR:L:5636/1970", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1970, data:"1970-12-03", numero:"5636", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1970-12-03;5636", vigente:true, titulo:"Lei nº 5.636 de 03/12/1970", urn:"urn:lex:br:federal:lei:1970-12-03;5636", ementa:"Altera disposições do Decreto-lei nº 60, de 21 de novembro de 1966, que \"Dispõe sobre a reorganização do Banco Nacional de Crédito Cooperativo, autoriza a subscrição de ações do referido estabelecimento e dá outras providências\".", arquivo:"federal/leis-ordinarias/1970/lei-5636-1970-12-03.md"}}, {id:"federal:BR:L:5617/1970", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1970, data:"1970-10-15", numero:"5617", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1970-10-15;5617", vigente:true, titulo:"Lei nº 5.617 de 15/10/1970", urn:"urn:lex:br:federal:lei:1970-10-15;5617", ementa:"Reorganiza o Conselho Nacional de Política Salarial - CNPS, e dá outras providências.", arquivo:"federal/leis-ordinarias/1970/lei-5617-1970-10-15.md"}}, {id:"federal:BR:L:5596/1970", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1970, data:"1970-07-28", numero:"5596", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1970-07-28;5596", vigente:true, titulo:"Lei nº 5.596 de 28/07/1970", urn:"urn:lex:br:federal:lei:1970-07-28;5596", ementa:"Autoriza a Associação Rural de Arroio do Meio, Estado do Rio Grande do Sul, a transferir, gratuitamente, à Campanha Nacional de Escolas da Comunidade, o imóvel que menciona.", arquivo:"federal/leis-ordinarias/1970/lei-5596-1970-07-28.md"}}, {id:"federal:BR:L:5604/1970", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1970, data:"1970-09-02", numero:"5604", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1970-09-02;5604", vigente:true, titulo:"Lei nº 5.604 de 02/09/1970", urn:"urn:lex:br:federal:lei:1970-09-02;5604", ementa:"Autoriza o Poder Executivo a criar a empresa pública \"Hospital de Clínicas de Porto Alegre\" e dá outras providências.", arquivo:"federal/leis-ordinarias/1970/lei-5604-1970-09-02.md"}}, {id:"federal:BR:L:5615/1970", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1970, data:"1970-10-13", numero:"5615", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1970-10-13;5615", vigente:true, titulo:"Lei nº 5.615 de 13/10/1970", urn:"urn:lex:br:federal:lei:1970-10-13;5615", ementa:"Dispõe sobre o Serviço Federal de Processamento de dados (SERPRO) e dá outras providências.", arquivo:"federal/leis-ordinarias/1970/lei-5615-1970-10-13.md"}}, {id:"federal:BR:L:5643/1970", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1970, data:"1970-12-10", numero:"5643", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1970-12-10;5643", vigente:true, titulo:"Lei nº 5.643 de 10/12/1970", urn:"urn:lex:br:federal:lei:1970-12-10;5643", ementa:"Cria na Justiça do Trabalho das 2º. e 5º. Regiões 16 Juntas de Conciliação e Julgamento e dá outras providências.", arquivo:"federal/leis-ordinarias/1970/lei-5643-1970-12-10.md"}}, {id:"federal:BR:L:5614/1970", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1970, data:"1970-10-05", numero:"5614", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1970-10-05;5614", vigente:true, titulo:"Lei nº 5.614 de 05/10/1970", urn:"urn:lex:br:federal:lei:1970-10-05;5614", ementa:"Dispõe sôbre o Cadastro Geral de Contribuintes (C.G.C).", arquivo:"federal/leis-ordinarias/1970/lei-5614-1970-10-05.md"}}, {id:"f