6-11.md"}}, {id:"federal:BR:L:6842/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-03", numero:"6842", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-11-03;6842", vigente:true, titulo:"Lei nº 6.842 de 03/11/1980", urn:"urn:lex:br:federal:lei:1980-11-03;6842", ementa:"Acrescenta dispositivos à Lei nº 6511, de 19 de dezembro de 1977, que   dispõe sobre Prêmios Literários Nacionais.", arquivo:"federal/leis-ordinarias/1980/lei-6842-1980-11-03.md"}}, {id:"federal:BR:L:6769/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-03-19", numero:"6769", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-03-19;6769", vigente:true, titulo:"Lei nº 6.769 de 19/03/1980", urn:"urn:lex:br:federal:lei:1980-03-19;6769", ementa:"Altera a Lei nº 6.516, de 13 de março de 1978, que \"dispõe sobre o   reajustamento do efetivo de Pessoal Militar da Ativa da Força Aérea Brasileira,   em tempo de paz\".", arquivo:"federal/leis-ordinarias/1980/lei-6769-1980-03-19.md"}}, {id:"federal:BR:L:6878/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-09", numero:"6878", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-12-09;6878", vigente:true, titulo:"Lei nº 6.878 de 09/12/1980", urn:"urn:lex:br:federal:lei:1980-12-09;6878", ementa:"Cria, na Carreira do Ministério Público do Distrito Federal e na do   Ministério Público dos Territórios Fcederais, os cargos que especifica.", arquivo:"federal/leis-ordinarias/1980/lei-6878-1980-12-09.md"}}, {id:"federal:BR:L:6802/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1980, data:"1980-06-30", numero:"6802", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1980-06-30;6802", vige