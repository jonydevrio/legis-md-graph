Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-08-03", numero:"2280", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-08-03;2280", vigente:true, titulo:"Lei nº 2.280 de 03/08/1954", urn:"urn:lex:br:federal:lei:1954-08-03;2280", ementa:"Assegura aos associados dos Institutos e Caixas de Previdência Social,   atacados de tuberculose, o benefício do auxílio-enfermidade.", arquivo:"federal/leis-ordinarias/1954/lei-2280-1954-08-03.md"}}, {id:"federal:BR:L:2192/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-03-06", numero:"2192", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-03-06;2192", vigente:true, titulo:"Lei nº 2.192 de 06/03/1954", urn:"urn:lex:br:federal:lei:1954-03-06;2192", ementa:"Dispõe sobre as contribuições para o Montepio civil.", arquivo:"federal/leis-ordinarias/1954/lei-2192-1954-03-06.md"}}, {id:"federal:BR:L:2301/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-08-27", numero:"2301", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-08-27;2301", vigente:true, titulo:"Lei nº 2.301 de 27/08/1954", urn:"urn:lex:br:federal:lei:1954-08-27;2301", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Saúde, o crédito   especial de Cr$ 700.000,00 para ocorrer às despesas com a representação do   Brasil ao 5º Congresso Internacional de Hematologia.", arquivo:"federal/leis-ordinarias/1954/lei-2301-1954-08-27.md"}}, {id:"federal:BR:L:2177/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-02-04", numero:"2177", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-02-04;2177", vigente:true, titulo:"Lei nº 2.177 de 04/02/1954", urn:"urn:lex:br:federal:lei:1954-02-04;2177", ementa:"Autoriza o Poder Executivo a abrir, pel