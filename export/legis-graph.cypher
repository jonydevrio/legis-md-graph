no:1869, data:"1869-10-09", numero:"1736", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1869-10-09;1736", vigente:true, titulo:"Lei nº 1.736 de 09/10/1869", urn:"urn:lex:br:federal:lei:1869-10-09;1736", ementa:"ABRE AO MINISTERIO DA MARINHA, PARA A DESPEZAS DO 2 SEMESTRE DO EXERCICIO 1869-1870, O CREDITO EXTRAORDINÁRIO DE 6.789:500$000.", arquivo:"federal/leis-ordinarias/1869/lei-1736-1869-10-09.md"}}, {id:"federal:BR:L:1588/1869", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1869, data:"1869-06-30", numero:"1588", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1869-06-30;1588", vigente:true, titulo:"Lei nº 1.588 de 30/06/1869", urn:"urn:lex:br:federal:lei:1869-06-30;1588", ementa:"FIXA AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1869-1870.", arquivo:"federal/leis-ordinarias/1869/lei-1588-1869-06-30.md"}}, {id:"federal:BR:L:1655/1869", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1869, data:"1869-08-04", numero:"1655", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1869-08-04;1655", vigente:true, titulo:"Lei nº 1.655 de 04/08/1869", urn:"urn:lex:br:federal:lei:1869-08-04;1655", ementa:"APROVA DECRETOS QUE TRANSPORTARÃO QUANTIAS DE UMAS PARA OUTRAS VERBAS DA LEI 1507 DE 26 DE SETEMBRO DE 1867 PARA O EXERCÍCIO DE 1867-68, ABRE CREDITOS SUPLEMENTARES E EXTRAORDINÁRIOS E APROVA OPERAÇÕES DE CRÉDITO REALISADAS PELO GOVERNO.", arquivo:"federal/leis-ordinarias/1869/lei-1655-1869-08-04.md"}}, {id:"federal:BR:L:1587/1869", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1869, data:"1869-06-28", numero:"1587", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1869-06-28;1587", vigente:true, titulo:"Lei nº 1.587 de 28/06/1869", urn:"urn:lex:br:federal:lei:1869-06-28;1587", ementa:"MANDA CONTINUAR EM VIGOR, DURANTE O 1 SEMESTRE DO ANO FINANCEIRO DE 1869-70, A LEI 1.507 DE 26 DE SETEMBRO DE 1867, E DA OUTRAS PROVIDENCIAS.", arquivo:"federal/leis-ordinarias/1869/lei-1587-1869-06-28.md"}}, {id:"federal:BR:L:1726/1869", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1869, data:"1869-09-29", numero:"1726", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1869-09-29;1726", vigente:true, titulo:"Lei nº 1.726 de 29/09/1869", urn:"urn:lex:br:federal:lei:1869-09-29;1726", ementa:"CONCEDE AO MINISTERIO DA GUERRA PARA AS DESPEZAS DO 3 TRIMESTRE DO EXERCICIO DE 1869-1870 O CRÉDITO EXTRAORDINARIO DA QUANTIA DE 12.956:302$946.", arquivo:"federal/leis-ordinarias/1869/lei-1726-1869-09-29.md"}}, {id:"federal:BR:L:1590/1869", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1869, data:"1869-06-30", numero:"1590", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1869-06-30;1590", vigente:true, titulo:"Lei nº 1.590 de 30/06/1869", urn:"urn:lex:br:federal:lei:1869-06-30;1590", ementa:"FIXA A FORÇA NAVAL PARA O ANO FINANCEIRO DE 1869-1870.", arquivo:"federal/leis-ordinarias/1869/lei-1590-1869-06-30.md"}}, {id:"federal:BR:L:1735/1869", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1869, data:"1869-10-09", numero:"1735", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1869-10-09;1735", vigente:true, titulo:"Lei nº 1.735 de 09/10/1869", urn:"urn:lex:br:federal:lei:1869-10-09;1735", ementa:"ABRE AO MINISTERIO DA MARINHA, PARA A COMPRA DA ILHA DAS ENXADAS, COM TODOS OS ARMAZENS E BENFEITORIAS, O CREDITO EXTRAORDINARIO DE 1.450:000$000.", arquivo:"federal/leis-ordinarias/1869/lei-1735-1869-10-09.md"}}, {id:"federal:BR:L:1689/1869", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1869, data:"1869-08-28", numero:"1689", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1869-08-28;1689", vigente:true, titulo:"Lei nº 1.689 de 28/08/1869", urn:"urn:lex:br:federal:lei:1869-08-28;1689", ementa:"FIXA A FORÇA NAVAL PARA O ANO FINANCEIRO DE 1870-1871.", arquivo:"federal/leis-ordinarias/1869/lei-1689-1869-08-28.md"}}, {id:"federal:BR:L:6430/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-07-07", numero:"6430", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-07-07;6430", vigente:true, titulo:"Lei nº 6.430 de 07/07/1977", urn:"urn:lex:br:federal:lei:1977-07-07;6430", ementa:"Extingue o SASSE, dispõe sobre a transferência dos economiários para o   regime da Lei número 3.807, de 26 de agosto de 1960, e dá outras providências.", arquivo:"federal/leis-ordinarias/1977/lei-6430-1977-07-07.md"}}, {id:"federal:BR:L:6455/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-10-24", numero:"6455", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-10-24;6455", vigente:true, titulo:"Lei nº 6.455 de 24/10/1977", urn:"urn:lex:br:federal:lei:1977-10-24;6455", ementa:"Autoriza o Poder Executivo a promover, pelo princípio de bravura, o 2º   Sargento do Exército Sílvio Delmar Holembach.", arquivo:"federal/leis-ordinarias/1977/lei-6455-1977-10-24.md"}}, {id:"federal:BR:L:6426/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-06-30", numero:"6426", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-06-30;6426", vigente:true, titulo:"Lei nº 6.426 de 30/06/1977", urn:"urn:lex:br:federal:lei:1977-06-30;6426", ementa:"Altera dispositivos da Lei n. 1512, de 19 de dezembro de 1951, que cria a   Comissão Nacional de Belas Artes, o Salão Nacional de Arte Moderna, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1977/lei-6426-1977-06-30.md"}}, {id:"federal:BR:L:6459/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-11-01", numero:"6459", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-11-01;6459", vigente:true, titulo:"Lei nº 6.459 de 01/11/1977", urn:"urn:lex:br:federal:lei:1977-11-01;6459", ementa:"Autoriza o Poder Executivo a abrir créditos suplementares aos programas   constantes da Lei n° ;6.395, de 09 de dezembro de 1976.", arquivo:"federal/leis-ordinarias/1977/lei-6459-1977-11-01.md"}}, {id:"federal:BR:L:6418/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-05-30", numero:"6418", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-05-30;6418", vigente:true, titulo:"Lei nº 6.418 de 30/05/1977", urn:"urn:lex:br:federal:lei:1977-05-30;6418", ementa:"Dá nova redação aos artigos 2º e 3º do Decreto-lei nº 1.016, de 21 de outubro de 1969, que dispõe sobre o pagamento de serviços industriais ou comerciais, prestados por órgãos vinculados ao Ministério dos Transportes.", arquivo:"federal/leis-ordinarias/1977/lei-6418-1977-05-30.md"}}, {id:"federal:BR:L:6453/1977", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-10-17", numero:"6453", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-10-17;6453", vigente:true, titulo:"Lei nº 6.453 de 17/10/1977", urn:"urn:lex:br:federal:lei:1977-10-17;6453", ementa:"Dispõe sobre a responsabilidade civil por danos nucleares e a responsabilidade criminal por atos relacionados com atividades nucleares e dá outras providências.", arquivo:"federal/leis-ordinarias/1977/lei-6453-1977-10-17.md"}}, {id:"federal:BR:L:6506/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-12-16", numero:"6506", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-12-16;6506", vigente:true, titulo:"Lei nº 6.506 de 16/12/1977", urn:"urn:lex:br:federal:lei:1977-12-16;6506", ementa:"Dá nova denominação ao Instituto de Medicina Legal do Distrito   Federal.", arquivo:"federal/leis-ordinarias/1977/lei-6506-1977-12-16.md"}}, {id:"federal:BR:L:6427/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-07-01", numero:"6427", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-07-01;6427", vigente:true, titulo:"Lei nº 6.427 de 01/07/1977", urn:"urn:lex:br:federal:lei:1977-07-01;6427", ementa:"Concede pensão especial a Esther Madeira da Silva, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1977/lei-6427-1977-07-01.md"}}, {id:"federal:BR:L:6512/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-12-19", numero:"6512", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-12-19;6512", vigente:true, titulo:"Lei nº 6.512 de 19/12/1977", urn:"urn:lex:br:federal:lei:1977-12-19;6512", ementa:"Dispõe sobre a obrigatoriedade do voto nas eleições sindicais e dá outras   providências.", arquivo:"federal/leis-ordinarias/1977/lei-6512-1977-12-19.md"}}, {id:"federal:BR:L:6476/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-12-01", numero:"6476", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-12-01;6476", vigente:true, titulo:"Lei nº 6.476 de 01/12/1977", urn:"urn:lex:br:federal:lei:1977-12-01;6476", ementa:"Dispõe sobre a transferência de estabelecimento federal de ensino agrícola   para o Governo do Estado da Paraíba, e dá outras providências.", arquivo:"federal/leis-ordinarias/1977/lei-6476-1977-12-01.md"}}, {id:"federal:BR:L:6415/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-05-24", numero:"6415", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-05-24;6415", vigente:true, titulo:"Lei nº 6.415 de 24/05/1977", urn:"urn:lex:br:federal:lei:1977-05-24;6415", ementa:"Amplia os atuais mandatos partidários", arquivo:"federal/leis-ordinarias/1977/lei-6415-1977-05-24.md"}}, {id:"federal:BR:L:6488/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-12-06", numero:"6488", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-12-06;6488", vigente:true, titulo:"Lei nº 6.488 de 06/12/1977", urn:"urn:lex:br:federal:lei:1977-12-06;6488", ementa:"Estima a Receita e fixa a Despesa do Distrito Federal para o exercício   financeiro de 1978.", arquivo:"federal/leis-ordinarias/1977/lei-6488-1977-12-06.md"}}, {id:"federal:BR:L:6496/1977", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-12-07", numero:"6496", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-12-07;6496", vigente:true, titulo:"Lei nº 6.496 de 07/12/1977", urn:"urn:lex:br:federal:lei:1977-12-07;6496", ementa:"Institui a \"Anotação de Responsabilidade Técnica\" na prestação de serviços de engenharia, de arquitetura e agronomia; autoriza a criação, pelo Conselho Federal de Engenharia, Arquitetura e Agronomia - CONFEA, de uma Mútua de Assistência Profissional; e dá outras providências.", arquivo:"federal/leis-ordinarias/1977/lei-6496-1977-12-07.md"}}, {id:"federal:BR:L:6464/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-11-09", numero:"6464", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-11-09;6464", vigente:true, titulo:"Lei nº 6.464 de 09/11/1977", urn:"urn:lex:br:federal:lei:1977-11-09;6464", ementa:"Declara Machado de Assis Patrono das Letras do Brasil.", arquivo:"federal/leis-ordinarias/1977/lei-6464-1977-11-09.md"}}, {id:"federal:BR:L:6492/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-12-07", numero:"6492", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-12-07;6492", vigente:true, titulo:"Lei nº 6.492 de 07/12/1977", urn:"urn:lex:br:federal:lei:1977-12-07;6492", ementa:"Autoriza a Petrobrás Química S.A. - PETROQUISA a, nas condições que   estabelece, participar do capital de outras sociedades.", arquivo:"federal/leis-ordinarias/1977/lei-6492-1977-12-07.md"}}, {id:"federal:BR:L:6468/1977", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-11-14", numero:"6468", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-11-14;6468", vigente:true, titulo:"Lei nº 6.468 de 14/11/1977", urn:"urn:lex:br:federal:lei:1977-11-14;6468", ementa:"Dispõe sobre o regime de tributação simplificada para as pessoas jurídicas de pequeno porte, estabelece isenção do imposto de renda em favor daquelas que auferem reduzida receita bruta e dá outras providências.", arquivo:"federal/leis-ordinarias/1977/lei-6468-1977-11-14.md"}}, {id:"federal:BR:L:6471/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-11-29", numero:"6471", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-11-29;6471", vigente:true, titulo:"Lei nº 6.471 de 29/11/1977", urn:"urn:lex:br:federal:lei:1977-11-29;6471", ementa:"Autoriza o Poder Executivo a abrir a Encargos Gerais da União - Recursos   sob Supervisão da Secretaria de Planejamento da Presidência da República - o   crédito especial até o limite de Cr$ 2.500.000.000,00, para fins que   especifica.", arquivo:"federal/leis-ordinarias/1977/lei-6471-1977-11-29.md"}}, {id:"federal:BR:L:6407/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-03-21", numero:"6407", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-03-21;6407", vigente:true, titulo:"Lei nº 6.407 de 21/03/1977", urn:"urn:lex:br:federal:lei:1977-03-21;6407", ementa:"Dispõe sobre a doação do Hospital Hermínio Amorim e dá outras   providências.", arquivo:"federal/leis-ordinarias/1977/lei-6407-1977-03-21.md"}}, {id:"federal:BR:L:6514/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-12-22", numero:"6514", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-12-22;6514", vigente:true, titulo:"Lei nº 6.514 de 22/12/1977", urn:"urn:lex:br:federal:lei:1977-12-22;6514", ementa:"Altera o Capítulo V do Título II da Consolidação das Leis do Trabalho, relativo à segurança e medicina do trabalho, e dá outras providências.", arquivo:"federal/leis-ordinarias/1977/lei-6514-1977-12-22.md"}}, {id:"federal:BR:L:6483/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-12-05", numero:"6483", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-12-05;6483", vigente:true, titulo:"Lei nº 6.483 de 05/12/1977", urn:"urn:lex:br:federal:lei:1977-12-05;6483", ementa:"Autoriza o Poder Executivo a abrir ao Ministério dos Transportes -   Entidades Supervisionadas - crédito especial até o limite de Cr$ 292.060.000,00   para o fim que especifica.", arquivo:"federal/leis-ordinarias/1977/lei-6483-1977-12-05.md"}}, {id:"federal:BR:L:6433/1977", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-07-15", numero:"6433", fonte:"https://normas.leg.br/?urn=urn:lex:br:federa