ties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-08-10", numero:"9812", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-08-10;9812", vigente:true, titulo:"Lei nº 9.812 de 10/08/1999", urn:"urn:lex:br:federal:lei:1999-08-10;9812", ementa:"Acrescenta parágrafos ao art. 30 da Lei nº 6.015, de 31 de dezembro de 1973, com a redação dada pela Lei nº 9.534, de 10 de dezembro de 1997, e inciso VI ao art. 39 da Lei nº 8.935, de 18 de novembro de 1994.", arquivo:"federal/leis-ordinarias/1999/lei-9812-1999-08-10.md"}}, {id:"federal:BR:L:9911/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-15", numero:"9911", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-12-15;9911", vigente:true, titulo:"Lei nº 9.911 de 15/12/1999", urn:"urn:lex:br:federal:lei:1999-12-15;9911", ementa:"Altera o nome do Aeroporto Campo dos Palmares no Estado de Alagoas.", arquivo:"federal/leis-ordinarias/1999/lei-9911-1999-12-15.md"}}, {id:"federal:BR:L:9845/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-10-20", numero:"9845", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-10-20;9845", vigente:true, titulo:"Lei nº 9.845 de 20/10/1999", urn:"urn:lex:br:federal:lei:1999-10-20;9845", ementa:"Altera dispositivos da Lei n. 8432, de 11 de junho de 1992, determina a transferência de Sede de Junta de Conciliação e Julgamento, define jurisdição e dá outras providências.", arquivo:"federal/leis-ordinarias/1999/lei-9845-1999-10-20.md"}}, {id:"federal:BR:L:9903/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-14", numero:"9903", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-12-14;9903", vigente:true, titulo:"Lei nº 9.903 de 14/12/1999", urn:"urn:lex:br:federal:lei:1999-12-14;9903", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério dos Transportes, crédito suplementar no valor de R$ 4.290.301,00, para reforço de dotações para pessoal e encargos sociais.", arquivo:"federal/leis-ordinarias/1999/lei-9903-1999-12-14.md"}}, {id:"federal:BR:L:9941/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-21", numero:"9941", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-12-21;9941", vigente:true, titulo:"Lei nº 9.941 de 21/12/1999", urn:"urn:lex:br:federal:lei:1999-12-21;9941", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor do Ministério da Educação, crédito especial no valor de R$ 5.949.717,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1999/lei-9941-1999-12-21.md"}}, {id:"federal:BR:L:9803/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-06-30", numero:"9803", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-06-30;9803", vigente:true, titulo:"Lei nº 9.803 de 30/06/1999", urn:"urn:lex:br:federal:lei:1999-06-30;9803", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento da Seguridade Social da   União, em favor do Ministério do Planejamento e Orçamento, crédito   extraordinário no valor de R$ 7.556.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1999/lei-9803-1999-06-30.md"}}, {id:"federal:BR:L:9801/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-06-14", numero:"9801", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-06-14;9801", vigente:true, titulo:"Lei nº 9.801 de 14/06/1999", urn:"urn:lex:br:federal:lei:1999-06-14;9801", ementa:"Dispõe sobre as normas gerais para perda de cargo público