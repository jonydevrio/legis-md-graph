UNWIND [{id:"federal:BR:EC:135/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2024, data:"2024-12-20", numero:"135", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2024-12-20;135", vigente:true, titulo:"Emenda Constitucional nº 135 de 20/12/2024", urn:"urn:lex:br:federal:emenda.constitucional:2024-12-20;135", ementa:"Altera os arts. 37, 163, 165, 212-A e 239 da Constituição Federal e o Ato das Disposições Constitucionais Transitórias (ADC T).", arquivo:"federal/emendas-constitucionais/2024/emc-135-2024-12-20.md"}}, {id:"federal:BR:EC:133/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2024, data:"2024-08-22", numero:"133", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2024-08-22;133", vigente:true, titulo:"Emenda Constitucional nº 133 de 22/08/2024", urn:"urn:lex:br:federal:emenda.constitucional:2024-08-22;133", ementa:"Impõe aos partidos políticos a obrigatoriedade da aplicação de recursos financeiros para candidaturas de pessoas pretas e pardas; estabelece parâmetros e condições para regularização e refinanciamento de débitos de partidos políticos; e reforça a imunidade tributária dos partidos políticos conforme prevista na Constituição Federal.", arquivo:"federal/emendas-constitucionais/2024/emc-133-2024-08-22.md"}}, {id:"federal:BR:EC:134/2024", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2024, data:"2024-09-24", numero:"134", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2024-09-24;134", vigente:true, titulo:"Emenda Constitucional nº 134 de 24/09/2024", urn:"urn:lex:br:federal:emenda.constitucional:2024-09-24;134", ementa:"Altera o art. 96 da Constituição Federal, para dispor sobre a eleição dos órgãos diretivos de Tribunais de Justiça.", arquivo:"federal/emendas-constitucionais/2024/emc-134-2024-09-24.md"}}, {id:"federal:BR:EC:50/2006", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2006, data:"2006-02-14", numero:"50", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2006-02-14;50", vigente:true, titulo:"Emenda Constitucional nº 50 de 14/02/2006", urn:"urn:lex:br:federal:emenda.constitucional:2006-02-14;50", ementa:"Modifica o art. 57 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/2006/emc-50-2006-02-14.md"}}, {id:"federal:BR:EC:52/2006", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2006, data:"2006-03-08", numero:"52", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2006-03-08;52", vigente:true, titulo:"Emenda Constitucional nº 52 de 08/03/2006", urn:"urn:lex:br:federal:emenda.constitucional:2006-03-08;52", ementa:"Dá nova redação ao § 1º do art. 17 da Constituição Federal para disciplinar as coligações eleitorais.", arquivo:"federal/emendas-constitucionais/2006/emc-52-2006-03-08.md"}}, {id:"federal:BR:EC:53/2006", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2006, data:"2006-12-19", numero:"53", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2006-12-19;53", vigente:true, titulo:"Emenda Constitucional nº 53 de 19/12/2006", urn:"urn:lex:br:federal:emenda.constitucional:2006-12-19;53", ementa:"Dá nova redação aos arts. 7º, 23, 30, 206, 208, 211 e 212 da Constituição Federal e ao art. 60 do Ato das Disposições Constitucionais Transitórias.", arquivo:"federal/emendas-constitucionais/2006/emc-53-2006-12-19.md"}}, {id:"federal:BR:EC:51/2006", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2006, data:"2006-02-14", numero:"51", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2006-02-14;51", vigente:true, titulo:"Emenda Constitucional nº 51 de 14/02/2006", urn:"urn:lex:br:federal:emenda.constitucional:2006-02-14;51", ementa:"Acrescenta os §§ 4º, 5º e 6º ao art. 198 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/2006/emc-51-2006-02-14.md"}}, {id:"federal:BR:EC:49/2006", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2006, data:"2006-02-08", numero:"49", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2006-02-08;49", vigente:true, titulo:"Emenda Constitucional nº 49 de 08/02/2006", urn:"urn:lex:br:federal:emenda.constitucional:2006-02-08;49", ementa:"Altera a redação da alínea b e acrescenta alínea c ao inciso XXIII do caput do art. 21 e altera a redação do inciso V do caput do art. 177 da Constituição Federal para excluir do monopólio da União a produção, a comercialização e a utilização de radioisótopos de meia-vida curta, para usos médicos, agrícolas e industriais.", arquivo:"federal/emendas-constitucionais/2006/emc-49-2006-02-08.md"}}, {id:"federal:BR:EC:10/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1977, data:"1977-11-14", numero:"10", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1977-11-14;10", vigente:true, titulo:"Emenda Constitucional nº 10 de 14/11/1977", urn:"urn:lex:br:federal:emenda.constitucional:1977-11-14;10", ementa:"Acrescenta parágrafo ao artigo 104 da Constiuição Federal.", arquivo:"federal/emendas-constitucionais/1977/emc-10-1977-11-14.md"}}, {id:"federal:BR:EC:8/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1977, data:"1977-04-14", numero:"8", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1977-04-14;8", vigente:true, titulo:"Emenda Constitucional nº 8 de 14/04/1977", urn:"urn:lex:br:federal:emenda.constitucional:1977-04-14;8", ementa:"Altera artigos da Constituição Federal, incluindo-se em seu Título V os artigos 208, 209 e 210.", arquivo:"federal/emendas-constitucionais/1977/emc-8-1977-04-14.md"}}, {id:"federal:BR:EC:9/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1977, data:"1977-06-28", numero:"9", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1977-06-28;9", vigente:true, titulo:"Emenda Constitucional nº 9 de 28/06/1977", urn:"urn:lex:br:federal:emenda.constitucional:1977-06-28;9", ementa:"Dá nova redação ao ;§ 1º do artigo 175 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/1977/emc-9-1977-06-28.md"}}, {id:"federal:BR:EC:7/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1977, data:"1977-04-13", numero:"7", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1977-04-13;7", vigente:true, titulo:"Emenda Constitucional nº 7 de 13/04/1977", urn:"urn:lex:br:federal:emenda.constitucional:1977-04-13;7", ementa:"Incorpora ao texto da Constituição Federal disposições relativas ao Poder Judiciário.", arquivo:"federal/emendas-constitucionais/1977/emc-7-1977-04-13.md"}}, {id:"federal:BR:EC:89/2015", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2015, data:"2015-09-15", numero:"89", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2015-09-15;89", vigente:true, titulo:"Emenda Constitucional nº 89 de 15/09/2015", urn:"urn:lex:br:federal:emenda.constitucional:2015-09-15;89", ementa:"Dá nova redação ao art. 42 do Ato das Disposições Constitucionais Transitórias, ampliando o prazo em que a União deverá destinar às Regiões Centro-Oeste e Nordeste percentuais mínimos dos recursos destinados à irrigação.", arquivo:"federal/emendas-constitucionais/2015/emc-89-2015-09-15.md"}}, {id:"federal:BR:EC:90/2015", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2015, data:"2015-09-15", numero:"90", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2015-09-15;90", vigente:true, titulo:"Emenda Constitucional nº 90 de 15/09/2015", urn:"urn:lex:br:federal:emenda.constitucional:2015-09-15;90", ementa:"Dá nova redação ao art. 6º da Constituição Federal, para introduzir o transporte como direito social.", arquivo:"federal/emendas-constitucionais/2015/emc-90-2015-09-15.md"}}, {id:"federal:BR:EC:88/2015", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2015, data:"2015-05-07", numero:"88", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2015-05-07;88", vigente:true, titulo:"Emenda Constitucional nº 88 de 07/05/2015", urn:"urn:lex:br:federal:emenda.constitucional:2015-05-07;88", ementa:"Altera o art. 40 da Constituição Federal, relativamente ao limite de idade para a aposentadoria compulsória do servidor público em geral, e acrescenta dispositivo ao Ato das Disposições Constitucionais Transitórias.", arquivo:"federal/emendas-constitucionais/2015/emc-88-2015-05-07.md"}}, {id:"federal:BR:EC:87/2015", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2015, data:"2015-04-16", numero:"87", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2015-04-16;87", vigente:true, titulo:"Emenda Constitucional nº 87 de 16/04/2015", urn:"urn:lex:br:federal:emenda.constitucional:2015-04-16;87", ementa:"Altera o § 2º do art. 155 da Constituição Federal e inclui o art. 99 no Ato das Disposições Constitucionais Transitórias, para tratar da sistemática de cobrança do imposto sobre operações relativas à circulação de mercadorias e sobre prestações de serviços de transporte interestadual e intermunicipal e de comunicação incidente sobre as operações e prestações que destinem bens e serviços a consumidor final, contribuinte ou não do imposto, localizado em outro Estado.", arquivo:"federal/emendas-constitucionais/2015/emc-87-2015-04-16.md"}}, {id:"federal:BR:EC:86/2015", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2015, data:"2015-03-17", numero:"86", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2015-03-17;86", vigente:true, titulo:"Emenda Constitucional nº 86 de 17/03/2015", urn:"urn:lex:br:federal:emenda.constitucional:2015-03-17;86", ementa:"Altera os arts. 165, 166 e 198 da Constituição Federal, para tornar obrigatória a execução da programação orçamentária que especifica.", arquivo:"federal/emendas-constitucionais/2015/emc-86-2015-03-17.md"}}, {id:"federal:BR:EC:85/2015", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2015, data:"2015-02-26", numero:"85", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2015-02-26;85", vigente:true, titulo:"Emenda Constitucional nº 85 de 26/02/2015", urn:"urn:lex:br:federal:emenda.constitucional:2015-02-26;85", ementa:"Altera e adiciona dispositivos na Constituição Federal para atualizar o tratamento das atividades de ciência, tecnologia e inovação.", arquivo:"federal/emendas-constitucionais/2015/emc-85-2015-02-26.md"}}, {id:"federal:BR:EC:6/1995", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1995, data:"1995-08-15", numero:"6", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1995-08-15;6", vigente:true, titulo:"Emenda Constitucional nº 6 de 15/08/1995", urn:"urn:lex:br:federal:emenda.constitucional:1995-08-15;6", ementa:"Altera o inciso IX do art. 170, o art. 171 e o § 1º do art. 176 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/1995/emc-6-1995-08-15.md"}}, {id:"federal:BR:EC:9/1995", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1995, data:"1995-11-09", numero:"9", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1995-11-09;9", vigente:true, titulo:"Emenda Constitucional nº 9 de 09/11/1995", urn:"urn:lex:br:federal:emenda.constitucional:1995-11-09;9", ementa:"Dá nova redação ao art. 177, da Constituição Federal, alterando e inserindo parágrafos.", arquivo:"federal/emendas-constitucionais/1995/emc-9-1995-11-09.md"}}, {id:"federal:BR:EC:8/1995", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1995, data:"1995-08-15", numero:"8", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1995-08-15;8", vigente:true, titulo:"Emenda Constitucional nº 8 de 15/08/1995", urn:"urn:lex:br:federal:emenda.constitucional:1995-08-15;8", ementa:"Altera o inciso XI e a alínea \"a\" do inciso XII do art. 21 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/1995/emc-8-1995-08-15.md"}}, {id:"federal:BR:EC:7/1995", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1995, data:"1995-08-15", numero:"7", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1995-08-15;7", vigente:true, titulo:"Emenda Constitucional nº 7 de 15/08/1995", urn:"urn:lex:br:federal:emenda.constitucional:1995-08-15;7", ementa:"Altera o art. 178 da Constituição Federal e dispõe sobre a adoção de Medidas Provisórias.", arquivo:"federal/emendas-constitucionais/1995/emc-7-1995-08-15.md"}}, {id:"federal:BR:EC:5/1995", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1995, data:"1995-08-15", numero:"5", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1995-08-15;5", vigente:true, titulo:"Emenda Constitucional nº 5 de 15/08/1995", urn:"urn:lex:br:federal:emenda.constitucional:1995-08-15;5", ementa:"Altera o § 2º do art. 25 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/1995/emc-5-1995-08-15.md"}}, {id:"federal:BR:EC:108/2020", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2020, data:"2020-08-26", numero:"108", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2020-08-26;108", vigente:true, titulo:"Emenda Constitucional nº 108 de 26/08/2020", urn:"urn:lex:br:federal:emenda.constitucional:2020-08-26;108", ementa:"Altera a Constituição Federal para estabelecer critérios de distribuição da cota municipal do Imposto sobre Operações Relativas à Circulação de Mercadorias e sobre Prestações de Serviços de Transporte Interestadual e Intermunicipal e de Comunicação (ICMS), para disciplinar a disponibilização de dados contábeis pelos entes federados, para tratar do planejamento na ordem social e para dispor sobre o Fundo de Manutenção e Desenvolvimento da Educação Básica e de Valorização dos Profissionais da Educ", arquivo:"federal/emendas-constitucionais/2020/emc-108-2020-08-26.md"}}, {id:"federal:BR:EC:107/2020", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2020, data:"2020-07-02", numero:"107", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2020-07-02;107", vigente:true, titulo:"Emenda Constitucional nº 107 de 02/07/2020", urn:"urn:lex:br:federal:emenda.constitucional:2020-07-02;107", ementa:"Adia, em razão da pandemia da Covid-19, as eleições municipais de outubro de 2020 e os prazos eleitorais respectivos", arquivo:"federal/emendas-constitucionais/2020/emc-107-2020-07-02.md"}}, {id:"federal:BR:EC:106/2020", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2020, data:"2020-05-07", numero:"106", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2020-05-07;106", vigente:true, titulo:"Emenda Constitucional nº 106 de 07/05/2020", urn:"urn:lex:br:federal:emenda.constitucional:2020-05-07;106", ementa:"Institui regime extraordinário fiscal, financeiro e de contratações para enfrentamento de calamidade pública nacional decorrente de pandemia.", arquivo:"federal/emendas-constitucionais/2020/emc-106-2020-05-07.md"}}, {id:"federal:BR:EC:38/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2002, data:"2002-06-12", numero:"38", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2002-06-12;38", vigente:true, titulo:"Emenda Constitucional nº 38 de 12/06/2002", urn:"urn:lex:br:federal:emenda.constitucional:2002-06-12;38", ementa:"Acrescenta o art. 89 ao Ato das Disposições Constitucionais Transitórias, incorporando os Policiais Militares do extinto Território Federal de Rondônia aos Quadros da União.", arquivo:"federal/emendas-constitucionais/2002/emc-38-2002-06-12.md"}}, {id:"federal:BR:EC:36/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2002, data:"2002-05-28", numero:"36", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2002-05-28;36", vigente:true, titulo:"Emenda Constitucional nº 36 de 28/05/2002", urn:"urn:lex:br:federal:emenda.constitucional:2002-05-28;36", ementa:"Dá nova redação ao art. 222 da Constituição Federal, para permitir a participação de pessoas jurídicas no capital social de empresas jornalísticas e de radiodifusão sonora e de sons e imagens, nas condições que especifica.", arquivo:"federal/emendas-constitucionais/2002/emc-36-2002-05-28.md"}}, {id:"federal:BR:EC:39/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2002, data:"2002-12-19", numero:"39", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2002-12-19;39", vigente:true, titulo:"Emenda Constitucional nº 39 de 19/12/2002", urn:"urn:lex:br:federal:emenda.constitucional:2002-12-19;39", ementa:"Acrescenta o art. 149-A à Constituição Federal (instituindo contribuição para custeio do serviço de iluminação pública nos Municípios e no Distrito Federal).", arquivo:"federal/emendas-constitucionais/2002/emc-39-2002-12-19.md"}}, {id:"federal:BR:EC:37/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2002, data:"2002-06-12", numero:"37", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2002-06-12;37", vigente:true, titulo:"Emenda Constitucional nº 37 de 12/06/2002", urn:"urn:lex:br:federal:emenda.constitucional:2002-06-12;37", ementa:"Altera os arts. 100 e 156 da Constituição Federal e acrescenta os arts. 84, 85, 86, 87 e 88 ao Ato das Disposições Constitucionais Transitórias.", arquivo:"federal/emendas-constitucionais/2002/emc-37-2002-06-12.md"}}, {id:"federal:BR:EC:22/1982", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1982, data:"1982-06-29", numero:"22", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1982-06-29;22", vigente:true, titulo:"Emenda Constitucional nº 22 de 29/06/1982", urn:"urn:lex:br:federal:emenda.constitucional:1982-06-29;22", ementa:"Altera e acrescenta dispositivos à Constituição Federal.", arquivo:"federal/emendas-constitucionais/1982/emc-22-1982-06-29.md"}}, {id:"federal:BR:EC:68/2011", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2011, data:"2011-12-21", numero:"68", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2011-12-21;68", vigente:true, titulo:"Emenda Constitucional nº 68 de 21/12/2011", urn:"urn:lex:br:federal:emenda.constitucional:2011-12-21;68", ementa:"Altera o art. 76 do Ato das Disposições Constitucionais Transitórias.", arquivo:"federal/emendas-constitucionais/2011/emc-68-2011-12-21.md"}}, {id:"federal:BR:EC:105/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-12", numero:"105", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2019-12-12;105", vigente:true, titulo:"Emenda Constitucional nº 105 de 12/12/2019", urn:"urn:lex:br:federal:emenda.constitucional:2019-12-12;105", ementa:"Acrescenta o art. 166-A à Constituição Federal, para autorizar a transferência de recursos federais a Estados, ao Distrito Federal e a Municípios mediante emendas ao projeto de lei orçamentária anual.", arquivo:"federal/emendas-constitucionais/2019/emc-105-2019-12-12.md"}}, {id:"federal:BR:EC:104/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-04", numero:"104", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2019-12-04;104", vigente:true, titulo:"Emenda Constitucional nº 104 de 04/12/2019", urn:"urn:lex:br:federal:emenda.constitucional:2019-12-04;104", ementa:"Altera o inciso XIV do caput do art. 21, o § 4º do art. 32 e o art. 144 da Constituição Federal, para criar as polícias penais federal, estaduais e distrital.", arquivo:"federal/emendas-constitucionais/2019/emc-104-2019-12-04.md"}}, {id:"federal:BR:EC:101/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2019, data:"2019-07-03", numero:"101", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2019-07-03;101", vigente:true, titulo:"Emenda Constitucional nº 101 de 03/07/2019", urn:"urn:lex:br:federal:emenda.constitucional:2019-07-03;101", ementa:"Acrescenta § 3º ao art. 42 da Constituição Federal para estender aos militares dos Estados, do Distrito Federal e dos Territórios o direito à acumulação de cargos públicos prevista no art. 37, inciso XVI.", arquivo:"federal/emendas-constitucionais/2019/emc-101-2019-07-03.md"}}, {id:"federal:BR:EC:102/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2019, data:"2019-09-26", numero:"102", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2019-09-26;102", vigente:true, titulo:"Emenda Constitucional nº 102 de 26/09/2019", urn:"urn:lex:br:federal:emenda.constitucional:2019-09-26;102", ementa:"Dá nova redação ao art. 20 da Constituição Federal e altera o art. 165 da Constituição Federal e o art. 107 do Ato das Disposições Constitucionais Transitórias.", arquivo:"federal/emendas-constitucionais/2019/emc-102-2019-09-26.md"}}, {id:"federal:BR:EC:103/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2019, data:"2019-11-12", numero:"103", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2019-11-12;103", vigente:true, titulo:"Emenda Constitucional nº 103 de 12/11/2019", urn:"urn:lex:br:federal:emenda.constitucional:2019-11-12;103", ementa:"Altera o sistema de previdência social e estabelece regras de transição e disposições transitórias.", arquivo:"federal/emendas-constitucionais/2019/emc-103-2019-11-12.md"}}, {id:"federal:BR:EC:100/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2019, data:"2019-06-26", numero:"100", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2019-06-26;100", vigente:true, titulo:"Emenda Constitucional nº 100 de 26/06/2019", urn:"urn:lex:br:federal:emenda.constitucional:2019-06-26;100", ementa:"Altera os arts. 165 e 166 da Constituição Federal para tornar obrigatória a execução da programação orçamentária proveniente de emendas de bancada de parlamentares de Estado ou do Distrito Federal.", arquivo:"federal/emendas-constitucionais/2019/emc-100-2019-06-26.md"}}, {id:"federal:BR:EC:22/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1999, data:"1999-03-18", numero:"22", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1999-03-18;22", vigente:true, titulo:"Emenda Constitucional nº 22 de 18/03/1999", urn:"urn:lex:br:federal:emenda.constitucional:1999-03-18;22", ementa:"Acrescenta parágrafo único ao art. 98 e altera as alíneas \"i\" do inciso I do art. 102, e \"c\" do inciso I do art. 105 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/1999/emc-22-1999-03-18.md"}}, {id:"federal:BR:EC:23/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1999, data:"1999-09-02", numero:"23", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1999-09-02;23", vigente:true, titulo:"Emenda Constitucional nº 23 de 02/09/1999", urn:"urn:lex:br:federal:emenda.constitucional:1999-09-02;23", ementa:"Altera os arts. 12, 52, 84, 91, 102, e 105 da Constituição Federal (criação do Ministério da Defesa).", arquivo:"federal/emendas-constitucionais/1999/emc-23-1999-09-02.md"}}, {id:"federal:BR:EC:24/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-09", numero:"24", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1999-12-09;24", vigente:true, titulo:"Emenda Constitucional nº 24 de 09/12/1999", urn:"urn:lex:br:federal:emenda.constitucional:1999-12-09;24", ementa:"Altera dispositivos da Constituição Federal pertinentes à representação classista na Justiça do Trabalho.", arquivo:"federal/emendas-constitucionais/1999/emc-24-1999-12-09.md"}}, {id:"federal:BR:EC:21/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1999, data:"1999-03-18", numero:"21", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1999-03-18;21", vigente:true, titulo:"Emenda Constitucional nº 21 de 18/03/1999", urn:"urn:lex:br:federal:emenda.constitucional:1999-03-18;21", ementa:"Prorroga, alterando a alíquota, a contribuição provisória sobre movimentação ou transmissão de valores e de créditos e de direitos de natureza financeira, a que se refere o art. 74 do Ato das Disposições Constitucionais Transitórias.", arquivo:"federal/emendas-constitucionais/1999/emc-21-1999-03-18.md"}}, {id:"federal:BR:EC:28/2000", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"sem_informacao", ano:2000, data:"2000-05-25", numero:"28", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2000-05-25;28", vigente:true, titulo:"Emenda Constitucional nº 28 de 25/05/2000", urn:"urn:lex:br:federal:emenda.constitucional:2000-05-25;28", ementa:"Dá nova redação ao inciso XXIX do art. 7º e revoga o art. 233 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/2000/emc-28-2000-05-25.md"}}, {id:"federal:BR:EC:25/2000", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2000, data:"2000-02-14", numero:"25", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2000-02-14;25", vigente:true, titulo:"Emenda Constitucional nº 25 de 14/02/2000", urn:"urn:lex:br:federal:emenda.constitucional:2000-02-14;25", ementa:"Altera o inciso VI do art. 29 e acrescenta o art. 29-A à Constituição Federal, que dispõem sobre limites de despesas com o Poder Legislativo Municipal.", arquivo:"federal/emendas-constitucionais/2000/emc-25-2000-02-14.md"}}, {id:"federal:BR:EC:29/2000", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2000, data:"2000-09-13", numero:"29", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2000-09-13;29", vigente:true, titulo:"Emenda Constitucional nº 29 de 13/09/2000", urn:"urn:lex:br:federal:emenda.constitucional:2000-09-13;29", ementa:"Altera os arts. 34, 35, 156, 160, 167 e 198 da Constituição Federal e acrescenta artigo ao Ato das Disposições Constitucionais Transitórias, para assegurar os recursos mínimos para o financiamento das ações e serviços públicos de saúde.", arquivo:"federal/emendas-constitucionais/2000/emc-29-2000-09-13.md"}}, {id:"federal:BR:EC:30/2000", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2000, data:"2000-09-13", numero:"30", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2000-09-13;30", vigente:true, titulo:"Emenda Constitucional nº 30 de 13/09/2000", urn:"urn:lex:br:federal:emenda.constitucional:2000-09-13;30", ementa:"Altera a redação do art. 100 da Constituição Federal e acrescenta o art. 78 no Ato das Disposições Constitucionais Transitórias, referente ao pagamento de precatórios judiciários.", arquivo:"federal/emendas-constitucionais/2000/emc-30-2000-09-13.md"}}, {id:"federal:BR:EC:31/2000", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2000, data:"2000-12-14", numero:"31", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2000-12-14;31", vigente:true, titulo:"Emenda Constitucional nº 31 de 14/12/2000", urn:"urn:lex:br:federal:emenda.constitucional:2000-12-14;31", ementa:"Altera o Ato das Disposições Transitórias, introduzindo artigos que criam o Fundo de Combate e Erradicação da Pobreza.", arquivo:"federal/emendas-constitucionais/2000/emc-31-2000-12-14.md"}}, {id:"federal:BR:EC:26/2000", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2000, data:"2000-02-14", numero:"26", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2000-02-14;26", vigente:true, titulo:"Emenda Constitucional nº 26 de 14/02/2000", urn:"urn:lex:br:federal:emenda.constitucional:2000-02-14;26", ementa:"Altera a redação do art. 6º da Constituição Federal.", arquivo:"federal/emendas-constitucionais/2000/emc-26-2000-02-14.md"}}, {id:"federal:BR:EC:27/2000", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2000, data:"2000-03-21", numero:"27", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2000-03-21;27", vigente:true, titulo:"Emenda Constitucional nº 27 de 21/03/2000", urn:"urn:lex:br:federal:emenda.constitucional:2000-03-21;27", ementa:"Acrescenta o art. 76 ao Ato das Disposições Constitucionais Transitórias, instituindo a desvinculação de arrecadação de impostos e contribuições sociais da União.", arquivo:"federal/emendas-constitucionais/2000/emc-27-2000-03-21.md"}}, {id:"federal:BR:EC:16/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-27", numero:"16", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1980-11-27;16", vigente:true, titulo:"Emenda Constitucional nº 16 de 27/11/1980", urn:"urn:lex:br:federal:emenda.constitucional:1980-11-27;16", ementa:"Altera dispositivos da Constituição Federal.", arquivo:"federal/emendas-constitucionais/1980/emc-16-1980-11-27.md"}}, {id:"federal:BR:EC:15/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1980, data:"1980-11-19", numero:"15", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1980-11-19;15", vigente:true, titulo:"Emenda Constitucional nº 15 de 19/11/1980", urn:"urn:lex:br:federal:emenda.constitucional:1980-11-19;15", ementa:"Restabelece o sistema de voto direto nas eleições para Governador de Estado e para Senador da República.", arquivo:"federal/emendas-constitucionais/1980/emc-15-1980-11-19.md"}}, {id:"federal:BR:EC:14/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1980, data:"1980-09-09", numero:"14", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1980-09-09;14", vigente:true, titulo:"Emenda Constitucional nº 14 de 09/09/1980", urn:"urn:lex:br:federal:emenda.constitucional:1980-09-09;14", ementa:"Altera o Título das Disposições Gerais e Transitórias, estendendo os mandatos dos atuais Prefeitos, Vice-Prefeitos, Vereadores e Suplentes até 1983, imprimindo nova redação ao artigo 209.", arquivo:"federal/emendas-constitucionais/1980/emc-14-1980-09-09.md"}}, {id:"federal:BR:EC:17/1980", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1980, data:"1980-12-02", numero:"17", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1980-12-02;17", vigente:true, titulo:"Emenda Constitucional nº 17 de 02/12/1980", urn:"urn:lex:br:federal:emenda.constitucional:1980-12-02;17", ementa:"Altera os artigos 23, 24 e 25 da Constituição Federal e dá outras providências.", arquivo:"federal/emendas-constitucionais/1980/emc-17-1980-12-02.md"}}, {id:"federal:BR:EC:139/2026", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2026, data:"2026-05-05", numero:"139", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2026-05-05;139", vigente:true, titulo:"Emenda Constitucional nº 139 de 05/05/2026", urn:"urn:lex:br:federal:emenda.constitucional:2026-05-05;139", ementa:"Altera o § 1º do art. 31 e o art. 75 da Constituição Federal para estabelecer os Tribunais de Contas como órgãos permanentes e essenciais ao controle externo da administração pública.", arquivo:"federal/emendas-constitucionais/2026/emc-139-2026-05-05.md"}}, {id:"federal:BR:EC:57/2008", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2008, data:"2008-12-18", numero:"57", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2008-12-18;57", vigente:true, titulo:"Emenda Constitucional nº 57 de 18/12/2008", urn:"urn:lex:br:federal:emenda.constitucional:2008-12-18;57", ementa:"Acrescenta artigo ao Ato das Disposições Constitucionais Transitórias para convalidar os atos de criação, fusão, incorporação e desmembramento de Municípios.", arquivo:"federal/emendas-constitucionais/2008/emc-57-2008-12-18.md"}}, {id:"federal:BR:EC:13/1979", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1979, data:"1979-10-10", numero:"13", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1979-10-10;13", vigente:true, titulo:"Emenda Constitucional nº 13 de 10/10/1979", urn:"urn:lex:br:federal:emenda.constitucional:1979-10-10;13", ementa:"Altera o artigo 36 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/1979/emc-13-1979-10-10.md"}}, {id:"federal:BR:EC:98/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2017, data:"2017-12-06", numero:"98", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2017-12-06;98", vigente:true, titulo:"Emenda Constitucional nº 98 de 06/12/2017", urn:"urn:lex:br:federal:emenda.constitucional:2017-12-06;98", ementa:"Altera o art. 31 da Emenda Constitucional nº 19, de 4 de junho de 1998, para prever a inclusão, em quadro em extinção da administração pública federal, de servidor público, de integrante da carreira de policial, civil ou militar, e de pessoa que haja mantido relação ou vínculo funcional, empregatício, estatutário ou de trabalho com a administração pública dos ex-Territórios ou dos Estados do Amapá ou de Roraima, inclusive suas prefeituras, na fase de instalação dessas unidades federadas, e dá ou", arquivo:"federal/emendas-constitucionais/2017/emc-98-2017-12-06.md"}}, {id:"federal:BR:EC:99/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2017, data:"2017-12-14", numero:"99", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2017-12-14;99", vigente:true, titulo:"Emenda Constitucional nº 99 de 14/12/2017", urn:"urn:lex:br:federal:emenda.constitucional:2017-12-14;99", ementa:"Altera o art. 101 do Ato das Disposições Constitucionais Transitórias, para instituir novo regime especial de pagamento de precatórios, e os arts. 102, 103 e 105 do Ato das Disposições Constitucionais Transitórias.", arquivo:"federal/emendas-constitucionais/2017/emc-99-2017-12-14.md"}}, {id:"federal:BR:EC:96/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2017, data:"2017-06-06", numero:"96", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2017-06-06;96", vigente:true, titulo:"Emenda Constitucional nº 96 de 06/06/2017", urn:"urn:lex:br:federal:emenda.constitucional:2017-06-06;96", ementa:"Acrescenta § 7º ao art. 225 da Constituição Federal para determinar que práticas desportivas que utilizem animais não são consideradas cruéis, nas condições que especifica.", arquivo:"federal/emendas-constitucionais/2017/emc-96-2017-06-06.md"}}, {id:"federal:BR:EC:97/2017", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2017, data:"2017-10-04", numero:"97", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2017-10-04;97", vigente:true, titulo:"Emenda Constitucional nº 97 de 04/10/2017", urn:"urn:lex:br:federal:emenda.constitucional:2017-10-04;97", ementa:"Altera a Constituição Federal para vedar as coligações partidárias nas eleições proporcionais, estabelecer normas sobre acesso dos partidos políticos aos recursos do fundo partidário e ao tempo de propaganda gratuito no rádio e na televisão e dispor sobre regras de transição.", arquivo:"federal/emendas-constitucionais/2017/emc-97-2017-10-04.md"}}, {id:"federal:BR:EC:17/1997", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1997, data:"1997-11-22", numero:"17", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1997-11-22;17", vigente:true, titulo:"Emenda Constitucional nº 17 de 22/11/1997", urn:"urn:lex:br:federal:emenda.constitucional:1997-11-22;17", ementa:"Altera dispositivos dos arts. 71 e 72 do Ato das Disposições Constitucionais Transitórias, introduzidos pela Emenda Constitucional de Revisão n. 1, de 1994.", arquivo:"federal/emendas-constitucionais/1997/emc-17-1997-11-22.md"}}, {id:"federal:BR:EC:16/1997", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1997, data:"1997-06-04", numero:"16", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1997-06-04;16", vigente:true, titulo:"Emenda Constitucional nº 16 de 04/06/1997", urn:"urn:lex:br:federal:emenda.constitucional:1997-06-04;16", ementa:"Dá nova redação ao § 5º do art. 14, ao \"caput\" do art. 28, ao inciso II do art. 29, ao \"caput\" do art. 77 e ao art. 82 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/1997/emc-16-1997-06-04.md"}}, {id:"federal:BR:EC:116/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2022, data:"2022-02-17", numero:"116", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2022-02-17;116", vigente:true, titulo:"Emenda Constitucional nº 116 de 17/02/2022", urn:"urn:lex:br:federal:emenda.constitucional:2022-02-17;116", ementa:"Acrescenta § 1º-A ao art. 156 da Constituição Federal para prever a não incidência sobre templos de qualquer culto do Imposto sobre a Propriedade Predial e Territorial Urbana (IPTU), ainda que as entidades abrangidas pela imunidade tributária sejam apenas locatárias do bem imóvel.", arquivo:"federal/emendas-constitucionais/2022/emc-116-2022-02-17.md"}}, {id:"federal:BR:EC:117/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2022, data:"2022-04-05", numero:"117", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2022-04-05;117", vigente:true, titulo:"Emenda Constitucional nº 117 de 05/04/2022", urn:"urn:lex:br:federal:emenda.constitucional:2022-04-05;117", ementa:"Altera o art. 17 da Constituição Federal para impor aos partidos políticos a aplicação de recursos do fundo partidário na promoção e difusão da participação política das mulheres, bem como a aplicação de recursos desse fundo e do Fundo Especial de Financiamento de Campanha e a divisão do tempo de propaganda gratuita no rádio e na televisão no percentual mínimo de 30% (trinta por cento) para candidaturas femininas.", arquivo:"federal/emendas-constitucionais/2022/emc-117-2022-04-05.md"}}, {id:"federal:BR:EC:123/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2022, data:"2022-07-14", numero:"123", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2022-07-14;123", vigente:true, titulo:"Emenda Constitucional nº 123 de 14/07/2022", urn:"urn:lex:br:federal:emenda.constitucional:2022-07-14;123", ementa:"Altera o art. 225 da Constituição Federal para estabelecer diferencial de competitividade para os biocombustíveis; inclui o art. 120 no Ato das Disposições Constitucionais Transitórias para reconhecer o estado de emergência decorrente da elevação extraordinária e imprevisível dos preços do petróleo, combustíveis e seus derivados e dos impactos sociais dela decorrentes; autoriza a União a entregar auxílio financeiro aos Estados e ao Distrito Federal que outorgarem créditos tributários do Imposto ", arquivo:"federal/emendas-constitucionais/2022/emc-123-2022-07-14.md"}}, {id:"federal:BR:EC:122/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2022, data:"2022-05-17", numero:"122", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2022-05-17;122", vigente:true, titulo:"Emenda Constitucional nº 122 de 17/05/2022", urn:"urn:lex:br:federal:emenda.constitucional:2022-05-17;122", ementa:"Altera a Constituição Federal para elevar para setenta anos a idade máxima para a escolha e nomeação de membros do Supremo Tribunal Federal, do Superior Tribunal de Justiça, dos Tribunais Regionais Federais, do Tribunal Superior do Trabalho, dos Tribunais Regionais do Trabalho, do Tribunal de Contas da União e dos Ministros civis do Superior Tribunal Militar.", arquivo:"federal/emendas-constitucionais/2022/emc-122-2022-05-17.md"}}, {id:"federal:BR:EC:128/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-22", numero:"128", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2022-12-22;128", vigente:true, titulo:"Emenda Constitucional nº 128 de 22/12/2022", urn:"urn:lex:br:federal:emenda.constitucional:2022-12-22;128", ementa:"Acrescenta § 7º ao art. 167 da Constituição Federal, para proibir a imposição e a transferência, por lei, de qualquer encargo financeiro decorrente da prestação de serviço público para a União, os Estados, o Distrito Federal e os Municípios.", arquivo:"federal/emendas-constitucionais/2022/emc-128-2022-12-22.md"}}, {id:"federal:BR:EC:115/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2022, data:"2022-02-10", numero:"115", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2022-02-10;115", vigente:true, titulo:"Emenda Constitucional nº 115 de 10/02/2022", urn:"urn:lex:br:federal:emenda.constitucional:2022-02-10;115", ementa:"Altera a Constituição Federal para incluir a proteção de dados pessoais entre os direitos e garantias fundamentais e para fixar a competência privativa da União para legislar sobre proteção e tratamento de dados pessoais.", arquivo:"federal/emendas-constitucionais/2022/emc-115-2022-02-10.md"}}, {id:"federal:BR:EC:121/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2022, data:"2022-05-10", numero:"121", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2022-05-10;121", vigente:true, titulo:"Emenda Constitucional nº 121 de 10/05/2022", urn:"urn:lex:br:federal:emenda.constitucional:2022-05-10;121", ementa:"Altera o inciso IV do § 2º do art. 4º da Emenda Constitucional nº 109, de 15 de março de 2021.", arquivo:"federal/emendas-constitucionais/2022/emc-121-2022-05-10.md"}}, {id:"federal:BR:EC:118/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2022, data:"2022-04-26", numero:"118", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2022-04-26;118", vigente:true, titulo:"Emenda Constitucional nº 118 de 26/04/2022", urn:"urn:lex:br:federal:emenda.constitucional:2022-04-26;118", ementa:"Dá nova redação às alíneas \"b\" e \"c\" do inciso XXIII do caput do art. 21 da Constituição Federal, para autorizar a produção, a comercialização e a utilização de radioisótopos para pesquisa e uso médicos.", arquivo:"federal/emendas-constitucionais/2022/emc-118-2022-04-26.md"}}, {id:"federal:BR:EC:125/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2022, data:"2022-07-14", numero:"125", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2022-07-14;125", vigente:true, titulo:"Emenda Constitucional nº 125 de 14/07/2022", urn:"urn:lex:br:federal:emenda.constitucional:2022-07-14;125", ementa:"Altera o art. 105 da Constituição Federal para instituir no recurso especial o requisito da relevância das questões de direito federal infraconstitucional.", arquivo:"federal/emendas-constitucionais/2022/emc-125-2022-07-14.md"}}, {id:"federal:BR:EC:119/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2022, data:"2022-04-27", numero:"119", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2022-04-27;119", vigente:true, titulo:"Emenda Constitucional nº 119 de 27/04/2022", urn:"urn:lex:br:federal:emenda.constitucional:2022-04-27;119", ementa:"Altera o Ato das Disposições Constitucionais Transitórias para determinar a impossibilidade de responsabilização dos Estados, do Distrito Federal, dos Municípios e dos agentes públicos desses entes federados pelo descumprimento, nos exercícios financeiros de 2020 e 2021, do disposto no caput do art. 212 da Constituição Federal; e dá outras providências.", arquivo:"federal/emendas-constitucionais/2022/emc-119-2022-04-27.md"}}, {id:"federal:BR:EC:124/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2022, data:"2022-07-14", numero:"124", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2022-07-14;124", vigente:true, titulo:"Emenda Constitucional nº 124 de 14/07/2022", urn:"urn:lex:br:federal:emenda.constitucional:2022-07-14;124", ementa:"Institui o piso salarial nacional do enfermeiro, do técnico de enfermagem, do auxiliar de enfermagem e da parteira.", arquivo:"federal/emendas-constitucionais/2022/emc-124-2022-07-14.md"}}, {id:"federal:BR:EC:126/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-21", numero:"126", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2022-12-21;126", vigente:true, titulo:"Emenda Constitucional nº 126 de 21/12/2022", urn:"urn:lex:br:federal:emenda.constitucional:2022-12-21;126", ementa:"Altera a Constituição Federal, para dispor sobre as emendas individuais ao projeto de lei orçamentária, e o Ato das Disposições Constitucionais Transitórias para excluir despesas dos limites previstos no art. 107; define regras para a transição da Presidência da República aplicáveis à Lei Orçamentária de 2023; e dá outras providências.", arquivo:"federal/emendas-constitucionais/2022/emc-126-2022-12-21.md"}}, {id:"federal:BR:EC:120/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2022, data:"2022-05-05", numero:"120", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2022-05-05;120", vigente:true, titulo:"Emenda Constitucional nº 120 de 05/05/2022", urn:"urn:lex:br:federal:emenda.constitucional:2022-05-05;120", ementa:"Acrescenta §§ 7º, 8º, 9º, 10 e 11 ao art. 198 da Constituição Federal, para dispor sobre a responsabilidade financeira da União, corresponsável pelo Sistema Único de Saúde (SUS), na política remuneratória e na valorização dos profissionais que exercem atividades de agente comunitário de saúde e de agente de combate às endemias.", arquivo:"federal/emendas-constitucionais/2022/emc-120-2022-05-05.md"}}, {id:"federal:BR:EC:127/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-22", numero:"127", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2022-12-22;127", vigente:true, titulo:"Emenda Constitucional nº 127 de 22/12/2022", urn:"urn:lex:br:federal:emenda.constitucional:2022-12-22;127", ementa:"Altera a Constituição Federal e o Ato das Disposições Constitucionais Transitórias para estabelecer que compete à União prestar assistência financeira complementar aos Estados, ao Distrito Federal e aos Municípios e às entidades filantrópicas, para o cumprimento dos pisos salariais profissionais nacionais para o enfermeiro, o técnico de enfermagem, o auxiliar de enfermagem e a parteira; altera a Emenda Constitucional nº 109, de 15 de março de 2021, para estabelecer o superávit financeiro dos fun", arquivo:"federal/emendas-constitucionais/2022/emc-127-2022-12-22.md"}}, {id:"federal:BR:EC:45/2004", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2004, data:"2004-12-08", numero:"45", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2004-12-08;45", vigente:true, titulo:"Emenda Constitucional nº 45 de 08/12/2004", urn:"urn:lex:br:federal:emenda.constitucional:2004-12-08;45", ementa:"Altera dispositivos dos arts. 5º, 36, 52, 92, 93, 95, 98, 99, 102, 103, 104, 105, 107, 109, 111, 112, 114, 115, 125, 126, 127, 128, 129, 134 e 168 da Constituição Federal, e acrescenta os arts. 103-A, 103-B, 111-A e 130-A, e dá outras providências.", arquivo:"federal/emendas-constitucionais/2004/emc-45-2004-12-08.md"}}, {id:"federal:BR:EC:44/2004", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2004, data:"2004-06-30", numero:"44", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2004-06-30;44", vigente:true, titulo:"Emenda Constitucional nº 44 de 30/06/2004", urn:"urn:lex:br:federal:emenda.constitucional:2004-06-30;44", ementa:"Altera o Sistema Tributário Nacional e dá outras providências.", arquivo:"federal/emendas-constitucionais/2004/emc-44-2004-06-30.md"}}, {id:"federal:BR:EC:43/2004", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2004, data:"2004-04-15", numero:"43", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2004-04-15;43", vigente:true, titulo:"Emenda Constitucional nº 43 de 15/04/2004", urn:"urn:lex:br:federal:emenda.constitucional:2004-04-15;43", ementa:"Altera o art. 42 do Ato das Disposições Constitucionais Transitórias, prorrogando, por 10 (dez)anos, a aplicação, por parte da União, de percentuais mínimos do total dos recursos destinados à irrigação nas Regiões Centro-Oeste e Nordeste.", arquivo:"federal/emendas-constitucionais/2004/emc-43-2004-04-15.md"}}, {id:"federal:BR:EC:5/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1975, data:"1975-06-28", numero:"5", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1975-06-28;5", vigente:true, titulo:"Emenda Constitucional nº 5 de 28/06/1975", urn:"urn:lex:br:federal:emenda.constitucional:1975-06-28;5", ementa:"Dá nova redação ao \"caput\" do artigo 25 da Constituição.", arquivo:"federal/emendas-constitucionais/1975/emc-5-1975-06-28.md"}}, {id:"federal:BR:EC:4/1975", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1975, data:"1975-04-23", numero:"4", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1975-04-23;4", vigente:true, titulo:"Emenda Constitucional nº 4 de 23/04/1975", urn:"urn:lex:br:federal:emenda.constitucional:1975-04-23;4", ementa:"Dispõe sobre a remuneração dos vereadores.", arquivo:"federal/emendas-constitucionais/1975/emc-4-1975-04-23.md"}}, {id:"federal:BR:EC:73/2013", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2013, data:"2013-06-06", numero:"73", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2013-06-06;73", vigente:true, titulo:"Emenda Constitucional nº 73 de 06/06/2013", urn:"urn:lex:br:federal:emenda.constitucional:2013-06-06;73", ementa:"Cria os Tribunais Regionais Federais da 6ª, 7ª, 8ª e 9ª Regiões.", arquivo:"federal/emendas-constitucionais/2013/emc-73-2013-06-06.md"}}, {id:"federal:BR:EC:75/2013", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2013, data:"2013-10-15", numero:"75", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2013-10-15;75", vigente:true, titulo:"Emenda Constitucional nº 75 de 15/10/2013", urn:"urn:lex:br:federal:emenda.constitucional:2013-10-15;75", ementa:"Acrescenta a alínea e ao inciso VI do art. 150 da Constituição Federal, instituindo imunidade tributária sobre os fonogramas e videofonogramas musicais produzidos no Brasil contendo obras musicais ou literomusicais de autores brasileiros e/ou obras em geral interpretadas por artistas brasileiros bem como os suportes materiais ou arquivos digitais que os contenham.", arquivo:"federal/emendas-constitucionais/2013/emc-75-2013-10-15.md"}}, {id:"federal:BR:EC:72/2013", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2013, data:"2013-04-02", numero:"72", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2013-04-02;72", vigente:true, titulo:"Emenda Constitucional nº 72 de 02/04/2013", urn:"urn:lex:br:federal:emenda.constitucional:2013-04-02;72", ementa:"Altera a redação do parágrafo único do art. 7º da Constituição Federal para estabelecer a igualdade de direitos trabalhistas entre os trabalhadores domésticos e os demais trabalhadores urbanos e rurais.", arquivo:"federal/emendas-constitucionais/2013/emc-72-2013-04-02.md"}}, {id:"federal:BR:EC:76/2013", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2013, data:"2013-11-28", numero:"76", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2013-11-28;76", vigente:true, titulo:"Emenda Constitucional nº 76 de 28/11/2013", urn:"urn:lex:br:federal:emenda.constitucional:2013-11-28;76", ementa:"Altera o § 2º do art. 55 e o § 4º do art. 66 da Constituição Federal, para abolir a votação secreta nos casos de perda de mandato de Deputado ou Senador e de apreciação de veto.", arquivo:"federal/emendas-constitucionais/2013/emc-76-2013-11-28.md"}}, {id:"federal:BR:EC:74/2013", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2013, data:"2013-08-06", numero:"74", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2013-08-06;74", vigente:true, titulo:"Emenda Constitucional nº 74 de 06/08/2013", urn:"urn:lex:br:federal:emenda.constitucional:2013-08-06;74", ementa:"Altera o art. 134 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/2013/emc-74-2013-08-06.md"}}, {id:"federal:BR:EC:4/1993", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1993, data:"1993-09-14", numero:"4", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1993-09-14;4", vigente:true, titulo:"Emenda Constitucional nº 4 de 14/09/1993", urn:"urn:lex:br:federal:emenda.constitucional:1993-09-14;4", ementa:"Dá nova redação ao art. 16 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/1993/emc-4-1993-09-14.md"}}, {id:"federal:BR:EC:3/1993", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1993, data:"1993-03-17", numero:"3", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1993-03-17;3", vigente:true, titulo:"Emenda Constitucional nº 3 de 17/03/1993", urn:"urn:lex:br:federal:emenda.constitucional:1993-03-17;3", ementa:"Altera os arts. 40, 42, 102, 103, 150, 155, 156, 160, 167 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/1993/emc-3-1993-03-17.md"}}, {id:"federal:BR:EC:1/1969", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1969, data:"1969-10-17", numero:"1", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1969-10-17;1", vigente:true, titulo:"Emenda Constitucional nº 1 de 17/10/1969", urn:"urn:lex:br:federal:emenda.constitucional:1969-10-17;1", ementa:"Edita o novo texto da Constituição Federal de 24 de janeiro de 1967.", arquivo:"federal/emendas-constitucionais/1969/emc-1-1969-10-17.md"}}, {id:"federal:BR:EC:137/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2025, data:"2025-12-09", numero:"137", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2025-12-09;137", vigente:true, titulo:"Emenda Constitucional nº 137 de 09/12/2025", urn:"urn:lex:br:federal:emenda.constitucional:2025-12-09;137", ementa:"Altera o art. 155 da Constituição Federal para conceder imunidade do Imposto sobre a Propriedade de Veículos Automotores (IPVA) aos veículos que especifica.", arquivo:"federal/emendas-constitucionais/2025/emc-137-2025-12-09.md"}}, {id:"federal:BR:EC:138/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2025, data:"2025-12-19", numero:"138", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2025-12-19;138", vigente:true, titulo:"Emenda Constitucional nº 138 de 19/12/2025", urn:"urn:lex:br:federal:emenda.constitucional:2025-12-19;138", ementa:"Altera o art. 37 da Constituição Federal para permitir a acumulação remunerada de um cargo de professor com outro de qualquer natureza.", arquivo:"federal/emendas-constitucionais/2025/emc-138-2025-12-19.md"}}, {id:"federal:BR:EC:136/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2025, data:"2025-09-09", numero:"136", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2025-09-09;136", vigente:true, titulo:"Emenda Constitucional nº 136 de 09/09/2025", urn:"urn:lex:br:federal:emenda.constitucional:2025-09-09;136", ementa:"Altera a Constituição Federal, o Ato das Disposições Constitucionais Transitórias e a Emenda Constitucional nº 113, de 8 de dezembro de 2021, a fim de instituir limite para o pagamento de precatórios pelos Estados, pelo Distrito Federal e pelos Municípios e de estipular novo prazo de parcelamento especial de débitos dos Estados, dos Municípios e do Distrito Federal com seus regimes próprios de previdência social e dos Municípios com o Regime Geral de Previdência Social; e dá outras providências.", arquivo:"federal/emendas-constitucionais/2025/emc-136-2025-09-09.md"}}, {id:"federal:BR:EC:55/2007", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2007, data:"2007-09-20", numero:"55", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2007-09-20;55", vigente:true, titulo:"Emenda Constitucional nº 55 de 20/09/2007", urn:"urn:lex:br:federal:emenda.constitucional:2007-09-20;55", ementa:"Altera o art. 159 da Constituição Federal, aumentando a entrega de recursos pela União ao Fundo de Participação dos Municípios.", arquivo:"federal/emendas-constitucionais/2007/emc-55-2007-09-20.md"}}, {id:"federal:BR:EC:56/2007", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2007, data:"2007-12-20", numero:"56", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2007-12-20;56", vigente:true, titulo:"Emenda Constitucional nº 56 de 20/12/2007", urn:"urn:lex:br:federal:emenda.constitucional:2007-12-20;56", ementa:"Prorroga o prazo previsto no caput do art. 76 do Ato das Disposições Constitucionais Transitórias e dá outras providências.", arquivo:"federal/emendas-constitucionais/2007/emc-56-2007-12-20.md"}}, {id:"federal:BR:EC:54/2007", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2007, data:"2007-09-20", numero:"54", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2007-09-20;54", vigente:true, titulo:"Emenda Constitucional nº 54 de 20/09/2007", urn:"urn:lex:br:federal:emenda.constitucional:2007-09-20;54", ementa:"Dá nova redação à alínea c do inciso I do art. 12 da Constituição Federal e acrescenta art. 95 ao Ato das Disposições Constitucionais Transitórias, assegurando o registro nos consulados de brasileiros nascidos no estrangeiro.", arquivo:"federal/emendas-constitucionais/2007/emc-54-2007-09-20.md"}}, {id:"federal:BR:EC:11/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1978, data:"1978-10-13", numero:"11", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1978-10-13;11", vigente:true, titulo:"Emenda Constitucional nº 11 de 13/10/1978", urn:"urn:lex:br:federal:emenda.constitucional:1978-10-13;11", ementa:"Altera dispositivos da Constituição Federal.", arquivo:"federal/emendas-constitucionais/1978/emc-11-1978-10-13.md"}}, {id:"federal:BR:EC:12/1978", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1978, data:"1978-10-17", numero:"12", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1978-10-17;12", vigente:true, titulo:"Emenda Constitucional nº 12 de 17/10/1978", urn:"urn:lex:br:federal:emenda.constitucional:1978-10-17;12", ementa:"Assegura aos Deficientes a melhoria de sua condição social e econômica.", arquivo:"federal/emendas-constitucionais/1978/emc-12-1978-10-17.md"}}, {id:"federal:BR:EC:95/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2016, data:"2016-12-15", numero:"95", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2016-12-15;95", vigente:true, titulo:"Emenda Constitucional nº 95 de 15/12/2016", urn:"urn:lex:br:federal:emenda.constitucional:2016-12-15;95", ementa:"Altera o Ato das Disposições Constitucionais Transitórias, para instituir o Novo Regime Fiscal, e dá outras providências.", arquivo:"federal/emendas-constitucionais/2016/emc-95-2016-12-15.md"}}, {id:"federal:BR:EC:92/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2016, data:"2016-07-12", numero:"92", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2016-07-12;92", vigente:true, titulo:"Emenda Constitucional nº 92 de 12/07/2016", urn:"urn:lex:br:federal:emenda.constitucional:2016-07-12;92", ementa:"Altera os arts. 92 e 111-A da Constituição Federal, para explicitar o Tribunal Superior do Trabalho como órgão do Poder Judiciário, alterar os requisitos para o provimento dos cargos de Ministros daquele Tribunal e modificar-lhe a competência.", arquivo:"federal/emendas-constitucionais/2016/emc-92-2016-07-12.md"}}, {id:"federal:BR:EC:91/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2016, data:"2016-02-18", numero:"91", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2016-02-18;91", vigente:true, titulo:"Emenda Constitucional nº 91 de 18/02/2016", urn:"urn:lex:br:federal:emenda.constitucional:2016-02-18;91", ementa:"Altera a Constituição Federal para estabelecer a possibilidade, excepcional e em período determinado, de desfiliação partidária, sem prejuízo do mandato.", arquivo:"federal/emendas-constitucionais/2016/emc-91-2016-02-18.md"}}, {id:"federal:BR:EC:93/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2016, data:"2016-09-08", numero:"93", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2016-09-08;93", vigente:true, titulo:"Emenda Constitucional nº 93 de 08/09/2016", urn:"urn:lex:br:federal:emenda.constitucional:2016-09-08;93", ementa:"Altera o Ato das Disposições Constitucionais Transitórias para prorrogar a desvinculação de receitas da União e estabelecer a desvinculação de receitas dos Estados, Distrito Federal e Municípios.", arquivo:"federal/emendas-constitucionais/2016/emc-93-2016-09-08.md"}}, {id:"federal:BR:EC:94/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2016, data:"2016-12-15", numero:"94", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2016-12-15;94", vigente:true, titulo:"Emenda Constitucional nº 94 de 15/12/2016", urn:"urn:lex:br:federal:emenda.constitucional:2016-12-15;94", ementa:"Altera o art. 100 da Constituição Federal, para dispor sobre o regime de pagamento de débitos públicos decorrentes de condenações judiciais; e acrescenta dispositivos ao Ato das Disposições Constitucionais Transitórias, para instituir regime especial de pagamento para os casos em mora.", arquivo:"federal/emendas-constitucionais/2016/emc-94-2016-12-15.md"}}, {id:"federal:BR:EC:13/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1996, data:"1996-08-21", numero:"13", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1996-08-21;13", vigente:true, titulo:"Emenda Constitucional nº 13 de 21/08/1996", urn:"urn:lex:br:federal:emenda.constitucional:1996-08-21;13", ementa:"Dá nova redação ao inciso II do art. 192 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/1996/emc-13-1996-08-21.md"}}, {id:"federal:BR:EC:14/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1996, data:"1996-09-12", numero:"14", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1996-09-12;14", vigente:true, titulo:"Emenda Constitucional nº 14 de 12/09/1996", urn:"urn:lex:br:federal:emenda.constitucional:1996-09-12;14", ementa:"Modifica os arts. 34, 208, 211 e 212 da Constituição Federal e dá nova redação ao art. 60 do Ato das Disposições Constitucionais Transitórias.", arquivo:"federal/emendas-constitucionais/1996/emc-14-1996-09-12.md"}}, {id:"federal:BR:EC:12/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1996, data:"1996-08-15", numero:"12", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1996-08-15;12", vigente:true, titulo:"Emenda Constitucional nº 12 de 15/08/1996", urn:"urn:lex:br:federal:emenda.constitucional:1996-08-15;12", ementa:"Outorga competência à União, para instituir contribuição provisória sobre movimentação ou transmissão de valores e de créditos e direitos de natureza financeira.", arquivo:"federal/emendas-constitucionais/1996/emc-12-1996-08-15.md"}}, {id:"federal:BR:EC:11/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1996, data:"1996-04-30", numero:"11", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1996-04-30;11", vigente:true, titulo:"Emenda Constitucional nº 11 de 30/04/1996", urn:"urn:lex:br:federal:emenda.constitucional:1996-04-30;11", ementa:"Permite a admissão de professores, técnicos e cientistas estrangeiros pelas universidades brasileiras e concede autonomia às instituições de pesquisa científica e tecnológica.", arquivo:"federal/emendas-constitucionais/1996/emc-11-1996-04-30.md"}}, {id:"federal:BR:EC:10/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1996, data:"1996-03-04", numero:"10", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1996-03-04;10", vigente:true, titulo:"Emenda Constitucional nº 10 de 04/03/1996", urn:"urn:lex:br:federal:emenda.constitucional:1996-03-04;10", ementa:"Altera os arts. 71 e 72 do Ato das Disposições Constitucionais Transitórias, introduzidos pela Emenda Constitucional de Revisão n.º 1, de 1994.", arquivo:"federal/emendas-constitucionais/1996/emc-10-1996-03-04.md"}}, {id:"federal:BR:EC:15/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1996, data:"1996-09-12", numero:"15", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1996-09-12;15", vigente:true, titulo:"Emenda Constitucional nº 15 de 12/09/1996", urn:"urn:lex:br:federal:emenda.constitucional:1996-09-12;15", ementa:"Dá nova redação ao § 4° do art. 18 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/1996/emc-15-1996-09-12.md"}}, {id:"federal:BR:EC:109/2021", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2021, data:"2021-03-15", numero:"109", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2021-03-15;109", vigente:true, titulo:"Emenda Constitucional nº 109 de 15/03/2021", urn:"urn:lex:br:federal:emenda.constitucional:2021-03-15;109", ementa:"Altera os arts. 29-A, 37, 49, 84, 163, 165, 167, 168 e 169 da Constituição Federal e os arts. 101 e 109 do Ato das Disposições Constitucionais Transitórias; acrescenta à Constituição Federal os arts. 164-A, 167-A, 167-B, 167-C, 167-D, 167-E, 167-F e 167-G; revoga dispositivos do Ato das Disposições Constitucionais Transitórias e institui regras transitórias sobre redução de benefícios tributários; desvincula parcialmente o superávit financeiro de fundos públicos; e suspende condicionalidades par", arquivo:"federal/emendas-constitucionais/2021/emc-109-2021-03-15.md"}}, {id:"federal:BR:EC:110/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2021, data:"2021-07-12", numero:"110", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2021-07-12;110", vigente:true, titulo:"Emenda Constitucional nº 110 de 12/07/2021", urn:"urn:lex:br:federal:emenda.constitucional:2021-07-12;110", ementa:"Acrescenta o art. 18-A ao Ato das Disposições Constitucionais Transitórias, para dispor sobre a convalidação de atos administrativos praticados no Estado do Tocantins entre 1º de janeiro de 1989 e 31 de dezembro de 1994.", arquivo:"federal/emendas-constitucionais/2021/emc-110-2021-07-12.md"}}, {id:"federal:BR:EC:113/2021", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-08", numero:"113", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2021-12-08;113", vigente:true, titulo:"Emenda Constitucional nº 113 de 08/12/2021", urn:"urn:lex:br:federal:emenda.constitucional:2021-12-08;113", ementa:"Altera a Constituição Federal e o Ato das Disposições Constitucionais Transitórias para estabelecer o novo regime de pagamentos de precatórios, modificar normas relativas ao Novo Regime Fiscal e autorizar o parcelamento de débitos previdenciários dos Municípios; e dá outras providências.", arquivo:"federal/emendas-constitucionais/2021/emc-113-2021-12-08.md"}}, {id:"federal:BR:EC:114/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2021, data:"2021-12-16", numero:"114", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2021-12-16;114", vigente:true, titulo:"Emenda Constitucional nº 114 de 16/12/2021", urn:"urn:lex:br:federal:emenda.constitucional:2021-12-16;114", ementa:"Altera a Constituição Federal e o Ato das Disposições Constitucionais Transitórias para estabelecer o novo regime de pagamentos de precatórios, modificar normas relativas ao Novo Regime Fiscal e autorizar o parcelamento de débitos previdenciários dos Municípios; e dá outras providências.", arquivo:"federal/emendas-constitucionais/2021/emc-114-2021-12-16.md"}}, {id:"federal:BR:EC:111/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2021, data:"2021-09-28", numero:"111", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2021-09-28;111", vigente:true, titulo:"Emenda Constitucional nº 111 de 28/09/2021", urn:"urn:lex:br:federal:emenda.constitucional:2021-09-28;111", ementa:"Altera a Constituição Federal para disciplinar a realização de consultas populares concomitantes às eleições municipais, dispor sobre o instituto da fidelidade partidária, alterar a data de posse de Governadores e do Presidente da República e estabelecer regras transitórias para distribuição entre os partidos políticos dos recursos do fundo partidário e do Fundo Especial de Financiamento de Campanha (FEFC) e para o funcionamento dos partidos políticos.", arquivo:"federal/emendas-constitucionais/2021/emc-111-2021-09-28.md"}}, {id:"federal:BR:EC:112/2021", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2021, data:"2021-10-27", numero:"112", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2021-10-27;112", vigente:true, titulo:"Emenda Constitucional nº 112 de 27/10/2021", urn:"urn:lex:br:federal:emenda.constitucional:2021-10-27;112", ementa:"Altera o art. 159 da Constituição Federal para disciplinar a distribuição de recursos pela União ao Fundo de Participação dos Municípios.", arquivo:"federal/emendas-constitucionais/2021/emc-112-2021-10-27.md"}}, {id:"federal:BR:EC:42/2003", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2003, data:"2003-12-19", numero:"42", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2003-12-19;42", vigente:true, titulo:"Emenda Constitucional nº 42 de 19/12/2003", urn:"urn:lex:br:federal:emenda.constitucional:2003-12-19;42", ementa:"Altera o Sistema Tributário Nacional e dá outras providências.", arquivo:"federal/emendas-constitucionais/2003/emc-42-2003-12-19.md"}}, {id:"federal:BR:EC:40/2003", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2003, data:"2003-05-29", numero:"40", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2003-05-29;40", vigente:true, titulo:"Emenda Constitucional nº 40 de 29/05/2003", urn:"urn:lex:br:federal:emenda.constitucional:2003-05-29;40", ementa:"Altera o inciso V do art. 163 e o art. 192 da Constituição Federal, e o caput do art. 52 do Ato das Disposições Constitucionais Transitórias.", arquivo:"federal/emendas-constitucionais/2003/emc-40-2003-05-29.md"}}, {id:"federal:BR:EC:41/2003", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2003, data:"2003-12-19", numero:"41", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2003-12-19;41", vigente:true, titulo:"Emenda Constitucional nº 41 de 19/12/2003", urn:"urn:lex:br:federal:emenda.constitucional:2003-12-19;41", ementa:"Modifica os arts. 37, 40, 42, 48, 96, 149 e 201 da Constituição Federal, revoga o inciso IX do § 3º do art. 142 da Constituição Federal e dispositivos da Emenda Constitucional nº 20, de 15 de dezembro de 1998, e dá outras providências.", arquivo:"federal/emendas-constitucionais/2003/emc-41-2003-12-19.md"}}, {id:"federal:BR:EC:23/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1983, data:"1983-12-01", numero:"23", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1983-12-01;23", vigente:true, titulo:"Emenda Constitucional nº 23 de 01/12/1983", urn:"urn:lex:br:federal:emenda.constitucional:1983-12-01;23", ementa:"Altera dispositivos da Constituição Federal.", arquivo:"federal/emendas-constitucionais/1983/emc-23-1983-12-01.md"}}, {id:"federal:BR:EC:24/1983", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1983, data:"1983-12-01", numero:"24", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1983-12-01;24", vigente:true, titulo:"Emenda Constitucional nº 24 de 01/12/1983", urn:"urn:lex:br:federal:emenda.constitucional:1983-12-01;24", ementa:"Estabelece a obrigatoriedade de aplicação anual, pela União, de nunca menos de treze por cento, e pelos Estados, Distrito Federal e Municípios, de, no mínimo, vinte e cinco por cento da renda resultante dos impostos, na manutenção e desenvolvimento do ensino.", arquivo:"federal/emendas-constitucionais/1983/emc-24-1983-12-01.md"}}, {id:"federal:BR:EC:71/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2012, data:"2012-11-29", numero:"71", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2012-11-29;71", vigente:true, titulo:"Emenda Constitucional nº 71 de 29/11/2012", urn:"urn:lex:br:federal:emenda.constitucional:2012-11-29;71", ementa:"Acrescenta o art. 216-A à Constituição Federal para instituir o Sistema Nacional de Cultura.", arquivo:"federal/emendas-constitucionais/2012/emc-71-2012-11-29.md"}}, {id:"federal:BR:EC:70/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2012, data:"2012-03-29", numero:"70", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2012-03-29;70", vigente:true, titulo:"Emenda Constitucional nº 70 de 29/03/2012", urn:"urn:lex:br:federal:emenda.constitucional:2012-03-29;70", ementa:"Acrescenta art. 6º-A à Emenda Constitucional nº 41, de 2003, para estabelecer critérios para o cálculo e a correção dos proventos da aposentadoria por invalidez dos servidores públicos que ingressaram no serviço público até a data da publicação daquela Emenda Constitucional.", arquivo:"federal/emendas-constitucionais/2012/emc-70-2012-03-29.md"}}, {id:"federal:BR:EC:69/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2012, data:"2012-03-29", numero:"69", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2012-03-29;69", vigente:true, titulo:"Emenda Constitucional nº 69 de 29/03/2012", urn:"urn:lex:br:federal:emenda.constitucional:2012-03-29;69", ementa:"Altera os arts. 21, 22 e 48 da Constituição Federal, para transferir da União para o Distrito Federal as atribuições de organizar e manter a Defensoria Pública do Distrito Federal.", arquivo:"federal/emendas-constitucionais/2012/emc-69-2012-03-29.md"}}, {id:"federal:BR:EC:2/1992", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1992, data:"1992-08-25", numero:"2", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1992-08-25;2", vigente:true, titulo:"Emenda Constitucional nº 2 de 25/08/1992", urn:"urn:lex:br:federal:emenda.constitucional:1992-08-25;2", ementa:"Dispõe sobre o plebiscito previsto no art. 2º do Ato das Disposições Constitucionais Transitórias.", arquivo:"federal/emendas-constitucionais/1992/emc-2-1992-08-25.md"}}, {id:"federal:BR:EC:1/1992", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1992, data:"1992-03-31", numero:"1", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1992-03-31;1", vigente:true, titulo:"Emenda Constitucional nº 1 de 31/03/1992", urn:"urn:lex:br:federal:emenda.constitucional:1992-03-31;1", ementa:"Dispõe sobre a remuneração dos Deputados Estaduais e do Vereadores.", arquivo:"federal/emendas-constitucionais/1992/emc-1-1992-03-31.md"}}, {id:"federal:BR:EC:35/2001", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2001, data:"2001-12-20", numero:"35", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2001-12-20;35", vigente:true, titulo:"Emenda Constitucional nº 35 de 20/12/2001", urn:"urn:lex:br:federal:emenda.constitucional:2001-12-20;35", ementa:"Dá nova redação ao art. 53 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/2001/emc-35-2001-12-20.md"}}, {id:"federal:BR:EC:33/2001", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2001, data:"2001-12-11", numero:"33", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2001-12-11;33", vigente:true, titulo:"Emenda Constitucional nº 33 de 11/12/2001", urn:"urn:lex:br:federal:emenda.constitucional:2001-12-11;33", ementa:"Altera os arts. 149, 155 e 177 da Constituição Federal", arquivo:"federal/emendas-constitucionais/2001/emc-33-2001-12-11.md"}}, {id:"federal:BR:EC:34/2001", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2001, data:"2001-12-13", numero:"34", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2001-12-13;34", vigente:true, titulo:"Emenda Constitucional nº 34 de 13/12/2001", urn:"urn:lex:br:federal:emenda.constitucional:2001-12-13;34", ementa:"Dá nova redação à alínea c do inciso XVI do art. 37 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/2001/emc-34-2001-12-13.md"}}, {id:"federal:BR:EC:32/2001", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2001, data:"2001-09-11", numero:"32", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2001-09-11;32", vigente:true, titulo:"Emenda Constitucional nº 32 de 11/09/2001", urn:"urn:lex:br:federal:emenda.constitucional:2001-09-11;32", ementa:"Altera dispositivos dos arts. 48, 57, 61, 62, 64, 66, 84, 88 e 246 da Constituição Federal, e dá outras providências.", arquivo:"federal/emendas-constitucionais/2001/emc-32-2001-09-11.md"}}, {id:"federal:BR:EC:20/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1981, data:"1981-10-20", numero:"20", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1981-10-20;20", vigente:true, titulo:"Emenda Constitucional nº 20 de 20/10/1981", urn:"urn:lex:br:federal:emenda.constitucional:1981-10-20;20", ementa:"Dispõe sobre novos subsídios para os Prefeitos Municipais e para os Vice-Prefeitos quando remunerados.", arquivo:"federal/emendas-constitucionais/1981/emc-20-1981-10-20.md"}}, {id:"federal:BR:EC:21/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1981, data:"1981-10-27", numero:"21", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1981-10-27;21", vigente:true, titulo:"Emenda Constitucional nº 21 de 27/10/1981", urn:"urn:lex:br:federal:emenda.constitucional:1981-10-27;21", ementa:"Dispõe sobre a remuneração dos Deputados Estaduais.", arquivo:"federal/emendas-constitucionais/1981/emc-21-1981-10-27.md"}}, {id:"federal:BR:EC:18/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1981, data:"1981-06-30", numero:"18", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1981-06-30;18", vigente:true, titulo:"Emenda Constitucional nº 18 de 30/06/1981", urn:"urn:lex:br:federal:emenda.constitucional:1981-06-30;18", ementa:"Dispõe sobre aposentadoria especial para professores e professoras.", arquivo:"federal/emendas-constitucionais/1981/emc-18-1981-06-30.md"}}, {id:"federal:BR:EC:19/1981", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1981, data:"1981-08-06", numero:"19", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1981-08-06;19", vigente:true, titulo:"Emenda Constitucional nº 19 de 06/08/1981", urn:"urn:lex:br:federal:emenda.constitucional:1981-08-06;19", ementa:"Altera o artigo 151 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/1981/emc-19-1981-08-06.md"}}, {id:"federal:BR:EC:3/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1972, data:"1972-06-15", numero:"3", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1972-06-15;3", vigente:true, titulo:"Emenda Constitucional nº 3 de 15/06/1972", urn:"urn:lex:br:federal:emenda.constitucional:1972-06-15;3", ementa:"Altera a redação do artigo 29 (caput) e a do artigo 36, e seu parágrafo 1º, da Constituição.", arquivo:"federal/emendas-constitucionais/1972/emc-3-1972-06-15.md"}}, {id:"federal:BR:EC:2/1972", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1972, data:"1972-05-09", numero:"2", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1972-05-09;2", vigente:true, titulo:"Emenda Constitucional nº 2 de 09/05/1972", urn:"urn:lex:br:federal:emenda.constitucional:1972-05-09;2", ementa:"Regula a eleição de Governadores e Vice-Governadores dos Estados em 1974.", arquivo:"federal/emendas-constitucionais/1972/emc-2-1972-05-09.md"}}, {id:"federal:BR:EC:66/2010", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2010, data:"2010-07-13", numero:"66", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2010-07-13;66", vigente:true, titulo:"Emenda Constitucional nº 66 de 13/07/2010", urn:"urn:lex:br:federal:emenda.constitucional:2010-07-13;66", ementa:"Dá nova redação ao § 6º do art. 226 da Constituição Federal, que dispõe sobre a dissolubilidade do casamento civil pelo divórcio, suprimindo o requisito de prévia separação judicial por mais de 1 (um) ano ou de comprovada separação de fato por mais de 2 (dois) anos.", arquivo:"federal/emendas-constitucionais/2010/emc-66-2010-07-13.md"}}, {id:"federal:BR:EC:63/2010", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2010, data:"2010-02-04", numero:"63", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2010-02-04;63", vigente:true, titulo:"Emenda Constitucional nº 63 de 04/02/2010", urn:"urn:lex:br:federal:emenda.constitucional:2010-02-04;63", ementa:"Altera o § 5º do art. 198 da Constituição Federal para dispor sobre piso salarial profissional nacional e diretrizes para os Planos de Carreira de agentes comunitários de saúde e de agentes de combate às endemias.", arquivo:"federal/emendas-constitucionais/2010/emc-63-2010-02-04.md"}}, {id:"federal:BR:EC:65/2010", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2010, data:"2010-07-13", numero:"65", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2010-07-13;65", vigente:true, titulo:"Emenda Constitucional nº 65 de 13/07/2010", urn:"urn:lex:br:federal:emenda.constitucional:2010-07-13;65", ementa:"Altera a denominação do Capítulo VII do Título VIII da Constituição Federal e modifica o seu art. 227, para cuidar dos interesses da juventude.", arquivo:"federal/emendas-constitucionais/2010/emc-65-2010-07-13.md"}}, {id:"federal:BR:EC:64/2010", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2010, data:"2010-02-04", numero:"64", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2010-02-04;64", vigente:true, titulo:"Emenda Constitucional nº 64 de 04/02/2010", urn:"urn:lex:br:federal:emenda.constitucional:2010-02-04;64", ementa:"Altera o art. 6º da Constituição Federal, para introduzir a alimentação como direito social.", arquivo:"federal/emendas-constitucionais/2010/emc-64-2010-02-04.md"}}, {id:"federal:BR:EC:67/2010", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2010, data:"2010-12-22", numero:"67", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2010-12-22;67", vigente:true, titulo:"Emenda Constitucional nº 67 de 22/12/2010", urn:"urn:lex:br:federal:emenda.constitucional:2010-12-22;67", ementa:"Prorroga, por tempo indeterminado, o prazo de vigência do Fundo de Combate e Erradicação da Pobreza.", arquivo:"federal/emendas-constitucionais/2010/emc-67-2010-12-22.md"}}, {id:"federal:BR:EC:58/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2009, data:"2009-09-23", numero:"58", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2009-09-23;58", vigente:true, titulo:"Emenda Constitucional nº 58 de 23/09/2009", urn:"urn:lex:br:federal:emenda.constitucional:2009-09-23;58", ementa:"Altera a redação do inciso IV do caput do art. 29 e do art. 29-A da Constituição Federal, tratando das disposições relativas à recomposição das Câmaras Municipais.", arquivo:"federal/emendas-constitucionais/2009/emc-58-2009-09-23.md"}}, {id:"federal:BR:EC:61/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2009, data:"2009-11-11", numero:"61", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2009-11-11;61", vigente:true, titulo:"Emenda Constitucional nº 61 de 11/11/2009", urn:"urn:lex:br:federal:emenda.constitucional:2009-11-11;61", ementa:"Altera o art. 103-B da Constituição Federal, para modificar a composição do Conselho Nacional de Justiça.", arquivo:"federal/emendas-constitucionais/2009/emc-61-2009-11-11.md"}}, {id:"federal:BR:EC:59/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2009, data:"2009-11-11", numero:"59", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2009-11-11;59", vigente:true, titulo:"Emenda Constitucional nº 59 de 11/11/2009", urn:"urn:lex:br:federal:emenda.constitucional:2009-11-11;59", ementa:"Acrescenta § 3º ao art. 76 do Ato das Disposições Constitucionais Transitórias para reduzir, anualmente, a partir do exercício de 2009, o percentual da Desvinculação das Receitas da União incidente sobre os recursos destinados à manutenção e desenvolvimento do ensino de que trata o art. 212 da Constituição Federal, dá nova redação aos incisos I e VII do art. 208, de forma a prever a obrigatoriedade do ensino de quatro a dezessete anos e ampliar a abrangência dos programas suplementares para toda", arquivo:"federal/emendas-constitucionais/2009/emc-59-2009-11-11.md"}}, {id:"federal:BR:EC:60/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2009, data:"2009-11-11", numero:"60", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2009-11-11;60", vigente:true, titulo:"Emenda Constitucional nº 60 de 11/11/2009", urn:"urn:lex:br:federal:emenda.constitucional:2009-11-11;60", ementa:"Altera o art. 89 do Ato das Disposições Constitucionais Transitórias para dispor sobre o quadro de servidores civis e militares do ex-Território Federal de Rondônia.", arquivo:"federal/emendas-constitucionais/2009/emc-60-2009-11-11.md"}}, {id:"federal:BR:EC:62/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-09", numero:"62", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2009-12-09;62", vigente:true, titulo:"Emenda Constitucional nº 62 de 09/12/2009", urn:"urn:lex:br:federal:emenda.constitucional:2009-12-09;62", ementa:"Altera o art. 100 da Constituição Federal e acrescenta o art. 97 ao Ato das Disposições Constitucionais Transitórias, instituindo regime especial de pagamento de precatórios pelos Estados, Distrito Federal e Municípios.", arquivo:"federal/emendas-constitucionais/2009/emc-62-2009-12-09.md"}}, {id:"federal:BR:EC:20/1998", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1998, data:"1998-12-15", numero:"20", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1998-12-15;20", vigente:true, titulo:"Emenda Constitucional nº 20 de 15/12/1998", urn:"urn:lex:br:federal:emenda.constitucional:1998-12-15;20", ementa:"Modifica o sistema de previdência social, estabelece normas de transição e dá outras providências.", arquivo:"federal/emendas-constitucionais/1998/emc-20-1998-12-15.md"}}, {id:"federal:BR:EC:18/1998", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"sem_informacao", ano:1998, data:"1998-02-05", numero:"18", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1998-02-05;18", vigente:true, titulo:"Emenda Constitucional nº 18 de 05/02/1998", urn:"urn:lex:br:federal:emenda.constitucional:1998-02-05;18", ementa:"Dispõe sobre o regime constitucional dos militares.", arquivo:"federal/emendas-constitucionais/1998/emc-18-1998-02-05.md"}}, {id:"federal:BR:EC:19/1998", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1998, data:"1998-06-04", numero:"19", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1998-06-04;19", vigente:true, titulo:"Emenda Constitucional nº 19 de 04/06/1998", urn:"urn:lex:br:federal:emenda.constitucional:1998-06-04;19", ementa:"Modifica o regime e dispõe sobre princípio e normas da Administração Pública, Servidores e Agentes políticos, controle de despesas e finanças públicas e custeio de atividades a cargo do Distrito Federal, e dá outras providências.", arquivo:"federal/emendas-constitucionais/1998/emc-19-1998-06-04.md"}}, {id:"federal:BR:EC:131/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2023, data:"2023-10-03", numero:"131", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2023-10-03;131", vigente:true, titulo:"Emenda Constitucional nº 131 de 03/10/2023", urn:"urn:lex:br:federal:emenda.constitucional:2023-10-03;131", ementa:"Altera o art. 12 da Constituição Federal para suprimir a perda da nacionalidade brasileira em razão da mera aquisição de outra nacionalidade, incluir a exceção para situações de apatridia e acrescentar a possibilidade de a pessoa requerer a perda da própria nacionalidade.", arquivo:"federal/emendas-constitucionais/2023/emc-131-2023-10-03.md"}}, {id:"federal:BR:EC:132/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-20", numero:"132", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2023-12-20;132", vigente:true, titulo:"Emenda Constitucional nº 132 de 20/12/2023", urn:"urn:lex:br:federal:emenda.constitucional:2023-12-20;132", ementa:"Altera o Sistema Tributário Nacional.", arquivo:"federal/emendas-constitucionais/2023/emc-132-2023-12-20.md"}}, {id:"federal:BR:EC:129/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-05", numero:"129", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2023-07-05;129", vigente:true, titulo:"Emenda Constitucional nº 129 de 05/07/2023", urn:"urn:lex:br:federal:emenda.constitucional:2023-07-05;129", ementa:"Acrescenta o art. 123 ao Ato das Disposições Constitucionais Transitórias, para assegurar prazo de vigência adicional aos instrumentos de permissão lotérica.", arquivo:"federal/emendas-constitucionais/2023/emc-129-2023-07-05.md"}}, {id:"federal:BR:EC:130/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2023, data:"2023-10-03", numero:"130", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2023-10-03;130", vigente:true, titulo:"Emenda Constitucional nº 130 de 03/10/2023", urn:"urn:lex:br:federal:emenda.constitucional:2023-10-03;130", ementa:"Altera o art. 93 da Constituição Federal para permitir a permuta entre juízes de direito vinculados a diferentes tribunais.", arquivo:"federal/emendas-constitucionais/2023/emc-130-2023-10-03.md"}}, {id:"federal:BR:EC:48/2005", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2005, data:"2005-08-10", numero:"48", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2005-08-10;48", vigente:true, titulo:"Emenda Constitucional nº 48 de 10/08/2005", urn:"urn:lex:br:federal:emenda.constitucional:2005-08-10;48", ementa:"Acrescenta o § 3º ao art. 215 da Constituição Federal, instituindo o Plano Nacional de Cultura.", arquivo:"federal/emendas-constitucionais/2005/emc-48-2005-08-10.md"}}, {id:"federal:BR:EC:47/2005", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2005, data:"2005-07-05", numero:"47", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2005-07-05;47", vigente:true, titulo:"Emenda Constitucional nº 47 de 05/07/2005", urn:"urn:lex:br:federal:emenda.constitucional:2005-07-05;47", ementa:"Altera os arts. 37, 40, 195 e 201 da Constituição Federal, para dispor sobre a previdência social, e dá outras providências.", arquivo:"federal/emendas-constitucionais/2005/emc-47-2005-07-05.md"}}, {id:"federal:BR:EC:46/2005", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2005, data:"2005-05-05", numero:"46", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2005-05-05;46", vigente:true, titulo:"Emenda Constitucional nº 46 de 05/05/2005", urn:"urn:lex:br:federal:emenda.constitucional:2005-05-05;46", ementa:"Altera o inciso IV do art. 20 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/2005/emc-46-2005-05-05.md"}}, {id:"federal:BR:EC:27/1985", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1985, data:"1985-11-28", numero:"27", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1985-11-28;27", vigente:true, titulo:"Emenda Constitucional nº 27 de 28/11/1985", urn:"urn:lex:br:federal:emenda.constitucional:1985-11-28;27", ementa:"Altera dispositivos da Constituição Federal.", arquivo:"federal/emendas-constitucionais/1985/emc-27-1985-11-28.md"}}, {id:"federal:BR:EC:26/1985", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1985, data:"1985-11-27", numero:"26", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1985-11-27;26", vigente:true, titulo:"Emenda Constitucional nº 26 de 27/11/1985", urn:"urn:lex:br:federal:emenda.constitucional:1985-11-27;26", ementa:"Convoca Assembléia Nacional Constituinte e dá outras providências.", arquivo:"federal/emendas-constitucionais/1985/emc-26-1985-11-27.md"}}, {id:"federal:BR:EC:25/1985", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1985, data:"1985-05-15", numero:"25", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1985-05-15;25", vigente:true, titulo:"Emenda Constitucional nº 25 de 15/05/1985", urn:"urn:lex:br:federal:emenda.constitucional:1985-05-15;25", ementa:"Altera dispositivos da Constituição Federal e estabelece outras normas constitucionais de caráter transitório.", arquivo:"federal/emendas-constitucionais/1985/emc-25-1985-05-15.md"}}, {id:"federal:BR:EC:6/1976", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:1976, data:"1976-06-04", numero:"6", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1976-06-04;6", vigente:true, titulo:"Emenda Constitucional nº 6 de 04/06/1976", urn:"urn:lex:br:federal:emenda.constitucional:1976-06-04;6", ementa:"Dá nova redação ao artigo 104 da Constituição.", arquivo:"federal/emendas-constitucionais/1976/emc-6-1976-06-04.md"}}, {id:"federal:BR:EC:84/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2014, data:"2014-12-02", numero:"84", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2014-12-02;84", vigente:true, titulo:"Emenda Constitucional nº 84 de 02/12/2014", urn:"urn:lex:br:federal:emenda.constitucional:2014-12-02;84", ementa:"Altera o art. 159 da Constituição Federal para aumentar a entrega de recursos pela União para o Fundo de Participação dos Municípios.", arquivo:"federal/emendas-constitucionais/2014/emc-84-2014-12-02.md"}}, {id:"federal:BR:EC:78/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2014, data:"2014-05-14", numero:"78", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2014-05-14;78", vigente:true, titulo:"Emenda Constitucional nº 78 de 14/05/2014", urn:"urn:lex:br:federal:emenda.constitucional:2014-05-14;78", ementa:"Acrescenta art. 54-A ao Ato das Disposições Constitucionais Transitórias, para dispor sobre indenização devida aos seringueiros de que trata o art. 54 desse Ato.", arquivo:"federal/emendas-constitucionais/2014/emc-78-2014-05-14.md"}}, {id:"federal:BR:EC:77/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2014, data:"2014-02-11", numero:"77", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2014-02-11;77", vigente:true, titulo:"Emenda Constitucional nº 77 de 11/02/2014", urn:"urn:lex:br:federal:emenda.constitucional:2014-02-11;77", ementa:"Altera os incisos II, III e VIII do § 3º do art. 142 da Constituição Federal, para estender aos profissionais de saúde das Forças Armadas a possibilidade de cumulação de cargo a que se refere o art. 37, inciso XVI, alínea \"c\".", arquivo:"federal/emendas-constitucionais/2014/emc-77-2014-02-11.md"}}, {id:"federal:BR:EC:80/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2014, data:"2014-06-04", numero:"80", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2014-06-04;80", vigente:true, titulo:"Emenda Constitucional nº 80 de 04/06/2014", urn:"urn:lex:br:federal:emenda.constitucional:2014-06-04;80", ementa:"Altera o Capítulo IV - Das Funções Essenciais à Justiça, do Título IV - Da Organização dos Poderes, e acrescenta artigo ao Ato das Disposições Constitucionais Transitórias da Constituição Federal.", arquivo:"federal/emendas-constitucionais/2014/emc-80-2014-06-04.md"}}, {id:"federal:BR:EC:79/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2014, data:"2014-05-27", numero:"79", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2014-05-27;79", vigente:true, titulo:"Emenda Constitucional nº 79 de 27/05/2014", urn:"urn:lex:br:federal:emenda.constitucional:2014-05-27;79", ementa:"Altera o art. 31 da Emenda Constitucional nº 19, de 4 de junho de 1998, para prever a inclusão, em quadro em extinção da Administração Federal, de servidores e policiais militares admitidos pelos Estados do Amapá e de Roraima, na fase de instalação dessas unidades federadas, e dá outras providências.", arquivo:"federal/emendas-constitucionais/2014/emc-79-2014-05-27.md"}}, {id:"federal:BR:EC:81/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2014, data:"2014-06-05", numero:"81", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2014-06-05;81", vigente:true, titulo:"Emenda Constitucional nº 81 de 05/06/2014", urn:"urn:lex:br:federal:emenda.constitucional:2014-06-05;81", ementa:"Dá nova redação ao art. 243 da Constituição Federal.", arquivo:"federal/emendas-constitucionais/2014/emc-81-2014-06-05.md"}}, {id:"federal:BR:EC:83/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2014, data:"2014-08-05", numero:"83", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2014-08-05;83", vigente:true, titulo:"Emenda Constitucional nº 83 de 05/08/2014", urn:"urn:lex:br:federal:emenda.constitucional:2014-08-05;83", ementa:"Acrescenta o art. 92-A ao Ato das Disposições Constitucionais Transitórias - ADCT.", arquivo:"federal/emendas-constitucionais/2014/emc-83-2014-08-05.md"}}, {id:"federal:BR:EC:82/2014", properties:{esfera:"federal", versao_texto:"original", tipo:"Emenda Constitucional", vigencia_origem:"revogada=false", ano:2014, data:"2014-07-16", numero:"82", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:2014-07-16;82", vigente:true, titulo:"Emenda Constitucional nº 82 de 16/07/2014", urn:"urn:lex:br:federal:emenda.constitucional:2014-07-16;82", ementa:"Inclui o § 10 ao art. 144 da Constituição Federal, para disciplinar a segurança viária no âmbito dos Estados, do Distrito Federal e dos Municípios.", arquivo:"federal/emendas-constitucionais/2014/emc-82-2014-07-16.md"}}] AS row
CREATE (n:Norma{id: row.id}) SET n += row.properties SET n:EmendaConstitucional;
