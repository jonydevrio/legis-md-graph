:"Orça a Receita Geral da Republica dos Estados Unidos do Brazil para o exercicio de 1914", arquivo:"federal/leis-ordinarias/1913/lei-2841-1913-12-31.md"}}, {id:"federal:BR:L:s/n/1832:8256", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1832, data:"1832-10-03", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1832-10-03;seq-sf-0", titulo:"Lei  de 03/10/1832", vigente:true, urn:"urn:lex:br:federal:lei:1832-10-03;seq-sf-0", ementa:"DA NOVA ORGANIZAÇÃO AS ATUAIS ACADEMIAS MEDICO-CIRURGICAS DAS CIDADES DO RIO DE JANEIRO, E BAHIA.", arquivo:"federal/leis-ordinarias/1832/lei-sn-1832-10-03-s0.md"}}, {id:"federal:BR:L:s/n/1832:8257", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1832, data:"1832-10-12", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1832-10-12;seq-sf-0", titulo:"Lei  de 12/10/1832", vigente:true, urn:"urn:lex:br:federal:lei:1832-10-12;seq-sf-0", ementa:"ORDENA QUE OS ELEITORES DOS DEPUTADOS PARA A SEGUINTE LEGISLATURA, LHES CONFIRMA NAS PROCURAÇÕES, FACULDADE PARA REFORMAREM ALGUNS ARTIGOS DA CONSTITUIÇÃO.", arquivo:"federal/leis-ordinarias/1832/lei-sn-1832-10-12-s0.md"}}, {id:"federal:BR:L:s/n/1832:8258", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1832, data:"1832-08-31", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1832-08-31;seq-sf-0", titulo:"Lei  de 31/08/1832", vigente:true, urn:"urn:lex:br:federal:lei:1832-08-31;seq-sf-0", ementa:"DECLARA QUE AS VILAS DE CAMPO DOS GOITACAZES, E DE SÃO JOÃO DA BARRA, FICAM PERTENCENDO A PROVINCIA DO RIO DE JANEIRO.", arquivo:"federal/leis-ordinarias/1832/lei-sn-1832-08-31-s0.md"}}, {id:"federal:BR:L:s/n/1832:8259", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1832, data:"1832-10-24", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1832-10-24;seq-sf-1", vigente:true, titulo:"Lei  de 24/10/1832 ( seq-sf: 1 )", urn:"urn:lex:br:federal:lei:1832-10-24;seq-sf-1", ementa:"ORÇA A RECEITA, E FIXA A DESPESA PARA O ANO FINANCEIRO DE 1833 - 1834.", arquivo:"federal/leis-ordinarias/1832/lei-sn-1832-10-24-s1.md"}}, {id:"federal:BR:L:s/n/1832:8260", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1832, data:"1832-10-23", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1832-10-23;seq-sf-0", titulo:"Lei  de 23/10/1832", vigente:true, urn:"urn:lex:br:federal:lei:1832-10-23;seq-sf-0", ementa:"SOBRE NATURALIZAÇÃO DOS ESTRANGEIROS.", arquivo:"federal/leis-ordinarias/1832/lei-sn-1832-10-23-s0.md"}}, {id:"federal:BR:L:s/n/1832:8261", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1832, data:"1832-11-29", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1832-11-29;seq-sf-0", titulo:"Lei  de 29/11/1832", vigente:true, urn:"urn:lex:br:federal:lei:1832-11-29;seq-sf-0", ementa:"PROMULGA O CÓDIGO DO PROCESSO CRIMINAL DE PRIMEIRA INSTÂNCIA COM DISPOSIÇÃO PROVISÓRIA À CERCA DA ADMINISTRAÇÃO DA JUSTIÇA CIVIL.", arquivo:"federal/leis-ordinarias/1832/lei-sn-1832-11-29-s0.md"}}, {id:"federal:BR:L:s/n/1832:8262", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1832, data:"1832-10-24", numero:"", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1832-10-24;seq-sf-0", titulo:"Lei  de 24/10/1832", vigente:true, urn:"urn:lex:br:federal:lei:1832-10-24;seq-sf-0", ementa:"SOBRE O JURO OU PREMIO DE DINHEIRO, DE QUALQUER ESPECIE.", arquivo:"federal/leis-ordinarias/1832/lei-sn-1832-10-24-s0.md"}}, {id:"federal:BR:L:s/n/1832:8263", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"r