:6168/1974", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-12-09", numero:"6168", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1974-12-09;6168", vigente:true, titulo:"Lei nº 6.168 de 09/12/1974", urn:"urn:lex:br:federal:lei:1974-12-09;6168", ementa:"Cria o Fundo de Apoio ao Desenvolvimento Social - FAS - e dá outras providências.", arquivo:"federal/leis-ordinarias/1974/lei-6168-1974-12-09.md"}}, {id:"federal:BR:L:6058/1974", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-06-17", numero:"6058", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1974-06-17;6058", vigente:true, titulo:"Lei nº 6.058 de 17/06/1974", urn:"urn:lex:br:federal:lei:1974-06-17;6058", ementa:"Cria na Justiça do Trabalho da 5ª Região a 1ª e 2ª Juntas de Conciliação e   Julgamento com sede no Município de Simões Filho, no Estado da   Bahia.", arquivo:"federal/leis-ordinarias/1974/lei-6058-1974-06-17.md"}}, {id:"federal:BR:L:6031/1974", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-04-30", numero:"6031", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1974-04-30;6031", vigente:true, titulo:"Lei nº 6.031 de 30/04/1974", urn:"urn:lex:br:federal:lei:1974-04-30;6031", ementa:"Fixa os valores dos níveis de vencimentos do Grupo-Direção e Assessoramento Superiores do Quadro Permanente da Secretaria doTribunal Superior Eleitoral e dá outras providências.", arquivo:"federal/leis-ordinarias/1974/lei-6031-1974-04-30.md"}}, {id:"federal:BR:L:6083/1974", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1974, data:"1974-07-10", numero:"6083", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1974-07-10;6083", vigente:true, titulo:"Lei nº 6.083 