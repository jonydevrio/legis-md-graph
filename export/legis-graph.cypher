 ano:1965, data:"1965-12-09", numero:"4896", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-12-09;4896", vigente:true, titulo:"Lei nº 4.896 de 09/12/1965", urn:"urn:lex:br:federal:lei:1965-12-09;4896", ementa:"Dispõe sôbre a fusão dos cargos de Assistente Jurídico e de Assessor de   Direito Aeronáutico, do Quadro de Pessoal do Ministério da   Aeronáutica.", arquivo:"federal/leis-ordinarias/1965/lei-4896-1965-12-09.md"}}, {id:"federal:BR:L:4790/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-20", numero:"4790", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-20;4790", vigente:true, titulo:"Lei nº 4.790 de 20/10/1965", urn:"urn:lex:br:federal:lei:1965-10-20;4790", ementa:"Fixa novos valôres dos símbolos do Quadro do Pessoal da Secretaria do Tribunal Regional do Trabalho da 6ª Região, e dá outras providências. /Há veto/", arquivo:"federal/leis-ordinarias/1965/lei-4790-1965-10-20.md"}}, {id:"federal:BR:L:4778/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-09-22", numero:"4778", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-09-22;4778", vigente:true, titulo:"Lei nº 4.778 de 22/09/1965", urn:"urn:lex:br:federal:lei:1965-09-22;4778", ementa:"Dispõe sôbre a obrigatoriedade de serem ouvidas as autoridades florestais   na aprovação de plantas e planos de loteamento para venda de terrenos em   prestações.", arquivo:"federal/leis-ordinarias/1965/lei-4778-1965-09-22.md"}}, {id:"federal:BR:L:4772/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-09-15", numero:"4772", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-09-15;4772", vigente:true, titulo:"Lei nº 4.772 de 15/09/1965", urn:"urn:lex:br:federal:lei:1965-09-15;4772", ementa:"Dispõe sôbre a transferência de cargos e dos respectivos servidores do   Escritório técnico da Cidade Universitária, da Universidade do Brasil, para o   Quadro do Pessoal - Parte Permanente, do Departamento Administrativo do Serviço   Público e vice-versa, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4772-1965-09-15.md"}}, {id:"federal:BR:L:4804/1965", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-10-20", numero:"4804", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-10-20;4804", vigente:true, titulo:"Lei nº 4.804 de 20/10/1965", urn:"urn:lex:br:federal:lei:1965-10-20;4804", ementa:"Dispõe sôbre demolições e reconstruções de benfeitorias, em próprio nacional, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4804-1965-10-20.md"}}, {id:"federal:BR:L:4864/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-29", numero:"4864", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-29;4864", vigente:true, titulo:"Lei nº 4.864 de 29/11/1965", urn:"urn:lex:br:federal:lei:1965-11-29;4864", ementa:"Cria medidas de estímulo à Indústria de Construção Civil.", arquivo:"federal/leis-ordinarias/1965/lei-4864-1965-11-29.md"}}, {id:"federal:BR:L:4858/1965", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1965, data:"1965-11-26", numero:"4858", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1965-11-26;4858", vigente:true, titulo:"Lei nº 4.858 de 26/11/1965", urn:"urn:lex:br:federal:lei:1965-11-26;4858", ementa:"Dispõe sobre as novas atribuições da Comissão de Marinha Mercante e do Conselho Superior do Trabalho Marítimo, e dá outras providências.", arquivo:"federal/leis-ordinarias/1965/lei-4858-1965-11-26.md"}}, {id:"federal:BR:L:4738/1965", propertie