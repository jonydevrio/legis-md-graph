0-2002-11-21.md"}}, {id:"federal:BR:L:10477/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2002, data:"2002-06-27", numero:"10477", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2002-06-27;10477", vigente:true, titulo:"Lei nº 10.477 de 27/06/2002", urn:"urn:lex:br:federal:lei:2002-06-27;10477", ementa:"Dispõe sobre a remuneração dos membros do Ministério Público da União.", arquivo:"federal/leis-ordinarias/2002/lei-10477-2002-06-27.md"}}, {id:"federal:BR:L:10543/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2002, data:"2002-11-12", numero:"10543", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2002-11-12;10543", vigente:true, titulo:"Lei nº 10.543 de 12/11/2002", urn:"urn:lex:br:federal:lei:2002-11-12;10543", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério da Justiça, crédito suplementar no valor de R$ 2.080.000,00 para reforço de dotações consignadas no vigente orçamento.", arquivo:"federal/leis-ordinarias/2002/lei-10543-2002-11-12.md"}}, {id:"federal:BR:L:10579/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2002, data:"2002-11-28", numero:"10579", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2002-11-28;10579", vigente:true, titulo:"Lei nº 10.579 de 28/11/2002", urn:"urn:lex:br:federal:lei:2002-11-28;10579", ementa:"Abre crédito suplementar ao Orçamento da Seguridade Social da União, em favor do Ministério da Saúde, no valor de R$ 707.342.273,00 para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2002/lei-10579-2002-11-28.md"}}, {id:"federal:BR:L:10606/2002", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2002, data:"2002-12-19", numero:"10606", fonte:"https://normas.leg.br/?urn=