igente:true, titulo:"Lei nº 3.889 de 16/02/1961", urn:"urn:lex:br:federal:lei:1961-02-16;3889", ementa:"Autoriza o Poder Executivo a abrir, ao Poder Judiciário - Tribunal Federal de Recursos - o crédito especial de Cr$ 86.286.924,00, para atender às despesas de qualquer natureza com a transferência do pessoal daquele Tribunal para Brasília.", arquivo:"federal/leis-ordinarias/1961/lei-3889-1961-02-16.md"}}, {id:"federal:BR:L:4039/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-12-20", numero:"4039", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-12-20;4039", vigente:true, titulo:"Lei nº 4.039 de 20/12/1961", urn:"urn:lex:br:federal:lei:1961-12-20;4039", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça Eleitoral - Tribunal Regional Eleitoral de Minas Gerais, o crédito especial de Cr$ 56.649,40 para pagamento de substituições de funcionários de sua secretaria, no exercício de 1957.", arquivo:"federal/leis-ordinarias/1961/lei-4039-1961-12-20.md"}}, {id:"federal:BR:L:3935/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-08-09", numero:"3935", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-08-09;3935", vigente:true, titulo:"Lei nº 3.935 de 09/08/1961", urn:"urn:lex:br:federal:lei:1961-08-09;3935", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 754.000.000,00, para atender a despesas com a realização do VII Recenseamento Geral de 1960 e dá outras providências.", arquivo:"federal/leis-ordinarias/1961/lei-3935-1961-08-09.md"}}, {id:"federal:BR:L:3928/1961", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1961, data:"1961-07-26", numero:"3928", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1961-07-26;3928", vigente:tru