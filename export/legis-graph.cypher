60/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-11-08", numero:"9860", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-11-08;9860", vigente:true, titulo:"Lei nº 9.860 de 08/11/1999", urn:"urn:lex:br:federal:lei:1999-11-08;9860", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor de diversos órgãos do Poder Executivo, crédito suplementar no valor global de R$ 12.866.296,00, para reforço de dotações consignadas no vigente orçamento.", arquivo:"federal/leis-ordinarias/1999/lei-9860-1999-11-08.md"}}, {id:"federal:BR:L:9872/1999", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-11-23", numero:"9872", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-11-23;9872", vigente:true, titulo:"Lei nº 9.872 de 23/11/1999", urn:"urn:lex:br:federal:lei:1999-11-23;9872", ementa:"Cria o Fundo de Aval para a Geração de Emprego e Renda - FUNPROGER, altera o art. 11 da Lei nº 9.365, de 16 de dezembro de 1996, e dá outras providências.", arquivo:"federal/leis-ordinarias/1999/lei-9872-1999-11-23.md"}}, {id:"federal:BR:L:9923/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-16", numero:"9923", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-12-16;9923", vigente:true, titulo:"Lei nº 9.923 de 16/12/1999", urn:"urn:lex:br:federal:lei:1999-12-16;9923", ementa:"Abre ao Orçamento de Investimento para 1999, em favor da empresas Petróleo Brasileiro S.A. - Petrobrás, e Petrobrás Distribuidora S.A. - BR, do Grupo Petrobrás, crédito especial no valor total de R$ 507.500.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1999/lei-9923-1999-12-16.md"}}, {id:"federal:BR:L:9821/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-08-23", numero:"9821", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-08-23;9821", vigente:true, titulo:"Lei nº 9.821 de 23/08/1999", urn:"urn:lex:br:federal:lei:1999-08-23;9821", ementa:"Altera dispositivos das Leis nºs 5.972, de 11 de dezembro de 1973, e   9.636, de 15 de maio de 1998, e dá outras providências.", arquivo:"federal/leis-ordinarias/1999/lei-9821-1999-08-23.md"}}, {id:"federal:BR:L:9867/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-11-10", numero:"9867", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-11-10;9867", vigente:true, titulo:"Lei nº 9.867 de 10/11/1999", urn:"urn:lex:br:federal:lei:1999-11-10;9867", ementa:"Dispõe sobre a criação e o funcionamento de Cooperativas Sociais, visando à integração social dos cidadãos, conforme especifica.", arquivo:"federal/leis-ordinarias/1999/lei-9867-1999-11-10.md"}}, {id:"federal:BR:L:9851/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-10-27", numero:"9851", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-10-27;9851", vigente:true, titulo:"Lei nº 9.851 de 27/10/1999", urn:"urn:lex:br:federal:lei:1999-10-27;9851", ementa:"Dá nova redação ao § 1º do art. 61 da Consolidação das Leis do Trabalho - CLT, aprovada pelo Decreto-Lei n. 5452.", arquivo:"federal/leis-ordinarias/1999/lei-9851-1999-10-27.md"}}, {id:"federal:BR:L:9907/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-14", numero:"9907", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-12-14;9907", vigente:true, titulo:"Lei nº 9.907 de 14/12/1999", urn:"urn:lex:br:federal:lei:1999-12-14;9907", ementa:"Abre ao Orçamento da Seguridade Social da União, em favor do Ministério da Agricultura e do Abastecimento, crédito suplementar no valor de R$ 50.000.000,00, para reforço de dotações do orçamento vigente.", arquivo:"federal/leis-ordinarias/1999/lei-9907-1999-12-14.md"}}, {id:"federal:BR:L:9944/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-22", numero:"9944", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-12-22;9944", vigente:true, titulo:"Lei nº 9.944 de 22/12/1999", urn:"urn:lex:br:federal:lei:1999-12-22;9944", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério do Desenvolvimento, Indústria e Comércio Exterior, crédito especial no valor de R$ 353.155.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1999/lei-9944-1999-12-22.md"}}, {id:"federal:BR:L:9893/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-10", numero:"9893", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-12-10;9893", vigente:true, titulo:"Lei nº 9.893 de 10/12/1999", urn:"urn:lex:br:federal:lei:1999-12-10;9893", ementa:"Abre ao Orçamento Fiscal da União, em favor da Justiça Eleitoral, crédito suplementar no valor de R$ 124.924.041,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1999/lei-9893-1999-12-10.md"}}, {id:"federal:BR:L:9882/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-12-03", numero:"9882", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-12-03;9882", vigente:true, titulo:"Lei nº 9.882 de 03/12/1999", urn:"urn:lex:br:federal:lei:1999-12-03;9882", ementa:"Dispõe sobre o processo e julgamento da argüição de descumprimento de preceito fundamental, nos termos do § 1º do art. 102 da Constituição Federal.", arquivo:"federal/leis-ordinarias/1999/lei-9882-1999-12-03.md"}}, {id:"f