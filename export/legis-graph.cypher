a:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1976, data:"1976-12-09", numero:"6396", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1976-12-09;6396", vigente:true, titulo:"Lei nº 6.396 de 09/12/1976", urn:"urn:lex:br:federal:lei:1976-12-09;6396", ementa:"Estima a Receita e Fixa a Despesa do Distrito Federal para o Exercício   Financeiro de 1977.", arquivo:"federal/leis-ordinarias/1976/lei-6396-1976-12-09.md"}}, {id:"federal:BR:L:6349/1976", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1976, data:"1976-07-07", numero:"6349", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1976-07-07;6349", vigente:true, titulo:"Lei nº 6.349 de 07/07/1976", urn:"urn:lex:br:federal:lei:1976-07-07;6349", ementa:"Dispõe sobre a indicação de candidatos a cargos eletivos nos municípios   onde os Partidos Políticos não constituiram Diretórios Municipais, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1976/lei-6349-1976-07-07.md"}}, {id:"federal:BR:L:6359/1976", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1976, data:"1976-09-22", numero:"6359", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1976-09-22;6359", vigente:true, titulo:"Lei nº 6.359 de 22/09/1976", urn:"urn:lex:br:federal:lei:1976-09-22;6359", ementa:"Fixa prazo para domicílio eleitoral e filiação partidária para as eleições   municipais de 1976.", arquivo:"federal/leis-ordinarias/1976/lei-6359-1976-09-22.md"}}, {id:"federal:BR:L:6355/1976", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1976, data:"1976-09-08", numero:"6355", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1976-09-08;6355", vigente:true, titulo:"Lei nº 6.355 de 08/09/1976", urn:"urn:lex:br:federal:lei:1976-09-08;6355", ementa:"Altera o caput do Artigo 20