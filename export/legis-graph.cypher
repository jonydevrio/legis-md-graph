ada=false", ano:1958, data:"1958-07-22", numero:"3436", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-07-22;3436", vigente:true, titulo:"Lei nº 3.436 de 22/07/1958", urn:"urn:lex:br:federal:lei:1958-07-22;3436", ementa:"Abre créditos suplementares no valor total de Cr$ 37.500.000,00 ao   Orçamento da União para o exercício financeiro de 1958, Anexo 2 - Poder   Legislativo.", arquivo:"federal/leis-ordinarias/1958/lei-3436-1958-07-22.md"}}, {id:"federal:BR:L:3471/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-11-28", numero:"3471", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-11-28;3471", vigente:true, titulo:"Lei nº 3.471 de 28/11/1958", urn:"urn:lex:br:federal:lei:1958-11-28;3471", ementa:"Institui o crédito de emergência aos agricultores e criadores do Polígono   das Secas.", arquivo:"federal/leis-ordinarias/1958/lei-3471-1958-11-28.md"}}, {id:"federal:BR:L:3407/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-06-16", numero:"3407", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-06-16;3407", vigente:true, titulo:"Lei nº 3.407 de 16/06/1958", urn:"urn:lex:br:federal:lei:1958-06-16;3407", ementa:"Concede à Federação das Bandeirantes do Brasil o auxílio de Cr$   10.000.000,00, para conclusão e aparelhamento de edifício de sua sede, no   Distrito Federal.", arquivo:"federal/leis-ordinarias/1958/lei-3407-1958-06-16.md"}}, {id:"federal:BR:L:3482/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-07", numero:"3482", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-07;3482", vigente:true, titulo:"Lei nº 3.482 de 07/12/1958", urn:"urn:lex:br:federal:lei:1958-12-07;3482", ementa:"Abre ao Congresso Nacional o crédito suplementar de Cr$ 4.200.000,00   (quatro milhões e duzentos mil cruzeiros) em reforço do Orçamento   vigente.", arquivo:"federal/leis-ordinarias/1958/lei-3482-1958-12-07.md"}}, {id:"federal:BR:L:3369/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-02-22", numero:"3369", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-02-22;3369", vigente:true, titulo:"Lei nº 3.369 de 22/02/1958", urn:"urn:lex:br:federal:lei:1958-02-22;3369", ementa:"Revoga o Decreto-Lei nº 2.928, de 31 de dezembro de 1940, na parte em que de refere ao art. 127, nº I, do Decreto-Lei nº 2.627, de 26 de setembro de 1940.", arquivo:"federal/leis-ordinarias/1958/lei-3369-1958-02-22.md"}}, {id:"federal:BR:L:3507/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-27", numero:"3507", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-27;3507", vigente:true, titulo:"Lei nº 3.507 de 27/12/1958", urn:"urn:lex:br:federal:lei:1958-12-27;3507", ementa:"Modifica a Lei nº 2.929, de 27 de outubro de 1956, que disciplina o   processo de alteração ou retificação de idade dos Oficiais das Forças Armadas e   dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3507-1958-12-27.md"}}, {id:"federal:BR:L:3417/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-07-05", numero:"3417", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-07-05;3417", vigente:true, titulo:"Lei nº 3.417 de 05/07/1958", urn:"urn:lex:br:federal:lei:1958-07-05;3417", ementa:"Retifica o art. 1º da Lei nº 3.367, de 26 de dezembro de 1957, que   concede a pensão especial de Cr$ 5.000,00 mensais a Amália de Carvalho Cunha,   filha do ex-Professor Felisberto de Carvalho.", arquivo:"federal/leis-ordinarias/1958/lei-3417-1958-07-05.md"}}, {id:"federal:BR:L:2706/1877", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1877, data:"1877-05-31", numero:"2706", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1877-05-31;2706", vigente:true, titulo:"Lei nº 2.706 de 31/05/1877", urn:"urn:lex:br:federal:lei:1877-05-31;2706", ementa:"FIXA AS FORÇAS DE TERRA PARA O ANO FINANCEIRO DE 1877-1878.", arquivo:"federal/leis-ordinarias/1877/lei-2706-1877-05-31.md"}}, {id:"federal:BR:L:2718/1877", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1877, data:"1877-06-27", numero:"2718", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1877-06-27;2718", vigente:true, titulo:"Lei nº 2.718 de 27/06/1877", urn:"urn:lex:br:federal:lei:1877-06-27;2718", ementa:"FIXA A FORÇA NAVAL PARA O ANO FINANCEIRO DE 1877 A 1878.", arquivo:"federal/leis-ordinarias/1877/lei-2718-1877-06-27.md"}}, {id:"federal:BR:L:2792/1877", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1877, data:"1877-10-20", numero:"2792", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1877-10-20;2792", vigente:true, titulo:"Lei nº 2.792 de 20/10/1877", urn:"urn:lex:br:federal:lei:1877-10-20;2792", ementa:"FIXA A DESPEZA E ORÇA A RECEITA GERAL DO IMPERIO PARA OS EXERCICIOS DE 1877-1878 E 1878-1879, E DA OUTRAS PROVIDENCIAS.", arquivo:"federal/leis-ordinarias/1877/lei-2792-1877-10-20.md"}}, {id:"federal:BR:L:631/1851", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1851, data:"1851-09-18", numero:"631", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1851-09-18;631", vigente:true, titulo:"Lei nº 631 de 18/09/1851", urn:"urn:lex:br:federal:lei:1851-09-18;631", ementa:"DETERMINA AS PENAS E O PROCESSO PARA ALGUNS CRIMES MILITARES.", arquivo:"federal/leis-ordinarias/1851/lei-631-1851-09-18.md"}}, {id:"federal:BR:L:609/1851", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1851, data:"1851-08-18", numero:"609", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1851-08-18;609", vigente:true, titulo:"Lei nº 609 de 18/08/1851", urn:"urn:lex:br:federal:lei:1851-08-18;609", ementa:"DECLARA O TRIBUNAL, PELO QUAL DEVEM SER PROCESSADOS E JULGADOS OS ARCEBISPOS E BISPOS  DO IMPERIO, NAS CAUSAS QUE NÃO FOREM PURAMENTE ESPIRITUAIS.", arquivo:"federal/leis-ordinarias/1851/lei-609-1851-08-18.md"}}, {id:"federal:BR:L:613/1851", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1851, data:"1851-08-21", numero:"613", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1851-08-21;613", vigente:true, titulo:"Lei nº 613 de 21/08/1851", urn:"urn:lex:br:federal:lei:1851-08-21;613", ementa:"FORÇA NAVAL PARA O ANO FINANCEIRO DE 1852-1853.", arquivo:"federal/leis-ordinarias/1851/lei-613-1851-08-21.md"}}, {id:"federal:BR:L:615/1851", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1851, data:"1851-08-23", numero:"615", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1851-08-23;615", vigente:true, titulo:"Lei nº 615 de 23/08/1851", urn:"urn:lex:br:federal:lei:1851-08-23;615", ementa:"FIXA AS FORÇAS DA TERRA PARA O ANO FINANCEIRO DE 185 - 1853.", arquivo:"federal/leis-ordinarias/1851/lei-615-1851-08-23.md"}}, {id:"federal:BR:L:628/1851", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1851, data:"1851-09-17", numero:"628", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1851-09-17;628", vigente:true, titulo:"Lei nº 628 de 17/09/1851", urn:"urn:lex:br:federal:lei:1851-09-17;628", ementa:"FIXANDO A DESPESA E ORÇANDO A RECEITA PARA O EXERCICIO DE 1852 - 1853.", arquivo:"federal/leis-ordinarias/1851/lei-628-1851-09-17.md"}}, {id:"federal:BR:L:614/1851", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1851, data:"1851-08-22", numero:"614", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1851-08-22;614", titulo:"Lei nº 614 de 22/08/1851", vigente:true, urn:"urn:lex:br:federal:lei:1851-08-22;614", ementa:"ORGANIZA O CORPO DIPLOMATICO BRASILEIRO.", arquivo:"federal/leis-ordinarias/1851/lei-614-1851-08-22.md"}}, {id:"federal:BR:L:627/1851", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1851, data:"1851-09-16", numero:"627", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1851-09-16;627", vigente:true, titulo:"Lei nº 627 de 16/09/1851", urn:"urn:lex:br:federal:lei:1851-09-16;627", ementa:"ABRE UM CREDITO SUPLEMENTAR E EXTRAORDINARIO DE 1.734.310$718, PARA AS DESPESAS DO EXERCICIO DE  1849 -1850 , OUTRO DE 4.591$359.709, PARA AS DO EXERCICIO DE 1850 -1851, E  OUTRO DE 176.143$250 , PARA AS DO EXERCICIO DE 1851 - 1852 .", arquivo:"federal/leis-ordinarias/1851/lei-627-1851-09-16.md"}}, {id:"federal:BR:L:620/1851", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1851, data:"1851-09-02", numero:"620", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1851-09-02;620", vigente:true, titulo:"Lei nº 620 de 02/09/1851", urn:"urn:lex:br:federal:lei:1851-09-02;620", ementa:"FIXA NA QUANTIA 400.000$000 O DOTE DA PRINCESA A SENHORA DONA MARIA AMELIA, E ESTABELECE O MODO DE O REALISAR, LOGO QUE SE VERIFIQUE O SEU CASAMENTO.", arquivo:"federal/leis-ordinarias/1851/lei-620-1851-09-02.md"}}, {id:"federal:BR:L:2842/1914", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1914, data:"1914-01-03", numero:"2842", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1914-01-03;2842", vigente:true, titulo:"Lei nº 2.842 de 03/01/1914", urn:"urn:lex:br:federal:lei:1914-01-03;2842", ementa:"Fixa a Despeza Geral da Republica dos Estados Unidos do Brazil para o exercicio de 1914", arquivo:"federal/leis-ordinarias/1914/lei-2842-1914-01-03.md"}}, {id:"federal:BR:L:2919/1914", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1914, data:"1914-12-31", numero:"2919", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1914-12-31;2919", vigente:true, titulo:"Lei nº 2.919 de 31/12/1914", urn:"urn:lex:br:federal:lei:1914-12-31;2919", ementa:"Orça a Receita Geral da Republica dos Estados Unidos do Brazil para o exercicio de 1915", arquivo:"federal/leis-ordinarias/1914/lei-2919-1914-12-31.md"}}, {id:"federal:BR:L:2918/1914", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1914, data:"1914-12-30", numero:"2918", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1914-12-30;2918", vigente:true, titulo:"Lei nº 2.918 de 30/12/1914", urn:"urn:lex:br:federal:lei:1914-12-30;2918", ementa:"Fixa as forças de terra para o exercicio de 1915", arquivo:"federal/leis-ordinarias/1914/lei-2918-1914-12-30.md"}}, {id:"federal:BR:L:31/1833", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1833, data:"1833-08-26", numero:"31", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1833-08-26;31", vigente:true, titulo:"Lei nº 31 de 26/08/1833", urn:"urn:lex:br:federal:lei:1833-08-26;31", ementa:"FIXA AS FORÇAS NAVAIS ATIVAS ORDINARIAS DO IMPÉRIO, PARA O ANO FINANCEIRO DE 1834-1835.", arquivo:"federal/leis-ordinarias/1833/lei-31-1833-08-26.md"}}, {id:"federal:BR:L:48/1833", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1833, data:"1833-09-03", numero:"48", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1833-09-03;48", vigente:true, titulo:"Lei nº 48 de 03/09/1833", urn:"urn:lex:br:federal:lei:1833-09-03;48", ementa:"FIXA AS FORÇAS DE TERRA ORDINÁRIAS PARA O ANO FINANCEIRO DE 1834-1835.", arquivo:"federal/leis-ordinarias/1833/lei-48-1833-09-03.md"}}, {id:"federal:BR:L:66/1833", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1833, data:"1833-10-12", numero:"66", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1833-10-12;66", vigente:true, titulo:"Lei nº 66 de 12/10/1833", urn:"urn:lex:br:federal:lei:1833-10-12;66", ementa:"DETERMINA O ARRENDAMENTO EM HASTA PÚBLICA DAS FÁBRICAS, TERRENOS E PRÓPRIOS NACIONAIS; AUTORIZA O CONTRATO PARA A ILUMINAÇÃO A GÁS, E SUPRIME OS ORDENADOS DO ESCRIVÃO DO HOSPITAL DE SANTOS E DO CAPELÃO DO COLÉGIO DE S.PAULO, E A DESPESA COM O QUARTEL DO RIO PARDO.", arquivo:"federal/leis-ordinarias/1833/lei-66-1833-10-12.md"}}, {id:"federal:BR:L:53/1833", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1833, data:"1833-10-07", numero:"53", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1833-10-07;53", vigente:true, titulo:"Lei nº 53 de 07/10/1833", urn:"urn:lex:br:federal:lei:1833-10-07;53", ementa:"MARCA O SUBSÍDIO QUE DEVERÃO VENCER OS DEPUTADOS NA PRÓXIMA SEGUINTE LEGISLATURA.", arquivo:"federal/leis-ordinarias/1833/lei-53-1833-10-07.md"}}, {id:"federal:BR:L:23/1833", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1833, data:"1833-08-12", numero:"23", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1833-08-12;23", vigente:true, titulo:"Lei nº 23 de 12/08/1833", urn:"urn:lex:br:federal:lei:1833-08-12;23", ementa:"ORDENA O ESTABELECIMENTO DE DUAS POVOAÇÕES ENTRE O TERMO DA CIDADE DO DESTERRO, E DA VILA DE LAGES.", arquivo:"federal/leis-ordinarias/1833/lei-23-1833-08-12.md"}}, {id:"federal:BR:L:58/1833", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1833, data:"1833-10-08", numero:"58", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1833-10-08;58", vigente:true, titulo:"Lei nº 58 de 08/10/1833", urn:"urn:lex:br:federal:lei:1833-10-08;58", ementa:"ORÇA A RECEITA E FIXA A DESPESA GERAL E PROVINCIAL DO IMPÉRIO PARA O ANO FINANCEIRO DE 1834-1835.", arquivo:"federal/leis-ordinarias/1833/lei-58-1833-10-08.md"}}, {id:"federal:BR:L:62/1833", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1833, data:"1833-10-10", numero:"62", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1833-10-10;62", vigente:true, titulo:"Lei nº 62 de 10/10/1833", urn:"urn:lex:br:federal:lei:1833-10-10;62", ementa:"FIXA O TEMPO DESDE O QUAL SERÃO CONTADOS OS JUROS DA DÍVIDA FLUTUANTE INSCRITA NO GRANDE LIVRO DA DIVIDA PUBLICA; E MANDA INSCREVER NO DITO LIVRO O EMPRÉSTIMO DE QUATROCENTAS MIL LIBRAS ESTERLINAS CONTRAIDO NA PRAÇA DE LONDRES, E REMOVE O COFRE DE DEPÓSITOS PÚBLICOS PARA O TESOURO NACIONAL.", arquivo:"federal/leis-ordinarias/1833/lei-62-1833-10-10.md"}}, {id:"federal:BR:L:46/1833", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1833, data:"1833-08-30", numero:"46", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1833-08-30;46", vigente:true, titulo:"Lei nº 46 de 30/08/1833", urn:"urn:lex:br:federal:lei:1833-08-30;46", ementa:"SUJEITA AS LEIS GERAIS DAS EXECUÇÕES AS FABRICAS DE MINERAÇÃO, E DE AÇUCAR, E LAVOURAS DE CANAS.", arquivo:"federal/leis-ordinarias/1833/lei-46-1833-08-30.md"}}, {id:"federal:BR:L:57/1833", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1833, data:"1833-10-08", numero:"57", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1833-10-08;57", vigente:true, titulo:"Lei nº 57 de 08/10/1833", urn:"urn:lex:br:federal:lei:1833-10-08;57", ementa:"AUTORIZA O GOVERNO A CONCEDER ANISTIA A TODOS OS CRIMES POLÍTICOS, COMETIDOS EM QUAISQUER PROVÍNCIAS DO IMPÉRIO, SEGUNDO PEDIR O BEM DO ESTADO.", arquivo:"federal/leis-ordinarias/1833/lei-57-1833-10-08.md"}}, {id:"federal:BR:L:24/1833", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1833, data:"1833-08-12", numero:"24", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1833-08-12;24", vigente:true, titulo:"Lei nº 24 de 12/08/1833", urn:"urn:lex:br:federal:lei:1833-08-12;24", ementa:"SEPARA DA FAZENDA DE CUBATÃO, EM S.PAULO, O TERRENO DE MEIA LÉGUA EM QUADRA PARA PASTAGEM DOS ANIMAIS QUE TRANSITAM PELA ESTRADA DE SANTOS, E FUNDAÇÃO DE UMA POVOAÇÃO.", arquivo:"federal/leis-ordinarias/1833/lei-24-1833-08-12.md"}}, {id:"federal:BR:L:59/1833", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1833, data:"1833-10-08", numero:"59", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1833-10-08;59", vigente:true, titulo:"Lei nº 59 de 08/10/1833", urn:"urn:lex:br:federal:lei:1833-10-08;59", ementa:"FIXA O NOVO PADRÃO MONETÁRIO; ESTABELECE UM BANCO DE CIRCULAÇÃO E DEPÓSITO; AUTORIZA O GOVERNO A CELEBRAR COM PARTICULARES OU COMPANHIAS CONTRATOS PARA A MINERAÇÃO DOS TERRENOS DA NAÇÃO; ALTERA O IMPOSTO DO SELO E CRIA A TAXA ANUAL DOS ESCRAVOS.", arquivo:"federal/leis-ordinarias/1833/lei-59-1833-10-08.md"}}, {id:"federal:BR:L:52/1833", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1833, data:"1833-10-03", numero:"52", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1833-10-03;52", vigente:true, titulo:"Lei nº 52 de 03/10/1833", urn:"urn:lex:br:federal:lei:1833-10-03;52", ementa:"MANDA SUBSTITUIR A MOEDA DE COBRE EM CIRCULAÇÃO, E ESTABELECE O MODO DE FAZER-SE ESTA OPERAÇÃO.", arquivo:"federal/leis-ordinarias/1833/lei-52-1833-10-03.md"}}, {id:"federal:BR:L:1134/1950", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-06-14", numero:"1134", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-06-14;1134", vigente:true, titulo:"Lei nº 1.134 de 14/06/1950", urn:"urn:lex:br:federal:lei:1950-06-14;1134", ementa:"Faculta representação perante as autoridades administrativas e a justiça ordinária aos associados de classes que especifica.", arquivo:"federal/leis-ordinarias/1950/lei-1134-1950-06-14.md"}}, {id:"federal:BR:L:1236/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-11-15", numero:"1236", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-11-15;1236", vigente:true, titulo:"Lei nº 1.236 de 15/11/1950", urn:"urn:lex:br:federal:lei:1950-11-15;1236", ementa:"Dispõe sôbre o Quadro de Despachantes da Recebedoria Federal de São   Paulo.", arquivo:"federal/leis-ordinarias/1950/lei-1236-1950-11-15.md"}}, {id:"federal:BR:L:1145/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-06-21", numero:"1145", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-06-21;1145", vigente:true, titulo:"Lei nº 1.145 de 21/06/1950", urn:"urn:lex:br:federal:lei:1950-06-21;1145", ementa:"Torna extensivo ao Clube dos Sub-Oficiais e Sargentos da Aeronáutica e à Casa do Sargento do Brasil, benefícios do Decreto-Lei n° 832, de 5 de novembro de 1938.", arquivo:"federal/leis-ordinarias/1950/lei-1145-1950-06-21.md"}}, {id:"federal:BR:L:1093/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-04-30", numero:"1093", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-04-30;1093", vigente:true, tit