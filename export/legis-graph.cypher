/?urn=urn:lex:br:federal:lei:2016-04-15;13271", vigente:true, titulo:"Lei nº 13.271 de 15/04/2016", urn:"urn:lex:br:federal:lei:2016-04-15;13271", ementa:"Dispõe sobre a proibição de revista íntima de funcionárias nos locais de trabalho e trata da revista íntima em ambientes prisionais.", arquivo:"federal/leis-ordinarias/2016/lei-13271-2016-04-15.md"}}, {id:"federal:BR:L:13284/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2016, data:"2016-05-10", numero:"13284", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2016-05-10;13284", vigente:true, titulo:"Lei nº 13.284 de 10/05/2016", urn:"urn:lex:br:federal:lei:2016-05-10;13284", ementa:"Dispõe sobre as medidas relativas aos Jogos Olímpicos e Paraolímpicos de 2016 e aos eventos relacionados, que serão realizados no Brasil; e altera a Lei nº 12.035, de 1º de outubro de 2009, que \"institui o Ato Olímpico, no âmbito da administração pública federal\", e a Lei nº 12.780, de 9 de janeiro de 2013, que \"dispõe sobre medidas tributárias referentes à realização, no Brasil, dos Jogos Olímpicos de 2016 e dos Jogos Paraolímpicos de 2016\".", arquivo:"federal/leis-ordinarias/2016/lei-13284-2016-05-10.md"}}, {id:"federal:BR:L:13281/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2016, data:"2016-05-04", numero:"13281", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2016-05-04;13281", vigente:true, titulo:"Lei nº 13.281 de 04/05/2016", urn:"urn:lex:br:federal:lei:2016-05-04;13281", ementa:"Altera a Lei nº 9.503, de 23 de setembro de 1997 (Código de Trânsito Brasileiro), e a Lei nº 13.146, de 6 de julho de 2015.", arquivo:"federal/leis-ordinarias/2016/lei-13281-2016-05-04.md"}}, {id:"federal:BR:L:13393/2016", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2016, data:"2016-12-20", numero:"13393", fonte: