48-11-04.md"}}, {id:"federal:BR:L:248/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-02-17", numero:"248", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-02-17;248", vigente:true, titulo:"Lei nº 248 de 17/02/1948", urn:"urn:lex:br:federal:lei:1948-02-17;248", ementa:"Autoriza a abertura, pelo Ministério da Viação e Obras Públicas, de   crédito especial para pagamento à concessionária do pôrto de   Santos.", arquivo:"federal/leis-ordinarias/1948/lei-248-1948-02-17.md"}}, {id:"federal:BR:L:327/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-08-13", numero:"327", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-08-13;327", vigente:true, titulo:"Lei nº 327 de 13/08/1948", urn:"urn:lex:br:federal:lei:1948-08-13;327", ementa:"Autoriza a construção de estação de passageiros do aeroporto de   Recife.", arquivo:"federal/leis-ordinarias/1948/lei-327-1948-08-13.md"}}, {id:"federal:BR:L:355/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-08-30", numero:"355", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-08-30;355", vigente:true, titulo:"Lei nº 355 de 30/08/1948", urn:"urn:lex:br:federal:lei:1948-08-30;355", ementa:"Autoriza a abertura, pelo Ministério da Agricultura, de crédito especial   para pagamento de gratificação de magistério e de salário-família, devidos no   exercício de 1947.", arquivo:"federal/leis-ordinarias/1948/lei-355-1948-08-30.md"}}, {id:"federal:BR:L:526/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-12-08", numero:"526", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-12-08;526", vigente:true, titulo:"Lei nº 526 de 08/12/1948", urn:"urn:lex:b