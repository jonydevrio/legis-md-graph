nte:true, titulo:"Lei nº 11.257 de 27/12/2005", urn:"urn:lex:br:federal:lei:2005-12-27;11257", ementa:"Altera o valor da pensão especial concedida a Mário Kozel e Terezinha Lana Kozel pela Lei nº 10.724, de 20 de agosto de 2003.", arquivo:"federal/leis-ordinarias/2005/lei-11257-2005-12-27.md"}}, {id:"federal:BR:L:11167/2005", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2005, data:"2005-08-31", numero:"11167", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2005-08-31;11167", vigente:true, titulo:"Lei nº 11.167 de 31/08/2005", urn:"urn:lex:br:federal:lei:2005-08-31;11167", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério das Relações Exteriores, crédito suplementar no valor de R$ 254.200.000,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2005/lei-11167-2005-08-31.md"}}, {id:"federal:BR:L:11220/2005", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2005, data:"2005-12-21", numero:"11220", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2005-12-21;11220", vigente:true, titulo:"Lei nº 11.220 de 21/12/2005", urn:"urn:lex:br:federal:lei:2005-12-21;11220", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério de Minas e Energia, crédito suplementar no valor de R$ 3.507.265,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2005/lei-11220-2005-12-21.md"}}, {id:"federal:BR:L:11173/2005", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2005, data:"2005-09-06", numero:"11173", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2005-09-06;11173", vigente:true, titulo:"Lei nº 11.173 de 06/09/2005", urn:"urn:lex:br:federal:lei:2005-09-06;11173", ementa:"Transforma as Faculdades Federais Integradas de Diamantina em Universidade Federal dos Vales do Jequitinhonha e Mucuri - UFVJM e dá outras providências.", arquivo:"federal/leis-ordinarias/2005/lei-11173-2005-09-06.md"}}, {id:"federal:BR:L:11186/2005", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2005, data:"2005-10-19", numero:"11186", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2005-10-19;11186", vigente:true, titulo:"Lei nº 11.186 de 19/10/2005", urn:"urn:lex:br:federal:lei:2005-10-19;11186", ementa:"Revoga a Medida Provisória nº 249, de 4 de maio de 2005, que dispõe sobre a instituição de concurso de prognóstico destinado ao desenvolvimento da prática desportiva, a participação de entidades desportivas da modalidade futebol nesse concurso e o parcelamento de débitos tributários e para com o Fundo de Garantia do Tempo de Serviço - FGTS.", arquivo:"federal/leis-ordinarias/2005/lei-11186-2005-10-19.md"}}, {id:"federal:BR:L:11195/2005", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2005, data:"2005-11-18", numero:"11195", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2005-11-18;11195", vigente:true, titulo:"Lei nº 11.195 de 18/11/2005", urn:"urn:lex:br:federal:lei:2005-11-18;11195", ementa:"Dá nova redação ao § 5º do art. 3º da Lei nº 8.948, de 8 de dezembro de 1994.", arquivo:"federal/leis-ordinarias/2005/lei-11195-2005-11-18.md"}}, {id:"federal:BR:L:11135/2005", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2005, data:"2005-07-19", numero:"11135", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2005-07-19;11135", vigente:true, titulo:"Lei nº 11.135 de 19/07/2005", urn:"urn:lex:br:federal:lei:2005-07-19;11135", ementa:"Inscreve o nome de José Bonifácio de Andrada e Silva no Livro dos Heróis da Pátria.", arquivo:"federal/leis-ordinarias/2005/lei-11135-2005-07-19.md"}}, {id:"federal:BR:L:11152/2005", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2005, data:"2005-07-29", numero:"11152", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2005-07-29;11152", vigente:true, titulo:"Lei nº 11.152 de 29/07/2005", urn:"urn:lex:br:federal:lei:2005-07-29;11152", ementa:"Transforma a Faculdade de Medicina do Triângulo Mineiro - FMTM em Universidade Federal do Triângulo Mineiro - UFTM e dá outras providências.", arquivo:"federal/leis-ordinarias/2005/lei-11152-2005-07-29.md"}}, {id:"federal:BR:L:11146/2005", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2005, data:"2005-07-26", numero:"11146", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2005-07-26;11146", vigente:true, titulo:"Lei nº 11.146 de 26/07/2005", urn:"urn:lex:br:federal:lei:2005-07-26;11146", ementa:"Autoriza o Poder Executivo a efetuar contribuições ao Grupo dos 24 (G-24).", arquivo:"federal/leis-ordinarias/2005/lei-11146-2005-07-26.md"}}, {id:"federal:BR:L:11127/2005", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2005, data:"2005-06-28", numero:"11127", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2005-06-28;11127", vigente:true, titulo:"Lei nº 11.127 de 28/06/2005", urn:"urn:lex:br:federal:lei:2005-06-28;11127", ementa:"Altera os arts. 54, 57, 59, 60 e 2.031 da Lei nº 10.406, de 10 de janeiro de 2002, que institui o Código Civil, e o art. 192 da Lei nº 11.101, de 9 de fevereiro de 2005, e dá outras providências.", arquivo:"federal/leis-ordinarias/2005/lei-11127-2005-06-28.md"}}, {id:"federal:BR:L:11200/2005", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2005, data:"2005-11-24", numero:"11200", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2005-11-24;11200", vigente:true, titulo:"Lei nº 11.200 d