", numero:"3285", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1886-08-07;3285", vigente:true, titulo:"Lei nº 3.285 de 07/08/1886", urn:"urn:lex:br:federal:lei:1886-08-07;3285", ementa:"AUMENTA DE 178:010$545 O CREDITO DA VERBA - TELEGRAFOS - DO EXERCICIO DE 1884 - 1885.", arquivo:"federal/leis-ordinarias/1886/lei-3285-1886-08-07.md"}}, {id:"federal:BR:L:3287/1886", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1886, data:"1886-08-14", numero:"3287", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1886-08-14;3287", vigente:true, titulo:"Lei nº 3.287 de 14/08/1886", urn:"urn:lex:br:federal:lei:1886-08-14;3287", ementa:"ABRE AO MINISTÉRIO DOS NEGÓCIOS DA MARINHA O CRÉDITO EXTRAORDINÁRIO DE 50:385$108, PARA ATENDER AS DESPESAS DAS VERBAS - CORPO DA ARMADA - E - COMBUSTÍVEL - DO EXERCICÍO 1883 - 1884.", arquivo:"federal/leis-ordinarias/1886/lei-3287-1886-08-14.md"}}, {id:"federal:BR:L:3311/1886", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1886, data:"1886-10-15", numero:"3311", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1886-10-15;3311", vigente:true, titulo:"Lei nº 3.311 de 15/10/1886", urn:"urn:lex:br:federal:lei:1886-10-15;3311", ementa:"ESTABELECE PENAS PARA OS CRIMES DE DESTRUIÇÃO, DANO, INCÊNDIO E OUTROS.", arquivo:"federal/leis-ordinarias/1886/lei-3311-1886-10-15.md"}}, {id:"federal:BR:L:3314/1886", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1886, data:"1886-10-16", numero:"3314", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1886-10-16;3314", vigente:true, titulo:"Lei nº 3.314 de 16/10/1886", urn:"urn:lex:br:federal:lei:1886-10-16;3314", ementa:"FIXA A DESPESA GERAL DO IMPÉRIO PARA O EXERCÍCIO DE 1886 - 1887 E 2º SEMESTRE DO ANO DE 1887, E DÁ OUTRAS PROVIDÊNCIAS.", arquivo:"federal/leis-ordinarias/1886/lei-3314-1886-10-16.md"}}, {id:"federal:BR:L:3304/1886", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1886, data:"1886-10-08", numero:"3304", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1886-10-08;3304", vigente:true, titulo:"Lei nº 3.304 de 08/10/1886", urn:"urn:lex:br:federal:lei:1886-10-08;3304", ementa:"DÁ AO GOVERNO A FACULDADE DE AUTORIZAR A ILMA, CAMARA MUNICIPAL DA CORTE PARA CONTRAIR O EMPRÉSTIMO DE 125:000$000 A FIM DE OCORRER AO PAGAMENTO DAS OBRAS URGENTES DO EDIFÍCIO DO MATADOURO PÚBLICO DE SANTA CRUZ.", arquivo:"federal/leis-ordinarias/1886/lei-3304-1886-10-08.md"}}, {id:"federal:BR:L:3302/1886", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1886, data:"1886-10-02", numero:"3302", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1886-10-02;3302", vigente:true, titulo:"Lei nº 3.302 de 02/10/1886", urn:"urn:lex:br:federal:lei:1886-10-02;3302", ementa:"FIXA AS FORÇAS DE MAR PARA O ANO FINANCEIRO DE 1887 - 1888.", arquivo:"federal/leis-ordinarias/1886/lei-3302-1886-10-02.md"}}, {id:"federal:BR:L:14571/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-05-05", numero:"14571", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-05-05;14571", vigente:true, titulo:"Lei nº 14.571 de 05/05/2023", urn:"urn:lex:br:federal:lei:2023-05-05;14571", ementa:"Confere o título de Capital Nacional da Criação de Cavalos da Raça Puro-Sangue Inglês ao Município de Bagé, no Estado do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/2023/lei-14571-2023-05-05.md"}}, {id:"federal:BR:L:14546/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-04-04", numero:"14546", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-04-04;14546", vigente:true, titulo:"Lei nº 14.546 de 04/04/2023", urn:"urn:lex:br:federal:lei:2023-04-04;14546", ementa:"Altera a Lei nº 11.445, de 5 de janeiro de 2007 (Lei de Saneamento Básico), para estabelecer medidas de prevenção a desperdícios, de aproveitamento das águas de chuva e de reúso não potável das águas cinzas.", arquivo:"federal/leis-ordinarias/2023/lei-14546-2023-04-04.md"}}, {id:"federal:BR:L:14560/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-04-26", numero:"14560", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-04-26;14560", vigente:true, titulo:"Lei nº 14.560 de 26/04/2023", urn:"urn:lex:br:federal:lei:2023-04-26;14560", ementa:"Altera a Lei nº 9.394, de 20 de dezembro de 1996 (Lei de Diretrizes e Bases da Educação Nacional), para inserir, como despesa de manutenção e desenvolvimento do ensino, aquela realizada com atividades curriculares complementares.", arquivo:"federal/leis-ordinarias/2023/lei-14560-2023-04-26.md"}}, {id:"federal:BR:L:14678/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-09-18", numero:"14678", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-09-18;14678", vigente:true, titulo:"Lei nº 14.678 de 18/09/2023", urn:"urn:lex:br:federal:lei:2023-09-18;14678", ementa:"Institui a Semana do Migrante e do Refugiado.", arquivo:"federal/leis-ordinarias/2023/lei-14678-2023-09-18.md"}}, {id:"federal:BR:L:14643/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-08-02", numero:"14643", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-08-02;14643", vigente:true, titulo:"Lei nº 14.643 de 02/08/2023", urn:"urn:lex:br:federal:lei:2023-08-02;14643", ementa:"Autoriza o Poder Executivo a implantar serviço de monitoramento de ocorrências de violência escolar.", arquivo:"federal/leis-ordinarias/2023/lei-14643-2023-08-02.md"}}, {id:"federal:BR:L:14764/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-21", numero:"14764", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-21;14764", vigente:true, titulo:"Lei nº 14.764 de 21/12/2023", urn:"urn:lex:br:federal:lei:2023-12-21;14764", ementa:"Abre ao Orçamento Fiscal da União, em favor das Justiças Federal, Eleitoral e do Trabalho, crédito especial no valor de R$ 50.785.329,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2023/lei-14764-2023-12-21.md"}}, {id:"federal:BR:L:14708/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-10-25", numero:"14708", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-10-25;14708", vigente:true, titulo:"Lei nº 14.708 de 25/10/2023", urn:"urn:lex:br:federal:lei:2023-10-25;14708", ementa:"Abre ao Orçamento de Investimento da União, em favor da Companhia Docas do Rio de Janeiro, crédito suplementar no valor de R$ 26.050.043,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2023/lei-14708-2023-10-25.md"}}, {id:"federal:BR:L:14630/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-25", numero:"14630", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-25;14630", vigente:true, titulo:"Lei nº 14.630 de 25/07/2023", urn:"urn:lex:br:federal:lei:2023-07-25;14630", ementa:"Abre ao Orçamento Fiscal da União, em favor da Justiça Federal e do Ministério Público da União, crédito suplementar no valor de R$ 5.381.500,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2023/lei-14630-2023-07-25.md"}}, {id:"federal:BR:L:14538/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-03-31", numero:"14538", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-03-31;14538", vigente:true, titulo:"Lei nº 14.538 de 31/03/2023", urn:"urn:lex:br:federal:lei:2023-03-31;14538", ementa:"Altera as Leis nºs 9.656, de 3 de junho de 1998, e 9.797, de 6 de maio de 1999, para assegurar às pacientes a substituição do implante mamário utilizado na reconstrução mamária ou na simetrização da mama contralateral sempre que ocorrerem complicações ou efeitos adversos a ele relacionados, bem como assegurar às pacientes acompanhamento psicológico e multidisciplinar especializado na hipótese que especifica.", arquivo:"federal/leis-ordinarias/2023/lei-14538-2023-03-31.md"}}, {id:"federal:BR:L:14609/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-06-20", numero:"14609", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-06-20;14609", vigente:true, titulo:"Lei nº 14.609 de 20/06/2023", urn:"urn:lex:br:federal:lei:2023-06-20;14609", ementa:"Institui o Dia Nacional do Plantio Direto.", arquivo:"federal/leis-ordinarias/2023/lei-14609-2023-06-20.md"}}, {id:"federal:BR:L:14599/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-06-19", numero:"14599", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-06-19;14599", vigente:true, titulo:"Lei nº 14.599 de 19/06/2023", urn:"urn:lex:br:federal:lei:2023-06-19;14599", ementa:"Posterga a exigência do exame toxicológico periódico para obtenção e renovação da Carteira Nacional de Habilitação; e altera a Lei nº 9.503, de 23 de setembro de 1997 (Código de Trânsito Brasileiro), a Lei nº 11.442, de 5 de janeiro de 2007, para dispor sobre seguro de cargas, e a Lei nº 11.539, de 8 de novembro de 2007, para dispor sobre a carreira de Analista de Infraestrutura e o cargo isolado de Especialista em Infraestrutura Sênior.", arquivo:"federal/leis-ordinarias/2023/lei-14599-2023-06-19.md"}}, {id:"federal:BR:L:14575/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-05-10", numero:"14575", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-05-10;14575", vigente:true, titulo:"Lei nº 14.575 de 10/05/2023", urn:"urn:lex:br:federal:lei:2023-05-10;14575", ementa:"Inscreve o nome de Adhemar Ferreira da Silva no Livro dos Heróis e Heroínas da Pátria.", arquivo:"federal/leis-ordinarias/2023/lei-14575-2023-05-10.md"}}, {id:"federal:BR:L:14601/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-06-19", numero:"14601", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-06-19;14601", vigente:true, titulo:"Lei nº 14.601 de 19/06/2023", urn:"urn:lex:br:federal:lei:2023-06-19;14601", ementa:"Institui o Programa Bolsa Família; altera a Lei nº 8.742, de 7 de dezembro de 1993 (Lei Orgânica da Assistência Social), a Lei nº 10.820, de 17 de dezembro de 2003, que dispõe sobre a autorização para desconto em folha de pagamento, e a Lei nº 10.779, de 25 de novembro de 2003; e revoga dispositivos das Leis nºs 14.284, de 29 de dezembro de 2021, e 14.342, de 18 de maio de 2022, e a Medida Provisória nº 1.155, de 1º de janeiro de 2023.", arquivo:"federal/leis-ordinarias/2023/lei-14601-2023-06-19.md"}}, {id:"federal:BR:L:14725/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-11-16", numero:"14725", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-11-16;14725", vigente:true, titulo:"Lei nº 14.725 de 16/11/2023", urn:"urn:lex:br:federal:lei:2023-11-16;14725", ementa:"Regula a profissão de sanitarista.", arquivo:"federal/leis-ordinarias/2023/lei-14725-2023-11-16.md"}}, {id:"federal:BR:L:14526/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-01-09", numero:"14526", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-01-09;14526", vigente:true, titulo:"Lei nº 14.526 de 09/01/2023", urn:"urn:lex:br:federal:lei:2023-01-09;14526", ementa:"Altera a Lei nº 12.300, de 28 de julho de 2010, para reajustar as Tabelas de Vencimentos Básicos dos Servidores Ocupantes de Cargo Efetivo do Quadro de Pessoal do Senado Federal.", arquivo:"federal/leis-ordinarias/2023/lei-14526-2023-01-09.md"}}, {id:"federal:BR:L:14610/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-06-28", numero:"14610", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-06-28;14610", vigente:true, titulo:"Lei nº 14.610 de 28/06/2023", urn:"urn:lex:br:federal:lei:2023-06-28;14610", ementa:"Inscreve no Livro dos Heróis e Heroínas da Pátria o nome do Brigadeiro Antônio Tibúrcio Ferreira de Souza.", arquivo:"federal/leis-ordinarias/2023/lei-14610-2023-06-28.md"}}, {id:"federal:BR:L:14739/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-11-28", numero:"14739", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-11-28;14739", vigente:true, titulo:"Lei nº 14.739 de 28/11/2023", urn:"urn:lex:br:federal:lei:2023-11-28;14739", ementa:"Denomina Viaduto Francisco Pereira Netto o viaduto situado sobre a rodovia BR-116, nas proximidades do km 117, no bairro Campo de Santana, no Município de Curitiba, Estado do Paraná.", arquivo:"federal/leis-ordinarias/2023/lei-14739-2023-11-28.md"}}, {id:"federal:BR:L:14666/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-09-04", numero:"14666", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-09-04;14666", vigente:true, titulo:"Lei nº 14.666 de 04/09/2023", urn:"urn:lex:br:federal:lei:2023-09-04;14666", ementa:"Institui a Política Nacional de Estímulo ao Empreendedorismo do Jovem do Campo (PNEEJC) e define seus princípios, objetivos e ações.", arquivo:"federal/leis-ordinarias/2023/lei-14666-2023-09-04.md"}}, {id:"federal:BR:L:14657/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-08-23", numero:"14657", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-08-23;14657", vigente:true, titulo:"Lei nº 14.657 de 23/08/2023", urn:"urn:lex:br:federal:lei:2023-08-23;14657", ementa:"Altera a Consolidação das Leis do Trabalho (CLT), aprovada pelo Decreto-Lei nº 5.452, de 1º de maio de 1943, para permitir que as partes e os advogados se retirem em caso de atraso injustificado do início de audiência.", arquivo:"federal/leis-ordinarias/2023/lei-14657-2023-08-23.md"}}, {id:"federal:BR:L:14638/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-25", numero:"14638", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-25;14638", vigente:true, titulo:"Lei nº 14.638 de 25/07/2023", urn:"urn:lex:br:federal:lei:2023-07-25;14638", ementa:"Confere ao Município de Canguçu, no Estado do Rio Grande do Sul, o título de Capital Nacional da Agricultura Familiar.", arquivo:"federal/leis-ordinarias/2023/lei-14638-2023-07-25.md"}}, {id:"federal:BR:L:14686/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-09-20", numero:"14686", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-09-20;14686", vigente:true, titulo:"Lei nº 14.686 de 20/09/2023", urn:"urn:lex:br:federal:lei:2023-09-20;14686", ementa:"Denomina Rodovia Senador Eliseu Resende o trecho da rodovia BR-262 localizado no Estado de Minas Gerais, entre as divisas dos Estados do Espírito Santo e de São Paulo.", arquivo:"federal/leis-ordinarias/2023/lei-14686-2023-09-20.md"}}, {id:"federal:BR:L:14629/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-25", numero:"14629", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-25;14629", vigente:true, titulo:"Lei nº 14.629 de 25/07/2023", urn:"urn:lex:br:federal:lei:2023-07-25;14629", ementa:"Abre ao Orçamento Fiscal da União, em favor das Justiças Eleitoral e do Trabalho, crédito especial no valor de R$ 807.900,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2023/lei-14629-2023-07-25.md"}}, {id:"federal:BR:L:14534/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-01-11", numero:"14534", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-01-11;14534", vigente:true, titulo:"Lei nº 14.534 de 11/01/2023", urn:"urn:lex:br:federal:lei:2023-01-11;14534", ementa:"Altera as Leis nºs 7.116, de 29 de agosto de 1983, 9.454, de 7 de abril de 1997, 13.444, de 11 de maio de 2017, e 13.460, de 26 de junho de 2017, para adotar número único para os documentos que especifica e para estabelecer o Cadastro de Pessoas Físicas (CPF) como número suficiente para identificação do cidadão nos bancos de dados de serviços públicos.", arquivo:"federal/leis-ordinarias/2023/lei-14534-2023-01-11.md"}}, {id:"federal:BR:L:14674/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-09-14", numero:"14674", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-09-14;14674", vigente:true, titulo:"Lei nº 14.674 de 14/09/2023", urn:"urn:lex:br:federal:lei:2023-09-14;14674", ementa:"Altera a Lei nº 11.340, de 7 de agosto de 2006 (Lei Maria da Penha), para dispor sobre auxílio-aluguel a ser concedido pelo juiz em decorrência de situação de vulnerabilidade social e econômica da ofendida afastada do lar.", arquivo:"federal/leis-ordinarias/2023/lei-14674-2023-09-14.md"}}, {id:"federal:BR:L:14668/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-09-11", numero:"14668", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-09-11;14668", vigente:true, titulo:"Lei nº 14.668 de 11/09/2023", urn:"urn:lex:br:federal:lei:2023-09-11;14668", ementa:"Concede ao Município de São Luís, capital do Estado do Maranhão, o título de Capital Nacional do Reggae.", arquivo:"federal/leis-ordinarias/2023/lei-14668-2023-09-11.md"}}, {id:"federal:BR:L:14596/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-06-14", numero:"14596", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-06-14;14596", vigente:true, titulo:"Lei nº 14.596 de 14/06/2023", urn:"urn:lex:br:federal:lei:2023-06-14;14596", ementa:"Dispõe sobre regras de preços de transferência relativas ao Imposto sobre a Renda das Pessoas Jurídicas (IRPJ) e à Contribuição Social sobre o Lucro Líquido (CSLL); altera as Leis nºs 9.430, de 27 de dezembro de 1996, 12.973, de 13 de maio de 2014, e 12.249, de 11 de junho de 2010; e revoga dispositivos das Leis nºs 3.470, de 28 de novembro de 1958, 4.131, de 3 de setembro de 1962, 4.506, de 30 de novembro de 1964, 8.383, de 30 de dezembro de 1991, 10.637, de 30 de dezembro de 2002, 10.833, de 2", arquivo:"federal/leis-ordinarias/2023/lei-14596-2023-06-14.md"}}, {id:"federal:BR:L:14775/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-27", numero:"14775", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-27;14775", vigente:true, titulo:"Lei nº 14.775 de 27/12/2023", urn:"urn:lex:br:federal:lei:2023-12-27;14775", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor da Presidência da República e dos Ministérios da Educação, da Saúde e das Comunicações, crédito especial no valor de R$ 387.140,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2023/lei-14775-2023-12-27.md"}}, {id:"federal:BR:L:14626/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-19", numero:"14626", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-19;14626", vigente:true, titulo:"Lei nº 14.626 de 19/07/2023", urn:"urn:lex:br:federal:lei:2023-07-19;14626", ementa:"Altera a Lei nº 10.048, de 8 de novembro de 2000, e a Lei nº 10.205, de 21 de março de 2001, para prever atendimento prioritário a pessoas com transtorno do espectro autista ou com mobilidade reduzida e a doadores de sangue e reserva de assento em veículos de empresas públicas de transporte e de concessionárias de transporte coletivo nos dois primeiros casos.", arquivo:"federal/leis-ordinarias/2023/lei-14626-2023-07-19.md"}}, {id:"federal:BR:L:14791/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-29", numero:"14791", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-29;14791", vigente:true, titulo:"Lei nº 14.791 de 29/12/2023", urn:"urn:lex:br:federal:lei:2023-12-29;14791", ementa:"Dispõe sobre as diretrizes para a elaboração e a execução da Lei Orçamentária de 2024 e dá outras providências.", arquivo:"federal/leis-ordinarias/2023/lei-14791-2023-12-29.md"}}, {id:"federal:BR:L:14713/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-10-30", numero:"14713", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-10-30;14713", vigente:true, titulo:"Lei nº 14.713 de 30/10/2023", urn:"urn:lex:br:federal:lei:2023-10-30;14713", ementa:"Altera as Leis nºs 10.406, de 10 de janeiro de 2002 (Código Civil), 13.105, de 16 de março de 2015 (Código de Processo Civil), para estabelecer o risco de violência doméstica ou familiar como causa impeditiva ao exercício da guarda compartilhada, bem como para impor ao juiz o dever de indagar previamente o Ministério Público e as partes sobre situações de violência doméstica ou familiar que envolvam o casal ou os filhos.", arquivo:"federal/leis-ordinarias/2023/lei-14713-2023-10-30.md"}}, {id:"federal:BR:L:14531/2023", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-01-10", numero:"14531", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-01-10;14531", vigente:true, titulo:"Lei nº 14.531 de 10/01/2023", urn:"urn:lex:br:federal:lei:2023-01-10;14531", ementa:"Altera as Leis nºs 13.675, de 11 de junho de 2018, que cria a Política Nacional de Segurança Pública e Defesa Social (PNSPDS), e 13.819, de 26 de abril de 2019, que institui a Política Nacional de Prevenção da Automutilação e do Suicídio, para dispor sobre a implementação de ações de assistência social, a promoção da saúde mental e a prevenção do suicídio entre profissionais de segurança pública e defesa social e para instituir as diretrizes nacionais de promoção e defesa dos direitos humanos do", arquivo:"federal/leis-ordinarias/2023/lei-14531-2023-01-10.md"}}, {id:"federal:BR:L:14701/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-10-20", numero:"14701", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-10-20;14701", vigente:true, titulo:"Lei nº 14.701 de 20/10/2023", urn:"urn:lex:br:federal:lei:2023-10-20;14701", ementa:"Regulamenta o art. 231 da Constituição Federal, para dispor sobre o reconhecimento, a demarcação, o uso e a gestão de terras indígenas; e altera as Leis nºs 11.460, de 21 de março de 2007, 4.132, de 10 de setembro de 1962, e 6.001, de 19 de dezembro de 1973.", arquivo:"federal/leis-ordinarias/2023/lei-14701-2023-10-20.md"}}, {id:"federal:BR:L:14780/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-27", numero:"14780", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-27;14780", vigente:true, titulo:"Lei nº 14.780 de 27/12/2023", urn:"urn:lex:br:federal:lei:2023-12-27;14780", ementa:"Abre ao Orçamento de Investimento da União, em favor da Autoridade Portuária de Santos S.A., da Companhia Docas do Rio de Janeiro e da Empresa Brasileira de Infraestrutura Aeroportuária, crédito especial no valor de R$ 70.917.827,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2023/lei-14780-2023-12-27.md"}}, {id:"federal:BR:L:14582/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-05-16", numero:"14582", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-05-16;14582", vigente:true, titulo:"Lei nº 14.582 de 16/05/2023", urn:"urn:lex:br:federal:lei:2023-05-16;14582", ementa:"Dispõe sobre a criação de cargos de provimento efetivo e de cargos em comissão no Quadro de Pessoal do Tribunal Superior do Trabalho e dá outras providências.", arquivo:"federal/leis-ordinarias/2023/lei-14582-2023-05-16.md"}}, {id:"federal:BR:L:14634/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-25", numero:"14634", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-25;14634", vigente:true, titulo:"Lei nº 14.634 de 25/07/2023", urn:"urn:lex:br:federal:lei:2023-07-25;14634", ementa:"Abre ao Orçamento Fiscal da União, em favor dos Ministérios da Educação, da Justiça e Segurança Pública, dos Transportes, e de Portos e Aeroportos, e de Transferências a Estados, Distrito Federal e Municípios, crédito especial no valor de R$ 3.136.572.032,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2023/lei-14634-2023-07-25.md"}}, {id:"federal:BR:L:14567/2023", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-05-04", numero:"14567", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-05-04;14567", vigente:true, titulo:"Lei nº 14.567 de 04/05/2023", urn:"urn:lex:br:federal:lei:2023-05-04;14567", ementa:"Reconhece as escolas de samba como manifestação da cultura nacional.", arquivo:"federal/leis-ordinarias/2023/lei-14567-2023-05-04.md"}}, {id:"federal:BR:L:14653/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-08-23", numero:"14653", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-08-23;14653", vigente:true, titulo:"Lei nº 14.653 de 23/08/2023", urn:"urn:lex:br:federal:lei:2023-08-23;14653", ementa:"Altera as Leis nºs 12.651, de 25 de maio de 2012, e 14.119, de 13 de janeiro de 2021, para disciplinar a intervenção e a implantação de instalações necessárias à recuperação e à proteção de nascentes.", arquivo:"federal/leis-ordinarias/2023/lei-14653-2023-08-23.md"}}, {id:"federal:BR:L:14556/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-04-25", numero:"14556", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-04-25;14556", vigente:true, titulo:"Lei nº 14.556 de 25/04/2023", urn:"urn:lex:br:federal:lei:2023-04-25;14556", ementa:"Institui a campanha Janeiro Branco, dedicada à promoção da saúde mental.", arquivo:"federal/leis-ordinarias/2023/lei-14556-2023-04-25.md"}}, {id:"federal:BR:L:14748/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-05", numero:"14748", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-05;14748", vigente:true, titulo:"Lei nº 14.748 de 05/12/2023", urn:"urn:lex:br:federal:lei:2023-12-05;14748", ementa:"Altera a Lei nº 12.587, de 3 de janeiro de 2012, a fim de dispor sobre o prazo para a elaboração do Plano de Mobilidade Urbana pelos Municípios.", arquivo:"federal/leis-ordinarias/2023/lei-14748-2023-12-05.md"}}, {id:"federal:BR:L:14591/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-05-25", numero:"14591", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-05-25;14591", vigente:true, titulo:"Lei nº 14.591 de 25/05/2023", urn:"urn:lex:br:federal:lei:2023-05-25;14591", ementa:"Dispõe sobre a transformação de cargos de Analista do Ministério Público da União em cargos de Procurador da Justiça Militar, em cargos de Promotor da Justiça Militar e em cargos em comissão que especifica, no âmbito do Ministério Público Militar; e altera a Lei nº 13.316, de 20 de julho de 2016.", arquivo:"federal/leis-ordinarias/2023/lei-14591-2023-05-25.md"}}, {id:"federal:BR:L:14772/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-26", numero:"14772", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-26;14772", vigente:true, titulo:"Lei nº 14.772 de 26/12/2023", urn:"urn:lex:br:federal:lei:2023-12-26;14772", ementa:"Abre ao Orçamento de Investimento da União, em favor da Autoridade Portuária de Santos S.A. e da Agência Brasileira Gestora de Fundos Garantidores e Garantias S.A., crédito suplementar no valor de R$ 19.519.660,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2023/lei-14772-2023-12-26.md"}}, {id:"federal:BR:L:14682/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-09-20", numero:"14682", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-09-20;14682", titulo:"Lei nº 14.682 de 20/09/2023", vigente:true, urn:"urn:lex:br:federal:lei:2023-09-20;14682", ementa:"Cria o selo Empresa Amiga da Mulher.", arquivo:"federal/leis-ordinarias/2023/lei-14682-2023-09-20.md"}}, {id:"federal:BR:L:14616/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-07", numero:"14616", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-07;14616", vigente:true, titulo:"Lei nº 14.616 de 07/07/2023", urn:"urn:lex:br:federal:lei:2023-07-07;14616", ementa:"Institui o Dia Nacional da Força Jovem Universal.", arquivo:"federal/leis-ordinarias/2023/lei-14616-2023-07-07.md"}}, {id:"federal:BR:L:14756/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-15", numero:"14756", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-15;14756", vigente:true, titulo:"Lei nº 14.756 de 15/12/2023", urn:"urn:lex:br:federal:lei:2023-12-15;14756", ementa:"Dispõe sobre emolumentos dos serviços notariais e de registros públicos no âmbito do Distrito Federal e dos Territórios; revoga disposições do Decreto-Lei nº 115, de 25 de janeiro de 1967; e dá outras providências.", arquivo:"federal/leis-ordinarias/2023/lei-14756-2023-12-15.md"}}, {id:"federal:BR:L:14767/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-22", numero:"14767", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-22;14767", vigente:true, titulo:"Lei nº 14.767 de 22/12/2023", urn:"urn:lex:br:federal:lei:2023-12-22;14767", ementa:"Altera a Lei nº 9.394, de 20 de dezembro de 1996, que \"estabelece as diretrizes e bases da educação nacional\", para possibilitar o uso da pedagogia da alternância nas escolas do campo.", arquivo:"federal/leis-ordinarias/2023/lei-14767-2023-12-22.md"}}, {id:"federal:BR:L:14624/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-17", numero:"14624", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-17;14624", vigente:true, titulo:"Lei nº 14.624 de 17/07/2023", urn:"urn:lex:br:federal:lei:2023-07-17;14624", ementa:"Altera a Lei nº 13.146, de 6 de julho de 2015 (Estatuto da Pessoa com Deficiência), para instituir o uso do cordão de fita com desenhos de girassóis para a identificação de pessoas com deficiências ocultas.", arquivo:"federal/leis-ordinarias/2023/lei-14624-2023-07-17.md"}}, {id:"federal:BR:L:14579/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-05-10", numero:"14579", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-05-10;14579", vigente:true, titulo:"Lei nº 14.579 de 10/05/2023", urn:"urn:lex:br:federal:lei:2023-05-10;14579", ementa:"Institui o Dia Nacional do Desporto Escolar.", arquivo:"federal/leis-ordinarias/2023/lei-14579-2023-05-10.md"}}, {id:"federal:BR:L:14759/2023", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-21", numero:"14759", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-21;14759", vigente:true, titulo:"Lei nº 14.759 de 21/12/2023", urn:"urn:lex:br:federal:lei:2023-12-21;14759", ementa:"Declara feriado nacional o Dia Nacional de Zumbi e da Consciência Negra.", arquivo:"federal/leis-ordinarias/2023/lei-14759-2023-12-21.md"}}, {id:"federal:BR:L:14572/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-05-08", numero:"14572", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-05-08;14572", vigente:true, titulo:"Lei nº 14.572 de 08/05/2023", urn:"urn:lex:br:federal:lei:2023-05-08;14572", ementa:"Institui a Política Nacional de Saúde Bucal no âmbito do Sistema Único de Saúde (SUS) e altera a Lei nº 8.080, de 19 de setembro de 1990, para incluir a saúde bucal no campo de atuação do SUS.", arquivo:"federal/leis-ordinarias/2023/lei-14572-2023-05-08.md"}}, {id:"federal:BR:L:14537/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-02-28", numero:"14537", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-02-28;14537", vigente:true, titulo:"Lei nº 14.537 de 28/02/2023", urn:"urn:lex:br:federal:lei:2023-02-28;14537", ementa:"Altera a Lei nº 12.249, de 11 de junho de 2010, para dispor sobre a alíquota do imposto sobre a renda retido na fonte incidente sobre as operações a que se refere; e revoga dispositivos das Leis nºs 12.810, de 15 de maio de 2013, 12.844, de 19 de julho de 2013, e 13.315, de 20 de julho de 2016.", arquivo:"federal/leis-ordinarias/2023/lei-14537-2023-02-28.md"}}, {id:"federal:BR:L:14620/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-13", numero:"14620", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-13;14620", vigente:true, titulo:"Lei nº 14.620 de 13/07/2023", urn:"urn:lex:br:federal:lei:2023-07-13;14620", ementa:"Dispõe sobre o Programa Minha Casa, Minha Vida, altera o Decreto-Lei nº 3.365, de 21 de junho de 1941 (Lei da Desapropriação), a Lei nº 4.591, de 16 de dezembro de 1964, a Lei nº 6.015, de 31 de dezembro de 1973 (Lei dos Registros Públicos), a Lei nº 6.766, de 19 de dezembro de 1979, a Lei nº 8.036, de 11 de maio de 1990 (Lei do FGTS), a Lei nº 8.677, de 13 de julho de 1993, a Lei nº 9.472, de 16 de julho de 1997, a Lei nº 9.514, de 20 de novembro de 1997, a Lei nº 10.188, de 12 de fevereiro de ", arquivo:"federal/leis-ordinarias/2023/lei-14620-2023-07-13.md"}}, {id:"federal:BR:L:14553/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-04-20", numero:"14553", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-04-20;14553", vigente:true, titulo:"Lei nº 14.553 de 20/04/2023", urn:"urn:lex:br:federal:lei:2023-04-20;14553", ementa:"Altera os arts. 39 e 49 da Lei nº 12.288, de 20 de julho de 2010 (Estatuto da Igualdade Racial), para determinar procedimentos e critérios de coleta de informações relativas à distribuição dos segmentos étnicos e raciais no mercado de trabalho.", arquivo:"federal/leis-ordinarias/2023/lei-14553-2023-04-20.md"}}, {id:"federal:BR:L:14518/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-01-04", numero:"14518", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-01-04;14518", vigente:true, titulo:"Lei nº 14.518 de 04/01/2023", urn:"urn:lex:br:federal:lei:2023-01-04;14518", ementa:"Inscreve o nome de Antonieta de Barros no Livro dos Heróis e Heroínas da Pátria.", arquivo:"federal/leis-ordinarias/2023/lei-14518-2023-01-04.md"}}, {id:"federal:BR:L:14543/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-04-03", numero:"14543", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-04-03;14543", vigente:true, titulo:"Lei nº 14.543 de 03/04/2023", urn:"urn:lex:br:federal:lei:2023-04-03;14543", ementa:"Institui a Semana Nacional de Conscientização sobre a Depressão, a ser celebrada anualmente na semana que compreender o dia 10 de outubro.", arquivo:"federal/leis-ordinarias/2023/lei-14543-2023-04-03.md"}}, {id:"federal:BR:L:14732/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-11-23", numero:"14732", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-11-23;14732", vigente:true, titulo:"Lei nº 14.732 de 23/11/2023", urn:"urn:lex:br:federal:lei:2023-11-23;14732", ementa:"Declara Patrono do Agricultor Familiar Brasileiro o Frei Egídio Maria Moscini.", arquivo:"federal/leis-ordinarias/2023/lei-14732-2023-11-23.md"}}, {id:"federal:BR:L:14690/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-10-03", numero:"14690", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-10-03;14690", vigente:true, titulo:"Lei nº 14.690 de 03/10/2023", urn:"urn:lex:br:federal:lei:2023-10-03;14690", ementa:"Institui o Programa Emergencial de Renegociação de Dívidas de Pessoas Físicas Inadimplentes - Desenrola Brasil; estabelece normas para facilitação de acesso a crédito e mitigação de riscos de inadimplemento e de superendividamento de pessoas físicas; altera a Consolidação das Leis do Trabalho, aprovada pelo Decreto-Lei nº 5.452, de 1º de maio de 1943, e as Leis nºs 10.406, de 10 de janeiro de 2002 (Código Civil), 10.522, de 19 de julho de 2002 e 12.087, de 11 de novembro de 2009; e revoga dispos", arquivo:"federal/leis-ordinarias/2023/lei-14690-2023-10-03.md"}}, {id:"federal:BR:L:14718/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-11-01", numero:"14718", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-11-01;14718", vigente:true, titulo:"Lei nº 14.718 de 01/11/2023", urn:"urn:lex:br:federal:lei:2023-11-01;14718", ementa:"Erige em monumento nacional a Rota do Café.", arquivo:"federal/leis-ordinarias/2023/lei-14718-2023-11-01.md"}}, {id:"federal:BR:L:14743/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-11-30", numero:"14743", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-11-30;14743", vigente:true, titulo:"Lei nº 14.743 de 30/11/2023", urn:"urn:lex:br:federal:lei:2023-11-30;14743", ementa:"Inscreve o nome de Dulcina de Moraes no Livro dos Heróis e Heroínas da Pátria.", arquivo:"federal/leis-ordinarias/2023/lei-14743-2023-11-30.md"}}, {id:"federal:BR:L:14522/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-01-09", numero:"14522", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-01-09;14522", vigente:true, titulo:"Lei nº 14.522 de 09/01/2023", urn:"urn:lex:br:federal:lei:2023-01-09;14522", ementa:"Fixa o subsídio do Defensor Público-Geral Federal; estabelece o percentual de escalonamento de que trata o inciso V do caput do art. 93 da Constituição Federal para os membros da Defensoria Pública da União; e revoga dispositivos e anexos da Lei nº 13.412, de 29 de dezembro de 2016.", arquivo:"federal/leis-ordinarias/2023/lei-14522-2023-01-09.md"}}, {id:"federal:BR:L:14588/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-05-18", numero:"14588", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-05-18;14588", vigente:true, titulo:"Lei nº 14.588 de 18/05/2023", urn:"urn:lex:br:federal:lei:2023-05-18;14588", ementa:"Institui a Semana Nacional de Conscientização sobre Hemangiomas e Anomalias Vasculares.", arquivo:"federal/leis-ordinarias/2023/lei-14588-2023-05-18.md"}}, {id:"federal:BR:L:14751/2023", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-12", numero:"14751", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-12;14751", vigente:true, titulo:"Lei nº 14.751 de 12/12/2023", urn:"urn:lex:br:federal:lei:2023-12-12;14751", ementa:"Institui a Lei Orgânica Nacional das Polícias Militares e dos Corpos de Bombeiros Militares dos Estados, do Distrito Federal e dos Territórios, nos termos do inciso XXI do caput do art. 22 da Constituição Federal, altera a Lei nº 13.675, de 11 de junho de 2018, e revoga dispositivos do Decreto-Lei nº 667, de 2 de julho de 1969.", arquivo:"federal/leis-ordinarias/2023/lei-14751-2023-12-12.md"}}, {id:"federal:BR:L:14704/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-10-25", numero:"14704", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-10-25;14704", vigente:true, titulo:"Lei nº 14.704 de 25/10/2023", urn:"urn:lex:br:federal:lei:2023-10-25;14704", ementa:"Altera a Lei nº 12.319, de 1º de setembro de 2010, para dispor sobre o exercício profissional e as condições de trabalho do profissional tradutor, intérprete e guia-intérprete da Língua Brasileira de Sinais (Libras).", arquivo:"federal/leis-ordinarias/2023/lei-14704-2023-10-25.md"}}, {id:"federal:BR:L:14787/2023", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-28", numero:"14787", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-28;14787", vigente:true, titulo:"Lei nº 14.787 de 28/12/2023", urn:"urn:lex:br:federal:lei:2023-12-28;14787", ementa:"Altera a Lei nº 11.033, de 21 de dezembro de 2004, para prorrogar o Regime Tributário para Incentivo à Modernização e à Ampliação da Estrutura Portuária (Reporto).", arquivo:"federal/leis-ordinarias/2023/lei-14787-2023-12-28.md"}}, {id:"federal:BR:L:14612/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-03", numero:"14612", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-03;14612", vigente:true, titulo:"Lei nº 14.612 de 03/07/2023", urn:"urn:lex:br:federal:lei:2023-07-03;14612", ementa:"Altera a Lei nº 8.906, de 4 de julho de 1994 (Estatuto da Advocacia), para incluir o assédio moral, o assédio sexual e a discriminação entre as infrações ético-disciplinares no âmbito da Ordem dos Advogados do Brasil.", arquivo:"federal/leis-ordinarias/2023/lei-14612-2023-07-03.md"}}, {id:"federal:BR:L:14605/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-06-20", numero:"14605", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-06-20;14605", vigente:true, titulo:"Lei nº 14.605 de 20/06/2023", urn:"urn:lex:br:federal:lei:2023-06-20;14605", ementa:"Institui o Dia Nacional da Pessoa com Surdocegueira.", arquivo:"federal/leis-ordinarias/2023/lei-14605-2023-06-20.md"}}, {id:"federal:BR:L:14779/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-27", numero:"14779", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-27;14779", vigente:true, titulo:"Lei nº 14.779 de 27/12/2023", urn:"urn:lex:br:federal:lei:2023-12-27;14779", ementa:"Abre ao Orçamento de Investimento da União, em favor do Banco da Amazônia S.A., da Petróleo Brasileiro S.A., da Petrobras International Braspetro B.V., da Petrobras Biocombustível S.A., da Indústrias Nucleares do Brasil S.A., da Companhia de Entrepostos e Armazéns Gerais de São Paulo, da Companhia Docas do Ceará, da Companhia Docas do Pará e da Companhia Docas do Rio Grande do Norte, crédito suplementar no valor de R$ 398.100.272,00, para reforço de dotações constantes da Lei Orçamentária vigent", arquivo:"federal/leis-ordinarias/2023/lei-14779-2023-12-27.md"}}, {id:"federal:BR:L:14760/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-21", numero:"14760", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-21;14760", vigente:true, titulo:"Lei nº 14.760 de 21/12/2023", urn:"urn:lex:br:federal:lei:2023-12-21;14760", ementa:"Abre ao Orçamento Fiscal da União, em favor dos Ministérios da Ciência, Tecnologia e Inovação, do Desenvolvimento Agrário e Agricultura Familiar, e das Mulheres, crédito suplementar no valor de R$ 25.891.727,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2023/lei-14760-2023-12-21.md"}}, {id:"federal:BR:L:14699/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-10-19", numero:"14699", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-10-19;14699", vigente:true, titulo:"Lei nº 14.699 de 19/10/2023", urn:"urn:lex:br:federal:lei:2023-10-19;14699", ementa:"Confere ao Município de Monte Sião, no Estado de Minas Gerais, o título de Capital Nacional da Moda Tricô.", arquivo:"federal/leis-ordinarias/2023/lei-14699-2023-10-19.md"}}, {id:"federal:BR:L:14671/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-09-11", numero:"14671", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-09-11;14671", vigente:true, titulo:"Lei nº 14.671 de 11/09/2023", urn:"urn:lex:br:federal:lei:2023-09-11;14671", ementa:"Altera a Lei nº 6.437, de 20 de agosto de 1977, para dispor sobre a celebração de termo de compromisso com a finalidade de promover correções e ajustes às exigências da legislação sanitária.", arquivo:"federal/leis-ordinarias/2023/lei-14671-2023-09-11.md"}}, {id:"federal:BR:L:14726/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-11-17", numero:"14726", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-11-17;14726", vigente:true, titulo:"Lei nº 14.726 de 17/11/2023", urn:"urn:lex:br:federal:lei:2023-11-17;14726", ementa:"Institui a gratificação por exercício cumulativo de ofícios dos membros da Defensoria Pública da União e dispõe sobre a sua interiorização.", arquivo:"federal/leis-ordinarias/2023/lei-14726-2023-11-17.md"}}, {id:"federal:BR:L:14562/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-04-26", numero:"14562", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-04-26;14562", vigente:true, titulo:"Lei nº 14.562 de 26/04/2023", urn:"urn:lex:br:federal:lei:2023-04-26;14562", ementa:"Altera o art. 311 do Decreto-Lei nº 2.848, de 7 de dezembro de 1940 (Código Penal), para criminalizar a conduta de quem adultera sinal identificador de veículo não categorizado como automotor.", arquivo:"federal/leis-ordinarias/2023/lei-14562-2023-04-26.md"}}, {id:"federal:BR:L:14645/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-08-02", numero:"14645", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-08-02;14645", vigente:true, titulo:"Lei nº 14.645 de 02/08/2023", urn:"urn:lex:br:federal:lei:2023-08-02;14645", ementa:"Altera a Lei nº 9.394, de 20 de dezembro de 1996 (Lei de Diretrizes e Bases da Educação Nacional), para dispor sobre a educação profissional e tecnológica e articular a educação profissional técnica de nível médio com programas de aprendizagem profissional, e a Lei nº 8.742, de 7 de dezembro de 1993, para dispor sobre isenção do cômputo de determinados rendimentos no cálculo da renda familiar per capita para efeitos da concessão do Benefício de Prestação Continuada (BPC).", arquivo:"federal/leis-ordinarias/2023/lei-14645-2023-08-02.md"}}, {id:"federal:BR:L:14628/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-20", numero:"14628", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-20;14628", vigente:true, titulo:"Lei nº 14.628 de 20/07/2023", urn:"urn:lex:br:federal:lei:2023-07-20;14628", ementa:"Institui o Programa de Aquisição de Alimentos (PAA) e o Programa Cozinha Solidária; altera as Leis nºs 12.512, de 14 de outubro de 2011, e 14.133, de 1º de abril de 2021 (Lei de Licitações e Contratos Administrativos); e revoga dispositivos das Leis nºs 11.718, de 20 de junho de 2008, 11.775, de 17 de setembro de 2008, 12.512, de 14 de outubro de 2011, e 14.284, de 29 de dezembro de 2021.", arquivo:"federal/leis-ordinarias/2023/lei-14628-2023-07-20.md"}}, {id:"federal:BR:L:14619/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-11", numero:"14619", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-11;14619", vigente:true, titulo:"Lei nº 14.619 de 11/07/2023", urn:"urn:lex:br:federal:lei:2023-07-11;14619", ementa:"Inclui a Caminhada da Água como evento ambiental comemorativo do Dia Mundial da Água.", arquivo:"federal/leis-ordinarias/2023/lei-14619-2023-07-11.md"}}, {id:"federal:BR:L:14632/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-25", numero:"14632", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-25;14632", vigente:true, titulo:"Lei nº 14.632 de 25/07/2023", urn:"urn:lex:br:federal:lei:2023-07-25;14632", ementa:"Abre ao Orçamento Fiscal da União, em favor de Operações Oficiais de Crédito, crédito suplementar no valor de R$ 40.355.174,00, para reforço de dotação constante da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2023/lei-14632-2023-07-25.md"}}, {id:"federal:BR:L:14565/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-05-04", numero:"14565", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-05-04;14565", vigente:true, titulo:"Lei nº 14.565 de 04/05/2023", urn:"urn:lex:br:federal:lei:2023-05-04;14565", ementa:"Altera a Lei nº 12.249, de 11 de junho de 2010, para modificar a Tabela de Taxas de Serviços Metrológicos.", arquivo:"federal/leis-ordinarias/2023/lei-14565-2023-05-04.md"}}, {id:"federal:BR:L:14729/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-11-23", numero:"14729", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-11-23;14729", vigente:true, titulo:"Lei nº 14.729 de 23/11/2023", urn:"urn:lex:br:federal:lei:2023-11-23;14729", ementa:"Altera as Leis nºs 13.724, de 4 de outubro de 2018, e 10.257, de 10 de julho de 2001, para ampliar a participação popular no processo de implantação de infraestruturas destinadas à circulação de bicicletas, bem como para determinar a compatibilização do Plano de Mobilidade Urbana com a ampliação do perímetro urbano.", arquivo:"federal/leis-ordinarias/2023/lei-14729-2023-11-23.md"}}, {id:"federal:BR:L:14651/2023", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-08-23", numero:"14651", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-08-23;14651", vigente:true, titulo:"Lei nº 14.651 de 23/08/2023", urn:"urn:lex:br:federal:lei:2023-08-23;14651", ementa:"Altera o Decreto-Lei nº 1.455, de 7 de abril de 1976, as Leis nºs 10.833, de 29 de dezembro de 2003, e 14.286, de 29 de dezembro de 2021, para dispor sobre a aplicação e o julgamento da pena de perdimento de mercadoria, veículo e moeda.", arquivo:"federal/leis-ordinarias/2023/lei-14651-2023-08-23.md"}}, {id:"federal:BR:L:14746/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-05", numero:"14746", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-05;14746", vigente:true, titulo:"Lei nº 14.746 de 05/12/2023", urn:"urn:lex:br:federal:lei:2023-12-05;14746", ementa:"Confere o título de Capital Nacional das Águas ao Município de Rio Grande, no Estado do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/2023/lei-14746-2023-12-05.md"}}, {id:"federal:BR:L:14622/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-17", numero:"14622", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-17;14622", vigente:true, titulo:"Lei nº 14.622 de 17/07/2023", urn:"urn:lex:br:federal:lei:2023-07-17;14622", ementa:"Institui o Dia Nacional da Pessoa com Visão Monocular.", arquivo:"federal/leis-ordinarias/2023/lei-14622-2023-07-17.md"}}, {id:"federal:BR:L:14577/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-05-10", numero:"14577", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-05-10;14577", vigente:true, titulo:"Lei nº 14.577 de 10/05/2023", urn:"urn:lex:br:federal:lei:2023-05-10;14577", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério da Ciência, Tecnologia e Inovação e de Operações Oficiais de Crédito, crédito suplementar no valor de R$ 4.182.427.220,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2023/lei-14577-2023-05-10.md"}}, {id:"federal:BR:L:14590/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-05-24", numero:"14590", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-05-24;14590", vigente:true, titulo:"Lei nº 14.590 de 24/05/2023", urn:"urn:lex:br:federal:lei:2023-05-24;14590", ementa:"Altera a Lei nº 11.284, de 2 de março de 2006, que dispõe sobre a gestão de florestas públicas para a produção sustentável, a Lei nº 11.516, de 28 de agosto de 2007, que dispõe sobre a criação do Instituto Chico Mendes de Conservação da Biodiversidade, e a Lei nº 12.114, de 9 de dezembro de 2009, que cria o Fundo Nacional sobre Mudança do Clima.", arquivo:"federal/leis-ordinarias/2023/lei-14590-2023-05-24.md"}}, {id:"federal:BR:L:14548/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-04-13", numero:"14548", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-04-13;14548", vigente:true, titulo:"Lei nº 14.548 de 13/04/2023", urn:"urn:lex:br:federal:lei:2023-04-13;14548", ementa:"Altera a Lei nº 8.069, de 13 de julho de 1990 (Estatuto da Criança e do Adolescente), para compatibilizá-la com a Lei nº 12.127, de 17 de dezembro de 2009, que criou o Cadastro Nacional de Crianças e Adolescentes Desaparecidos, e com a Lei nº 13.812, de 16 de março de 2019, que instituiu a Política Nacional de Busca de Pessoas Desaparecidas e criou o Cadastro Nacional de Pessoas Desaparecidas.", arquivo:"federal/leis-ordinarias/2023/lei-14548-2023-04-13.md"}}, {id:"federal:BR:L:14765/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-22", numero:"14765", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-22;14765", vigente:true, titulo:"Lei nº 14.765 de 22/12/2023", urn:"urn:lex:br:federal:lei:2023-12-22;14765", ementa:"Concede pensão especial aos ex-integrantes do Batalhão Suez.", arquivo:"federal/leis-ordinarias/2023/lei-14765-2023-12-22.md"}}, {id:"federal:BR:L:14697/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-10-11", numero:"14697", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-10-11;14697", vigente:true, titulo:"Lei nº 14.697 de 11/10/2023", urn:"urn:lex:br:federal:lei:2023-10-11;14697", ementa:"Altera o Decreto-Lei nº 288, de 28 de fevereiro de 1967, para estabelecer prazo máximo para análise de proposta de Processo Produtivo Básico (PPB).", arquivo:"federal/leis-ordinarias/2023/lei-14697-2023-10-11.md"}}, {id:"federal:BR:L:14528/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-01-09", numero:"14528", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-01-09;14528", vigente:true, titulo:"Lei nº 14.528 de 09/01/2023", urn:"urn:lex:br:federal:lei:2023-01-09;14528", ementa:"Altera a Lei nº 12.777, de 28 de dezembro de 2012, para reajustar a remuneração dos servidores do Quadro de Pessoal da Câmara dos Deputados.", arquivo:"federal/leis-ordinarias/2023/lei-14528-2023-01-09.md"}}, {id:"federal:BR:L:14593/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-06-02", numero:"14593", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-06-02;14593", vigente:true, titulo:"Lei nº 14.593 de 02/06/2023", urn:"urn:lex:br:federal:lei:2023-06-02;14593", ementa:"Altera a Lei nº 13.693, de 10 de julho de 2018, para instituir a Semana Nacional da Informação, Capacitação e Pesquisa sobre Doenças Raras e alterar a denominação do Dia Nacional de Doenças Raras.", arquivo:"federal/leis-ordinarias/2023/lei-14593-2023-06-02.md"}}, {id:"federal:BR:L:14660/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-08-23", numero:"14660", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-08-23;14660", vigente:true, titulo:"Lei nº 14.660 de 23/08/2023", urn:"urn:lex:br:federal:lei:2023-08-23;14660", ementa:"Altera o art. 14 da Lei nº 11.947, de 16 de junho de 2009, para incluir grupos formais e informais de mulheres da agricultura familiar entre aqueles com prioridade na aquisição de gêneros alimentícios no âmbito do Programa Nacional de Alimentação Escolar (PNAE) e para estabelecer que pelo menos 50% (cinquenta por cento) da venda da família será feita no nome da mulher.", arquivo:"federal/leis-ordinarias/2023/lei-14660-2023-08-23.md"}}, {id:"federal:BR:L:14663/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-08-28", numero:"14663", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-08-28;14663", vigente:true, titulo:"Lei nº 14.663 de 28/08/2023", urn:"urn:lex:br:federal:lei:2023-08-28;14663", ementa:"Define o valor do salário mínimo a partir de 1º de maio de 2023; estabelece a política de valorização permanente do salário mínimo a vigorar a partir de 1º de janeiro de 2024; e altera os valores da tabela mensal do Imposto sobre a Renda da Pessoa Física de que trata o art. 1º da Lei nº 11.482, de 31 de maio de 2007, e os valores de dedução previstos no art. 4º da Lei nº 9.250, de 26 de dezembro de 1995.", arquivo:"federal/leis-ordinarias/2023/lei-14663-2023-08-28.md"}}, {id:"federal:BR:L:14681/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-09-18", numero:"14681", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-09-18;14681", vigente:true, titulo:"Lei nº 14.681 de 18/09/2023", urn:"urn:lex:br:federal:lei:2023-09-18;14681", ementa:"Institui a Política de Bem-Estar, Saúde e Qualidade de Vida no Trabalho e Valorização dos Profissionais da Educação.", arquivo:"federal/leis-ordinarias/2023/lei-14681-2023-09-18.md"}}, {id:"federal:BR:L:14551/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-04-20", numero:"14551", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-04-20;14551", vigente:true, titulo:"Lei nº 14.551 de 20/04/2023", urn:"urn:lex:br:federal:lei:2023-04-20;14551", ementa:"Confere ao Município de Cruz Machado, no Estado do Paraná, o título de Capital Nacional da Erva-Mate Sombreada.", arquivo:"federal/leis-ordinarias/2023/lei-14551-2023-04-20.md"}}, {id:"federal:BR:L:14688/2023", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-09-20", numero:"14688", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-09-20;14688", vigente:true, titulo:"Lei nº 14.688 de 20/09/2023", urn:"urn:lex:br:federal:lei:2023-09-20;14688", ementa:"Altera o Decreto-Lei nº 1.001, de 21 de outubro de 1969 (Código Penal Militar), a fim de compatibilizá-lo com o Decreto-Lei nº 2.848, de 7 de dezembro de 1940 (Código Penal), e com a Constituição Federal, e a Lei nº 8.072, de 25 de julho de 1990 (Lei dos Crimes Hediondos), para classificar como hediondos os crimes que especifica.", arquivo:"federal/leis-ordinarias/2023/lei-14688-2023-09-20.md"}}, {id:"federal:BR:L:14586/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-05-18", numero:"14586", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-05-18;14586", vigente:true, titulo:"Lei nº 14.586 de 18/05/2023", urn:"urn:lex:br:federal:lei:2023-05-18;14586", ementa:"Denomina \"Rodovia Dr. Fábio André Koff\" a BR-448, no Estado do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/2023/lei-14586-2023-05-18.md"}}, {id:"federal:BR:L:14536/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-01-20", numero:"14536", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-01-20;14536", vigente:true, titulo:"Lei nº 14.536 de 20/01/2023", urn:"urn:lex:br:federal:lei:2023-01-20;14536", ementa:"Altera a Lei nº 11.350, de 5 de outubro de 2006, a fim de considerar os Agentes Comunitários de Saúde e os Agentes de Combate às Endemias como profissionais de saúde, com profissões regulamentadas, para a finalidade que especifica.", arquivo:"federal/leis-ordinarias/2023/lei-14536-2023-01-20.md"}}, {id:"federal:BR:L:14520/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-01-09", numero:"14520", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-01-09;14520", vigente:true, titulo:"Lei nº 14.520 de 09/01/2023", urn:"urn:lex:br:federal:lei:2023-01-09;14520", ementa:"Fixa o subsídio de Ministro do Supremo Tribunal Federal, referido no inciso XV do caput do art. 48 da Constituição Federal; e dá outras providências.", arquivo:"federal/leis-ordinarias/2023/lei-14520-2023-01-09.md"}}, {id:"federal:BR:L:14541/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-04-03", numero:"14541", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-04-03;14541", vigente:true, titulo:"Lei nº 14.541 de 03/04/2023", urn:"urn:lex:br:federal:lei:2023-04-03;14541", ementa:"Dispõe sobre a criação e o funcionamento ininterrupto de Delegacias Especializadas de Atendimento à Mulher.", arquivo:"federal/leis-ordinarias/2023/lei-14541-2023-04-03.md"}}, {id:"federal:BR:L:14730/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-11-23", numero:"14730", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-11-23;14730", vigente:true, titulo:"Lei nº 14.730 de 23/11/2023", urn:"urn:lex:br:federal:lei:2023-11-23;14730", ementa:"Denomina Rodovia Bernardo Sayão trechos das rodovias BR-153, BR-226, BR-010 e BR-316.", arquivo:"federal/leis-ordinarias/2023/lei-14730-2023-11-23.md"}}, {id:"federal:BR:L:14659/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-08-23", numero:"14659", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-08-23;14659", vigente:true, titulo:"Lei nº 14.659 de 23/08/2023", urn:"urn:lex:br:federal:lei:2023-08-23;14659", ementa:"Confere ao Município de Timbó, no Estado de Santa Catarina, o título de Capital Nacional do Cicloturismo.", arquivo:"federal/leis-ordinarias/2023/lei-14659-2023-08-23.md"}}, {id:"federal:BR:L:14741/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-11-30", numero:"14741", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-11-30;14741", vigente:true, titulo:"Lei nº 14.741 de 30/11/2023", urn:"urn:lex:br:federal:lei:2023-11-30;14741", ementa:"Cria cargos de provimento efetivo, cargos em comissão e funções comissionadas nos Quadros Permanentes da Secretaria do Superior Tribunal Militar e das Auditorias da Justiça Militar da União.", arquivo:"federal/leis-ordinarias/2023/lei-14741-2023-11-30.md"}}, {id:"federal:BR:L:14603/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-06-20", numero:"14603", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-06-20;14603", vigente:true, titulo:"Lei nº 14.603 de 20/06/2023", urn:"urn:lex:br:federal:lei:2023-06-20;14603", ementa:"Reconhece o carnaval do Município de Nova Russas, no Estado do Ceará, como manifestação da cultura nacional.", arquivo:"federal/leis-ordinarias/2023/lei-14603-2023-06-20.md"}}, {id:"federal:BR:L:14758/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-19", numero:"14758", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-19;14758", vigente:true, titulo:"Lei nº 14.758 de 19/12/2023", urn:"urn:lex:br:federal:lei:2023-12-19;14758", ementa:"Institui a Política Nacional de Prevenção e Controle do Câncer no âmbito do Sistema Único de Saúde (SUS) e o Programa Nacional de Navegação da Pessoa com Diagnóstico de Câncer; e altera a Lei nº 8.080, de 19 de setembro de 1990 (Lei Orgânica da Saúde).", arquivo:"federal/leis-ordinarias/2023/lei-14758-2023-12-19.md"}}, {id:"federal:BR:L:14715/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-10-30", numero:"14715", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-10-30;14715", vigente:true, titulo:"Lei nº 14.715 de 30/10/2023", urn:"urn:lex:br:federal:lei:2023-10-30;14715", ementa:"Altera a Lei nº 8.080, de 19 de setembro de 1990 (Lei Orgânica da Saúde), para incluir no campo de atuação do Sistema Único de Saúde (SUS) a formulação e a execução da política de informação e assistência toxicológica e de logística de antídotos e medicamentos utilizados em intoxicações.", arquivo:"federal/leis-ordinarias/2023/lei-14715-2023-10-30.md"}}, {id:"federal:BR:L:14598/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-06-14", numero:"14598", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-06-14;14598", vigente:true, titulo:"Lei nº 14.598 de 14/06/2023", urn:"urn:lex:br:federal:lei:2023-06-14;14598", ementa:"Dispõe sobre a realização de exames em gestantes.", arquivo:"federal/leis-ordinarias/2023/lei-14598-2023-06-14.md"}}, {id:"federal:BR:L:14777/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-27", numero:"14777", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-27;14777", vigente:true, titulo:"Lei nº 14.777 de 27/12/2023", urn:"urn:lex:br:federal:lei:2023-12-27;14777", ementa:"Abre ao Orçamento Fiscal da União, em favor das Justiças Federal e do Trabalho, e do Ministério Público da União, crédito suplementar no valor de R$ 5.087.628,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2023/lei-14777-2023-12-27.md"}}, {id:"federal:BR:L:14782/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-27", numero:"14782", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-27;14782", vigente:true, titulo:"Lei nº 14.782 de 27/12/2023", urn:"urn:lex:br:federal:lei:2023-12-27;14782", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério do Turismo e de Operações Oficiais de Crédito, crédito suplementar no valor de R$ 405.538.500,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2023/lei-14782-2023-12-27.md"}}, {id:"federal:BR:L:14664/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-09-04", numero:"14664", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-09-04;14664", vigente:true, titulo:"Lei nº 14.664 de 04/09/2023", urn:"urn:lex:br:federal:lei:2023-09-04;14664", ementa:"Denomina \"Rodovia Iris Rezende Machado\" o trecho da BR-153 entre as cidades de Anápolis, no Estado de Goiás, e de Aliança do Tocantins, no Estado do Tocantins.", arquivo:"federal/leis-ordinarias/2023/lei-14664-2023-09-04.md"}}, {id:"federal:BR:L:14584/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-05-16", numero:"14584", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-05-16;14584", vigente:true, titulo:"Lei nº 14.584 de 16/05/2023", urn:"urn:lex:br:federal:lei:2023-05-16;14584", ementa:"Inscreve o nome de Maria Rita de Souza Brito Lopes Pontes, Irmã Dulce, no Livro dos Heróis e Heroínas da Pátria.", arquivo:"federal/leis-ordinarias/2023/lei-14584-2023-05-16.md"}}, {id:"federal:BR:L:14703/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-10-20", numero:"14703", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-10-20;14703", vigente:true, titulo:"Lei nº 14.703 de 20/10/2023", urn:"urn:lex:br:federal:lei:2023-10-20;14703", ementa:"Abre ao Orçamento Fiscal da União, em favor dos Ministérios da Defesa e da Integração e do Desenvolvimento Regional, crédito especial no valor de R$ 892.145.545,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2023/lei-14703-2023-10-20.md"}}, {id:"federal:BR:L:14774/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-26", numero:"14774", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-26;14774", vigente:true, titulo:"Lei nº 14.774 de 26/12/2023", urn:"urn:lex:br:federal:lei:2023-12-26;14774", ementa:"Abre ao Orçamento Fiscal da União, em favor dos Ministérios da Fazenda, da Justiça e Segurança Pública, da Defesa, das Cidades e de Portos e Aeroportos, crédito especial no valor de R$ 573.005.655,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2023/lei-14774-2023-12-26.md"}}, {id:"federal:BR:L:14684/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-09-20", numero:"14684", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-09-20;14684", vigente:true, titulo:"Lei nº 14.684 de 20/09/2023", urn:"urn:lex:br:federal:lei:2023-09-20;14684", ementa:"Acrescenta inciso ao art. 193 da Consolidação das Leis do Trabalho (CLT), aprovada pelo Decreto-Lei nº 5.452, de 1º de maio de 1943, para considerar perigosas as atividades desempenhadas pelos agentes das autoridades de trânsito.", arquivo:"federal/leis-ordinarias/2023/lei-14684-2023-09-20.md"}}, {id:"federal:BR:L:14558/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-04-25", numero:"14558", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-04-25;14558", vigente:true, titulo:"Lei nº 14.558 de 25/04/2023", urn:"urn:lex:br:federal:lei:2023-04-25;14558", ementa:"Institui o Dia Nacional do Terço dos Homens.", arquivo:"federal/leis-ordinarias/2023/lei-14558-2023-04-25.md"}}, {id:"federal:BR:L:14625/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-18", numero:"14625", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-18;14625", vigente:true, titulo:"Lei nº 14.625 de 18/07/2023", urn:"urn:lex:br:federal:lei:2023-07-18;14625", ementa:"Altera o Anexo V à Lei nº 14.535, de 17 de janeiro de 2023, que estima a receita e fixa a despesa da União para o exercício financeiro de 2023.", arquivo:"federal/leis-ordinarias/2023/lei-14625-2023-07-18.md"}}, {id:"federal:BR:L:14647/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-08-04", numero:"14647", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-08-04;14647", vigente:true, titulo:"Lei nº 14.647 de 04/08/2023", urn:"urn:lex:br:federal:lei:2023-08-04;14647", ementa:"Altera a Consolidação das Leis do Trabalho (CLT), aprovada pelo Decreto-Lei nº 5.452, de 1º de maio de 1943, para estabelecer a inexistência de vínculo empregatício entre entidades religiosas ou instituições de ensino vocacional e seus ministros, membros ou quaisquer outros que a eles se equiparem.", arquivo:"federal/leis-ordinarias/2023/lei-14647-2023-08-04.md"}}, {id:"federal:BR:L:14655/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-08-23", numero:"14655", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-08-23;14655", vigente:true, titulo:"Lei nº 14.655 de 23/08/2023", urn:"urn:lex:br:federal:lei:2023-08-23;14655", ementa:"Altera a Lei nº 8.080, de 19 de setembro de 1990, para assegurar a participação de especialista indicado pela Associação Médica Brasileira na Comissão Nacional de Incorporação de Tecnologias no Sistema Único de Saúde.", arquivo:"federal/leis-ordinarias/2023/lei-14655-2023-08-23.md"}}, {id:"federal:BR:L:14636/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-25", numero:"14636", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-25;14636", vigente:true, titulo:"Lei nº 14.636 de 25/07/2023", urn:"urn:lex:br:federal:lei:2023-07-25;14636", ementa:"Confere o título de Capital Nacional do Agroturismo ao Município de Venda Nova do Imigrante, no Estado do Espírito Santo.", arquivo:"federal/leis-ordinarias/2023/lei-14636-2023-07-25.md"}}, {id:"federal:BR:L:14532/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-01-11", numero:"14532", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-01-11;14532", vigente:true, titulo:"Lei nº 14.532 de 11/01/2023", urn:"urn:lex:br:federal:lei:2023-01-11;14532", ementa:"Altera a Lei nº 7.716, de 5 de janeiro de 1989 (Lei do Crime Racial), e o Decreto-Lei nº 2.848, de 7 de dezembro de 1940 (Código Penal), para tipificar como crime de racismo a injúria racial, prever pena de suspensão de direito em caso de racismo praticado no contexto de atividade esportiva ou artística e prever pena para o racismo religioso e recreativo e para o praticado por funcionário público.", arquivo:"federal/leis-ordinarias/2023/lei-14532-2023-01-11.md"}}, {id:"federal:BR:L:14769/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-22", numero:"14769", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-22;14769", vigente:true, titulo:"Lei nº 14.769 de 22/12/2023", urn:"urn:lex:br:federal:lei:2023-12-22;14769", ementa:"Institui o dia 19 de maio como o Dia Nacional do Físico.", arquivo:"federal/leis-ordinarias/2023/lei-14769-2023-12-22.md"}}, {id:"federal:BR:L:14711/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-10-30", numero:"14711", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-10-30;14711", vigente:true, titulo:"Lei nº 14.711 de 30/10/2023", urn:"urn:lex:br:federal:lei:2023-10-30;14711", ementa:"Dispõe sobre o aprimoramento das regras de garantia, a execução extrajudicial de créditos garantidos por hipoteca, a execução extrajudicial de garantia imobiliária em concurso de credores, o procedimento de busca e apreensão extrajudicial de bens móveis em caso de inadimplemento de contrato de alienação fiduciária, o resgate antecipado de Letra Financeira, a alíquota de imposto de renda sobre rendimentos no caso de fundos de investimento em participações qualificados que envolvam titulares de co", arquivo:"federal/leis-ordinarias/2023/lei-14711-2023-10-30.md"}}, {id:"federal:BR:L:14640/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-31", numero:"14640", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-31;14640", vigente:true, titulo:"Lei nº 14.640 de 31/07/2023", urn:"urn:lex:br:federal:lei:2023-07-31;14640", ementa:"Institui o Programa Escola em Tempo Integral; e altera a Lei nº 11.273, de 6 de fevereiro de 2006, a Lei nº 13.415, de 16 de fevereiro de 2017, e a Lei nº 14.172, de 10 de junho de 2021.", arquivo:"federal/leis-ordinarias/2023/lei-14640-2023-07-31.md"}}, {id:"federal:BR:L:14573/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-05-10", numero:"14573", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-05-10;14573", vigente:true, titulo:"Lei nº 14.573 de 10/05/2023", urn:"urn:lex:br:federal:lei:2023-05-10;14573", ementa:"Inscreve o nome de Jaime Nelson Wright no Livro dos Heróis e Heroínas da Pátria.", arquivo:"federal/leis-ordinarias/2023/lei-14573-2023-05-10.md"}}, {id:"federal:BR:L:14524/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-01-09", numero:"14524", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-01-09;14524", vigente:true, titulo:"Lei nº 14.524 de 09/01/2023", urn:"urn:lex:br:federal:lei:2023-01-09;14524", ementa:"Altera a Lei nº 13.316, de 20 de julho de 2016, para reajustar a remuneração das carreiras dos servidores do Ministério Público da União e do Conselho Nacional do Ministério Público.", arquivo:"federal/leis-ordinarias/2023/lei-14524-2023-01-09.md"}}, {id:"federal:BR:L:14722/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-11-08", numero:"14722", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-11-08;14722", vigente:true, titulo:"Lei nº 14.722 de 08/11/2023", urn:"urn:lex:br:federal:lei:2023-11-08;14722", ementa:"Institui a Política Nacional de Conscientização e Incentivo à Doação e ao Transplante de Órgãos e Tecidos.", arquivo:"federal/leis-ordinarias/2023/lei-14722-2023-11-08.md"}}, {id:"federal:BR:L:14642/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-08-01", numero:"14642", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-08-01;14642", vigente:true, titulo:"Lei nº 14.642 de 01/08/2023", urn:"urn:lex:br:federal:lei:2023-08-01;14642", ementa:"Denomina João Batista Menegatti o viaduto localizado na rodovia BR-282, na travessia urbana do Município de Xanxerê, Estado de Santa Catarina.", arquivo:"federal/leis-ordinarias/2023/lei-14642-2023-08-01.md"}}, {id:"federal:BR:L:14581/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-05-11", numero:"14581", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-05-11;14581", vigente:true, titulo:"Lei nº 14.581 de 11/05/2023", urn:"urn:lex:br:federal:lei:2023-05-11;14581", ementa:"Abre ao Orçamento da Seguridade Social da União, em favor do Ministério da Saúde, crédito especial no valor de R$ 7.300.000.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/2023/lei-14581-2023-05-11.md"}}, {id:"federal:BR:L:14692/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-10-03", numero:"14692", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-10-03;14692", vigente:true, titulo:"Lei nº 14.692 de 03/10/2023", urn:"urn:lex:br:federal:lei:2023-10-03;14692", ementa:"Altera a Lei nº 8.069, de 13 de julho de 1990 (Estatuto da Criança e do Adolescente), para possibilitar ao doador de recursos aos Fundos dos Direitos da Criança e do Adolescente a indicação da destinação desses recursos, na forma que especifica.", arquivo:"federal/leis-ordinarias/2023/lei-14692-2023-10-03.md"}}, {id:"federal:BR:L:14734/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-11-23", numero:"14734", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-11-23;14734", vigente:true, titulo:"Lei nº 14.734 de 23/11/2023", urn:"urn:lex:br:federal:lei:2023-11-23;14734", ementa:"Altera a Lei nº 11.947, de 16 de junho de 2009, para determinar que os Estados, o Distrito Federal e os Municípios forneçam recursos financeiros a fim de possibilitar o pleno funcionamento do Conselho de Alimentação Escolar (CAE) e aprovem normas complementares para execução do Programa Nacional de Alimentação Escolar (Pnae).", arquivo:"federal/leis-ordinarias/2023/lei-14734-2023-11-23.md"}}, {id:"federal:BR:L:14621/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-14", numero:"14621", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-14;14621", vigente:true, titulo:"Lei nº 14.621 de 14/07/2023", urn:"urn:lex:br:federal:lei:2023-07-14;14621", ementa:"Institui a Estratégia Nacional de Formação de Especialistas para a Saúde no âmbito do Programa Mais Médicos; e altera as Leis nºs 12.871, de 22 de outubro de 2013, 13.959, de 18 de dezembro de 2019, e 13.958, de 18 de dezembro de 2019, para criar novos incentivos e regras no âmbito do Projeto Mais Médicos para o Brasil e do Exame Nacional de Revalidação de Diplomas Médicos Expedidos por Instituição de Educação Superior Estrangeira (Revalida) e para transformar a Agência para o Desenvolvimento da", arquivo:"federal/leis-ordinarias/2023/lei-14621-2023-07-14.md"}}, {id:"federal:BR:L:14607/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-06-20", numero:"14607", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-06-20;14607", vigente:true, titulo:"Lei nº 14.607 de 20/06/2023", urn:"urn:lex:br:federal:lei:2023-06-20;14607", ementa:"Institui o Dia Nacional da Doença de Huntington.", arquivo:"federal/leis-ordinarias/2023/lei-14607-2023-06-20.md"}}, {id:"federal:BR:L:14770/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-22", numero:"14770", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-22;14770", vigente:true, titulo:"Lei nº 14.770 de 22/12/2023", urn:"urn:lex:br:federal:lei:2023-12-22;14770", ementa:"Altera a Lei nº 14.133, de 1º de abril de 2021 (Lei de Licitações e Contratos Administrativos), para determinar o modo de disputa fechado nas licitações de obras e serviços que especifica, facultar a adesão de Município a ata de registro de preços licitada por outro ente do mesmo nível federativo, dispor sobre a execução e liquidação do objeto remanescente de contrato administrativo rescindido, permitir a prestação de garantia na forma de título de capitalização e promover a gestão e a aplicação", arquivo:"federal/leis-ordinarias/2023/lei-14770-2023-12-22.md"}}, {id:"federal:BR:L:14614/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-07-03", numero:"14614", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-07-03;14614", vigente:true, titulo:"Lei nº 14.614 de 03/07/2023", urn:"urn:lex:br:federal:lei:2023-07-03;14614", ementa:"Altera a Lei nº 14.597, de 14 de junho de 2023 (Lei Geral do Esporte), para garantir às atletas gestantes ou puérperas, no âmbito da Bolsa-Atleta, o respeito à maternidade e aos direitos que as protegem.", arquivo:"federal/leis-ordinarias/2023/lei-14614-2023-07-03.md"}}, {id:"federal:BR:L:14694/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-10-10", numero:"14694", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-10-10;14694", vigente:true, titulo:"Lei nº 14.694 de 10/10/2023", urn:"urn:lex:br:federal:lei:2023-10-10;14694", ementa:"Institui o Novembrinho Azul, a ser realizado no mês de novembro.", arquivo:"federal/leis-ordinarias/2023/lei-14694-2023-10-10.md"}}, {id:"federal:BR:L:14706/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-10-25", numero:"14706", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-10-25;14706", vigente:true, titulo:"Lei nº 14.706 de 25/10/2023", urn:"urn:lex:br:federal:lei:2023-10-25;14706", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério da Ciência, Tecnologia e Inovação, crédito especial no valor de R$ 22.827.287,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2023/lei-14706-2023-10-25.md"}}, {id:"federal:BR:L:14519/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-01-05", numero:"14519", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-01-05;14519", vigente:true, titulo:"Lei nº 14.519 de 05/01/2023", urn:"urn:lex:br:federal:lei:2023-01-05;14519", ementa:"Institui o Dia Nacional das Tradições das Raízes de Matrizes Africanas e Nações do Candomblé.", arquivo:"federal/leis-ordinarias/2023/lei-14519-2023-01-05.md"}}, {id:"federal:BR:L:14753/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-12", numero:"14753", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-12;14753", vigente:true, titulo:"Lei nº 14.753 de 12/12/2023", urn:"urn:lex:br:federal:lei:2023-12-12;14753", ementa:"Altera a Medida Provisória nº 2.199-14, de 24 de agosto de 2001, para fixar novo prazo para a aprovação de projetos beneficiados com incentivos fiscais de redução e reinvestimento do imposto sobre a renda e adicionais nas áreas de atuação da Superintendência do Desenvolvimento do Nordeste (Sudene) e da Superintendência do Desenvolvimento da Amazônia (Sudam).", arquivo:"federal/leis-ordinarias/2023/lei-14753-2023-12-12.md"}}, {id:"federal:BR:L:14544/2023", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-04-04", numero:"14544", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-04-04;14544", vigente:true, titulo:"Lei nº 14.544 de 04/04/2023", urn:"urn:lex:br:federal:lei:2023-04-04;14544", ementa:"Dispõe sobre a gestão e a operacionalização dos pedidos das indenizações previstas no art. 3º da Lei nº 6.194, de 19 de dezembro de 1974, com vistas a assegurar a sua continuidade; e altera a Lei nº 14.075, de 22 de outubro de 2020.", arquivo:"federal/leis-ordinarias/2023/lei-14544-2023-04-04.md"}}, {id:"federal:BR:L:14676/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-09-18", numero:"14676", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-09-18;14676", vigente:true, titulo:"Lei nº 14.676 de 18/09/2023", urn:"urn:lex:br:federal:lei:2023-09-18;14676", ementa:"Cria funções comissionadas no Quadro de Pessoal do Tribunal de Justiça do Distrito Federal e dos Territórios.", arquivo:"federal/leis-ordinarias/2023/lei-14676-2023-09-18.md"}}, {id:"federal:BR:L:14762/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-21", numero:"14762", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-21;14762", vigente:true, titulo:"Lei nº 14.762 de 21/12/2023", urn:"urn:lex:br:federal:lei:2023-12-21;14762", ementa:"Abre ao Orçamento Fiscal da União, em favor das Justiças Federal e Eleitoral, crédito especial no valor de R$ 4.167.554,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2023/lei-14762-2023-12-21.md"}}, {id:"federal:BR:L:14745/2023", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2023, data:"2023-12-05", numero:"14745", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2023-12-05;14745", vigente:true, titulo:"Lei nº 14.745 de 05/12/2023", urn:"urn:lex:br:federal:lei:2023-12-05;14745", ementa:"Institui o Dia Nacional do Rosário da Virgem Maria.", arquivo:"federal/leis-ordinarias/2023/lei-14745-2023-12-05.md"}}, {id:"federal:BR:L:14631/2023", properties:{esfera:"fede