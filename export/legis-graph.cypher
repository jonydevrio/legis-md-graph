 versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-12-21", numero:"12148", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-12-21;12148", vigente:true, titulo:"Lei nº 12.148 de 21/12/2009", urn:"urn:lex:br:federal:lei:2009-12-21;12148", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério da Ciência e Tecnologia, crédito especial no valor de R$ 6.250.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2009/lei-12148-2009-12-21.md"}}, {id:"federal:BR:L:11992/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-07-27", numero:"11992", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-07-27;11992", vigente:true, titulo:"Lei nº 11.992 de 27/07/2009", urn:"urn:lex:br:federal:lei:2009-07-27;11992", ementa:"Abre ao Orçamento de Investimento para 2009, em favor da Empresa de Tecnologia e Informações da Previdência Social - DATAPREV, crédito especial no valor total de R$ 103.263.522,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2009/lei-11992-2009-07-27.md"}}, {id:"federal:BR:L:11930/2009", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-04-22", numero:"11930", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2009-04-22;11930", vigente:true, titulo:"Lei nº 11.930 de 22/04/2009", urn:"urn:lex:br:federal:lei:2009-04-22;11930", ementa:"Institui a Semana de Mobilização Nacional para Doação de Medula Óssea e dispõe sobre a localização de doadores de medula óssea.", arquivo:"federal/leis-ordinarias/2009/lei-11930-2009-04-22.md"}}, {id:"federal:BR:L:12063/2009", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2009, data:"2009-10-27", numero:"12063", fonte:"https://normas.leg.br/?urn=urn:lex:br:f