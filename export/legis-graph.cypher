.", arquivo:"federal/leis-ordinarias/1935/lei-53-1935-05-18.md"}}, {id:"federal:BR:L:66/1935", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1935, data:"1935-06-13", numero:"66", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1935-06-13;66", vigente:true, titulo:"Lei nº 66 de 13/06/1935", urn:"urn:lex:br:federal:lei:1935-06-13;66", ementa:"Autoriza a abrir o credito especial de 2.500:000$000, para ultimação das obras iniciadas na 7ª Região Militar", arquivo:"federal/leis-ordinarias/1935/lei-66-1935-06-13.md"}}, {id:"federal:BR:L:129/1935", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1935, data:"1935-12-07", numero:"129", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1935-12-07;129", vigente:true, titulo:"Lei nº 129 de 07/12/1935", urn:"urn:lex:br:federal:lei:1935-12-07;129", ementa:"Autoriza o Poder Executivo a entrar em acordo com os credores norte-americanos para a liquidação das dividas commerciaes atrazadas", arquivo:"federal/leis-ordinarias/1935/lei-129-1935-12-07.md"}}, {id:"federal:BR:L:77/1935", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1935, data:"1935-07-01", numero:"77", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1935-07-01;77", vigente:true, titulo:"Lei nº 77 de 01/07/1935", urn:"urn:lex:br:federal:lei:1935-07-01;77", ementa:"Altera a idade para a matricula dos capitães combatentes do Exercito da Escola de Estado-Maior", arquivo:"federal/leis-ordinarias/1935/lei-77-1935-07-01.md"}}, {id:"federal:BR:L:138/1935", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1935, data:"1935-12-16", numero:"138", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1935-12-16;138", vigente:true,