rquivo:"federal/leis-ordinarias/1937/lei-583-1937-11-09.md"}}, {id:"federal:BR:L:509/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-09-22", numero:"509", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-09-22;509", vigente:true, titulo:"Lei nº 509 de 22/09/1937", urn:"urn:lex:br:federal:lei:1937-09-22;509", ementa:"Autoriza o Presidente da República a mandar emitir selos postais   comemorativos do 1º centenário do nascimento do Brigadeiro José Vieira Couto de   Magalhães e dá outras providências", arquivo:"federal/leis-ordinarias/1937/lei-509-1937-09-22.md"}}, {id:"federal:BR:L:564/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-10-29", numero:"564", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-10-29;564", vigente:true, titulo:"Lei nº 564 de 29/10/1937", urn:"urn:lex:br:federal:lei:1937-10-29;564", ementa:"Autoriza a abrir, pelo Ministério da Justiça e Negocios Interiores, o   crédito especial de 534:061$200 para pagamento aos primeiros suplentes de pretos   da Justiça do Distrito Federal", arquivo:"federal/leis-ordinarias/1937/lei-564-1937-10-29.md"}}, {id:"federal:BR:L:513/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-09-27", numero:"513", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-09-27;513", vigente:true, titulo:"Lei nº 513 de 27/09/1937", urn:"urn:lex:br:federal:lei:1937-09-27;513", ementa:"Suprime a cláusula exclusiva da penhora de bens da Liga Brasileira contra   a Tuberculose", arquivo:"federal/leis-ordinarias/1937/lei-513-1937-09-27.md"}}, {id:"federal:BR:L:457/1937", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-07-13", numero:"457", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-07-13;457", vigente:true, titulo:"Lei nº 457 de 13/07/1937", urn:"urn:lex:br:federal:lei:1937-07-13;457", ementa:"Providencia sôbre a celebração de casamentos nas circunscrições   territoriais das 7ª e 8ª Pretorias Civeis do Districto Federal", arquivo:"federal/leis-ordinarias/1937/lei-457-1937-07-13.md"}}, {id:"federal:BR:L:411/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-03-26", numero:"411", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-03-26;411", vigente:true, titulo:"Lei nº 411 de 26/03/1937", urn:"urn:lex:br:federal:lei:1937-03-26;411", ementa:"Autoriza a abrir pelo Ministério da Agricultura, o crédito especial de   1.028:373$700, para pagamento de auxílios devidos às emprêsas de ficção de seda   nacional, e à Inspetoria de Sericicultura de Barbacena", arquivo:"federal/leis-ordinarias/1937/lei-411-1937-03-26.md"}}, {id:"federal:BR:L:553/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-10-21", numero:"553", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-10-21;553", vigente:true, titulo:"Lei nº 553 de 21/10/1937", urn:"urn:lex:br:federal:lei:1937-10-21;553", ementa:"Aprova o acôrdo celebrado com o Govêrno do Estado do Rio de Janeiro, para   a execução dos serviços relativos à classificação do algodão no respectivo   território", arquivo:"federal/leis-ordinarias/1937/lei-553-1937-10-21.md"}}, {id:"federal:BR:L:519/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-10-01", numero:"519", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-10-01;519", vigente:true, titulo:"Lei nº 519 de 01/10/1937", urn:"urn:lex:br:federal:lei:1937-10-01;519", ementa:"Completa o art. 4º da lei nº 178, de 9 de janeiro de 1936", arquivo:"federal/leis-ordinarias/1937/lei-519-1937-10-01.md"}}, {id:"federal:BR:L:531/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-10-07", numero:"531", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-10-07;531", vigente:true, titulo:"Lei nº 531 de 07/10/1937", urn:"urn:lex:br:federal:lei:1937-10-07;531", ementa:"Autoriza a compra de um terreno em Sant'ana do Livramento, no Rio Grande   do Sul", arquivo:"federal/leis-ordinarias/1937/lei-531-1937-10-07.md"}}, {id:"federal:BR:L:476/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-08-17", numero:"476", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-08-17;476", vigente:true, titulo:"Lei nº 476 de 17/08/1937", urn:"urn:lex:br:federal:lei:1937-08-17;476", ementa:"Revigora, para os exercícios de 1937 e 1938, o crédito especial de   4.450:600$000, aberto pelo decreto n. 23.238, de 1933, afim de se regularizar a   aquisição da área destinada à construção do Ministério do Trabalho", arquivo:"federal/leis-ordinarias/1937/lei-476-1937-08-17.md"}}, {id:"federal:BR:L:422/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-04-14", numero:"422", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-04-14;422", vigente:true, titulo:"Lei nº 422 de 14/04/1937", urn:"urn:lex:br:federal:lei:1937-04-14;422", ementa:"Autoriza a dispender até a quantia de 200:000$000, com a construção de uma   ponte sôbre o Rio Amambaí no Estado de Mato Grosso", arquivo:"federal/leis-ordinarias/1937/lei-422-1937-04-14.md"}}, {id:"federal:BR:L:524/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-10-05", numero:"524", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-10-05;524", vigente:true, titulo:"Lei nº 524 de 05/10/1937", urn:"urn:lex:br:federal:lei:1937-10-05;524", ementa:"Autoriza a abrir os créditos necessários para a construção de um monumento   a Francisco Manoel da Silva, autor do Hino Nacional Brasileiro", arquivo:"federal/leis-ordinarias/1937/lei-524-1937-10-05.md"}}, {id:"federal:BR:L:486/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-08-25", numero:"486", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-08-25;486", vigente:true, titulo:"Lei nº 486 de 25/08/1937", urn:"urn:lex:br:federal:lei:1937-08-25;486", ementa:"Destaca da verba 15ª do Orçamento do Ministério da Viação para 1937, a   importância de 304:200$000, para pagamento de pessoal adido e de cargos   extintos.", arquivo:"federal/leis-ordinarias/1937/lei-486-1937-08-25.md"}}, {id:"federal:BR:L:508/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-09-21", numero:"508", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-09-21;508", vigente:true, titulo:"Lei nº 508 de 21/09/1937", urn:"urn:lex:br:federal:lei:1937-09-21;508", ementa:"Providencia sôbre a construção de canais de irrigação no Nordeste e estende   às instalações de elevação de água os auxílios concedidos aos açudes por   cooperação", arquivo:"federal/leis-ordinarias/1937/lei-508-1937-09-21.md"}}, {id:"federal:BR:L:557/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-10-25", numero:"557", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-10-25;557", vigente:true, titulo:"Lei nº 557 de 25/10/1937", urn:"urn:lex:br:federal:lei:1937-10-25;557", ementa:"Autoriza o Poder Executivo a garantir um empréstimo de 6.000:000$ ao   Govêrno do Estado da Baía, afim de custear a exploração do schisto de Marú", arquivo:"federal/leis-ordinarias/1937/lei-557-1937-10-25.md"}}, {id:"federal:BR:L:456/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-07-12", numero:"456", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-07-12;456", vigente:true, titulo:"Lei nº 456 de 12/07/1937", urn:"urn:lex:br:federal:lei:1937-07-12;456", ementa:"Autoriza a abrir, pelo Ministério da Viação e Óbras Públicas, crédito   suplementar de 20.000:000$000, para refôrço de subvenção ao Lloyd Brasileiro", arquivo:"federal/leis-ordinarias/1937/lei-456-1937-07-12.md"}}, {id:"federal:BR:L:517/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-09-30", numero:"517", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-09-30;517", vigente:true, titulo:"Lei nº 517 de 30/09/1937", urn:"urn:lex:br:federal:lei:1937-09-30;517", ementa:"Inclue no quadro dos funcionários da Secretaria da Câmara, por ter sido   omitido, o lugar de porteiro-chefe de portaria, cargo extinto", arquivo:"federal/leis-ordinarias/1937/lei-517-1937-09-30.md"}}, {id:"federal:BR:L:446/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-06-05", numero:"446", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-06-05;446", vigente:true, titulo:"Lei nº 446 de 05/06/1937", urn:"urn:lex:br:federal:lei:1937-06-05;446", ementa:"Dispõe sobre a creação de um monumento a, Santos Dumont, na sua cidade   natal, em Minas Gerais", arquivo:"federal/leis-ordinarias/1937/lei-446-1937-06-05.md"}}, {id:"federal:BR:L:398/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-03-02", numero:"398", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-03-02;398", vi