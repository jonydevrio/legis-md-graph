"}}, {id:"federal:BR:L:3790/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-08-02", numero:"3790", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-08-02;3790", vigente:true, titulo:"Lei nº 3.790 de 02/08/1960", urn:"urn:lex:br:federal:lei:1960-08-02;3790", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 10.000.000,00 para socorrer as vítimas da tromba d'água ocorrida no município de Cambuci, Estado do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1960/lei-3790-1960-08-02.md"}}, {id:"federal:BR:L:3762/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-04-25", numero:"3762", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-04-25;3762", vigente:true, titulo:"Lei nº 3.762 de 25/04/1960", urn:"urn:lex:br:federal:lei:1960-04-25;3762", ementa:"Autoriza o Poder Executivo a doar imóvel do Domínio da União ao Município de Piraí, no Estado do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1960/lei-3762-1960-04-25.md"}}, {id:"federal:BR:L:3738/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-04-04", numero:"3738", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1960-04-04;3738", vigente:true, titulo:"Lei nº 3.738 de 04/04/1960", urn:"urn:lex:br:federal:lei:1960-04-04;3738", ementa:"Assegura pensão especial à viúva de militar ou funcionário civil atacado de tuberculose ativa, alienação mental, neoplasia malígna, cegueira, lepra, paralisia ou cardiopatia grave.", arquivo:"federal/leis-ordinarias/1960/lei-3738-1960-04-04.md"}}, {id:"federal:BR:L:3808/1960", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1960, data:"1960-09-01", numero:"3808", fonte:"https:/