numero:"3427", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-07-10;3427", vigente:true, titulo:"Lei nº 3.427 de 10/07/1958", urn:"urn:lex:br:federal:lei:1958-07-10;3427", ementa:"Determina a inclusão da especialização de engenheiro sanitarista na   enumeração do art. 16 do Decreto-Lei nº 8.620, de 10 de janeiro de   1946.", arquivo:"federal/leis-ordinarias/1958/lei-3427-1958-07-10.md"}}, {id:"federal:BR:L:3439/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-08-21", numero:"3439", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-08-21;3439", vigente:true, titulo:"Lei nº 3.439 de 21/08/1958", urn:"urn:lex:br:federal:lei:1958-08-21;3439", ementa:"Considera estáveis os servidores extranumerários e interinos que tomaram   parte ativa no último conflito mundial e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3439-1958-08-21.md"}}, {id:"federal:BR:L:3479/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-04", numero:"3479", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-04;3479", vigente:true, titulo:"Lei nº 3.479 de 04/12/1958", urn:"urn:lex:br:federal:lei:1958-12-04;3479", ementa:"Isenta de todos os impostos e taxas federais o Museu de Arte Moderna do   Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1958/lei-3479-1958-12-04.md"}}, {id:"federal:BR:L:3457/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-11-18", numero:"3457", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-11-18;3457", vigente:true, titulo:"Lei nº 3.457 de 18/11/1958", urn:"urn:lex:br:federal:lei:1958-11-18;3457", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o   crédito especial de Cr$ 9.300.000, para atender às despesas decorrentes das   comemorações do 150º aniversário da fundação do Jardim Botânico.", arquivo:"federal/leis-ordinarias/1958/lei-3457-1958-11-18.md"}}, {id:"federal:BR:L:3492/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-12-18", numero:"3492", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-12-18;3492", vigente:true, titulo:"Lei nº 3.492 de 18/12/1958", urn:"urn:lex:br:federal:lei:1958-12-18;3492", ementa:"Eleva à Primeira Categoria os Tribunais Regionais do Trabalho das Terceira, Quinta e Sexta Regiões; cria Juntas de Conciliação e Julgamento e dá outras providências.", arquivo:"federal/leis-ordinarias/1958/lei-3492-1958-12-18.md"}}, {id:"federal:BR:L:3428/1958", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-07-15", numero:"3428", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-07-15;3428", vigente:true, titulo:"Lei nº 3.428 de 15/07/1958", urn:"urn:lex:br:federal:lei:1958-07-15;3428", ementa:"Cria a Comissão Executiva do Sisal.", arquivo:"federal/leis-ordinarias/1958/lei-3428-1958-07-15.md"}}, {id:"federal:BR:L:3388/1958", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1958, data:"1958-05-21", numero:"3388", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1958-05-21;3388", vigente:true, titulo:"Lei nº 3.388 de 21/05/1958", urn:"urn:lex:br:federal:lei:1958-05-21;3388", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça Eleitoral   - Tribunal Regional Eleitoral do Rio Grande do Norte, o crédito especial de Cr$   14.500,00 para atender às despesas de pagamento da majoração de gratificação de   juízes e escrivães eleitorais .", arquivo:"federal/leis-ordinarias/1958/lei-3388-1958-05-21.md"}}, {id:"federal:BR:L:3498/1958", properties:{esfera:"federal", vers