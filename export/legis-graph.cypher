11602-2007-12-03.md"}}, {id:"federal:BR:L:11441/2007", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2007, data:"2007-01-04", numero:"11441", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2007-01-04;11441", vigente:true, titulo:"Lei nº 11.441 de 04/01/2007", urn:"urn:lex:br:federal:lei:2007-01-04;11441", ementa:"Altera dispositivos da Lei nº 5.869, de 11 de janeiro de 1973 - Código de Processo Civil, possibilitando a realização de inventário, partilha, separação consensual e divórcio consensual por via administrativa.", arquivo:"federal/leis-ordinarias/2007/lei-11441-2007-01-04.md"}}, {id:"federal:BR:L:11468/2007", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2007, data:"2007-04-17", numero:"11468", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2007-04-17;11468", vigente:true, titulo:"Lei nº 11.468 de 17/04/2007", urn:"urn:lex:br:federal:lei:2007-04-17;11468", ementa:"Abre crédito extraordinário, em favor dos Ministérios da Educação, dos Transportes e da Integração Nacional, no valor global de R$ 181.200.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2007/lei-11468-2007-04-17.md"}}, {id:"federal:BR:L:11585/2007", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2007, data:"2007-11-28", numero:"11585", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2007-11-28;11585", vigente:true, titulo:"Lei nº 11.585 de 28/11/2007", urn:"urn:lex:br:federal:lei:2007-11-28;11585", ementa:"Institui o dia 4 de outubro como o Dia Nacional do Agente Comunitário de Saúde.", arquivo:"federal/leis-ordinarias/2007/lei-11585-2007-11-28.md"}}, {id:"federal:BR:L:11486/2007", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2007, data:"2007-06-15", numero:"11486", fonte:"ht