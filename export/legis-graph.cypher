1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-11-08", numero:"9862", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-11-08;9862", vigente:true, titulo:"Lei nº 9.862 de 08/11/1999", urn:"urn:lex:br:federal:lei:1999-11-08;9862", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor do Ministério da Previdência e Assistência Social e do Ministério da Educação, crédito especial no valor global de R$ 47.526.311,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1999/lei-9862-1999-11-08.md"}}, {id:"federal:BR:L:9791/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-03-24", numero:"9791", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-03-24;9791", vigente:true, titulo:"Lei nº 9.791 de 24/03/1999", urn:"urn:lex:br:federal:lei:1999-03-24;9791", ementa:"Dispõe sobre a obrigatoriedade de as concessionárias de serviços públicos estabelecerem ao consumidor e ao usuário datas opcionais para o vencimento de seus débitos.", arquivo:"federal/leis-ordinarias/1999/lei-9791-1999-03-24.md"}}, {id:"federal:BR:L:9823/1999", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1999, data:"1999-08-23", numero:"9823", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1999-08-23;9823", vigente:true, titulo:"Lei nº 9.823 de 23/08/1999", urn:"urn:lex:br:federal:lei:1999-08-23;9823", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento da Seguridade Social da   União, em favor do Ministério da Previdência e Assistência Social, crédito   extraordinário no valor de R$ 2.932.395.868,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1999/lei-9823-1999-08-23.md"}}, {id:"federal:BR:L:9807/1999", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", 