narias/1990/lei-8024-1990-04-12.md"}}, {id:"federal:BR:L:8079/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-09-13", numero:"8079", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-09-13;8079", vigente:true, titulo:"Lei nº 8.079 de 13/09/1990", urn:"urn:lex:br:federal:lei:1990-09-13;8079", ementa:"Altera a redação do § 2º do art. 184 e acrescenta parágrafo único ao art. 240 da Lei nº 5.869, de 11 de janeiro de 1973 - Código de Processo Civil.", arquivo:"federal/leis-ordinarias/1990/lei-8079-1990-09-13.md"}}, {id:"federal:BR:L:8050/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-06-20", numero:"8050", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-06-20;8050", vigente:true, titulo:"Lei nº 8.050 de 20/06/1990", urn:"urn:lex:br:federal:lei:1990-06-20;8050", ementa:"Dá nova redação ao art. 52, § 2º, da Lei nº 7.800, de 10 de julho de 1989.", arquivo:"federal/leis-ordinarias/1990/lei-8050-1990-06-20.md"}}, {id:"federal:BR:L:8108/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-12-10", numero:"8108", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-12-10;8108", vigente:true, titulo:"Lei nº 8.108 de 10/12/1990", urn:"urn:lex:br:federal:lei:1990-12-10;8108", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento Fiscal da União crédito suplementar no valor de Cr$ 6.120.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1990/lei-8108-1990-12-10.md"}}, {id:"federal:BR:L:8057/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-06-29", numero:"8057", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-06-29;8057", vigente:true, titulo:"Lei nº 8.057 de 29/06/1990", urn:"urn:lex:br:federal:lei:1990-06-29;8057", ementa:"Dispõe sobre a competência das autoridades que menciona e dá outras   providências.", arquivo:"federal/leis-ordinarias/1990/lei-8057-1990-06-29.md"}}, {id:"federal:BR:L:8033/1990", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-04-12", numero:"8033", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-04-12;8033", vigente:true, titulo:"Lei nº 8.033 de 12/04/1990", urn:"urn:lex:br:federal:lei:1990-04-12;8033", ementa:"Altera, mediante conversão em lei das Medidas Provisórias nºs 160, de 15 de março de 1990, e 171, de 17 de março de 1990, a legislação do Imposto sobre Operações Financeiras, instituindo incidências de caráter transitório sobre os atos que menciona, e dá outras providências.", arquivo:"federal/leis-ordinarias/1990/lei-8033-1990-04-12.md"}}, {id:"federal:BR:L:8152/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-12-28", numero:"8152", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-12-28;8152", vigente:true, titulo:"Lei nº 8.152 de 28/12/1990", urn:"urn:lex:br:federal:lei:1990-12-28;8152", ementa:"Dispõe sobre a criação das Procuradorias da República nos Estados de Roraima e Amapá e dá outras providências.", arquivo:"federal/leis-ordinarias/1990/lei-8152-1990-12-28.md"}}, {id:"federal:BR:L:8088/1990", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-10-31", numero:"8088", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-10-31;8088", vigente:true, titulo:"Lei nº 8.088 de 31/10/1990", urn:"urn:lex:br:federal:lei:1990-10-31;8088", ementa:"Dispõe sobre a atualização do Bônus do Tesouro Nacional e dos depósitos de poupança e dá outras providências.", arquivo:"federal/leis-ordinarias/1990/lei-8088-1990-10-31.md"}}, {id:"federal:BR:L:8049/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-06-20", numero:"8049", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-06-20;8049", vigente:true, titulo:"Lei nº 8.049 de 20/06/1990", urn:"urn:lex:br:federal:lei:1990-06-20;8049", ementa:"Altera dispositivos da Lei nº 3.071, de 1º de janeiro de 1916 - Código Civil Brasileiro, que dispõe sobre a herança jacente e a sucessão legítima.", arquivo:"federal/leis-ordinarias/1990/lei-8049-1990-06-20.md"}}, {id:"federal:BR:L:8125/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-12-19", numero:"8125", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-12-19;8125", vigente:true, titulo:"Lei nº 8.125 de 19/12/1990", urn:"urn:lex:br:federal:lei:1990-12-19;8125", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento Fiscal da União crédito especial até o limite de Cr$ 30.000.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1990/lei-8125-1990-12-19.md"}}, {id:"federal:BR:L:8064/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-07-04", numero:"8064", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-07-04;8064", vigente:true, titulo:"Lei nº 8.064 de 04/07/1990", urn:"urn:lex:br:federal:lei:1990-07-04;8064", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento da Seguridade Social da União crédito suplementar de Cr$ 3.300.000.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1990/lei-8064-1990-07-04.md"}}, {id:"federal:BR:L:8035/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-04-27", numero:"8035", fonte:"https://normas.leg.br/?u