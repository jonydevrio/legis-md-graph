UNWIND [{id:"federal:BR:L:15166/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-07-16", numero:"15166", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-07-16;15166", vigente:true, titulo:"Lei nº 15.166 de 16/07/2025", urn:"urn:lex:br:federal:lei:2025-07-16;15166", ementa:"Cria a Rota Turística Costa Azul, no Estado de Santa Catarina.", arquivo:"federal/leis-ordinarias/2025/lei-15166-2025-07-16.md"}}, {id:"federal:BR:L:15186/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-08-04", numero:"15186", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-08-04;15186", vigente:true, titulo:"Lei nº 15.186 de 04/08/2025", urn:"urn:lex:br:federal:lei:2025-08-04;15186", ementa:"Concede o título de Capital Nacional dos Bombeiros Voluntários ao Município de Joinville, no Estado de Santa Catarina.", arquivo:"federal/leis-ordinarias/2025/lei-15186-2025-08-04.md"}}, {id:"federal:BR:L:15122/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-04-11", numero:"15122", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-04-11;15122", vigente:true, titulo:"Lei nº 15.122 de 11/04/2025", urn:"urn:lex:br:federal:lei:2025-04-11;15122", ementa:"Estabelece critérios para suspensão de concessões comerciais, de investimentos e de obrigações relativas a direitos de propriedade intelectual em resposta a medidas unilaterais adotadas por país ou bloco econômico que impactem negativamente a competitividade internacional brasileira; e dá outras providências.", arquivo:"federal/leis-ordinarias/2025/lei-15122-2025-04-11.md"}}, {id:"federal:BR:L:15181/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-07-28", numero:"15181", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-07-28;15181", vigente:true, titulo:"Lei nº 15.181 de 28/07/2025", urn:"urn:lex:br:federal:lei:2025-07-28;15181", ementa:"Altera o Decreto-Lei nº 2.848, de 7 de dezembro de 1940 (Código Penal), para aumentar as penas aplicadas ao furto, roubo e receptação de fios, cabos ou equipamentos utilizados para fornecimento ou transmissão de energia elétrica ou de telefonia ou para transferência de dados e as aplicadas à interrupção ou perturbação de serviço telegráfico, telefônico, informático, telemático ou de informação de utilidade pública; e altera as Leis nºs 9.613, de 3 de março de 1998, para aumentar a pena dos crime", arquivo:"federal/leis-ordinarias/2025/lei-15181-2025-07-28.md"}}, {id:"federal:BR:L:15248/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-11-03", numero:"15248", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-11-03;15248", vigente:true, titulo:"Lei nº 15.248 de 03/11/2025", urn:"urn:lex:br:federal:lei:2025-11-03;15248", ementa:"Institui o Dia Nacional do Motociclista Profissional.", arquivo:"federal/leis-ordinarias/2025/lei-15248-2025-11-03.md"}}, {id:"federal:BR:L:15254/2025", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-11-06", numero:"15254", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-11-06;15254", vigente:true, titulo:"Lei nº 15.254 de 06/11/2025", urn:"urn:lex:br:federal:lei:2025-11-06;15254", ementa:"Institui o Dia Nacional da Proteção de Dados.", arquivo:"federal/leis-ordinarias/2025/lei-15254-2025-11-06.md"}}, {id:"federal:BR:L:15235/2025", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-10-08", numero:"15235", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-10-08;15235", vigente:true, titulo:"Lei nº 15.235 de 08/10/2025", urn:"urn:lex:br:federal:lei:2025-10-08;15235", ementa:"Altera as Leis nºs 10.438, de 26 de abril de 2002, 12.111, de 9 de dezembro de 2009, e 12.212, de 20 de janeiro de 2010; e revoga dispositivos das Leis nºs 9.427, de 26 de dezembro de 1996, e 11.196, de 21 de novembro de 2005.", arquivo:"federal/leis-ordinarias/2025/lei-15235-2025-10-08.md"}}, {id:"federal:BR:L:15223/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-09-30", numero:"15223", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-09-30;15223", vigente:true, titulo:"Lei nº 15.223 de 30/09/2025", urn:"urn:lex:br:federal:lei:2025-09-30;15223", ementa:"Institui o Programa Nacional de Fortalecimento da Agricultura Familiar (Pronaf) e o Plano Safra da agricultura familiar, e dá outras providências.", arquivo:"federal/leis-ordinarias/2025/lei-15223-2025-09-30.md"}}, {id:"federal:BR:L:15198/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-09-08", numero:"15198", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-09-08;15198", vigente:true, titulo:"Lei nº 15.198 de 08/09/2025", urn:"urn:lex:br:federal:lei:2025-09-08;15198", ementa:"Dispõe sobre ações relacionadas ao enfrentamento do parto prematuro e institui o Novembro Roxo, o Dia Nacional da Prematuridade e a Semana da Prematuridade.", arquivo:"federal/leis-ordinarias/2025/lei-15198-2025-09-08.md"}}, {id:"federal:BR:L:15266/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-11-21", numero:"15266", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-11-21;15266", vigente:true, titulo:"Lei nº 15.266 de 21/11/2025", urn:"urn:lex:br:federal:lei:2025-11-21;15266", ementa:"Altera a Lei nº 14.133, de 1º de abril de 2021 (Lei de Licitações e Contratos Administrativos), para prever o uso do Sistema de Compras Expressas (Sicx) na contratação de bens e serviços comuns padronizados.", arquivo:"federal/leis-ordinarias/2025/lei-15266-2025-11-21.md"}}, {id:"federal:BR:L:15205/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-09-12", numero:"15205", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-09-12;15205", vigente:true, titulo:"Lei nº 15.205 de 12/09/2025", urn:"urn:lex:br:federal:lei:2025-09-12;15205", ementa:"Reconhece como manifestação da cultura nacional a Festa de San Gennaro, realizada no Município de São Paulo, no Estado de São Paulo.", arquivo:"federal/leis-ordinarias/2025/lei-15205-2025-09-12.md"}}, {id:"federal:BR:L:15236/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-10-16", numero:"15236", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-10-16;15236", vigente:true, titulo:"Lei nº 15.236 de 16/10/2025", urn:"urn:lex:br:federal:lei:2025-10-16;15236", ementa:"Altera a Lei nº 10.420, de 10 de abril de 2002, para modificar disposições relativas ao Fundo Garantia Safra e ao Benefício Garantia-Safra.", arquivo:"federal/leis-ordinarias/2025/lei-15236-2025-10-16.md"}}, {id:"federal:BR:L:15092/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-01-07", numero:"15092", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-01-07;15092", vigente:true, titulo:"Lei nº 15.092 de 07/01/2025", urn:"urn:lex:br:federal:lei:2025-01-07;15092", ementa:"Reconhece como patrimônio cultural brasileiro as barracas de praia e a atividade desempenhada pelos barraqueiros da Praia do Futuro, em Fortaleza, Estado do Ceará.", arquivo:"federal/leis-ordinarias/2025/lei-15092-2025-01-07.md"}}, {id:"federal:BR:L:15257/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-11-12", numero:"15257", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-11-12;15257", vigente:true, titulo:"Lei nº 15.257 de 12/11/2025", urn:"urn:lex:br:federal:lei:2025-11-12;15257", ementa:"Revoga as Leis nºs 3.807, de 26 de agosto de 1960 (Lei Orgânica da Previdência Social), 5.890, de 8 de junho de 1973, e 6.367, de 19 de outubro de 1976, e dispositivos do Decreto-Lei nº 72, de 21 de novembro de 1966.", arquivo:"federal/leis-ordinarias/2025/lei-15257-2025-11-12.md"}}, {id:"federal:BR:L:15130/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-04-29", numero:"15130", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-04-29;15130", vigente:true, titulo:"Lei nº 15.130 de 29/04/2025", urn:"urn:lex:br:federal:lei:2025-04-29;15130", ementa:"Altera a Lei nº 7.827, de 27 de setembro de 1989 (Lei dos Fundos Constitucionais), que \"regulamenta o art. 159, inciso I, alínea c, da Constituição Federal, institui o Fundo Constitucional de Financiamento do Norte (FNO), o Fundo Constitucional de Financiamento do Nordeste (FNE) e o Fundo Constitucional de Financiamento do Centro-Oeste (FCO), e dá outras providências\".", arquivo:"federal/leis-ordinarias/2025/lei-15130-2025-04-29.md"}}, {id:"federal:BR:L:15281/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-12-05", numero:"15281", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-12-05;15281", vigente:true, titulo:"Lei nº 15.281 de 05/12/2025", urn:"urn:lex:br:federal:lei:2025-12-05;15281", ementa:"Altera a Lei nº 11.343, de 23 de agosto de 2006, para dispor sobre a criação de estratégia de saúde direcionada às mulheres alcoolistas.", arquivo:"federal/leis-ordinarias/2025/lei-15281-2025-12-05.md"}}, {id:"federal:BR:L:15114/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-03-19", numero:"15114", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-03-19;15114", vigente:true, titulo:"Lei nº 15.114 de 19/03/2025", urn:"urn:lex:br:federal:lei:2025-03-19;15114", ementa:"Abre crédito extraordinário em favor do Ministério da Integração e do Desenvolvimento Regional, no valor de R$ 383.000.000,00 (trezentos e oitenta e três milhões de reais), para o fim que especifica.", arquivo:"federal/leis-ordinarias/2025/lei-15114-2025-03-19.md"}}, {id:"federal:BR:L:15137/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-05-21", numero:"15137", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-05-21;15137", vigente:true, titulo:"Lei nº 15.137 de 21/05/2025", urn:"urn:lex:br:federal:lei:2025-05-21;15137", ementa:"Reconhece o Carnaval de Pernambuco como manifestação da cultura nacional.", arquivo:"federal/leis-ordinarias/2025/lei-15137-2025-05-21.md"}}, {id:"federal:BR:L:15270/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-11-26", numero:"15270", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-11-26;15270", vigente:true, titulo:"Lei nº 15.270 de 26/11/2025", urn:"urn:lex:br:federal:lei:2025-11-26;15270", ementa:"Altera a Lei nº 9.250, de 26 de dezembro de 1995, e a Lei nº 9.249, de 26 de dezembro de 1995, para instituir a redução do imposto sobre a renda devido nas bases de cálculo mensal e anual e a tributação mínima para as pessoas físicas que auferem altas rendas; e dá outras providências.", arquivo:"federal/leis-ordinarias/2025/lei-15270-2025-11-26.md"}}, {id:"federal:BR:L:15154/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-06-30", numero:"15154", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-06-30;15154", vigente:true, titulo:"Lei nº 15.154 de 30/06/2025", urn:"urn:lex:br:federal:lei:2025-06-30;15154", ementa:"Altera a Lei nº 6.360, de 23 de setembro de 1976, para estabelecer isenção de registro e observância de regras simplificadas para cosméticos, produtos de higiene pessoal, perfumes e outros produtos de finalidade congênere, quando produzidos de maneira artesanal.", arquivo:"federal/leis-ordinarias/2025/lei-15154-2025-06-30.md"}}, {id:"federal:BR:L:15210/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-09-16", numero:"15210", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-09-16;15210", vigente:true, titulo:"Lei nº 15.210 de 16/09/2025", urn:"urn:lex:br:federal:lei:2025-09-16;15210", ementa:"Altera a Lei nº 14.133, de 1º de abril de 2021 (Lei de Licitações e Contratos Administrativos), para estabelecer requisitos para a compra de equipamentos destinados a procedimentos diagnósticos ou terapêuticos no âmbito do Sistema Único de Saúde (SUS).", arquivo:"federal/leis-ordinarias/2025/lei-15210-2025-09-16.md"}}, {id:"federal:BR:L:15309/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-12-22", numero:"15309", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-12-22;15309", vigente:true, titulo:"Lei nº 15.309 de 22/12/2025", urn:"urn:lex:br:federal:lei:2025-12-22;15309", ementa:"Abre ao Orçamento de Investimento da União, em favor da Telecomunicações Brasileiras S.A., crédito especial no valor de R$ 53.040.201,00, para inclusão de programações na Lei Orçamentária vigente, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2025/lei-15309-2025-12-22.md"}}, {id:"federal:BR:L:15242/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-10-28", numero:"15242", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-10-28;15242", vigente:true, titulo:"Lei nº 15.242 de 28/10/2025", urn:"urn:lex:br:federal:lei:2025-10-28;15242", ementa:"Inscreve o nome de Dom Hélder Pessoa Câmara no Livro dos Heróis e Heroínas da Pátria e altera a Lei nº 11.597, de 29 de novembro de 2007.", arquivo:"federal/leis-ordinarias/2025/lei-15242-2025-10-28.md"}}, {id:"federal:BR:L:15134/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-05-06", numero:"15134", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-05-06;15134", vigente:true, titulo:"Lei nº 15.134 de 06/05/2025", urn:"urn:lex:br:federal:lei:2025-05-06;15134", ementa:"Altera o Decreto-Lei nº 2.848, de 7 de dezembro de 1940 (Código Penal), e as Leis nºs 8.072, de 25 de julho de 1990 (Lei dos Crimes Hediondos), 12.694, de 24 de julho de 2012, e 13.709, de 14 de agosto de 2018 (Lei Geral de Proteção de Dados Pessoais), para reconhecer como atividade de risco permanente as atribuições inerentes ao Poder Judiciário, ao Ministério Público e à Defensoria Pública e garantir aos seus membros e aos oficiais de justiça medidas de proteção, bem como recrudescer o tratame", arquivo:"federal/leis-ordinarias/2025/lei-15134-2025-05-06.md"}}, {id:"federal:BR:L:15238/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-10-23", numero:"15238", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-10-23;15238", vigente:true, titulo:"Lei nº 15.238 de 23/10/2025", urn:"urn:lex:br:federal:lei:2025-10-23;15238", ementa:"Declara Robson Sampaio de Almeida Patrono do Paradesporto Brasileiro.", arquivo:"federal/leis-ordinarias/2025/lei-15238-2025-10-23.md"}}, {id:"federal:BR:L:15150/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-06-16", numero:"15150", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-06-16;15150", vigente:true, titulo:"Lei nº 15.150 de 16/06/2025", urn:"urn:lex:br:federal:lei:2025-06-16;15150", ementa:"Altera a Lei nº 9.605, de 12 de fevereiro de 1998, que \"dispõe sobre as sanções penais e administrativas derivadas de condutas e atividades lesivas ao meio ambiente\", para proibir a realização de tatuagens e a colocação de piercings em cães e gatos, com fins estéticos.", arquivo:"federal/leis-ordinarias/2025/lei-15150-2025-06-16.md"}}, {id:"federal:BR:L:15162/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-07-03", numero:"15162", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-07-03;15162", vigente:true, titulo:"Lei nº 15.162 de 03/07/2025", urn:"urn:lex:br:federal:lei:2025-07-03;15162", ementa:"Institui o Dia Nacional do Conselheiro Comunitário de Segurança.", arquivo:"federal/leis-ordinarias/2025/lei-15162-2025-07-03.md"}}, {id:"federal:BR:L:15087/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-01-03", numero:"15087", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-01-03;15087", vigente:true, titulo:"Lei nº 15.087 de 03/01/2025", urn:"urn:lex:br:federal:lei:2025-01-03;15087", ementa:"Institui o Dia Nacional do Medicamento Biossimilar.", arquivo:"federal/leis-ordinarias/2025/lei-15087-2025-01-03.md"}}, {id:"federal:BR:L:15143/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-06-05", numero:"15143", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-06-05;15143", vigente:true, titulo:"Lei nº 15.143 de 05/06/2025", urn:"urn:lex:br:federal:lei:2025-06-05;15143", ementa:"Dispõe sobre medidas excepcionais para concessão de colaboração financeira à União, aos Estados e ao Distrito Federal, para apoio a ações de prevenção e combate à ocorrência de queimadas irregulares e de incêndios florestais; autoriza a participação da União no Fundo de Apoio à Infraestrutura para Recuperação e Adaptação a Eventos Climáticos Extremos; dispensa a celebração de convênio ou instrumento congênere para repasses do Fundo Nacional de Meio Ambiente aos entes subnacionais a fim de financ", arquivo:"federal/leis-ordinarias/2025/lei-15143-2025-06-05.md"}}, {id:"federal:BR:L:15098/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-01-10", numero:"15098", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-01-10;15098", titulo:"Lei nº 15.098 de 10/01/2025", vigente:true, urn:"urn:lex:br:federal:lei:2025-01-10;15098", ementa:"Institui o Dia Nacional da Ikebana.", arquivo:"federal/leis-ordinarias/2025/lei-15098-2025-01-10.md"}}, {id:"federal:BR:L:15151/2025", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2025, data:"2025-06-24", numero:"15151", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2025-06-24;15151", vigente:true, titulo:"Lei nº 15.151 de 24/06/2025", urn:"urn:lex:br:federal:lei:2025-06-24;15151", ementa:"Institui o dia 23 de abril como Dia Nacional de Conscientização da Fibrodisplasia Ossificante Progressiva (FOP)", arquivo:"federal/leis-ordinarias/2025/lei-15151-2025-06-24.md"}}, {id:"federal:BR:L:11567/2007", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2007, data:"2007-11-22", numero:"11567", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2007-11-22;11567", vigente:true, titulo:"Lei nº 11.567 de 22/11/2007", urn:"urn:lex:br:federal:lei:2007-11-22;11567", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério da Justiça, crédito especial no valor de R$ 50.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/2007/lei-11567-2007-11-22.md"}}, {id:"federal:BR:L:11633/2007", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2007, data:"2007-12-27", numero:"11633", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2007-12-27;11633", vigente:true, titulo:"Lei nº 11.633 de 27/12/2007", urn:"urn:lex:br:federal:lei:2007-12-27;11633", ementa:"Altera a Lei nº 9.434, de 4 de fevereiro de 1997.", arquivo:"federal/leis-ordinarias/2007/lei-11633-2007-12-27.md"}}, {id:"federal:BR:L:11483/2007", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2007, data:"2007-05-31", numero:"11483", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2007-05-31;11483", vigente:true, titulo:"Lei nº 11.483 de 31/05/2007", urn:"urn:lex:br:federal:lei:2007-05-31;11483", ementa:"Dispõe sobre a revitalização do setor ferroviário, altera dispositivos da Lei nº 10.233, de 5 de junho de 2001, e dá outras providências.", arquivo:"federal/leis-ordinarias/2007/lei-11483-2007-05-31.md"}}, {id:"federal:BR:L:11449/2007", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2007, data:"2007-01-15", numero:"11449", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2007-01-15;11449", vigente:true, titulo:"Lei nº 11.449 de 15/01/2007", urn:"urn:lex:br:federal:lei:2007-01-15;11449", ementa:"Altera o art. 306 do Decreto-Lei nº 3.689, de 3 de outubro de 1941 - Código de Processo Penal.", arquivo:"federal/leis-ordinarias/2007/lei-11449-2007-01-15.md"}}, {id:"federal:BR:L:11552/2007", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vi