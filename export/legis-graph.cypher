.md"}}, {id:"federal:BR:L:2315/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-09-03", numero:"2315", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-09-03;2315", vigente:true, titulo:"Lei nº 2.315 de 03/09/1954", urn:"urn:lex:br:federal:lei:1954-09-03;2315", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Agricultura, o crédito   especial de Cr$ 500.000,00 para auxiliar a realização do II Congresso   Nacional do Algodão.", arquivo:"federal/leis-ordinarias/1954/lei-2315-1954-09-03.md"}}, {id:"federal:BR:L:2353/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-11-26", numero:"2353", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-11-26;2353", vigente:true, titulo:"Lei nº 2.353 de 26/11/1954", urn:"urn:lex:br:federal:lei:1954-11-26;2353", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 400.000,00, como auxílio ao Município de Crato, Estado   do Ceará, para construção, no centenário da cidade, do monumento comemorativo de   suas tradições cívicas.", arquivo:"federal/leis-ordinarias/1954/lei-2353-1954-11-26.md"}}, {id:"federal:BR:L:2371/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-12-16", numero:"2371", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-12-16;2371", vigente:true, titulo:"Lei nº 2.371 de 16/12/1954", urn:"urn:lex:br:federal:lei:1954-12-16;2371", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura   o crédito especial de Cr$ 26.111.410,00 para pagamento do abono de emergência e   salário-família ao pessoal do Quadro Extraordinário da Universidade do   Brasil.", arquivo:"federal/leis-ordinarias/1954/lei-2371-1954-12-16.md"}}, {id:"federal:BR:L:2345/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-11-25", numero:"2345", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-11-25;2345", vigente:true, titulo:"Lei nº 2.345 de 25/11/1954", urn:"urn:lex:br:federal:lei:1954-11-25;2345", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Guerra, o crédito   especial de Cr$ 1.200.000,00 para atender a despesas com a afetivação da   incorporação, ao Patrimônio da União, do prédio da rua dos Tupis nº 723, em Belo   Horizonte, Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/1954/lei-2345-1954-11-25.md"}}, {id:"federal:BR:L:2289/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-08-19", numero:"2289", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-08-19;2289", vigente:true, titulo:"Lei nº 2.289 de 19/08/1954", urn:"urn:lex:br:federal:lei:1954-08-19;2289", ementa:"Dispõe sobre os professores catedráticos aposentados da Universidade do   Brasil, da Universidade Rural e da Escola Superior de Agricultura e Medicina   Veterinária.", arquivo:"federal/leis-ordinarias/1954/lei-2289-1954-08-19.md"}}, {id:"federal:BR:L:2196/1954", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1954, data:"1954-04-01", numero:"2196", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1954-04-01;2196", vigente:true, titulo:"Lei nº 2.196 de 01/04/1954", urn:"urn:lex:br:federal:lei:1954-04-01;2196", ementa:"Acrescenta novo item ao parágrafo único do art. 285 da Consolidação das Leis do Trabalho, dispondo sobre o serviço dos trabalhadores na movimentação de mercadorias.", arquivo:"federal/leis-ordinarias/1954/lei-2196-1954-04-01.md"}}, {id:"federal:BR:L:2307/1954", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária"