l", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-12-13", numero:"1273", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-12-13;1273", vigente:true, titulo:"Lei nº 1.273 de 13/12/1950", urn:"urn:lex:br:federal:lei:1950-12-13;1273", ementa:"Autoriza a abertura, ao Tribunal de Contas, de crédito especial para   pagamento de vencimentos.", arquivo:"federal/leis-ordinarias/1950/lei-1273-1950-12-13.md"}}, {id:"federal:BR:L:1119/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-06-02", numero:"1119", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-06-02;1119", vigente:true, titulo:"Lei nº 1.119 de 02/06/1950", urn:"urn:lex:br:federal:lei:1950-06-02;1119", ementa:"Eleva a Cr$ 100.000,00 a subvenção anual concedida ao Instituto Franco Brasileiro de Alta Cultura.", arquivo:"federal/leis-ordinarias/1950/lei-1119-1950-06-02.md"}}, {id:"federal:BR:L:1109/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-05-22", numero:"1109", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-05-22;1109", vigente:true, titulo:"Lei nº 1.109 de 22/05/1950", urn:"urn:lex:br:federal:lei:1950-05-22;1109", ementa:"Concede pensão especial a Luiz Hilário Pereira Garro.", arquivo:"federal/leis-ordinarias/1950/lei-1109-1950-05-22.md"}}, {id:"federal:BR:L:1091/1950", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1950, data:"1950-04-23", numero:"1091", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1950-04-23;1091", vigente:true, titulo:"Lei nº 1.091 de 23/04/1950", urn:"urn:lex:br:federal:lei:1950-04-23;1091", ementa:"Autoriza a abertura, pelo Ministério da Educação e Saúde, do crédito especial de Cr$ 196.870,40, para ocorrer a pagamento de gratificação de magistério.", arquivo:"federa