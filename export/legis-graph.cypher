01.md"}}, {id:"federal:BR:L:1850/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-04-27", numero:"1850", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-04-27;1850", vigente:true, titulo:"Lei nº 1.850 de 27/04/1953", urn:"urn:lex:br:federal:lei:1953-04-27;1850", ementa:"Abre ao Congresso Nacional créditos especiais para pagamento de gratificação aos funcionários das Secretarias da Câmara dos Deputados e do Senado Federal e aos servidores do Poder Executivo que naquelas exercem suas atividades.", arquivo:"federal/leis-ordinarias/1953/lei-1850-1953-04-27.md"}}, {id:"federal:BR:L:2014/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-10-12", numero:"2014", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-10-12;2014", vigente:true, titulo:"Lei nº 2.014 de 12/10/1953", urn:"urn:lex:br:federal:lei:1953-10-12;2014", ementa:"Concede isenção de tributos, exclusive a taxa de Previdência Social, a materiais importados pela Prefeitura Municipal de Formiga e outras.", arquivo:"federal/leis-ordinarias/1953/lei-2014-1953-10-12.md"}}, {id:"federal:BR:L:2020/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-10-15", numero:"2020", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1953-10-15;2020", vigente:true, titulo:"Lei nº 2.020 de 15/10/1953", urn:"urn:lex:br:federal:lei:1953-10-15;2020", ementa:"Cria na Justiça do Trabalho a Segunda Junta de Conciliação e Julgamento, com sede na cidade de Santos, Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1953/lei-2020-1953-10-15.md"}}, {id:"federal:BR:L:2077/1953", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1953, data:"1953-11-09", numero:"2077", fonte:"https://nor