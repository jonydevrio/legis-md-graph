quivo:"federal/leis-ordinarias/2003/lei-10712-2003-08-12.md"}}, {id:"federal:BR:L:10754/2003", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2003, data:"2003-10-31", numero:"10754", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2003-10-31;10754", vigente:true, titulo:"Lei nº 10.754 de 31/10/2003", urn:"urn:lex:br:federal:lei:2003-10-31;10754", ementa:"Altera a Lei nº 8.989, de 24 de fevereiro de 1995 que \"dispõe sobre a isenção do Imposto Sobre Produtos Industrializados - IPI, na aquisição de automóveis para utilização no transporte autônomo de passageiros, bem como por pessoas portadoras de deficiência física e aos destinados ao transporte escolar, e dá outras providências.\"", arquivo:"federal/leis-ordinarias/2003/lei-10754-2003-10-31.md"}}, {id:"federal:BR:L:10807/2003", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2003, data:"2003-12-12", numero:"10807", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2003-12-12;10807", vigente:true, titulo:"Lei nº 10.807 de 12/12/2003", urn:"urn:lex:br:federal:lei:2003-12-12;10807", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério dos Transportes, crédito especial no valor de R$ 20.000.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2003/lei-10807-2003-12-12.md"}}, {id:"federal:BR:L:10824/2003", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2003, data:"2003-12-22", numero:"10824", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2003-12-22;10824", vigente:true, titulo:"Lei nº 10.824 de 22/12/2003", urn:"urn:lex:br:federal:lei:2003-12-22;10824", ementa:"Denomina \"Aeroporto de Joinville/SC - Lauro Carneiro de Loyola\" o Aeroporto de Joinville, no Estado de Santa Catarina.", arquivo:"federal/leis-ordinarias/2003/lei-10824-2003-12-22.md"}}, {id:"federal:BR:L