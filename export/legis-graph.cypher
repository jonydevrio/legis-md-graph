deral:BR:L:478/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-08-17", numero:"478", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-08-17;478", vigente:true, titulo:"Lei nº 478 de 17/08/1937", urn:"urn:lex:br:federal:lei:1937-08-17;478", ementa:"Autoriza a abrir, pelo Ministério da Viação e Obras Públicas, o crédito   especial de 4.000:000$000, para atender a despesas de pessoal e material da   Estrada de ferro Noroéste do Brasil", arquivo:"federal/leis-ordinarias/1937/lei-478-1937-08-17.md"}}, {id:"federal:BR:L:510/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-09-22", numero:"510", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-09-22;510", vigente:true, titulo:"Lei nº 510 de 22/09/1937", urn:"urn:lex:br:federal:lei:1937-09-22;510", ementa:"Altera o regulamento da Ordem dos Advogados do Brasil", arquivo:"federal/leis-ordinarias/1937/lei-510-1937-09-22.md"}}, {id:"federal:BR:L:405/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-03-16", numero:"405", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-03-16;405", vigente:true, titulo:"Lei nº 405 de 16/03/1937", urn:"urn:lex:br:federal:lei:1937-03-16;405", ementa:"Manda destacar do Orçamento Geral da União para 1937, a importancia de   300:000$ (trezentos contos de réis), afim de concluir a construção dos predios   destinados ás Escolas Normaes Ruraes de Limoeiro e Joazeiro, no Estado do Ceará", arquivo:"federal/leis-ordinarias/1937/lei-405-1937-03-16.md"}}, {id:"federal:BR:L:424/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-04-14", numero:"424", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-04-14;424", vigente:true, titulo:"Lei nº 424 de 14/04/1937", urn:"urn:lex:br:federal:lei:1937-04-14;424", ementa:"Autoriza a abrir pelo Ministério da Educação e Saude Pública, o crédito   especial de 200:103$000, para a aquisição da biblioteca, e objetos de arte que   pertenceram ao escritor Henrique Coelho Neto", arquivo:"federal/leis-ordinarias/1937/lei-424-1937-04-14.md"}}, {id:"federal:BR:L:380/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-01-16", numero:"380", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-01-16;380", vigente:true, titulo:"Lei nº 380 de 16/01/1937", urn:"urn:lex:br:federal:lei:1937-01-16;380", ementa:"Modifica o decreto eplo qual foi creada a Caixa de Aposentadoria e Pensões   dos Trabalhadores em Tropiches e Armazens de Café.", arquivo:"federal/leis-ordinarias/1937/lei-380-1937-01-16.md"}}, {id:"federal:BR:L:526/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-10-05", numero:"526", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-10-05;526", vigente:true, titulo:"Lei nº 526 de 05/10/1937", urn:"urn:lex:br:federal:lei:1937-10-05;526", ementa:"Autoriza a abertura de um crédito especial para pagamento", arquivo:"federal/leis-ordinarias/1937/lei-526-1937-10-05.md"}}, {id:"federal:BR:L:554/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-10-22", numero:"554", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-10-22;554", vigente:true, titulo:"Lei nº 554 de 22/10/1937", urn:"urn:lex:br:federal:lei:1937-10-22;554", ementa:"Autoriza o Poder Executivo a receber em doação um terreno na cidade de   Jaú, Estado de São Paulo", arquivo:"federal/leis-ordinarias/1937/lei-554-1937-10-22.md"}}, {id:"federal:BR:L:420/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-04-10", numero:"420", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-04-10;420", vigente:true, titulo:"Lei nº 420 de 10/04/1937", urn:"urn:lex:br:federal:lei:1937-04-10;420", ementa:"Autoriza o Poder Executivo a assumir a responsabilidade do ativo e passivo da sociedade anônima Companhia de Navegação \"Lloyd Brasileiro\", incorporando todo seu acervo ao patrimônio da União.", arquivo:"federal/leis-ordinarias/1937/lei-420-1937-04-10.md"}}, {id:"federal:BR:L:574/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-11-09", numero:"574", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-11-09;574", vigente:true, titulo:"Lei nº 574 de 09/11/1937", urn:"urn:lex:br:federal:lei:1937-11-09;574", ementa:"Autoriza a abertura de crédito para comemoração do centenário do Colégio   Pedro II", arquivo:"federal/leis-ordinarias/1937/lei-574-1937-11-09.md"}}, {id:"federal:BR:L:400/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-03-04", numero:"400", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-03-04;400", vigente:true, titulo:"Lei nº 400 de 04/03/1937", urn:"urn:lex:br:federal:lei:1937-03-04;400", ementa:";Revigora o credito de 300:000$000 (trezentos contos de réis) destinado   ás obras de restauração do Jardim Botanico.", arquivo:"federal/leis-ordinarias/1937/lei-400-1937-03-04.md"}}, {id:"federal:BR:L:493/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-08-30", numero:"493", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-08-30;493", vigente:true, titulo:"Lei nº 493 de 30/08/1937", urn:"urn:lex:br:federal:lei:1937-08-30;493", ementa:"Autoriza o Poder Executivo a emitir papel-moeda, até a importância de   500.000:000$000, para empréstimo ao Departamento Nacional do   Café.", arquivo:"federal/leis-ordinarias/1937/lei-493-1937-08-30.md"}}, {id:"federal:BR:L:520/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-10-03", numero:"520", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-10-03;520", vigente:true, titulo:"Lei nº 520 de 03/10/1937", urn:"urn:lex:br:federal:lei:1937-10-03;520", ementa:"Autoriza a abertura, pelo Ministério da Viação e Obras Públicas, do   crédito especial de 17.514:198$000, para pagamento de indenização à   Madeira-Mamoré Railway Co. Ltd.", arquivo:"federal/leis-ordinarias/1937/lei-520-1937-10-03.md"}}, {id:"federal:BR:L:482/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-08-23", numero:"482", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-08-23;482", vigente:true, titulo:"Lei nº 482 de 23/08/1937", urn:"urn:lex:br:federal:lei:1937-08-23;482", ementa:"Altera a tabela de direitos aduaneiros sobre o amianto e seus produtos, da   tarifa das Alfândegas, e concede redução especial dêsses direitos à indústria   nacional de fibro-cimento.", arquivo:"federal/leis-ordinarias/1937/lei-482-1937-08-23.md"}}, {id:"federal:BR:L:465/1937", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1937, data:"1937-07-23", numero:"465", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1937-07-23;465", vigente:true, titulo:"Lei nº 465 de 23/07/1937", urn:"urn:lex:br:federal:lei:1937-07-23;465", ementa:"Autoriza a abertura do crédito especial de 250:000$000, destinado à   conclusão do edifício para a agência postal-telegráfica de Pelotas", arquivo:"federal/leis-ordinarias/1937/lei-465-1937-07-23.md"}}, {id:"federal:BR:L:460/1937", properties:{esfera:"federal", versao_t