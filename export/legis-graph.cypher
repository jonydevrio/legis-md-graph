vo:"federal/leis-ordinarias/1959/lei-3563-1959-06-05.md"}}, {id:"federal:BR:L:3590/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-07-22", numero:"3590", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-07-22;3590", vigente:true, titulo:"Lei nº 3.590 de 22/07/1959", urn:"urn:lex:br:federal:lei:1959-07-22;3590", ementa:"Prorroga, até 30 de junho de 1960, o prazo a que se refere o art. 1º, da Lei nº 3.415, de 30 de junho de 1958, e altera dispositivos da Lei nº 1.522, de 26 de dezembro de 1951.", arquivo:"federal/leis-ordinarias/1959/lei-3590-1959-07-22.md"}}, {id:"federal:BR:L:3601/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-07-29", numero:"3601", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-07-29;3601", vigente:true, titulo:"Lei nº 3.601 de 29/07/1959", urn:"urn:lex:br:federal:lei:1959-07-29;3601", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Marinha, o crédito   especial de Cr$ 5.000.000,00, para atender a despesas de qualquer natureza com o   prosseguimento da construção e instalação do Instituto de Pesquisas da   Marinha.", arquivo:"federal/leis-ordinarias/1959/lei-3601-1959-07-29.md"}}, {id:"federal:BR:L:3599/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-07-29", numero:"3599", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-07-29;3599", vigente:true, titulo:"Lei nº 3.599 de 29/07/1959", urn:"urn:lex:br:federal:lei:1959-07-29;3599", ementa:"Substitui a Tabela nº XIX, anexa à Lei nº 1229, de 13 de novembro de 1950 (Altera as carreiras do Quadro III do Ministério da Viação e Obras Públicas - Departamento dos Correios e Telégrafos).", arquivo:"federal/leis-ordinarias/1959/lei-3599-1959-07-29.md"}}, {id:"federal:BR:L:3718/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-24", numero:"3718", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-24;3718", vigente:true, titulo:"Lei nº 3.718 de 24/12/1959", urn:"urn:lex:br:federal:lei:1959-12-24;3718", ementa:"Concede a pensão mensal vitalícia de Cr$ 3.000,00 ao Professor Constantino   Ribeiro Lima.", arquivo:"federal/leis-ordinarias/1959/lei-3718-1959-12-24.md"}}, {id:"federal:BR:L:3681/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-07", numero:"3681", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-07;3681", vigente:true, titulo:"Lei nº 3.681 de 07/12/1959", urn:"urn:lex:br:federal:lei:1959-12-07;3681", ementa:"Dispõe sobre registro de contratos, acordos, ajustes e outros atos   jurídicos análogos, pelo Tribunal de Contas.", arquivo:"federal/leis-ordinarias/1959/lei-3681-1959-12-07.md"}}, {id:"federal:BR:L:3603/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-08-08", numero:"3603", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-08-08;3603", vigente:true, titulo:"Lei nº 3.603 de 08/08/1959", urn:"urn:lex:br:federal:lei:1959-08-08;3603", ementa:"Permite consignação em folha de pagamento de mensalidades e descontos em   favor da Sociedade Beneficente dos Fiscais Aduaneiros de Santos e da Caixa   Beneficente dos Funcionários da Alfândega de Santos.", arquivo:"federal/leis-ordinarias/1959/lei-3603-1959-08-08.md"}}, {id:"federal:BR:L:3639/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-10-06", numero:"3639", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-10-06;3639", vigente:true, titulo:"Lei nº 3.639 de 06/10/1959", urn:"urn:lex:br:federal:lei:1959-10-06;3639", ementa:"Abre ao Poder Legislativo - Subanexo 2.01 - Câmara dos Deputados - o   crédito suplemetar de Cr$ 87.560.000,00 ao Orçamento da União para o exercício   financeiro de 1959.", arquivo:"federal/leis-ordinarias/1959/lei-3639-1959-10-06.md"}}, {id:"federal:BR:L:3677/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-02", numero:"3677", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-02;3677", vigente:true, titulo:"Lei nº 3.677 de 02/12/1959", urn:"urn:lex:br:federal:lei:1959-12-02;3677", ementa:"Concede auxílio especial de Cr$ 100.000,00 à Casa do Universitário   Católico, de Santa Maria, Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1959/lei-3677-1959-12-02.md"}}, {id:"federal:BR:L:3710/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-24", numero:"3710", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-24;3710", vigente:true, titulo:"Lei nº 3.710 de 24/12/1959", urn:"urn:lex:br:federal:lei:1959-12-24;3710", ementa:"Autoriza o Poder Executivo a abrir pelo Minstério da Viação e Obras   Públicas, o crédito especial de Cr$ 20.573.800,00, para ocorrer às despesas com   a reorganização do quadro de pessoal da Estrada de Ferro Santa   Catarina.", arquivo:"federal/leis-ordinarias/1959/lei-3710-1959-12-24.md"}}, {id:"federal:BR:L:3610/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-08-11", numero:"3610", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-08-11;3610", vigente:true, titulo:"Lei nº 3.610 de 11/08/1959", urn:"urn:lex:br:federal:lei:1959-08-11;3610", ementa:"Cria Juntas de Conciliação e Julgamento na 1º Região da Justiça do   Trabalho e dá outras providências.", arquivo:"federal/leis-ordinarias/1959/lei-3610-1959-08-11.md"}}, {id:"federal:BR:L:3551/1959", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-02-13", numero:"3551", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-02-13;3551", vigente:true, titulo:"Lei nº 3.551 de 13/02/1959", urn:"urn:lex:br:federal:lei:1959-02-13;3551", ementa:"Autoriza, através de convênio com o Banco do Brasil S.A., liberação total da safra de trigo de 1958-59, composição das dívidas dos triticultores e dá outras providências.", arquivo:"federal/leis-ordinarias/1959/lei-3551-1959-02-13.md"}}, {id:"federal:BR:L:3651/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-11-03", numero:"3651", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-11-03;3651", vigente:true, titulo:"Lei nº 3.651 de 03/11/1959", urn:"urn:lex:br:federal:lei:1959-11-03;3651", ementa:"Concede a pensão especial de Cr$ 6.500,00 mensais a Josefa Occhioni, viúva   do ex-servidor Pedro Occhioni.", arquivo:"federal/leis-ordinarias/1959/lei-3651-1959-11-03.md"}}, {id:"federal:BR:L:3696/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-18", numero:"3696", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-18;3696", vigente:true, titulo:"Lei nº 3.696 de 18/12/1959", urn:"urn:lex:br:federal:lei:1959-12-18;3696", ementa:"Dispõe sobre naturalização de estangeira casada com brasileiro que exerça   função permanente no exterior.", arquivo:"federal/leis-ordinarias/1959/lei-3696-1959-12-18.md"}}, {id:"federal:BR:L:3687/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-09", numero:"3687", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-09;3687", vigente:true, titulo:"Lei nº 3.687 de 09/12/1959", urn:"urn:lex:br:federal:lei:1959-12-09;3687", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Superior Tribunal   Militar - o crédito especial de Cr$ 405.983,20, para atender ao pagamento, em   exercícios findos, de vencimentos, salário-família, ajuda de custo e   gratificação adicional, de pessoal da Justiça Militar.", arquivo:"federal/leis-ordinarias/1959/lei-3687-1959-12-09.md"}}, {id:"federal:BR:L:3593/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-07-27", numero:"3593", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-07-27;3593", vigente:true, titulo:"Lei nº 3.593 de 27/07/1959", urn:"urn:lex:br:federal:lei:1959-07-27;3593", ementa:"Dispõe sobre o reajustamento automático das aposentadorias e pensões   concedidas pelos Institutos e Caixa de Aposentadoria e Pensões e pelo Instituto   de Previdência e Assistência dos Servidores do Estado.", arquivo:"federal/leis-ordinarias/1959/lei-3593-1959-07-27.md"}}, {id:"federal:BR:L:3526/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-01-03", numero:"3526", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-01-03;3526", vigente:true, titulo:"Lei nº 3.526 de 03/01/1959", urn:"urn:lex:br:federal:lei:1959-01-03;3526", ementa:"Altera o Quadro da Secretaria do Tribunal Regional Eleitoral do Piauí e dá   outras providências.", arquivo:"federal/leis-ordinarias/1959/lei-3526-1959-01-03.md"}}, {id:"federal:BR:L:3701/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-24", numero:"3701", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-24;3701", vigente:true, titulo:"Lei nº 3.701 de 24/12/1959", urn:"urn:lex:br:federal:lei:1959-12-24;3701", ementa:"Retifica, sem ônus, a Lei nº 3.487, de 10 de dezembro de 1958, que estima a   Receita e fixa a Despesa da União para o exercício financeiro de   1959.", arquivo:"federal/leis-ordinarias/1959/lei-3701-1959-12-24.md"}}, {id:"federal:BR:L:3540/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-02-02", numero:"3540", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-02-02;3540", vigente:true, titulo:"Lei nº 3.540 de 02/02/1959", urn:"urn:lex:br:federal:lei:1959-02-02;3540", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras Públicas, o crédito especial de Cr$ 3.750.000.000,00, para atender a despesas com obras de emergência na região assolada pela seca.", arquivo:"federal/leis-ordinarias/1959/lei-3540-1959-02-02.md"}}, {id:"federal:BR:L:3573/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-06-26", numero:"3573", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-06-26;3573", vigente:true, titulo:"Lei nº 3.573 de 26/06/1959", urn:"urn:lex:br:federal:lei:1959-06-26;3573", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário, o crédito especial   de Cr$ 146.863,70, para atender pagamentos de exercícios findos.", arquivo:"federal/leis-ordinarias/1959/lei-3573-1959-06-26.md"}}, {id:"federal:BR:L:3625/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-09-07", numero:"3625", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-09-07;3625", vigente:true, titulo:"Lei nº 3.625 de 07/09/1959", urn:"urn:lex:br:federal:lei:1959-09-07;3625", ementa:"Estende os benefícios do montepío militar às viúvas e órfãos dos cabos, soldados, fuzileiros navais, marinheiros e taifeiros das Forças Armadas, da Polícia Militar e do Corpo de Bombeiros do Distrito Federal, falecidos antes da Lei n° 488, de 15 de novembro de 1948; e dá outras providências.", arquivo:"federal/leis-ordinarias/1959/lei-3625-1959-09-07.md"}}, {id:"federal:BR:L:3583/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-07-15", numero:"3583", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-07-15;3583", vigente:true, titulo:"Lei nº 3.583 de 15/07/1959", urn:"urn:lex:br:federal:lei:1959-07-15;3583", ementa:"Concede o auxílio de Cr$ 200.000,00 ao Rotary Clube de Taubaté, no Estado   de São Paulo, pela realização da VI Semana Nacional Monteiro Lobato naquela   cidade.", arquivo:"federal/leis-ordinarias/1959/lei-3583-1959-07-15.md"}}, {id:"federal:BR:L:3556/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-05-17", numero:"3556", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-05-17;3556", vigente:true, titulo:"Lei nº 3.556 de 17/05/1959", urn:"urn:lex:br:federal:lei:1959-05-17;3556", ementa:"Cria agências postais nas Vilas de Poções (Montalvânia), Município de   Manga, e Caçaratiba, Município de Turmalina, no Estado de Minas Gerais, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1959/lei-3556-1959-05-17.md"}}, {id:"federal:BR:L:3679/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-04", numero:"3679", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-04;3679", vigente:true, titulo:"Lei nº 3.679 de 04/12/1959", urn:"urn:lex:br:federal:lei:1959-12-04;3679", ementa:"Autoriza o Poder Executivo a abrir, pelo Poder Judiciário - Justiça   Eleitoral - Tribunal Superior Eleitoral e Tribunais Regionais, o crédito   suplementar de Cr$ 39.153.636,70, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1959/lei-3679-1959-12-04.md"}}, {id:"federal:BR:L:3633/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-09-17", numero:"3633", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-09-17;3633", vigente:true, titulo:"Lei nº 3.633 de 17/09/1959", urn:"urn:lex:br:federal:lei:1959-09-17;3633", ementa:"Concede pensões especiais de Cr$ 3.000,00 mensais às viúvas dos   ex-integrantes da Força Expedicionária Brasileira e aos ex-expedicionários   incapacitados para o trabalho.", arquivo:"federal/leis-ordinarias/1959/lei-3633-1959-09-17.md"}}, {id:"federal:BR:L:3554/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-04-29", numero:"3554", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-04-29;3554", vigente:true, titulo:"Lei nº 3.554 de 29/04/1959", urn:"urn:lex:br:federal:lei:1959-04-29;3554", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Saúde, o crédito   especial de Cr$ 14.000.000,00 destinado à cobertura do deficit da Santa Casa de   Misericórdia de Santos, Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1959/lei-3554-1959-04-29.md"}}, {id:"federal:BR:L:3667/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-11-17", numero:"3667", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-11-17;3667", vigente:true, titulo:"Lei nº 3.667 de 17/11/1959", urn:"urn:lex:br:federal:lei:1959-11-17;3667", ementa:"Autoriza o Poder Executivo a abrir o crédito especial de Cr$ 150.666,30,   destinado ao pagamento de diferença de vencimentos a funcionários da secretaria   do Senado Federal.", arquivo:"federal/leis-ordinarias/1959/lei-3667-1959-11-17.md"}}, {id:"federal:BR:L:3522/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-01-03", numero:"3522", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-01-03;3522", vigente:true, titulo:"Lei nº 3.522 de 03/01/1959", urn:"urn:lex:br:federal:lei:1959-01-03;3522", ementa:"Autoriza o Poder Executivo a encampar parte das emissões de papel-moeda   feitas para atender a operações da Caixa de Mobilização Bancária, mediante a   incorporação ao Patrimônio Nacional, de imóvel pertencente àquela Autarquia, e   transferir esse imóvel à propriedade da Legião Brasileira de   Assistência.", arquivo:"federal/leis-ordinarias/1959/lei-3522-1959-01-03.md"}}, {id:"federal:BR:L:3617/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-08-25", numero:"3617", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-08-25;3617", vigente:true, titulo:"Lei nº 3.617 de 25/08/1959", urn:"urn:lex:br:federal:lei:1959-08-25;3617", ementa:"Isenta dos impostos de importação e consumo e de taxas aduaneiras   meteriais importados pela Mecânica Pesada S.A.", arquivo:"federal/leis-ordinarias/1959/lei-3617-1959-08-25.md"}}, {id:"federal:BR:L:3683/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-09", numero:"3683", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-09;3683", vigente:true, titulo:"Lei nº 3.683 de 09/12/1959", urn:"urn:lex:br:federal:lei:1959-12-09;3683", ementa:"Concede isenção de direitos para importação de peças e materiais   destinados à fabricação, no país, de centrais telefônicas automáticas para   serviços públicos.", arquivo:"federal/leis-ordinarias/1959/lei-3683-1959-12-09.md"}}, {id:"federal:BR:L:3641/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-10-10", numero:"3641", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-10-10;3641", vigente:true, titulo:"Lei nº 3.641 de 10/10/1959", urn:"urn:lex:br:federal:lei:1959-10-10;3641", ementa:"Dá nova redação aos parágrafos do art. 16 da Lei nº 1.254, de 4 de dezembro   de 1950.", arquivo:"federal/leis-ordinarias/1959/lei-3641-1959-10-10.md"}}, {id:"federal:BR:L:3580/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-07-10", numero:"3580", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-07-10;3580", vigente:true, titulo:"Lei nº 3.580 de 10/07/1959", urn:"urn:lex:br:federal:lei:1959-07-10;3580", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Tribunal Federal   de Recursos - o crédito especial de Cr$ 7.277.091,50, para atender às despesas   do abono provisório de 30% aos servidores da Secretaria do mesmo   Tribunal.", arquivo:"federal/leis-ordinarias/1959/lei-3580-1959-07-10.md"}}, {id:"federal:BR:L:3622/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-09-02", numero:"3622", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-09-02;3622", vigente:true, titulo:"Lei nº 3.622 de 02/09/1959", urn:"urn:lex:br:federal:lei:1959-09-02;3622", ementa:"Cria cargos no Quadro do Pessoal da Justiça do Trabalho da 2ª Região, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1959/lei-3622-1959-09-02.md"}}, {id:"federal:BR:L:3657/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-11-10", numero:"3657", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-11-10;3657", vigente:true, titulo:"Lei nº 3.657 de 10/11/1959", urn:"urn:lex:br:federal:lei:1959-11-10;3657", ementa:"Inclui escolas superiores entre os estabelecimentos subvencionados pelo   Governo Federal.", arquivo:"federal/leis-ordinarias/1959/lei-3657-1959-11-10.md"}}, {id:"federal:BR:L:3714/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-24", numero:"3714", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-24;3714", vigente:true, titulo:"Lei nº 3.714 de 24/12/1959", urn:"urn:lex:br:federal:lei:1959-12-24;3714", ementa:"Retifica, sem ônus, a Lei nº 3.487, de 10 de dezembro de 1958, que estima a   Receita e fixa a Despesa da União para o exercício financeiro de   1959.", arquivo:"federal/leis-ordinarias/1959/lei-3714-1959-12-24.md"}}, {id:"federal:BR:L:3644/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-10-15", numero:"3644", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-10-15;3644", vigente:true, titulo:"Lei nº 3.644 de 15/10/1959", urn:"urn:lex:br:federal:lei:1959-10-15;3644", ementa:"Altera o Quadro da Secretaria do Tribunal Regional Eleitoral do Pará, e dá outras providências.", arquivo:"federal/leis-ordinarias/1959/lei-3644-1959-10-15.md"}}, {id:"federal:BR:L:3670/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-11-24", numero:"3670", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-11-24;3670", vigente:true, titulo:"Lei nº 3.670 de 24/11/1959", urn:"urn:lex:br:federal:lei:1959-11-24;3670", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Saúde, o crédito   especial de Cr$ 5.500.000,00, destinado ao pagamento de dívida contraída pela   Liga Baiana Contra o Câncer.", arquivo:"federal/leis-ordinarias/1959/lei-3670-1959-11-24.md"}}, {id:"federal:BR:L:3673/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-11-30", numero:"3673", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-11-30;3673", vigente:true, titulo:"Lei nº 3.673 de 30/11/1959", urn:"urn:lex:br:federal:lei:1959-11-30;3673", ementa:"Dispõe sobre declarações de aspirantes a oficial, de primeiros e segundos   tenentes da Polícia Militar do Distrito Federal.", arquivo:"federal/leis-ordinarias/1959/lei-3673-1959-11-30.md"}}, {id:"federal:BR:L:3680/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-04", numero:"3680", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-04;3680", vigente:true, titulo:"Lei nº 3.680 de 04/12/1959", urn:"urn:lex:br:federal:lei:1959-12-04;3680", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça Eleitoral - o crédito especial de Cr$ 4.240.132,30, para atender a despesas correspondentes aos exercícios de 1945 a 1958.", arquivo:"federal/leis-ordinarias/1959/lei-3680-1959-12-04.md"}}, {id:"federal:BR:L:3723/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-24", numero:"3723", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-24;3723", vigente:true, titulo:"Lei nº 3.723 de 24/12/1959", urn:"urn:lex:br:federal:lei:1959-12-24;3723", ementa:"Retifica, sem ônus, a Lei nº 3.487, de 10 de dezembro de 1958, que estima a   Receita e fixa a Despesa da união para o exercício financeiro de   1959.", arquivo:"federal/leis-ordinarias/1959/lei-3723-1959-12-24.md"}}, {id:"federal:BR:L:3548/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-02-11", numero:"3548", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-02-11;3548", vigente:true, titulo:"Lei nº 3.548 de 11/02/1959", urn:"urn:lex:br:federal:lei:1959-02-11;3548", ementa:"Concede o auxílio de Cr$ 2.000.000,00 ao Município de Machado, no Estado   de Minas Gerais.", arquivo:"federal/leis-ordinarias/1959/lei-3548-1959-02-11.md"}}, {id:"federal:BR:L:3588/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-07-18", numero:"3588", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-07-18;3588", vigente:true, titulo:"Lei nº 3.588 de 18/07/1959", urn:"urn:lex:br:federal:lei:1959-07-18;3588", ementa:"Concede a pensão especial de Cr$ 3.000,00 mensais a Felizardo Avelino de   Cerqueira, guia da Comissão Demarcadora de Limites Brasil-Peru.", arquivo:"federal/leis-ordinarias/1959/lei-3588-1959-07-18.md"}}, {id:"federal:BR:L:3595/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-07-29", numero:"3595", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-07-29;3595", vigente:true, titulo:"Lei nº 3.595 de 29/07/1959", urn:"urn:lex:br:federal:lei:1959-07-29;3595", ementa:"Concede o auxílio de Cr$ 1.500.000,00 à Prefeitura Municipal de Guamá, no   Estado do Pará.", arquivo:"federal/leis-ordinarias/1959/lei-3595-1959-07-29.md"}}, {id:"federal:BR:L:3632/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-09-10", numero:"3632", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-09-10;3632", vigente:true, titulo:"Lei nº 3.632 de 10/09/1959", urn:"urn:lex:br:federal:lei:1959-09-10;3632", ementa:"Inclui no Serviço de Saúde da Aeronáutica, no posto de 2º Tenente, as   enfermeiras que integraram a Força Aérea Brasileira, durante as operações de   guerra na Itália.", arquivo:"federal/leis-ordinarias/1959/lei-3632-1959-09-10.md"}}, {id:"federal:BR:L:3571/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-06-20", numero:"3571", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-06-20;3571", vigente:true, titulo:"Lei nº 3.571 de 20/06/1959", urn:"urn:lex:br:federal:lei:1959-06-20;3571", ementa:"Prorroga a vigência do crédito especial de que trata a Lei nº 3.032, de 19 de dezembro de 1956, e revigora, por mais dois exercícios a Lei nº 3.017, de 17 de dezembro de 1956.", arquivo:"federal/leis-ordinarias/1959/lei-3571-1959-06-20.md"}}, {id:"federal:BR:L:3613/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-08-12", numero:"3613", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-08-12;3613", vigente:true, titulo:"Lei nº 3.613 de 12/08/1959", urn:"urn:lex:br:federal:lei:1959-08-12;3613", ementa:"Inclui a rodovia que liga os municípios de Limeira, Pirassununga, Ribeirão   Preto, Igarapava e Delta, no Estado de São Paulo; Uberaba, Uberlândia e   Araguari, no Estado de Minas Gerais; Catalão e Cristalino, no Estado de Goiás; e   Brasília no Plano Rodoviário Nacional.", arquivo:"federal/leis-ordinarias/1959/lei-3613-1959-08-12.md"}}, {id:"federal:BR:L:3552/1959", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-02-16", numero:"3552", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-02-16;3552", vigente:true, titulo:"Lei nº 3.552 de 16/02/1959", urn:"urn:lex:br:federal:lei:1959-02-16;3552", ementa:"Dispõe sobre nova organização escolar e administrativa dos estabelecimentos de ensino industrial do Ministério da Educação e Cultura, e dá outras providências.", arquivo:"federal/leis-ordinarias/1959/lei-3552-1959-02-16.md"}}, {id:"federal:BR:L:3705/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-24", numero:"3705", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-24;3705", vigente:true, titulo:"Lei nº 3.705 de 24/12/1959", urn:"urn:lex:br:federal:lei:1959-12-24;3705", ementa:"Transforma em extranumerário-mensalista o pessoal do Estabelecimento   Comercial de Material de Intendência, do Ministério da Guerra.", arquivo:"federal/leis-ordinarias/1959/lei-3705-1959-12-24.md"}}, {id:"federal:BR:L:3539/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-02-02", numero:"3539", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-02-02;3539", vigente:true, titulo:"Lei nº 3.539 de 02/02/1959", urn:"urn:lex:br:federal:lei:1959-02-02;3539", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 3.000.000,00, para auxiliar a reconstrução da Igreja do Sagrado Coração de Jesus, na cidade de Fortaleza, capital do Estado do Ceará.", arquivo:"federal/leis-ordinarias/1959/lei-3539-1959-02-02.md"}}, {id:"federal:BR:L:3534/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-01-26", numero:"3534", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-01-26;3534", vigente:true, titulo:"Lei nº 3.534 de 26/01/1959", urn:"urn:lex:br:federal:lei:1959-01-26;3534", ementa:"Concede isenção de direitos, imposto de consumo e taxas alfandegárias para a importação de 8.400.000 kg de gêneros alimentícios doados pela War Relief Service (NCWC).", arquivo:"federal/leis-ordinarias/1959/lei-3534-1959-01-26.md"}}, {id:"federal:BR:L:3646/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-10-22", numero:"3646", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-10-22;3646", vigente:true, titulo:"Lei nº 3.646 de 22/10/1959", urn:"urn:lex:br:federal:lei:1959-10-22;3646", ementa:"Cria a Escola de Viticultura e Enologia de Bento Gonçalves, no Estado do   Rio Grande do Sul, e dá outras providências.", arquivo:"federal/leis-ordinarias/1959/lei-3646-1959-10-22.md"}}, {id:"federal:BR:L:3568/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-06-11", numero:"3568", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-06-11;3568", vigente:true, titulo:"Lei nº 3.568 de 11/06/1959", urn:"urn:lex:br:federal:lei:1959-06-11;3568", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 15.000.000,00, para atender despesas com as novas   instalações do Colégio Pedro II - Internato.", arquivo:"federal/leis-ordinarias/1959/lei-3568-1959-06-11.md"}}, {id:"federal:BR:L:3521/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-01-02", numero:"3521", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-01-02;3521", vigente:true, titulo:"Lei nº 3.521 de 02/01/1959", urn:"urn:lex:br:federal:lei:1959-01-02;3521", ementa:"Modifica o art. 2º da Lei nº 2.395, de 11 de janeiro de 1955, que cria   dois Distritos de 1ª classe no Departamento Nacional das Obras e dá outras   providências.", arquivo:"federal/leis-ordinarias/1959/lei-3521-1959-01-02.md"}}, {id:"federal:BR:L:3635/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-09-22", numero:"3635", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-09-22;3635", vigente:true, titulo:"Lei nº 3.635 de 22/09/1959", urn:"urn:lex:br:federal:lei:1959-09-22;3635", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura, os créditos especiais de Cr$ 1.000.000,00 e Cr$ 500.000,00, para pagamento das subvenções concedidas, respectivamente, a Academia Brasileira de Ciências e ao Instituto do Nordeste.", arquivo:"federal/leis-ordinarias/1959/lei-3635-1959-09-22.md"}}, {id:"federal:BR:L:3592/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-07-22", numero:"3592", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-07-22;3592", vigente:true, titulo:"Lei nº 3.592 de 22/07/1959", urn:"urn:lex:br:federal:lei:1959-07-22;3592", ementa:"Concede a pensão vitalícia de Cr$ 3.000,00 mensais ao Dr. Pacífico Lopes   de Siqueira.", arquivo:"federal/leis-ordinarias/1959/lei-3592-1959-07-22.md"}}, {id:"federal:BR:L:3629/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-09-10", numero:"3629", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-09-10;3629", vigente:true, titulo:"Lei nº 3.629 de 10/09/1959", urn:"urn:lex:br:federal:lei:1959-09-10;3629", ementa:"Dá o nome de Washington Luiz à Rodovia Rio-Petrópolis.", arquivo:"federal/leis-ordinarias/1959/lei-3629-1959-09-10.md"}}, {id:"federal:BR:L:3665/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-11-17", numero:"3665", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-11-17;3665", vigente:true, titulo:"Lei nº 3.665 de 17/11/1959", urn:"urn:lex:br:federal:lei:1959-11-17;3665", ementa:"Autoriza o Poder Executivo a construir o trecho da estrada de ferro que vai de   Bragança, no Estado do Pará, atingindo o melhor ponto da Estrada de Ferro São Luiz   - Terezina, e dá outras providências.", arquivo:"federal/leis-ordinarias/1959/lei-3665-1959-11-17.md"}}, {id:"federal:BR:L:3605/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-08-08", numero:"3605", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-08-08;3605", vigente:true, titulo:"Lei nº 3.605 de 08/08/1959", urn:"urn:lex:br:federal:lei:1959-08-08;3605", ementa:"Autoriza o Poder Executivo a abrir, através do Ministério da Fazenda, o   crédito especial de Cr$ 3.800.000,00, para pagamento de exercícios findos devido   aos funcionários aposentados da Secretaria da Câmara dos   Deputados.", arquivo:"federal/leis-ordinarias/1959/lei-3605-1959-08-08.md"}}, {id:"federal:BR:L:3621/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-08-28", numero:"3621", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-08-28;3621", vigente:true, titulo:"Lei nº 3.621 de 28/08/1959", urn:"urn:lex:br:federal:lei:1959-08-28;3621", ementa:"Permite a fixação de época especial, no ano letivo de 1959, para a   prestação de exames finais, do 5º ano das Faculdades de Direito de todo o País,   e dá outras providências.", arquivo:"federal/leis-ordinarias/1959/lei-3621-1959-08-28.md"}}, {id:"federal:BR:L:3712/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-24", numero:"3712", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-24;3712", vigente:true, titulo:"Lei nº 3.712 de 24/12/1959", urn:"urn:lex:br:federal:lei:1959-12-24;3712", ementa:"Concede a pensão especial de Cr$ 3.000,00 mensais a Lydia Heidtmann Gomes,   viúva do maquinista Francisco de Souza Gomes.", arquivo:"federal/leis-ordinarias/1959/lei-3712-1959-12-24.md"}}, {id:"federal:BR:L:3655/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-11-10", numero:"3655", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-11-10;3655", vigente:true, titulo:"Lei nº 3.655 de 10/11/1959", urn:"urn:lex:br:federal:lei:1959-11-10;3655", ementa:"Concede a pensão especial de Cr$ 3.000,00 mensais a Francisca Philemon de   Mascarenhas, viúva de Francisco de Assis Mascarenhas.", arquivo:"federal/leis-ordinarias/1959/lei-3655-1959-11-10.md"}}, {id:"federal:BR:L:3661/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-11-13", numero:"3661", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-11-13;3661", vigente:true, titulo:"Lei nº 3.661 de 13/11/1959", urn:"urn:lex:br:federal:lei:1959-11-13;3661", ementa:"Isenta de imposto de consumo portas de bronze adquiridas pela Basílica de   Nossa Senhora de Nazaré, em Belém.", arquivo:"federal/leis-ordinarias/1959/lei-3661-1959-11-13.md"}}, {id:"federal:BR:L:3612/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-08-11", numero:"3612", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-08-11;3612", vigente:true, titulo:"Lei nº 3.612 de 11/08/1959", urn:"urn:lex:br:federal:lei:1959-08-11;3612", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 700.000.000,00, para ocorrer a despesas de exercícios encerrados.", arquivo:"federal/leis-ordinarias/1959/lei-3612-1959-08-11.md"}}, {id:"federal:BR:L:3698/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-18", numero:"3698", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-18;3698", vigente:true, titulo:"Lei nº 3.698 de 18/12/1959", urn:"urn:lex:br:federal:lei:1959-12-18;3698", ementa:"Concede pensão mensal a Alba Coelho Sales, viúva do ex-Ministro Eurico de   Aguiar Sales.", arquivo:"federal/leis-ordinarias/1959/lei-3698-1959-12-18.md"}}, {id:"federal:BR:L:3630/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-09-10", numero:"3630", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-09-10;3630", vigente:true, titulo:"Lei nº 3.630 de 10/09/1959", urn:"urn:lex:br:federal:lei:1959-09-10;3630", ementa:"Assegura às culturas do bacilo Calmette-Guerin (BCG), destinadas ao   intercâmbio científico, todas as facilidades postais relativas ao transporte   aéreo ou marítimo.", arquivo:"federal/leis-ordinarias/1959/lei-3630-1959-09-10.md"}}, {id:"federal:BR:L:3546/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-02-11", numero:"3546", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-02-11;3546", vigente:true, titulo:"Lei nº 3.546 de 11/02/1959", urn:"urn:lex:br:federal:lei:1959-02-11;3546", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Viação e Obras   Públicas, em favor da Cia. Nacional de Navegação Costeira, o crédito especial de   Cr$ 210.000.000,00, para atender ao pagamento da importância adiantada pelo   Banco Nacional do Desenvolvimento Ecônomico, nos termos do art, 25, parágrafo   único, da Lei nº 1.628, de 20 de junho de 1952.", arquivo:"federal/leis-ordinarias/1959/lei-3546-1959-02-11.md"}}, {id:"federal:BR:L:3721/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-24", numero:"3721", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-24;3721", vigente:true, titulo:"Lei nº 3.721 de 24/12/1959", urn:"urn:lex:br:federal:lei:1959-12-24;3721", ementa:"Altera disposições da Lei nº 3.487, de 10 de dezembro de 1958, que estima a   Receita e fixa a Despesa da União para o exercício financeiro de   1959.", arquivo:"federal/leis-ordinarias/1959/lei-3721-1959-12-24.md"}}, {id:"federal:BR:L:3586/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-07-18", numero:"3586", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-07-18;3586", vigente:true, titulo:"Lei nº 3.586 de 18/07/1959", urn:"urn:lex:br:federal:lei:1959-07-18;3586", ementa:"Concede pensão vitalícia ao médico Antônio Tolentino residente na Cidade   de Sêrro, em Minas Gerais.", arquivo:"federal/leis-ordinarias/1959/lei-3586-1959-07-18.md"}}, {id:"federal:BR:L:3703/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-24", numero:"3703", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-24;3703", vigente:true, titulo:"Lei nº 3.703 de 24/12/1959", urn:"urn:lex:br:federal:lei:1959-12-24;3703", ementa:"Concede o auxílio de Cr$ 42.000.000,00 a populações ribeirinhas vítimas de   inundações.", arquivo:"federal/leis-ordinarias/1959/lei-3703-1959-12-24.md"}}, {id:"federal:BR:L:3537/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-02-02", numero:"3537", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-02-02;3537", vigente:true, titulo:"Lei nº 3.537 de 02/02/1959", urn:"urn:lex:br:federal:lei:1959-02-02;3537", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura, o crédito especial de Cr$ 100.000.000,00 destinado à concessão de bolsas de estudos a estudantes.", arquivo:"federal/leis-ordinarias/1959/lei-3537-1959-02-02.md"}}, {id:"federal:BR:L:3643/1959", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-10-14", numero:"3643", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-10-14;3643", vigente:true, titulo:"Lei nº 3.643 de 14/10/1959", urn:"urn:lex:br:federal:lei:1959-10-14;3643", ementa:"Prorroga o prazo de pagamento dos débitos dos cafeicultores amparados pelas Leis n°s. 2.095, de 16 de novembro de 1953, 2.297, de 27 de dezembro de 1955 e 3.393, de 27 de maio de 1958, e dá outras providências.", arquivo:"federal/leis-ordinarias/1959/lei-3643-1959-10-14.md"}}, {id:"federal:BR:L:3575/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-06-26", numero:"3575", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-06-26;3575", vigente:true, titulo:"Lei nº 3.575 de 26/06/1959", urn:"urn:lex:br:federal:lei:1959-06-26;3575", ementa:"Dispõe sobre a constituição e Administração dos Estabelecimentos Ministro   Mallet (EMM).", arquivo:"federal/leis-ordinarias/1959/lei-3575-1959-06-26.md"}}, {id:"federal:BR:L:3618/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-08-26", numero:"3618", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-08-26;3618", vigente:true, titulo:"Lei nº 3.618 de 26/08/1959", urn:"urn:lex:br:federal:lei:1959-08-26;3618", ementa:"Concede a pensão especial de Cr$ 3.000,00, mensais, a Elza Borges Tavares,   filha de Joaquim de Lima Tavares.", arquivo:"federal/leis-ordinarias/1959/lei-3618-1959-08-26.md"}}, {id:"federal:BR:L:3689/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-14", numero:"3689", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-14;3689", vigente:true, titulo:"Lei nº 3.689 de 14/12/1959", urn:"urn:lex:br:federal:lei:1959-12-14;3689", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura,   o crédito especial de Cr$ 3.000.000,00 para ocorrer a despesas feitas com a   promoção do Campeonato Pan-Americano do Boxe e Mundial de Judô.", arquivo:"federal/leis-ordinarias/1959/lei-3689-1959-12-14.md"}}, {id:"federal:BR:L:3634/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-09-18", numero:"3634", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-09-18;3634", vigente:true, titulo:"Lei nº 3.634 de 18/09/1959", urn:"urn:lex:br:federal:lei:1959-09-18;3634", ementa:"Autoriza o Poder Executivo a estabelecer convênio com o Banco do Brasil   para liberação da safra de arroz de 1958-59, composição de dívidas e   financiamentos aos produtores vítima de inundações e chuvas excessivas   verificadas no Rio Grande do Sul e Mato Grosso.", arquivo:"federal/leis-ordinarias/1959/lei-3634-1959-09-18.md"}}, {id:"federal:BR:L:3627/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-09-07", numero:"3627", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-09-07;3627", vigente:true, titulo:"Lei nº 3.627 de 07/09/1959", urn:"urn:lex:br:federal:lei:1959-09-07;3627", ementa:"Concede a pensão especial de Cr$ 5.000,00 (cinco mil cruzeiros), ao   artista José De Francesco.", arquivo:"federal/leis-ordinarias/1959/lei-3627-1959-09-07.md"}}, {id:"federal:BR:L:3668/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-11-18", numero:"3668", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-11-18;3668", vigente:true, titulo:"Lei nº 3.668 de 18/11/1959", urn:"urn:lex:br:federal:lei:1959-11-18;3668", ementa:"Concede isençao de tributos para material de propaganda do 36º Congresso   Eucarístico Internacional.", arquivo:"federal/leis-ordinarias/1959/lei-3668-1959-11-18.md"}}, {id:"federal:BR:L:3694/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-18", numero:"3694", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-18;3694", vigente:true, titulo:"Lei nº 3.694 de 18/12/1959", urn:"urn:lex:br:federal:lei:1959-12-18;3694", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Justiça e Negócios Interiores, o crédito suplementar de Cr$ 2.500.000,00, em reforço da dotação atribuída, no exercício de 1959, ao Corpo de Bombeiros do Distrito Federal.", arquivo:"federal/leis-ordinarias/1959/lei-3694-1959-12-18.md"}}, {id:"federal:BR:L:3542/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-02-11", numero:"3542", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-02-11;3542", vigente:true, titulo:"Lei nº 3.542 de 11/02/1959", urn:"urn:lex:br:federal:lei:1959-02-11;3542", ementa:"Institui a Campanha Nacional contra a Lepra e dá outras providências.", arquivo:"federal/leis-ordinarias/1959/lei-3542-1959-02-11.md"}}, {id:"federal:BR:L:3558/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-05-17", numero:"3558", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-05-17;3558", vigente:true, titulo:"Lei nº 3.558 de 17/05/1959", urn:"urn:lex:br:federal:lei:1959-05-17;3558", ementa:"Concede o auxílio de Cr$ 3.000.000,00 ao Educandário Espírita e Escola   Doméstica de Araguari, Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/1959/lei-3558-1959-05-17.md"}}, {id:"federal:BR:L:3550/1959", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-02-12", numero:"3550", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-02-12;3550", vigente:true, titulo:"Lei nº 3.550 de 12/02/1959", urn:"urn:lex:br:federal:lei:1959-02-12;3550", ementa:"Dispõe sobre o pagamento de subvenções orçamentárias concedidas à conta do Fundo Nacional do Ensino Médio.", arquivo:"federal/leis-ordinarias/1959/lei-3550-1959-02-12.md"}}, {id:"federal:BR:L:3685/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-09", numero:"3685", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-09;3685", vigente:true, titulo:"Lei nº 3.685 de 09/12/1959", urn:"urn:lex:br:federal:lei:1959-12-09;3685", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e   Cultura,o crédito especial de Cr$ 3.000.000,00, para custear as despesas de   reedição das obras do Cônego Joaquim Caetano Fernandes Pinheiro.", arquivo:"federal/leis-ordinarias/1959/lei-3685-1959-12-09.md"}}, {id:"federal:BR:L:3524/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-01-03", numero:"3524", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-01-03;3524", vigente:true, titulo:"Lei nº 3.524 de 03/01/1959", urn:"urn:lex:br:federal:lei:1959-01-03;3524", ementa:"Cria uma Coletoria Federal, em Mossoró, Estado do Rio Grande do Norte, em   substituição à Mesa de Rendas Alfandegada existente naquela cidade, e dá outras   providências.", arquivo:"federal/leis-ordinarias/1959/lei-3524-1959-01-03.md"}}, {id:"federal:BR:L:3672/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-11-24", numero:"3672", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-11-24;3672", vigente:true, titulo:"Lei nº 3.672 de 24/11/1959", urn:"urn:lex:br:federal:lei:1959-11-24;3672", ementa:"Autoriza o Poder Executivo a abrir o crédito especial de Cr$ 3.000.000,00,   para atender a despesas com o Campeonato Mundial de Vela da Classe Snipe, a   realizar-se em Porto Alegre.", arquivo:"federal/leis-ordinarias/1959/lei-3672-1959-11-24.md"}}, {id:"federal:BR:L:3716/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-24", numero:"3716", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-24;3716", vigente:true, titulo:"Lei nº 3.716 de 24/12/1959", urn:"urn:lex:br:federal:lei:1959-12-24;3716", ementa:"Autoriza o Poder Executivo a abrir pelo Ministério da Guerra, o crédito   especial de Cr$ 767.569,00 para atender às despesas decorrentes da execução da   Lei nº 2.188, de 3 de março de 1954.", arquivo:"federal/leis-ordinarias/1959/lei-3716-1959-12-24.md"}}, {id:"federal:BR:L:3690/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-14", numero:"3690", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-14;3690", vigente:true, titulo:"Lei nº 3.690 de 14/12/1959", urn:"urn:lex:br:federal:lei:1959-12-14;3690", ementa:"Autoriza a abertura do crédito suplementar de Cr$ 555.379.320,00 ao   Orçamento do Ministério da Fazenda.", arquivo:"federal/leis-ordinarias/1959/lei-3690-1959-12-14.md"}}, {id:"federal:BR:L:3582/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-07-10", numero:"3582", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-07-10;3582", vigente:true, titulo:"Lei nº 3.582 de 10/07/1959", urn:"urn:lex:br:federal:lei:1959-07-10;3582", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Supremo Tribunal   Federal - o crédito especial de Cr$ 7.736.400,00, para pagamento no exercício de   1959, do abono provisório de 30% aos servidores da Secretaria do mesmo   Tribunal.", arquivo:"federal/leis-ordinarias/1959/lei-3582-1959-07-10.md"}}, {id:"federal:BR:L:3624/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-09-02", numero:"3624", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-09-02;3624", vigente:true, titulo:"Lei nº 3.624 de 02/09/1959", urn:"urn:lex:br:federal:lei:1959-09-02;3624", ementa:"Dispõe sobre diploma e certificado que deverão suprir as exigências para   inscrição em concurso de habilitação às Escolas de Arquitetura.", arquivo:"federal/leis-ordinarias/1959/lei-3624-1959-09-02.md"}}, {id:"federal:BR:L:3675/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-12-02", numero:"3675", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-12-02;3675", vigente:true, titulo:"Lei nº 3.675 de 02/12/1959", urn:"urn:lex:br:federal:lei:1959-12-02;3675", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Marinha, o crédito   especial de Cr$ 13.690.891,90, para pagamento de diferença de proventos de   inatividade.", arquivo:"federal/leis-ordinarias/1959/lei-3675-1959-12-02.md"}}, {id:"federal:BR:L:3597/1959", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-07-29", numero:"3597", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-07-29;3597", vigente:true, titulo:"Lei nº 3.597 de 29/07/1959", urn:"urn:lex:br:federal:lei:1959-07-29;3597", ementa:"Concede a pensão vitalícia de Cr$ 8.000,00 mensais a Albina Clementina Frascalossi Sanson, viúva do Deputado Sílvio Sanson.", arquivo:"federal/leis-ordinarias/1959/lei-3597-1959-07-29.md"}}, {id:"federal:BR:L:3615/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-08-12", numero:"3615", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-08-12;3615", vigente:true, titulo:"Lei nº 3.615 de 12/08/1959", urn:"urn:lex:br:federal:lei:1959-08-12;3615", ementa:"Dispõe sobre a contagem de tempo de serviço de funcionários públicos   civis.", arquivo:"federal/leis-ordinarias/1959/lei-3615-1959-08-12.md"}}, {id:"federal:BR:L:3616/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-08-20", numero:"3616", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-08-20;3616", vigente:true, titulo:"Lei nº 3.616 de 20/08/1959", urn:"urn:lex:br:federal:lei:1959-08-20;3616", ementa:"Autoriza o Poder Executivo a doar à Prefeitura Municipal de Cuibá, Estado   de Mato Grosso, área de terras de proprieda