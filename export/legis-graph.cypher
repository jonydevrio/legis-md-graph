po:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-05-30", numero:"6417", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-05-30;6417", vigente:true, titulo:"Lei nº 6.417 de 30/05/1977", urn:"urn:lex:br:federal:lei:1977-05-30;6417", ementa:"Autoriza o Instituto Brasileiro de Desenvolvimento Florestal - IBDF - a   permutar o imóvel que menciona.", arquivo:"federal/leis-ordinarias/1977/lei-6417-1977-05-30.md"}}, {id:"federal:BR:L:6458/1977", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-11-01", numero:"6458", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-11-01;6458", vigente:true, titulo:"Lei nº 6.458 de 01/11/1977", urn:"urn:lex:br:federal:lei:1977-11-01;6458", ementa:"Adapta ao Código de Processo Civil a Lei n° ;5.474, de 18 de julho de 1968, e dá outras providências.", arquivo:"federal/leis-ordinarias/1977/lei-6458-1977-11-01.md"}}, {id:"federal:BR:L:6452/1977", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-10-17", numero:"6452", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-10-17;6452", vigente:true, titulo:"Lei nº 6.452 de 17/10/1977", urn:"urn:lex:br:federal:lei:1977-10-17;6452", ementa:"Concede pensão especial a Nair Viana Café, vítima do torpedeamento do   navio Afonso Pena, durante a Segunda Guerra Mundial.", arquivo:"federal/leis-ordinarias/1977/lei-6452-1977-10-17.md"}}, {id:"federal:BR:L:6511/1977", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1977, data:"1977-12-19", numero:"6511", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1977-12-19;6511", vigente:true, titulo:"Lei nº 6.511 de 19/12/1977", urn:"urn:lex:br:federal:lei:1977-12-19;6511", ementa:"Dispõe sobre os Prêmios Literários Nacionais.", arquivo:"fe