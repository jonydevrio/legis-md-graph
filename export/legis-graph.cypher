leg.br/?urn=urn:lex:br:federal:lei:1837-09-30;69", vigente:true, titulo:"Lei nº 69 de 30/09/1837", urn:"urn:lex:br:federal:lei:1837-09-30;69", ementa:"SOBRE A GRATIFICAÇÃO DOS CONSELHEIROS E VOGAIS DO CONSELHO SUPREMO MILITAR.", arquivo:"federal/leis-ordinarias/1837/lei-69-1837-09-30.md"}}, {id:"federal:BR:L:8048/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-06-15", numero:"8048", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-06-15;8048", vigente:true, titulo:"Lei nº 8.048 de 15/06/1990", urn:"urn:lex:br:federal:lei:1990-06-15;8048", ementa:"Concede anistia às pessoas envolvidas nos fatos que menciona.", arquivo:"federal/leis-ordinarias/1990/lei-8048-1990-06-15.md"}}, {id:"federal:BR:L:8146/1990", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-12-28", numero:"8146", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-12-28;8146", vigente:true, titulo:"Lei nº 8.146 de 28/12/1990", urn:"urn:lex:br:federal:lei:1990-12-28;8146", ementa:"Introduz modificação na estrutura organizacional da 4ª Região da Justiça   Federal, dá competência ao respectivo Tribunal Regional e determina outras   providências.", arquivo:"federal/leis-ordinarias/1990/lei-8146-1990-12-28.md"}}, {id:"federal:BR:L:8001/1990", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1990, data:"1990-03-13", numero:"8001", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1990-03-13;8001", vigente:true, titulo:"Lei nº 8.001 de 13/03/1990", urn:"urn:lex:br:federal:lei:1990-03-13;8001", ementa:"Define os percentuais da distribuição da compensação financeira de que trata a Lei nº 7.990, de 28 de dezembro de 1989, e dá outras providências.", arquivo:"federal/leis-ordinarias/1990/lei-8001-1990-03-13.md"}}, {id:"federal:BR:L:815