ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 189.760,00, para pagamento de diferença de vencimentos a Salomão Vasconcelos.", arquivo:"federal/leis-ordinarias/1952/lei-1552-1952-02-08.md"}}, {id:"federal:BR:L:1557/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-02-14", numero:"1557", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-02-14;1557-a", vigente:true, titulo:"Lei nº 1.557-A de 14/02/1952", urn:"urn:lex:br:federal:lei:1952-02-14;1557-a", ementa:"Autoriza o Poder Executivo a abrir o crédito especial de Cr$ 300.000,00, como auxílio ao V Congresso Nacional dos Estabelecimentos Particulares de Ensino, a realizar-se em 1952, na cidade de Porto Alegre, Estado do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1952/lei-1557-a-1952-02-14.md"}}, {id:"federal:BR:L:1693/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-10-03", numero:"1693", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-10-03;1693", vigente:true, titulo:"Lei nº 1.693 de 03/10/1952", urn:"urn:lex:br:federal:lei:1952-10-03;1693", ementa:"Autoriza a abertura, pelo Ministério da Educação e Saúde, do crédito especial como contribuição do Governo Federal às despesas com a construção do monumento a J. J. Seabra, no Estado da Bahia.", arquivo:"federal/leis-ordinarias/1952/lei-1693-1952-10-03.md"}}, {id:"federal:BR:L:1723/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-11-08", numero:"1723", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-11-08;1723", vigente:true, titulo:"Lei nº 1.723 de 08/11/1952", urn:"urn:lex:br:federal:lei:1952-11-08;1723", ementa:"Modifica o artigo 461, do Decreto-lei nº 5.452, de 1º de maio de 1943 (Consolidação das leis do Trabalho).", arquivo:"federal/leis-ordinarias/1952/lei-1723-1952-11-08.md"}}, {id:"federal:BR:L:1712/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-10-29", numero:"1712", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-10-29;1712", vigente:true, titulo:"Lei nº 1.712 de 29/10/1952", urn:"urn:lex:br:federal:lei:1952-10-29;1712", ementa:"Autoriza o Poder Executivo a promover a liquidação e o pagamento de despesas com a execução de obras na Secretaria do Ministério da Educação e Saúde.", arquivo:"federal/leis-ordinarias/1952/lei-1712-1952-10-29.md"}}, {id:"federal:BR:L:1611/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-05-27", numero:"1611", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-05-27;1611", vigente:true, titulo:"Lei nº 1.611 de 27/05/1952", urn:"urn:lex:br:federal:lei:1952-05-27;1611", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério das Relações Exteriores, o crédito especial de Cr$ 412.076,62 para o fim de atender ao pagamento da contribuição do Brasil em favor do Fundo de Reserva da Organização Mundial de Saúde.", arquivo:"federal/leis-ordinarias/1952/lei-1611-1952-05-27.md"}}, {id:"federal:BR:L:1729/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-11-11", numero:"1729", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-11-11;1729", vigente:true, titulo:"Lei nº 1.729 de 11/11/1952", urn:"urn:lex:br:federal:lei:1952-11-11;1729", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 155.167,70, para atender ao pagamento de indenização à Companhia Ferro Carril do Jardim Botânico.", arquivo:"federal/leis-ordinarias/1952/lei-1729-1952-11-11.md"}}, {id:"federal:BR:L:1760/1952", properties:{esfera:"