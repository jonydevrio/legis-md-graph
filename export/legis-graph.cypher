UNWIND [{id:"federal:BR:L:14470/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-11-16", numero:"14470", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-11-16;14470", vigente:true, titulo:"Lei nº 14.470 de 16/11/2022", urn:"urn:lex:br:federal:lei:2022-11-16;14470", ementa:"Altera a Lei nº 12.529, de 30 de novembro de 2011 (Lei de Defesa da Concorrência), para prever novas disposições aplicáveis à repressão de infrações à ordem econômica.", arquivo:"federal/leis-ordinarias/2022/lei-14470-2022-11-16.md"}}, {id:"federal:BR:L:14512/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-27", numero:"14512", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-27;14512", vigente:true, titulo:"Lei nº 14.512 de 27/12/2022", urn:"urn:lex:br:federal:lei:2022-12-27;14512", ementa:"Abre ao Orçamento Fiscal da União, em favor dos Ministérios da Agricultura, Pecuária e Abastecimento, da Economia, da Infraestrutura, das Comunicações, da Defesa e do Turismo, crédito suplementar no valor de R$ 71.080.366,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2022/lei-14512-2022-12-27.md"}}, {id:"federal:BR:L:14294/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-01-04", numero:"14294", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-01-04;14294", vigente:true, titulo:"Lei nº 14.294 de 04/01/2022", urn:"urn:lex:br:federal:lei:2022-01-04;14294", ementa:"Altera a Lei nº 13.756, de 12 de dezembro de 2018, para definir percentual de arrecadação da loteria de prognósticos numéricos a ser destinado ao Comitê Brasileiro de Clubes Paralímpicos (CBCP).", arquivo:"federal/leis-ordinarias/2022/lei-14294-2022-01-04.md"}}, {id:"federal:BR:L:14364/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-06-01", numero:"14364", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-06-01;14364", vigente:true, titulo:"Lei nº 14.364 de 01/06/2022", urn:"urn:lex:br:federal:lei:2022-06-01;14364", ementa:"Altera a Lei nº 10.048, de 8 de novembro de 2000, para garantir direitos aos acompanhantes das pessoas com prioridade de atendimento, nas condições que especifica.", arquivo:"federal/leis-ordinarias/2022/lei-14364-2022-06-01.md"}}, {id:"federal:BR:L:14327/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-04-13", numero:"14327", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-04-13;14327", vigente:true, titulo:"Lei nº 14.327 de 13/04/2022", urn:"urn:lex:br:federal:lei:2022-04-13;14327", ementa:"Dispõe sobre requisitos mínimos de segurança para a fabricação, a construção, a instalação e o funcionamento de piscinas ou similares e sobre a responsabilidade em caso de seu descumprimento.", arquivo:"federal/leis-ordinarias/2022/lei-14327-2022-04-13.md"}}, {id:"federal:BR:L:14354/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-05-30", numero:"14354", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-05-30;14354", vigente:true, titulo:"Lei nº 14.354 de 30/05/2022", urn:"urn:lex:br:federal:lei:2022-05-30;14354", ementa:"Institui o Dia Nacional do Espiritismo.", arquivo:"federal/leis-ordinarias/2022/lei-14354-2022-05-30.md"}}, {id:"federal:BR:L:14424/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-07-27", numero:"14424", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-07-27;14424", vigente:true, titulo:"Lei nº 14.424 de 27/07/2022", urn:"urn:lex:br:federal:lei:2022-07-27;14424", ementa:"Altera a Lei nº 13.116, de 20 de abril de 2015, para autorizar a instalação de infraestrutura de telecomunicações, nos termos do requerimento de instalação, em caso de não manifestação do órgão competente no prazo legalmente estabelecido.", arquivo:"federal/leis-ordinarias/2022/lei-14424-2022-07-27.md"}}, {id:"federal:BR:L:14479/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-21", numero:"14479", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-21;14479", vigente:true, titulo:"Lei nº 14.479 de 21/12/2022", urn:"urn:lex:br:federal:lei:2022-12-21;14479", ementa:"Institui a Política Nacional de Desfazimento e Recondicionamento de Equipamentos Eletroeletrônicos e dispõe sobre o Programa Computadores para Inclusão.", arquivo:"federal/leis-ordinarias/2022/lei-14479-2022-12-21.md"}}, {id:"federal:BR:L:14495/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-23", numero:"14495", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-23;14495", vigente:true, titulo:"Lei nº 14.495 de 23/12/2022", urn:"urn:lex:br:federal:lei:2022-12-23;14495", ementa:"Abre ao Orçamento de Investimento da União, em favor do Banco da Amazônia S.A., crédito suplementar no valor total de R$ 25.504.828,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2022/lei-14495-2022-12-23.md"}}, {id:"federal:BR:L:14516/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-29", numero:"14516", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-29;14516", vigente:true, titulo:"Lei nº 14.516 de 29/12/2022", urn:"urn:lex:br:federal:lei:2022-12-29;14516", ementa:"Altera a Lei nº 14.452, de 21 de setembro de 2022, que redefine os limites do Parque Nacional da Serra dos Órgãos.", arquivo:"federal/leis-ordinarias/2022/lei-14516-2022-12-29.md"}}, {id:"federal:BR:L:14467/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-11-16", numero:"14467", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-11-16;14467", vigente:true, titulo:"Lei nº 14.467 de 16/11/2022", urn:"urn:lex:br:federal:lei:2022-11-16;14467", ementa:"Dispõe sobre o tratamento tributário aplicável às perdas incorridas no recebimento de créditos decorrentes das atividades das instituições financeiras e das demais instituições autorizadas a funcionar pelo Banco Central do Brasil.", arquivo:"federal/leis-ordinarias/2022/lei-14467-2022-11-16.md"}}, {id:"federal:BR:L:14376/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-06-22", numero:"14376", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-06-22;14376", vigente:true, titulo:"Lei nº 14.376 de 22/06/2022", urn:"urn:lex:br:federal:lei:2022-06-22;14376", ementa:"Denomina \"Estrada Senador Murilo Badaró\" o trecho rodoviário da BR-367 que liga os Municípios de Minas Novas e Araçuaí, no Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/2022/lei-14376-2022-06-22.md"}}, {id:"federal:BR:L:14393/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-07-04", numero:"14393", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-07-04;14393", vigente:true, titulo:"Lei nº 14.393 de 04/07/2022", urn:"urn:lex:br:federal:lei:2022-07-04;14393", ementa:"Altera a Lei nº 9.795, de 27 de abril de 1999, que dispõe sobre a Política Nacional de Educação Ambiental, para instituir a Campanha Junho Verde.", arquivo:"federal/leis-ordinarias/2022/lei-14393-2022-07-04.md"}}, {id:"federal:BR:L:14459/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-10-25", numero:"14459", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-10-25;14459", vigente:true, titulo:"Lei nº 14.459 de 25/10/2022", urn:"urn:lex:br:federal:lei:2022-10-25;14459", ementa:"Altera a Lei nº 12.598, de 21 de março de 2012, que estabelece normas especiais para as compras, as contratações e o desenvolvimento de produtos e de sistemas de defesa e dispõe sobre regras de incentivo à área estratégica de defesa.", arquivo:"federal/leis-ordinarias/2022/lei-14459-2022-10-25.md"}}, {id:"federal:BR:L:14300/2022", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-01-06", numero:"14300", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-01-06;14300", vigente:true, titulo:"Lei nº 14.300 de 06/01/2022", urn:"urn:lex:br:federal:lei:2022-01-06;14300", ementa:"Institui o marco legal da microgeração e minigeração distribuída, o Sistema de Compensação de Energia Elétrica (SCEE) e o Programa de Energia Renovável Social (PERS); altera as Leis nºs 10.848, de 15 de março de 2004, e 9.427, de 26 de dezembro de 1996; e dá outras providências.", arquivo:"federal/leis-ordinarias/2022/lei-14300-2022-01-06.md"}}, {id:"federal:BR:L:14347/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-05-25", numero:"14347", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-05-25;14347", vigente:true, titulo:"Lei nº 14.347 de 25/05/2022", urn:"urn:lex:br:federal:lei:2022-05-25;14347", ementa:"Abre crédito extraordinário em favor do Ministério da Saúde, no valor de R$ 6.412.000.000,00 (seis bilhões quatrocentos e doze milhões de reais), para os fins que especifica.", arquivo:"federal/leis-ordinarias/2022/lei-14347-2022-05-25.md"}}, {id:"federal:BR:L:14415/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-07-18", numero:"14415", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-07-18;14415", vigente:true, titulo:"Lei nº 14.415 de 18/07/2022", urn:"urn:lex:br:federal:lei:2022-07-18;14415", ementa:"Institui o Dia Nacional do Laringectomizado, a ser celebrado, anualmente, no dia 11 de agosto.", arquivo:"federal/leis-ordinarias/2022/lei-14415-2022-07-18.md"}}, {id:"federal:BR:L:14409/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-07-15", numero:"14409", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-07-15;14409", vigente:true, titulo:"Lei nº 14.409 de 15/07/2022", urn:"urn:lex:br:federal:lei:2022-07-15;14409", ementa:"Abre ao Orçamento Fiscal da União, em favor de Encargos Financeiros da União, crédito especial no valor de R$ 23.912.137.414,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/2022/lei-14409-2022-07-15.md"}}, {id:"federal:BR:L:14509/2022", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-27", numero:"14509", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-27;14509", vigente:true, titulo:"Lei nº 14.509 de 27/12/2022", urn:"urn:lex:br:federal:lei:2022-12-27;14509", ementa:"Dispõe sobre o percentual máximo aplicado para a contratação de operações de crédito com desconto automático em folha de pagamento; altera a Lei nº 14.431, de 3 de agosto de 2022; revoga dispositivos da Lei nº 8.112, de 11 de dezembro de 1990; e dá outras providências.", arquivo:"federal/leis-ordinarias/2022/lei-14509-2022-12-27.md"}}, {id:"federal:BR:L:14488/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-21", numero:"14488", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-21;14488", vigente:true, titulo:"Lei nº 14.488 de 21/12/2022", urn:"urn:lex:br:federal:lei:2022-12-21;14488", ementa:"Abre ao Orçamento de Investimento da União, em favor da Petróleo Brasileiro S.A. - Petrobras, crédito suplementar no valor de R$ 379.732.000,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2022/lei-14488-2022-12-21.md"}}, {id:"federal:BR:L:14455/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-09-21", numero:"14455", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-09-21;14455", vigente:true, titulo:"Lei nº 14.455 de 21/09/2022", urn:"urn:lex:br:federal:lei:2022-09-21;14455", ementa:"Autoriza o Poder Executivo a instituir os produtos lotéricos denominados Loteria da Saúde e Loteria do Turismo; e altera a Lei nº 13.756, de 12 de dezembro de 2018.", arquivo:"federal/leis-ordinarias/2022/lei-14455-2022-09-21.md"}}, {id:"federal:BR:L:14299/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-01-05", numero:"14299", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-01-05;14299", vigente:true, titulo:"Lei nº 14.299 de 05/01/2022", urn:"urn:lex:br:federal:lei:2022-01-05;14299", ementa:"Altera as Leis nºs 10.438, de 26 de abril de 2002, e 9.074, de 7 de julho de 1995, para instituir subvenção econômica às concessionárias do serviço público de distribuição de energia elétrica de pequeno porte; cria o Programa de Transição Energética Justa (TEJ); e dá outras providências.", arquivo:"federal/leis-ordinarias/2022/lei-14299-2022-01-05.md"}}, {id:"federal:BR:L:14303/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-01-21", numero:"14303", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-01-21;14303", vigente:true, titulo:"Lei nº 14.303 de 21/01/2022", urn:"urn:lex:br:federal:lei:2022-01-21;14303", ementa:"Estima a receita e fixa a despesa da União para o exercício financeiro de 2022.", arquivo:"federal/leis-ordinarias/2022/lei-14303-2022-01-21.md"}}, {id:"federal:BR:L:14465/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-11-09", numero:"14465", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-11-09;14465", vigente:true, titulo:"Lei nº 14.465 de 09/11/2022", urn:"urn:lex:br:federal:lei:2022-11-09;14465", ementa:"Transforma Funções Gratificadas (FG) em Cargos Comissionados de Direção (CD) e Cargos Comissionados de Gerência Executiva (CGE) destinados à Agência Nacional de Transportes Aquaviários (Antaq); e altera a Lei nº 10.233, de 5 de junho de 2001.", arquivo:"federal/leis-ordinarias/2022/lei-14465-2022-11-09.md"}}, {id:"federal:BR:L:14318/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-03-29", numero:"14318", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-03-29;14318", vigente:true, titulo:"Lei nº 14.318 de 29/03/2022", urn:"urn:lex:br:federal:lei:2022-03-29;14318", ementa:"Altera a Lei nº 9.800, de 26 de maio de 1999, e a Lei nº 11.419, de 19 de dezembro de 2006, para prever hipóteses de cabimento de utilização de sistema de protocolo integrado judicial de caráter nacional.", arquivo:"federal/leis-ordinarias/2022/lei-14318-2022-03-29.md"}}, {id:"federal:BR:L:14448/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-09-09", numero:"14448", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-09-09;14448", vigente:true, titulo:"Lei nº 14.448 de 09/09/2022", urn:"urn:lex:br:federal:lei:2022-09-09;14448", ementa:"Institui, em âmbito nacional, o Agosto Lilás como mês de proteção à mulher, destinado à conscientização para o fim da violência contra a mulher.", arquivo:"federal/leis-ordinarias/2022/lei-14448-2022-09-09.md"}}, {id:"federal:BR:L:14430/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-08-03", numero:"14430", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-08-03;14430", vigente:true, titulo:"Lei nº 14.430 de 03/08/2022", urn:"urn:lex:br:federal:lei:2022-08-03;14430", ementa:"Dispõe sobre a emissão de Letra de Risco de Seguro (LRS) por Sociedade Seguradora de Propósito Específico (SSPE), sobre as regras gerais aplicáveis à securitização de direitos creditórios e à emissão de Certificados de Recebíveis e sobre a flexibilização do requisito de instituição financeira para a prestação do serviço de escrituração e de custódia de valores mobiliários; altera as Leis nºs 6.404, de 15 de dezembro de 1976, 6.385, de 7 de dezembro de 1976, 9.718, de 27 de novembro de 1998, 4.59", arquivo:"federal/leis-ordinarias/2022/lei-14430-2022-08-03.md"}}, {id:"federal:BR:L:14480/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-21", numero:"14480", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-21;14480", vigente:true, titulo:"Lei nº 14.480 de 21/12/2022", urn:"urn:lex:br:federal:lei:2022-12-21;14480", ementa:"Abre ao Orçamento Fiscal da União, em favor das Justiças Federal e Eleitoral, crédito suplementar, no valor de R$ 11.456.199,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2022/lei-14480-2022-12-21.md"}}, {id:"federal:BR:L:14460/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-10-25", numero:"14460", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-10-25;14460", vigente:true, titulo:"Lei nº 14.460 de 25/10/2022", urn:"urn:lex:br:federal:lei:2022-10-25;14460", ementa:"Transforma a Autoridade Nacional de Proteção de Dados (ANPD) em autarquia de natureza especial e transforma cargos comissionados; altera as Leis nºs 13.709, de 14 de agosto de 2018 (Lei Geral de Proteção de Dados Pessoais), e 13.844, de 18 de junho de 2019; e revoga dispositivos da Lei nº 13.853, de 8 de julho de 2019.", arquivo:"federal/leis-ordinarias/2022/lei-14460-2022-10-25.md"}}, {id:"federal:BR:L:14326/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-04-12", numero:"14326", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-04-12;14326", vigente:true, titulo:"Lei nº 14.326 de 12/04/2022", urn:"urn:lex:br:federal:lei:2022-04-12;14326", ementa:"Altera a Lei nº 7.210, de 11 de julho de 1984 (Lei de Execução Penal), para assegurar à mulher presa gestante ou puérpera tratamento humanitário antes e durante o trabalho de parto e no período de puerpério, bem como assistência integral à sua saúde e à do recém-nascido.", arquivo:"federal/leis-ordinarias/2022/lei-14326-2022-04-12.md"}}, {id:"federal:BR:L:14397/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-07-08", numero:"14397", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-07-08;14397", vigente:true, titulo:"Lei nº 14.397 de 08/07/2022", urn:"urn:lex:br:federal:lei:2022-07-08;14397", ementa:"Anistia infrações e anula multas por atraso na entrega da Guia de Recolhimento do Fundo de Garantia do Tempo de Serviço e Informações à Previdência Social (GFIP).", arquivo:"federal/leis-ordinarias/2022/lei-14397-2022-07-08.md"}}, {id:"federal:BR:L:14410/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-07-15", numero:"14410", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-07-15;14410", vigente:true, titulo:"Lei nº 14.410 de 15/07/2022", urn:"urn:lex:br:federal:lei:2022-07-15;14410", ementa:"Abre ao Orçamento Fiscal da União, em favor dos Poderes Legislativo e Judiciário, da Defensoria Pública da União e do Ministério Público da União, crédito suplementar no valor de R$ 202.540.096,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2022/lei-14410-2022-07-15.md"}}, {id:"federal:BR:L:14510/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-27", numero:"14510", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-27;14510", vigente:true, titulo:"Lei nº 14.510 de 27/12/2022", urn:"urn:lex:br:federal:lei:2022-12-27;14510", ementa:"Altera a Lei nº 8.080, de 19 de setembro de 1990, para autorizar e disciplinar a prática da telessaúde em todo o território nacional, e a Lei nº 13.146, de 6 de julho de 2015; e revoga a Lei nº 13.989, de 15 de abril de 2020.", arquivo:"federal/leis-ordinarias/2022/lei-14510-2022-12-27.md"}}, {id:"federal:BR:L:14333/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-05-04", numero:"14333", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-05-04;14333", vigente:true, titulo:"Lei nº 14.333 de 04/05/2022", urn:"urn:lex:br:federal:lei:2022-05-04;14333", ementa:"Altera a Lei nº 9.394, de 20 de dezembro de 1996 (Lei de Diretrizes e Bases da Educação Nacional), para dispor sobre a garantia de mobiliário, equipamentos e materiais pedagógicos adequados à idade e às necessidades específicas de cada aluno.", arquivo:"federal/leis-ordinarias/2022/lei-14333-2022-05-04.md"}}, {id:"federal:BR:L:14362/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-06-01", numero:"14362", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-06-01;14362", vigente:true, titulo:"Lei nº 14.362 de 01/06/2022", urn:"urn:lex:br:federal:lei:2022-06-01;14362", ementa:"Abre crédito extraordinário em favor do Ministério da Infraestrutura, no valor de R$ 418.000.000,00 (quatrocentos e dezoito milhões de reais), para o fim que especifica.", arquivo:"federal/leis-ordinarias/2022/lei-14362-2022-06-01.md"}}, {id:"federal:BR:L:14384/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-06-27", numero:"14384", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-06-27;14384", vigente:true, titulo:"Lei nº 14.384 de 27/06/2022", urn:"urn:lex:br:federal:lei:2022-06-27;14384", ementa:"Denomina Aeroporto de Macaé/Rio de Janeiro - Joaquim de Azevedo Mancebo o aeroporto situado na cidade de Macaé, Estado do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/2022/lei-14384-2022-06-27.md"}}, {id:"federal:BR:L:14501/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-23", numero:"14501", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-23;14501", vigente:true, titulo:"Lei nº 14.501 de 23/12/2022", urn:"urn:lex:br:federal:lei:2022-12-23;14501", ementa:"Abre ao Orçamento de Investimento da União, em favor das Indústrias Nucleares do Brasil S.A. - INB, crédito especial no valor de R$ 26.500.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/2022/lei-14501-2022-12-23.md"}}, {id:"federal:BR:L:14499/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-23", numero:"14499", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-23;14499", vigente:true, titulo:"Lei nº 14.499 de 23/12/2022", urn:"urn:lex:br:federal:lei:2022-12-23;14499", ementa:"Abre ao Orçamento de Investimento da União, em favor do Banco do Nordeste do Brasil S.A. - BNB e da Empresa Brasileira de Participações em Energia Nuclear e Binacional S.A. - ENBPar, crédito especial no valor de R$ 6.336.178,00, para os fins que especifica.B", arquivo:"federal/leis-ordinarias/2022/lei-14499-2022-12-23.md"}}, {id:"federal:BR:L:14369/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-06-15", numero:"14369", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-06-15;14369", vigente:true, titulo:"Lei nº 14.369 de 15/06/2022", urn:"urn:lex:br:federal:lei:2022-06-15;14369", ementa:"Altera a Lei Complementar nº 89, de 18 de fevereiro de 1997, que institui o Fundo para Aparelhamento e Operacionalização das Atividades-fim da Polícia Federal (Funapol).", arquivo:"federal/leis-ordinarias/2022/lei-14369-2022-06-15.md"}}, {id:"federal:BR:L:14439/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-08-24", numero:"14439", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-08-24;14439", vigente:true, titulo:"Lei nº 14.439 de 24/08/2022", urn:"urn:lex:br:federal:lei:2022-08-24;14439", ementa:"Altera a Lei nº 11.438, de 29 de dezembro de 2006, para aumentar os limites para dedução dos valores destinados a projetos desportivos e paradesportivos do imposto de renda e para aumentar a relação de proponentes dos projetos, e a Lei nº 9.532, de 10 de dezembro de 1997, para permitir que as doações e patrocínios a projeto desportivo ou paradesportivo destinado a promover a inclusão social por meio do esporte, preferencialmente em comunidades em situação de vulnerabilidade social, partilhem os ", arquivo:"federal/leis-ordinarias/2022/lei-14439-2022-08-24.md"}}, {id:"federal:BR:L:14304/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-02-23", numero:"14304", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-02-23;14304", vigente:true, titulo:"Lei nº 14.304 de 23/02/2022", urn:"urn:lex:br:federal:lei:2022-02-23;14304", ementa:"Veda a divulgação, a publicação ou a disseminação, em redes sociais ou em quaisquer outros meios de divulgação digitais, eletrônicos ou impressos, do registro visual da prática de infração que coloque em risco a segurança no trânsito; e altera a Lei nº 9.503, de 23 de setembro de 1997 (Código de Trânsito Brasileiro).", arquivo:"federal/leis-ordinarias/2022/lei-14304-2022-02-23.md"}}, {id:"federal:BR:L:14436/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-08-09", numero:"14436", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-08-09;14436", vigente:true, titulo:"Lei nº 14.436 de 09/08/2022", urn:"urn:lex:br:federal:lei:2022-08-09;14436", ementa:"Dispõe sobre as diretrizes para a elaboração e a execução da Lei Orçamentária de 2023 e dá outras providências.", arquivo:"federal/leis-ordinarias/2022/lei-14436-2022-08-09.md"}}, {id:"federal:BR:L:14312/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-03-14", numero:"14312", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-03-14;14312", vigente:true, titulo:"Lei nº 14.312 de 14/03/2022", urn:"urn:lex:br:federal:lei:2022-03-14;14312", ementa:"Institui o Programa Nacional de Apoio à Aquisição de Habitação para Profissionais da Segurança Pública (Programa Habite Seguro); e altera as Leis nºs 8.677, de 13 de julho de 1993, 10.188, de 12 de fevereiro de 2001, 11.124, de 16 de junho de 2005, e 11.977, de 7 de julho de 2009.", arquivo:"federal/leis-ordinarias/2022/lei-14312-2022-03-14.md"}}, {id:"federal:BR:L:14484/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-21", numero:"14484", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-21;14484", vigente:true, titulo:"Lei nº 14.484 de 21/12/2022", urn:"urn:lex:br:federal:lei:2022-12-21;14484", ementa:"Abre ao Orçamento Fiscal da União, em favor dos Ministérios da Ciência, Tecnologia e Inovações; da Educação; da Justiça e Segurança Pública; de Minas e Energia; da Infraestrutura; das Comunicações; e do Desenvolvimento Regional, crédito especial no valor de R$ 35.398.824,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2022/lei-14484-2022-12-21.md"}}, {id:"federal:BR:L:14355/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-05-31", numero:"14355", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-05-31;14355", vigente:true, titulo:"Lei nº 14.355 de 31/05/2022", urn:"urn:lex:br:federal:lei:2022-05-31;14355", ementa:"Altera a Lei nº 11.371, de 28 de novembro de 2006, para dispor sobre a redução na alíquota do imposto sobre a renda incidente sobre as operações que menciona.", arquivo:"federal/leis-ordinarias/2022/lei-14355-2022-05-31.md"}}, {id:"federal:BR:L:14344/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-05-24", numero:"14344", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-05-24;14344", vigente:true, titulo:"Lei nº 14.344 de 24/05/2022", urn:"urn:lex:br:federal:lei:2022-05-24;14344", ementa:"Cria mecanismos para a prevenção e o enfrentamento da violência doméstica e familiar contra a criança e o adolescente, nos termos do § 8º do art. 226 e do § 4º do art. 227 da Constituição Federal e das disposições específicas previstas em tratados, convenções ou acordos internacionais de que o Brasil seja parte; altera o Decreto-Lei nº 2.848, de 7 de dezembro de 1940 (Código Penal), e as Leis nºs 7.210, de 11 de julho de 1984 (Lei de Execução Penal), 8.069, de 13 de julho de 1990 (Estatuto da Cr", arquivo:"federal/leis-ordinarias/2022/lei-14344-2022-05-24.md"}}, {id:"federal:BR:L:14443/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-09-02", numero:"14443", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-09-02;14443", vigente:true, titulo:"Lei nº 14.443 de 02/09/2022", urn:"urn:lex:br:federal:lei:2022-09-02;14443", ementa:"Altera a Lei nº 9.263, de 12 de janeiro de 1996, para determinar prazo para oferecimento de métodos e técnicas contraceptivas e disciplinar condições para esterilização no âmbito do planejamento familiar.", arquivo:"federal/leis-ordinarias/2022/lei-14443-2022-09-02.md"}}, {id:"federal:BR:L:14365/2022", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-06-02", numero:"14365", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-06-02;14365", vigente:true, titulo:"Lei nº 14.365 de 02/06/2022", urn:"urn:lex:br:federal:lei:2022-06-02;14365", ementa:"Altera as Leis nºs 8.906, de 4 de julho de 1994 (Estatuto da Advocacia), e 13.105, de 16 de março de 2015 (Código de Processo Civil), e o Decreto-Lei nº 3.689, de 3 de outubro de 1941 (Código de Processo Penal), para incluir disposições sobre a atividade privativa de advogado, a fiscalização, a competência, as prerrogativas, as sociedades de advogados, o advogado associado, os honorários advocatícios, os limites de impedimentos ao exercício da advocacia e a suspensão de prazo no processo penal.", arquivo:"federal/leis-ordinarias/2022/lei-14365-2022-06-02.md"}}, {id:"federal:BR:L:14472/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-06", numero:"14472", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-06;14472", vigente:true, titulo:"Lei nº 14.472 de 06/12/2022", urn:"urn:lex:br:federal:lei:2022-12-06;14472", ementa:"Institui o dia 13 de julho como o Dia Nacional da Música e Viola Caipira.", arquivo:"federal/leis-ordinarias/2022/lei-14472-2022-12-06.md"}}, {id:"federal:BR:L:14308/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-03-08", numero:"14308", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-03-08;14308", vigente:true, titulo:"Lei nº 14.308 de 08/03/2022", urn:"urn:lex:br:federal:lei:2022-03-08;14308", ementa:"Institui a Política Nacional de Atenção à Oncologia Pediátrica.", arquivo:"federal/leis-ordinarias/2022/lei-14308-2022-03-08.md"}}, {id:"federal:BR:L:14451/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-09-21", numero:"14451", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-09-21;14451", vigente:true, titulo:"Lei nº 14.451 de 21/09/2022", urn:"urn:lex:br:federal:lei:2022-09-21;14451", ementa:"Altera a Lei nº 10.406, de 10 de janeiro de 2002 (Código Civil), para modificar os quóruns de deliberação dos sócios da sociedade limitada previstos nos arts. 1.061 e 1.076.", arquivo:"federal/leis-ordinarias/2022/lei-14451-2022-09-21.md"}}, {id:"federal:BR:L:14370/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-06-15", numero:"14370", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-06-15;14370", vigente:true, titulo:"Lei nº 14.370 de 15/06/2022", urn:"urn:lex:br:federal:lei:2022-06-15;14370", ementa:"Institui o Programa Nacional de Prestação de Serviço Civil Voluntário e o Prêmio Portas Abertas.", arquivo:"federal/leis-ordinarias/2022/lei-14370-2022-06-15.md"}}, {id:"federal:BR:L:14357/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-06-01", numero:"14357", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-06-01;14357", vigente:true, titulo:"Lei nº 14.357 de 01/06/2022", urn:"urn:lex:br:federal:lei:2022-06-01;14357", ementa:"Abre crédito extraordinário em favor do Ministério da Cidadania, no valor de R$ 167.288.600,00 (cento e sessenta e sete milhões duzentos e oitenta e oito mil e seiscentos reais), para o fim que especifica.", arquivo:"federal/leis-ordinarias/2022/lei-14357-2022-06-01.md"}}, {id:"federal:BR:L:14341/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-05-18", numero:"14341", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-05-18;14341", vigente:true, titulo:"Lei nº 14.341 de 18/05/2022", urn:"urn:lex:br:federal:lei:2022-05-18;14341", ementa:"Dispõe sobre a Associação de Representação de Municípios; e altera a Lei nº 13.105, de 16 de março de 2015 (Código de Processo Civil).", arquivo:"federal/leis-ordinarias/2022/lei-14341-2022-05-18.md"}}, {id:"federal:BR:L:14408/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-07-12", numero:"14408", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-07-12;14408", vigente:true, titulo:"Lei nº 14.408 de 12/07/2022", urn:"urn:lex:br:federal:lei:2022-07-12;14408", ementa:"Altera a Lei nº 4.117, de 27 de agosto de 1962 (Código Brasileiro de Telecomunicações), para dispor sobre a transferência, a comercialização e a cessão do tempo de programação para a produção independente.", arquivo:"federal/leis-ordinarias/2022/lei-14408-2022-07-12.md"}}, {id:"federal:BR:L:14352/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-05-25", numero:"14352", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-05-25;14352", vigente:true, titulo:"Lei nº 14.352 de 25/05/2022", urn:"urn:lex:br:federal:lei:2022-05-25;14352", ementa:"Altera a Lei nº 14.194, de 20 de agosto de 2021, que dispõe sobre as diretrizes para a elaboração e a execução da Lei Orçamentária de 2022.", arquivo:"federal/leis-ordinarias/2022/lei-14352-2022-05-25.md"}}, {id:"federal:BR:L:14315/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-03-28", numero:"14315", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-03-28;14315", vigente:true, titulo:"Lei nº 14.315 de 28/03/2022", urn:"urn:lex:br:federal:lei:2022-03-28;14315", ementa:"Confere ao Munícipio de Campo Grande, no Estado de Mato Grosso do Sul, o título de Capital Nacional do Chamamé.", arquivo:"federal/leis-ordinarias/2022/lei-14315-2022-03-28.md"}}, {id:"federal:BR:L:14329/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-05-03", numero:"14329", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-05-03;14329", vigente:true, titulo:"Lei nº 14.329 de 03/05/2022", urn:"urn:lex:br:federal:lei:2022-05-03;14329", ementa:"Institui o Dia Nacional do Profissional de Logística.", arquivo:"federal/leis-ordinarias/2022/lei-14329-2022-05-03.md"}}, {id:"federal:BR:L:14433/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-08-04", numero:"14433", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-08-04;14433", vigente:true, titulo:"Lei nº 14.433 de 04/08/2022", urn:"urn:lex:br:federal:lei:2022-08-04;14433", ementa:"Abre crédito extraordinário em favor de Operações Oficiais de Crédito, no valor de R$ 1.200.000.000,00 (um bilhão e duzentos milhões de reais), para o fim que especifica.", arquivo:"federal/leis-ordinarias/2022/lei-14433-2022-08-04.md"}}, {id:"federal:BR:L:14506/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-26", numero:"14506", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-26;14506", vigente:true, titulo:"Lei nº 14.506 de 26/12/2022", urn:"urn:lex:br:federal:lei:2022-12-26;14506", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério da Justiça e Segurança Pública, crédito suplementar no valor de R$ 231.734.617,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2022/lei-14506-2022-12-26.md"}}, {id:"federal:BR:L:14418/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-07-20", numero:"14418", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-07-20;14418", vigente:true, titulo:"Lei nº 14.418 de 20/07/2022", urn:"urn:lex:br:federal:lei:2022-07-20;14418", ementa:"Declara Maria Lenk Patrona da Natação Brasileira.", arquivo:"federal/leis-ordinarias/2022/lei-14418-2022-07-20.md"}}, {id:"federal:BR:L:14491/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-23", numero:"14491", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-23;14491", vigente:true, titulo:"Lei nº 14.491 de 23/12/2022", urn:"urn:lex:br:federal:lei:2022-12-23;14491", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério de Minas e Energia, crédito especial no valor de R$ 1.212.148.152,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/2022/lei-14491-2022-12-23.md"}}, {id:"federal:BR:L:14463/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-10-26", numero:"14463", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-10-26;14463", vigente:true, titulo:"Lei nº 14.463 de 26/10/2022", urn:"urn:lex:br:federal:lei:2022-10-26;14463", ementa:"Dispõe sobre a reabertura do prazo para opção pelo regime de previdência complementar e altera a Lei nº 12.618, de 30 de abril de 2012, e a Lei nº 9.250, de 26 de dezembro de 1995, para adequá-las à Emenda Constitucional nº 103, de 12 de novembro de 2019, e estabelecer a natureza jurídica do benefício especial.", arquivo:"federal/leis-ordinarias/2022/lei-14463-2022-10-26.md"}}, {id:"federal:BR:L:14296/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-01-04", numero:"14296", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-01-04;14296", vigente:true, titulo:"Lei nº 14.296 de 04/01/2022", urn:"urn:lex:br:federal:lei:2022-01-04;14296", ementa:"Altera a Lei nº 11.279, de 9 de fevereiro de 2006, para incluir cursos no Sistema de Ensino Naval (SEN), ajustar a faixa etária de ingresso em corpos e quadros da Marinha e estabelecer restrições ao uso de tatuagem.", arquivo:"federal/leis-ordinarias/2022/lei-14296-2022-01-04.md"}}, {id:"federal:BR:L:14414/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-07-18", numero:"14414", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-07-18;14414", vigente:true, titulo:"Lei nº 14.414 de 18/07/2022", urn:"urn:lex:br:federal:lei:2022-07-18;14414", ementa:"Confere ao Município de Teresópolis, no Estado do Rio de Janeiro, o título de Capital Nacional do Lúpulo.", arquivo:"federal/leis-ordinarias/2022/lei-14414-2022-07-18.md"}}, {id:"federal:BR:L:14346/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-05-25", numero:"14346", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-05-25;14346", vigente:true, titulo:"Lei nº 14.346 de 25/05/2022", urn:"urn:lex:br:federal:lei:2022-05-25;14346", ementa:"Altera a Lei Complementar nº 79, de 7 de janeiro de 1994, para dispor sobre o percentual mínimo do repasse obrigatório da União aos fundos dos Estados, do Distrito Federal e dos Municípios.", arquivo:"federal/leis-ordinarias/2022/lei-14346-2022-05-25.md"}}, {id:"federal:BR:L:14466/2022", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-11-16", numero:"14466", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-11-16;14466", vigente:true, titulo:"Lei nº 14.466 de 16/11/2022", urn:"urn:lex:br:federal:lei:2022-11-16;14466", ementa:"Revoga a Lei nº 14.125, de 10 de março de 2021, que \"dispõe sobre a responsabilidade civil relativa a eventos adversos pós-vacinação contra a Covid-19 e sobre a aquisição e distribuição de vacinas por pessoas jurídicas de direito privado\".", arquivo:"federal/leis-ordinarias/2022/lei-14466-2022-11-16.md"}}, {id:"federal:BR:L:14392/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-07-04", numero:"14392", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-07-04;14392", vigente:true, titulo:"Lei nº 14.392 de 04/07/2022", urn:"urn:lex:br:federal:lei:2022-07-04;14392", ementa:"Reconhece a Marcha de Resistência do Cavalo Crioulo do Rio Grande do Sul como manifestação da cultura nacional.", arquivo:"federal/leis-ordinarias/2022/lei-14392-2022-07-04.md"}}, {id:"federal:BR:L:14478/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-21", numero:"14478", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-21;14478", vigente:true, titulo:"Lei nº 14.478 de 21/12/2022", urn:"urn:lex:br:federal:lei:2022-12-21;14478", ementa:"Dispõe sobre diretrizes a serem observadas na prestação de serviços de ativos virtuais e na regulamentação das prestadoras de serviços de ativos virtuais; altera o Decreto-Lei nº 2.848, de 7 de dezembro de 1940 (Código Penal), para prever o crime de fraude com a utilização de ativos virtuais, valores mobiliários ou ativos financeiros; e altera a Lei nº 7.492, de 16 de junho de 1986, que define crimes contra o sistema financeiro nacional, e a Lei nº 9.613, de 3 de março de 1998, que dispõe sobre ", arquivo:"federal/leis-ordinarias/2022/lei-14478-2022-12-21.md"}}, {id:"federal:BR:L:14343/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-05-19", numero:"14343", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-05-19;14343", vigente:true, titulo:"Lei nº 14.343 de 19/05/2022", urn:"urn:lex:br:federal:lei:2022-05-19;14343", ementa:"Autoriza o Poder Executivo federal a doar imunizantes contra a covid-19 a outros países em caráter de cooperação humanitária internacional.", arquivo:"federal/leis-ordinarias/2022/lei-14343-2022-05-19.md"}}, {id:"federal:BR:L:14494/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-23", numero:"14494", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-23;14494", vigente:true, titulo:"Lei nº 14.494 de 23/12/2022", urn:"urn:lex:br:federal:lei:2022-12-23;14494", ementa:"Abre ao Orçamento Fiscal da União, em favor dos Ministérios da Agricultura, Pecuária e Abastecimento e da Economia e de Operações Oficiais de Crédito, crédito suplementar no valor de R$ 386.535.009,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2022/lei-14494-2022-12-23.md"}}, {id:"federal:BR:L:14515/2022", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-29", numero:"14515", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-29;14515", vigente:true, titulo:"Lei nº 14.515 de 29/12/2022", urn:"urn:lex:br:federal:lei:2022-12-29;14515", ementa:"Dispõe sobre os programas de autocontrole dos agentes privados regulados pela defesa agropecuária e sobre a organização e os procedimentos aplicados pela defesa agropecuária aos agentes das cadeias produtivas do setor agropecuário; institui o Programa de Incentivo à Conformidade em Defesa Agropecuária, a Comissão Especial de Recursos de Defesa Agropecuária e o Programa de Vigilância em Defesa Agropecuária para Fronteiras Internacionais (Vigifronteiras); altera as Leis nºs 13.996, de 5 de maio de", arquivo:"federal/leis-ordinarias/2022/lei-14515-2022-12-29.md"}}, {id:"federal:BR:L:14317/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-03-29", numero:"14317", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-03-29;14317", vigente:true, titulo:"Lei nº 14.317 de 29/03/2022", urn:"urn:lex:br:federal:lei:2022-03-29;14317", ementa:"Altera a Lei nº 7.940, de 20 de dezembro de 1989, para modificar a forma de cálculo da Taxa de Fiscalização dos mercados de títulos e valores mobiliários, e a Lei nº 6.385, de 7 de dezembro de 1976; e revoga dispositivos das Leis nºs 8.383, de 30 de dezembro de 1991, 9.457, de 5 de maio de 1997, 11.076, de 30 de dezembro de 2004, 11.908, de 3 de março de 2009, e 12.249, de 11 de junho de 2010.", arquivo:"federal/leis-ordinarias/2022/lei-14317-2022-03-29.md"}}, {id:"federal:BR:L:14373/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-06-15", numero:"14373", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-06-15;14373", vigente:true, titulo:"Lei nº 14.373 de 15/06/2022", urn:"urn:lex:br:federal:lei:2022-06-15;14373", ementa:"Denomina Engenheiro Manoel dos Passos Barros o viaduto localizado no entroncamento da BR-101 com a BR-262, no Município de Cariacica, Estado do Espírito Santo.", arquivo:"federal/leis-ordinarias/2022/lei-14373-2022-06-15.md"}}, {id:"federal:BR:L:14476/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-14", numero:"14476", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-14;14476", vigente:true, titulo:"Lei nº 14.476 de 14/12/2022", urn:"urn:lex:br:federal:lei:2022-12-14;14476", ementa:"Dispõe sobre o funcionamento e as operações do Fundo Geral de Turismo e passa a denominá-lo Novo Fungetur; altera as Leis nºs 11.771, de 17 de setembro de 2008, 14.002, de 22 de maio de 2020, e 10.668, de 14 de maio de 2003; e revoga o Decreto-Lei nº 1.191, de 27 de outubro de 1971.", arquivo:"federal/leis-ordinarias/2022/lei-14476-2022-12-14.md"}}, {id:"federal:BR:L:14508/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-27", numero:"14508", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-27;14508", vigente:true, titulo:"Lei nº 14.508 de 27/12/2022", urn:"urn:lex:br:federal:lei:2022-12-27;14508", ementa:"Altera o art. 6º da Lei nº 8.906, de 4 de julho de 1994, que \"Dispõe sobre o Estatuto da Advocacia e a Ordem dos Advogados do Brasil (OAB)\", para estabelecer normas sobre a posição topográfica dos advogados durante audiências de instrução e julgamento.", arquivo:"federal/leis-ordinarias/2022/lei-14508-2022-12-27.md"}}, {id:"federal:BR:L:14487/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-21", numero:"14487", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-21;14487", vigente:true, titulo:"Lei nº 14.487 de 21/12/2022", urn:"urn:lex:br:federal:lei:2022-12-21;14487", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério do Desenvolvimento Regional, crédito especial no valor de R$ 5.300.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/2022/lei-14487-2022-12-21.md"}}, {id:"federal:BR:L:14454/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-09-21", numero:"14454", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-09-21;14454", vigente:true, titulo:"Lei nº 14.454 de 21/09/2022", urn:"urn:lex:br:federal:lei:2022-09-21;14454", ementa:"Altera a Lei nº 9.656, de 3 de junho de 1998, que dispõe sobre os planos privados de assistência à saúde, para estabelecer critérios que permitam a cobertura de exames ou tratamentos de saúde que não estão incluídos no rol de procedimentos e eventos em saúde suplementar.", arquivo:"federal/leis-ordinarias/2022/lei-14454-2022-09-21.md"}}, {id:"federal:BR:L:14298/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-01-05", numero:"14298", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-01-05;14298", vigente:true, titulo:"Lei nº 14.298 de 05/01/2022", urn:"urn:lex:br:federal:lei:2022-01-05;14298", ementa:"Altera a Lei nº 10.233, de 5 de junho de 2001, para estabelecer critérios de outorga mediante autorização para o transporte rodoviário interestadual e internacional de passageiros; e dá outras providências.", arquivo:"federal/leis-ordinarias/2022/lei-14298-2022-01-05.md"}}, {id:"federal:BR:L:14446/2022", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-09-02", numero:"14446", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-09-02;14446", vigente:true, titulo:"Lei nº 14.446 de 02/09/2022", urn:"urn:lex:br:federal:lei:2022-09-02;14446", ementa:"Altera a Lei nº 7.689, de 15 de dezembro de 1988, que institui a contribuição social sobre o lucro das pessoas jurídicas.", arquivo:"federal/leis-ordinarias/2022/lei-14446-2022-09-02.md"}}, {id:"federal:BR:L:14396/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-07-08", numero:"14396", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-07-08;14396", vigente:true, titulo:"Lei nº 14.396 de 08/07/2022", urn:"urn:lex:br:federal:lei:2022-07-08;14396", ementa:"Denomina Rodovia Presidente João Goulart o trecho da rodovia BR-153 compreendido entre o Município de Cachoeira do Sul, no Estado do Rio Grande do Sul, e o Município de Marabá, no Estado do Pará.", arquivo:"federal/leis-ordinarias/2022/lei-14396-2022-07-08.md"}}, {id:"federal:BR:L:14325/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-04-12", numero:"14325", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-04-12;14325", vigente:true, titulo:"Lei nº 14.325 de 12/04/2022", urn:"urn:lex:br:federal:lei:2022-04-12;14325", ementa:"Altera a Lei nº 14.113, de 25 de dezembro de 2020, para dispor sobre a utilização dos recursos extraordinários recebidos pelos Estados, pelo Distrito Federal e pelos Municípios em decorrência de decisões judiciais relativas ao cálculo do valor anual por aluno para a distribuição dos recursos oriundos dos fundos e da complementação da União ao Fundo de Manutenção e Desenvolvimento do Ensino Fundamental e de Valorização do Magistério (Fundef), previstos na Lei nº 9.424, de 24 de dezembro de 1996, ", arquivo:"federal/leis-ordinarias/2022/lei-14325-2022-04-12.md"}}, {id:"federal:BR:L:14292/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-01-03", numero:"14292", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-01-03;14292", vigente:true, titulo:"Lei nº 14.292 de 03/01/2022", urn:"urn:lex:br:federal:lei:2022-01-03;14292", ementa:"Altera a Lei nº 9.478, de 6 de agosto de 1997, e a Lei nº 9.718, de 27 de novembro de 1998, para dispor sobre as operações de compra e venda de álcool, a comercialização de combustíveis por revendedor varejista e a incidência da Contribuição para o Programa de Integração Social e o Programa de Formação do Patrimônio do Servidor Público (PIS/Pasep) e da Contribuição para o Financiamento da Seguridade Social (Cofins) nas referidas operações.", arquivo:"federal/leis-ordinarias/2022/lei-14292-2022-01-03.md"}}, {id:"federal:BR:L:14464/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-11-01", numero:"14464", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-11-01;14464", vigente:true, titulo:"Lei nº 14.464 de 01/11/2022", urn:"urn:lex:br:federal:lei:2022-11-01;14464", ementa:"Autoriza o Poder Executivo federal a doar 20 (vinte) viaturas operacionais MBB 1418 revitalizadas ao Exército Paraguaio.", arquivo:"federal/leis-ordinarias/2022/lei-14464-2022-11-01.md"}}, {id:"federal:BR:L:14311/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-03-09", numero:"14311", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-03-09;14311", vigente:true, titulo:"Lei nº 14.311 de 09/03/2022", urn:"urn:lex:br:federal:lei:2022-03-09;14311", ementa:"Altera a Lei nº 14.151, de 12 de maio de 2021, para disciplinar o afastamento da empregada gestante, inclusive a doméstica, não imunizada contra o coronavírus SARS-Cov-2 das atividades de trabalho presencial quando a atividade laboral por ela exercida for incompatível com a sua realização em seu domicílio, por meio de teletrabalho, trabalho remoto ou outra forma de trabalho a distância, nos termos em que especifica.", arquivo:"federal/leis-ordinarias/2022/lei-14311-2022-03-09.md"}}, {id:"federal:BR:L:14447/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-09-09", numero:"14447", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-09-09;14447", vigente:true, titulo:"Lei nº 14.447 de 09/09/2022", urn:"urn:lex:br:federal:lei:2022-09-09;14447", ementa:"Altera os limites da Floresta Nacional de Brasília.", arquivo:"federal/leis-ordinarias/2022/lei-14447-2022-09-09.md"}}, {id:"federal:BR:L:14322/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-04-06", numero:"14322", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-04-06;14322", vigente:true, titulo:"Lei nº 14.322 de 06/04/2022", urn:"urn:lex:br:federal:lei:2022-04-06;14322", ementa:"Altera a Lei nº 11.343, de 23 de agosto de 2006 (Lei Antidrogas), para excluir a possibilidade de restituição ao lesado do veículo usado para transporte de droga ilícita e para permitir a alienação ou o uso público do veículo independentemente da habitualidade da prática criminosa.", arquivo:"federal/leis-ordinarias/2022/lei-14322-2022-04-06.md"}}, {id:"federal:BR:L:14504/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-12-23", numero:"14504", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-12-23;14504", vigente:true, titulo:"Lei nº 14.504 de 23/12/2022", urn:"urn:lex:br:federal:lei:2022-12-23;14504", ementa:"Abre ao Orçamento Fiscal da União, em favor das Justiças Federal e do Trabalho, da Defensoria Pública da União e do Conselho Nacional do Ministério Público, crédito suplementar no valor de R$ 28.681.000,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2022/lei-14504-2022-12-23.md"}}, {id:"federal:BR:L:14361/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-06-01", numero:"14361", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-06-01;14361", vigente:true, titulo:"Lei nº 14.361 de 01/06/2022", urn:"urn:lex:br:federal:lei:2022-06-01;14361", ementa:"Abre crédito extraordinário em favor do Ministério do Desenvolvimento Regional, no valor de R$ 550.000.000,00 (quinhentos e cinquenta milhões de reais), para o fim que especifica.", arquivo:"federal/leis-ordinarias/2022/lei-14361-2022-06-01.md"}}, {id:"federal:BR:L:14332/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-05-04", numero:"14332", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-05-04;14332", vigente:true, titulo:"Lei nº 14.332 de 04/05/2022", urn:"urn:lex:br:federal:lei:2022-05-04;14332", ementa:"Dispõe sobre a arrecadação de recursos por entidades beneficentes de assistência social por meio de títulos de capitalização.", arquivo:"federal/leis-ordinarias/2022/lei-14332-2022-05-04.md"}}, {id:"federal:BR:L:14404/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-07-11", numero:"14404", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-07-11;14404", vigente:true, titulo:"Lei nº 14.404 de 11/07/2022", urn:"urn:lex:br:federal:lei:2022-07-11;14404", ementa:"Institui o Dia Nacional de Conscientização sobre a Fissura Labiopalatina.", arquivo:"federal/leis-ordinarias/2022/lei-14404-2022-07-11.md"}}, {id:"federal:BR:L:14335/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-05-10", numero:"14335", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-05-10;14335", vigente:true, titulo:"Lei nº 14.335 de 10/05/2022", urn:"urn:lex:br:federal:lei:2022-05-10;14335", ementa:"Altera a Lei nº 11.664, de 29 de abril de 2008, para dispor sobre a atenção integral à mulher na prevenção dos cânceres do colo uterino, de mama e colorretal.", arquivo:"federal/leis-ordinarias/2022/lei-14335-2022-05-10.md"}}, {id:"federal:BR:L:14314/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-03-24", numero:"14314", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-03-24;14314", vigente:true, titulo:"Lei nº 14.314 de 24/03/2022", urn:"urn:lex:br:federal:lei:2022-03-24;14314", ementa:"Altera a Lei Complementar nº 173, de 27 de maio de 2020, para ajustar o período de suspensão da contagem dos prazos de validade dos concursos públicos em razão dos impactos econômicos decorrentes da emergência de saúde pública de importância internacional decorrente da covid-19.", arquivo:"federal/leis-ordinarias/2022/lei-14314-2022-03-24.md"}}, {id:"federal:BR:L:14339/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-05-18", numero:"14339", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-05-18;14339", vigente:true, titulo:"Lei nº 14.339 de 18/05/2022", urn:"urn:lex:br:federal:lei:2022-05-18;14339", ementa:"Denomina \"Aeroporto de Angra dos Reis/Rio de Janeiro - Carmelo Jordão\" o aeroporto situado no Município de Angra dos Reis, Estado do Rio de Janeiro.", arquivo:"federal/leis-ordinarias/2022/lei-14339-2022-05-18.md"}}, {id:"federal:BR:L:14313/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-03-21", numero:"14313", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-03-21;14313", vigente:true, titulo:"Lei nº 14.313 de 21/03/2022", urn:"urn:lex:br:federal:lei:2022-03-21;14313", ementa:"Altera a Lei nº 8.080, de 19 de setembro de 1990 (Lei Orgânica da Saúde), para dispor sobre os processos de incorporação de tecnologias ao Sistema Único de Saúde (SUS) e sobre a utilização, pelo SUS, de medicamentos cuja indicação de uso seja distinta daquela aprovada no registro da Agência Nacional de Vigilância Sanitária (Anvisa).", arquivo:"federal/leis-ordinarias/2022/lei-14313-2022-03-21.md"}}, {id:"federal:BR:L:14438/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-08-24", numero:"14438", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-08-24;14438", vigente:true, titulo:"Lei nº 14.438 de 24/08/2022", urn:"urn:lex:br:federal:lei:2022-08-24;14438", ementa:"Institui o Programa de Simplificação do Microcrédito Digital para Empreendedores (SIM Digital); promove alterações na gestão e nos procedimentos de recolhimento do Fundo de Garantia do Tempo de Serviço (FGTS); altera a Consolidação das Leis do Trabalho (CLT), aprovada pelo Decreto-Lei nº 5.452, de 1º de maio de 1943, e as Leis nºs 8.212, de 24 de julho de 1991, 11.196, de 21 de novembro de 2005, 8.036, de 11 de maio de 1990, 13.636, de 20 de março de 2018, e 14.118, de 12 de janeiro de 2021; e r", arquivo:"federal/leis-ordinarias/2022/lei-14438-2022-08-24.md"}}, {id:"federal:BR:L:14379/2022", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2022, data:"2022-06-22", numero:"14379", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2022-06-22;14379", vigente:true, titulo:"Lei nº 14.379 de 22/06/2022", urn:"urn:lex:br:federal:lei:2022-06-22;14379", ementa:"Denomina Passarela Hermínio Pertel a passarela construída na BR-101, Rodovia Governador Mário Covas, na localidade de Guatemala, Município de Ibiraçu, Estado do Espírito Santo.", arquivo:"federal/leis-ordinarias/2022/lei-14379-2022-06-22.md"}}, {id:"federal:BR:L:14383/2022", propertie