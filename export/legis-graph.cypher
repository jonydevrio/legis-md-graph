3-2000-07-24.md"}}, {id:"federal:BR:L:10086/2000", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2000, data:"2000-12-18", numero:"10086", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2000-12-18;10086", vigente:true, titulo:"Lei nº 10.086 de 18/12/2000", urn:"urn:lex:br:federal:lei:2000-12-18;10086", ementa:"Abre ao Orçamento Fiscal da União, em favor de diversos Órgãos do Poder Judiciário e do Ministério Público da União, crédito suplementar no valor de R$ 529.598.104,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2000/lei-10086-2000-12-18.md"}}, {id:"federal:BR:L:10103/2000", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2000, data:"2000-12-21", numero:"10103", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2000-12-21;10103", vigente:true, titulo:"Lei nº 10.103 de 21/12/2000", urn:"urn:lex:br:federal:lei:2000-12-21;10103", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério do Meio   Ambiente, crédito especial no valor de R$ 110.000,00, para os fins que   especifica.", arquivo:"federal/leis-ordinarias/2000/lei-10103-2000-12-21.md"}}, {id:"federal:BR:L:9972/2000", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2000, data:"2000-05-25", numero:"9972", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2000-05-25;9972", vigente:true, titulo:"Lei nº 9.972 de 25/05/2000", urn:"urn:lex:br:federal:lei:2000-05-25;9972", ementa:"Institui a classificação de produtos vegetais, subprodutos e resíduos de valor econômico, e dá outras providências.", arquivo:"federal/leis-ordinarias/2000/lei-9972-2000-05-25.md"}}, {id:"federal:BR:L:10159/2000", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2000, data:"2000-12-22", nu