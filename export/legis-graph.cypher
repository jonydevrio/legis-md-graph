da=false", ano:1959, data:"1959-11-16", numero:"3662", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-11-16;3662", vigente:true, titulo:"Lei nº 3.662 de 16/11/1959", urn:"urn:lex:br:federal:lei:1959-11-16;3662", ementa:"Cria cargos isolados, de provimento efetivo, no Magistério do   Exército.", arquivo:"federal/leis-ordinarias/1959/lei-3662-1959-11-16.md"}}, {id:"federal:BR:L:3536/1959", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1959, data:"1959-01-26", numero:"3536", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1959-01-26;3536", vigente:true, titulo:"Lei nº 3.536 de 26/01/1959", urn:"urn:lex:br:federal:lei:1959-01-26;3536", ementa:"Concede auxílio de Cr$ 400.000,00 à Associação Brasileira de Enfermagem para comparecimento da Delegação Brasileira ao XI Congresso Quadrienal de Enfermagem.", arquivo:"federal/leis-ordinarias/1959/lei-3536-1959-01-26.md"}}, {id:"federal:BR:L:4529/1964", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-12-08", numero:"4529", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-12-08;4529", vigente:true, titulo:"Lei nº 4.529 de 08/12/1964", urn:"urn:lex:br:federal:lei:1964-12-08;4529", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério do Trabalho e Previdência Social, o crédito suplementar de Cr$ 11.400.000.000,00 (onze bilhões e quatrocentos milhões de cruzeiros), para atender ao pagamento de despesas que especifica.", arquivo:"federal/leis-ordinarias/1964/lei-4529-1964-12-08.md"}}, {id:"federal:BR:L:4363/1964", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-07-17", numero:"4363", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-07-17;4363", vigente:true, titulo:"Lei nº 4.363 de 17/07/1964", urn:"urn:lex:br:federal:lei:1964-07-17;4363", ementa:"Autoriza a criação da Escola de Arquitetura da Universidade do Ceará e dá   outras providências.", arquivo:"federal/leis-ordinarias/1964/lei-4363-1964-07-17.md"}}, {id:"federal:BR:L:4459/1964", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-11-07", numero:"4459", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-11-07;4459", vigente:true, titulo:"Lei nº 4.459 de 07/11/1964", urn:"urn:lex:br:federal:lei:1964-11-07;4459", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações   Exteriores, o crédito especial de Cr$ 107.484.000,00, para atender às despesas   com o comparecimento do Episcopado brasileiro ao Concílio Ecumênico Vaticano   II.", arquivo:"federal/leis-ordinarias/1964/lei-4459-1964-11-07.md"}}, {id:"federal:BR:L:4431/1964", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-10-20", numero:"4431", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-10-20;4431", vigente:true, titulo:"Lei nº 4.431 de 20/10/1964", urn:"urn:lex:br:federal:lei:1964-10-20;4431", ementa:"Retifica, sem ônus, a Lei nº 4.295, de 16 de dezembro de 1963, que estima a Receita e fixa a Despesa da União para exercício de 1964.", arquivo:"federal/leis-ordinarias/1964/lei-4431-1964-10-20.md"}}, {id:"federal:BR:L:4366/1964", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-07-23", numero:"4366", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-07-23;4366", vigente:true, titulo:"Lei nº 4.366 de 23/07/1964", urn:"urn:lex:br:federal:lei:1964-07-23;4366", ementa:"Autoriza o Poder Executivo a financiar, mediante empréstimos às municipalidades, o estudo e construção de sistemas públicos de abastecimento de água potável e dá outras providências.", arquivo:"federal/leis-ordinarias/1964/lei-4366-1964-07-23.md"}}, {id:"federal:BR:L:4495/1964", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-11-25", numero:"4495", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-11-25;4495", vigente:true, titulo:"Lei nº 4.495 de 25/11/1964", urn:"urn:lex:br:federal:lei:1964-11-25;4495", ementa:"Enquadra os atuais professores fundadores em cargos de Professor do Ensino Superior.", arquivo:"federal/leis-ordinarias/1964/lei-4495-1964-11-25.md"}}, {id:"federal:BR:L:4537/1964", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-12-09", numero:"4537", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-12-09;4537", vigente:true, titulo:"Lei nº 4.537 de 09/12/1964", urn:"urn:lex:br:federal:lei:1964-12-09;4537", ementa:"Cria Juntas de Conciliação e Julgamento na 4ª Região da Justiça do Trabalho e dá outras providências.", arquivo:"federal/leis-ordinarias/1964/lei-4537-1964-12-09.md"}}, {id:"federal:BR:L:4421/1964", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-09-29", numero:"4421", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-09-29;4421", vigente:true, titulo:"Lei nº 4.421 de 29/09/1964", urn:"urn:lex:br:federal:lei:1964-09-29;4421", ementa:"Transforma a Escola Paulista de Medicina em estabelecimento isolado de ensino superior de natureza autárquica, e dá outras providências.", arquivo:"federal/leis-ordinarias/1964/lei-4421-1964-09-29.md"}}, {id:"federal:BR:L:4447/1964", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-10-29", numero:"4447", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-10-29;4447", vigente:true, titulo:"Lei nº 4.447 de 29/10/1964", urn:"urn:lex:br:federal:lei:1964-10-29;4447", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério das Relações Exteriores, o crédito especial de Cr$ 35.000.000,00 (trinta e cinco milhões de cruzeiros) para atender às despesas decorrentes da visita ao Brasil do Presidente dos Estados Unidos da América.", arquivo:"federal/leis-ordinarias/1964/lei-4447-1964-10-29.md"}}, {id:"federal:BR:L:4382/1964", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-08-24", numero:"4382", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-08-24;4382", vigente:true, titulo:"Lei nº 4.382 de 24/08/1964", urn:"urn:lex:br:federal:lei:1964-08-24;4382", ementa:"Isenta dos emolumentos consulares o embarque de quatro centrais termelétricas.", arquivo:"federal/leis-ordinarias/1964/lei-4382-1964-08-24.md"}}, {id:"federal:BR:L:4393/1964", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-08-31", numero:"4393", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-08-31;4393", vigente:true, titulo:"Lei nº 4.393 de 31/08/1964", urn:"urn:lex:br:federal:lei:1964-08-31;4393", ementa:"Cria no Ministério da Educação e Cultura - Conselho Federal de Educação -   cargos em comissão de Secretário-Geral e Secretários de Câmaras.", arquivo:"federal/leis-ordinarias/1964/lei-4393-1964-08-31.md"}}, {id:"federal:BR:L:4589/1964", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-12-11", numero:"4589", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-12-11;4589", vigente:true, titulo:"Lei nº 4.589 de 11/12/1964", urn:"urn:lex:br:federal:lei:1964-12-11;4589", ementa:"Extingue a Comissão do Imposto Sindical, a Comissão Técnica de Orientação Sindical cria órgãos no Ministério do Trabalho e Previdência Social, e dá outras providências.", arquivo:"federal/leis-ordinarias/1964/lei-4589-1964-12-11.md"}}, {id:"federal:BR:L:4511/1964", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-12-01", numero:"4511", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-12-01;4511", vigente:true, titulo:"Lei nº 4.511 de 01/12/1964", urn:"urn:lex:br:federal:lei:1964-12-01;4511", ementa:"Dispõe sobre o meio circulante, e dá outras providências.", arquivo:"federal/leis-ordinarias/1964/lei-4511-1964-12-01.md"}}, {id:"federal:BR:L:4336/1964", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-06-01", numero:"4336", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-06-01;4336", vigente:true, titulo:"Lei nº 4.336 de 01/06/1964", urn:"urn:lex:br:federal:lei:1964-06-01;4336", ementa:"Altera dispositivo do Código do Processo Penal.", arquivo:"federal/leis-ordinarias/1964/lei-4336-1964-06-01.md"}}, {id:"federal:BR:L:4518/1964", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-12-02", numero:"4518", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-12-02;4518", vigente:true, titulo:"Lei nº 4.518 de 02/12/1964", urn:"urn:lex:br:federal:lei:1964-12-02;4518", ementa:"Dispõe sobre associados obrigatórios do Serviço de Assistência e Seguro Social dos Economiários.", arquivo:"federal/leis-ordinarias/1964/lei-4518-1964-12-02.md"}}, {id:"federal:BR:L:4530/1964", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1964, data:"1964-12-08", numero:"4530", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1964-12-08;4530", vigente:true, titulo:"Lei nº 4.530 de 08/12/1964", urn:"urn:lex:br:federal:lei:1964-12-08;4530", ementa:"Extingue a Comissão de Reparações de Guerra e dá outras providências.", arquivo:"federal/leis-ordi