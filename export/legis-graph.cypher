1620-1952-06-09.md"}}, {id:"federal:BR:L:1634/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-07-03", numero:"1634", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-07-03;1634", vigente:true, titulo:"Lei nº 1.634 de 03/07/1952", urn:"urn:lex:br:federal:lei:1952-07-03;1634", ementa:"Autoriza a abertura, pelo Ministério das Relações Exteriores, do crédito especial de Cr$ 500.000,00, para atender às despesas decorrentes da realização do VIII Congresso da Comissão Interamericana de Mulheres.", arquivo:"federal/leis-ordinarias/1952/lei-1634-1952-07-03.md"}}, {id:"federal:BR:L:1574/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-03-13", numero:"1574", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-03-13;1574", vigente:true, titulo:"Lei nº 1.574 de 13/03/1952", urn:"urn:lex:br:federal:lei:1952-03-13;1574", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Aeronáutica, o crédito especial de Cr$ 30.391.198,30, para atender ao pagamento de indenização devida a Construções Aeronáuticas S.A., concessionária da Fábrica de Aviões da Lagoa Santa, no Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/1952/lei-1574-1952-03-13.md"}}, {id:"federal:BR:L:1545/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-01-08", numero:"1545", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-01-08;1545", vigente:true, titulo:"Lei nº 1.545 de 08/01/1952", urn:"urn:lex:br:federal:lei:1952-01-08;1545", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário, o crédito especial de Cr$ 9.000,00, para pagamento de diferença de aluguel do prédio-sede do Tribunal Regional Eleitoral do Ceará.", arquivo:"federal/leis-ordinarias/1952/lei-1545-1952-01-08.md"}}, {id:"federal:BR:L:1780/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-12-23", numero:"1780", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-12-23;1780", vigente:true, titulo:"Lei nº 1.780 de 23/12/1952", urn:"urn:lex:br:federal:lei:1952-12-23;1780", ementa:"Reajusta os proventos dos inativos do Departamento dos Correios e Telégrafos.", arquivo:"federal/leis-ordinarias/1952/lei-1780-1952-12-23.md"}}, {id:"federal:BR:L:1608/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-05-22", numero:"1608", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-05-22;1608", vigente:true, titulo:"Lei nº 1.608 de 22/05/1952", urn:"urn:lex:br:federal:lei:1952-05-22;1608", ementa:"Altera o art. 59 do Decreto-Lei n° 9.120, de 2 de abril de 1946, referente à organização dos quadros efetivos do Exército.", arquivo:"federal/leis-ordinarias/1952/lei-1608-1952-05-22.md"}}, {id:"federal:BR:L:1641/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-07-14", numero:"1641", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-07-14;1641", vigente:true, titulo:"Lei nº 1.641 de 14/07/1952", urn:"urn:lex:br:federal:lei:1952-07-14;1641", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 79.657.946,00, para completar o pagamento devido aos municípios pela cota do imposto de renda.", arquivo:"federal/leis-ordinarias/1952/lei-1641-1952-07-14.md"}}, {id:"federal:BR:L:1791/1952", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1952, data:"1952-12-30", numero:"1791", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1952-12-30;1791", vigente:true, titulo:"Lei nº 1.791 de 30/12/1952", urn:"urn:lex:br:federa