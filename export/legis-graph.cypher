12", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-05-28", numero:"12654", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-05-28;12654", vigente:true, titulo:"Lei nº 12.654 de 28/05/2012", urn:"urn:lex:br:federal:lei:2012-05-28;12654", ementa:"Altera as Leis nºs 12.037, de 1º de outubro de 2009, e 7.210, de 11 de julho de 1984 - Lei de Execução Penal, para prever a coleta de perfil genético como forma de identificação criminal, e dá outras providências.", arquivo:"federal/leis-ordinarias/2012/lei-12654-2012-05-28.md"}}, {id:"federal:BR:L:12755/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-12-19", numero:"12755", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-12-19;12755", vigente:true, titulo:"Lei nº 12.755 de 19/12/2012", urn:"urn:lex:br:federal:lei:2012-12-19;12755", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor dos Ministérios da Previdência Social, do Trabalho e Emprego e do Desenvolvimento Social e Combate à Fome, crédito especial no valor de R$ 9.030.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2012/lei-12755-2012-12-19.md"}}, {id:"federal:BR:L:12671/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-06-19", numero:"12671", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-06-19;12671", vigente:true, titulo:"Lei nº 12.671 de 19/06/2012", urn:"urn:lex:br:federal:lei:2012-06-19;12671", ementa:"Cria cargos de Advogado da União.", arquivo:"federal/leis-ordinarias/2012/lei-12671-2012-06-19.md"}}, {id:"federal:BR:L:12707/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-08-08", numero:"12707", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-08-08;12707", vigente:true, titulo:"Lei nº 12.707 de 08/08/2012", urn:"urn:lex:br:federal:lei:2012-08-08;12707", ementa:"Dá a denominação de Aeroporto de Bauru - Comandante João Ribeiro de Barros ao Aeroporto de Bauru, no Estado de São Paulo.", arquivo:"federal/leis-ordinarias/2012/lei-12707-2012-08-08.md"}}, {id:"federal:BR:L:12595/2012", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-01-19", numero:"12595", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-01-19;12595", vigente:true, titulo:"Lei nº 12.595 de 19/01/2012", urn:"urn:lex:br:federal:lei:2012-01-19;12595", ementa:"Estima a receita e fixa a despesa da União para o exercício financeiro de 2012.", arquivo:"federal/leis-ordinarias/2012/lei-12595-2012-01-19.md"}}, {id:"federal:BR:L:12600/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-03-23", numero:"12600", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-03-23;12600", vigente:true, titulo:"Lei nº 12.600 de 23/03/2012", urn:"urn:lex:br:federal:lei:2012-03-23;12600", ementa:"Cria os cargos de Juiz-Auditor e Juiz-Auditor Substituto para a 2ª Auditoria da 11ª Circunscrição Judiciária Militar, no âmbito da Justiça Militar da União; revoga dispositivos da Lei nº 10.333, de 19 de dezembro de 2001; e dá outras providências.", arquivo:"federal/leis-ordinarias/2012/lei-12600-2012-03-23.md"}}, {id:"federal:BR:L:12746/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-12-19", numero:"12746", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-12-19;12746", vigente:true, titulo:"Lei nº 12.746 de 19/12/2012", urn:"urn:lex:br:federal:lei:2012-12-19;12746", ementa:"Abre aos Orçamentos Fiscal e da Seguridade Social da União, em favor dos Ministérios da Justiça e da Defesa, crédito suplementar no valor global de R$ 802.197.850,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2012/lei-12746-2012-12-19.md"}}, {id:"federal:BR:L:12658/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-06-05", numero:"12658", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-06-05;12658", vigente:true, titulo:"Lei nº 12.658 de 05/06/2012", urn:"urn:lex:br:federal:lei:2012-06-05;12658", ementa:"Dispõe sobre a criação de Varas do Trabalho na jurisdição do Tribunal Regional do Trabalho da 12ª Região e dá outras providências.", arquivo:"federal/leis-ordinarias/2012/lei-12658-2012-06-05.md"}}, {id:"federal:BR:L:12773/2012", properties:{esfera:"federal", versao_texto:"republicação/retificação", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-12-28", numero:"12773", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-12-28;12773", vigente:true, titulo:"Lei nº 12.773 de 28/12/2012", urn:"urn:lex:br:federal:lei:2012-12-28;12773", ementa:"Altera a Lei nº 11.415, de 15 de dezembro de 2006, que dispõe sobre as Carreiras dos Servidores do Ministério Público da União, fixa os valores de sua remuneração e dá outras providências.", arquivo:"federal/leis-ordinarias/2012/lei-12773-2012-12-28.md"}}, {id:"federal:BR:L:12674/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-06-25", numero:"12674", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-06-25;12674", vigente:true, titulo:"Lei nº 12.674 de 25/06/2012", urn:"urn:lex:br:federal:lei:2012-06-25;12674", ementa:"Dispõe sobre a criação de Varas do Trabalho na jurisdição do Tribunal Regional do Trabalho da 10ª Região e dá outras providências.", arquivo:"federal/leis-ordinarias/2012/lei-12674-2012-06-25.md"}}, {id:"federal:BR:L:12680/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-06-28", numero:"12680", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-06-28;12680", vigente:true, titulo:"Lei nº 12.680 de 28/06/2012", urn:"urn:lex:br:federal:lei:2012-06-28;12680", ementa:"Abre crédito extraordinário, em favor do Ministério da Defesa, no valor de R$ 40.000.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/2012/lei-12680-2012-06-28.md"}}, {id:"federal:BR:L:12715/2012", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-09-17", numero:"12715", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-09-17;12715", vigente:true, titulo:"Lei nº 12.715 de 17/09/2012", urn:"urn:lex:br:federal:lei:2012-09-17;12715", ementa:"Altera a alíquota das contribuições previdenciárias sobre a folha de salários devidas pelas empresas que especifica; institui o Programa de Incentivo à Inovação Tecnológica e Adensamento da Cadeia Produtiva de Veículos Automotores, o Regime Especial de Tributação do Programa Nacional de Banda Larga para Implantação de Redes de Telecomunicações, o Regime Especial de Incentivo a Computadores para Uso Educacional, o Programa Nacional de Apoio à Atenção Oncológica e o Programa Nacional de Apoio à At", arquivo:"federal/leis-ordinarias/2012/lei-12715-2012-09-17.md"}}, {id:"federal:BR:L:12765/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-12-27", numero:"12765", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-12-27;12765", vigente:true, titulo:"Lei nº 12.765 de 27/12/2012", urn:"urn:lex:br:federal:lei:2012-12-27;12765", ementa:"Altera as Leis nºs 12.468, de 26 de agosto de 2011, e 6.094, de 30 de agosto de 1974; e dá outras providências.", arquivo:"federal/leis-ordinarias/2012/lei-12765-2012-12-27.md"}}, {id:"federal:BR:L:12723/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-10-09", numero:"12723", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-10-09;12723", vigente:true, titulo:"Lei nº 12.723 de 09/10/2012", urn:"urn:lex:br:federal:lei:2012-10-09;12723", ementa:"Altera o Decreto-Lei nº 1.455, de 7 de abril de 1976, que dispõe sobre bagagem de passageiro procedente do exterior, disciplina o regime de entreposto aduaneiro, estabelece normas sobre mercadorias estrangeiras apreendidas e dá outras providências, para autorizar a instalação de lojas francas em Municípios da faixa de fronteira cujas sedes se caracterizam como cidades gêmeas de cidades estrangeiras e para aplicar penalidade aos responsáveis dos órgãos da administração direta ou indireta que dolo", arquivo:"federal/leis-ordinarias/2012/lei-12723-2012-10-09.md"}}, {id:"federal:BR:L:12621/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-05-08", numero:"12621", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-05-08;12621", vigente:true, titulo:"Lei nº 12.621 de 08/05/2012", urn:"urn:lex:br:federal:lei:2012-05-08;12621", ementa:"Institui o Dia Nacional do Maquinista Ferroviário.", arquivo:"federal/leis-ordinarias/2012/lei-12621-2012-05-08.md"}}, {id:"federal:BR:L:12701/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-08-06", numero:"12701", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-08-06;12701", vigente:true, titulo:"Lei nº 12.701 de 06/08/2012", urn:"urn:lex:br:federal:lei:2012-08-06;12701", ementa:"Inscreve os nomes de Francisco Barreto de Menezes, João Fernandes Vieira, André Vidal de Negreiros, Henrique Dias, Antônio Filipe Camarão e Antônio Dias Cardoso no Livro dos Heróis da Pátria.", arquivo:"federal/leis-ordinarias/2012/lei-12701-2012-08-06.md"}}, {id:"federal:BR:L:12737/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-11-30", numero:"12737", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-11-30;12737", vigente:true, titulo:"Lei nº 12.737 de 30/11/2012", urn:"urn:lex:br:federal:lei:2012-11-30;12737", ementa:"Dispõe sobre a tipificação criminal de delitos informáticos; altera o Decreto-Lei nº 2.848, de 7 de dezembro de 1940 - Código Penal; e dá outras providências.", arquivo:"federal/leis-ordinarias/2012/lei-12737-2012-11-30.md"}}, {id:"federal:BR:L:12641/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-05-15", numero:"12641", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-05-15;12641", vigente:true, titulo:"Lei nº 12.641 de 15/05/2012", urn:"urn:lex:br:federal:lei:2012-05-15;12641", ementa:"Institui o dia 12 de agosto como o Dia Nacional dos Direitos Humanos.", arquivo:"federal/leis-ordinarias/2012/lei-12641-2012-05-15.md"}}, {id:"federal:BR:L:12618/2012", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-04-30", numero:"12618", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-04-30;12618", vigente:true, titulo:"Lei nº 12.618 de 30/04/2012", urn:"urn:lex:br:federal:lei:2012-04-30;12618", ementa:"Institui o regime de previdência complementar para os servidores públicos federais titulares de cargo efetivo, inclusive os membros dos órgãos que menciona; fixa o limite máximo para a concessão de aposentadorias e pensões pelo regime de previdência de que trata o art. 40 da Constituição Federal; autoriza a criação de 3 (três) entidades fechadas de previdência complementar, denominadas Fundação de Previdência Complementar do Servidor Público Federal do Poder Executivo (Funpresp-Exe), Fundação de", arquivo:"federal/leis-ordinarias/2012/lei-12618-2012-04-30.md"}}, {id:"federal:BR:L:12688/2012", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-07-18", numero:"12688", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-07-18;12688", vigente:true, titulo:"Lei nº 12.688 de 18/07/2012", urn:"urn:lex:br:federal:lei:2012-07-18;12688", ementa:"Autoriza a Centrais Elétricas Brasileiras S.A. (Eletrobras) a adquirir o controle acionário da Celg Distribuição S.A. (Celg D); institui o Programa de Estímulo à Reestruturação e ao Fortalecimento das Instituições de Ensino Superior (Proies); altera as Leis nºs 3.890-A, de 25 de abril de 1961, 9.718, de 27 de novembro de 1998, 10.637, de 30 de dezembro de 2002, 10.887, de 18 de junho de 2004, 10.833, de 29 de dezembro de 2003, 11.033, de 21 de dezembro de 2004, 11.128, de 28 de junho de 2005, 11", arquivo:"federal/leis-ordinarias/2012/lei-12688-2012-07-18.md"}}, {id:"federal:BR:L:12740/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-12-08", numero:"12740", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-12-08;12740", vigente:true, titulo:"Lei nº 12.740 de 08/12/2012", urn:"urn:lex:br:federal:lei:2012-12-08;12740", ementa:"Altera o art. 193 da Consolidação das Leis do Trabalho - CLT, aprovada pelo Decreto- Lei nº 5.452, de 1º de maio de 1943, a fim de redefinir os critérios para caracterização das atividades ou operações perigosas, e revoga a Lei nº 7.369, de 20 de setembro de 1985.", arquivo:"federal/leis-ordinarias/2012/lei-12740-2012-12-08.md"}}, {id:"federal:BR:L:12633/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-05-14", numero:"12633", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-05-14;12633", vigente:true, titulo:"Lei nº 12.633 de 14/05/2012", urn:"urn:lex:br:federal:lei:2012-05-14;12633", ementa:"Institui o Dia Nacional da Educação Ambiental.", arquivo:"federal/leis-ordinarias/2012/lei-12633-2012-05-14.md"}}, {id:"federal:BR:L:12627/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-05-11", numero:"12627", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-05-11;12627", vigente:true, titulo:"Lei nº 12.627 de 11/05/2012", urn:"urn:lex:br:federal:lei:2012-05-11;12627", ementa:"Institui o Dia Nacional dos Portadores de Vitiligo.", arquivo:"federal/leis-ordinarias/2012/lei-12627-2012-05-11.md"}}, {id:"federal:BR:L:12725/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-10-16", numero:"12725", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-10-16;12725", vigente:true, titulo:"Lei nº 12.725 de 16/10/2012", urn:"urn:lex:br:federal:lei:2012-10-16;12725", ementa:"Dispõe sobre o controle da fauna nas imediações de aeródromos.", arquivo:"federal/leis-ordinarias/2012/lei-12725-2012-10-16.md"}}, {id:"federal:BR:L:12719/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-09-26", numero:"12719", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-09-26;12719", vigente:true, titulo:"Lei nº 12.719 de 26/09/2012", urn:"urn:lex:br:federal:lei:2012-09-26;12719", ementa:"Altera o inciso III do art. 2º da Lei nº 11.476, de 29 de maio de 2007, para permitir que os portadores de diploma de técnico de nível médio em Enologia e os alunos que ingressaram em curso deste nível até 29 de maio de 2007 possam exercer a profissão de enólogo, e dá outras providências.", arquivo:"federal/leis-ordinarias/2012/lei-12719-2012-09-26.md"}}, {id:"federal:BR:L:12699/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-07-30", numero:"12699", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-07-30;12699", vigente:true, titulo:"Lei nº 12.699 de 30/07/2012", urn:"urn:lex:br:federal:lei:2012-07-30;12699", ementa:"Abre ao Orçamento Fiscal da União, em favor de Operações Oficiais de Crédito, crédito suplementar no valor de R$ 1.355.000.000,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2012/lei-12699-2012-07-30.md"}}, {id:"federal:BR:L:12759/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-12-19", numero:"12759", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-12-19;12759", vigente:true, titulo:"Lei nº 12.759 de 19/12/2012", urn:"urn:lex:br:federal:lei:2012-12-19;12759", ementa:"Abre ao Orçamento Fiscal da União, em favor dos Ministérios da Justiça e da Defesa, crédito suplementar no valor de R$ 590.979.322,00, para reforço de dotações constantes da Lei Orçamentária vigente.", arquivo:"federal/leis-ordinarias/2012/lei-12759-2012-12-19.md"}}, {id:"federal:BR:L:12732/2012", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-11-22", numero:"12732", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-11-22;12732", vigente:true, titulo:"Lei nº 12.732 de 22/11/2012", urn:"urn:lex:br:federal:lei:2012-11-22;12732", ementa:"Dispõe sobre o primeiro tratamento de paciente com neoplasia maligna comprovada e estabelece prazo para seu início.", arquivo:"federal/leis-ordinarias/2012/lei-12732-2012-11-22.md"}}, {id:"federal:BR:L:12777/2012", properties:{esfera:"federal", versao_texto:"compilada (texto v