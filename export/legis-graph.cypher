51/lei-1437-1951-09-19.md"}}, {id:"federal:BR:L:1353/1951", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1951, data:"1951-04-02", numero:"1353", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1951-04-02;1353", vigente:true, titulo:"Lei nº 1.353 de 02/04/1951", urn:"urn:lex:br:federal:lei:1951-04-02;1353", ementa:"Considera de utilidade pública a Casa do Policial, sediada na cidade do   Rio de Janeiro.", arquivo:"federal/leis-ordinarias/1951/lei-1353-1951-04-02.md"}}, {id:"federal:BR:L:1532/1951", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1951, data:"1951-12-31", numero:"1532", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1951-12-31;1532", vigente:true, titulo:"Lei nº 1.532 de 31/12/1951", urn:"urn:lex:br:federal:lei:1951-12-31;1532", ementa:"Restabelece entre os Institutos e Caixas de Aposentadoria e Pensões, comunidade de serviços médicos para combate à tuberculose e outras molétias nocivas à coletividade, cria Conselho de Medicina da Previdência Social e dá outras providências.", arquivo:"federal/leis-ordinarias/1951/lei-1532-1951-12-31.md"}}, {id:"federal:BR:L:1471/1951", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1951, data:"1951-11-21", numero:"1471", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1951-11-21;1471", vigente:true, titulo:"Lei nº 1.471 de 21/11/1951", urn:"urn:lex:br:federal:lei:1951-11-21;1471", ementa:"Extingue o Departamento Administrativo de Recuperação do Material e dá outras providências.", arquivo:"federal/leis-ordinarias/1951/lei-1471-1951-11-21.md"}}, {id:"federal:BR:L:1314/1951", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1951, data:"1951-01-17", numero:"1314", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1951-01