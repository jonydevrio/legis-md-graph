, vigente:true, titulo:"Lei nº 9.658 de 05/06/1998", urn:"urn:lex:br:federal:lei:1998-06-05;9658", ementa:"Dá nova redação ao art. 11 da Consolidação das Leis do Trabalho e   determina outras providências.", arquivo:"federal/leis-ordinarias/1998/lei-9658-1998-06-05.md"}}, {id:"federal:BR:L:9667/1998", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1998, data:"1998-06-23", numero:"9667", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1998-06-23;9667", vigente:true, titulo:"Lei nº 9.667 de 23/06/1998", urn:"urn:lex:br:federal:lei:1998-06-23;9667", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento Fiscal da União, em favor   do Ministério da Educação e do Desporto, crédito especial até o limite de R$   5.003.898,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1998/lei-9667-1998-06-23.md"}}, {id:"federal:BR:L:9662/1998", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1998, data:"1998-06-19", numero:"9662", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1998-06-19;9662", vigente:true, titulo:"Lei nº 9.662 de 19/06/1998", urn:"urn:lex:br:federal:lei:1998-06-19;9662", ementa:"Autoriza o Poder Executivo a abrir aos Orçamentos Fiscal e da Seguridade   Social da União, em favor do Ministério das Comunicações, crédito especial até o   limite de R$ 500.000.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1998/lei-9662-1998-06-19.md"}}, {id:"federal:BR:L:9757/1998", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1998, data:"1998-12-17", numero:"9757", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1998-12-17;9757", vigente:true, titulo:"Lei nº 9.757 de 17/12/1998", urn:"urn:lex:br:federal:lei:1998-12-17;9757", ementa:"Abre ao Orçamento de Investimento, em favor de diversas empresas estatais federais, crédito especial até o limite de R$ 155.786.645,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1998/lei-9757-1998-12-17.md"}}, {id:"federal:BR:L:9695/1998", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1998, data:"1998-08-20", numero:"9695", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1998-08-20;9695", vigente:true, titulo:"Lei nº 9.695 de 20/08/1998", urn:"urn:lex:br:federal:lei:1998-08-20;9695", ementa:"Acrescenta incisos ao art. 1º da Lei nº 8.072, de 25 de julho de 1990, que dispõe sobre os crimes hediondos, e altera os arts. 2º, 5º e 10 da Lei nº 6.437, de 20 de agosto de 1977, e dá outras providências.", arquivo:"federal/leis-ordinarias/1998/lei-9695-1998-08-20.md"}}, {id:"federal:BR:L:9603/1998", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1998, data:"1998-01-22", numero:"9603", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1998-01-22;9603", vigente:true, titulo:"Lei nº 9.603 de 22/01/1998", urn:"urn:lex:br:federal:lei:1998-01-22;9603", ementa:"Autoriza o Ministério dos Transportes, por intermédio da Companhia   Brasileira de Trens Urbanos - CBTU, a repassar à Companhia Cearense de   Transportes Metropolitanos - METROFOR recursos para pagamento de pessoal.", arquivo:"federal/leis-ordinarias/1998/lei-9603-1998-01-22.md"}}, {id:"federal:BR:L:9749/1998", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1998, data:"1998-12-16", numero:"9749", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1998-12-16;9749", vigente:true, titulo:"Lei nº 9.749 de 16/12/1998", urn:"urn:lex:br:federal:lei:1998-12-16;9749", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento Fiscal da União, em favor do Ministério do Planejamento e Orçamento, crédito especial até o limite de R$ 360.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1998/lei-9749-1998-12-16.md"}}, {id:"federal:BR:L:9620/1998", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1998, data:"1998-04-02", numero:"9620", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1998-04-02;9620", vigente:true, titulo:"Lei nº 9.620 de 02/04/1998", urn:"urn:lex:br:federal:lei:1998-04-02;9620", ementa:"Cria carreiras no âmbito do Poder Executivo Federal, cria as Gratificações de Desempenho e Eficiência - GDE e de Desempenho de Atividade de Defesa Agropecuária - GDA e dá outras providências.", arquivo:"federal/leis-ordinarias/1998/lei-9620-1998-04-02.md"}}, {id:"federal:BR:L:9712/1998", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1998, data:"1998-11-20", numero:"9712", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1998-11-20;9712", vigente:true, titulo:"Lei nº 9.712 de 20/11/1998", urn:"urn:lex:br:federal:lei:1998-11-20;9712", ementa:"Altera a Lei nº 8.171, de 17 de janeiro de 1991, acrescentando-lhe dispositivos referentes à defesa agropecuária.", arquivo:"federal/leis-ordinarias/1998/lei-9712-1998-11-20.md"}}, {id:"federal:BR:L:5259/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-12", numero:"5259", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-12;5259", vigente:true, titulo:"Lei nº 5.259 de 12/04/1967", urn:"urn:lex:br:federal:lei:1967-04-12;5259", ementa:"Isenta dos impostos de importação e de consumo, bem como da taxa de despacho aduaneiro, o barco doado ao Museu de Biologia Professor Melo Leitão.", arquivo:"federal/leis-ordinarias/1967/lei-5259-1967-04-12.md"}}, {id:"federal:BR:L:5354/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-11-09", numero:"5354", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-11-09;5354", vigente:true, titulo:"Lei nº 5.354 de 09/11/1967", urn:"urn:lex:br:federal:lei:1967-11-09;5354", ementa:"Isenta dos impostos de importação e sôbre produtos industrializados, material importado pela Sociedade Telefônica de Franca Ltda. e destinado à ampliação de uma central telefônica sistema A.G.F.", arquivo:"federal/leis-ordinarias/1967/lei-5354-1967-11-09.md"}}, {id:"federal:BR:L:5201/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-12", numero:"5201", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-12;5201", vigente:true, titulo:"Lei nº 5.201 de 12/01/1967", urn:"urn:lex:br:federal:lei:1967-01-12;5201", ementa:"Altera o artigo 1º da Lei nº 4.662, de 2 de junho de 1965, no concernente à denominação da Faculdade de Farmácia da Universidade Federal do Ceará.", arquivo:"federal/leis-ordinarias/1967/lei-5201-1967-01-12.md"}}, {id:"federal:BR:L:5280/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-27", numero:"5280", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-27;5280", vigente:true, titulo:"Lei nº 5.280 de 27/04/1967", urn:"urn:lex:br:federal:lei:1967-04-27;5280", ementa:"Proíbe a entrada no País de máquinas e maquinismos sem os dispositivos de proteção e segurança do trabalho exigidos pela Consolidação das Leis do Trabalho, e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5280-1967-04-27.md"}}, {id:"federal:BR:L:5263/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-17", numero:"5263", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-17;5263", vigente:true, titulo:"Lei nº 5.263 de 17/04/1967", urn:"urn:lex:br:federal:lei:1967-04-17;5263", ementa:"Auroriza o Poder Executivo a abrir, ao Ministério da Educação e Cultura, o crédito especial de NCr$ 3.500.000,00 (três milhões e quinhentos mil cruzeiros novos) destinados à Fundação Universidade de Brasília.", arquivo:"federal/leis-ordinarias/1967/lei-5263-1967-04-17.md"}}, {id:"federal:BR:L:5199/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-12", numero:"5199", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-12;5199", vigente:true, titulo:"Lei nº 5.199 de 12/01/1967", urn:"urn:lex:br:federal:lei:1967-01-12;5199", ementa:"Altera a redação do art. 6, parágrafo único, da Lei nº 1. 628, de 20 de junho de 1952, que dispõe sobre \"Obrigações do Reaparelhamento Econômico\".", arquivo:"federal/leis-ordinarias/1967/lei-5199-1967-01-12.md"}}, {id:"federal:BR:L:5256/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-06", numero:"5256", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-06;5256", titulo:"Lei nº 5.256 de 06/04/1967", vigente:true, urn:"urn:lex:br:federal:lei:1967-04-06;5256", ementa:"Dispõe sôbre a prisão especial.", arquivo:"federal/leis-ordinarias/1967/lei-5256-1967-04-06.md"}}, {id:"federal:BR:L:5290/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-05-25", numero:"5290", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-05-25;5290", vigente:true, titulo:"Lei nº 5.290 de 25/05/1967", urn:"urn:lex:br:federal:lei:1967-05-25;5290", ementa:"Autoriza o Poder Executivo a abrir ao Ministério dos Transportes o crédito especial de NCr$ 2.000.000,00 (dois milhões de cruzeiros novos), para atender a despesas com pagamento de gratificação salarial ao pessoal da Rede Ferroviária Federal S.A.", arquivo:"federal/leis-ordinarias/1967/lei-5290-1967-05-25.md"}}, {id:"federal:BR:L:5361/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-11-29", numero:"5361", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-11-29;5361", vigente:true, titulo:"Lei nº 5.361 de 29/11/1967", urn:"urn:lex:br:federal:lei:1967-11-29;5361", ementa:"Autoriza o Poder Executivo a doar, à Cruz Vermelha Internacional, até 1.000 (mil) sacas de café.", arquivo:"federal/leis-ordinarias/1967/lei-5361-1967-11-29.md"}}, {id:"federal:BR:L:5269/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-20", numero:"5269", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-20;5269", vigente:true, titulo:"Lei nº 5.269 de 20/04/1967", urn:"urn:lex:br:federal:lei:1967-04-20;5269", ementa:"Altera, sem aumento de despesas, dotações do Poder Legislativo - Câmara dos Deputados - consignadas na Lei nº 4.900, de 10 de dezembro de 1965.", arquivo:"federal/leis-ordinarias/1967/lei-5269-1967-04-20.md"}}, {id:"federal:BR:L:5229/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-18", numero:"5229", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-18;5229", vigente:true, titulo:"Lei nº 5.229 de 18/01/1967", urn:"urn:lex:br:federal:lei:1967-01-18;5229", ementa:"Autoriza o Poder Executivo, pelo Ministério da Fazenda, a doar, ao   Movimento Universitário de Desenvolvimento Econômico e Social \"MUDES\",   Obrigações Reajustáveis do Tesouro Nacional, e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5229-1967-01-18.md"}}, {id:"federal:BR:L:5317/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-09-21", numero:"5317", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-09-21;5317", vigente:true, titulo:"Lei nº 5.317 de 21/09/1967", urn:"urn:lex:br:federal:lei:1967-09-21;5317", ementa:"Concede isenção dos impostos de importação e sôbre produtos industrializados para material importado pela Companhia Telefônica Ponte Novense, de Ponte Nova, Estado de Minas Gerais.", arquivo:"federal/leis-ordinarias/1967/lei-5317-1967-09-21.md"}}, {id:"federal:BR:L:5260/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-12", numero:"5260", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-12;5260", vigente:true, titulo:"Lei nº 5.260 de 12/04/1967", urn:"urn:lex:br:federal:lei:1967-04-12;5260", ementa:"Isenta dos impostos de importação e de consumo, bem como taxa de despacho aduaneiro, equipamento complementar a um conjunto eletrônico, importado pelo Centro Eletrônico de Processamento de Dados do Paraná S/A.", arquivo:"federal/leis-ordinarias/1967/lei-5260-1967-04-12.md"}}, {id:"federal:BR:L:5289/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-05-25", numero:"5289", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-05-25;5289", vigente:true, titulo:"Lei nº 5.289 de 25/05/1967", urn:"urn:lex:br:federal:lei:1967-05-25;5289", ementa:"Autoriza o Poder Executivo a doar à Ação Paroquial de Assistência de Limoeiro o imóvel situado na Rua de Santa Cruz, nº 215, em Limoeiro, Estado de Pernambuco.", arquivo:"federal/leis-ordinarias/1967/lei-5289-1967-05-25.md"}}, {id:"federal:BR:L:5335/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-10-12", numero:"5335", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-10-12;5335", vigente:true, titulo:"Lei nº 5.335 de 12/10/1967", urn:"urn:lex:br:federal:lei:1967-10-12;5335", ementa:"Dá a denominação de Via Prestes Maia à BR-101, do Plano Rodoviário Nacional.", arquivo:"federal/leis-ordinarias/1967/lei-5335-1967-10-12.md"}}, {id:"federal:BR:L:5279/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-27", numero:"5279", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-27;5279", vigente:true, titulo:"Lei nº 5.279 de 27/04/1967", urn:"urn:lex:br:federal:lei:1967-04-27;5279", ementa:"Prorroga o prazo para apresentação de declarações do impôsto de renda, no corrente exercício, e dá outras ovidências.", arquivo:"federal/leis-ordinarias/1967/lei-5279-1967-04-27.md"}}, {id:"federal:BR:L:5222/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-17", numero:"5222", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-17;5222", vigente:true, titulo:"Lei nº 5.222 de 17/01/1967", urn:"urn:lex:br:federal:lei:1967-01-17;5222", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 172.369.000 (cento e setenta e dois milhões trezentos e sessenta e nove mil cruzeiros), destinado a regularizar despesas com a subscrição de 172.369 ações da Companhia Vale do Rio Doce pelo Tesouro Nacional.", arquivo:"federal/leis-ordinarias/1967/lei-5222-1967-01-17.md"}}, {id:"federal:BR:L:5244/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-31", numero:"5244", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-31;5244", vigente:true, titulo:"Lei nº 5.244 de 31/01/1967", urn:"urn:lex:br:federal:lei:1967-01-31;5244", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça Eleitoral - Tribunal Regional Eleitoral do Rio Grande do Sul - o crédito especial de Cr$ 31.330 (trinta e um mil, trezentos e trinta cruzeiros), para os fins que especifica.", arquivo:"federal/leis-ordinarias/1967/lei-5244-1967-01-31.md"}}, {id:"federal:BR:L:5214/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-16", numero:"5214", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-16;5214", vigente:true, titulo:"Lei nº 5.214 de 16/01/1967", urn:"urn:lex:br:federal:lei:1967-01-16;5214", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 133.724.236 (cento e trinta e três milhões setecentos e vinte e quatro mil duzentos e trinta e seis cruzeiros), para atender a despesas decorrentes do cumprimento de sentença prolatada pelo Supremo Tribunal Federal, em que são recorrentes as empresas \"Varig\", \"Real\" e recorrida a União Federal.", arquivo:"federal/leis-ordinarias/1967/lei-5214-1967-01-16.md"}}, {id:"federal:BR:L:5299/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-06-23", numero:"5299", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-06-23;5299", vigente:true, titulo:"Lei nº 5.299 de 23/06/1967", urn:"urn:lex:br:federal:lei:1967-06-23;5299", ementa:"Dispõe sobre a contratação de pessoal técnico especializado de nível médio e superior pela Comissão Nacional de Energia Nuclear e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5299-1967-06-23.md"}}, {id:"federal:BR:L:5322/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-09-29", numero:"5322", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-09-29;5322", vigente:true, titulo:"Lei nº 5.322 de 29/09/1967", urn:"urn:lex:br:federal:lei:1967-09-29;5322", ementa:"Dispõe sôbre a mudança de denominação do Aeroporto de Uruguaiana para Aeroporto Rubem Berta.", arquivo:"federal/leis-ordinarias/1967/lei-5322-1967-09-29.md"}}, {id:"federal:BR:L:5292/1967", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-06-08", numero:"5292", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-06-08;5292", vigente:true, titulo:"Lei nº 5.292 de 08/06/1967", urn:"urn:lex:br:federal:lei:1967-06-08;5292", ementa:"Dispõe sôbre a prestação do Serviço Militar pelos estudantes de Medicina, Farmácia, Odontologia e Veterinária e pelos Médicos, Farmacêuticos, Dentistas e Veterinários em decorrência de dispositivos da Lei nº 4.375, de 17 de agôsto de 1964.", arquivo:"federal/leis-ordinarias/1967/lei-5292-1967-06-08.md"}}, {id:"federal:BR:L:5378/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-12-15", numero:"5378", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-12-15;5378", vigente:true, titulo:"Lei nº 5.378 de 15/12/1967", urn:"urn:lex:br:federal:lei:1967-12-15;5378", ementa:"Retifica, sem ônus, a Lei nº 5.189, de 8 de dezembro de 1966, que estima a Receita e fixa a Despesa da União para o exercício financeiro de 1967.", arquivo:"federal/leis-ordinarias/1967/lei-5378-1967-12-15.md"}}, {id:"federal:BR:L:5267/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-17", numero:"5267", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-17;5267", vigente:true, titulo:"Lei nº 5.267 de 17/04/1967", urn:"urn:lex:br:federal:lei:1967-04-17;5267", ementa:"Proíbe a exibição de \"trailers\" de filmes impróprios para crianças, nos espetáculos para menores.", arquivo:"federal/leis-ordinarias/1967/lei-5267-1967-04-17.md"}}, {id:"federal:BR:L:5205/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-12", numero:"5205", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-12;5205", vigente:true, titulo:"Lei nº 5.205 de 12/01/1967", urn:"urn:lex:br:federal:lei:1967-01-12;5205", ementa:"Isenta dos impostos de importação e de consumo equipamento importado pela Cooperativa Central dos Produtores Rurais de Minas Gerais Ltda., destinado à ampliação de fábrica de leite em pó, instalada em Sete Lagoas.", arquivo:"federal/leis-ordinarias/1967/lei-5205-1967-01-12.md"}}, {id:"federal:BR:L:5233/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-20", numero:"5233", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-20;5233", vigente:true, titulo:"Lei nº 5.233 de 20/01/1967", urn:"urn:lex:br:federal:lei:1967-01-20;5233", ementa:"Altera o item III do artigo 178 da Lei nº 1.711, de 28 de outubro de 1952 (Estatuto dos Funcionários Públicos Civis da União), incluindo a doença de Parkinson entre as que dão direito à aposentadoria integral.", arquivo:"federal/leis-ordinarias/1967/lei-5233-1967-01-20.md"}}, {id:"federal:BR:L:5240/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-31", numero:"5240", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-31;5240", vigente:true, titulo:"Lei nº 5.240 de 31/01/1967", urn:"urn:lex:br:federal:lei:1967-01-31;5240", ementa:"Fixa em 10% (dez por cento) ad valorem a alíquota incidente sôbre películas destinadas à fabricação de filmes foto-sensíveis.", arquivo:"federal/leis-ordinarias/1967/lei-5240-1967-01-31.md"}}, {id:"federal:BR:L:5332/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-10-11", numero:"5332", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-10-11;5332", vigente:true, titulo:"Lei nº 5.332 de 11/10/1967", urn:"urn:lex:br:federal:lei:1967-10-11;5332", ementa:"Dispõe sobre o arrendamento de áreas aeroportuárias às empresas e pessoas físicas ou jurídicas ligadas às atividades aeronáuticas.", arquivo:"federal/leis-ordinarias/1967/lei-5332-1967-10-11.md"}}, {id:"federal:BR:L:5294/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-06-15", numero:"5294", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-06-15;5294", vigente:true, titulo:"Lei nº 5.294 de 15/06/1967", urn:"urn:lex:br:federal:lei:1967-06-15;5294", ementa:"Concede isenção de impostos para equipamento telefônico destinado à Companhia Telefônica \" Melhoramento e Resistência \", com sede em Pelotas, Estado do Rio Grande do Sul.", arquivo:"federal/leis-ordinarias/1967/lei-5294-1967-06-15.md"}}, {id:"federal:BR:L:5283/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-28", numero:"5283", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-28;5283", vigente:true, titulo:"Lei nº 5.283 de 28/04/1967", urn:"urn:lex:br:federal:lei:1967-04-28;5283", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério das Minas e Energia, o crédito especial de NCr$ 36.000,00 (trinta e seis mil cruzeiros novos) destinado a pagamento de aluguel de imóveis e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5283-1967-04-28.md"}}, {id:"federal:BR:L:5210/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-16", numero:"5210", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-16;5210", vigente:true, titulo:"Lei nº 5.210 de 16/01/1967", urn:"urn:lex:br:federal:lei:1967-01-16;5210", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Fazenda, o crédito especial de Cr$ 8.050.000 (oito milhões e cinqüenta mil cruzeiros), destinado à Delegacia Fiscal do Tesouro Nacional, no Estado da Bahia.", arquivo:"federal/leis-ordinarias/1967/lei-5210-1967-01-16.md"}}, {id:"federal:BR:L:5305/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-07-04", numero:"5305", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-07-04;5305", vigente:true, titulo:"Lei nº 5.305 de 04/07/1967", urn:"urn:lex:br:federal:lei:1967-07-04;5305", ementa:"Altera, sem ônus, a Lei nº 5.189, de 8 de dezembro de 1966, que estima a Receita e fixa a Despesa da União para o exercício financeiro de 1967.", arquivo:"federal/leis-ordinarias/1967/lei-5305-1967-07-04.md"}}, {id:"federal:BR:L:5366/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-12-01", numero:"5366", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-12-01;5366", vigente:true, titulo:"Lei nº 5.366 de 01/12/1967", urn:"urn:lex:br:federal:lei:1967-12-01;5366", ementa:"Concede pensão especial ao cidadão brasileiro Leopoldo Jacob Arnt,   ex-proprietário da antiga Navegação Arnt Ltda., do Rio Grande do Sul, e dá   outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5366-1967-12-01.md"}}, {id:"federal:BR:L:5314/1967", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-09-11", numero:"5314", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-09-11;5314", vigente:true, titulo:"Lei nº 5.314 de 11/09/1967", urn:"urn:lex:br:federal:lei:1967-09-11;5314", ementa:"Estabelece normas sobre a fiscalização de mercadorias estrangeiras e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5314-1967-09-11.md"}}, {id:"federal:BR:L:5347/1967", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-11-03", numero:"5347", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-11-03;5347", vigente:true, titulo:"Lei nº 5.347 de 03/11/1967", urn:"urn:lex:br:federal:lei:1967-11-03;5347", ementa:"Concede pensão especial aos doutores Orozimbo Corrêa Neto e Esperidião Gabínio de Carvalho, ex-médico da Comissão Rondon, e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5347-1967-11-03.md"}}, {id:"federal:BR:L:5239/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-31", numero:"5239", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-31;5239", vigente:true, titulo:"Lei nº 5.239 de 31/01/1967", urn:"urn:lex:br:federal:lei:1967-01-31;5239", ementa:"Abre ao Ministério da Viação e Obras Públicas o crédito especial de Cr$ 659.880.000 (seiscentos e cinqüenta e nove milhões oitocentos e oitenta mil cruzeiros) para atender, no corrente ano, às despesas com o aumento de salário do pessoal da Companhia de Navegação Bahiana.", arquivo:"federal/leis-ordinarias/1967/lei-5239-1967-01-31.md"}}, {id:"federal:BR:L:5209/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-16", numero:"5209", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-16;5209", vigente:true, titulo:"Lei nº 5.209 de 16/01/1967", urn:"urn:lex:br:federal:lei:1967-01-16;5209", ementa:"Abre ao Ministério da Saúde o crédito especial de Cr$ 942.142.836 (novecentos e quarenta e dois milhões cento e quarenta e dois mil oitocentos e trinta e seis cruzeiros), destinado aos encargos de desapropriação do prédio ocupado pelo Laboratório Central de Controle de Drogas, Medicamentos e Alimentos.", arquivo:"federal/leis-ordinarias/1967/lei-5209-1967-01-16.md"}}, {id:"federal:BR:L:5226/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-17", numero:"5226", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-17;5226", vigente:true, titulo:"Lei nº 5.226 de 17/01/1967", urn:"urn:lex:br:federal:lei:1967-01-17;5226", ementa:"Autoriza a abertura do crédito especial de Cr$ 986.563.164 (novecentos e oitenta e seis milhões quinhentos e sessenta e três mil cento e sessenta e quatro cruzeiros), destinado à restituição, pela Caixa de Amortização, de indenizações trabalhistas e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5226-1967-01-17.md"}}, {id:"federal:BR:L:5371/1967", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-12-05", numero:"5371", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-12-05;5371", vigente:true, titulo:"Lei nº 5.371 de 05/12/1967", urn:"urn:lex:br:federal:lei:1967-12-05;5371", ementa:"Autoriza a instituição da \"Fundação Nacional do Índio\" e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5371-1967-12-05.md"}}, {id:"federal:BR:L:5254/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-04", numero:"5254", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-04;5254", vigente:true, titulo:"Lei nº 5.254 de 04/04/1967", urn:"urn:lex:br:federal:lei:1967-04-04;5254", ementa:"Prorroga o prazo de existência do Conselho Federal de Odontologia provisória e dá otras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5254-1967-04-04.md"}}, {id:"federal:BR:L:5218/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-16", numero:"5218", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-16;5218", vigente:true, titulo:"Lei nº 5.218 de 16/01/1967", urn:"urn:lex:br:federal:lei:1967-01-16;5218", ementa:"Autoriza a abertura do crédito especial de Cr$ 3.024.000.000 (três bilhões e vinte e quatro milhões de cruzeiros) ao Ministério da Saúde, para atender ao pagamento das diferenças de vencimentos e vantagens decorrentes do enquadramento definitivo dos seus funcionários.", arquivo:"federal/leis-ordinarias/1967/lei-5218-1967-01-16.md"}}, {id:"federal:BR:L:5285/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-05-05", numero:"5285", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-05-05;5285", vigente:true, titulo:"Lei nº 5.285 de 05/05/1967", urn:"urn:lex:br:federal:lei:1967-05-05;5285", ementa:"Dispõe sobre a ocupação de próprios da União por servidores públicos federais e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5285-1967-05-05.md"}}, {id:"federal:BR:L:5308/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-07-07", numero:"5308", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-07-07;5308", vigente:true, titulo:"Lei nº 5.308 de 07/07/1967", urn:"urn:lex:br:federal:lei:1967-07-07;5308", ementa:"Altera o art. 15 do Decreto-lei nº 157, de 10 de fevereiro de 1967, que \" concede estímulos fiscais à capitalização das empresas; reforça os incentivos à compra de ações; facilita o pagamento de débitos fiscais \", e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5308-1967-07-07.md"}}, {id:"federal:BR:L:5369/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-12-04", numero:"5369", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-12-04;5369", vigente:true, titulo:"Lei nº 5.369 de 04/12/1967", urn:"urn:lex:br:federal:lei:1967-12-04;5369", ementa:"Prorroga, por 180 (cento e oitenta) dias, o prazo estabelecido no art. 11 da Lei nº 5.276, de 24 de abril de 1967, que dispõe sobre a profissão de Nutricionista, regula o seu exercício, e dá outras providências.", arquivo:"federal/leis-ordinarias/1967/lei-5369-1967-12-04.md"}}, {id:"federal:BR:L:5320/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-09-29", numero:"5320", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-09-29;5320", vigente:true, titulo:"Lei nº 5.320 de 29/09/1967", urn:"urn:lex:br:federal:lei:1967-09-29;5320", ementa:"Dispõe sôbre referência ao título profissional de funcionário público civil da União, no caso e pela forma que especifica.", arquivo:"federal/leis-ordinarias/1967/lei-5320-1967-09-29.md"}}, {id:"federal:BR:L:5265/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-17", numero:"5265", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-17;5265", vigente:true, titulo:"Lei nº 5.265 de 17/04/1967", urn:"urn:lex:br:federal:lei:1967-04-17;5265", ementa:"Autoriza o Poder Executivo a abrir, ao Ministério da Justiça, o crédito especial de NCr$ 2.535.000,00 (dois milhões, quinhentos e trinta e cinco mil cruzeiros novos), destinado à Polícia do Distrito Federal.", arquivo:"federal/leis-ordinarias/1967/lei-5265-1967-04-17.md"}}, {id:"federal:BR:L:5203/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-12", numero:"5203", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-12;5203", vigente:true, titulo:"Lei nº 5.203 de 12/01/1967", urn:"urn:lex:br:federal:lei:1967-01-12;5203", ementa:"Autoriza a abertura do crédito especial de Cr$ 738.300.000 (setecentos e trinta e oito milhões e trezentos mil cruzeiros) ao Ministro Extraordinario para a Coordenação dos Organismos Regionais, para ser aplicado pela Fundação Brasil Central.", arquivo:"federal/leis-ordinarias/1967/lei-5203-1967-01-12.md"}}, {id:"federal:BR:L:5339/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-10-18", numero:"5339", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-10-18;5339", vigente:true, titulo:"Lei nº 5.339 de 18/10/1967", urn:"urn:lex:br:federal:lei:1967-10-18;5339", ementa:"Concede reajustamento de proventos da aposentadoria do ex-funcionário Índio Tamoyo do Prado.", arquivo:"federal/leis-ordinarias/1967/lei-5339-1967-10-18.md"}}, {id:"federal:BR:L:5330/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-10-11", numero:"5330", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-10-11;5330", vigente:true, titulo:"Lei nº 5.330 de 11/10/1967", urn:"urn:lex:br:federal:lei:1967-10-11;5330", ementa:"Inclui, nas isenções do imposto sôbre produtos industrializados, material bélico e aeronaves de uso militar.", arquivo:"federal/leis-ordinarias/1967/lei-5330-1967-10-11.md"}}, {id:"federal:BR:L:5257/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-07", numero:"5257", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-07;5257", vigente:true, titulo:"Lei nº 5.257 de 07/04/1967", urn:"urn:lex:br:federal:lei:1967-04-07;5257", ementa:"Dispõe sôbre as Tomadas de Contas em atraso dos exatores   federais.", arquivo:"federal/leis-ordinarias/1967/lei-5257-1967-04-07.md"}}, {id:"federal:BR:L:5237/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-31", numero:"5237", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-31;5237", vigente:true, titulo:"Lei nº 5.237 de 31/01/1967", urn:"urn:lex:br:federal:lei:1967-01-31;5237", ementa:"Abre ao Ministério da Saúde o crédito especial de Cr$ 8.700.000.000 (oito bilhões e setecentos milhões de cruzeiros), para atender aos encargos do ano de 1965 da Fundação Serviço Especial de Saúde Pública, destinando-se Cr$ 3.500.000.000 (três bilhões e quinhentos milhões de cruzeiros) à regularização de despesa já realizada.", arquivo:"federal/leis-ordinarias/1967/lei-5237-1967-01-31.md"}}, {id:"federal:BR:L:5247/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-02-02", numero:"5247", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-02-02;5247", vigente:true, titulo:"Lei nº 5.247 de 02/02/1967", urn:"urn:lex:br:federal:lei:1967-02-02;5247", ementa:"Concede a isenção prevista na alínea \"c\" do item I do art. 1º da Lei nº 4.622, de 3 de maio de 1965, a equipamentos importados, para execução de projetos industriais aprovados pelo Grupo Executivo das Indústrias Mecânicas.", arquivo:"federal/leis-ordinarias/1967/lei-5247-1967-02-02.md"}}, {id:"federal:BR:L:5231/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-01-19", numero:"5231", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-01-19;5231", vigente:true, titulo:"Lei nº 5.231 de 19/01/1967", urn:"urn:lex:br:federal:lei:1967-01-19;5231", ementa:"Autoriza o Poder Executivo a abrir ao Poder Judiciário - Justiça Eleitoral - Tribunal Superior Eleitoral - crédito especial para pagamento de exercícios findos.", arquivo:"federal/leis-ordinarias/1967/lei-5231-1967-01-19.md"}}, {id:"federal:BR:L:5262/1967", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1967, data:"1967-04-12", numero:"5262", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1967-04-12;5262", vigente:true, titulo:"Lei nº 5.262 de 12/04/1967", urn:"urn:lex:br:federal:lei:1967-04-12;5262", ementa:"Isenta do imposto de importação, do imposto sobre produtos industrializados e da taxa de despacho aduaneiro, equipamentos destinados à ampliação de uma fábrica de prensados duros de fibras de madeira.", arquivo:"federal/leis-ordinarias/1967/lei-5262-1967-04-12.md"}}] AS row
CREATE (n:Norma{id: row.id}) SET n += row.properties SET n:Lei;
