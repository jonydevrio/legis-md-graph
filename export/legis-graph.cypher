, fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-12-27;12769", vigente:true, titulo:"Lei nº 12.769 de 27/12/2012", urn:"urn:lex:br:federal:lei:2012-12-27;12769", ementa:"Abre ao Orçamento Fiscal da União, em favor dos Ministérios da Justiça e da Defesa, crédito especial no valor de R$ 165.930.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2012/lei-12769-2012-12-27.md"}}, {id:"federal:BR:L:12681/2012", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-07-04", numero:"12681", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-07-04;12681", vigente:true, titulo:"Lei nº 12.681 de 04/07/2012", urn:"urn:lex:br:federal:lei:2012-07-04;12681", ementa:"Institui o Sistema Nacional de Informações de Segurança Pública, Prisionais e sobre Drogas - SINESP; altera as Leis nºs 10.201, de 14 de fevereiro de 2001, e 11.530, de 24 de outubro de 2007, a Lei Complementar nº 79, de 7 de janeiro de 1994, e o Decreto- Lei nº 3.689, de 3 de outubro de 1941 - Código de Processo Penal; e revoga dispositivo da Lei nº 10.201, de 14 de fevereiro de 2001.", arquivo:"federal/leis-ordinarias/2012/lei-12681-2012-07-04.md"}}, {id:"federal:BR:L:12716/2012", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-09-21", numero:"12716", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-09-21;12716", vigente:true, titulo:"Lei nº 12.716 de 21/09/2012", urn:"urn:lex:br:federal:lei:2012-09-21;12716", ementa:"Altera as Leis nºs 10.177, de 12 de janeiro de 2001, 7.827, de 27 de setembro de 1989, 11.524, de 24 de setembro de 2007, 11.775, de 17 de setembro de 2008, 9.469, de 10 de julho de 1997, 11.196, de 21 de novembro de 2005, 8.029, de 12 de abril de 1990, 10.954, de 29 de setembro de 2004, e 11.314, de 3 de julho de 2006; e dá outras providências.", arquivo:"federal/leis-ordinarias/2012/lei-12716-2012-09-21.md"}}, {id:"federal:BR:L:12761/2012", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-12-27", numero:"12761", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-12-27;12761", vigente:true, titulo:"Lei nº 12.761 de 27/12/2012", urn:"urn:lex:br:federal:lei:2012-12-27;12761", ementa:"Institui o Programa de Cultura do Trabalhador; cria o vale-cultura; altera as Leis nºs 8.212, de 24 de julho de 1991, e 7.713, de 22 de dezembro de 1988, e a Consolidação das Leis do Trabalho - CLT, aprovada pelo Decreto-Lei nº 5.452, de 1º de maio de 1943; e dá outras providências.", arquivo:"federal/leis-ordinarias/2012/lei-12761-2012-12-27.md"}}, {id:"federal:BR:L:12644/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-05-16", numero:"12644", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-05-16;12644", titulo:"Lei nº 12.644 de 16/05/2012", vigente:true, urn:"urn:lex:br:federal:lei:2012-05-16;12644", ementa:"Institui o Dia Nacional da Umbanda.", arquivo:"federal/leis-ordinarias/2012/lei-12644-2012-05-16.md"}}, {id:"federal:BR:L:12751/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-12-19", numero:"12751", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-12-19;12751", vigente:true, titulo:"Lei nº 12.751 de 19/12/2012", urn:"urn:lex:br:federal:lei:2012-12-19;12751", ementa:"Abre ao Orçamento Fiscal da União, em favor de Encargos Financeiros da União, crédito especial no valor de R$ 1.790.000.000,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/2012/lei-12751-2012-12-19.md"}}, {id:"federal:BR:L:12624/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-05-09", numero:"12624", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-05-09;12624", vigente:true, titulo:"Lei nº 12.624 de 09/05/2012", urn:"urn:lex:br:federal:lei:2012-05-09;12624", ementa:"Institui o dia 17 de outubro como o Dia Nacional da Música Popular Brasileira.", arquivo:"federal/leis-ordinarias/2012/lei-12624-2012-05-09.md"}}, {id:"federal:BR:L:12663/2012", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-06-05", numero:"12663", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-06-05;12663", vigente:true, titulo:"Lei nº 12.663 de 05/06/2012", urn:"urn:lex:br:federal:lei:2012-06-05;12663", ementa:"Dispõe sobre as medidas relativas à Copa das Confederações FIFA 2013, à Copa do Mundo FIFA 2014 e à Jornada Mundial da Juventude - 2013, que serão realizadas no Brasil; altera as Leis nºs 6.815, de 19 de agosto de 1980, e 10.671, de 15 de maio de 2003; e estabelece concessão de prêmio e de auxílio especial mensal aos jogadores das seleções campeãs do mundo em 1958, 1962 e 1970.", arquivo:"federal/leis-ordinarias/2012/lei-12663-2012-06-05.md"}}, {id:"federal:BR:L:12714/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-09-14", numero:"12714", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2012-09-14;12714", vigente:true, titulo:"Lei nº 12.714 de 14/09/2012", urn:"urn:lex:br:federal:lei:2012-09-14;12714", ementa:"Dispõe sobre o sistema de acompanhamento da execução das penas, da prisão cautelar e da medida de segurança.", arquivo:"federal/leis-ordinarias/2012/lei-12714-2012-09-14.md"}}, {id:"federal:BR:L:12637/2012", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2012, data:"2012-05-14", numero:"12637", fonte:"https://normas.leg.br/?urn=urn:lex:br:f