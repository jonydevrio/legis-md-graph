30.md"}}, {id:"federal:BR:L:13895/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-10-30", numero:"13895", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-10-30;13895", vigente:true, titulo:"Lei nº 13.895 de 30/10/2019", urn:"urn:lex:br:federal:lei:2019-10-30;13895", ementa:"Institui a Política Nacional de Prevenção do Diabetes e de Assistência Integral à Pessoa Diabética.", arquivo:"federal/leis-ordinarias/2019/lei-13895-2019-10-30.md"}}, {id:"federal:BR:L:13946/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-13", numero:"13946", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-13;13946", vigente:true, titulo:"Lei nº 13.946 de 13/12/2019", urn:"urn:lex:br:federal:lei:2019-12-13;13946", ementa:"Abre ao Orçamento Fiscal da União, em favor do Ministério da Defesa, crédito especial no valor de R$ 3.162.567,00, para o fim que especifica.", arquivo:"federal/leis-ordinarias/2019/lei-13946-2019-12-13.md"}}, {id:"federal:BR:L:13952/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-12-16", numero:"13952", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2019-12-16;13952", vigente:true, titulo:"Lei nº 13.952 de 16/12/2019", urn:"urn:lex:br:federal:lei:2019-12-16;13952", ementa:"Abre ao Orçamento Fiscal da União, em favor dos Ministérios da Educação, do Desenvolvimento Regional e do Turismo, crédito especial no valor de R$ 69.345.645,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2019/lei-13952-2019-12-16.md"}}, {id:"federal:BR:L:13868/2019", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2019, data:"2019-09-03", numero:"13868", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei