as/2006/lei-11407-2006-12-15.md"}}, {id:"federal:BR:L:11412/2006", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:2006, data:"2006-12-15", numero:"11412", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:2006-12-15;11412", vigente:true, titulo:"Lei nº 11.412 de 15/12/2006", urn:"urn:lex:br:federal:lei:2006-12-15;11412", ementa:"Abre ao Orçamento de Investimento para 2006, em favor de empresas do Grupo ELETROBRÁS, crédito suplementar no valor total de R$ 408.871.889,00 e reduz o Orçamento de Investimento de empresas do mesmo Grupo no valor global de R$ 758.445.333,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/2006/lei-11412-2006-12-15.md"}}] AS row
