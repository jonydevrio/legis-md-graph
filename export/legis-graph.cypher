}}, {id:"federal:BR:L:9406/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1996, data:"1996-12-20", numero:"9406", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-12-20;9406", vigente:true, titulo:"Lei nº 9.406 de 20/12/1996", urn:"urn:lex:br:federal:lei:1996-12-20;9406", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento da Seguridade Social da União, em favor do Ministério da Saúde, crédito especial até o limite de R$ 1.306.252,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1996/lei-9406-1996-12-20.md"}}, {id:"federal:BR:L:9342/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1996, data:"1996-12-12", numero:"9342", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-12-12;9342", vigente:true, titulo:"Lei nº 9.342 de 12/12/1996", urn:"urn:lex:br:federal:lei:1996-12-12;9342", ementa:"Autoriza o Poder Executivo a abrir ao Orçamenrto Fiscal da União, em favor do Estado-Maior das Forças Armadas, crédito suplementar no valor de R$ 50.715.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1996/lei-9342-1996-12-12.md"}}, {id:"federal:BR:L:9420/1996", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1996, data:"1996-12-24", numero:"9420", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1996-12-24;9420", vigente:true, titulo:"Lei nº 9.420 de 24/12/1996", urn:"urn:lex:br:federal:lei:1996-12-24;9420", ementa:"Autoriza o Poder Executivo a abrir aos Orçamentos Fiscal e da Seguridade Social da União, em favor do Ministério da Fazenda, do Ministério da Indústria, do Comércio e do Turismo e de Transferências a Estados, Distrito Federal e Municípios, crédito suplementar no valor de R$ 110.820.935,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1996/lei-9420-1996-12-24.md"}},