3-1948-12-13.md"}}, {id:"federal:BR:L:323/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-08-11", numero:"323", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-08-11;323", vigente:true, titulo:"Lei nº 323 de 11/08/1948", urn:"urn:lex:br:federal:lei:1948-08-11;323", ementa:"Acrescenta um parágrafo ao artigo 5º do Decreto-lei nº 8.818, de 1946.", arquivo:"federal/leis-ordinarias/1948/lei-323-1948-08-11.md"}}, {id:"federal:BR:L:499/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-11-28", numero:"499", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-11-28;499", vigente:true, titulo:"Lei nº 499 de 28/11/1948", urn:"urn:lex:br:federal:lei:1948-11-28;499", ementa:"Fixa os vencimentos da Magistratura e do Ministério Público da União.", arquivo:"federal/leis-ordinarias/1948/lei-499-1948-11-28.md"}}, {id:"federal:BR:L:273/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-04-20", numero:"273", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-04-20;273", vigente:true, titulo:"Lei nº 273 de 20/04/1948", urn:"urn:lex:br:federal:lei:1948-04-20;273", ementa:"Dá nova redação ao parágrafo único do artigo 2º, da Lei número 140, de 18 de   Novembro de 1947.", arquivo:"federal/leis-ordinarias/1948/lei-273-1948-04-20.md"}}, {id:"federal:BR:L:238/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-02-12", numero:"238", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-02-12;238", vigente:true, titulo:"Lei nº 238 de 12/02/1948", urn:"urn:lex:br:federal:lei:1948-02-12;238", ementa:"Autoriza a abertura, ao Congresso Nacional de Crédito especial para   pagamento de deferença de gratificação adicional.", arquivo:"federal/leis-ordinarias/1948/lei-238-1948-02-12.md"}}, {id:"federal:BR:L:263/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-02-23", numero:"263", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-02-23;263", vigente:true, titulo:"Lei nº 263 de 23/02/1948", urn:"urn:lex:br:federal:lei:1948-02-23;263", ementa:"Modifica a competência de Tribunal de Júri e dá outras providências.", arquivo:"federal/leis-ordinarias/1948/lei-263-1948-02-23.md"}}, {id:"federal:BR:L:481/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-11-12", numero:"481", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-11-12;481", vigente:true, titulo:"Lei nº 481 de 12/11/1948", urn:"urn:lex:br:federal:lei:1948-11-12;481", ementa:"Abre, pelo Ministério da Fazenda, créditos especiais para pagamento à   Viação Férrea Rio Grande do Sul, à Rede Mineira de Viação e à Great Western of   Brazil Ry, Co. Ltda.", arquivo:"federal/leis-ordinarias/1948/lei-481-1948-11-12.md"}}, {id:"federal:BR:L:447/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-10-20", numero:"447", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-10-20;447", vigente:true, titulo:"Lei nº 447 de 20/10/1948", urn:"urn:lex:br:federal:lei:1948-10-20;447", ementa:"Autoriza a abertura, pelo Ministério da Educação e Saúde, de crédito   especial para ocorrer as despesas com a construção da Cidade   Universitária.", arquivo:"federal/leis-ordinarias/1948/lei-447-1948-10-20.md"}}, {id:"federal:BR:L:419/1948", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-10-03", numero:"419", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-10-03;419", vigente:true, titulo:"Lei nº 419 de 03/10/1948", urn:"urn:lex:br:federal:lei:1948-10-03;419", ementa:"Isenta de toda tributação os animais importados para reprodução e melhoria da pecuária nacional, adquiridos em país estrangeiro, por compra direta de criador brasileiro, ou que se consignem às nossas exposições-feiras.", arquivo:"federal/leis-ordinarias/1948/lei-419-1948-10-03.md"}}, {id:"federal:BR:L:470/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-11-05", numero:"470", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-11-05;470", vigente:true, titulo:"Lei nº 470 de 05/11/1948", urn:"urn:lex:br:federal:lei:1948-11-05;470", ementa:"Concede subvenção à Estrada de Ferro Noroeste do Brasil e autoriza a   abertura do crédito necessário.", arquivo:"federal/leis-ordinarias/1948/lei-470-1948-11-05.md"}}, {id:"federal:BR:L:351/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-08-27", numero:"351", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-08-27;351", vigente:true, titulo:"Lei nº 351 de 27/08/1948", urn:"urn:lex:br:federal:lei:1948-08-27;351", ementa:"Altera os artigos 1º e 2º do Decreto-lei nº 9.763, de 6 de setembro de   1946.", arquivo:"federal/leis-ordinarias/1948/lei-351-1948-08-27.md"}}, {id:"federal:BR:L:456/1948", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1948, data:"1948-10-28", numero:"456", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1948-10-28;456", vigente:true, titulo:"Lei nº 456 de 28/10/1948", urn:"urn:lex:br:federal:lei:1948-10-28;456", ementa:"Declara feriado nacional o dia 29 de outubro de 1948.", arquivo:"federal/leis-ordinarias/1948/lei-456-1948-10-28.md"}}, {id:"federal:BR:L:569/1948", properties:{esfera:"federal", versao_texto:"compilada 