:8394/1991", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1991, data:"1991-12-30", numero:"8394", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1991-12-30;8394", vigente:true, titulo:"Lei nº 8.394 de 30/12/1991", urn:"urn:lex:br:federal:lei:1991-12-30;8394", ementa:"Dispõe sobre a preservação, organização e proteção dos acervos documentais   privados dos presidentes da República e dá outras providências.", arquivo:"federal/leis-ordinarias/1991/lei-8394-1991-12-30.md"}}, {id:"federal:BR:L:8278/1991", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1991, data:"1991-12-20", numero:"8278", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1991-12-20;8278", vigente:true, titulo:"Lei nº 8.278 de 20/12/1991", urn:"urn:lex:br:federal:lei:1991-12-20;8278", ementa:"Autoriza o Poder Executivo a abrir aos Orçamentos da União créditos adicionais no valor de Cr$ 592.811.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1991/lei-8278-1991-12-20.md"}}, {id:"federal:BR:L:8376/1991", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1991, data:"1991-12-30", numero:"8376", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1991-12-30;8376", vigente:true, titulo:"Lei nº 8.376 de 30/12/1991", urn:"urn:lex:br:federal:lei:1991-12-30;8376", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento Fiscal da União crédito   suplementar no valor de Cr$1.229.627.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1991/lei-8376-1991-12-30.md"}}, {id:"federal:BR:L:8351/1991", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1991, data:"1991-12-28", numero:"8351", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1991-12-28;8351", vigente:true, titulo:"Lei nº 8.351 de 28/12/1991", urn:"urn:lex:br:federal:lei:1991-12-28;8351", ementa:"Autoriza a Companhia Vale do Rio Doce - CVRD a   participar, minoritariamente, do capital social da sociedade anônima a ser constituída sob   a denominação de CELMAR S.A. - Indústria de Celulose e   Papel.", arquivo:"federal/leis-ordinarias/1991/lei-8351-1991-12-28.md"}}, {id:"federal:BR:L:8205/1991", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1991, data:"1991-07-08", numero:"8205", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1991-07-08;8205", vigente:true, titulo:"Lei nº 8.205 de 08/07/1991", urn:"urn:lex:br:federal:lei:1991-07-08;8205", ementa:"Autoriza a emissão extraordinária de Títulos Públicos Federais, no   montante de Cr$ 205.500.000.000,00 e a abertura de créditos adicionais, em favor   da unidade \"Recursos sob a Supervisão do Ministério da Economia, Fazenda e   Planejamento\", no montante de até Cr$ 302.100.000.000,00.", arquivo:"federal/leis-ordinarias/1991/lei-8205-1991-07-08.md"}}, {id:"federal:BR:L:8167/1991", properties:{esfera:"federal", versao_texto:"compilada (texto vigente)", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1991, data:"1991-01-16", numero:"8167", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1991-01-16;8167", vigente:true, titulo:"Lei nº 8.167 de 16/01/1991", urn:"urn:lex:br:federal:lei:1991-01-16;8167", ementa:"Altera a legislação do Imposto sobre a Renda relativa a incentivos fiscais, estabelece novas condições operacionais dos Fundos de Invenstimentos Regionais e dá outras providências.", arquivo:"federal/leis-ordinarias/1991/lei-8167-1991-01-16.md"}}, {id:"federal:BR:L:8223/1991", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1991, data:"1991-09-06", numero:"8223", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1991-09-06;8223", vigente:true, titulo:"Lei nº 8.223 de 06/09/1991", urn:"urn:lex:br:federal:lei:1991-09-06;8223", ementa:"Autoriza o Poder Executivo a doar o Imóvel que menciona ao Município de   Campinas, Estado de São Paulo.", arquivo:"federal/leis-ordinarias/1991/lei-8223-1991-09-06.md"}}, {id:"federal:BR:L:8335/1991", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1991, data:"1991-12-26", numero:"8335", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1991-12-26;8335", vigente:true, titulo:"Lei nº 8.335 de 26/12/1991", urn:"urn:lex:br:federal:lei:1991-12-26;8335", ementa:"Autoriza o Poder Executivo a abrir ao Orçamento Fiscal da União, em favor do Ministério da Agricultura e Reforma Agrária, crédito suplementar no valor de Cr$ 1.345.828.000,00, para os fins que especifica.", arquivo:"federal/leis-ordinarias/1991/lei-8335-1991-12-26.md"}}, {id:"federal:BR:L:2675/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-12-08", numero:"2675", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-12-08;2675", vigente:true, titulo:"Lei nº 2.675 de 08/12/1955", urn:"urn:lex:br:federal:lei:1955-12-08;2675", ementa:"Autoriza o Poder Executivo a abrir, pelo Ministério da Educação e Cultura, o crédito especial de Cr$ 600.000,00 para auxiliar a realização do Tríduo Nacional de Nossa Senhora de Fátima, em Fortaleza, Estado do Ceará.", arquivo:"federal/leis-ordinarias/1955/lei-2675-1955-12-08.md"}}, {id:"federal:BR:L:2404/1955", properties:{esfera:"federal", versao_texto:"original", tipo:"Lei Ordinária", vigencia_origem:"revogada=false", ano:1955, data:"1955-01-13", numero:"2404", fonte:"https://normas.leg.br/?urn=urn:lex:br:federal:lei:1955-01-13;2404", vigente:true, titulo:"Lei nº 2.404 de 13/01/1955", urn:"urn:lex:br:federal:lei:1955-01-13;2404", ementa:"Autoriza o Tesouro Nacional a adquirir partes beneficiárias da Companhia   Hidro-Elétrica do São Francisco.", arqui